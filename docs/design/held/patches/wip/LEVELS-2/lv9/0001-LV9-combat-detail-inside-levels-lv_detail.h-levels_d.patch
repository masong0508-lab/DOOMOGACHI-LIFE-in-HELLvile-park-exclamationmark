+thing 6 1 KEY_RED
+thing 7 1 KEY_BLUE
+thing 8 1 CANDY tflags2=collect
+thing 9 1 AMMO_ROCKETS tflags=secret
+thing 10 1 SCRAP tflags2=usable arg=1
+thing 11 1 ARMOR
+thing 12 1 SOUL_ORB
+# props (every second one is thinned)
+thing 1 2 PROP_TREE
+thing 2 2 PROP_LAMP
+thing 3 2 PROP_BENCH
