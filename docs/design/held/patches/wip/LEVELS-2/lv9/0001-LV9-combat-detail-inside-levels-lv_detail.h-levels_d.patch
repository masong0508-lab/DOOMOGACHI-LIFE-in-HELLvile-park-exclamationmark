diff --git a/core/include/doomo/lv_detail.h b/core/include/doomo/lv_detail.h
new file mode 100644
index 0000000..d56abc6
--- /dev/null
+++ b/core/include/doomo/lv_detail.h
@@ -0,0 +1,76 @@
+/* lv_detail.h - the combat detail option inside a level (owner: levels, LV9; plan 8.7 and 7.2).
+ *
+ * Three inputs: the option (OPT3D_SMOOTH / BALANCED / MAX, town.h), the level's header (`detail a,b,c`
+ * = what may be dropped, first to last; `awake S B M` = the awake demon caps) and the governor's
+ * pressure (how far the last frames ran over their budget, a small int 0..LVD_PRESSURE_MAX).
+ * Output: which MDET_* effects are dropped this frame and the awake cap.
+ *
+ *   dropped steps = Smooth ? LVD_SMOOTH_STEPS : 0, plus the held pressure level, at most the list's
+ *   length. Step n drops the n-th named effect. Balanced and Max start at 0 and only lose effects
+ *   under pressure (the governor lowers Max first: its cap falls toward Smooth's).
+ *
+ * Pure functions on a caller-owned 4-byte LvDetail. No statics, no clock, no rng, no allocation.
+ * Hysteresis: the held level rises ONE step per update while the pressure is above it (detail is
+ * dropped at once, one step at a time) and falls one step only after LVD_RAISE_GOOD updates in a
+ * row with the pressure below it (detail comes back slowly), so detail does not flicker.
+ *
+ * Loot: Smooth thins the loot a level lists (`detail ... loot`) and the props (`... props`) at
+ * spawn time, keyed to the thing's index, never to the pressure (so the level plays the same
+ * whatever the frame cost). lvd_thing_kept() never drops a key, a secret, a collectible, an
+ * escort, a usable, an NPC, a boss, an event thing, the machine heart, scrap or a soul orb.
+ *
+ * Code for every platform (levels overlay group on the PS1: nothing links until a level calls it).
+ * Wiring: combat_scene.c's combat_view_detail() (the existing option's hook) for the drawing side.
+ */
+#ifndef DOOMO_LV_DETAIL_H
+#define DOOMO_LV_DETAIL_H
+
+#include "map.h"
+
+#define LVD_PRESSURE_MAX  3      /* pressure 0 = in budget .. 3 = far over                        */
+#define LVD_SMOOTH_STEPS  2      /* effects Smooth drops before any pressure                       */
+#define LVD_RAISE_GOOD    45     /* good updates (1.5 s at 30 fps) before one step comes back     */
+#define LVD_MAX_STEPS     3      /* DoomoMapExt.detail has 3 slots                                 */
+
+/* platforms (the awake cap multiplies the header's GBA numbers) */
+enum { LVD_GBA, LVD_PS1, LVD_DC, LVD_PLATFORMS };
+
+#if defined(DOOMO_PLATFORM_PS1)
+#define LVD_HERE LVD_PS1
+#elif defined(DOOMO_PLATFORM_DC)
+#define LVD_HERE LVD_DC
+#else
+#define LVD_HERE LVD_GBA            /* the GBA and the host build (the tests set the platform by hand) */
+#endif
+
+/* the caller's state: 4 bytes (it lives in the level's runtime) */
+typedef struct LvDetail {
+    uint8_t level;               /* held pressure level 0..LVD_PRESSURE_MAX                       */
+    uint8_t good;                /* consecutive updates below `level`                              */
+    uint8_t mode;                /* OPT3D_* last seen (a change of mode restarts the state)        */
+    uint8_t pad;
+} LvDetail;
+
+typedef struct LvDetailOut {
+    uint16_t drop;               /* bit (1 << MDET_*) per dropped effect                           */
+    uint8_t  awake;              /* awake demons the level may have                                */
+    uint8_t  steps;              /* effects dropped (0..LVD_MAX_STEPS)                             */
+} LvDetailOut;
+
+/* a frame's cost in percent of its budget (100 = exactly on budget) -> pressure 0..3:
+ * <= 100 is 0, <= 115 is 1, <= 140 is 2, above is 3 */
+int  lvd_pressure(int cost_pct);
+void lvd_begin(LvDetail *s, int mode);
+/* once per frame (or every few): feed the pressure; hysteresis as above */
+void lvd_update(LvDetail *s, int mode, int pressure);
+/* the effects dropped and the cap for the level `x` (NULL = a v1 map: nothing dropped, the defaults) */
+void lvd_get(const LvDetail *s, const DoomoMapExt *x, int mode, int platform, LvDetailOut *o);
+/* the awake cap alone: the header's numbers (or the defaults) x the platform, lowered by the held level */
+int  lvd_awake_cap(const DoomoMapExt *x, int mode, int platform, int level);
+/* 1 if effect `kind` (MDET_*) is in the level's drop list at all */
+int  lvd_listed(const DoomoMapExt *x, int kind);
+/* spawn time: 0 = leave thing `index` out (Smooth thinning), 1 = keep it. `flags` is DoomoThing.flags,
+ * `flags2` its tflags2 byte (0 without a table). Every other mode keeps everything. */
+int  lvd_thing_kept(const DoomoMapExt *x, int mode, int index, int type, int flags, int flags2);
+
+#endif
