diff --git a/core/src/levels_detail.c b/core/src/levels_detail.c
new file mode 100644
index 0000000..0143d1d
--- /dev/null
+++ b/core/src/levels_detail.c
@@ -0,0 +1,105 @@
+/* levels_detail.c - the combat detail option inside a level (owner: levels, LV9). See lv_detail.h.
+ * Pure functions: no statics. On the PS1 this is in the combat + levels overlay group
+ * (ps1/tools/ovl_plan.py matches levels_*) and links only when a level calls it. */
+#include "doomo/lv_detail.h"
+#include "doomo/town.h"
+#include "doomo/actor.h"
+
+/* defaults (the Vape Cellar numbers, plan 7.2: GBA awake demons 6 / 8 / 10) */
+static const uint8_t k_awake_def[3] = { 6, 8, 10 };
+/* the header's numbers are GBA numbers; the other platforms multiply (x2 / 2: x1.5 and x2) */
+static const uint8_t k_plat_mul2[LVD_PLATFORMS] = { 2, 3, 4 };
+
+static int mode_index(int mode)
+{
+    return mode == OPT3D_SMOOTH ? 0 : mode == OPT3D_MAX ? 2 : 1;
+}
+
+int lvd_pressure(int cost_pct)
+{
+    if (cost_pct <= 100) return 0;
+    if (cost_pct <= 115) return 1;
+    if (cost_pct <= 140) return 2;
+    return LVD_PRESSURE_MAX;
+}
+
+void lvd_begin(LvDetail *s, int mode)
+{
+    s->level = 0; s->good = 0; s->mode = (uint8_t)mode; s->pad = 0;
+}
+
+void lvd_update(LvDetail *s, int mode, int pressure)
+{
+    if (s->mode != (uint8_t)mode) lvd_begin(s, mode);
+    if (pressure < 0) pressure = 0;
+    if (pressure > LVD_PRESSURE_MAX) pressure = LVD_PRESSURE_MAX;
+    if (pressure > s->level) {
+        s->level++;                     /* one step down at a time */
+        s->good = 0;
+    } else if (pressure < s->level) {
+        if (++s->good >= LVD_RAISE_GOOD) { s->level--; s->good = 0; }
+    } else {
+        s->good = 0;                    /* at the level: the run of good frames starts over */
+    }
+}
+
+int lvd_listed(const DoomoMapExt *x, int kind)
+{
+    int i;
+    if (!x) return 0;
+    for (i = 0; i < LVD_MAX_STEPS; i++)
+        if (x->detail[i] == kind) return 1;
+    return 0;
+}
+
+static int listed_count(const DoomoMapExt *x)
+{
+    int n = 0;
+    if (!x) return 0;
+    while (n < LVD_MAX_STEPS && x->detail[n] != MDET_NONE) n++;
+    return n;
+}
+
+int lvd_awake_cap(const DoomoMapExt *x, int mode, int platform, int level)
+{
+    int mi = mode_index(mode), cap, low;
+    const uint8_t *t = (x && x->awake[0]) ? x->awake : k_awake_def;
+    if (platform < 0 || platform >= LVD_PLATFORMS) platform = LVD_GBA;
+    cap = t[mi] * k_plat_mul2[platform] / 2;
+    low = t[0] * k_plat_mul2[platform] / 2;
+    if (level > 0 && cap > low) {       /* the governor lowers Balanced and Max toward Smooth's cap */
+        cap -= level;
+        if (cap < low) cap = low;
+    }
+    return cap < 1 ? 1 : cap;
+}
+
+void lvd_get(const LvDetail *s, const DoomoMapExt *x, int mode, int platform, LvDetailOut *o)
+{
+    int n = listed_count(x), steps = (mode == OPT3D_SMOOTH ? LVD_SMOOTH_STEPS : 0) + s->level, i;
+    if (s->mode != (uint8_t)mode) steps = mode == OPT3D_SMOOTH ? LVD_SMOOTH_STEPS : 0;   /* stale state */
+    if (steps > n) steps = n;
+    o->drop = 0;
+    for (i = 0; i < steps; i++) o->drop = (uint16_t)(o->drop | (1u << x->detail[i]));
+    o->steps = (uint8_t)steps;
+    o->awake = (uint8_t)lvd_awake_cap(x, mode, platform, s->mode == (uint8_t)mode ? s->level : 0);
+}
+
+int lvd_thing_kept(const DoomoMapExt *x, int mode, int index, int type, int flags, int flags2)
+{
+    int loot, prop;
+    if (!x || mode != OPT3D_SMOOTH) return 1;
+    /* never: anything that carries the level's progress or story */
+    if (flags & (THF_SECRET | THF_BOSS | THF_DORMANT | THF_KILL_EVENT | THF_MACHINE_HEART)) return 1;
+    if (flags2 & (THF2_COLLECT | THF2_ESCORT | THF2_USABLE)) return 1;
+    prop = type >= THING_PROP_TREE && type <= THING_PROP_MAILBOX;
+    switch (type) {
+    case THING_HEALTH_SMALL: case THING_AMMO_BULLETS: case THING_AMMO_SHELLS:
+    case THING_AMMO_CELLS: case THING_AMMO_ROCKETS: case THING_CANDY:
+        loot = 1; break;
+    default: loot = 0; break;           /* keys, armor, big health, scrap, soul orbs, NPCs, demons: kept */
+    }
+    if (loot && lvd_listed(x, MDET_LOOT)) return (index & 1) ? 0 : 1;
+    if (prop && lvd_listed(x, MDET_PROPS)) return (index & 1) ? 0 : 1;
+    return 1;
+}
