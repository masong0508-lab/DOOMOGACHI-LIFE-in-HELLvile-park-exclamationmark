diff --git a/core/tests/test_lv_detail.c b/core/tests/test_lv_detail.c
new file mode 100644
index 0000000..ca3c968
--- /dev/null
+++ b/core/tests/test_lv_detail.c
@@ -0,0 +1,270 @@
+/* test_lv_detail.c - LV9 (owner: levels): the combat detail option inside a level (core/src/levels_detail.c)
+ * on the test map core/tests/maps/t9_detail.txt (`detail steam,loot,props`, `awake 4 6 9`): every mode at
+ * every pressure, the hysteresis, the awake caps per platform, the loot thinning that never touches a key
+ * or a quest item, determinism, and the v1 map (no ext) staying untouched. */
+#include "test.h"
+#include "doomo/lv_detail.h"
+#include "doomo/actor.h"
+
+#define IS_DEMON(t) ((t) >= THING_IMPLING && (t) <= THING_LORD_VAPULA)
+extern const DoomoMapExt map_ext_t9_detail;
+#define X (&map_ext_t9_detail)
+#define BIT(k) (1u << (k))
+
+static const int k_mode[3] = { OPT3D_SMOOTH, OPT3D_BALANCED, OPT3D_MAX };
+
+TEST(lvd_mapc_emits_the_header)
+{
+    CHECK_EQ(X->detail[0], MDET_STEAM);
+    CHECK_EQ(X->detail[1], MDET_LOOT);
+    CHECK_EQ(X->detail[2], MDET_PROPS);
+    CHECK_EQ(X->awake[0], 4);
+    CHECK_EQ(X->awake[1], 6);
+    CHECK_EQ(X->awake[2], 9);
+    CHECK_EQ(sizeof(LvDetail), 4);
+}
+
+TEST(lvd_pressure_from_cost)
+{
+    CHECK_EQ(lvd_pressure(0), 0);
+    CHECK_EQ(lvd_pressure(100), 0);
+    CHECK_EQ(lvd_pressure(101), 1);
+    CHECK_EQ(lvd_pressure(115), 1);
+    CHECK_EQ(lvd_pressure(116), 2);
+    CHECK_EQ(lvd_pressure(140), 2);
+    CHECK_EQ(lvd_pressure(141), 3);
+    CHECK_EQ(lvd_pressure(9999), LVD_PRESSURE_MAX);
+}
+
+/* the held level goes up one step an update and comes down only after LVD_RAISE_GOOD good updates */
+TEST(lvd_hysteresis)
+{
+    LvDetail s;
+    int i, k;
+    lvd_begin(&s, OPT3D_BALANCED);
+    lvd_update(&s, OPT3D_BALANCED, 3);
+    CHECK_EQ(s.level, 1);                       /* one step at a time */
+    lvd_update(&s, OPT3D_BALANCED, 3);
+    CHECK_EQ(s.level, 2);
+    lvd_update(&s, OPT3D_BALANCED, 3);
+    CHECK_EQ(s.level, 3);
+    lvd_update(&s, OPT3D_BALANCED, 3);
+    CHECK_EQ(s.level, 3);                       /* the top */
+    for (i = 0; i < LVD_RAISE_GOOD - 1; i++) lvd_update(&s, OPT3D_BALANCED, 0);
+    CHECK_EQ(s.level, 3);                       /* not yet */
+    lvd_update(&s, OPT3D_BALANCED, 0);
+    CHECK_EQ(s.level, 2);                       /* one step back, not all */
+    /* a bad frame in the run of good ones starts the run over */
+    for (i = 0; i < LVD_RAISE_GOOD - 1; i++) lvd_update(&s, OPT3D_BALANCED, 0);
+    lvd_update(&s, OPT3D_BALANCED, 2);          /* at the level: resets the run */
+    for (i = 0; i < LVD_RAISE_GOOD - 1; i++) lvd_update(&s, OPT3D_BALANCED, 0);
+    CHECK_EQ(s.level, 2);
+    lvd_update(&s, OPT3D_BALANCED, 0);
+    CHECK_EQ(s.level, 1);
+    /* an alternating signal never flickers: over / under every other frame holds the level */
+    lvd_begin(&s, OPT3D_MAX);
+    lvd_update(&s, OPT3D_MAX, 2); lvd_update(&s, OPT3D_MAX, 2);
+    CHECK_EQ(s.level, 2);
+    for (k = 0; k < 200; k++) {
+        lvd_update(&s, OPT3D_MAX, (k & 1) ? 0 : 2);
+        CHECK_EQ(s.level, 2);
+    }
+    /* out-of-range pressure is clamped */
+    lvd_begin(&s, OPT3D_MAX);
+    for (k = 0; k < 10; k++) lvd_update(&s, OPT3D_MAX, 99);
+    CHECK_EQ(s.level, LVD_PRESSURE_MAX);
+    lvd_update(&s, OPT3D_MAX, -5);
+    CHECK(s.level <= LVD_PRESSURE_MAX);
+}
+
+TEST(lvd_mode_change_restarts)
+{
+    LvDetail s;
+    lvd_begin(&s, OPT3D_MAX);
+    lvd_update(&s, OPT3D_MAX, 3); lvd_update(&s, OPT3D_MAX, 3);
+    CHECK_EQ(s.level, 2);
+    lvd_update(&s, OPT3D_SMOOTH, 0);
+    CHECK_EQ(s.level, 0);
+    CHECK_EQ(s.mode, OPT3D_SMOOTH);
+}
+
+/* every mode x every held level: the dropped effects are a prefix of the list, in order */
+TEST(lvd_every_mode_every_pressure)
+{
+    int m, lvl, p;
+    for (m = 0; m < 3; m++) {
+        int prev_steps = -1, prev_cap = 1000;
+        for (lvl = 0; lvl <= LVD_PRESSURE_MAX; lvl++) {
+            LvDetail s;
+            LvDetailOut o;
+            int want = (k_mode[m] == OPT3D_SMOOTH ? LVD_SMOOTH_STEPS : 0) + lvl, i;
+            unsigned mask = 0;
+            lvd_begin(&s, k_mode[m]);
+            for (i = 0; i < lvl; i++) lvd_update(&s, k_mode[m], lvl);
+            CHECK_EQ(s.level, lvl);
+            lvd_get(&s, X, k_mode[m], LVD_GBA, &o);
+            if (want > 3) want = 3;
+            CHECK_EQ(o.steps, want);
+            for (i = 0; i < want; i++) mask |= BIT(X->detail[i]);
+            CHECK_EQ(o.drop, mask);
+            CHECK(o.steps >= prev_steps);             /* more pressure never gives detail back */
+            CHECK(o.awake <= prev_cap);               /* nor demons */
+            CHECK(o.awake >= X->awake[0]);            /* never below Smooth's own cap */
+            CHECK(o.awake <= X->awake[m]);            /* never above the mode's */
+            prev_steps = o.steps; prev_cap = o.awake;
+        }
+        /* the pressure helper feeds the same table */
+        for (p = 0; p <= LVD_PRESSURE_MAX; p++) CHECK(lvd_pressure(100 + p * 20) <= LVD_PRESSURE_MAX);
+    }
+    /* Balanced and Max with no pressure drop nothing; Smooth drops the first two named */
+    {
+        LvDetail s;
+        LvDetailOut o;
+        lvd_begin(&s, OPT3D_BALANCED);
+        lvd_get(&s, X, OPT3D_BALANCED, LVD_GBA, &o);
+        CHECK_EQ(o.drop, 0);
+        CHECK_EQ(o.awake, 6);
+        lvd_begin(&s, OPT3D_MAX);
+        lvd_get(&s, X, OPT3D_MAX, LVD_GBA, &o);
+        CHECK_EQ(o.drop, 0);
+        CHECK_EQ(o.awake, 9);
+        lvd_begin(&s, OPT3D_SMOOTH);
+        lvd_get(&s, X, OPT3D_SMOOTH, LVD_GBA, &o);
+        CHECK_EQ(o.drop, BIT(MDET_STEAM) | BIT(MDET_LOOT));
+        CHECK_EQ(o.awake, 4);
+    }
+}
+
+TEST(lvd_defaults_and_platforms)
+{
+    DoomoMapExt plain = *X;
+    LvDetail s;
+    LvDetailOut o;
+    memset(plain.awake, 0, sizeof(plain.awake));
+    memset(plain.detail, 0, sizeof(plain.detail));
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_SMOOTH, LVD_GBA, 0), 6);       /* the Vape Cellar numbers */
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_BALANCED, LVD_GBA, 0), 8);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_MAX, LVD_GBA, 0), 10);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_BALANCED, LVD_PS1, 0), 12);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_BALANCED, LVD_DC, 0), 16);
+    CHECK_EQ(lvd_awake_cap(X, OPT3D_MAX, LVD_PS1, 0), 13);              /* 9 x 3 / 2 */
+    CHECK_EQ(lvd_awake_cap(NULL, OPT3D_MAX, LVD_GBA, 0), 10);           /* a v1 map: the defaults */
+    CHECK_EQ(lvd_awake_cap(X, OPT3D_MAX, 99, 0), 9);                    /* unknown platform: the GBA's */
+    /* the governor lowers Max toward Smooth's cap and stops there */
+    CHECK_EQ(lvd_awake_cap(X, OPT3D_MAX, LVD_GBA, 1), 8);
+    CHECK_EQ(lvd_awake_cap(X, OPT3D_MAX, LVD_GBA, 3), 6);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_MAX, LVD_GBA, 3), 7);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_MAX, LVD_GBA, 9), 6);
+    CHECK_EQ(lvd_awake_cap(&plain, OPT3D_SMOOTH, LVD_GBA, 3), 6);       /* Smooth is already the floor */
+    /* no drop list: nothing is ever dropped, in any mode or pressure */
+    lvd_begin(&s, OPT3D_SMOOTH);
+    lvd_update(&s, OPT3D_SMOOTH, 3); lvd_update(&s, OPT3D_SMOOTH, 3); lvd_update(&s, OPT3D_SMOOTH, 3);
+    lvd_get(&s, &plain, OPT3D_SMOOTH, LVD_GBA, &o);
+    CHECK_EQ(o.drop, 0);
+    CHECK_EQ(o.steps, 0);
+    /* a v1 map (no ext) */
+    lvd_get(&s, NULL, OPT3D_SMOOTH, LVD_GBA, &o);
+    CHECK_EQ(o.drop, 0);
+    CHECK_EQ(o.awake, 6);
+    CHECK_EQ(lvd_listed(NULL, MDET_LOOT), 0);
+    CHECK_EQ(lvd_listed(X, MDET_LOOT), 1);
+    CHECK_EQ(lvd_listed(X, MDET_RAIN), 0);
+}
+
+/* a stale state (the option changed since the last update) reads as the new mode's start */
+TEST(lvd_stale_state)
+{
+    LvDetail s;
+    LvDetailOut o;
+    lvd_begin(&s, OPT3D_MAX);
+    lvd_update(&s, OPT3D_MAX, 3); lvd_update(&s, OPT3D_MAX, 3); lvd_update(&s, OPT3D_MAX, 3);
+    lvd_get(&s, X, OPT3D_BALANCED, LVD_GBA, &o);
+    CHECK_EQ(o.drop, 0);
+    CHECK_EQ(o.awake, 6);
+}
+
+static int kept(int mode, int i)
+{
+    const DoomoThing *t = &X->def->things[i];
+    return lvd_thing_kept(X, mode, i, t->type, t->flags, map_thing_flags2(X, i));
+}
+
+/* the loot rule: Smooth thins ammo, candy, small health and props; nothing else, in no other mode */
+TEST(lvd_loot_never_drops_a_key_or_a_quest_item)
+{
+    const DoomoMapDef *d = X->def;
+    int i, thinned = 0, m, props_thinned = 0;
+    for (m = 0; m < 3; m++)
+        if (k_mode[m] != OPT3D_SMOOTH)
+            for (i = 0; i < d->thing_count; i++) CHECK_EQ(kept(k_mode[m], i), 1);
+    for (i = 0; i < d->thing_count; i++) {
+        const DoomoThing *t = &d->things[i];
+        int f2 = map_thing_flags2(X, i), k = kept(OPT3D_SMOOTH, i);
+        if (!k) {
+            thinned++;
+            if (t->type >= THING_PROP_TREE && t->type <= THING_PROP_MAILBOX) props_thinned++;
+            CHECK(t->type != THING_KEY_RED && t->type != THING_KEY_BLUE);
+            CHECK(t->type != THING_SCRAP && t->type != THING_SOUL_ORB && t->type != THING_ARMOR);
+            CHECK(!(t->flags & THF_SECRET));
+            CHECK(!(f2 & (THF2_COLLECT | THF2_ESCORT | THF2_USABLE)));
+            CHECK(!IS_DEMON(t->type));
+        }
+        if (t->type == THING_KEY_RED || t->type == THING_KEY_BLUE) CHECK_EQ(k, 1);
+        if (f2 & THF2_COLLECT) CHECK_EQ(k, 1);
+        if (f2 & THF2_USABLE) CHECK_EQ(k, 1);
+        if (t->flags & THF_SECRET) CHECK_EQ(k, 1);
+        if (t->type == THING_PLAYER_START) CHECK_EQ(k, 1);
+    }
+    CHECK(thinned >= 4);                  /* it does thin something (loot and props) */
+    CHECK(props_thinned >= 1);
+    /* the rule alone, for every type and every flag: never a key, never a flagged thing, whatever the index */
+    for (m = 0; m < 2; m++) {
+        int type, idx;
+        for (type = 0; type < THING_COUNT; type++)
+            for (idx = 0; idx < 4; idx++) {
+                if (type == THING_KEY_RED || type == THING_KEY_BLUE)
+                    CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, 0, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, THF_SECRET, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, THF_BOSS, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, THF_DORMANT, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, THF_KILL_EVENT, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, THF_MACHINE_HEART, 0), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, 0, THF2_COLLECT), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, 0, THF2_ESCORT), 1);
+                CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, 0, THF2_USABLE), 1);
+                if (IS_DEMON(type) || type == THING_NPC)
+                    CHECK_EQ(lvd_thing_kept(X, OPT3D_SMOOTH, idx, type, 0, 0), 1);
+            }
+    }
+    /* a v1 map: nothing is thinned even in Smooth */
+    CHECK_EQ(lvd_thing_kept(NULL, OPT3D_SMOOTH, 1, THING_CANDY, 0, 0), 1);
+    {   /* a level that lists neither loot nor props keeps everything */
+        DoomoMapExt none = *X;
+        memset(none.detail, 0, sizeof(none.detail));
+        none.detail[0] = MDET_STEAM;
+        CHECK_EQ(lvd_thing_kept(&none, OPT3D_SMOOTH, 1, THING_CANDY, 0, 0), 1);
+        CHECK_EQ(lvd_thing_kept(&none, OPT3D_SMOOTH, 1, THING_PROP_TREE, 0, 0), 1);
+    }
+}
+
+TEST(lvd_is_deterministic)
+{
+    int run, i, m;
+    unsigned h[2] = { 0, 0 };
+    for (run = 0; run < 2; run++) {
+        LvDetail s;
+        LvDetailOut o;
+        unsigned x = 2166136261u;
+        for (m = 0; m < 3; m++) {
+            lvd_begin(&s, k_mode[m]);
+            for (i = 0; i < 400; i++) {
+                lvd_update(&s, k_mode[m], lvd_pressure(80 + (i * 7) % 90));
+                lvd_get(&s, X, k_mode[m], LVD_PS1, &o);
+                x = (x ^ o.drop) * 16777619u; x = (x ^ o.awake) * 16777619u; x = (x ^ o.steps) * 16777619u;
+            }
+        }
+        for (i = 0; i < X->def->thing_count; i++) x = (x ^ (unsigned)kept(OPT3D_SMOOTH, i)) * 16777619u;
+        h[run] = x;
+    }
+    CHECK_EQ(h[0], h[1]);
+}
