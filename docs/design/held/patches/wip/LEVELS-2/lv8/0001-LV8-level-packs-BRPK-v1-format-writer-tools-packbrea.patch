+#!/usr/bin/env python3
+"""test_packbreach.py - LV8: tools/packbreach.py (level packs, BREACH.BIN, the manifest) and mapc's manifest guard.
+
+The C reader's own tests are core/tests/test_breachpack.c; this file checks the writer: the byte layout of
+core/include/doomo/breachpack.h, determinism, the limits, every refusal, the directory, the manifest."""
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+import zlib
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+import mapc  # noqa: E402
+import packbreach as pb  # noqa: E402
+
+TESTMAPS = os.path.join(ROOT, "core", "tests", "maps")
+TESTBANKS = os.path.join(ROOT, "core", "tests", "banks")
+KIT = os.path.join(TESTMAPS, "t3_kit.txt")
+MAP_MIN = """format 2
+title "Tiny"
+kind dungeon
+sky PASTEL_DAY
+music HAHALAND_DAY
+ambient 12
+cell # wall=PASTEL_BRICK
+cell . floor=WOOD_FLOOR ceil=CLOUD_PUFF ch=14
+cell p like=. thing=PLAYER_START
+cell x like=. flags=exit
+grid
+######
+#p..x#
+######
+end
+"""
+
+
+def tmpmap(text, name="tiny"):
+    d = tempfile.mkdtemp()
+    p = os.path.join(d, name + ".txt")
+    with open(p, "w") as f:
+        f.write(text)
+    return p
+
+
+class Layout(unittest.TestCase):
+    def test_header_and_table(self):
+        pack, info = pb.build_pack(KIT)
+        self.assertEqual(pack[:4], b"BRPK")
+        self.assertEqual(pack[4], 1)
+        self.assertEqual(pack[5], 12)
+        total, crc = struct.unpack_from("<II", pack, 8)
+        self.assertEqual(total, len(pack))
+        self.assertEqual(crc, zlib.crc32(pack[16:]) & 0xFFFFFFFF)
+        self.assertEqual((pack[16], pack[17]), (36, 7))
+        self.assertEqual(pack[48:55], b"T3 Kit\0")
+        self.assertEqual(pack[36], 0)                       # no texture bank
+        self.assertEqual(struct.unpack_from("<HH", pack, 38)[0], info["model"][4].__len__())
+        for i in range(12):
+            sid, enc, z, off, stored, raw = struct.unpack_from("<BBHIII", pack, 80 + 16 * i)
+            self.assertEqual((sid, z), (i, 0))
+            if stored:
+                self.assertEqual(off % 4, 0)
+                self.assertGreaterEqual(off, 272)
+                self.assertLessEqual(off + stored, total)
+        # the sprite bank is reserved and empty
+        self.assertEqual(struct.unpack_from("<BBHIII", pack, 80 + 16 * 11), (11, 0, 0, 0, 0, 0))
+
+    def test_round_trip_and_deterministic(self):
+        a, info = pb.build_pack(KIT)
+        b, _ = pb.build_pack(KIT)
+        self.assertEqual(a, b)
+        pb.check_roundtrip(a, info)
+
+    def test_every_test_map_round_trips(self):
+        for f in sorted(os.listdir(TESTMAPS)):
+            if f.endswith(".txt"):
+                pack, info = pb.build_pack(os.path.join(TESTMAPS, f), TESTBANKS)
+                pb.check_roundtrip(pack, info)
+                self.assertLessEqual(len(pack), pb.PACK_MAX)
+                self.assertLessEqual(info["tables"], pb.ARENA_MAX)
+
+    def test_every_shipped_map_packs(self):
+        for f in sorted(os.listdir(mapc.MAPS_DIR)):
+            if f.endswith(".txt") and f != "platforms.txt":
+                pack, info = pb.build_pack(os.path.join(mapc.MAPS_DIR, f))
+                pb.check_roundtrip(pack, info)
+
+    def test_cells_are_lz_only_when_smaller(self):
+        big, _ = pb.build_pack(os.path.join(mapc.MAPS_DIR, "hellvile.txt"))
+        self.assertEqual(big[80 + 1], 1)
+        u = pb.unpack(big)
+        self.assertEqual(len(u["sec"][0]), u["w"] * u["h"] * 8)
+        # a tiny map: LZ is used exactly when it is smaller (the flag follows the sizes)
+        text = MAP_MIN
+        pk, info = pb.build_pack(tmpmap(text))
+        self.assertEqual(pk[80 + 1], info["cells_stored"] < info["cells_raw"])
+
+    def test_header_fields_of_a_v2_map(self):
+        pack, _ = pb.build_pack(os.path.join(TESTMAPS, "t8_bank.txt"), TESTBANKS)
+        u = pb.unpack(pack)
+        self.assertEqual((u["fog"], u["view"], u["gravity"], u["note"]), (12, 14, 80, 7))
+        self.assertEqual(u["hero"], (3, 4))
+        self.assertEqual(u["detail"], [mapc.ENUMS["MDET_FX"], mapc.ENUMS["MDET_FAR"], 0])
+        self.assertEqual(u["xflags"], mapc.ENUMS["MAPX_HERO"])
+        self.assertEqual(u["texbank"], 3)
+        self.assertEqual(u["strings"], 2)
+        # the texture bank is the generator's blob, unchanged
+        import texbank
+        want = texbank.build_file(os.path.join(TESTBANKS, "t8_bank.bank"))
+        names = b"vat_brick".ljust(12, b"\0") + b"\0" * 12 + b"dust".ljust(12, b"\0")
+        self.assertEqual(u["sec"][pb.S_TEXBANK], names + want)
+        # the text section
+        t = u["sec"][pb.S_TEXT]
+        self.assertEqual(struct.unpack_from("<H", t, 0)[0], 2)
+        self.assertTrue(t.endswith(b"Welcome to the vat.\0Second string\0"))
+
+    def test_tables_bytes_matches_the_reader_layout(self):
+        pack, info = pb.build_pack(os.path.join(TESTMAPS, "t8_bank.txt"), TESTBANKS)
+        self.assertEqual(info["tables"], pb.tables_bytes(
+            {"things": 1, "zones": 1, "paths": 0, "pathpts": 0, "swaps": 0, "swapcells": 0, "script": 0, "texbank": 3},
+            [b"", b"", b"", b"", b"", b"", b"", b"", b"", pb.unpack(pack)["sec"][pb.S_TEXT], b"", b""]))
+
+
+class Refusals(unittest.TestCase):
+    def refuse(self, fn, *words):
+        try:
+            fn()
+        except (pb.PackError, mapc.MapError) as e:
+            for w in words:
+                self.assertIn(w, str(e))
+            return
+        self.fail("not refused")
+
+    def test_pack_over_96k(self):
+        # 28 frames of 4 KB in the bank: 114 KB
+        d = tempfile.mkdtemp()
+        with open(os.path.join(d, "tiny.bank"), "w") as f:
+            f.write("bank tiny\n" + "".join("tex t%d frames=4 speed=2 stripes STONE.1 STONE.5 8\n" % i for i in range(7)))
+        text = MAP_MIN.replace("cell # wall", "texbank 0 t0\ncell # wall")
+        self.refuse(lambda: pb.build_pack(tmpmap(text), d), "at most 98304")
+
+    def test_bank_missing_or_wrong_name(self):
+        text = MAP_MIN.replace("cell # wall", "texbank 0 nosuch\ncell # wall")
+        self.refuse(lambda: pb.build_pack(tmpmap(text), tempfile.mkdtemp()), "no ")
+        self.refuse(lambda: pb.build_pack(tmpmap(text, "t8_bank"), TESTBANKS), "not in the bank")
+
+    def test_bank_slot_order_is_the_id_order(self):
+        # `texbank 1 dust` but dust is slot 2 of the bank: id 57 would answer from the wrong slot
+        text = MAP_MIN.replace("cell # wall", "texbank 1 dust\ncell # wall")
+        d = tempfile.mkdtemp()
+        with open(os.path.join(d, "tiny.bank"), "w") as f:
+            f.write("bank tiny\ntex a fill STONE.1\ntex b fill STONE.2\ntex dust fill STONE.3\n")
+        self.refuse(lambda: pb.build_pack(tmpmap(text), d), "slot order")
+
+    def test_too_many_strings_or_text(self):
+        p = tmpmap(MAP_MIN)
+        with open(p[:-4] + ".strings", "w") as f:
+            f.write("\n".join("s%d" % i for i in range(65)))
+        self.refuse(lambda: pb.build_pack(p), "at most 64")
+        with open(p[:-4] + ".strings", "w") as f:
+            f.write("\n".join("x" * 200 for i in range(30)))
+        self.refuse(lambda: pb.build_pack(p), "at most 4096")
+
+    def test_mapc_errors_pass_through(self):
+        self.refuse(lambda: pb.build_pack(tmpmap(MAP_MIN.replace("grid\n######", "grid\n#####"))), "grid row")
+
+    def test_tampering_is_caught_by_the_reader(self):
+        pack, info = pb.build_pack(KIT)
+        bad = bytearray(pack)
+        bad[100] ^= 1
+        self.refuse(lambda: pb.unpack(bytes(bad)), "crc")
+        self.refuse(lambda: pb.unpack(pack[:100]), "short")
+        bad = bytearray(pack)
+        bad[0] = 0
+        self.refuse(lambda: pb.unpack(bytes(bad)), "magic")
+        # a pack that is a valid pack of another map is not this map's
+        other, _ = pb.build_pack(os.path.join(TESTMAPS, "t4_env.txt"))
+        self.refuse(lambda: pb.check_roundtrip(other, info), "differs")
+
+
+class Bin(unittest.TestCase):
+    def packs(self, n):
+        pack, _ = pb.build_pack(KIT)
+        return [(i * 2, 6, pack) for i in range(n)], pack
+
+    def test_layout(self):
+        ents, pack = self.packs(3)
+        data = pb.build_bin(ents)
+        self.assertEqual(len(data) % 2048, 0)
+        self.assertEqual(data[:4], b"BRBN")
+        got = pb.read_bin(data)
+        self.assertEqual([g[0] for g in got], [0, 2, 4])
+        crc = struct.unpack_from("<I", pack, 12)[0]
+        for lid, mask, off, ln, c in got:
+            self.assertEqual((mask, ln, c), (6, len(pack), crc))
+            self.assertEqual(off % 2048, 0)
+            self.assertEqual(data[off:off + ln], pack)
+        self.assertEqual(got[0][2], 2048)
+        self.assertEqual(got[1][2], 2048 + ((len(pack) + 2047) // 2048) * 2048)
+
+    def test_24_levels_and_no_more(self):
+        ents, _ = self.packs(24)
+        self.assertEqual(len(pb.read_bin(pb.build_bin(ents))), 24)
+        ents, pack = self.packs(25)
+        with self.assertRaises(pb.PackError):
+            pb.build_bin(ents)
+
+    def test_duplicate_level_id(self):
+        ents, pack = self.packs(2)
+        with self.assertRaises(pb.PackError):
+            pb.build_bin([ents[0], (ents[0][0], 6, pack)])
+
+    def test_empty_bin_is_one_sector(self):
+        self.assertEqual(len(pb.build_bin([])), 2048)
+
+
+class Manifest(unittest.TestCase):
+    def load(self, text):
+        d = tempfile.mkdtemp()
+        p = os.path.join(d, "platforms.txt")
+        with open(p, "w") as f:
+            f.write(text)
+        return mapc.load_manifest(p)
+
+    def test_defaults_and_options(self):
+        m = self.load("# c\nlevel a\nlevel b map=bee gba yes ps1 no   # x\nlevel c dc no\n")
+        self.assertEqual([k for k, _ in m], ["a", "b", "c"])
+        self.assertEqual(m[0][1], {"map": "a", "gba": False, "ps1": True, "dc": True})
+        self.assertEqual(m[1][1], {"map": "bee", "gba": True, "ps1": False, "dc": True})
+        self.assertFalse(m[2][1]["dc"])
+
+    def test_refusals(self):
+        for text, why in (("lvl a\n", "level ID"), ("level A\n", "level ID"), ("level a gba maybe\n", "unexpected"),
+                          ("level a\nlevel a\n", "twice"), ("level a map=x\nlevel b map=x\n", "twice"),
+                          ("level a map=X\n", "lowercase"), ("level a wat\n", "unexpected"),
+                          ("".join("level l%d\n" % i for i in range(25)), "at most 24")):
+            with self.assertRaises(mapc.MapError, msg=text) as c:
+                self.load(text)
+            self.assertIn(why, str(c.exception))
+
+    def test_missing_file_is_empty(self):
+        self.assertEqual(mapc.load_manifest("/nonexistent/platforms.txt"), [])
+
+    def test_shipped_manifest(self):
+        m = mapc.load_manifest()
+        self.assertEqual(len(m), 24)
+        self.assertEqual(sum(1 for _, e in m if e["gba"]), 7)
+        self.assertEqual([k for k, e in m if e["gba"]], ["hb8", "hb9", "hb13", "hb15", "n1", "n7", "n14"])
+        self.assertTrue(all(e["ps1"] and e["dc"] for _, e in m))
+
+    def test_guard(self):
+        m = [("a", {"map": "a", "gba": False, "ps1": True, "dc": True}),
+             ("b", {"map": "b", "gba": True, "ps1": True, "dc": True})]
+        self.assertEqual(mapc.manifest_guard("a", m), "!defined(DOOMO_PLATFORM_PS1) && !defined(DOOMO_PLATFORM_GBA)")
+        self.assertEqual(mapc.manifest_guard("b", m), "!defined(DOOMO_PLATFORM_PS1)")
+        self.assertIsNone(mapc.manifest_guard("vape_cellar", m))      # a shipped map: unguarded
+
+    def test_mapc_wraps_a_manifest_level_and_leaves_the_others(self):
+        d = tempfile.mkdtemp()
+        man = os.path.join(d, "platforms.txt")
+        with open(man, "w") as f:
+            f.write("level tiny\n")
+        p = tmpmap(MAP_MIN)
+        out = os.path.join(d, "out")
+        r = subprocess.run([sys.executable, os.path.join(ROOT, "tools", "mapc.py"), "--manifest", man,
+                            "--out-root", out, p], capture_output=True, text=True)
+        self.assertEqual(r.returncode, 0, r.stderr)
+        text = open(os.path.join(out, "core", "gen", "map_tiny.c")).read()
+        self.assertIn("#if !defined(DOOMO_PLATFORM_PS1) && !defined(DOOMO_PLATFORM_GBA)", text)
+        self.assertTrue(text.rstrip().endswith("#endif"))
+        # the same map not in the manifest: no guard
