+/* ---- BREACH.BIN ---- */
+static uint8_t dir[BP_SECTOR];
+static void mk_dir(int n)
+{
+    int i;
+    memset(dir, 0, sizeof dir);
+    memcpy(dir, "BRBN", 4);
+    dir[4] = 1; dir[5] = (uint8_t)n;
+    p32(dir + 8, BP_SECTOR * (1 + n * 2));
+    for (i = 0; i < n; i++) {
+        uint8_t *e = dir + BP_DIR_HDR + i * BP_DIR_ENT;
+        e[0] = (uint8_t)(i * 3); e[2] = BP_PLAT_PS1 | BP_PLAT_DC;
+        p32(e + 4, BP_SECTOR * (1 + i * 2)); p32(e + 8, 3000); p32(e + 12, 0xABCD0000u + i);
+    }
+}
+
+TEST(breachpack_directory_reads_and_finds)
+{
+    BpDir d;
+    const BpDirEnt *e;
+    mk_dir(5);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 11), BP_OK);
+    CHECK_EQ(d.count, 5);
+    e = bp_dir_find(&d, 9);
+    CHECK(e != NULL);
+    if (e) { CHECK_EQ(e->off, BP_SECTOR * 7); CHECK_EQ(e->len, 3000); CHECK_EQ(e->crc, 0xABCD0003u); }
+    CHECK(bp_dir_find(&d, 10) == NULL);
+    mk_dir(BP_DIR_ENTRIES);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * (1 + BP_DIR_ENTRIES * 2)), BP_OK);
+    CHECK_EQ(d.count, BP_DIR_ENTRIES);
+}
+
+TEST(breachpack_directory_refusals)
+{
+    BpDir d;
+    mk_dir(3);
+    CHECK_EQ(bp_dir(&d, dir, BP_DIR_BYTES - 1, BP_SECTOR * 7), BP_ERR_SHORT);
+    CHECK_EQ(bp_dir(&d, NULL, 0, 0), BP_ERR_NULL);
+    dir[0] = 'X';
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_MAGIC);
+    mk_dir(3); dir[4] = 2;
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_VERSION);
+    mk_dir(3); dir[5] = BP_DIR_ENTRIES + 1;
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_COUNT);
+    mk_dir(3);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 6), BP_ERR_RANGE);          /* longer than the file */
+    mk_dir(3); p32(dir + BP_DIR_HDR + 4, BP_SECTOR + 1);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_DIR);            /* not on a sector */
+    mk_dir(3); p32(dir + BP_DIR_HDR + 4, 0);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_DIR);            /* on the directory sector */
+    mk_dir(3); p32(dir + BP_DIR_HDR + 8, BP_PACK_MAX + 1);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 100), BP_ERR_SIZE);
+    mk_dir(3); p32(dir + BP_DIR_HDR + 8, 100);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_SIZE);
+    mk_dir(3); p32(dir + BP_DIR_HDR + 4 + 2 * BP_DIR_ENT, BP_SECTOR * 5); p32(dir + BP_DIR_HDR + 8 + 2 * BP_DIR_ENT, BP_PACK_MAX);
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 100), BP_ERR_RANGE);        /* runs past the end */
+    mk_dir(3); dir[BP_DIR_HDR + BP_DIR_ENT] = dir[BP_DIR_HDR];                   /* a level id twice */
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_DIR);
+    mk_dir(3); p32(dir + BP_DIR_HDR + 4 + BP_DIR_ENT, BP_SECTOR);                /* two packs on the same sectors */
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_OVERLAP);
+    mk_dir(3); dir[BP_DIR_HDR + 2] = 0;
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_DIR);            /* no platform */
+    mk_dir(3); dir[BP_DIR_HDR + 3] = 1;
+    CHECK_EQ(bp_dir(&d, dir, sizeof dir, BP_SECTOR * 7), BP_ERR_DIR);
+}
