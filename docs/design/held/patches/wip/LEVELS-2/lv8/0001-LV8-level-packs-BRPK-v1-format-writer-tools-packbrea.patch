+/* ---- every refusal ---- */
+static int open_now(BpPack *p) { return bp_open(p, pk, pk_len); }
+
+TEST(breachpack_refuses_null_short_magic_version)
+{
+    BpPack p;
+    BpHead h;
+    CHECK_EQ(bp_open(&p, NULL, 10), BP_ERR_NULL);
+    CHECK_EQ(bp_head(&h, NULL, 0, 0), BP_ERR_NULL);
+    CHECK(load_file("t3_kit"));
+    CHECK_EQ(bp_open(&p, pk, 0), BP_ERR_SHORT);
+    CHECK_EQ(bp_open(&p, pk, BP_HEAD_BYTES - 1), BP_ERR_SHORT);
+    pk[0] = 'X';
+    CHECK_EQ(open_now(&p), BP_ERR_MAGIC);
+    pk[0] = 'B';
+    pk[4] = 2;
+    CHECK_EQ(open_now(&p), BP_ERR_VERSION);
+    pk[4] = 1; pk[5] = 11;
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+    pk[5] = 12;
+    CHECK_EQ(open_now(&p), BP_OK);
+}
+
+TEST(breachpack_refuses_a_bad_crc_and_a_flipped_byte)
+{
+    BpPack p;
+    uint32_t i;
+    CHECK(load_file("t3_kit"));
+    CHECK_EQ(open_now(&p), BP_OK);
+    p32(pk + 12, u32(pk + 12) ^ 1);
+    CHECK_EQ(open_now(&p), BP_ERR_CRC);
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_OK);
+    for (i = 16; i < pk_len; i += 37) {        /* a flipped byte anywhere past the crc field */
+        pk[i] ^= 0x10;
+        CHECK_MSG(open_now(&p) != BP_OK, "flip at %u not refused", (unsigned)i);
+        pk[i] ^= 0x10;
+    }
+    CHECK_EQ(open_now(&p), BP_OK);
+}
+
+TEST(breachpack_refuses_total_and_section_ranges)
+{
+    BpPack p;
+    CHECK(load_file("t3_kit"));
+    p32(pk + 8, pk_len + 4);                       /* the pack says it is longer than what was read */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_RANGE);
+    p32(pk + 8, pk_len);
+    p32(pk + 8, BP_PACK_MAX + 4);                  /* over 96 KB */
+    CHECK_EQ(bp_head(&p.head, pk, BP_HEAD_BYTES, BP_PACK_MAX * 2), BP_ERR_RANGE);
+    CHECK(load_file("t3_kit"));
+    p32(sec_ent(BP_SEC_THINGS) + 4, pk_len - 2);   /* starts inside the pack, ends past it */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_RANGE);
+    CHECK(load_file("t3_kit"));
+    p32(sec_ent(BP_SEC_THINGS) + 4, 0xFFFFFFF0u);  /* offset + length wraps */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_RANGE);
+}
+
+TEST(breachpack_refuses_overlapping_sections)
+{
+    BpPack p;
+    CHECK(load_file("t3_kit"));
+    p32(sec_ent(BP_SEC_THINGS) + 4, u32(sec_ent(BP_SEC_CELLS) + 4));     /* things on top of the cells */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_OVERLAP);
+    CHECK(load_file("t3_kit"));
+    p32(sec_ent(BP_SEC_CELLS) + 4, 16);                                  /* a section inside the header */
+    fix_crc();
