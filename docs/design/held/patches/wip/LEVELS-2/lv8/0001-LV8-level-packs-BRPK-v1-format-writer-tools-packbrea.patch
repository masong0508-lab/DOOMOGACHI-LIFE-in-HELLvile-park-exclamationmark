+TEST(breachpack_refuses_counts_over_the_limits)
+{
+    static const struct { int off; int v; const char *what; } c[] = {
+        { 33, DOOMO_ZONE_MAX + 1, "zones" }, { 34, DOOMO_PATH_MAX + 1, "paths" },
+        { 35, DOOMO_SWAP_MAX + 1, "swap sets" }, { 36, DOOMO_TEXBANK_MAX + 1, "texbank slots" },
+        { 16, DOOMO_MAP_MAX_W + 1, "width" }, { 17, DOOMO_MAP_MAX_H + 1, "height" } };
+    BpPack p;
+    unsigned i;
+    for (i = 0; i < sizeof c / sizeof c[0]; i++) {
+        CHECK(load_file("t3_kit"));
+        pk[c[i].off] = (uint8_t)c[i].v;
+        fix_crc();
+        CHECK_MSG(open_now(&p) == BP_ERR_COUNT, "%s over the limit: %d", c[i].what, open_now(&p));
+    }
+    CHECK(load_file("t3_kit"));
+    pk[38] = (BP_THINGS_MAX + 1) & 255; pk[39] = (BP_THINGS_MAX + 1) >> 8;
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+    CHECK(load_file("t3_kit"));
+    pk[40] = 0; pk[41] = 1;                        /* 256 path points (8 x 32 = 256 is the limit: 257 is over) */
+    pk[40] = 1;
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+    CHECK(load_file("t3_kit"));
+    pk[42] = 1; pk[43] = 1;                        /* 257 swap cells */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+    CHECK(load_file("t3_kit"));
+    pk[44] = 1; pk[45] = 8;                        /* 2049 script bytes */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+    CHECK(load_file("t3_kit"));
+    pk[46] = BP_STRINGS_MAX + 1;
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_COUNT);
+}
