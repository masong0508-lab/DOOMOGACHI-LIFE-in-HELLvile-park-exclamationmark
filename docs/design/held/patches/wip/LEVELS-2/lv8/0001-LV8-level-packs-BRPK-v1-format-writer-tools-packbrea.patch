+TEST(breachpack_refuses_bad_encodings)
+{
+    BpPack p;
+    uint32_t off;
+    CHECK(load_file("hellvile"));
+    sec_ent(BP_SEC_CELLS)[1] = 2;
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_ENC);
+    CHECK(load_file("hellvile"));
+    sec_ent(BP_SEC_THINGS)[1] = 1;                  /* only the cells may be LZ */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_ENC);
+    /* a corrupt LZ stream passes the crc and the header and is refused when it is decoded */
+    CHECK(load_file("hellvile"));
+    off = u32(sec_ent(BP_SEC_CELLS) + 4);
+    pk[off] = 0x80; pk[off + 1] = 0xFF; pk[off + 2] = 0xFF;      /* a copy from before the start */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_OK);
+    CHECK_EQ(bp_load(&p, arena, sizeof arena, &lv), BP_ERR_ENC);
+    CHECK(load_file("hellvile"));
+    off = u32(sec_ent(BP_SEC_CELLS) + 8);
+    p32(sec_ent(BP_SEC_CELLS) + 8, off - 1);        /* the stream is one byte shorter than it needs */
+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_OK);
+    CHECK_EQ(bp_load(&p, arena, sizeof arena, &lv), BP_ERR_ENC);
+}
