+# core/data/maps/platforms.txt - which platforms get which level (LV8; tools/mapc.py, tools/packbreach.py).
+#
+#   level ID [map=NAME] [gba yes|no] [ps1 yes|no] [dc yes|no]       defaults: gba no, ps1 yes, dc yes
+#
+# One line per level, 24 at most. The line's index (0-based, counting only `level` lines) is the level id in
+# BREACH.BIN's directory. ID is the plan's number (docs/design/levels/LEVELS_EXPANSION_PLAN.md: HB8-HB16 the
+# main game, N1-N15 New Game+); `map=NAME` names the map file core/data/maps/NAME.txt once the level gets a
+# real name (default: the ID in lowercase). A line whose map file does not exist yet is skipped by the tools.
+#
+# GBA: the 7 of plan 7.1 (`gba yes`), const in the ROM; the rest are compiled out of the GBA build. PS1 and
+# Dreamcast: all 24, as packs in BREACH.BIN (the PS1 never links the const data). The 12 shipped maps are
+# not listed: they are const data in every build.
+# `gba yes` here and `gba yes` in the map's header must agree (packbreach.py --check).
+level hb8  gba yes    # Steam Room Panic
+level hb9  gba yes    # The Undercroft (dark)
+level hb10            # Fright Night at the Fun Fair
+level hb11            # The Glum Pipes (dark)
+level hb12            # The Wall (dark)
+level hb13 gba yes    # Boneyard Buffet & Bandstand
+level hb14            # Hell Pits Highrise
+level hb15 gba yes    # The Department of Contracts
+level hb16            # The Ninth Cloud
+level n1   gba yes    # Day One (dark)
+level n2              # The Dead Letter Office
+level n3              # Repo Night
+level n4              # The Interest Engine
+level n5              # Lake of Fire Regatta
+level n6              # Everything Must Go
+level n7   gba yes    # The Audit
+level n8              # The Debtors' Prison (dark)
+level n9              # The Artist's Studio (dark)
+level n10             # The Ward of Forgotten Names (dark)
+level n11             # The Hollow Mingle (dark)
+level n12             # The Interest
+level n13             # The Vault of Unfelt Things (dark)
+level n14  gba yes    # The Ledger
+level n15             # Both Are Better
diff --git a/core/include/doomo/breachpack.h b/core/include/doomo/breachpack.h
new file mode 100644
index 0000000..94801c0
--- /dev/null
+++ b/core/include/doomo/breachpack.h
@@ -0,0 +1,169 @@
+/* breachpack.h - the level pack ("BRPK" v1) reader (LV8; owner: levels; platform neutral).
+ *
+ * A level that mapc compiled can be delivered as one pack: the PS1 and the Dreamcast read it from the
+ * disc (BREACH.BIN holds up to 24 of them behind a directory), the host tests read it from memory. The
+ * writer is tools/packbreach.py; the format is documented in docs/LEVELS.md ("Level packs") and
+ * core/data/maps/README.md. All numbers are little endian and every field is read one by one (no
+ * struct copy of file bytes: pointer sizes differ between the host, the MIPS and the SH4).
+ *
+ *   header, 80 bytes:   0 'BRPK'   4 version (1)   5 section count (12)   6 u16 zero
+ *                       8 u32 total length   12 u32 crc32 of bytes [16, total)
+ *                       16 w  17 h  18 kind  19 sky  20 music  21 ambient  22 MAPX_* flags  23 fog
+ *                       24 view  25 gravity  26 u16 note  28 detail[3]  31 hero look  32 hero loadout
+ *                       33 zones  34 paths  35 swap sets  36 texbank slots  37 zero
+ *                       38 u16 things  40 u16 path points  42 u16 swap cells  44 u16 script bytes
+ *                       46 u16 string count  48 name[32] (the title, NUL padded)
+ *   section table:      12 entries of 16 bytes at 80: id u8, enc u8 (0 raw, 1 LZ), u16 zero,
+ *                       u32 offset (from the pack start), u32 stored length, u32 raw length
+ *   sections (BP_SEC_*): cells (8 B each, LZ when smaller), things (6), tflags2 (1 per thing), zones (7),
+ *                       paths (6), path points (2), swap sets (6), swap cells (2 + 8), script bytes,
+ *                       text, texbank blob ('LVTB', texbank.h, copied unchanged), sprite bank (reserved
+ *                       for LV7b: empty in v1)
+ *   text section:       u16 count, u16 offset[count] (from the section start), then NUL-terminated
+ *                       strings
+ *
+ * Limits: a pack is at most BP_PACK_MAX (96 KB); what bp_load puts in the arena apart from the cells and
+ * the texture bank (tables + text) is at most BP_ARENA_MAX (12 KB, the PS1 level arena).
+ *
+ * No allocation and no static state: everything lives in the caller's structs and arena. The reader works
+ * on a BpRead callback (a memory blob on the host and the Dreamcast, CD sectors on the PS1) so one code
+ * path serves all of them. */
+#ifndef DOOMO_BREACHPACK_H
+#define DOOMO_BREACHPACK_H
+
+#include "types.h"
+#include "map.h"
+#include "texbank.h"
+
+#define BP_VERSION       1
+#define BP_HDR           80
+#define BP_SEC_ENT       16
+#define BP_SECTIONS      12
+#define BP_HEAD_BYTES    (BP_HDR + BP_SECTIONS * BP_SEC_ENT)   /* 272: header + section table */
+#define BP_PACK_MAX      (96 * 1024)
+#define BP_ARENA_MAX     (12 * 1024)
+#define BP_NAME          32
+#define BP_STRINGS_MAX   64
+#define BP_DIR_MAGIC     "BRBN"
+#define BP_DIR_ENTRIES   24
+#define BP_DIR_HDR       16
+#define BP_DIR_ENT       16
+#define BP_DIR_BYTES     (BP_DIR_HDR + BP_DIR_ENTRIES * BP_DIR_ENT)
+#define BP_THINGS_MAX    256      /* (plan 2.3: new levels have at most 200; hahaland_invaded has 210) */
+#define BP_SCRIPT_MAX    2048     /* plan 8.1 */
+#define BP_TEXT_MAX      4096
+#define BP_SECTOR        2048
+
+enum { BP_SEC_CELLS, BP_SEC_THINGS, BP_SEC_TFLAGS2, BP_SEC_ZONES, BP_SEC_PATHS, BP_SEC_PATHPTS,
+       BP_SEC_SWAPS, BP_SEC_SWAPCELLS, BP_SEC_SCRIPT, BP_SEC_TEXT, BP_SEC_TEXBANK, BP_SEC_SPRITES };
+
+enum { BP_OK = 0, BP_ERR_NULL = -1, BP_ERR_SHORT = -2, BP_ERR_MAGIC = -3, BP_ERR_VERSION = -4,
+       BP_ERR_RANGE = -5,     /* a section lies outside the pack */
+       BP_ERR_OVERLAP = -6,   /* two sections overlap, or one overlaps the header */
+       BP_ERR_COUNT = -7,     /* a count is over its DOOMO_* limit */
+       BP_ERR_CRC = -8,
+       BP_ERR_SIZE = -9,      /* a section's length does not match its count / the map size */
+       BP_ERR_ENC = -10,      /* unknown encoding, or a bad LZ stream */
+       BP_ERR_ARENA = -11,    /* the arena is too small */
+       BP_ERR_READ = -12,     /* the read callback failed */
+       BP_ERR_FIELD = -13,    /* a header field is out of range (kind, sky, ambient, flags...) */
+       BP_ERR_TEXT = -14,     /* the text table is malformed */
+       BP_ERR_DIR = -15,      /* BREACH.BIN directory */
+       BP_ERR_NOLEVEL = -16 };/* the directory has no such level */
+
+typedef struct BpSec {
+    uint8_t  enc;             /* 0 raw, 1 LZ */
+    uint32_t off, stored, raw;
+} BpSec;
+
+/* The validated header of a pack. Plain data: a caller may keep it. */
+typedef struct BpHead {
+    uint32_t total, crc;
+    char     name[BP_NAME];
+    uint8_t  w, h, kind, sky, music, ambient, xflags, fog, view, gravity;
+    uint16_t note;
+    uint8_t  detail[3], hero_look, hero_loadout;
+    uint8_t  zone_count, path_count, swap_count, texbank_count;
+    uint16_t thing_count, pathpt_count, swapcell_count, script_len, string_count;
+    BpSec    sec[BP_SECTIONS];
+} BpHead;
+
+/* Reads `n` bytes at `off` of the pack into dst. Returns 1, 0 on failure. */
+typedef int (*BpRead)(void *ctx, uint32_t off, void *dst, uint32_t n);
+
+/* A level, loaded. def / ext point into the arena (and at `cells`); keep the arena alive while it runs. */
+typedef struct BpLevel {
+    DoomoMapDef  def;
+    DoomoMapExt  ext;
+    const char  *strings[BP_STRINGS_MAX];     /* the text section, NULL past string_count */
+    uint8_t      string_count;
+    uint32_t     tb_off, tb_len;              /* the texture bank blob (0 len: none): its offset from the start of the
+                                               * pack, or of the BREACH.BIN after bp_bin_load */
+    uint32_t     used;                        /* arena bytes in use */
+} BpLevel;
+
+/* Parse and validate a header + section table from `n` bytes (>= BP_HEAD_BYTES). `pack_len` is the length
+ * of the pack as the directory (or the file) says; every section must lie inside both it and h->total.
+ * Does NOT check the crc (it needs the whole pack: bp_crc_check / bp_open). */
+int  bp_head(BpHead *h, const uint8_t *buf, uint32_t n, uint32_t pack_len);
+/* crc32 of the pack's bytes [16, total) through the callback, `chunk` (>= 16 B, <= 2048 B) is the scratch.
+ * BP_OK or BP_ERR_CRC / BP_ERR_READ. */
+int  bp_crc_check(const BpHead *h, BpRead rd, void *ctx, uint8_t *chunk, uint32_t chunk_len);
+
+/* Where the cells go (bp_load_mode, bp_arena_need):
+ *   BP_CELLS_DST    decoded into a caller's buffer (w * h cells)
+ *   BP_CELLS_ARENA  decoded into the arena
+ *   BP_CELLS_LZMC   the PS1: left packed in the arena as "LZMC", u32 cell count, the LZ stream, which def.cells
+ *                   then points at: its map_def_cells() (ps1/src/packart.c) decodes that straight into the
+ *                   live map, so no resident code changes (a grid stored raw is simply a plain copy) */
+enum { BP_CELLS_DST = 0, BP_CELLS_ARENA = 1, BP_CELLS_LZMC = 2 };
+
+/* Arena bytes the load needs (peak): tables + text, + the cells for ARENA / LZMC, + the scratch the
+ * conversions read through while they run. */
+uint32_t bp_arena_need(const BpHead *h, int mode);
+/* The part of that which stays resident, tables + text only (at most BP_ARENA_MAX). */
+uint32_t bp_tables_bytes(const BpHead *h);
+
+/* Build the level from a pack read through `rd`. Cells go to cells_dst (w*h cells, e.g. doomo_map.cells
+ * on the PS1) or, if NULL, into the arena. The arena is 4-byte aligned by the caller. */
+int  bp_load_read(const BpHead *h, BpRead rd, void *ctx, void *arena, uint32_t arena_len,
+                  DoomoCell *cells_dst, BpLevel *out);
+int  bp_load_mode(const BpHead *h, BpRead rd, void *ctx, void *arena, uint32_t arena_len, int mode,
+                  DoomoCell *cells_dst, BpLevel *out);
+
+/* The same for a pack in memory: open validates everything (header, section table, crc) and
+ * bp_load builds the level. */
+typedef struct BpPack { const uint8_t *blob; uint32_t len; BpHead head; } BpPack;
+int  bp_open(BpPack *p, const uint8_t *blob, uint32_t len);
+int  bp_load(const BpPack *p, void *arena, uint32_t arena_len, BpLevel *out);
+/* The raw bytes of a stored-raw section (the texture bank, the sprite bank) inside an open pack, NULL if
+ * the section is empty or compressed. */
+const uint8_t *bp_section(const BpPack *p, int sec, uint32_t *len);
+
+/* BREACH.BIN directory (16-byte header + 24 entries of 16 bytes), read from the first sector.
+ *   'BRBN', u8 version 1, u8 count, u16 zero, u32 total file length, u32 zero
+ *   entry: u16 level id, u8 platforms (BP_PLAT_*), u8 zero, u32 offset (sector aligned), u32 length, u32 crc
+ * (the crc is the pack's own crc field, so a reader can compare before it reads the pack). */
+enum { BP_PLAT_GBA = 1, BP_PLAT_PS1 = 2, BP_PLAT_DC = 4 };
+typedef struct BpDirEnt { uint16_t level; uint8_t plats; uint32_t off, len, crc; } BpDirEnt;
+typedef struct BpDir { uint8_t count; uint32_t total; BpDirEnt ent[BP_DIR_ENTRIES]; } BpDir;
+int  bp_dir(BpDir *d, const uint8_t *buf, uint32_t n, uint32_t file_len);
+/* The entry of a level id, NULL if the directory has none. */
+const BpDirEnt *bp_dir_find(const BpDir *d, int level);
+
+/* Load a level straight from a BREACH.BIN read through `rd` (offsets from the start of the file, file_len bytes):
+ * directory, header, crc, then bp_load_mode. `*need` (if not NULL) gets the arena bytes the level wants (also on
+ * BP_ERR_ARENA, so a caller can retry or give up). Uses about 1.2 KB of the caller's stack for the directory,
+ * the header and the crc chunk. BP_ERR_NOLEVEL if the directory has no such level. */
+int  bp_bin_load(BpRead rd, void *ctx, uint32_t file_len, int level, int mode, void *arena, uint32_t arena_len,
+                 DoomoCell *cells_dst, uint32_t *need, BpLevel *out);
+
+/* The platform side (PS1: ps1/src/breachdisc.c, Dreamcast: dc/src/breachdisc.c): the level `level` of the disc's
+ * BREACH.BIN, ready for map_load_def() (def->cells is valid while the arena lives). Built only where the disc has
+ * a BREACH.BIN (DOOMO_BREACH_BIN); the platforms that carry levels as const data have no such function. Returns
+ * BP_OK or a BP_ERR_*; on BP_OK `*def` / `*ext` stay valid until the next call. */
+int  plat_breach_level(int level, const DoomoMapDef **def, const DoomoMapExt **ext);
+
+const char *bp_strerror(int err);
+
+#endif
diff --git a/core/src/breachpack.c b/core/src/breachpack.c
new file mode 100644
index 0000000..7aff96f
--- /dev/null
+++ b/core/src/breachpack.c
@@ -0,0 +1,570 @@
+/* breachpack.c - the level pack ("BRPK" v1) reader (LV8; owner: levels). See doomo/breachpack.h.
+ * Platform neutral: no allocation, no static state, no libc but memcpy / memset. */
+#include <string.h>
+#include "doomo/breachpack.h"
+
+/* ---- little endian fields ---- */
+static unsigned rd16(const uint8_t *p) { return (unsigned)p[0] | ((unsigned)p[1] << 8); }
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* crc32 (IEEE, reflected, as save_crc32) with a 16-entry table built from the nibble: no big table */
+static uint32_t crc_step(uint32_t c, const uint8_t *b, uint32_t n)
+{
+    static const uint32_t t[16] = {
+        0x00000000u, 0x1DB71064u, 0x3B6E20C8u, 0x26D930ACu, 0x76DC4190u, 0x6B6B51F4u, 0x4DB26158u, 0x5005713Cu,
+        0xEDB88320u, 0xF00F9344u, 0xD6D6A3E8u, 0xCB61B38Cu, 0x9B64C2B0u, 0x86D3D2D4u, 0xA00AE278u, 0xBDBDF21Cu };
+    while (n--) {
+        c ^= *b++;
+        c = (c >> 4) ^ t[c & 15];
+        c = (c >> 4) ^ t[c & 15];
+    }
+    return c;
+}
+
+const char *bp_strerror(int e)
+{
+    switch (e) {
+    case BP_OK: return "ok";
+    case BP_ERR_NULL: return "null argument";
+    case BP_ERR_SHORT: return "pack too short";
+    case BP_ERR_MAGIC: return "bad magic";
+    case BP_ERR_VERSION: return "unknown version";
+    case BP_ERR_RANGE: return "section out of range";
+    case BP_ERR_OVERLAP: return "sections overlap";
+    case BP_ERR_COUNT: return "count over its limit";
+    case BP_ERR_CRC: return "bad crc";
+    case BP_ERR_SIZE: return "section length does not match its count";
+    case BP_ERR_ENC: return "bad encoding";
+    case BP_ERR_ARENA: return "arena too small";
+    case BP_ERR_READ: return "read failed";
+    case BP_ERR_FIELD: return "header field out of range";
+    case BP_ERR_TEXT: return "bad text table";
+    case BP_ERR_DIR: return "bad directory";
+    case BP_ERR_NOLEVEL: return "no such level";
+    }
+    return "?";
+}
+
+/* serialized sizes */
+#define S_CELL 8
+#define S_THING 6
+#define S_ZONE 7
+#define S_PATH 6
+#define S_SWAP 6
+#define S_SWAPCELL 10
+
+int bp_head(BpHead *h, const uint8_t *b, uint32_t n, uint32_t pack_len)
+{
+    BpHead t;
+    int i, j;
+    memset(&t, 0, sizeof t);
+    if (!h || !b) return BP_ERR_NULL;
+    if (n < BP_HEAD_BYTES || pack_len < BP_HEAD_BYTES) return BP_ERR_SHORT;
+    if (b[0] != 'B' || b[1] != 'R' || b[2] != 'P' || b[3] != 'K') return BP_ERR_MAGIC;
+    if (b[4] != BP_VERSION) return BP_ERR_VERSION;
+    if (b[5] != BP_SECTIONS) return BP_ERR_COUNT;
+    t.total = rd32(b + 8);
+    t.crc = rd32(b + 12);
+    if (t.total < BP_HEAD_BYTES || t.total > pack_len || t.total > BP_PACK_MAX) return BP_ERR_RANGE;
+    t.w = b[16]; t.h = b[17]; t.kind = b[18]; t.sky = b[19]; t.music = b[20]; t.ambient = b[21];
+    t.xflags = b[22]; t.fog = b[23]; t.view = b[24]; t.gravity = b[25];
+    t.note = (uint16_t)rd16(b + 26);
+    t.detail[0] = b[28]; t.detail[1] = b[29]; t.detail[2] = b[30];
+    t.hero_look = b[31]; t.hero_loadout = b[32];
+    t.zone_count = b[33]; t.path_count = b[34]; t.swap_count = b[35]; t.texbank_count = b[36];
+    t.thing_count = (uint16_t)rd16(b + 38);
+    t.pathpt_count = (uint16_t)rd16(b + 40);
+    t.swapcell_count = (uint16_t)rd16(b + 42);
+    t.script_len = (uint16_t)rd16(b + 44);
+    t.string_count = (uint16_t)rd16(b + 46);
+    memcpy(t.name, b + 48, BP_NAME);
+    if (t.w < 1 || t.h < 1 || t.kind > MAP_ARENA || t.ambient > 15 || (t.xflags & ~(MAPX_DARK | MAPX_GBA | MAPX_HERO)))
+        return BP_ERR_FIELD;
+    if (b[6] || b[7] || b[37] || t.name[BP_NAME - 1]) return BP_ERR_FIELD;
+    for (i = 0; i < 3; i++) if (t.detail[i] >= MDET_COUNT) return BP_ERR_FIELD;
+    if (t.w > DOOMO_MAP_MAX_W || t.h > DOOMO_MAP_MAX_H || t.zone_count > DOOMO_ZONE_MAX ||
+        t.path_count > DOOMO_PATH_MAX || t.pathpt_count > DOOMO_PATH_MAX * DOOMO_PATH_POINTS ||
+        t.swap_count > DOOMO_SWAP_MAX || t.swapcell_count > DOOMO_SWAP_CELLS_MAX ||
+        t.texbank_count > DOOMO_TEXBANK_MAX || t.thing_count > BP_THINGS_MAX ||
+        t.script_len > BP_SCRIPT_MAX || t.string_count > BP_STRINGS_MAX)
+        return BP_ERR_COUNT;
+    if ((t.path_count == 0) != (t.pathpt_count == 0) || (t.path_count && t.pathpt_count < 2u * t.path_count))
+        return BP_ERR_COUNT;
+    if ((t.swap_count == 0) != (t.swapcell_count == 0) || t.swapcell_count < t.swap_count)
+        return BP_ERR_COUNT;
+    for (i = 0; i < BP_SECTIONS; i++) {
+        const uint8_t *e = b + BP_HDR + i * BP_SEC_ENT;
+        BpSec *s = &t.sec[i];
+        uint32_t want = 0;
+        int exact = 1;
+        if (e[0] != i || rd16(e + 2)) return BP_ERR_FIELD;
+        if (e[1] > 1) return BP_ERR_ENC;
+        s->enc = e[1];
+        s->off = rd32(e + 4);
+        s->stored = rd32(e + 8);
+        s->raw = rd32(e + 12);
+        switch (i) {
+        case BP_SEC_CELLS: want = (uint32_t)t.w * t.h * S_CELL; break;
+        case BP_SEC_THINGS: want = (uint32_t)t.thing_count * S_THING; break;
+        case BP_SEC_TFLAGS2: want = s->raw ? t.thing_count : 0; break;       /* none, or one per thing */
+        case BP_SEC_ZONES: want = (uint32_t)t.zone_count * S_ZONE; break;
+        case BP_SEC_PATHS: want = (uint32_t)t.path_count * S_PATH; break;
+        case BP_SEC_PATHPTS: want = (uint32_t)t.pathpt_count * 2; break;
+        case BP_SEC_SWAPS: want = (uint32_t)t.swap_count * S_SWAP; break;
+        case BP_SEC_SWAPCELLS: want = (uint32_t)t.swapcell_count * S_SWAPCELL; break;
+        case BP_SEC_SCRIPT: want = t.script_len; break;
+        case BP_SEC_TEXT: exact = 0; if (s->raw > BP_TEXT_MAX) return BP_ERR_SIZE; break;
+        case BP_SEC_TEXBANK:                  /* the names of the ids 56.. then the 'LVTB' blob */
+            want = 0; exact = 0;
+            if (!t.texbank_count) { if (s->raw) return BP_ERR_SIZE; }
+            else if (s->raw < DOOMO_TEXBANK_NAME * (uint32_t)t.texbank_count + DOOMO_TEXBANK_HDR + DOOMO_TEXBANK_ENT ||
+                     s->raw > DOOMO_TEXBANK_NAME * (uint32_t)t.texbank_count + DOOMO_TEXBANK_HDR +
+                              (DOOMO_TEXBANK_ENT + 4096 * DOOMO_TEXBANK_FRAMES_MAX) * (uint32_t)DOOMO_TEXBANK_MAX)
+                return BP_ERR_SIZE;
+            break;
+        default: want = 0; break;                                                /* sprites: empty in v1 */
+        }
+        if (i != BP_SEC_CELLS && s->enc) return BP_ERR_ENC;
+        if (exact && s->raw != want) return BP_ERR_SIZE;
+        if (s->enc == 0 && s->stored != s->raw) return BP_ERR_SIZE;
+        if (s->enc == 1 && (s->stored == 0 || s->stored > s->raw + (s->raw >> 6) + 8)) return BP_ERR_ENC;
+        if (s->stored == 0) {
+            if (s->off || s->raw) return BP_ERR_SIZE;
+            continue;
+        }
+        if (s->off < BP_HEAD_BYTES) return BP_ERR_OVERLAP;
+        if (s->off > t.total || s->stored > t.total - s->off) return BP_ERR_RANGE;
+    }
+    for (i = 0; i < BP_SECTIONS; i++)
+        for (j = i + 1; j < BP_SECTIONS; j++) {
+            const BpSec *a = &t.sec[i], *c = &t.sec[j];
+            if (!a->stored || !c->stored) continue;
+            if (a->off < c->off + c->stored && c->off < a->off + a->stored) return BP_ERR_OVERLAP;
+        }
+    if (bp_tables_bytes(&t) > BP_ARENA_MAX) return BP_ERR_ARENA;
+    *h = t;
+    return BP_OK;
+}
+
+int bp_crc_check(const BpHead *h, BpRead rd, void *ctx, uint8_t *chunk, uint32_t chunk_len)
+{
+    uint32_t pos = 16, c = 0xFFFFFFFFu;
+    if (!h || !rd || !chunk || chunk_len < 16) return BP_ERR_NULL;
+    while (pos < h->total) {
+        uint32_t n = h->total - pos;
+        if (n > chunk_len) n = chunk_len;
+        if (!rd(ctx, pos, chunk, n)) return BP_ERR_READ;
+        c = crc_step(c, chunk, n);
+        pos += n;
+    }
+    return (c ^ 0xFFFFFFFFu) == h->crc ? BP_OK : BP_ERR_CRC;
+}
+
+/* ---- the arena layout ---- */
+#define AL(x) (((x) + 3u) & ~3u)
+
+typedef struct Lay {
+    uint32_t name, things, tflags2, zones, paths, pts, swaps, swapcells, script, tbnames, text, cells;
+    uint32_t tables;            /* end of the resident part */
+    uint32_t scratch, need;
+} Lay;
+
+static void layout(const BpHead *h, int mode, Lay *l)
+{
+    uint32_t o = 0, sc = 0, v;
+    l->name = o;        o = AL(o + BP_NAME);
+    l->things = o;      o = AL(o + (uint32_t)h->thing_count * sizeof(DoomoThing));
+    l->tflags2 = o;     o = AL(o + h->sec[BP_SEC_TFLAGS2].raw);
+    l->zones = o;       o = AL(o + (uint32_t)h->zone_count * sizeof(DoomoZone));
+    l->paths = o;       o = AL(o + (uint32_t)h->path_count * sizeof(DoomoPath));
+    l->pts = o;         o = AL(o + (uint32_t)h->pathpt_count * 2);
+    l->swaps = o;       o = AL(o + (uint32_t)h->swap_count * sizeof(DoomoSwapSet));
+    l->swapcells = o;   o = AL(o + (uint32_t)h->swapcell_count * sizeof(DoomoSwapCell));
+    l->script = o;      o = AL(o + h->script_len);
+    l->tbnames = o;     o = AL(o + (uint32_t)h->texbank_count * DOOMO_TEXBANK_NAME);
+    l->text = o;        o = AL(o + h->sec[BP_SEC_TEXT].raw);
+    l->tables = o;
+    l->cells = o;
+    if (mode == BP_CELLS_ARENA) o = AL(o + h->sec[BP_SEC_CELLS].raw);
+    else if (mode == BP_CELLS_LZMC)
+        o = AL(o + (h->sec[BP_SEC_CELLS].enc ? 8 + h->sec[BP_SEC_CELLS].stored : h->sec[BP_SEC_CELLS].raw));
+    /* the scratch the conversions read their raw bytes into, then released */
+    v = (h->sec[BP_SEC_CELLS].enc && mode != BP_CELLS_LZMC) ? h->sec[BP_SEC_CELLS].stored : 0;
+    if (v > sc) sc = v;
+    v = h->sec[BP_SEC_THINGS].raw; if (v > sc) sc = v;
+    v = h->sec[BP_SEC_ZONES].raw; if (v > sc) sc = v;
+    v = h->sec[BP_SEC_PATHS].raw; if (v > sc) sc = v;
+    v = h->sec[BP_SEC_SWAPS].raw; if (v > sc) sc = v;
+    v = h->sec[BP_SEC_SWAPCELLS].raw; if (v > sc) sc = v;
+    v = (uint32_t)h->texbank_count * DOOMO_TEXBANK_ENT; if (v > sc) sc = v;
+    l->scratch = o;
+    l->need = AL(o + sc);
+}
+
+uint32_t bp_tables_bytes(const BpHead *h)
+{
+    Lay l;
+    layout(h, BP_CELLS_DST, &l);
+    return l.tables;
+}
+
+uint32_t bp_arena_need(const BpHead *h, int mode)
+{
+    Lay l;
+    layout(h, mode, &l);
+    return l.need;
+}
+
+/* the save codec's LZ (ps1/tools/packart.py): c < 0x80 -> c+1 literals; else copy (c&0x7F)+3 from u16 distance */
+static int unlz(const uint8_t *s, uint32_t sn, uint8_t *d, uint32_t dn)
+{
+    uint32_t i = 0, o = 0;
+    while (o < dn) {
+        unsigned c;
+        if (i >= sn) return 0;
+        c = s[i++];
+        if (c < 0x80) {
+            unsigned k = c + 1;
+            if (k > sn - i || k > dn - o) return 0;
+            memcpy(d + o, s + i, k);
+            i += k; o += k;
+        } else {
+            unsigned k = (c & 0x7F) + 3, dist, m;
+            if (sn - i < 2) return 0;
+            dist = rd16(s + i);
+            i += 2;
+            if (dist < 1 || dist > o || k > dn - o) return 0;
+            for (m = 0; m < k; m++, o++) d[o] = d[o - dist];
+        }
+    }
+    return i == sn;
+}
+
+static int rd_sec(BpRead rd, void *ctx, const BpHead *h, int sec, uint32_t at, void *dst, uint32_t n)
+{
+    return rd(ctx, h->sec[sec].off + at, dst, n) ? BP_OK : BP_ERR_READ;
+}
+
+int bp_load_read(const BpHead *h, BpRead rd, void *ctx, void *arena, uint32_t arena_len,
+                 DoomoCell *cells_dst, BpLevel *out)
+{
+    return bp_load_mode(h, rd, ctx, arena, arena_len, cells_dst ? BP_CELLS_DST : BP_CELLS_ARENA, cells_dst, out);
+}
+
+int bp_load_mode(const BpHead *h, BpRead rd, void *ctx, void *arena, uint32_t arena_len, int mode,
+                 DoomoCell *cells_dst, BpLevel *out)
+{
+    Lay l;
+    uint8_t *a = (uint8_t *)arena, *sc;
+    uint32_t i, ncell;
+    int e;
+    DoomoThing *things;
+    DoomoZone *zones;
+    DoomoPath *paths;
+    DoomoSwapSet *swaps;
+    DoomoSwapCell *scells;
+    uint8_t *pts;
+    DoomoCell *cells;
+    if (!h || !rd || !arena || !out) return BP_ERR_NULL;
+    if (mode < BP_CELLS_DST || mode > BP_CELLS_LZMC || (mode == BP_CELLS_DST && !cells_dst)) return BP_ERR_NULL;
+    layout(h, mode, &l);
+    if (((uintptr_t)arena & 3u) || arena_len < l.need) return BP_ERR_ARENA;
+    ncell = (uint32_t)h->w * h->h;
+    sc = a + l.scratch;
+    memset(out, 0, sizeof *out);
+
+    /* cells */
+    cells = mode == BP_CELLS_DST ? cells_dst : (DoomoCell *)(void *)(a + l.cells);
+    if (mode == BP_CELLS_LZMC && h->sec[BP_SEC_CELLS].enc) {
+        /* the PS1 keeps the grid packed: "LZMC", u32 cell count, the LZ stream (ps1/tools/packmaps.py), which its
+         * map_def_cells() decodes straight into the live map */
+        uint8_t *q = a + l.cells;
+        q[0] = 'L'; q[1] = 'Z'; q[2] = 'M'; q[3] = 'C';
+        q[4] = (uint8_t)ncell; q[5] = (uint8_t)(ncell >> 8); q[6] = (uint8_t)(ncell >> 16); q[7] = (uint8_t)(ncell >> 24);
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_CELLS, 0, q + 8, h->sec[BP_SEC_CELLS].stored)) != BP_OK) return e;
+    } else if (h->sec[BP_SEC_CELLS].enc) {
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_CELLS, 0, sc, h->sec[BP_SEC_CELLS].stored)) != BP_OK) return e;
+        if (!unlz(sc, h->sec[BP_SEC_CELLS].stored, (uint8_t *)(void *)cells, ncell * S_CELL)) return BP_ERR_ENC;
+    } else if ((e = rd_sec(rd, ctx, h, BP_SEC_CELLS, 0, cells, ncell * S_CELL)) != BP_OK) return e;
+    /* DoomoCell is 8 single-byte fields: the decoded bytes are the cells on every machine */
+
+    /* things */
+    things = (DoomoThing *)(void *)(a + l.things);
+    if (h->thing_count) {
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_THINGS, 0, sc, h->sec[BP_SEC_THINGS].raw)) != BP_OK) return e;
+        for (i = 0; i < h->thing_count; i++) {
+            const uint8_t *p = sc + i * S_THING;
+            if (p[0] >= h->w || p[1] >= h->h) return BP_ERR_FIELD;
+            things[i].x = p[0]; things[i].y = p[1]; things[i].type = p[2];
+            things[i].angle = p[3]; things[i].arg = p[4]; things[i].flags = p[5];
+        }
+    }
+    if (h->sec[BP_SEC_TFLAGS2].raw &&
+        (e = rd_sec(rd, ctx, h, BP_SEC_TFLAGS2, 0, a + l.tflags2, h->thing_count)) != BP_OK) return e;
+    /* zones */
+    zones = (DoomoZone *)(void *)(a + l.zones);
+    if (h->zone_count) {
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_ZONES, 0, sc, h->sec[BP_SEC_ZONES].raw)) != BP_OK) return e;
+        for (i = 0; i < h->zone_count; i++) {
+            const uint8_t *p = sc + i * S_ZONE;
+            if (p[0] > p[2] || p[1] > p[3] || p[2] >= h->w || p[3] >= h->h || p[4] >= ZONE_COUNT)
+                return BP_ERR_FIELD;
+            zones[i].x0 = p[0]; zones[i].y0 = p[1]; zones[i].x1 = p[2]; zones[i].y1 = p[3];
+            zones[i].kind = p[4]; zones[i].arg = p[5]; zones[i].tag = p[6];
+        }
+    }
+    /* path points, then paths */
+    pts = a + l.pts;
+    if (h->pathpt_count) {
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_PATHPTS, 0, pts, h->sec[BP_SEC_PATHPTS].raw)) != BP_OK) return e;
+        for (i = 0; i < h->pathpt_count; i++)
+            if (pts[2 * i] >= h->w || pts[2 * i + 1] >= h->h) return BP_ERR_FIELD;
+    }
+    paths = (DoomoPath *)(void *)(a + l.paths);
+    if (h->path_count) {
+        uint32_t next = 0;
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_PATHS, 0, sc, h->sec[BP_SEC_PATHS].raw)) != BP_OK) return e;
+        for (i = 0; i < h->path_count; i++) {
+            const uint8_t *p = sc + i * S_PATH;
+            uint32_t first = rd16(p + 4);
+            if (p[1] >= MPATH_COUNT || p[2] < 2 || p[2] > DOOMO_PATH_POINTS || p[3] ||
+                first != next || first + p[2] > h->pathpt_count)
+                return BP_ERR_FIELD;
+            paths[i].id = p[0]; paths[i].kind = p[1]; paths[i].count = p[2]; paths[i].reserved = 0;
+            paths[i].first = (uint16_t)first;
+            next = first + p[2];
+        }
+        if (next != h->pathpt_count) return BP_ERR_FIELD;
+    }
+    /* swap cells, then sets */
+    scells = (DoomoSwapCell *)(void *)(a + l.swapcells);
+    if (h->swapcell_count) {
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_SWAPCELLS, 0, sc, h->sec[BP_SEC_SWAPCELLS].raw)) != BP_OK) return e;
+        for (i = 0; i < h->swapcell_count; i++) {
+            const uint8_t *p = sc + i * S_SWAPCELL;
+            if (rd16(p) >= ncell) return BP_ERR_FIELD;
+            scells[i].cell = (uint16_t)rd16(p);
+            memcpy(scells[i].x, p + 2, 8);
+        }
+    }
+    swaps = (DoomoSwapSet *)(void *)(a + l.swaps);
+    if (h->swap_count) {
+        uint32_t next = 0;
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_SWAPS, 0, sc, h->sec[BP_SEC_SWAPS].raw)) != BP_OK) return e;
+        for (i = 0; i < h->swap_count; i++) {
+            const uint8_t *p = sc + i * S_SWAP;
+            uint32_t first = rd16(p), cnt = rd16(p + 2);
+            if (first != next || cnt < 1 || first + cnt > h->swapcell_count || p[4] >= MSWAP_COUNT)
+                return BP_ERR_FIELD;
+            swaps[i].first = (uint16_t)first; swaps[i].count = (uint16_t)cnt;
+            swaps[i].mode = p[4]; swaps[i].event = p[5];
+            next = first + cnt;
+        }
+        if (next != h->swapcell_count) return BP_ERR_FIELD;
+    }
+    /* script */
+    if (h->script_len &&
+        (e = rd_sec(rd, ctx, h, BP_SEC_SCRIPT, 0, a + l.script, h->script_len)) != BP_OK) return e;
+    /* texture bank: the names of the ids 56.. stay resident (empty = unused id); the blob's pixels are the
+     * loader's (the PS1 pins them in the world-texture slots) */
+    if (h->texbank_count) {
+        uint8_t hd[DOOMO_TEXBANK_HDR];
+        uint32_t k, m, nb = (uint32_t)h->texbank_count * DOOMO_TEXBANK_NAME, any = 0;
+        uint8_t *nm = a + l.tbnames;
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_TEXBANK, 0, nm, nb)) != BP_OK) return e;
+        for (k = 0; k < h->texbank_count; k++) {
+            const uint8_t *p = nm + k * DOOMO_TEXBANK_NAME;
+            for (m = 0; m < DOOMO_TEXBANK_NAME; m++)
+                if (p[m] && !((p[m] >= 'a' && p[m] <= 'z') || (p[m] >= '0' && p[m] <= '9') || p[m] == '_'))
+                    return BP_ERR_FIELD;
+            if (p[DOOMO_TEXBANK_NAME - 1]) return BP_ERR_FIELD;
+            any |= p[0];
+        }
+        if (!any) return BP_ERR_FIELD;
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_TEXBANK, nb, hd, sizeof hd)) != BP_OK) return e;
+        if (hd[0] != 'L' || hd[1] != 'V' || hd[2] != 'T' || hd[3] != 'B' || hd[4] != DOOMO_TEXBANK_VERSION ||
+            rd32(hd + 8) != h->sec[BP_SEC_TEXBANK].raw - nb)
+            return BP_ERR_FIELD;
+        out->tb_off = h->sec[BP_SEC_TEXBANK].off + nb;
+        out->tb_len = h->sec[BP_SEC_TEXBANK].raw - nb;
+    }
+    /* text */
+    if (h->sec[BP_SEC_TEXT].raw) {
+        uint8_t *t = a + l.text;
+        uint32_t n = h->sec[BP_SEC_TEXT].raw, cnt, k, floor_;
+        if ((e = rd_sec(rd, ctx, h, BP_SEC_TEXT, 0, t, n)) != BP_OK) return e;
+        if (n < 2) return BP_ERR_TEXT;
+        cnt = rd16(t);
+        floor_ = 2 + 2 * cnt;
+        if (cnt != h->string_count || floor_ > n || t[n - 1]) return BP_ERR_TEXT;
+        for (k = 0; k < cnt; k++) {
+            uint32_t off = rd16(t + 2 + 2 * k);
+            if (off < floor_ || off >= n || (k && off <= rd16(t + 2 * k))) return BP_ERR_TEXT;
+            if (k && t[off - 1]) return BP_ERR_TEXT;      /* the previous string ends right before */
+            out->strings[k] = (const char *)t + off;
+        }
+    } else if (h->string_count) return BP_ERR_TEXT;
+    out->string_count = (uint8_t)h->string_count;
+
+    /* the definition and its ext */
+    memcpy(a + l.name, h->name, BP_NAME);
+    out->def.name = (const char *)(a + l.name);
+    out->def.w = h->w; out->def.h = h->h; out->def.kind = h->kind; out->def.sky = h->sky;
+    out->def.music = h->music; out->def.ambient = h->ambient;
+    out->def.cells = cells;
+    out->def.things = h->thing_count ? things : NULL;
+    out->def.thing_count = h->thing_count;
+    out->ext.def = &out->def;
+    out->ext.flags = h->xflags; out->ext.fog = h->fog; out->ext.view = h->view; out->ext.gravity = h->gravity;
+    out->ext.note = h->note;
+    out->ext.detail[0] = h->detail[0]; out->ext.detail[1] = h->detail[1]; out->ext.detail[2] = h->detail[2];
+    out->ext.hero_look = h->hero_look; out->ext.hero_loadout = h->hero_loadout;
+    out->ext.zone_count = h->zone_count; out->ext.path_count = h->path_count;
+    out->ext.swap_count = h->swap_count; out->ext.texbank_count = h->texbank_count;
+    out->ext.zones = h->zone_count ? zones : NULL;
+    out->ext.paths = h->path_count ? paths : NULL;
+    out->ext.path_pts = h->path_count ? pts : NULL;
+    out->ext.swaps = h->swap_count ? swaps : NULL;
+    out->ext.swap_cells = h->swap_count ? scells : NULL;
+    out->ext.texbank = h->texbank_count ? (const char (*)[DOOMO_TEXBANK_NAME])(void *)(a + l.tbnames) : NULL;
+    out->ext.tflags2 = h->sec[BP_SEC_TFLAGS2].raw ? a + l.tflags2 : NULL;
+    out->ext.script = h->script_len ? a + l.script : NULL;
+    out->ext.script_len = h->script_len;
+    out->used = mode == BP_CELLS_ARENA ? l.scratch : mode == BP_CELLS_LZMC ? l.scratch : l.tables;
+    return BP_OK;
+}
+
+/* ---- a pack in memory ---- */
+typedef struct MemCtx { const uint8_t *b; uint32_t n; } MemCtx;
+static int mem_rd(void *ctx, uint32_t off, void *dst, uint32_t n)
+{
+    const MemCtx *m = (const MemCtx *)ctx;
+    if (off > m->n || n > m->n - off) return 0;
+    memcpy(dst, m->b + off, n);
+    return 1;
+}
+
+int bp_open(BpPack *p, const uint8_t *blob, uint32_t len)
+{
+    BpHead h;
+    uint32_t c;
+    int e;
+    if (!p || !blob) return BP_ERR_NULL;
+    if ((e = bp_head(&h, blob, len, len)) != BP_OK) return e;
+    c = crc_step(0xFFFFFFFFu, blob + 16, h.total - 16) ^ 0xFFFFFFFFu;
+    if (c != h.crc) return BP_ERR_CRC;
+    if (h.texbank_count) {
+        DoomoTexBank tb;
+        uint32_t nb = (uint32_t)h.texbank_count * DOOMO_TEXBANK_NAME, k;
+        const uint8_t *base = blob + h.sec[BP_SEC_TEXBANK].off;
+        if (texbank_open(&tb, base + nb, h.sec[BP_SEC_TEXBANK].raw - nb) != TB_OK) return BP_ERR_FIELD;
+        for (k = 0; k < h.texbank_count; k++)       /* id 56 + k answers from slot k (texbank.c): a name is that slot's */
+            if (base[k * DOOMO_TEXBANK_NAME] &&
+                texbank_slot(&tb, (const char *)base + k * DOOMO_TEXBANK_NAME) != (int)k)
+                return BP_ERR_FIELD;
+    }
+    p->blob = blob;
+    p->len = len;
+    p->head = h;
+    return BP_OK;
+}
+
+int bp_load(const BpPack *p, void *arena, uint32_t arena_len, BpLevel *out)
+{
+    MemCtx m;
+    if (!p || !p->blob) return BP_ERR_NULL;
+    m.b = p->blob; m.n = p->len;
+    return bp_load_read(&p->head, mem_rd, &m, arena, arena_len, NULL, out);
+}
+
+const uint8_t *bp_section(const BpPack *p, int sec, uint32_t *len)
+{
+    const BpSec *s;
+    if (len) *len = 0;
+    if (!p || sec < 0 || sec >= BP_SECTIONS) return NULL;
+    s = &p->head.sec[sec];
+    if (!s->stored || s->enc) return NULL;
+    if (len) *len = s->raw;
+    return p->blob + s->off;
+}
+
+/* ---- BREACH.BIN directory ---- */
+int bp_dir(BpDir *d, const uint8_t *b, uint32_t n, uint32_t file_len)
+{
+    BpDir t;
+    uint32_t i, j;
+    memset(&t, 0, sizeof t);
+    if (!d || !b) return BP_ERR_NULL;
+    if (n < BP_DIR_BYTES) return BP_ERR_SHORT;
+    if (memcmp(b, BP_DIR_MAGIC, 4)) return BP_ERR_MAGIC;
+    if (b[4] != 1) return BP_ERR_VERSION;
+    if (b[5] > BP_DIR_ENTRIES) return BP_ERR_COUNT;
+    if (rd16(b + 6) || rd32(b + 12)) return BP_ERR_DIR;
+    t.count = b[5];
+    t.total = rd32(b + 8);
+    if (t.total > file_len || t.total < BP_SECTOR) return BP_ERR_RANGE;
+    for (i = 0; i < t.count; i++) {
+        const uint8_t *p = b + BP_DIR_HDR + i * BP_DIR_ENT;
+        BpDirEnt *e = &t.ent[i];
+        e->level = (uint16_t)rd16(p); e->plats = p[2]; e->off = rd32(p + 4); e->len = rd32(p + 8);
+        e->crc = rd32(p + 12);
+        if (p[3] || !e->plats || (e->plats & ~7u)) return BP_ERR_DIR;
+        if (e->off < BP_SECTOR || (e->off % BP_SECTOR)) return BP_ERR_DIR;
+        if (e->len < BP_HEAD_BYTES || e->len > BP_PACK_MAX) return BP_ERR_SIZE;
+        if (e->off > t.total || e->len > t.total - e->off) return BP_ERR_RANGE;
+        for (j = 0; j < i; j++) {
+            if (t.ent[j].level == e->level) return BP_ERR_DIR;
+            if (e->off < t.ent[j].off + t.ent[j].len && t.ent[j].off < e->off + e->len) return BP_ERR_OVERLAP;
+        }
+    }
+    *d = t;
+    return BP_OK;
+}
+
+const BpDirEnt *bp_dir_find(const BpDir *d, int level)
+{
+    int i;
+    if (!d) return NULL;
+    for (i = 0; i < d->count; i++)
+        if (d->ent[i].level == level) return &d->ent[i];
+    return NULL;
+}
+
+/* ---- straight from a BREACH.BIN ---- */
+typedef struct BinCtx { BpRead rd; void *ctx; uint32_t base; } BinCtx;
+static int bin_rd(void *c, uint32_t off, void *dst, uint32_t n)
+{
+    const BinCtx *b = (const BinCtx *)c;
+    return b->rd(b->ctx, b->base + off, dst, n);
+}
+
+int bp_bin_load(BpRead rd, void *ctx, uint32_t file_len, int level, int mode, void *arena, uint32_t arena_len,
+                DoomoCell *cells_dst, uint32_t *need, BpLevel *out)
+{
+    uint8_t buf[512];                     /* the directory, then the crc chunk */
+    BpDir d;
+    BpHead h;
+    BinCtx b;
+    const BpDirEnt *e;
+    int r;
+    if (need) *need = 0;
+    if (!rd || !out) return BP_ERR_NULL;
+    if (!rd(ctx, 0, buf, BP_DIR_BYTES)) return BP_ERR_READ;
+    if ((r = bp_dir(&d, buf, BP_DIR_BYTES, file_len)) != BP_OK) return r;
+    if (!(e = bp_dir_find(&d, level))) return BP_ERR_NOLEVEL;
+    b.rd = rd; b.ctx = ctx; b.base = e->off;
+    {
+        uint8_t hb[BP_HEAD_BYTES];
+        if (!bin_rd(&b, 0, hb, sizeof hb)) return BP_ERR_READ;
+        if ((r = bp_head(&h, hb, sizeof hb, e->len)) != BP_OK) return r;
+    }
+    if (h.crc != e->crc) return BP_ERR_CRC;               /* the directory and the pack disagree */
+    if (need) *need = bp_arena_need(&h, mode);
+    if ((r = bp_crc_check(&h, bin_rd, &b, buf, sizeof buf)) != BP_OK) return r;
+    r = bp_load_mode(&h, bin_rd, &b, arena, arena_len, mode, cells_dst, out);
+    if (r == BP_OK && out->tb_len) out->tb_off += e->off;     /* from the start of the file, for the loader's read */
+    return r;
+}
