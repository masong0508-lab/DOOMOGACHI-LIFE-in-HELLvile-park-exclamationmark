diff --git a/core/tests/test_breachpack.c b/core/tests/test_breachpack.c
new file mode 100644
index 0000000..4a97ab2
--- /dev/null
+++ b/core/tests/test_breachpack.c
@@ -0,0 +1,711 @@
+/* test_breachpack.c - LV8: the level pack reader (doomo/breachpack.h, core/src/breachpack.c).
+ *
+ * The packs are written by tools/packbreach.py from the test maps and two shipped maps (core/Makefile,
+ * $(BUILD)/testpacks); each is read back through bp_open / bp_load and compared field by field and cell by cell
+ * with the const data mapc generated for the same map. Then every refusal of the reader. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "test.h"
+#include "doomo/breachpack.h"
+#include "doomo/save.h"
+
+#ifndef BP_TESTPACK_DIR
+#define BP_TESTPACK_DIR "."
+#endif
+
+extern const DoomoMapDef map_def_t2_script, map_def_t3_kit, map_def_t4_env, map_def_t2_tables,
+    map_def_t2_swap_toggle, map_def_t8_bank, map_def_vape_cellar, map_def_hellvile;
+extern const DoomoMapExt map_ext_t2_script, map_ext_t3_kit, map_ext_t4_env, map_ext_t2_tables,
+    map_ext_t2_swap_toggle, map_ext_t8_bank;
+
+static uint8_t  pk[BP_PACK_MAX + 16];
+static uint32_t pk_len;
+static uint32_t arena[(BP_PACK_MAX + BP_ARENA_MAX) / 4];
+static BpLevel  lv;
+
+static int load_file(const char *name)
+{
+    char path[512];
+    FILE *f;
+    snprintf(path, sizeof path, "%s/%s.brpk", BP_TESTPACK_DIR, name);
+    f = fopen(path, "rb");
+    if (!f) return 0;
+    pk_len = (uint32_t)fread(pk, 1, BP_PACK_MAX + 16, f);
+    fclose(f);
+    return pk_len > 0;
+}
+
+static unsigned u16(const uint8_t *p) { return p[0] | (p[1] << 8); }
+static uint32_t u32(const uint8_t *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24); }
+static void p32(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+static void fix_crc(void) { p32(pk + 12, save_crc32(pk + 16, u32(pk + 8) - 16)); }
+static uint8_t *sec_ent(int i) { return pk + BP_HDR + i * BP_SEC_ENT; }
+
+static uint32_t rd_calls, rd_fail_at;
+static int rd_mem(void *ctx, uint32_t off, void *dst, uint32_t n)
+{
+    (void)ctx;
+    rd_calls++;
+    if (rd_fail_at && rd_calls >= rd_fail_at) return 0;
+    if (off > pk_len || n > pk_len - off) return 0;
+    memcpy(dst, pk + off, n);
+    return 1;
+}
+
+static void same_level(const char *name, const DoomoMapDef *d, const DoomoMapExt *x)
+{
+    BpPack p;
+    int i, k, e;
+    CHECK_MSG(load_file(name), "%s: no pack file in " BP_TESTPACK_DIR, name);
+    CHECK_EQ(bp_open(&p, pk, pk_len), BP_OK);
+    e = bp_load(&p, arena, sizeof arena, &lv);
+    CHECK_EQ(e, BP_OK);
+    if (e != BP_OK) return;
+    CHECK_STR(lv.def.name, d->name);
+    CHECK_EQ(lv.def.w, d->w); CHECK_EQ(lv.def.h, d->h); CHECK_EQ(lv.def.kind, d->kind);
+    CHECK_EQ(lv.def.sky, d->sky); CHECK_EQ(lv.def.music, d->music); CHECK_EQ(lv.def.ambient, d->ambient);
+    CHECK_EQ(lv.def.thing_count, d->thing_count);
+    CHECK(memcmp(lv.def.cells, d->cells, (size_t)d->w * d->h * sizeof(DoomoCell)) == 0);
+    for (i = 0; i < d->thing_count; i++) {
+        const DoomoThing *a = &lv.def.things[i], *b = &d->things[i];
+        CHECK(a->x == b->x && a->y == b->y && a->type == b->type && a->angle == b->angle &&
+              a->arg == b->arg && a->flags == b->flags);
+    }
+    CHECK(lv.ext.def == &lv.def);
+    if (!x) {
+        CHECK_EQ(lv.ext.flags, 0);
+        CHECK_EQ(lv.ext.zone_count + lv.ext.path_count + lv.ext.swap_count + lv.ext.texbank_count, 0);
+        CHECK(lv.ext.script == NULL && lv.ext.tflags2 == NULL);
+        return;
+    }
+    CHECK_EQ(lv.ext.flags, x->flags); CHECK_EQ(lv.ext.fog, x->fog); CHECK_EQ(lv.ext.view, x->view);
+    CHECK_EQ(lv.ext.gravity, x->gravity); CHECK_EQ(lv.ext.note, x->note);
+    for (i = 0; i < 3; i++) CHECK_EQ(lv.ext.detail[i], x->detail[i]);
+    CHECK_EQ(lv.ext.hero_look, x->hero_look); CHECK_EQ(lv.ext.hero_loadout, x->hero_loadout);
+    CHECK_EQ(lv.ext.zone_count, x->zone_count); CHECK_EQ(lv.ext.path_count, x->path_count);
+    CHECK_EQ(lv.ext.swap_count, x->swap_count); CHECK_EQ(lv.ext.texbank_count, x->texbank_count);
+    for (i = 0; i < x->zone_count; i++) {
+        const DoomoZone *a = &lv.ext.zones[i], *b = &x->zones[i];
+        CHECK(a->x0 == b->x0 && a->y0 == b->y0 && a->x1 == b->x1 && a->y1 == b->y1 && a->kind == b->kind &&
+              a->arg == b->arg && a->tag == b->tag);
+    }
+    k = 0;
+    for (i = 0; i < x->path_count; i++) {
+        const DoomoPath *a = &lv.ext.paths[i], *b = &x->paths[i];
+        int j;
+        CHECK(a->id == b->id && a->kind == b->kind && a->count == b->count && a->first == b->first);
+        for (j = 0; j < b->count; j++, k++) {
+            int ax, ay, bx, by;
+            CHECK(map_path_point(&lv.ext, a, j, &ax, &ay) && map_path_point(x, b, j, &bx, &by));
+            CHECK(ax == bx && ay == by);
+        }
+    }
+    for (i = 0; i < x->swap_count; i++) {
+        const DoomoSwapSet *a = &lv.ext.swaps[i], *b = &x->swaps[i];
+        int j;
+        CHECK(a->first == b->first && a->count == b->count && a->mode == b->mode && a->event == b->event);
+        for (j = 0; j < b->count; j++) {
+            const DoomoSwapCell *c = &lv.ext.swap_cells[a->first + j], *o = &x->swap_cells[b->first + j];
+            CHECK(c->cell == o->cell && memcmp(c->x, o->x, 8) == 0);
+        }
+    }
+    for (i = 0; i < x->texbank_count; i++) CHECK_STR(lv.ext.texbank[i], x->texbank[i]);
+    for (i = 0; i < d->thing_count; i++) CHECK_EQ(map_thing_flags2(&lv.ext, i), map_thing_flags2(x, i));
+    CHECK_EQ(lv.ext.script_len, x->script_len);
+    if (x->script_len) CHECK(memcmp(lv.ext.script, x->script, x->script_len) == 0);
+    else CHECK(lv.ext.script == NULL);
+    /* the accessors give the same answers on every cell */
+    {
+        int cx, cy, kind;
+        for (cy = 0; cy < d->h; cy++)
+            for (cx = 0; cx < d->w; cx++)
+                for (kind = ZONE_NONE; kind < ZONE_COUNT; kind++)
+                    CHECK(map_zone_at(&lv.ext, cx, cy, kind, 0) == map_zone_at(x, cx, cy, kind, 0));
+    }
+    CHECK(lv.used <= BP_ARENA_MAX + (uint32_t)d->w * d->h * sizeof(DoomoCell));
+    CHECK(bp_tables_bytes(&p.head) <= BP_ARENA_MAX);
+}
+
+TEST(breachpack_round_trip_t2_script) { same_level("t2_script", &map_def_t2_script, &map_ext_t2_script); }
+TEST(breachpack_round_trip_t3_kit) { same_level("t3_kit", &map_def_t3_kit, &map_ext_t3_kit); }
+TEST(breachpack_round_trip_t4_env) { same_level("t4_env", &map_def_t4_env, &map_ext_t4_env); }
+TEST(breachpack_round_trip_t2_tables) { same_level("t2_tables", &map_def_t2_tables, &map_ext_t2_tables); }
+TEST(breachpack_round_trip_swaps) { same_level("t2_swap_toggle", &map_def_t2_swap_toggle, &map_ext_t2_swap_toggle); }
+TEST(breachpack_round_trip_bank_level) { same_level("t8_bank", &map_def_t8_bank, &map_ext_t8_bank); }
+/* two shipped maps: v1 maps, no ext; the biggest one (hellvile 64x56?) exercises the LZ cells */
+TEST(breachpack_round_trip_shipped_vape_cellar) { same_level("vape_cellar", &map_def_vape_cellar, NULL); }
+TEST(breachpack_round_trip_shipped_hellvile) { same_level("hellvile", &map_def_hellvile, NULL); }
+
+TEST(breachpack_cells_are_lz_where_smaller)
+{
+    BpPack p;
+    CHECK(load_file("hellvile"));
+    CHECK_EQ(bp_open(&p, pk, pk_len), BP_OK);
+    CHECK_EQ(p.head.sec[BP_SEC_CELLS].enc, 1);
+    CHECK(p.head.sec[BP_SEC_CELLS].stored < p.head.sec[BP_SEC_CELLS].raw / 4);
+    /* a raw section is never LZ */
+    CHECK_EQ(p.head.sec[BP_SEC_THINGS].enc, 0);
+}
+
+TEST(breachpack_loaded_def_runs_in_the_map_code)
+{
+    /* map_load_def accepts the loaded def; the live cells equal the generated ones; v2 accessors on the
+     * loaded ext: zones, paths, and a swap set applied / reverted on the live map */
+    BpPack p;
+    uint16_t applied_a = 0, applied_b = 0;
+    int i, n;
+    DoomoCell *live;
+    CHECK(load_file("t2_swap_toggle"));
+    CHECK_EQ(bp_open(&p, pk, pk_len), BP_OK);
+    CHECK_EQ(bp_load(&p, arena, sizeof arena, &lv), BP_OK);
+    map_load_def(&map_def_t2_swap_toggle);
+    live = doomo_map.cells;
+    {
+        static DoomoCell ref[DOOMO_MAP_MAX_W * DOOMO_MAP_MAX_H];
+        memcpy(ref, live, sizeof ref);
+        n = map_swap_apply(&doomo_map, &map_ext_t2_swap_toggle, 0, &applied_a);
+        CHECK(n > 0);
+        {
+            static DoomoCell after_const[DOOMO_MAP_MAX_W * DOOMO_MAP_MAX_H];
+            memcpy(after_const, doomo_map.cells, sizeof after_const);
+            map_load_def(&lv.def);
+            for (i = 0; i < lv.def.w * lv.def.h; i++) CHECK(memcmp(&doomo_map.cells[i], &ref[i], 8) == 0);
+            CHECK_EQ(map_swap_apply(&doomo_map, &lv.ext, 0, &applied_b), n);
+            CHECK_EQ(applied_a, applied_b);
+            CHECK(memcmp(doomo_map.cells, after_const, sizeof after_const) == 0);
+            CHECK_EQ(map_swap_revert(&doomo_map, &lv.ext, 0, &applied_b), n);
+            CHECK(memcmp(doomo_map.cells, ref, sizeof ref) == 0);
+        }
+    }
+    CHECK(doomo_map.def == &lv.def);
+}
+
+TEST(breachpack_bank_level_names_text_and_blob)
+{
+    BpPack p;
+    uint32_t len = 0;
+    const uint8_t *tb;
+    DoomoTexBank b;
+    CHECK(load_file("t8_bank"));
+    CHECK_EQ(bp_open(&p, pk, pk_len), BP_OK);
+    CHECK_EQ(bp_load(&p, arena, sizeof arena, &lv), BP_OK);
+    CHECK_EQ(lv.string_count, 2);
+    CHECK_STR(lv.strings[0], "Welcome to the vat.");
+    CHECK_STR(lv.strings[1], "Second string");
+    CHECK(lv.strings[2] == NULL);
+    tb = bp_section(&p, BP_SEC_TEXBANK, &len);
+    CHECK(tb != NULL);
+    /* the section is the names of the 3 ids, then the blob: tb_off / tb_len are the blob's */
+    CHECK_EQ(len - 3 * DOOMO_TEXBANK_NAME, lv.tb_len);
+    CHECK_EQ(tb + 3 * DOOMO_TEXBANK_NAME - pk, lv.tb_off);
+    CHECK_EQ(texbank_open(&b, pk + lv.tb_off, lv.tb_len), TB_OK);
+    CHECK_EQ(b.count, 3);
+    CHECK_STR(texbank_name(&b, 0), "vat_brick");
+    CHECK_EQ(lv.ext.texbank_count, 3);
+    CHECK_STR(lv.ext.texbank[0], "vat_brick");
+    CHECK_STR(lv.ext.texbank[1], "");              /* id 57 is unused */
+    CHECK_STR(lv.ext.texbank[2], "dust");
+}
+
+/* the PS1's own decoder (ps1/src/packart.c map_def_cells) on a blob "LZMC", u32 count, LZ stream: the same LZ
+ * as the save codec, decoded here the same way */
+static void ps1_style_decode(const uint8_t *b, DoomoCell *dst)
+{
+    uint32_t n = u32(b + 4) * 8, i = 8, o = 0;
+    uint8_t *d = (uint8_t *)dst;
+    while (o < n) {
+        unsigned c = b[i++];
+        if (c < 0x80) { memcpy(d + o, b + i, c + 1); i += c + 1; o += c + 1; }
+        else { unsigned k = (c & 0x7F) + 3, dist = b[i] | (b[i + 1] << 8), m; i += 2; for (m = 0; m < k; m++, o++) d[o] = d[o - dist]; }
+    }
+}
+
+TEST(breachpack_lzmc_mode_is_what_the_ps1_decodes)
+{
+    static DoomoCell live[DOOMO_MAP_MAX_W * DOOMO_MAP_MAX_H];
+    static uint8_t chunk[BP_SECTOR];
+    BpHead h;
+    BpLevel l;
+    uint32_t need;
+    CHECK(load_file("hellvile"));
+    CHECK_EQ(bp_head(&h, pk, BP_HEAD_BYTES, pk_len), BP_OK);
+    CHECK_EQ(bp_crc_check(&h, rd_mem, NULL, chunk, sizeof chunk), BP_OK);
+    need = bp_arena_need(&h, BP_CELLS_LZMC);
+    CHECK(need < bp_arena_need(&h, BP_CELLS_ARENA));
+    CHECK_EQ(bp_load_mode(&h, rd_mem, NULL, arena, need, BP_CELLS_LZMC, NULL, &l), BP_OK);
+    CHECK(memcmp(l.def.cells, "LZMC", 4) == 0);
+    CHECK_EQ(u32((const uint8_t *)l.def.cells + 4), (uint32_t)h.w * h.h);
+    ps1_style_decode((const uint8_t *)l.def.cells, live);
+    CHECK(memcmp(live, map_def_hellvile.cells, (size_t)h.w * h.h * sizeof(DoomoCell)) == 0);
+    CHECK(bp_tables_bytes(&h) + 8 + h.sec[BP_SEC_CELLS].stored <= BP_ARENA_MAX);
+    CHECK_EQ(bp_load_mode(&h, rd_mem, NULL, arena, need - 4, BP_CELLS_LZMC, NULL, &l), BP_ERR_ARENA);
+    CHECK_EQ(bp_load_mode(&h, rd_mem, NULL, arena, need, BP_CELLS_DST, NULL, &l), BP_ERR_NULL);
+    CHECK_EQ(bp_load_mode(&h, rd_mem, NULL, arena, need, 9, NULL, &l), BP_ERR_NULL);
+}
+
+TEST(breachpack_cells_decode_into_the_callers_buffer)
+{
+    /* the PS1 path: header through bp_head, crc through the callback, cells straight into the live map */
+    static DoomoCell dst[DOOMO_MAP_MAX_W * DOOMO_MAP_MAX_H];
+    static uint8_t chunk[BP_SECTOR];
+    BpHead h;
+    BpLevel l;
+    uint32_t need;
+    CHECK(load_file("hellvile"));
+    CHECK_EQ(bp_head(&h, pk, BP_HEAD_BYTES, pk_len), BP_OK);
+    CHECK_EQ(bp_crc_check(&h, rd_mem, NULL, chunk, sizeof chunk), BP_OK);
+    need = bp_arena_need(&h, BP_CELLS_DST);
+    CHECK(need < bp_arena_need(&h, BP_CELLS_ARENA));
+    CHECK(bp_arena_need(&h, BP_CELLS_ARENA) >= h.sec[BP_SEC_CELLS].raw + bp_tables_bytes(&h));
+    CHECK_EQ(bp_load_read(&h, rd_mem, NULL, arena, need, dst, &l), BP_OK);
+    CHECK(l.def.cells == dst);
+    CHECK(memcmp(dst, map_def_hellvile.cells, (size_t)h.w * h.h * sizeof(DoomoCell)) == 0);
+    CHECK(l.used <= BP_ARENA_MAX);
+    /* one byte less than the need is refused */
+    CHECK_EQ(bp_load_read(&h, rd_mem, NULL, arena, need - 4, dst, &l), BP_ERR_ARENA);
+    /* a failing read is an error, whichever read it is */
+    {
+        uint32_t k, reads;
+        rd_calls = 0; rd_fail_at = 0;
+        CHECK_EQ(bp_load_read(&h, rd_mem, NULL, arena, need, dst, &l), BP_OK);
+        reads = rd_calls;
+        CHECK(reads >= 2);
+        for (k = 1; k <= reads; k++) {
+            rd_calls = 0; rd_fail_at = k;
+            CHECK_EQ(bp_load_read(&h, rd_mem, NULL, arena, need, dst, &l), BP_ERR_READ);
+        }
+        rd_fail_at = 0;
+    }
+    CHECK_EQ(bp_crc_check(&h, rd_mem, NULL, chunk, 8), BP_ERR_NULL);
+}
