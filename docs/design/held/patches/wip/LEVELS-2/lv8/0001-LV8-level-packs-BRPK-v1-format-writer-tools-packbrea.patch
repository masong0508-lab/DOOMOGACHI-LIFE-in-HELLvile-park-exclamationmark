+    fix_crc();
+    CHECK_EQ(open_now(&p), BP_ERR_SIZE);
+    CHECK(load_file("t3_kit"));
+    pk[33] = 4;                                     /* 4 zones in the header, the section holds others */
+    fix_crc();
+    CHECK(open_now(&p) == BP_ERR_SIZE);
