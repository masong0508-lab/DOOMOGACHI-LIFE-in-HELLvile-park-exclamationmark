+/* ---- bp_bin_load: the whole path of a platform reader, on the BREACH.BIN the Makefile wrote (ids 0..7 = the
+ * TESTPACK_MAPS order: t2_script t3_kit t4_env t2_tables t2_swap_toggle t8_bank vape_cellar hellvile) ---- */
+static uint8_t bin[256 * 1024];
+static uint32_t bin_len;
+static int load_bin(void)
+{
+    FILE *f = fopen(BP_TESTPACK_DIR "/BREACH.BIN", "rb");
+    if (!f) return 0;
+    bin_len = (uint32_t)fread(bin, 1, sizeof bin, f);
+    fclose(f);
+    return bin_len >= BP_SECTOR;
+}
+static int rd_bin(void *ctx, uint32_t off, void *dst, uint32_t n)
+{
+    (void)ctx;
+    if (off > bin_len || n > bin_len - off) return 0;
+    memcpy(dst, bin + off, n);
+    return 1;
+}
+
+TEST(breachpack_bin_loads_a_level_by_id)
+{
+    BpLevel l;
+    uint32_t need = 0;
+    CHECK(load_bin());
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 1, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &lv), BP_OK);
+    CHECK_STR(lv.def.name, map_def_t3_kit.name);
+    CHECK(memcmp(lv.def.cells, map_def_t3_kit.cells, (size_t)lv.def.w * lv.def.h * 8) == 0);
+    CHECK(need > 0 && need <= sizeof arena);
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 5, BP_CELLS_LZMC, arena, sizeof arena, NULL, &need, &l), BP_OK);
+    CHECK_STR(l.def.name, map_def_t8_bank.name);
+    CHECK_EQ(l.string_count, 2);
+    CHECK(l.tb_len > 16000);
+    CHECK(l.tb_off >= BP_SECTOR && memcmp(bin + l.tb_off, "LVTB", 4) == 0);   /* from the file's start */
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 7, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_OK);
+    CHECK_STR(l.def.name, map_def_hellvile.name);
+    /* the answers are the ones of a pack opened by itself */
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 99, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_ERR_NOLEVEL);
+}
+
+TEST(breachpack_bin_reports_the_arena_it_needs_and_refuses_damage)
+{
+    BpLevel l;
+    uint32_t need = 0, k;
+    CHECK(load_bin());
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 3, BP_CELLS_ARENA, arena, 16, NULL, &need, &l), BP_ERR_ARENA);
+    CHECK(need > 16);
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 3, BP_CELLS_ARENA, arena, need, NULL, &need, &l), BP_OK);
+    /* the directory's crc must be the pack's: a pack swapped for another is refused */
+    {
+        uint8_t save[4];
+        uint8_t *e = bin + BP_DIR_HDR + 3 * BP_DIR_ENT + 12;
+        memcpy(save, e, 4);
+        e[0] ^= 1;
+        CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 3, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_ERR_CRC);
+        memcpy(e, save, 4);
+    }
+    /* a flipped byte in the pack body (past the header and table) is a crc error */
+    {
+        uint8_t *dir_e = bin + BP_DIR_HDR + 3 * BP_DIR_ENT;
+        uint32_t off = u32(dir_e + 4);
+        bin[off + BP_HEAD_BYTES + 3] ^= 0x40;
+        CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len, 3, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_ERR_CRC);
+        bin[off + BP_HEAD_BYTES + 3] ^= 0x40;
+    }
+    CHECK_EQ(bp_bin_load(rd_bin, NULL, bin_len - 4096, 3, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_ERR_RANGE);
+    CHECK_EQ(bp_bin_load(NULL, NULL, bin_len, 3, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l), BP_ERR_NULL);
+    /* a read that fails anywhere is a read error (and nothing else) */
+    for (k = 1; k <= 3; k++) {
+        rd_calls = 0; rd_fail_at = k;
+        pk_len = bin_len;
+        memcpy(pk, bin, bin_len < sizeof pk ? bin_len : sizeof pk);
+        {
+            int r;
+            /* rd_mem reads pk: the first 3 reads are the directory, the header and the first crc chunk */
+            r = bp_bin_load(rd_mem, NULL, bin_len < sizeof pk ? bin_len : sizeof pk, 3, BP_CELLS_ARENA, arena, sizeof arena, NULL, &need, &l);
+            CHECK_EQ(r, BP_ERR_READ);
+        }
+    }
+    rd_fail_at = 0;
+}
