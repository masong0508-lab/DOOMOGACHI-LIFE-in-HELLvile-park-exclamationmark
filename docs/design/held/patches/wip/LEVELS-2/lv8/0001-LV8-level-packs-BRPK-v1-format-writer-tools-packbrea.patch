diff --git a/tools/packbreach.py b/tools/packbreach.py
new file mode 100644
index 0000000..f3241cd
--- /dev/null
+++ b/tools/packbreach.py
@@ -0,0 +1,412 @@
+#!/usr/bin/env python3
+"""packbreach.py - LV8: level packs ("BRPK" v1) and BREACH.BIN (owner: levels). Stdlib only, deterministic.
+
+    packbreach.py [--manifest FILE] [--platform ps1|dc|gba] [--out-dir DIR] [--bin FILE] [--check] [-v] [MAP.txt ...]
+
+A level that tools/mapc.py compiles can be delivered as a pack: the cells (LZ, the save codec of
+ps1/tools/packart.py, so the PS1 decoder is reused; raw when that is smaller), things, tflags2, zones,
+paths, path points, swap sets, swap cells, the script bytes, the level's strings, the texture bank
+('LVTB', tools/texbank.py, copied unchanged) and a sprite bank slot (empty, reserved for LV7b), behind a
+header and a section table. The reader is core/src/breachpack.c (core/include/doomo/breachpack.h has the byte
+layout; docs/LEVELS.md "Level packs" explains it). Little endian, every field written one by one.
+
+With no MAP files: every level of the manifest (core/data/maps/platforms.txt) whose map file exists, in the
+manifest order; the level id in BREACH.BIN is the line's index in the manifest. With MAP files: those
+maps, ids 0, 1, 2... in the order given (tests, one-off packs).
+
+  --out-dir DIR   one NAME.brpk per level, and BREACH.BIN unless --bin says where
+  --bin FILE      the whole BREACH.BIN: a directory sector, then every pack on a 2048-byte sector
+  --platform P    which levels go into the BIN: those the manifest gives to P (default ps1)
+  --check         build everything in memory, read every pack back with the independent reader below and
+                  compare it to the mapc model, check the limits, write nothing; exit 1 on any problem
+
+A pack is at most 96 KB; the tables and text the reader keeps resident at most 12 KB.
+"""
+import argparse
+import os
+import struct
+import sys
+import zlib
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(ROOT, "ps1", "tools"))
+import mapc  # noqa: E402
+import texbank  # noqa: E402
+from packart import lz, unlz  # noqa: E402
+
+VERSION = 1
+HDR = 80
+NSEC = 12
+SEC_ENT = 16
+HEAD_BYTES = HDR + NSEC * SEC_ENT
+PACK_MAX = 96 * 1024
+ARENA_MAX = 12 * 1024
+SECTOR = 2048
+NAME_LEN = 32
+DIR_ENTRIES = 24
+DIR_HDR = 16
+DIR_ENT = 16
+(S_CELLS, S_THINGS, S_TFLAGS2, S_ZONES, S_PATHS, S_PATHPTS, S_SWAPS, S_SWAPCELLS, S_SCRIPT, S_TEXT,
+ S_TEXBANK, S_SPRITES) = range(NSEC)
+SEC_NAMES = ("cells", "things", "tflags2", "zones", "paths", "pathpts", "swaps", "swapcells", "script",
+             "text", "texbank", "sprites")
+PLATS = {"gba": 1, "ps1": 2, "dc": 4}
+MANIFEST = os.path.join(mapc.MAPS_DIR, "platforms.txt")
+STRINGS_MAX = 64
+TEXT_MAX = 4096
+THINGS_MAX = 256
+SCRIPT_MAX = 2048
+
+
+class PackError(Exception):
+    pass
+
+
+# ---------------------------------------------------------------- manifest
+def load_manifest(path=MANIFEST):
+    """[(id, {map, gba, ps1, dc})] in file order. `level ID [map=NAME] [gba yes|no] [ps1 yes|no] [dc yes|no]`;
+    defaults: gba no, ps1 yes, dc yes. mapc.load_manifest is the same reader."""
+    return mapc.load_manifest(path)
+
+
+# ---------------------------------------------------------------- one pack
+def align4(n):
+    return (n + 3) & ~3
+
+
+def strings_of(path):
+    """The level's strings: NAME.strings next to the map, one per line, # comments, ASCII."""
+    sp = os.path.splitext(path)[0] + ".strings"
+    if not os.path.exists(sp):
+        return []
+    out = []
+    with open(sp, "r", encoding="ascii") as f:
+        for ln, line in enumerate(f.read().split("\n"), 1):
+            if not line.strip() or line.lstrip().startswith("#"):
+                continue
+            if "\0" in line or len(line) > 255:
+                raise PackError("%s:%d: a string is at most 255 characters" % (sp, ln))
+            out.append(line.rstrip("\r"))
+    return out
+
+
+def text_section(strings):
+    if not strings:
+        return b""
+    if len(strings) > STRINGS_MAX:
+        raise PackError("%d strings, at most %d" % (len(strings), STRINGS_MAX))
+    body = b""
+    offs = []
+    base = 2 + 2 * len(strings)
+    for s in strings:
+        offs.append(base + len(body))
+        body += s.encode("ascii") + b"\0"
+    out = struct.pack("<H", len(strings)) + b"".join(struct.pack("<H", o) for o in offs) + body
+    if len(out) > TEXT_MAX:
+        raise PackError("the strings take %d bytes, at most %d" % (len(out), TEXT_MAX))
+    return out
+
+
+def model_sections(m, w, h, cells, things):
+    """The mapc model as the pack's raw section bytes and header fields."""
+    hdr = m["hdr"]
+    ext = m.get("ext") or {"swaps": [], "bank": [], "script": b""}
+    sec = [b""] * NSEC
+    sec[S_CELLS] = b"".join(bytes(mapc.cell_bytes(c)) for c in cells)
+    sec[S_THINGS] = b"".join(struct.pack("<6B", t.x, t.y, t.type, t.angle, t.arg, t.flags) for t in things)
+    if any(t.flags2 for t in things):
+        sec[S_TFLAGS2] = bytes(t.flags2 for t in things)
+    sec[S_ZONES] = b"".join(struct.pack("<7B", z["x0"], z["y0"], z["x1"], z["y1"], mapc.ZONE_KINDS[z["kind"]],
+                                        z["arg"], z["tag"]) for z in m["zones"])
+    first = 0
+    paths = pts = b""
+    for p in m["paths"]:
+        paths += struct.pack("<4BH", p["id"], mapc.PATH_KINDS[p["kind"]], len(p["pts"]), 0, first)
+        pts += b"".join(struct.pack("<2B", x, y) for x, y in p["pts"])
+        first += len(p["pts"])
+    sec[S_PATHS], sec[S_PATHPTS] = paths, pts
+    sets = scells = b""
+    first = 0
+    for sw in ext["swaps"]:
+        sets += struct.pack("<HH2B", first, len(sw["cells"]), mapc.ENUMS["MSWAP_" + sw["mode"].upper()], sw["event"])
+        for i, x in sw["cells"]:
+            scells += struct.pack("<H8B", i, *x)
+        first += len(sw["cells"])
+    sec[S_SWAPS], sec[S_SWAPCELLS] = sets, scells
+    sec[S_SCRIPT] = bytes(ext["script"]) if ext["script"] else b""
+    flags = (mapc.ENUMS["MAPX_DARK"] if hdr.get("dark") else 0) | (mapc.ENUMS["MAPX_GBA"] if hdr.get("gba") else 0) \
+        | (mapc.ENUMS["MAPX_HERO"] if "hero" in hdr else 0)
+    det = (list(hdr.get("detail", [])) + [0, 0, 0])[:3]
+    hero = hdr.get("hero", (0, 0))
+    fields = {
+        "w": w, "h": h, "kind": ("overworld", "dungeon", "arena").index(m["kind"]), "sky": m["sky"],
+        "music": m["music"], "ambient": m["ambient"], "xflags": flags, "fog": hdr.get("fog", 0),
+        "view": hdr.get("view", 0), "gravity": hdr.get("gravity", 0), "note": hdr.get("note", 0),
+        "detail": det, "hero": tuple(hero), "zones": len(m["zones"]), "paths": len(m["paths"]),
+        "swaps": len(ext["swaps"]), "things": len(things), "pathpts": len(pts) // 2,
+        "swapcells": len(scells) // 10, "script": len(sec[S_SCRIPT]),
+    }
+    return sec, fields
+
+
+def tables_bytes(fields, sections):
+    """What the reader keeps resident (core/src/breachpack.c layout): must match bp_tables_bytes."""
+    f = fields
+    o = align4(NAME_LEN)
+    for n in (f["things"] * 6, len(sections[S_TFLAGS2]), f["zones"] * 7, f["paths"] * 6, f["pathpts"] * 2,
+              f["swaps"] * 6, f["swapcells"] * 10, f["script"], f["texbank"] * 12, len(sections[S_TEXT])):
+        o = align4(o + n)
+    return o
+
+
+def bank_blob(m, path, bank_dir):
+    """(the texbank section, the names of the ids 56..): the 12-byte names the map gives the ids (empty = unused),
+    then the level's 'LVTB' blob unchanged (core/data/texbanks-style bank file named like the map). Empty
+    without a `texbank` statement."""
+    ext = m.get("ext")
+    names = list(ext["bank"]) if ext else []
+    names = [n or "" for n in names]
+    if not any(names):
+        return b"", []
+    bp = os.path.join(bank_dir, m["name"] + ".bank")
+    if not os.path.exists(bp):
+        raise PackError("%s: `texbank` names %s but there is no %s" % (
+            path, ", ".join(n for n in names if n), os.path.relpath(bp, ROOT)))
+    try:
+        blob = texbank.build_file(bp)
+    except texbank.BankError as e:
+        raise PackError("%s: %s" % (bp, e))
+    have = [blob[12 + 16 * i:12 + 16 * i + 12].rstrip(b"\0").decode() for i in range(blob[5])]
+    for k, n in enumerate(names):
+        if n and n not in have:
+            raise PackError("%s: the map's texbank name '%s' is not in the bank (has %s)" % (path, n, ", ".join(have)))
+        if n and have[k] != n:     # texture id 56 + k answers from slot k of the bank (texbank.c texbank_id_slot)
+            raise PackError("%s: `texbank %d %s` but slot %d of the bank is '%s': the bank's slot order is the ids'" % (
+                path, k, n, k, have[k]))
+    return b"".join(n.encode().ljust(12, b"\0") for n in names) + blob, names
+
+
+def build_pack(path, bank_dir=texbank.BANK_DIR):
+    """(pack bytes, info dict) of one map file. Raises PackError / mapc.MapError."""
+    m = mapc.parse_map(path)
+    w, h, cells, things = mapc.build(m)
+    if len(things) > THINGS_MAX:
+        raise PackError("%s: %d things, at most %d in a pack" % (path, len(things), THINGS_MAX))
+    sec, f = model_sections(m, w, h, cells, things)
+    if len(sec[S_SCRIPT]) > SCRIPT_MAX:
+        raise PackError("%s: script %d bytes, at most %d" % (path, len(sec[S_SCRIPT]), SCRIPT_MAX))
+    sec[S_TEXT] = text_section(strings_of(path))
+    sec[S_TEXBANK], names = bank_blob(m, path, bank_dir)
+    f["texbank"] = len(names)
+    f["strings"] = len(strings_of(path))
+    # cells: LZ when smaller
+    lzc = lz(sec[S_CELLS])
+    assert unlz(lzc, len(sec[S_CELLS])) == sec[S_CELLS]
+    stored = [s for s in sec]
+    enc = [0] * NSEC
+    if len(lzc) < len(sec[S_CELLS]):
+        stored[S_CELLS], enc[S_CELLS] = lzc, 1
+    table = b""
+    body = b""
+    pos = HEAD_BYTES
+    for i in range(NSEC):
+        if not stored[i]:
+            table += struct.pack("<BBHIII", i, 0, 0, 0, 0, 0)
+            continue
+        table += struct.pack("<BBHIII", i, enc[i], 0, pos, len(stored[i]), len(sec[i]))
+        body += stored[i] + b"\0" * (align4(len(stored[i])) - len(stored[i]))
+        pos += align4(len(stored[i]))
+    total = pos
+    title = m["title"].encode("ascii")
+    d = f["detail"]
+    head = bytearray(HDR)
+    head[0:4] = b"BRPK"
+    head[4], head[5] = VERSION, NSEC
+    struct.pack_into("<I", head, 8, total)
+    head[16:26] = bytes((f["w"], f["h"], f["kind"], f["sky"], f["music"], f["ambient"], f["xflags"], f["fog"],
+                         f["view"], f["gravity"]))
+    struct.pack_into("<H", head, 26, f["note"])
+    head[28:31] = bytes(d)
+    head[31], head[32] = f["hero"]
+    head[33:37] = bytes((f["zones"], f["paths"], f["swaps"], f["texbank"]))
+    struct.pack_into("<HHHHH", head, 38, f["things"], f["pathpts"], f["swapcells"], f["script"], f["strings"])
+    head[48:48 + len(title)] = title
+    pack = bytearray(bytes(head) + table + body)
+    struct.pack_into("<I", pack, 12, zlib.crc32(bytes(pack[16:])) & 0xFFFFFFFF)
+    pack = bytes(pack)
+    tb = tables_bytes(f, sec)
+    if len(pack) > PACK_MAX:
+        raise PackError("%s: the pack is %d bytes, at most %d" % (path, len(pack), PACK_MAX))
+    if tb > ARENA_MAX:
+        raise PackError("%s: tables + text are %d bytes, at most %d" % (path, tb, ARENA_MAX))
+    info = {"name": m["name"], "title": m["title"], "size": len(pack), "tables": tb, "cells_raw": len(sec[S_CELLS]),
+            "cells_stored": len(stored[S_CELLS]), "gba": bool(m["hdr"].get("gba")), "model": (m, w, h, cells, things)}
+    return pack, info
+
+
+# ---------------------------------------------------------------- the independent reader (for --check and tests)
+def unpack(blob):
+    """Parse a pack back into a dict. Raises PackError on any inconsistency (mirrors breachpack.c)."""
+    if len(blob) < HEAD_BYTES:
+        raise PackError("short")
+    if blob[:4] != b"BRPK":
+        raise PackError("magic")
+    if blob[4] != VERSION or blob[5] != NSEC:
+        raise PackError("version")
+    total, crc = struct.unpack_from("<II", blob, 8)
+    if total > len(blob) or total < HEAD_BYTES:
+        raise PackError("range")
+    if zlib.crc32(blob[16:total]) & 0xFFFFFFFF != crc:
+        raise PackError("crc")
+    h = {"w": blob[16], "h": blob[17], "kind": blob[18], "sky": blob[19], "music": blob[20], "ambient": blob[21],
+         "xflags": blob[22], "fog": blob[23], "view": blob[24], "gravity": blob[25],
+         "note": struct.unpack_from("<H", blob, 26)[0], "detail": list(blob[28:31]),
+         "hero": (blob[31], blob[32]), "zones": blob[33], "paths": blob[34], "swaps": blob[35],
+         "texbank": blob[36]}
+    (h["things"], h["pathpts"], h["swapcells"], h["script"], h["strings"]) = struct.unpack_from("<HHHHH", blob, 38)
+    h["name"] = blob[48:80].split(b"\0")[0].decode("ascii")
+    secs = []
+    for i in range(NSEC):
+        sid, enc, _, off, stored, raw = struct.unpack_from("<BBHIII", blob, HDR + i * SEC_ENT)
+        if sid != i:
+            raise PackError("section id")
+        data = b""
+        if stored:
+            if off < HEAD_BYTES or off + stored > total:
+                raise PackError("section %s out of range" % SEC_NAMES[i])
+            data = blob[off:off + stored]
+            if enc == 1:
+                data = unlz(data, raw)
+            if len(data) != raw:
+                raise PackError("section %s length" % SEC_NAMES[i])
+        secs.append(data)
+    h["sec"] = secs
+    return h
+
+
+def check_roundtrip(blob, info):
+    """The unpacked pack equals the mapc model (cells, things, tables)."""
+    m, w, hgt, cells, things = info["model"]
+    u = unpack(blob)
+    sec, f = model_sections(m, w, hgt, cells, things)
+    for i in (S_CELLS, S_THINGS, S_TFLAGS2, S_ZONES, S_PATHS, S_PATHPTS, S_SWAPS, S_SWAPCELLS, S_SCRIPT):
+        if u["sec"][i] != sec[i]:
+            raise PackError("%s: section %s differs from the mapc model" % (info["name"], SEC_NAMES[i]))
+    for k in ("w", "h", "kind", "sky", "music", "ambient", "xflags", "fog", "view", "gravity", "note", "detail",
+              "hero", "zones", "paths", "swaps", "things", "pathpts", "swapcells", "script"):
+        if u[k] != f[k]:
+            raise PackError("%s: header field %s differs (%r vs %r)" % (info["name"], k, u[k], f[k]))
+    if u["name"] != m["title"]:
+        raise PackError("%s: name differs" % info["name"])
+
+
+# ---------------------------------------------------------------- BREACH.BIN
+def build_bin(entries):
+    """entries: [(level id, platform mask, pack bytes)] -> the BREACH.BIN bytes."""
+    if len(entries) > DIR_ENTRIES:
+        raise PackError("%d levels, a BREACH.BIN has at most %d" % (len(entries), DIR_ENTRIES))
+    ids = [e[0] for e in entries]
+    if len(set(ids)) != len(ids):
+        raise PackError("a level id is used twice")
+    pos = SECTOR
+    ents = b""
+    body = b""
+    for lid, mask, pack in entries:
+        crc = struct.unpack_from("<I", pack, 12)[0]
+        ents += struct.pack("<HBBIII", lid, mask, 0, pos, len(pack), crc)
+        padded = pack + b"\0" * (-len(pack) % SECTOR)
+        body += padded
+        pos += len(padded)
+    head = b"BRBN" + struct.pack("<BBHII", 1, len(entries), 0, pos, 0) + ents
+    return head + b"\0" * (SECTOR - len(head)) + body
+
+
+def read_bin(data):
+    """[(level id, mask, off, len, crc)], validating the directory like bp_dir."""
+    if data[:4] != b"BRBN" or data[4] != 1:
+        raise PackError("BREACH.BIN: magic / version")
+    count, _, total, z = struct.unpack_from("<BHII", data, 5)
+    if count > DIR_ENTRIES or total != len(data) or z:
+        raise PackError("BREACH.BIN: directory")
+    out = []
+    for i in range(count):
+        lid, mask, _, off, ln, crc = struct.unpack_from("<HBBIII", data, DIR_HDR + i * DIR_ENT)
+        if off % SECTOR or off < SECTOR or off + ln > total:
+            raise PackError("BREACH.BIN: entry %d out of range" % i)
+        out.append((lid, mask, off, ln, crc))
+    return out
+
+
+# ---------------------------------------------------------------- driver
+def plan(args):
+    """[(level id, map path, platform mask)] and the manifest problems."""
+    problems = []
+    if args.maps:
+        return [(i, os.path.abspath(p), PLATS["ps1"] | PLATS["dc"]) for i, p in enumerate(args.maps)], problems
+    man = load_manifest(args.manifest)
+    out = []
+    for i, (lid, ent) in enumerate(man):
+        path = os.path.join(mapc.MAPS_DIR, ent["map"] + ".txt")
+        mask = sum(PLATS[p] for p in PLATS if ent[p])
+        if not os.path.exists(path):
+            continue
+        out.append((i, path, mask))
+    return out, problems
+
+
+def main(argv):
+    ap = argparse.ArgumentParser(description="level packs and BREACH.BIN")
+    ap.add_argument("maps", nargs="*")
+    ap.add_argument("--manifest", default=MANIFEST)
+    ap.add_argument("--platform", default="ps1", choices=sorted(PLATS))
+    ap.add_argument("--out-dir")
+    ap.add_argument("--bin")
+    ap.add_argument("--check", action="store_true")
+    ap.add_argument("--bank-dir", default=texbank.BANK_DIR)
+    ap.add_argument("-v", "--verbose", action="store_true")
+    args = ap.parse_args(argv[1:])
+    try:
+        items, problems = plan(args)
+        if not args.maps:
+            for lid, ent in load_manifest(args.manifest):
+                mp = os.path.join(mapc.MAPS_DIR, ent["map"] + ".txt")
+                if os.path.exists(mp):
+                    mm = mapc.parse_map(mp)
+                    if bool(mm["hdr"].get("gba")) != bool(ent["gba"]):
+                        problems.append("%s: the manifest says gba %s but the map says %s" % (
+                            lid, "yes" if ent["gba"] else "no", "yes" if mm["hdr"].get("gba") else "no"))
+        entries = []
+        for lid, path, mask in items:
+            pack, info = build_pack(path, args.bank_dir)
+            check_roundtrip(pack, info)
+            if args.verbose or args.check:
+                print("packbreach: %-24s %5d B pack, cells %d -> %d B, tables %d B" % (
+                    info["name"], info["size"], info["cells_raw"], info["cells_stored"], info["tables"]))
+            if mask & PLATS[args.platform] or args.maps:
+                entries.append((lid, mask, pack))
+            if args.out_dir and not args.check:
+                os.makedirs(args.out_dir, exist_ok=True)
+                with open(os.path.join(args.out_dir, info["name"] + ".brpk"), "wb") as fh:
+                    fh.write(pack)
+        data = build_bin(entries)
+        read_bin(data)
+        if problems:
+            raise PackError("; ".join(problems))
+        if not args.check:
+            dst = args.bin or (os.path.join(args.out_dir, "BREACH.BIN") if args.out_dir else None)
+            if dst:
+                os.makedirs(os.path.dirname(os.path.abspath(dst)), exist_ok=True)
+                with open(dst, "wb") as fh:
+                    fh.write(data)
+        print("packbreach: %d level(s), BREACH.BIN %d bytes (%s)%s" % (
+            len(entries), len(data), args.platform, " [check]" if args.check else ""))
+    except (PackError, mapc.MapError, OSError) as e:
+        sys.stderr.write("packbreach: error: %s\n" % e)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
