diff --git a/dc/src/breachdisc.c b/dc/src/breachdisc.c
new file mode 100644
index 0000000..0e13fa7
--- /dev/null
+++ b/dc/src/breachdisc.c
@@ -0,0 +1,67 @@
+/* breachdisc.c - the level packs, read from the GD-ROM data track (owner: levels / dreamcast; LV8).
+ *
+ * BREACH.BIN (tools/packbreach.py --platform dc) sits on the disc root next to PACK.DMP and TALK_EN.BIN; a level
+ * is a pack inside it (core/include/doomo/breachpack.h). This file only reads: it opens /cd/BREACH.BIN through
+ * KallistiOS's CD file system, hands the core reader (core/src/breachpack.c) a read callback, and keeps the
+ * loaded level in BSS (the Dreamcast has 16 MB: a 12 KB table arena, the cells decoded, a 96 KB bank buffer).
+ * plat_breach_level(id) is what the level select calls once a level exists; the texture bank is made the
+ * level's with texbank_activate() (ids 56..63 then answer from it).
+ *
+ * Built only when the disc has a BREACH.BIN (make -C dc BREACH=1, which defines DOOMO_BREACH_BIN): the stock disc
+ * links none of this. The host test is dc/tests/breachdisc_host.sh (the KOS file calls mocked).
+ */
+#if defined(DOOMO_BREACH_BIN)
+#include <fcntl.h>
+#include <string.h>
+#include <kos/fs.h>
+#include "dc_plat.h"
+#include "doomo/breachpack.h"
+#include "doomo/texbank.h"
+
+#define BREACH_PATH "/cd/BREACH.BIN"
+
+static uint32_t s_arena[(BP_ARENA_MAX + 2 * BP_PACK_MAX) / 4] __attribute__((aligned(32)));
+static uint8_t  s_bank[BP_PACK_MAX] __attribute__((aligned(32)));
+static BpLevel  s_level;
+static DoomoTexBank s_tb;
+static int      s_loaded = -1;            /* the level in s_level, -1 none */
+
+typedef struct File { file_t fd; } File;
+
+static int rd_file(void *ctx, uint32_t off, void *dst, uint32_t n)
+{
+    file_t fd = ((File *)ctx)->fd;
+    return fs_seek(fd, (off_t)off, SEEK_SET) == (off_t)off && fs_read(fd, dst, n) == (ssize_t)n;
+}
+
+int plat_breach_level(int level, const DoomoMapDef **def, const DoomoMapExt **ext)
+{
+    File f;
+    ssize_t total;
+    int r;
+    uint32_t need = 0;
+    if (def) *def = NULL;
+    if (ext) *ext = NULL;
+    f.fd = fs_open(BREACH_PATH, O_RDONLY);
+    if (f.fd < 0) return BP_ERR_READ;
+    total = fs_total(f.fd);
+    texbank_activate(NULL);
+    s_loaded = -1;
+    if (total <= 0) { fs_close(f.fd); return BP_ERR_READ; }
+    r = bp_bin_load(rd_file, &f, (uint32_t)total, level, BP_CELLS_ARENA, s_arena, sizeof s_arena, NULL, &need, &s_level);
+    if (r == BP_OK && s_level.tb_len) {
+        /* the level's texture bank: the 'LVTB' blob, read whole, made the active bank */
+        if (s_level.tb_len > sizeof s_bank || !rd_file(&f, s_level.tb_off, s_bank, s_level.tb_len) ||
+            texbank_open(&s_tb, s_bank, s_level.tb_len) != TB_OK)
+            r = BP_ERR_READ;
+        else
+            texbank_activate(&s_tb);
+    }
+    fs_close(f.fd);
+    if (r != BP_OK) return r;
+    s_loaded = level;
+    if (def) *def = &s_level.def;
+    if (ext) *ext = &s_level.ext;
+    return BP_OK;
+}
+#endif
diff --git a/dc/tests/breachdisc_host.c b/dc/tests/breachdisc_host.c
new file mode 100644
index 0000000..f5d189e
--- /dev/null
+++ b/dc/tests/breachdisc_host.c
@@ -0,0 +1,47 @@
+/* breachdisc_host.c - LV8 host test: the real dc/src/breachdisc.c and core/src/breachpack.c over a mock of the KOS
+ * file calls (packdisc_mock.c), reading a BREACH.BIN that tools/packbreach.py wrote (ids 0..2 = t3_kit, t8_bank,
+ * hellvile). */
+#include <stdio.h>
+#include <string.h>
+#include "doomo/breachpack.h"
+#include "doomo/texbank.h"
+extern long mock_reads;
+extern const DoomoMapDef map_def_t3_kit, map_def_t8_bank, map_def_hellvile;
+extern const DoomoMapExt map_ext_t3_kit, map_ext_t8_bank;
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+int main(void)
+{
+    const DoomoMapDef *d = NULL;
+    const DoomoMapExt *x = NULL;
+    int r;
+    r = plat_breach_level(0, &d, &x);
+    CHECK(r == BP_OK && d && x);
+    if (d) {
+        CHECK(!strcmp(d->name, map_def_t3_kit.name) && d->w == map_def_t3_kit.w && d->h == map_def_t3_kit.h);
+        CHECK(memcmp(d->cells, map_def_t3_kit.cells, (size_t)d->w * d->h * sizeof(DoomoCell)) == 0);
+        CHECK(d->thing_count == map_def_t3_kit.thing_count);
+        CHECK(x->def == d && x->zone_count == map_ext_t3_kit.zone_count && x->path_count == map_ext_t3_kit.path_count);
+        CHECK(texbank_active() == NULL);
+    }
+    CHECK(mock_reads > 0 && mock_reads < 40);
+    /* a level with a bank: ids 56.. answer from it */
+    r = plat_breach_level(1, &d, &x);
+    if (r != BP_OK) printf("level 1: %s\n", bp_strerror(r));
+    CHECK(r == BP_OK && d && x);
+    if (d) {
+        const DoomoTexBank *tb = texbank_active();
+        CHECK(!strcmp(d->name, map_def_t8_bank.name));
+        CHECK(tb && tb->count == 3 && !strcmp(texbank_name(tb, 0), "vat_brick"));
+        CHECK(texbank_id_pixels(DOOMO_TEXBANK_FIRST, 0) != NULL);
+        CHECK(!strcmp(x->texbank[0], "vat_brick") && x->texbank[1][0] == 0 && !strcmp(x->texbank[2], "dust"));
+    }
+    /* the next level clears the bank, a missing level is an error and leaves nothing active */
+    r = plat_breach_level(2, &d, &x);
+    CHECK(r == BP_OK && d && !strcmp(d->name, map_def_hellvile.name) && x->texbank_count == 0);
+    CHECK(texbank_active() == NULL);
+    r = plat_breach_level(77, &d, &x);
+    CHECK(r == BP_ERR_NOLEVEL && d == NULL && x == NULL);
+    printf("breachdisc host: %s\n", fails ? "FAILED" : "all checks passed");
+    return fails != 0;
+}
diff --git a/dc/tests/breachdisc_host.sh b/dc/tests/breachdisc_host.sh
new file mode 100644
index 0000000..9e208a7
--- /dev/null
+++ b/dc/tests/breachdisc_host.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# LV8: build a BREACH.BIN of three test maps and read levels from it through dc/src/breachdisc.c (KOS file calls
+# mocked), over the real core reader. Host cc only: `sh dc/tests/breachdisc_host.sh`. Part of `make -C dc
+# check-breachdisc` and `make dc-host-test`.
+set -eu
+here=$(cd "$(dirname "$0")" && pwd); root=$(cd "$here/../.." && pwd)
+t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
+maps="$root/core/tests/maps"
+python3 -I "$root/tools/packbreach.py" --platform dc --bin "$t/BREACH.BIN" --bank-dir "$root/core/tests/banks" \
+    "$maps/t3_kit.txt" "$maps/t8_bank.txt" "$root/core/data/maps/hellvile.txt" >/dev/null
+mkdir -p "$t/gen"
+for m in t3_kit t8_bank; do
+    python3 -I "$root/tools/mapc.py" --out-root "$t/gen" "$maps/$m.txt"
+done
+python3 -I "$root/tools/mapc.py" --out-root "$t/gen" "$root/core/data/maps/hellvile.txt"
+${CC:-cc} -std=gnu99 -Wall -Wextra -Werror -DDOOMO_PLATFORM_DC=1 -DDOOMO_BREACH_BIN=1 \
+    -I"$root/core/include" -I"$root/dc/src" -I"$root/dc/harness" -I"$here/mock" \
+    "$here/breachdisc_host.c" "$here/packdisc_mock.c" "$root/dc/src/breachdisc.c" \
+    "$root/core/src/breachpack.c" "$root/core/src/texbank.c" \
+    "$t/gen/core/gen/map_t3_kit.c" "$t/gen/core/gen/map_t8_bank.c" "$t/gen/core/gen/map_hellvile.c" \
+    -o "$t/t" 2>&1 | head -40
+BREACH_FILE="$t/BREACH.BIN" "$t/t"
