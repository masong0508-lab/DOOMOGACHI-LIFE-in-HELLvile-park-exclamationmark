diff --git a/gba/tools/memreport.py b/gba/tools/memreport.py
index 40f230c..961e139 100644
--- a/gba/tools/memreport.py
+++ b/gba/tools/memreport.py
@@ -14,6 +14,7 @@ G0), plus the biggest EWRAM / IWRAM objects. Exit status 1 if the main
 stack is under 6 KB with the largest overlay group loaded (gba.ld ASSERTs
 the same at link time), else 0.
 """
+import os
 import re
 import sys
 
@@ -26,6 +27,61 @@ SYMS = ("__iwram_start", "__iwram_end", "__iwram_bss_start", "__iwram_bss_end",
 STACK_MIN = 6144        # gba.ld GBA_STACK_SIZE
 
 
+LEVEL_OBJS = re.compile(r"(^|/)(levels\w*|lv_\w+|breachpack|texbank|map|maps)\.c?\.?o(bj)?$")
+
+
+def levels_rows(text):
+    """LV8: what the level expansion costs this ROM. ROM: the map tables (tools/levelcheck.py rom_estimate) of the
+    maps the GBA build compiles: the shipped maps, plus the levels core/data/maps/platforms.txt gives `gba yes`
+    whose map file exists. EWRAM / IWRAM: the .data / .bss / .iwram input sections of the levels objects
+    (levels*, lv_*, map, maps, texbank, breachpack) in the linker map; the pack reader (breachpack.o) is linked
+    out of the GBA ROM (nothing references it: the 7 levels are const data), so it adds nothing."""
+    out = []
+    here = os.path.dirname(os.path.abspath(__file__))
+    tools = os.path.join(os.path.dirname(os.path.dirname(here)), "tools")
+    try:
+        sys.path.insert(0, tools)
+        import mapc
+        import levelcheck
+        man = {e["map"]: e for _, e in mapc.load_manifest()}
+        rom, names = 0, []
+        for f in sorted(os.listdir(mapc.MAPS_DIR)):
+            if not f.endswith(".txt") or f == "platforms.txt":
+                continue
+            name = f[:-4]
+            if name in man and not man[name]["gba"]:
+                continue                     # a new level the GBA does not carry (compiled out)
+            m = mapc.parse_map(os.path.join(mapc.MAPS_DIR, f))
+            w, h, cells, things = mapc.build(m)
+            rom += levelcheck.rom_estimate(m, cells, things)
+            names.append(name)
+        new = [n for n in names if n in man]
+        out.append("memreport: levels ROM %7d bytes of map tables (%d maps: %d shipped + %d new `gba yes` of the 7)" % (
+            rom, len(names), len(names) - len(new), len(new)))
+        absent = sum(1 for e in man.values() if e["gba"] and not os.path.exists(os.path.join(mapc.MAPS_DIR, e["map"] + ".txt")))
+        if absent:
+            out.append("memreport:   %d of the 7 GBA levels have no map file yet" % absent)
+    except Exception as e:                   # the report must never fail a build
+        out.append("memreport: levels ROM not computed (%s)" % e)
+    ew = iw = 0
+    parts = {}
+    for m in re.finditer(r"^ (\.(?:bss|data|iwram|iwram_bss|iwram_data|ewram_bss|noinit)[^\s]*)\s*\n?\s+0x([0-9a-f]+)"
+                         r"\s+0x([0-9a-f]+)\s+(\S+)", text, re.M):
+        addr, size, obj = int(m.group(2), 16), int(m.group(3), 16), m.group(4)
+        base = obj.split("/")[-1]
+        if not size or not LEVEL_OBJS.search(base):
+            continue
+        key = re.sub(r"\.c?\.?o(bj)?$", "", base)
+        if 0x02000000 <= addr < 0x03000000:
+            ew += size
+            parts[key] = parts.get(key, 0) + size
+        elif 0x03000000 <= addr < 0x04000000:
+            iw += size
+    out.append("memreport: levels EWRAM %5d bytes, IWRAM %d bytes in the levels objects (%s); breachpack %d" % (
+        ew, iw, ", ".join("%s %d" % kv for kv in sorted(parts.items())) or "none", parts.get("breachpack", 0)))
+    return out
+
+
 def main():
     if len(sys.argv) < 2:
         sys.exit("usage: memreport.py ROM.map")
@@ -85,6 +141,8 @@ def main():
     objs.sort(reverse=True)
     for size, addr, sec, obj in objs[:12]:
         print("memreport:   %6d  0x%08x  %-28s %s" % (size, addr, sec[:28], obj))
+    for row in levels_rows(text):
+        print(row)
     if stack < STACK_MIN:
         print("memreport: FAIL: main stack %d < %d bytes" % (stack, STACK_MIN))
         return 1
