diff --git a/ps1/src/breachdisc.c b/ps1/src/breachdisc.c
new file mode 100644
index 0000000..3045ad8
--- /dev/null
+++ b/ps1/src/breachdisc.c
@@ -0,0 +1,153 @@
+/* breachdisc.c - level packs read from BREACH.BIN on the disc (owner: levels; LV8).
+ *
+ * BREACH.BIN (tools/packbreach.py --platform ps1) is a directory sector, then the level packs on sector boundaries
+ * (core/include/doomo/breachpack.h; docs/LEVELS.md "Level packs"). Nothing of it is resident: this file and the core
+ * reader (core/src/breachpack.c) are code of the combat + levels overlay group (ovl_plan.py: `breach(pack|disc)`), and
+ * the loaded level lives in the core's 12 KB scene scratch block (scene_scratch(), tag 'LVLP'), which no combat level
+ * uses:
+ *
+ *     [ BpLevel | arena the reader fills (tables + text + the packed cells) | 2 KB sector window ]
+ *
+ * The cells stay LZ-packed ("LZMC": BP_CELLS_LZMC) and def.cells points at them, so map_def_cells() in packart.c
+ * decodes them straight into the live map as for the 12 shipped maps. The level's texture bank is not kept: its
+ * frame 0 of each slot is read from the disc and uploaded to the pinned world-texture slots 72..79 (vram.c,
+ * vram_wtex_pin), ids 56 + k, at most 8 of the 80. Animated bank frames are not shown on the PS1 yet (frame 0 stays).
+ *
+ * Load cost: the CRC pass reads the pack once, the load reads it again, the bank another 4 KB a slot: at most
+ * 2 x 96 KB + 32 KB = 224 KB, 0.75 s at 2x speed (300 KB/s): inside the 1 s of the plan (behind the intro card).
+ * Built only with cmake -DDOOMO_BREACH_BIN=ON: the shipped disc links none of it.
+ */
+#include <string.h>
+#include <psxapi.h>
+#include <psxcd.h>
+#include "ps1.h"
+
+#if defined(DOOMO_HAVE_CORE) && defined(DOOMO_BREACH_BIN)
+#include "doomo/scene.h"
+#include "doomo/breachpack.h"
+#include "doomo/texbank.h"
+
+#define SECTOR      2048
+#define LVLP_TAG    0x504C564Cu                 /* 'LVLP' */
+#define BLOCK       DOOMO_SCENE_SCRATCH
+#define HEAD_ROOM   ((sizeof(BpLevel) + 3u) & ~3u)
+
+static int       s_lba = -1;                    /* BREACH.BIN: -1 not looked up, -2 missing */
+static uint32_t  s_size;
+static uint32_t *s_win;                         /* the sector window (in the scratch block) */
+static int       s_have = -1;                   /* sector of the file in the window */
+static int       s_level = -1;                  /* the level in the block, -1 none */
+
+static int read_sector(int lba, void *dst)
+{
+    CdlLOC loc;
+    int tries;
+    for (tries = 0; tries < 4; tries++) {
+        CdIntToPos(lba, &loc);
+        if (!CdControl(CdlSetloc, &loc, 0))
+            continue;
+        if (!CdRead(1, (uint32_t *)dst, CdlModeSpeed))
+            continue;
+        if (CdReadSync(0, 0) >= 0)
+            return 1;
+    }
+    return 0;
+}
+
+/* BpRead: any byte range of the file through the one-sector window */
+static int rd_disc(void *ctx, uint32_t off, void *dst, uint32_t n)
+{
+    uint8_t *d = (uint8_t *)dst;
+    (void)ctx;
+    if (off > s_size || n > s_size - off) return 0;
+    while (n) {
+        uint32_t sec = off / SECTOR, in = off % SECTOR, k = SECTOR - in;
+        if (k > n) k = n;
+        if (s_have != (int)sec) {
+            s_have = -1;
+            if (!read_sector(s_lba + (int)sec, s_win)) return 0;
+            s_have = (int)sec;
+        }
+        memcpy(d, (const uint8_t *)s_win + in, k);
+        d += k; off += k; n -= k;
+    }
+    return 1;
+}
+
+static int find_bin(void)
+{
+    CdlFILE f;
+    if (s_lba >= 0) return 1;
+    if (s_lba == -2) return 0;
+    if (!CdSearchFile(&f, "\\BREACH.BIN;1")) {
+        dbg("breach: BREACH.BIN missing\n");
+        s_lba = -2;
+        return 0;
+    }
+    s_lba = CdPosToInt(&f.pos);
+    s_size = f.size;
+    return 1;
+}
+
+/* the pinned textures: frame 0 of each bank slot, 2 KB at a time */
+static int pin_bank(const BpLevel *l, uint32_t bank_in_file)
+{
+    uint8_t hd[DOOMO_TEXBANK_HDR + DOOMO_TEXBANK_ENT * DOOMO_TEXBANK_MAX];
+    uint32_t rows[SECTOR / 4];                   /* 2 KB of stack, for the duration of the load only */
+    uint32_t k, count, pix = 0, bank = bank_in_file;
+    if (!rd_disc(NULL, bank, hd, DOOMO_TEXBANK_HDR)) return 0;
+    count = hd[5];
+    if (count > DOOMO_TEXBANK_MAX) return 0;
+    if (!rd_disc(NULL, bank + DOOMO_TEXBANK_HDR, hd + DOOMO_TEXBANK_HDR, count * DOOMO_TEXBANK_ENT)) return 0;
+    pix = bank + DOOMO_TEXBANK_HDR + count * DOOMO_TEXBANK_ENT;
+    for (k = 0; k < count; k++) {
+        uint32_t frames = hd[DOOMO_TEXBANK_HDR + k * DOOMO_TEXBANK_ENT + 12];
+        int half;
+        if (k < l->ext.texbank_count && l->ext.texbank[k][0]) {
+            for (half = 0; half < 2; half++) {
+                if (!rd_disc(NULL, pix + half * SECTOR, rows, SECTOR)) return 0;
+                vram_wtex_pin((int)k, half, rows);
+            }
+        }
+        pix += frames * 4096u;
+    }
+    return 1;
+}
+
+int plat_breach_level(int level, const DoomoMapDef **def, const DoomoMapExt **ext)
+{
+    uint8_t *blk;
+    BpLevel *l;
+    uint32_t room, need = 0, t0 = timer_us();
+    int r;
+    if (def) *def = NULL;
+    if (ext) *ext = NULL;
+    if (!find_bin()) return BP_ERR_READ;
+    blk = (uint8_t *)scene_scratch(LVLP_TAG, BLOCK);
+    if (!blk) return BP_ERR_ARENA;
+    s_level = -1;
+    vram_wtex_unpin();
+    l = (BpLevel *)(void *)blk;
+    s_win = (uint32_t *)(void *)(blk + BLOCK - SECTOR);
+    s_have = -1;
+    room = BLOCK - SECTOR - HEAD_ROOM;
+    r = bp_bin_load(rd_disc, NULL, s_size, level, BP_CELLS_LZMC, blk + HEAD_ROOM, room, NULL, &need, l);
+    if (r != BP_OK) {
+        dbg("breach: level %d: %s (arena %u of %u)\n", level, bp_strerror(r), (unsigned)need, (unsigned)room);
+        return r;
+    }
+    if (l->tb_len && !pin_bank(l, l->tb_off)) {
+        dbg("breach: level %d: texture bank read failed\n", level);
+        vram_wtex_unpin();
+        return BP_ERR_READ;
+    }
+    s_level = level;
+    dbg("breach: level %d '%s' loaded in %u ms (arena %u of %u B)\n", level, l->def.name,
+        (unsigned)((timer_us() - t0) / 1000), (unsigned)need, (unsigned)room);
+    if (def) *def = &l->def;
+    if (ext) *ext = &l->ext;
+    return BP_OK;
+}
+
+int ps1_breach_current(void) { return s_level >= 0 && scene_scratch_mine(LVLP_TAG) ? s_level : -1; }
+#endif /* DOOMO_HAVE_CORE && DOOMO_BREACH_BIN */
