+/* tests: put the player on tile (tx,ty) facing dir; returns 1 when A would find a piece (or the wall) in front */
+int home_draw_test_player(int tx, int ty, int dir)
+{
+    static const int8_t fdx[4] = { 0, -1, 1, 0 }, fdy[4] = { 1, 0, 0, -1 };
+    int k, hit = 0;
+    if (!H) return 0;
+    H->px = INT2FIX(tx) + FIX_ONE / 2;
+    H->py = INT2FIX(ty) + FIX_ONE / 2;
+    H->pdir = (uint8_t)(dir & 3);
+    for (k = 0; k < 2; k++) {
+        int x = tx + fdx[dir & 3] * k, y = ty + fdy[dir & 3] * k;
+        int idx = home_obj_at(&H->ed.room, x, y);
+        if (idx < 0 && (x <= 0 || y <= 0)) {             /* the same lookup as live_use */
+            if (y <= 0) idx = home_obj_at(&H->ed.room, x, 0);
+            if (idx < 0 && x <= 0) idx = home_obj_at(&H->ed.room, 0, y);
+        }
+        if (idx >= 0) hit = 1;
+    }
+    return hit;
+}
