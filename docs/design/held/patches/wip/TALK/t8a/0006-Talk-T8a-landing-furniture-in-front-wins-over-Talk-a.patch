+TEST(home_talk_a_housemate_nearby_does_not_pre_empt_the_furniture_in_front)
+{
+    HomeTalkRoom rm;
+    int w, dx, dy, d, furn_tried = 0, free_tried = 0;
+    live_house(2, 0);
+    CHECK(home_draw_talk_room(&rm));
+    for (w = 0; w < rm.nwho && !(furn_tried && free_tried); w++) {
+        int wx = tile_of(rm.who[w].x), wy = tile_of(rm.who[w].y);
+        for (dy = -1; dy <= 1; dy++)
+            for (dx = -1; dx <= 1; dx++) {
+                int tx = wx + dx, ty = wy + dy;
+                static const int fdx[4] = { 0, -1, 1, 0 }, fdy[4] = { 1, 0, 0, -1 };
+                if (!dx && !dy) continue;
+                if (tx < 1 || ty < 1 || tx >= 14 || ty >= 14 || ((rm.occ[ty] >> tx) & 1)) continue;
+                for (d = 0; d < 4; d++) {
+                    int onfront = tx + fdx[d] == wx && ty + fdy[d] == wy;
+                    int furn = home_draw_test_player(tx, ty, d);
+                    if (onfront || (furn ? furn_tried : free_tried)) continue;
+                    CHECK(home_draw_talk_room(&rm));
+                    press(BTN_A);
+                    frames(2);
+                    if (furn) { CHECK_MSG(!home_talk_on(), "furniture ahead at (%d,%d) dir %d, housemate at (%d,%d)", tx, ty, d, wx, wy); furn_tried++; }
+                    else { CHECK_MSG(home_talk_on(), "nothing ahead at (%d,%d) dir %d: Talk", tx, ty, d); free_tried++; }
+                    home_talk_abort();
+                    frames(3);
+                    if (furn_tried && free_tried) goto done;
+                }
+            }
+    }
+done:
+    CHECK(furn_tried > 0);
+    CHECK(free_tried > 0);
+}
