+/* ---- seats and the view -------------------------------------------------------------------------------------- */
+static int actor_sits(int id)
+{
+    HomeTalkActor a[6];
+    int n = home_talk_actors(a, 6), k;
+    for (k = 0; k < n; k++) if (a[k].id == id) return a[k].sit;
