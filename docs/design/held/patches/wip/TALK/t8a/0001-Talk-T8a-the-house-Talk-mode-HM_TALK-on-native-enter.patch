+    H->talk_view = H->view_k;
+    H->view_k = (uint8_t)k;
+    H->mode = HM_TALK;
+    H->menu = HMN_NONE;
+    H->sitting = 0;
+    H->pwalk = 0;
+    H->held = -1;
+    return 1;
+}
