+/* Start Talk (talk.h home_talk_enter is this): who = a person's id, TALK_PET_ID, or -1 the nearest */
+int home_draw_talk_start(int who)
+{
+    HomeTalkRoom rm;
+    int k, here = who < 0;
+    if (!H || scene_top() != &SCENE_HOME || !scene_scratch_mine(HD_TAG)) return 0;
+    if (!home_draw_talk_room(&rm)) return 0;
+    for (k = 0; k < rm.nwho; k++) if (rm.who[k].id == who) here = 1;
+    if (!here) return 0;
