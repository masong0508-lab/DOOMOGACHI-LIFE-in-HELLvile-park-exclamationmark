+/* home_talk.c - HM_TALK, the house's Talk mode (owner: TK, package T8a; docs/TALK.md "The house Talk
+ * mode"; design 4 and 2). Native only until TKP: everything below is inside DOOMO_HAS_TALK (core/Makefile),
+ * so the GBA, PS1 and Dreamcast builds link none of it and their RAM and speed do not change.
+ *
+ * What is here (T8a): entering Talk, gathering the people of the room and their seats, the camera, speech
+ * bubbles drawn at the speakers' heads (plat_room_project), driving talk_dm (talk_dm_say / _step / _tick /
+ * _end) so that a session shows its lines in bubbles, leaving, the control card and the one instruction
+ * line. What is NOT here yet (T8b / T8c): the portrait inset, emotes, quick replies, catch-the-word, the
+ * composer, the typed line, invites. The "starters" below are a stand-in so that a person at the pad can say
+ * something; the quick replies replace them.
+ *
+ * The seams, so that the later packages can build on this:
+ *   home_draw.c  owns the room and the scene (static HomeScn). It calls home_talk_begin() with a
+ *                HomeTalkRoom (everyone present, the seats, the free floor), and in HM_TALK it calls
+ *                home_talk_update / _view / _actors / _draw / _prompts. Nothing else of the house is touched.
+ *   home_talk.c  owns the conversation: gather() picks who joins and where they stand, pick_view() the
+ *                quarter turn, cam_*() the shots, bub_*() the bubbles, pump() the drama manager. T8b adds the
+ *                portrait inset and emotes in home_talk_draw(); T8c adds input sources that all end in
+ *                home_talk_say().
+ *   talk_dm.c    the policy. Every utterance goes through talk_dm_say(), which runs the audience gate, so no
+ *                caller here can skip a safety rule. The audience is everyone present: nobody is left out of
+ *                talk_dm_begin() (pick_who() drops an adult before a child or the pet), so a child in the
+ *                room makes the room kid-safe for the whole talk.
+ *
+ * State: one static HomeTalk (1,492 B on x86-64) and the room it was told about (a HomeTalkRoom, 168 B) and the parser's name buffer (96 B), native
+ * only. TP2 moves them into the house's scene scratch.
+ */
+#include "home_int.h"
+#include "doomo/tween.h"
+#include "doomo/audio.h"
+#include "doomo/portrait.h"
+#include "doomo/playas.h"
+#include "doomo/family.h"
+#include "doomo/life.h"
+#include "doomo/lang.h"
+#include "doomo/ui.h"
+#include "doomo/font.h"
+#include "doomo/input.h"
+#include "doomo/plat_ext.h"
+
+typedef int home_talk_unit_;         /* an empty unit is not allowed in ISO C */
+
+#ifdef DOOMO_HAS_TALK
+
+/* ---- timing (frames at 30 Hz) and limits ----------------------------------------------------- */
+#define HTT_GATHER_MIN   12          /* design 4.2: everyone walks to the spot in 12-20 frames        */
+#define HTT_GATHER_MAX   20
+#define HTT_LEAVE        14          /* walking back                                                  */
+#define HTT_OUT          20          /* a resident who walks out goes to the door                     */
+#define HTT_HOLD_BASE    30          /* a finished bubble stays: base + per char, up to the cap       */
+#define HTT_HOLD_CHAR    2
+#define HTT_HOLD_MAX     150
+#define HTT_HOLD_CUT     6           /* an interrupted line is cut off at once                        */
+#define HTT_ME_HOLD      30          /* the player's own bubble                                       */
+#define HTT_PREV_HOLD    150         /* the faded previous bubble stays this long once nobody is speaking */
+#define HTT_CAM_GAP      45          /* at most one camera move in this many frames (design 4.2)      */
+#define HTT_CAM_RETURN   90          /* quiet this long and the shot goes back to the group           */
+#define HTT_PUSH_Q8      26          /* 1.1x                                                          */
+#define HTT_SHAKE        4           /* an interrupted bubble shakes for 4 frames                     */
+#define HTT_OVER_HOLD    40          /* the talk is over: the last line stays, then everyone leaves   */
+#define HTT_PAN_MAX      12          /* px the shot may pan toward a speaker                          */
+#define HTT_FRAME_X      24          /* px the framing may slide the room toward the group (x, y)     */
+#define HTT_FRAME_Y      8
+#define HTT_HEAD         30          /* px above the feet where the bubble's tail points              */
+
+enum { HTS_OFF, HTS_GATHER, HTS_TALK, HTS_LEAVE };
+enum { HTB_NONE, HTB_TYPE, HTB_HOLD };
+enum { HTC_GROUP, HTC_SPEAKER, HTC_TWO };
+
+typedef struct HtPerson {
+    int16_t  id;                     /* resident / pool id, TALK_PET_ID, -1 the player                */
+    fix16    x, y;                   /* now                                                           */
+    fix16    fx, fy, tx, ty;         /* from (where the house had them), to (the conversation's spot) */
+    uint8_t  sit, out, gone;         /* seated; walking out to the door; out of the talk              */
+    uint8_t  dir, frame;             /* facing (bodyspr dir), walk frame                              */
+    uint8_t  out_t;                  /* frames spent walking out                                      */
+    uint8_t  tile_x, tile_y;         /* the tile of the spot                                          */
+    uint8_t  rot;                    /* a seat's rot                                                  */
+} HtPerson;
+
+typedef struct HtBubble {
+    char     text[TALK_LINE_MAX];    /* with the line codes taken out                                 */
+    int8_t   who;                    /* participant slot, -1 the player                               */
+    uint8_t  phase, cut;             /* HTB_*; the line was cut off (it shakes when it is all there)  */
+    uint8_t  shake, sincere;
+    uint16_t age;                    /* frames in this phase                                          */
+    uint16_t shown, len;             /* half characters shown, characters in all                      */
+} HtBubble;
+
+typedef struct HomeTalk {
+    TalkState  dm;
+    uint8_t    state, n, view_k, stepping, opened_db, starter, over_t, cam_shot;
+    uint8_t    last_who, sincere_q, have_sum, cam_ever;
+    uint16_t   t;                    /* frames in the state                                           */
+    uint16_t   dur;                  /* frames this state lasts (gather, leave)                       */
+    uint16_t   cam_t;                /* frame (T.t) of the last camera move                           */
+    uint16_t   cam_moves, cam_min_gap;   /* tests: moves made, the shortest gap between two           */
+    HtPerson   p[TALK_PARTS_MAX];
+    HtPerson   me;
+    HtBubble   cur, prev;
+    fix16      fx, fy, fr;           /* the framing now (tile space)                                  */
+    int8_t     pan_x, pan_y, pan_tx, pan_ty;
+    TwSpring   push;                 /* the boing of a new speaker's shot                             */
+    TalkSummary sum;
+    uint32_t   serial;               /* talks started (the seed)                                      */
+} HomeTalk;
+
+static HomeTalk T;
+static HomeTalkRoom R;               /* the room as told at the start (the door, the free floor)      */
+
+/* the starters: what A says until T8b's quick replies (act, tone, label, the player's bubble) */
+static const struct { uint8_t act, tone; const char *label, *say; } starters[] = {
+    { TA_GREET,       TONE_WARM,   "Say hi",           "Hi, everyone!" },
+    { TA_ASK_FEELING, TONE_PLAIN,  "Ask how they are", "How is everyone?" },
+    { TA_COMPLIMENT,  TONE_WARM,   "Compliment",       "You all look great." },
+    { TA_JOKE,        TONE_CHEEKY, "Tell a joke",      "Knock, knock!" },
+    { TA_THANK,       TONE_WARM,   "Say thanks",       "Thanks, all of you." },
+};
+#define NSTARTERS ((int)(sizeof(starters) / sizeof(starters[0])))
+
+/* ---- small helpers ------------------------------------------------------------------------- */
+static int iabs(int v) { return v < 0 ? -v : v; }
+static fix16 centre(int t) { return INT2FIX(t) + FIX_ONE / 2; }
+
+/* a tile of the room in the turned view (room_ref.c: (x, y) -> (D - 1 - y, x) a step) */
+static void rot_tile(int k, int w, int d, int *x, int *y)
+{
+    while (k-- > 0) {
+        int t = *x;
+        *x = d - 1 - *y;
+        *y = t;
+        t = w; w = d; d = t;
+    }
+}
+
+static int view_y(int k, int x, int y)
+{
+    rot_tile(k, R.w, R.d, &x, &y);
+    return y;
+}
+
+/* what a vector of the room looks like on the screen in view k: the iso projection's dx (units) and dy (x2) */
+static void screen_delta(int k, fix16 dx, fix16 dy, int *sx, int *sy)
+{
+    int vx = FIX2INT(dx * 16), vy = FIX2INT(dy * 16), t;    /* 16 units a tile, as room_ref.c */
+    for (; k > 0; k--) { t = vx; vx = -vy; vy = t; }
+    *sx = vx - vy;
+    *sy = (vx + vy) / 2;
+}
+
+/* what a seat's rot looks like in view k: rots 0 / 1 show their front (furn.h). 3 straight on, then 2, 1, 0 */
+static int seat_front(int rot, int k)
+{
+    static const uint8_t score[4] = { 3, 2, 0, 1 };
+    return score[(rot - k) & 3];
+}
+
+static int tile_free(int x, int y)
+{
+    return x >= 0 && y >= 0 && x < R.w && y < R.d && !((R.occ[y] >> x) & 1);
+}
+
+static const char *name_of(int id)
+{
+    if (id == TALK_PET_ID) return doomo_town.pet.name[0] ? doomo_town.pet.name : "Boreagotchi";
+    if (id < 0) return "You";
+    if (id > DOOMO_PLAYER_ID) return family_name(id);
+    {
+        const DoomoResident *r = town_res(id);
+        return r && r->status != RES_EMPTY ? r->name : "?";
+    }
+}
+
+/* ---- who joins (design 4.1) -------------------------------------------------------------------- */
+/* The room's audience is everyone present. At most TALK_PARTS_MAX can join; when the room holds more: the
+ * target first, then the children and the pet (the safety rules read them), then the others by distance to
+ * the player. An adult is dropped before a child or the pet is. Returns the count; order[] indexes room->who. */
+static int pick_who(const HomeTalkRoom *room, int target, int *order)
+{
+    int n = 0, i, j, used[HTK_WHO_MAX], key[HTK_WHO_MAX], nw = room->nwho < HTK_WHO_MAX ? room->nwho : HTK_WHO_MAX;
+    for (i = 0; i < nw; i++) {
+        int id = room->who[i].id, dx, dy;
+        used[i] = 0;
+        if (id < 0 || id == room->avatar) used[i] = 1;                      /* nobody, or the player themselves */
+        for (j = 0; j < i; j++) if (room->who[j].id == id) used[i] = 1;     /* once */
+        dx = FIX2INT(room->who[i].x - room->px);
+        dy = FIX2INT(room->who[i].y - room->py);
+        key[i] = 100 + iabs(dx) + iabs(dy);
+        if (id == target) key[i] = 0;
+        else if (id == TALK_PET_ID || talk_safe_minor(id)) key[i] -= 50;
+    }
+    while (n < TALK_PARTS_MAX) {
+        int best = -1;
+        for (i = 0; i < nw; i++)
+            if (!used[i] && (best < 0 || key[i] < key[best])) best = i;
+        if (best < 0) break;
+        used[best] = 1;
+        order[n++] = best;
+    }
+    return n;
+}
+
+/* ---- where they stand (design 4.2) ------------------------------------------------------------- */
+static void place(HtPerson *p, int tx, int ty, int sit, int rot)
+{
+    p->tile_x = (uint8_t)tx;
+    p->tile_y = (uint8_t)ty;
+    p->tx = centre(tx);
+    p->ty = centre(ty);
+    p->sit = (uint8_t)sit;
+    p->rot = (uint8_t)rot;
+}
+
+/* the quarter turn that shows the seated residents' fronts the most (a tie keeps the view it is in) */
+static int pick_view(const int *rots, int nrot, int cur)
+{
+    int k, best = cur, bs = -1;
+    if (!nrot) return cur;
+    for (k = 0; k < 4; k++) {
+        int kk = (cur + k) & 3, s = 0, i;
+        for (i = 0; i < nrot; i++) s += seat_front(rots[i], kk);
+        if (s > bs) { bs = s; best = kk; }
+    }
+    return best;
+}
+
+static int spot_taken(int x, int y)
+{
+    int k;
+    for (k = 0; k < T.n; k++) if (T.p[k].tx && T.p[k].tile_x == x && T.p[k].tile_y == y) return 1;
+    return T.me.tx && T.me.tile_x == x && T.me.tile_y == y;
+}
+
+/* The best free standing tile round (ax, ay) for someone starting at (sx, sy): about two tiles from the
+ * anchor (a ring), on the camera's side (a half circle: a tile behind costs more), not next to anyone, and not
+ * far to walk. `front` is the player: a little further out, pulled toward the camera (the open side). */
+static int stand_tile(int ax, int ay, int sx, int sy, int front, int *ox, int *oy)
+{
+    int x, y, best = 0x7FFFFFFF, found = 0, vya = view_y(T.view_k, ax, ay);
+    for (y = 0; y < R.d; y++)
+        for (x = 0; x < R.w; x++) {
+            int dx = x - ax, dy = y - ay, d2 = dx * dx + dy * dy, vy, cost, pen, want = front ? 9 : 4, k;
+            if (!tile_free(x, y) || d2 < 1 || spot_taken(x, y)) continue;
+            vy = view_y(T.view_k, x, y) - vya;
+            pen = front ? -6 * DOOMO_CLAMP(vy, -2, 2) : (vy < -1 ? 8 : 0);
+            for (k = 0; k < T.n; k++)                       /* room to breathe: not shoulder to shoulder */
+                if (T.p[k].tx && iabs(T.p[k].tile_x - x) <= 1 && iabs(T.p[k].tile_y - y) <= 1) pen += 10;
+            cost = (iabs(d2 - want) * 3 + pen) * 4 + iabs(x - sx) + iabs(y - sy);
+            if (cost < best) { best = cost; *ox = x; *oy = y; found = 1; }
+        }
+    return found;
+}
+
+static void gather(const HomeTalkRoom *room, int n)
+{
+    int i, k, ncl = 0, cl[HTK_SEATS], seat_taken[HTK_SEATS], nrot = 0, rots[TALK_PARTS_MAX + 1];
+    int ax = room->w / 2, ay = room->d / 2, have_anchor = 0, best_n = 0, best_i = 0, nseat = room->nseat;
+    if (nseat > HTK_SEATS) nseat = HTK_SEATS;
+    memset(seat_taken, 0, sizeof(seat_taken));
+    /* 1. the largest seat cluster: the seats within 3 tiles of the seat with the most of them near */
+    for (i = 0; i < nseat; i++) {
+        int c = 0;
+        for (k = 0; k < nseat; k++)
+            if (iabs(room->seat[k].x - room->seat[i].x) <= 3 && iabs(room->seat[k].y - room->seat[i].y) <= 3) c++;
+        if (c > best_n) { best_n = c; best_i = i; }
+    }
+    if (best_n > 0) {
+        int sx = 0, sy = 0;
+        for (k = 0; k < nseat; k++)
+            if (iabs(room->seat[k].x - room->seat[best_i].x) <= 3 && iabs(room->seat[k].y - room->seat[best_i].y) <= 3) {
+                cl[ncl++] = k;
+                sx += room->seat[k].x;
+                sy += room->seat[k].y;
+            }
+        ax = sx / ncl;
+        ay = sy / ncl;
+        have_anchor = 1;
+    }
+    for (i = 0; i < n; i++) {                           /* residents sit, the nearest free seat first; the pet stands */
+        HtPerson *p = &T.p[i];
+        int bi = -1, bd = 0x7FFF;
+        if (p->id == TALK_PET_ID) continue;
+        for (k = 0; k < ncl; k++) {
+            int s = cl[k], d = iabs(room->seat[s].x - FIX2INT(p->fx)) + iabs(room->seat[s].y - FIX2INT(p->fy));
+            if (!seat_taken[s] && d < bd) { bd = d; bi = s; }
+        }
+        if (bi < 0) continue;
+        seat_taken[bi] = 1;
+        place(p, room->seat[bi].x, room->seat[bi].y, 1, room->seat[bi].rot);
+        rots[nrot++] = room->seat[bi].rot;
+    }
+    T.view_k = (uint8_t)pick_view(rots, nrot, room->view_k);
+    /* 2. a table, if there is no seat cluster */
+    if (!have_anchor && room->ntable) {
+        ax = room->table[0].x + room->table[0].w / 2;
+        ay = room->table[0].y + room->table[0].d / 2;
+    }
+    /* 3. the rest stand in a half circle on the camera's side of the anchor */
+    for (i = 0; i < n; i++) {
+        HtPerson *p = &T.p[i];
+        int tx, ty;
+        if (p->tx) continue;
+        if (stand_tile(ax, ay, FIX2INT(p->fx), FIX2INT(p->fy), 0, &tx, &ty)) place(p, tx, ty, 0, 0);
+    }
+    /* the player: a spare seat of the cluster, else the open side */
+    {
+        int bi = -1, bd = 0x7FFF, tx, ty;
+        for (k = 0; k < ncl; k++) {
+            int s = cl[k], d = iabs(room->seat[s].x - FIX2INT(T.me.fx)) + iabs(room->seat[s].y - FIX2INT(T.me.fy));
+            if (!seat_taken[s] && d < bd) { bd = d; bi = s; }
+        }
+        if (bi >= 0) place(&T.me, room->seat[bi].x, room->seat[bi].y, 1, room->seat[bi].rot);
+        else if (stand_tile(ax, ay, FIX2INT(T.me.fx), FIX2INT(T.me.fy), 1, &tx, &ty)) place(&T.me, tx, ty, 0, 0);
+    }
+}
+
+/* ---- the camera (design 4.2) --------------------------------------------------------------------- */
+/* the group shot: everyone still in the talk and the player, a tile of head margin; the two-shot of an
+ * argument: the two who row */
+static void cam_frame(void)
+{
+    fix16 minx = 0x7FFFFFFF, maxx = -0x7FFFFFFF, miny = 0x7FFFFFFF, maxy = -0x7FFFFFFF;
+    int k, any = 0, two = T.cam_shot == HTC_TWO && T.dm.arg_a >= 0 && T.dm.arg_b >= 0;
+    for (k = -1; k < T.n; k++) {
+        const HtPerson *p = k < 0 ? &T.me : &T.p[k];
+        if (k >= 0 && (p->gone || p->out)) continue;
+        if (two && k >= 0 && k != T.dm.arg_a && k != T.dm.arg_b) continue;
+        if (two && k < 0) continue;
+        if (p->x < minx) minx = p->x;
+        if (p->x > maxx) maxx = p->x;
+        if (p->y < miny) miny = p->y;
+        if (p->y > maxy) maxy = p->y;
+        any = 1;
+    }
+    if (!any) return;
+    T.fx = (minx + maxx) / 2;
+    T.fy = (miny + maxy) / 2;
+    {
+        fix16 rx = (maxx - minx) / 2, ry = (maxy - miny) / 2;
+        T.fr = (rx > ry ? rx : ry) + FIX_ONE;
+    }
+}
+
+/* The camera may change its shot once in HTT_CAM_GAP frames; 1 if it did. */
+static int cam_move(int shot)
+{
+    if (T.cam_ever && (uint16_t)(T.t - T.cam_t) < HTT_CAM_GAP) return 0;
+    if (T.cam_ever && (uint16_t)(T.t - T.cam_t) < T.cam_min_gap) T.cam_min_gap = (uint16_t)(T.t - T.cam_t);
+    T.cam_ever = 1;
+    T.cam_t = T.t;
+    T.cam_shot = (uint8_t)shot;
+    T.cam_moves++;
+    return 1;
+}
+
+static void cam_tick(void)
+{
+    int arg = T.dm.arg_step > 0 && T.dm.arg_a >= 0 && T.dm.arg_b >= 0;
+    if (arg && T.cam_shot != HTC_TWO) cam_move(HTC_TWO);
+    else if (!arg && T.cam_shot == HTC_TWO) cam_move(HTC_GROUP);
+    else if (T.cam_shot == HTC_SPEAKER && T.cur.phase == HTB_NONE && (uint16_t)(T.t - T.cam_t) > HTT_CAM_RETURN) cam_move(HTC_GROUP);
+    cam_frame();
+    if (T.cam_shot == HTC_SPEAKER && T.last_who < T.n) {                /* pan toward the speaker's head */
+        const HtPerson *p = &T.p[T.last_who];
+        int sx, sy;
+        screen_delta(T.view_k, p->x - T.fx, p->y - T.fy, &sx, &sy);
+        T.pan_tx = (int8_t)DOOMO_CLAMP(-sx / 4, -HTT_PAN_MAX, HTT_PAN_MAX);
+        T.pan_ty = (int8_t)DOOMO_CLAMP(-sy / 4, -HTT_PAN_MAX / 2, HTT_PAN_MAX / 2);
+    } else {
+        T.pan_tx = T.pan_ty = 0;
+    }
+    if (T.pan_x < T.pan_tx) T.pan_x++; else if (T.pan_x > T.pan_tx) T.pan_x--;
+    if (T.pan_y < T.pan_ty) T.pan_y++; else if (T.pan_y > T.pan_ty) T.pan_y--;
+    tw_spring_step(&T.push);
+    /* a sincere line: a slow push in, and back out */
+    if (T.cur.sincere && T.cur.phase != HTB_NONE) { if (T.sincere_q < HTT_PUSH_Q8) T.sincere_q++; }
+    else if (T.sincere_q) T.sincere_q--;
+}
+
+/* The shot for the platform: zoom 2 with the framing circle (a renderer that can scale fits it: the
+ * Dreamcast and the PS1 do), and a pan that already slides the picture toward the group, so the native
+ * reference renderer, which draws at one scale and ignores zoom (room_ref.c, the T0 contract), frames it too:
+ * three quarters of the way from the room's middle to the group's, then the speaker's pan on top. */
+void home_talk_view(DoomoRoomView *v)
+{
+    int punch = (int)(T.push.e / 16), fsx, fsy;             /* Q4 -> Q8 */
+    if (!v) return;
+    screen_delta(T.view_k, T.fx - INT2FIX(R.w) / 2, T.fy - INT2FIX(R.d) / 2, &fsx, &fsy);
+    v->yaw = (int16_t)(T.view_k * 1024);
+    v->zoom = 2;
+    v->focus_x = T.fx;
+    v->focus_y = T.fy;
+    v->focus_r = T.fr;
+    v->pan_x = (int8_t)(DOOMO_CLAMP(-fsx * 3 / 4, -HTT_FRAME_X, HTT_FRAME_X) + T.pan_x);
+    v->pan_y = (int8_t)(DOOMO_CLAMP(-fsy * 3 / 4, -HTT_FRAME_Y, HTT_FRAME_Y) + T.pan_y);
+    v->punch_q8 = (int16_t)(256 + DOOMO_CLAMP(punch, 0, 64) + T.sincere_q);
+}
+
+/* ---- bubbles (design 4.3) ---------------------------------------------------------------------------- */
+/* the line without its ui_dialog codes: {d} {!} {big} {/} {w} {r} {cut N} {punch} {p N} and the page break */
+static void strip_codes(const char *in, char *out, int cap)
+{
+    int o = 0;
+    while (*in && o < cap - 1) {
+        if (*in == '{') {
+            while (*in && *in != '}') in++;
+            if (*in) in++;
+            continue;
+        }
+        if (*in == '/' && in[1] == '/') { in += 2; continue; }
+        out[o++] = *in++;
+    }
+    out[o] = 0;
+}
+
+static void bub_start(HtBubble *b, const char *text, int who, int cut, int sincere)
+{
+    memset(b, 0, sizeof(*b));
+    strip_codes(text, b->text, (int)sizeof(b->text));
+    b->who = (int8_t)who;
+    b->phase = HTB_TYPE;
+    b->cut = (uint8_t)cut;
+    b->sincere = (uint8_t)sincere;
+    b->len = (uint16_t)strlen(b->text);
+}
+
+static void babble(int who, char c)
+{
+    DoomoResident fr;
+    const DoomoResident *r = NULL;
+    uint8_t voice[VOICE_COUNT];
+    int id;
+    if (!opt_get(OPT_VOICE_BABBLE) || c == ' ' || who < 0 || who >= T.n) return;
+    id = T.p[who].id;
+    if (id == TALK_PET_ID) { audio_voice_char(audio_voice_preset(VOICE_GURGLE), c); return; }
+    if (id < PLAYAS_ID_FAMILY_FIRST) r = town_res(id);
+    else if (family_resident(id, &fr)) r = &fr;
+    if (!r) return;
+    res_get_voice(r, voice);
+    audio_voice_char(voice, c);
+}
+
+/* the typewriter at the dialogue's speed (OPT_TEXT_SPEED as ui_dialog.c: 0 half a char a frame, 1 one, 2 two,
+ * 3 whole); the player's own line appears whole. Returns 1 when all of it shows. */
+static int bub_type(HtBubble *b)
+{
+    int speed = opt_get(OPT_TEXT_SPEED), before = b->shown / 2, half;
+    half = speed == 0 ? (b->age & 1) : speed == 1 ? 2 : speed == 2 ? 4 : 2 * (int)b->len;
+    if (b->who < 0) half = 2 * (int)b->len;
+    b->shown = (uint16_t)DOOMO_MIN((int)b->shown + half, 2 * (int)b->len);
+    for (; before < b->shown / 2; before++) babble(b->who, b->text[before]);
+    return b->shown / 2 >= b->len;
+}
+
+static int bub_hold_len(const HtBubble *b)
+{
+    if (b->who < 0) return HTT_ME_HOLD;
+    if (b->cut) return HTT_HOLD_CUT;
+    return DOOMO_MIN(HTT_HOLD_BASE + HTT_HOLD_CHAR * (int)b->len, HTT_HOLD_MAX);
+}
+
+/* ---- driving the drama manager ---------------------------------------------------------------------- */
+static int busy(void) { return T.cur.phase != HTB_NONE || T.stepping; }
+
+/* Take the next line of the planned exchange (one talk_dm_step a call, so a slow platform may spread an
+ * exchange over frames) and show it. */
+static void next_line(void)
+{
+    const TalkLine *ln;
+    if (!talk_dm_step(&T.dm, NULL)) { T.stepping = 0; return; }
+    ln = &T.dm.line[T.dm.nlines - 1];
+    bub_start(&T.cur, ln->text, ln->who, (ln->flags & TLF_CUT) != 0, (ln->flags & TLF_SINCERE) != 0);
+    if (ln->who >= 0 && ln->who != (int)T.last_who && cam_move(HTC_SPEAKER)) {
+        T.last_who = (uint8_t)ln->who;
+        tw_spring_punch(&T.push, HTT_PUSH_Q8 * 16);
+    }
+}
+
+static void pump(void)
+{
+    if (T.prev.phase != HTB_NONE && ++T.prev.age >= HTT_PREV_HOLD) T.prev.phase = HTB_NONE;
+    if (T.cur.phase == HTB_NONE) {
+        if (T.stepping) next_line();
+        else if (!talk_dm_over(&T.dm) && talk_dm_tick(&T.dm, 1)) T.stepping = 1;       /* idle chatter, the prod */
+        return;
+    }
+    T.cur.age++;
+    if (T.cur.shake && T.cur.phase == HTB_HOLD) T.cur.shake--;
+    if (T.cur.phase == HTB_TYPE) {
+        if (bub_type(&T.cur)) {
+            T.cur.phase = HTB_HOLD;
+            T.cur.age = 0;
+            if (T.cur.cut) T.cur.shake = HTT_SHAKE;
+        }
+    } else if (T.cur.age >= bub_hold_len(&T.cur)) {
+        T.prev = T.cur;                                     /* it fades and shrinks; the next line takes its place */
+        T.prev.age = 0;
+        T.cur.phase = HTB_NONE;
+        if (T.prev.who < 0) memset(&T.prev, 0, sizeof(T.prev));
+    }
+}
+
+/* a resident who left the talk walks to the door and is gone, once the exchange is on screen */
+static void walk_outs(void)
+{
+    int k;
+    for (k = 0; k < T.n; k++) {
+        HtPerson *p = &T.p[k];
+        if ((T.dm.part[k].flags & TPF_LEFT) && !p->out && !p->gone && !busy()) {
+            p->out = 1;
+            p->out_t = 0;
+            p->fx = p->x;
+            p->fy = p->y;
+            p->tx = centre(R.door_x);
+            p->ty = centre(R.door_y);
+            p->sit = 0;
+        }
+    }
+}
+
+/* ---- input ------------------------------------------------------------------------------------------ */
+static void talk_input(void)
+{
+    if (btn_pressed(BTN_B)) { home_talk_leave(); return; }
+    if (T.cur.phase == HTB_TYPE) {
+        if (btn_pressed(BTN_A)) T.cur.shown = (uint16_t)(2 * T.cur.len);          /* A completes the line */
+    } else if (T.cur.phase == HTB_HOLD) {
+        if (btn_pressed(BTN_A)) T.cur.age = (uint16_t)bub_hold_len(&T.cur);       /* A goes on to the next */
+    } else if (!T.stepping && !talk_dm_over(&T.dm)) {
+        if (btn_pressed(BTN_LEFT)) T.starter = (uint8_t)((T.starter + NSTARTERS - 1) % NSTARTERS);
+        if (btn_pressed(BTN_RIGHT)) T.starter = (uint8_t)((T.starter + 1) % NSTARTERS);
+        if (btn_pressed(BTN_A)) {
+            TalkUtter u;
+            memset(&u, 0, sizeof(u));
+            u.act[0] = starters[T.starter].act;
+            u.target = -1;
+            u.tone = starters[T.starter].tone;
+            u.conf = 15;
+            doomo_snprintf(u.shown, sizeof(u.shown), "%s", starters[T.starter].say);
+            home_talk_say(&u);
+        }
+    }
+}
+
+/* ---- the public calls ---------------------------------------------------------------------------------- */
+/* the house hook of talk.h (weak in weak_talk.c): the house is the one that knows the room */
+int home_talk_enter(int who) { return home_draw_talk_start(who); }
+int home_talk_on(void) { return T.state != HTS_OFF; }
+/* gathering, leaving, a bubble on screen or lines still to come (the runner's talk-wait) */
+int home_talk_busy(void) { return T.state != HTS_OFF && (T.state != HTS_TALK || busy()); }
+const TalkState *home_talk_state(void) { return &T.dm; }
+const TalkSummary *home_talk_summary(void) { return T.have_sum ? &T.sum : NULL; }
+/* tests: bubble `which` (0 the current, 1 the faded previous): its phase (0 none, 1 typing, 2 held), and
+ * through the pointers the speaker's slot (-1 the player), the characters shown and the text */
+int home_talk_bubble(int which, char *text, int cap, int *who, int *shown)
+{
+    const HtBubble *b = which ? &T.prev : &T.cur;
+    if (text && cap > 0) doomo_snprintf(text, (size_t)cap, "%s", b->phase ? b->text : "");
+    if (who) *who = b->who;
+    if (shown) *shown = b->shown / 2;
+    return b->phase;
+}
+void home_talk_cam_stats(int *moves, int *min_gap)
+{
+    if (moves) *moves = T.cam_moves;
+    if (min_gap) *min_gap = T.cam_min_gap;
+}
+
+static uint32_t hash32(uint32_t h, uint32_t v)
+{
+    h ^= v;
+    h *= 16777619u;
+    return h;
+}
+
+int home_talk_begin(const HomeTalkRoom *room, int target)
+{
+    int order[HTK_WHO_MAX], ids[TALK_PARTS_MAX], n, i, maxd = 0;
+    uint32_t seed;
+    if (!room || T.state != HTS_OFF) return -1;
+    if (plat_screen_w() < 320 || plat_screen_h() < 240) return -1;      /* a GBA-sized screen: Talk is not offered */
+    n = pick_who(room, target, order);
+    if (n <= 0) return -1;
+    T.opened_db = 0;
+    if (!talk_db_is_open()) {
+        if (talk_db_open(lang_get()) != TALK_DB_OK && talk_db_open(lang_find("en")) != TALK_DB_OK) return -1;
+        T.opened_db = 1;
+    }
+    R = *room;
+    memset(T.p, 0, sizeof(T.p));
+    memset(&T.me, 0, sizeof(T.me));
+    memset(&T.cur, 0, sizeof(T.cur));
+    memset(&T.prev, 0, sizeof(T.prev));
+    T.n = (uint8_t)n;
+    for (i = 0; i < n; i++) {
+        const HomeTalkWho *w = &room->who[order[i]];
+        ids[i] = w->id;
+        T.p[i].id = w->id;
+        T.p[i].x = T.p[i].fx = w->x;
+        T.p[i].y = T.p[i].fy = w->y;
+    }
+    T.me.id = -1;
+    T.me.x = T.me.fx = room->px;
+    T.me.y = T.me.fy = room->py;
+    T.serial++;
+    seed = hash32(2166136261u, (uint32_t)room->avatar);
+    seed = hash32(seed, doomo_town.seed);
+    seed = hash32(seed, doomo_town.day);
+    seed = hash32(seed, T.serial);
+    for (i = 0; i < n; i++) seed = hash32(seed, (uint32_t)ids[i]);
+    talk_dm_begin(&T.dm, room->avatar, ids, n, seed);
+    talk_mem_begin(&T.dm.conv);                          /* what they remember, and who said no to romance today (K-5) */
+    for (i = 0; i < n; i++)
+        if ((T.dm.conv.refused >> i) & 1) T.dm.part[i].flags |= TPF_REFUSED;
+    T.view_k = room->view_k;
+    gather(room, n);
+    for (i = -1; i < n; i++) {
+        HtPerson *p = i < 0 ? &T.me : &T.p[i];
+        if (!p->tx) { p->tx = p->fx; p->ty = p->fy; p->tile_x = (uint8_t)FIX2INT(p->fx); p->tile_y = (uint8_t)FIX2INT(p->fy); }
+        maxd = DOOMO_MAX(maxd, iabs(FIX2INT(p->tx - p->fx)) + iabs(FIX2INT(p->ty - p->fy)));
+    }
+    T.dur = (uint16_t)DOOMO_CLAMP(HTT_GATHER_MIN + maxd, HTT_GATHER_MIN, HTT_GATHER_MAX);
+    T.state = HTS_GATHER;
+    T.t = 0;
+    T.stepping = 0;
+    T.starter = 0;
+    T.over_t = 0;
+    T.have_sum = 0;
+    T.cam_t = 0;
+    T.cam_ever = 0;
+    T.cam_moves = 0;
+    T.cam_min_gap = 0xFFFF;
+    T.cam_shot = HTC_GROUP;
+    T.last_who = 0xFF;
+    T.pan_x = T.pan_y = T.pan_tx = T.pan_ty = 0;
+    T.sincere_q = 0;
+    tw_spring_init(&T.push, TW_BOING, 0);
+    T.fx = T.me.x;
+    T.fy = T.me.y;
+    T.fr = 3 * FIX_ONE;
+    cam_frame();
+    return T.view_k;
+}
+
+static void finish(void)
+{
+    talk_dm_end(&T.dm, &T.sum);
+    T.have_sum = 1;
+    if (T.opened_db) talk_db_close();
+    T.opened_db = 0;
+    T.state = HTS_OFF;
+}
+
+void home_talk_abort(void)
+{
+    if (T.state != HTS_OFF) finish();
+}
+
+/* Everyone goes back to where the house had them; the player stays where the talk put them (the house
+ * reads it with home_talk_end_pos()). */
+void home_talk_leave(void)
+{
+    int k;
+    if (T.state != HTS_GATHER && T.state != HTS_TALK) return;
+    T.state = HTS_LEAVE;
+    T.t = 0;
+    T.dur = HTT_LEAVE;
+    T.stepping = 0;
+    T.cur.phase = HTB_NONE;
+    T.prev.phase = HTB_NONE;
+    for (k = 0; k < T.n; k++) {
+        HtPerson *p = &T.p[k];
+        p->tx = p->fx;
+        p->ty = p->fy;
+        p->fx = p->x;
+        p->fy = p->y;
+        p->out = 0;
+        p->gone = 0;
+        p->sit = 0;
+    }
+    T.me.fx = T.me.tx = T.me.x;
+    T.me.fy = T.me.ty = T.me.y;
+}
+
+int home_talk_say(const TalkUtter *u)
+{
+    if (!u || T.state != HTS_TALK || busy() || talk_dm_over(&T.dm)) return 0;
+    talk_dm_say(&T.dm, u);                                  /* the gate first, whatever the caller is */
+    T.stepping = 1;
+    T.prev.phase = HTB_NONE;
+    if (T.dm.in.shown[0]) bub_start(&T.cur, T.dm.in.shown, -1, 0, 0);    /* what the gate left of it; a refusal shows no echo */
+    return 1;
+}
+
+/* Parse a typed line with the room as the parser's context (the runner's talk-say; T8c's typed line). */
+int home_talk_parse(const char *text, TalkUtter *out)
+{
+    TalkParseCtx ctx;
+    static char names[TALK_PARTS_MAX][24];
+    int k;
+    if (T.state == HTS_OFF || !text || !out) return 0;
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.nparts = T.n;
+    ctx.ring = -1;
+    ctx.hops = 1;
+    ctx.kid_room = T.dm.conv.aud.any_minor;
+    for (k = 0; k < T.n; k++) {
+        doomo_snprintf(names[k], sizeof(names[k]), "%s", name_of(T.p[k].id));
+        ctx.name[k] = names[k];
+    }
+    ctx.nstack = (uint8_t)DOOMO_MIN(TALK_STACK_MAX, 8);
+    for (k = 0; k < ctx.nstack; k++) ctx.stack[k] = T.dm.topic_stack[k];
+    return talk_parse(text, &ctx, out, NULL);
+}
+
+static void walk(HtPerson *p, int t, int dur)
+{
+    fix16 f = tw_smooth(tw_t(t, dur));
+    p->x = p->fx + (fix16)(((int64_t)(p->tx - p->fx) * f) >> 16);
+    p->y = p->fy + (fix16)(((int64_t)(p->ty - p->fy) * f) >> 16);
+    if (f < FIX_ONE && (p->tx != p->fx || p->ty != p->fy)) {
+        int sx, sy;
+        screen_delta(T.view_k, p->tx - p->fx, p->ty - p->fy, &sx, &sy);
+        p->dir = (uint8_t)(iabs(sx) > iabs(sy) ? (sx < 0 ? 1 : 2) : (sy > 0 ? 0 : 3));
+        p->frame = (uint8_t)((t >> 2) & 3);
+    } else {
+        p->dir = 0;
+        p->frame = 0;
+    }
+}
+
+int home_talk_update(void)
+{
+    int k;
+    if (T.state == HTS_OFF) return 0;
+    T.t++;
+    if (T.state == HTS_GATHER) {
+        for (k = -1; k < T.n; k++) walk(k < 0 ? &T.me : &T.p[k], T.t, T.dur);
+        cam_frame();
+        if (btn_pressed(BTN_B)) { home_talk_leave(); return 1; }
+        if (T.t >= T.dur) { T.state = HTS_TALK; T.t = 0; }
+    } else if (T.state == HTS_TALK) {
+        for (k = 0; k < T.n; k++) {
+            HtPerson *p = &T.p[k];
+            if (p->out && !p->gone) {
+                walk(p, ++p->out_t, HTT_OUT);
+                if (p->out_t >= HTT_OUT) p->gone = 1;
+            }
+        }
+        pump();
+        walk_outs();
+        cam_tick();
+        talk_input();
+        if (T.state == HTS_TALK && talk_dm_over(&T.dm) && !busy() && ++T.over_t >= HTT_OVER_HOLD) home_talk_leave();
+    } else {
+        for (k = -1; k < T.n; k++) walk(k < 0 ? &T.me : &T.p[k], T.t, T.dur);
+        cam_frame();
+        if (T.t >= T.dur) { finish(); return 0; }
+    }
+    return 1;
+}
+
+void home_talk_end_pos(fix16 *x, fix16 *y, int *sitting)
+{
+    if (x) *x = T.me.x;
+    if (y) *y = T.me.y;
+    if (sitting) *sitting = T.me.sit;
+}
+
+/* ---- the figures ---------------------------------------------------------------------------------------- */
+int home_talk_actors(HomeTalkActor *out, int max)
+{
+    int k, n = 0, speaker = T.cur.phase != HTB_NONE ? T.cur.who : -2, breath = (T.t >> 4) & 1;
+    static const int8_t bob[8] = { 0, 9, 15, 9, 0, -9, -15, -9 };    /* the talking bob: +-6% at 4 Hz */
+    for (k = -1; k < T.n && n < max; k++) {
+        const HtPerson *p = k < 0 ? &T.me : &T.p[k];
+        HomeTalkActor *a = &out[n];
+        int moving = T.state != HTS_TALK || (p->out && !p->gone);
+        if (p->gone) continue;
+        memset(a, 0, sizeof(*a));
+        a->id = p->id;
+        a->x = p->x;
+        a->y = p->y;
+        a->sx = a->sy = 256;
+        a->flags = k < 0 ? RA_PLAYER : 0;
+        a->sit = p->sit;
+        a->frame = p->frame;
+        if (p->sit && !moving) { a->z = 4; a->sx = 270; a->sy = 236; }
+        else if (k == speaker && T.cur.phase == HTB_TYPE) {
+            a->sy = (int16_t)(256 + bob[(T.t >> 0) & 7]);
+            a->sx = (int16_t)(256 - bob[(T.t >> 0) & 7] / 2);
+        } else if (!moving && breath) a->sy = 262;
+        /* posture: a bored one faces away, the others the speaker (the head turn is a quarter view) */
+        if (moving) a->dir = p->dir;
+        else if (k >= 0 && (T.dm.part[k].flags & TPF_AWAY)) a->dir = 3;
+        else if (p->id == TALK_PET_ID) a->dir = 0;
+        else if (speaker >= 0 && speaker != k) {
+            const HtPerson *s = &T.p[speaker];
+            int sx, sy;
+            screen_delta(T.view_k, s->x - p->x, s->y - p->y, &sx, &sy);
+            a->dir = (uint8_t)(iabs(sx) < 12 ? 0 : (sx < 0 ? 1 : 2));
+        } else a->dir = 0;
+        n++;
+    }
+    return n;
+}
+
+/* ---- drawing: bubbles, the instruction line and the control card ------------------------------------------------ */
+/* greedy word wrap at `cols` characters, the same as talk_safe_bubble_lines (the lint's count): line i is
+ * text[start[i] .. start[i] + len[i]) */
+static int wrap(const char *s, int cols, int *start, int *len, int maxl)
+{
+    int n = 0, col = 0, p = 0, ls = 0;
+    while (s[p]) {
+        int wl = 0;
+        while (s[p] == ' ') p++;
+        if (!s[p]) break;
+        while (s[p + wl] && s[p + wl] != ' ') wl++;
+        if (wl > cols) wl = cols;
+        if (col && col + 1 + wl > cols) {
+            if (n < maxl) { start[n] = ls; len[n] = col; n++; }
+            col = 0;
+        }
+        if (!col) ls = p;
+        col = (p + wl) - ls;
+        p += wl;
+    }
+    if (col && n < maxl) { start[n] = ls; len[n] = col; n++; }
+    return n ? n : 0;
+}
+
+typedef struct HtBox { int x, y, w, h, tail_x, flip, side; } HtBox;
+typedef struct HtLay { HtBox box; int n, more, start[TALK_BUBBLE_LINES + 1], len[TALK_BUBBLE_LINES + 1]; } HtLay;
+
+/* where a bubble goes: above the speaker's head (plat_room_project, the platform's own projection), kept on
+ * the screen, below the figure when there is no room above; the player's line is bottom left */
+static void bub_layout(const DoomoRoomView *v, const HtBubble *b, HtLay *l, int faded)
+{
+    int sw = plat_screen_w(), sh = plat_screen_h(), i, cols = 0, sx;
+    int16_t px = 0, py = 0;
+    HtBox *bx = &l->box;
+    l->n = wrap(b->text, TALK_BUBBLE_COLS, l->start, l->len, TALK_BUBBLE_LINES + 1);
+    if (l->n > TALK_BUBBLE_LINES) l->n = TALK_BUBBLE_LINES;
+    if (faded) {                                         /* shrunk to its first line, trailing off */
+        l->more = l->n > 1;
+        l->n = DOOMO_MIN(l->n, 1);
+    } else l->more = 0;
+    for (i = 0; i < l->n; i++) if (l->len[i] > cols) cols = l->len[i];
+    if (l->more) cols += 3;
+    memset(bx, 0, sizeof(*bx));
+    bx->w = cols * FONT_ADVANCE + 8;
+    bx->h = l->n * FONT_LINE + 5;
+    if (b->who < 0) { bx->x = 4; bx->y = sh - 12 - 13 - 14 - bx->h - 2; return; }
+    plat_room_project(v, T.p[b->who].x, T.p[b->who].y, T.p[b->who].sit ? HTT_HEAD - 4 : HTT_HEAD, &px, &py);
+    sx = px;
+    bx->x = DOOMO_CLAMP(sx - bx->w / 2, 3, sw - bx->w - 3);
+    bx->y = py - bx->h - 9;                              /* the tail and a name tab between it and the head */
+    if (bx->y < 22) { bx->y = py + 8; bx->flip = 1; }
+    bx->tail_x = DOOMO_CLAMP(sx, bx->x + 6, bx->x + bx->w - 6);
+    bx->side = sx < 0 ? -1 : sx >= sw ? 1 : 0;
+}
+
+static void bub_draw(const HtBubble *b, const HtLay *l, int faded)
+{
+    const UiStyle *st = ui_style(WIN_CUTE);
+    const HtBox *bx = &l->box;
+    int i, shown = b->shown / 2, x = bx->x, y = bx->y;
+    uint8_t fill = faded ? st->fill_lo : st->fill_hi, txt = faded ? st->text_dim : st->text;
+    char tmp[TALK_BUBBLE_COLS + 6];
+    if (l->n <= 0) return;
+    if (b->who < 0) {                                   /* the player's line: a flat-cornered box */
+        plat_rect(x - 1, y - 1, bx->w + 2, bx->h + 2, st->outline);
+        plat_rect(x, y, bx->w, bx->h, st->fill);
+    } else {
+        int dx = b->shake ? ((b->shake & 1) ? 1 : -1) * 2 : 0;
+        x += dx;
+        ui_round_rect(x - 1, y - 1, bx->w + 2, bx->h + 2, 5, st->outline);
+        ui_round_rect(x, y, bx->w, bx->h, 4, fill);
+        for (i = 0; i < 5; i++) {                       /* the tail, pointing at the head */
+            int ty = bx->flip ? y - 1 - i : y + bx->h + i;
+            plat_rect(bx->tail_x - 4 + i + dx, ty, 9 - 2 * i, 1, i == 4 ? st->outline : fill);
+        }
+        if (!faded) {                                   /* who is speaking: a name tab on the bubble */
+            const char *nm = name_of(T.p[b->who].id);
+            int ty = bx->flip ? y + bx->h : y - 8;
+            ui_round_rect(x, ty, ui_text_width(nm) + 6, 9, 3, st->title_bg);
+            ui_text(x + 3, ty + 1, nm, st->title);
+        }
+        if (bx->side) ui_text(bx->side < 0 ? 1 : plat_screen_w() - 7, y + bx->h / 2 - 3,
+                              bx->side < 0 ? STR_ICON_ARROW_L : STR_ICON_ARROW_R, st->accent);   /* off screen: an arrow */
+    }
+    for (i = 0; i < l->n; i++) {
+        int upto = DOOMO_MIN(l->len[i], shown - l->start[i]);
+        if (upto <= 0) break;
+        memcpy(tmp, b->text + l->start[i], (size_t)upto);
+        tmp[upto] = 0;
+        if (faded && l->more && upto == l->len[i]) strcat(tmp, "...");
+        ui_text(x + 4, y + 3 + i * FONT_LINE, tmp, txt);
+    }
+}
+
+static const char *instruction(void)
+{
+    if (T.state == HTS_GATHER) return "Everyone gathers round. B leaves.";
+    if (T.state == HTS_LEAVE) return "Bye for now!";
+    if (talk_dm_over(&T.dm)) return "The chat is over. They head off.";
+    if (busy()) return "They are talking. A skips ahead.";
+    return "Choose what to say, then press A.";
+}
+
+void home_talk_prompts(void)
+{
+    UiPrompt p[3];
+    int n = 0;
+    if (T.state == HTS_LEAVE) { p[n].btn = 0; p[n].prio = 0; p[n].verb = "Bye!"; n++; }
+    else {
+        if (T.state == HTS_TALK && !busy() && !talk_dm_over(&T.dm)) {
+            p[n].btn = BTN_LEFT | BTN_RIGHT; p[n].prio = 1; p[n].verb = "Pick"; n++;
+            p[n].btn = BTN_A; p[n].prio = 0; p[n].verb = "Say it"; n++;
+        } else if (T.state == HTS_TALK) { p[n].btn = BTN_A; p[n].prio = 0; p[n].verb = "Next"; n++; }
+        p[n].btn = BTN_B; p[n].prio = 0; p[n].verb = "Leave"; n++;
+    }
+    ui_prompts_at(p, n, WIN_CUTE, plat_screen_h() - 12, ui_prompts_maxw());
+}
+
+/* the previous bubble, faded and shrunk to its first line, steps up out of the current one's way */
+static void prev_layout(const DoomoRoomView *v, const HtBubble *b, HtLay *l, const HtLay *cur)
+{
+    HtBox *a;
+    bub_layout(v, b, l, 1);
+    a = &l->box;
+    if (cur && a->x < cur->box.x + cur->box.w && cur->box.x < a->x + a->w && a->y < cur->box.y + cur->box.h &&
+        cur->box.y < a->y + a->h) {
+        a->y = cur->box.y - a->h - 12;
+        a->flip = 0;
+    }
+}
+
+void home_talk_draw(const DoomoRoomView *v)
+{
+    const UiStyle *st = ui_style(WIN_CUTE);
+    int sw = plat_screen_w(), sh = plat_screen_h(), w;
+    char buf[48];
+    HtLay lc, lp;
+    int have_cur = T.cur.phase != HTB_NONE, have_prev = T.prev.phase != HTB_NONE && T.prev.who >= 0;
+    if (T.state == HTS_OFF) return;
+    if (have_cur) bub_layout(v, &T.cur, &lc, 0);
+    if (have_prev) {
+        prev_layout(v, &T.prev, &lp, have_cur && T.cur.who >= 0 ? &lc : NULL);
+        bub_draw(&T.prev, &lp, 1);
+    }
+    if (have_cur) bub_draw(&T.cur, &lc, 0);
+    /* the pick row: what A says (until the quick replies) */
+    if (T.state == HTS_TALK && !busy() && !talk_dm_over(&T.dm)) {
+        doomo_snprintf(buf, sizeof(buf), STR_ICON_ARROW_L " %s " STR_ICON_ARROW_R, starters[T.starter].label);
+        w = ui_text_width(buf) + 12;
+        ui_round_rect(4, sh - 12 - 13 - 14, w, 13, 4, st->fill_hi);
+        ui_text(10, sh - 12 - 13 - 14 + 3, buf, st->text);
+    }
+    /* the one instruction line, above the control card */
+    w = ui_text_width(instruction()) + 10;
+    if (w > sw - 8) w = sw - 8;
+    ui_round_rect((sw - w) / 2, sh - 12 - 13, w, 12, 4, st->fill_lo);
+    ui_text_center(sw / 2, sh - 12 - 13 + 2, instruction(), st->text_dim);
+}
+
+#endif /* DOOMO_HAS_TALK */
