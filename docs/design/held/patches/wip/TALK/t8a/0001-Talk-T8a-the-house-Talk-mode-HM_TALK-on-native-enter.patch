+TEST(home_talk_a_resident_who_walks_out_goes_to_the_door_and_the_talk_ends_when_all_left)
+{
+    HomeTalkRoom rm;
+    int k, left = 0;
+    premade();
+    rm = synth_room();
+    add_who(&rm, ID_NANA, 2, 2);
+    CHECK(home_talk_begin(&rm, -1) >= 0);
+    run_idle(60);
+    for (k = 0; k < 14 && !talk_dm_over(home_talk_state()); k++) {           /* bore them to the door */
+        TalkUtter u;
+        memset(&u, 0, sizeof(u));
+        u.act[0] = k & 1 ? TA_DISMISS : TA_INSULT;
+        u.target = 0;
