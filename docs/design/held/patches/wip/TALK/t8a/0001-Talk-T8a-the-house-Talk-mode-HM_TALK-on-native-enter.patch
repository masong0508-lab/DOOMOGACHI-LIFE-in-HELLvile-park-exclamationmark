+/* ---- entering and gathering ----------------------------------------------------------------------------- */
+TEST(home_talk_enter_gathers_the_room)
+{
+    HomeTalkRoom rm;
+    fix16 x, y, seen[8][2];
+    int k, n = 0, gather = 0, i, j;
+    live_house(2, 1);
+    CHECK(!home_talk_on());
+    CHECK(home_draw_talk_room(&rm));
+    CHECK_EQ(rm.nwho, 3);
+    CHECK(!home_talk_enter(9999));                       /* nobody of that name here */
+    CHECK(!home_talk_on());
+    CHECK(home_talk_enter(-1));
+    CHECK(home_talk_on());
+    CHECK(!home_talk_enter(-1));                         /* once */
+    for (k = 0; k < 40 && home_talk_busy(); k++) { frames(1); gather++; }
+    CHECK_MSG(gather >= 12 && gather <= 21, "gathered in %d frames", gather);
+    CHECK_EQ(home_talk_state()->nparts, 3);
+    frames(1);
+    for (k = 0; home_draw_actor(k, &x, &y) && n < 8; k++) { seen[n][0] = x; seen[n][1] = y; n++; }
+    CHECK_EQ(n, 4);                                      /* the player and three people */
+    for (i = 0; i < n; i++) {
+        CHECK_MSG(!((rm.occ[tile_of(seen[i][1])] >> tile_of(seen[i][0])) & 1), "figure %d stands on a piece", i);
+        for (j = 0; j < i; j++)
+            CHECK_MSG(tile_of(seen[i][0]) != tile_of(seen[j][0]) || tile_of(seen[i][1]) != tile_of(seen[j][1]),
+                      "figures %d and %d share a tile", i, j);
+    }
+    home_talk_abort();
+    CHECK(!home_talk_on());
+}
