diff --git a/core/tests/scripts/home_talk_basic.txt b/core/tests/scripts/home_talk_basic.txt
new file mode 100644
index 00000000..f6611b93
--- /dev/null
+++ b/core/tests/scripts/home_talk_basic.txt
@@ -0,0 +1,79 @@
+# assert-no-stubs
+# resolutions: 320x240
+# T8a: the house's Talk mode (docs/TALK.md "The house Talk mode"). Own house, Live mode, two housemates
+# (Mara and Vex, adults): START > Talk gathers everyone round the middle of the room (12-20 frames), the camera
+# frames the group, the pad's starter (A) and a typed line (talk-say) go through the audience gate and the drama
+# manager, the answers come as speech bubbles at the speakers' heads, B leaves. Shots are reviewed for
+# readability: one instruction line, the control card at the foot, the player's line bottom left.
+home-room 1
+family-add housemate adult Mara
+family-add housemate adult Vex
+clock 14 0
+scene HOME -1
+wait 20
+press START
+wait 14
+press DOWN
+wait 2
+press A
+wait 20
+expect-talk off
+shot talk_0_live
+# START > Talk (the row before Leave)
+press START
+wait 14
+shot talk_1_menu
+press DOWN
+press DOWN
+press DOWN
+press DOWN
+press DOWN
+wait 4
+shot talk_1_menu_talk
+press A
+wait 5
+expect-talk on
+shot talk_2_gathering
+talk-wait
+shot talk_3_ready
+# the pad's starter: A says "Hi, everyone!"
+press A
+wait 6
+shot talk_4_player_line
+talk-wait 40
+shot talk_5_reply_typing
+talk-wait
+shot talk_6_after
+# a typed line to one of them (the runner's talk-say: parsed, gated, said)
+talk-say "Mara you look great"
+wait 40
+shot talk_7_typed_reply
+talk-wait
+# pick another starter with the pad and say it
+press RIGHT
+press RIGHT
+wait 2
+shot talk_8_pick_row
+press A
+talk-wait
+shot talk_9_compliment
+# B leaves: everyone walks back, the house is Live again
+press B
+wait 4
+shot talk_a_leaving
+wait 20
+expect-talk off
+shot talk_b_live_again
+# and again the other way in: the player stands where the talk left them, the housemates are back on their
+# floor tiles ((2,4) and (3,5)); walk up to one and press A
+hold LEFT 15
+wait 4
+shot talk_c_next_to_housemate
+press A
+wait 3
+expect-talk on
+talk-wait
+shot talk_d_ready_again
+talk-leave
+expect-talk off
+shot talk_e_end
diff --git a/core/tests/test_home_talk.c b/core/tests/test_home_talk.c
new file mode 100644
index 00000000..0fb8d5e4
--- /dev/null
+++ b/core/tests/test_home_talk.c
@@ -0,0 +1,585 @@
+/* test_home_talk.c - T8a: the house's Talk mode (core/src/home_talk.c, hooks in home_draw.c, room_ref.c zoom 2).
+ * Owner: TK. docs/TALK.md "The house Talk mode"; design 4.1-4.3.
+ *
+ * Entering and gathering (who joins, distinct free tiles, 12-20 frames), the seats (the largest cluster, the
+ * pet stands, the quarter turn that shows the seats' fronts), the audience (everyone present joins; when the
+ * room is too full an adult is dropped before a child or the pet; a child makes the room kid-safe and nothing
+ * in the talk relaxes it, and a romance act toward the room goes through the gate), bubbles (the player's line,
+ * then the residents', typed in order, at most two on screen), the camera (talk framing, at most one move in
+ * 45 frames), leaving, a GBA-sized screen, the housemates' spots agreeing with Live mode, and room_ref's zoom 2.
+ */
+#include "test.h"
+#include <stdlib.h>
+#ifndef DOOMO_HAS_TALK
