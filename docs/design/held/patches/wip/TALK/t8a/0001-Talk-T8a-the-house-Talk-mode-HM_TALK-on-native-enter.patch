+/* 1 if Talk could start in the house as it is now; fills rm with the room and everyone in it */
+int home_draw_talk_room(HomeTalkRoom *rm)
+{
+    const HomeRoom *r;
+    int i, x, y, ids[HOME_HOUSEMATES], n;
+    fix16 xs[HOME_HOUSEMATES], ys[HOME_HOUSEMATES];
+    memset(rm, 0, sizeof(*rm));
+    if (!H || H->mode != HM_LIVE || (H->kind != HK_OWN && H->kind != HK_VISIT)) return 0;
+    if (plat_screen_w() < 320 || plat_screen_h() < 240) return 0;          /* a GBA-sized screen: no Talk */
+    r = &H->ed.room;
+    rm->w = (uint8_t)room_w();
+    rm->d = (uint8_t)room_d();
+    rm->view_k = (uint8_t)(H->view_k & 3);
+    rm->door_x = home_room_defs[H->room].door_wall == HW_B ? 0 : home_room_defs[H->room].door_at;
+    rm->door_y = home_room_defs[H->room].door_wall == HW_B ? home_room_defs[H->room].door_at : 0;
+    home_floor_occupancy(r, rm->occ);
+    for (i = 0; i < r->nobj; i++) {
+        const DoomoFurn *f = home_furn(HO_FURN(&r->obj[i]));
+        int fw, fd;
+        if (!f || (f->flags & FF_WALL) || HO_ONSURF(&r->obj[i])) continue;
+        home_footprint(f, HO_ROT(&r->obj[i]), &fw, &fd);
+        if (f->interact == FI_SIT) {
+            for (y = HO_Y(&r->obj[i]); y < HO_Y(&r->obj[i]) + fd; y++)
+                for (x = HO_X(&r->obj[i]); x < HO_X(&r->obj[i]) + fw; x++)
+                    if (rm->nseat < HTK_SEATS) {
+                        rm->seat[rm->nseat].x = (uint8_t)x;
+                        rm->seat[rm->nseat].y = (uint8_t)y;
+                        rm->seat[rm->nseat].rot = (uint8_t)HO_ROT(&r->obj[i]);
+                        rm->nseat++;
+                    }
+        } else if (f->role == FR_TABLE && rm->ntable < 2) {
+            rm->table[rm->ntable].x = (uint8_t)HO_X(&r->obj[i]);
+            rm->table[rm->ntable].y = (uint8_t)HO_Y(&r->obj[i]);
+            rm->table[rm->ntable].w = (uint8_t)fw;
+            rm->table[rm->ntable].d = (uint8_t)fd;
+            rm->ntable++;
+        }
+    }
+    rm->px = H->px;
+    rm->py = H->py;
+    rm->avatar = (int16_t)playas_avatar();
+    if (H->kind == HK_VISIT) {
+        if (!H->host_out && rm->nwho < HTK_WHO_MAX) {
+            rm->who[rm->nwho].id = (int16_t)H->visit.id;
+            rm->who[rm->nwho].x = H->hx;
+            rm->who[rm->nwho].y = H->hy;
+            rm->nwho++;
+        }
+    } else {
+        n = talk_housemate_spots(ids, xs, ys);
+        for (i = 0; i < n && rm->nwho < HTK_WHO_MAX; i++) {
+            rm->who[rm->nwho].id = (int16_t)ids[i];
+            rm->who[rm->nwho].x = xs[i];
+            rm->who[rm->nwho].y = ys[i];
+            rm->nwho++;
+        }
+        if (H->pet_on && r->nobj && rm->nwho < HTK_WHO_MAX) {              /* where the pet is now (build_actors' hop) */
+            int to = H->pet_to < r->nobj ? H->pet_to : 0, from = H->pet_from < r->nobj ? H->pet_from : to;
+            fix16 x0 = INT2FIX(HO_X(&r->obj[from])) + FIX_ONE / 2, y0 = INT2FIX(HO_Y(&r->obj[from])) + FIX_ONE;
+            fix16 x1 = INT2FIX(HO_X(&r->obj[to])) + FIX_ONE / 2, y1 = INT2FIX(HO_Y(&r->obj[to])) + FIX_ONE;
+            if (H->pet_age != 0xFF) {
+                fix16 t = tw_t(H->pet_age, ht[HT_HOP] * 3);
+                x0 = x0 + (fix16)(((int64_t)(x1 - x0) * t) >> 16);
+                y0 = y0 + (fix16)(((int64_t)(y1 - y0) * t) >> 16);
+            } else {
+                x0 = x1; y0 = y1;
+            }
+            if (y0 > INT2FIX(room_d()) - FIX_ONE / 4) y0 = INT2FIX(room_d()) - FIX_ONE / 4;
+            rm->who[rm->nwho].id = TALK_PET_ID;
+            rm->who[rm->nwho].x = x0;
+            rm->who[rm->nwho].y = y0;
+            rm->nwho++;
+        }
+    }
+    return rm->nwho > 0;
+}
+
+int home_draw_actor(int i, fix16 *x, fix16 *y)
+{
+    if (!H || i < 0 || i >= H->nact) return 0;
+    *x = H->act[i].x;
+    *y = H->act[i].y;
+    return 1;
+}
