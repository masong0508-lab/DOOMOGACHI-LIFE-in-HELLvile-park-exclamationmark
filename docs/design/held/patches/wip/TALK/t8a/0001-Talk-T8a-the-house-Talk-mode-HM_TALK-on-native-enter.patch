+/* a frame of Talk; when it is over the player is where the talk left them and the house is Live again */
+static void update_talk(void)
+{
+    fix16 x, y;
+    int sit;
+    if (home_talk_update()) return;
+    home_talk_end_pos(&x, &y, &sit);
+    H->px = x;
+    H->py = y;
+    H->sitting = 0;
+    if (sit) {
+        int idx = home_obj_at(&H->ed.room, FIX2INT(x), FIX2INT(y));
+        if (idx >= 0) { H->sitting = 1; H->sit_obj = (uint8_t)idx; }
+    }
+    H->pdir = 0;
+    H->view_k = H->talk_view;
+    H->mode = HM_LIVE;
+}
