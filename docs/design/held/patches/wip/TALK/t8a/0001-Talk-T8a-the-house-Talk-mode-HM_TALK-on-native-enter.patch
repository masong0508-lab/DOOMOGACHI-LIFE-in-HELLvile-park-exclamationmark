+    left = (home_talk_state()->part[0].flags & TPF_LEFT) != 0;
+    if (left) {
+        for (k = 0; k < 200 && home_talk_on(); k++) frames(1);
+        CHECK(!home_talk_on());                           /* everyone left: the talk is over and the house goes back */
+        CHECK(home_talk_summary() != NULL);
+    } else {
+        home_talk_abort();
+    }
+}
