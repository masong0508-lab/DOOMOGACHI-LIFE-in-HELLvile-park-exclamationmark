+static void big(void) { nat_w = 320; nat_h = 240; home_talk_abort(); }    /* a test that failed halfway left Talk on */
+static void small_(void) { nat_w = 240; nat_h = 160; }
+
+/* frames of the game; with no house on screen (the tests that give Talk a room of their own) the frames
+ * go straight to home_talk_update(), which is all the house calls each frame */
+static void frames(int n)
+{
+    while (n-- > 0) {
+        if (scene_top() == &SCENE_HOME) { plat_begin_frame(); doomo_frame(0); plat_end_frame(); }
+        else home_talk_update();
+    }
+}
+
+static void press(int btn)
+{
+    plat_begin_frame();
+    doomo_frame((uint32_t)btn);
+    plat_end_frame();
+    frames(1);
+}
+
+/* the house in Live mode: START, down to "Live mode", A (as test_home_render does) */
+static void live_house(int adults, int kids)
+{
+    int i;
+    big();
+    test_reset();
+    home_reset();
+    for (i = 0; i < adults; i++) family_pool_add(FAMROLE_HOUSEMATE, LIFE_ADULT, 100u + (uint32_t)i, NULL, -1);
+    for (i = 0; i < kids; i++) family_pool_add(FAMROLE_SIBLING, LIFE_CHILD, 200u + (uint32_t)i, NULL, -1);
+    scene_set(&SCENE_HOME, HOME_ARG_OWN(HOME_COTTAGE));
+    frames(20);
+    press(BTN_START);
+    press(BTN_DOWN);
+    press(BTN_A);
+    frames(10);
+}
+
+static void premade(void)
+{
+    big();
+    test_reset();
+    town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE);
+}
+
+static HomeTalkRoom synth_room(void)
+{
+    HomeTalkRoom rm;
+    memset(&rm, 0, sizeof(rm));
+    rm.w = 8; rm.d = 8; rm.view_k = 0;
+    rm.door_x = 3; rm.door_y = 0;
+    rm.px = INT2FIX(1) + FIX_ONE / 2;
+    rm.py = INT2FIX(6) + FIX_ONE / 2;
+    rm.avatar = DOOMO_PLAYER_ID;
+    return rm;
+}
+
+static void add_who(HomeTalkRoom *rm, int id, int tx, int ty)
+{
+    rm->who[rm->nwho].id = (int16_t)id;
+    rm->who[rm->nwho].x = INT2FIX(tx) + FIX_ONE / 2;
+    rm->who[rm->nwho].y = INT2FIX(ty) + FIX_ONE / 2;
+    rm->nwho++;
+}
+
+static void add_seat(HomeTalkRoom *rm, int x, int y, int rot)
+{
+    rm->seat[rm->nseat].x = (uint8_t)x;
+    rm->seat[rm->nseat].y = (uint8_t)y;
+    rm->seat[rm->nseat].rot = (uint8_t)rot;
+    rm->nseat++;
+}
+
+/* run until nothing is gathering or on screen; returns the frames it took */
+static int run_idle(int max)
+{
+    int k;
+    for (k = 0; k < max && home_talk_on() && home_talk_busy(); k++) frames(1);
+    return k;
+}
+
+static int say_text(const char *text)
+{
+    TalkUtter u;
+    memset(&u, 0, sizeof(u));
+    if (!home_talk_parse(text, &u)) return 0;
+    return home_talk_say(&u);
+}
+
+static int tile_of(fix16 v) { return FIX2INT(v); }
+
+/* A pressed for one frame and let go, with no house on screen: the frames go to home_talk_update() (the A edge
+ * is the input layer's, doomo_frame() makes it). Skips a typing line, then a held one: lines turn over fast */
+static void skip_a(void)
+{
+    plat_begin_frame(); doomo_frame(BTN_A); plat_end_frame();
+    home_talk_update();
+    plat_begin_frame(); doomo_frame(0); plat_end_frame();
+    home_talk_update();
+}
