+/* ---- bubbles --------------------------------------------------------------------------------------------------- */
+TEST(home_talk_shows_the_exchange_in_bubbles_in_order)
+{
+    HomeTalkRoom rm;
+    char txt[TALK_LINE_MAX];
+    int who, shown, k, phase, last_who = -9, last_phase = 0, last_shown = 0, first_who = -9, res_bubbles = 0, max_visible = 0;
+    premade();
+    rm = synth_room();
+    add_who(&rm, ID_NANA, 2, 2);
+    add_who(&rm, ID_RIVET, 3, 2);
+    CHECK(home_talk_begin(&rm, -1) >= 0);
+    run_idle(60);
+    CHECK(say_text("hello everyone"));
+    for (k = 0; k < 900 && home_talk_busy(); k++) {
+        int visible;
+        frames(1);
+        phase = home_talk_bubble(0, txt, sizeof(txt), &who, &shown);
+        visible = (phase != 0) + (home_talk_bubble(1, NULL, 0, NULL, NULL) != 0);
+        if (visible > max_visible) max_visible = visible;
+        if (!phase) { last_phase = 0; continue; }
+        CHECK_MSG(strchr(txt, '{') == NULL && strchr(txt, '}') == NULL, "line codes in the bubble: %s", txt);
+        CHECK(shown >= 0 && shown <= (int)strlen(txt));
+        CHECK_MSG(who >= -1 && who < 2, "speaker slot %d", who);
+        if (!last_phase || who != last_who) {                       /* a new bubble */
+            if (first_who == -9) first_who = who;
+            if (who >= 0) res_bubbles++;
+        } else {
+            CHECK_MSG(shown >= last_shown, "the typewriter went back");   /* within a bubble the text only grows */
+        }
+        last_phase = phase;
+        last_who = who;
+        last_shown = shown;
+    }
+    CHECK_EQ(first_who, -1);                             /* the player's own line comes first */
+    CHECK(res_bubbles >= 1);
+    CHECK(max_visible <= 2);                             /* the current one and the faded previous one */
+    CHECK(home_talk_state()->nlines >= 1);
+    home_talk_abort();
+}
