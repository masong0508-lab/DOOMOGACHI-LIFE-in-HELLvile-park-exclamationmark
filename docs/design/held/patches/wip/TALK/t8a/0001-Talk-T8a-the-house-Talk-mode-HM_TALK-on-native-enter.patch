+TEST(home_talk_seats_the_largest_cluster)
+{
+    HomeTalkRoom rm = synth_room();
+    HomeTalkActor a[6];
+    int n, i, j, seated = 0;
+    premade();
+    rm = synth_room();
+    add_seat(&rm, 0, 0, 0);                              /* a lone chair in a corner */
+    add_seat(&rm, 5, 4, 0);                              /* a sofa and an armchair: the big cluster */
+    add_seat(&rm, 6, 4, 0);
+    add_seat(&rm, 6, 5, 0);
+    add_who(&rm, ID_NANA, 2, 2);
+    add_who(&rm, ID_RIVET, 3, 2);
+    add_who(&rm, TALK_PET_ID, 2, 3);
+    CHECK(home_talk_begin(&rm, ID_NANA) >= 0);
+    frames(25);
+    n = home_talk_actors(a, 6);
+    CHECK_EQ(n, 4);
+    CHECK_EQ(actor_sits(ID_NANA), 1);
+    CHECK_EQ(actor_sits(ID_RIVET), 1);
+    CHECK_EQ(actor_sits(TALK_PET_ID), 0);                /* the pet never sits */
+    for (i = 0; i < n; i++) seated += a[i].sit;
+    CHECK_EQ(seated, 3);                                 /* Nana, Rivet and the player take the cluster's three seats */
+    for (i = 0; i < n; i++) {
+        if (a[i].sit) {
+            int tx = tile_of(a[i].x), ty = tile_of(a[i].y);
+            CHECK_MSG(tx >= 5 && ty >= 4, "a seated figure left the big cluster (%d,%d)", tx, ty);
+        }
+        for (j = 0; j < i; j++) CHECK(tile_of(a[i].x) != tile_of(a[j].x) || tile_of(a[i].y) != tile_of(a[j].y));
+    }
+    home_talk_abort();
+}
