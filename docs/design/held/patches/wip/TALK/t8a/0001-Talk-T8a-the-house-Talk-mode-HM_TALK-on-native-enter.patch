+#ifdef DOOMO_HAS_TALK
+/* ---- (T8) Talk: the house's side of home_talk.c ---------------------------------------------------------
+ * home_talk.c owns the conversation; this is the glue that needs the scene's statics: the room as Talk sees
+ * it, the figures it asks to draw, and the way back to Live. The F3 housemate spots repeat build_actors'
+ * placement (that loop is left as it was so the GBA and PS1 code stay byte for byte): keep the two in step
+ * (test_home_talk.c compares them). */
+static int talk_housemate_spots(int *ids, fix16 *xs, fix16 *ys)
+{
+    uint16_t occ[16];
+    int i, n = family_count(), put = 0, w = room_w(), dd = room_d();
+    home_floor_occupancy(&H->ed.room, occ);
+    for (i = 0; i < n && put < HOME_HOUSEMATES; i++) {
+        int id = family_member(i), t, tiles = w * dd, start;
+        if (id < 0 || id == playas_avatar()) continue;
+        start = (id * 7 + 3) % (tiles > 0 ? tiles : 1);
+        for (t = 0; t < tiles; t++) {
+            int c = (start + t) % tiles, cx = c % w, cy = c / w;
+            if ((occ[cy] >> cx) & 1) continue;
+            occ[cy] |= (uint16_t)(1u << cx);
+            ids[put] = id;
+            xs[put] = INT2FIX(cx) + FIX_ONE / 2;
+            ys[put] = INT2FIX(cy) + FIX_ONE / 2;
+            put++;
+            break;
+        }
+    }
+    return put;
+}
