+/* ---- the native framing: a pan toward the group ------------------------------------------------------------------ */
+TEST(home_talk_view_slides_the_room_toward_the_group_on_the_reference_renderer)
+{
+    HomeTalkRoom rm = synth_room();
+    DoomoRoomView v, flat;
+    int16_t gx, gy, cx, cy, fx, fy;
+    premade();
+    rm = synth_room();
+    add_who(&rm, ID_NANA, 6, 6);                         /* a group in the far corner */
+    rm.px = INT2FIX(5) + FIX_ONE / 2;
+    rm.py = INT2FIX(6) + FIX_ONE / 2;
+    CHECK(home_talk_begin(&rm, -1) >= 0);
+    frames(25);
+    memset(&v, 0, sizeof(v));
+    v.w = 8; v.d = 8; v.vw = 320; v.vh = 216; v.vy = 12;
+    home_talk_view(&v);
+    flat = v;
+    flat.zoom = 0; flat.pan_x = flat.pan_y = 0;           /* the same room with no framing */
+    room_ref_project(&flat, v.focus_x, v.focus_y, 0, &gx, &gy);
+    room_ref_project(&v, v.focus_x, v.focus_y, 0, &fx, &fy);
+    cx = 160; cy = 12 + 216 / 2;
+    CHECK_MSG(abs(fx - cx) + abs(fy - cy) < abs(gx - cx) + abs(gy - cy), "framed (%d,%d) is no nearer the middle than (%d,%d)", fx, fy, gx, gy);
+    CHECK(abs(v.pan_x) <= HTT_FRAME_X_TEST + 12 && abs(v.pan_y) <= HTT_FRAME_Y_TEST + 6);
+    home_talk_abort();
+}
