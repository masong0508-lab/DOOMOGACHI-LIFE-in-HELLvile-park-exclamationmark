+/* ---- a bubble never sits on another face ---------------------------------------------------------------------------- */
+TEST(home_talk_a_bubble_keeps_off_the_other_faces)
+{
+    HomeTalkRoom rm;
+    DoomoRoomView v;
+    int k, bx, by, bw, bh, seen = 0, clear = 0, who, shown;
+    premade();
+    rm = synth_room();
+    add_who(&rm, ID_NANA, 3, 2);                         /* Nana stands behind Rivet on the screen: the same column */
+    add_who(&rm, ID_RIVET, 4, 3);
+    rm.px = INT2FIX(6) + FIX_ONE / 2;
+    rm.py = INT2FIX(6) + FIX_ONE / 2;
+    CHECK(home_talk_begin(&rm, -1) >= 0);
+    run_idle(60);
+    CHECK(say_text("hello everyone"));
+    memset(&v, 0, sizeof(v));
+    v.w = 8; v.d = 8; v.vw = 320; v.vh = 216; v.vy = 12;
+    for (k = 0; k < 900 && home_talk_busy(); k++) {
+        HomeTalkActor a[6];
+        int n, i, hit = 0;
+        frames(1);
+        if (home_talk_bubble(0, NULL, 0, &who, &shown) != 1 || who < 0) continue;    /* a resident's line, typing */
+        home_talk_view(&v);
+        if (!home_talk_bubble_rect(&v, &bx, &by, &bw, &bh)) continue;
+        seen++;
+        n = home_talk_actors(a, 6);
+        for (i = 0; i < n; i++) {
+            int16_t fx, fy;
+            if (a[i].id < 0 || i == 0) continue;
+            if (home_talk_state()->part[who].id == a[i].id) continue;
+            room_ref_project(&v, a[i].x, a[i].y, 0, &fx, &fy);
+            if (fx + 9 > bx && fx - 9 < bx + bw && fy - 12 > by && fy - 34 < by + bh) hit = 1;      /* their head and shoulders */
+        }
+        clear += !hit;
+        CHECK_MSG(bx >= 0 && bx + bw <= 320 && by >= 12, "the bubble left the screen: %d,%d %dx%d", bx, by, bw, bh);
+    }
+    CHECK(seen >= 5);
+    CHECK_EQ(clear, seen);
+    home_talk_abort();
+}
+
 /* ---- the native framing: a pan toward the group ------------------------------------------------------------------ */
