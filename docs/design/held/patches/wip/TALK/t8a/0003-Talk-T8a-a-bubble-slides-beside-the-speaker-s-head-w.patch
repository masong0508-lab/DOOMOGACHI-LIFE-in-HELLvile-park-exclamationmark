+            if (bx->sidetail) {                         /* the bubble is beside the head: a tail out of its side */
+                int tx = bx->sidetail < 0 ? x - 1 - i : x + bx->w + i;
+                plat_rect(tx, bx->tail_y - 4 + i, 1, 9 - 2 * i, i == 4 ? st->outline : fill);
+            } else {
+                int ty = bx->flip ? y - 1 - i : y + bx->h + i;
+                plat_rect(bx->tail_x - 4 + i + dx, ty, 9 - 2 * i, 1, i == 4 ? st->outline : fill);
+            }
         }
         if (!faded) {                                   /* who is speaking: a name tab on the bubble */
             const char *nm = name_of(T.p[b->who].id);
@@ -899,6 +937,19 @@ static void bub_draw(const HtBubble *b, const HtLay *l, int faded)
     }
 }
 
+/* tests: where the current bubble is drawn in view v (the box, not its tail); 0 when no bubble is up */
+int home_talk_bubble_rect(const DoomoRoomView *v, int *x, int *y, int *w, int *h)
+{
+    HtLay l;
+    if (T.state == HTS_OFF || T.cur.phase == HTB_NONE) return 0;
+    bub_layout(v, &T.cur, &l, 0);
+    if (x) *x = l.box.x;
+    if (y) *y = l.box.y;
+    if (w) *w = l.box.w;
+    if (h) *h = l.box.h;
+    return 1;
+}
