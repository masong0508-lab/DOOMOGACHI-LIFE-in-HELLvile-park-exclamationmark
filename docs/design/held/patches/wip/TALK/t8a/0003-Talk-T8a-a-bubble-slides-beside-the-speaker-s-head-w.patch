-typedef struct HtBox { int x, y, w, h, tail_x, flip, side; } HtBox;
+typedef struct HtBox { int x, y, w, h, tail_x, tail_y, sidetail, flip, side; } HtBox;
 typedef struct HtLay { HtBox box; int n, more, start[TALK_BUBBLE_LINES + 1], len[TALK_BUBBLE_LINES + 1]; } HtLay;
 
+/* A bubble above the speaker's head can sit on top of someone standing behind them on the screen. When it
+ * would, it slides to the left or the right of the head (the nearer free side), keeping its tail at the head,
+ * so every face stays visible. */
+static int hits_a_head(const DoomoRoomView *v, const HtBubble *b, const HtBox *bx)
+{
+    int k;
+    for (k = -1; k < T.n; k++) {
+        const HtPerson *p = k < 0 ? &T.me : &T.p[k];
+        int16_t fx, fy;
+        if (k == b->who || p->gone || p->out) continue;
+        plat_room_project(v, p->x, p->y, 0, &fx, &fy);
+        if (fx + 9 > bx->x && fx - 9 < bx->x + bx->w && fy - 12 > bx->y - 9 && fy - 34 < bx->y + bx->h + 5) return 1;   /* their head and shoulders */
+    }
+    return 0;
+}
+
+static void bub_clear_of_heads(const DoomoRoomView *v, const HtBubble *b, HtBox *bx, int head_x, int head_y, int sw)
+{
+    int k, y_side = DOOMO_MAX(16, head_y + 6 - bx->h);       /* its foot level with the head */
+    if (!hits_a_head(v, b, bx)) return;
+    for (k = 0; k < 2; k++) {                            /* beside the head: the roomier side first */
+        int right = (k == 0) == (head_x < sw / 2), x = right ? head_x + 20 : head_x - 20 - bx->w;
+        HtBox t = *bx;
+        t.x = DOOMO_CLAMP(x, 3, sw - bx->w - 3);
+        t.y = y_side;
+        t.flip = 0;
+        t.sidetail = right ? -1 : 1;                     /* the tail points back at the head */
+        t.tail_y = DOOMO_CLAMP(head_y + 2, t.y + 4, t.y + t.h - 4);
+        if (!hits_a_head(v, b, &t) && iabs(t.x - head_x) < sw) { *bx = t; return; }
+    }
+}
+
 /* where a bubble goes: above the speaker's head (plat_room_project, the platform's own projection), kept on
  * the screen, below the figure when there is no room above; the player's line is bottom left */
 static void bub_layout(const DoomoRoomView *v, const HtBubble *b, HtLay *l, int faded)
@@ -858,6 +890,7 @@ static void bub_layout(const DoomoRoomView *v, const HtBubble *b, HtLay *l, int
     if (bx->y < 22) { bx->y = py + 8; bx->flip = 1; }
     bx->tail_x = DOOMO_CLAMP(sx, bx->x + 6, bx->x + bx->w - 6);
     bx->side = sx < 0 ? -1 : sx >= sw ? 1 : 0;
+    bub_clear_of_heads(v, b, bx, sx, py, sw);
 }
 
 static void bub_draw(const HtBubble *b, const HtLay *l, int faded)
@@ -877,8 +910,13 @@ static void bub_draw(const HtBubble *b, const HtLay *l, int faded)
         ui_round_rect(x - 1, y - 1, bx->w + 2, bx->h + 2, 5, st->outline);
         ui_round_rect(x, y, bx->w, bx->h, 4, fill);
