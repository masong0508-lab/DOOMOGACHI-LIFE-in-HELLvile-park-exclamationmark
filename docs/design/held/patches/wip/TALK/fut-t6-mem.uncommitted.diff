diff --git a/core/include/doomo/talk.h b/core/include/doomo/talk.h
index f2d185f..4d933b8 100644
--- a/core/include/doomo/talk.h
+++ b/core/include/doomo/talk.h
@@ -544,6 +544,8 @@ enum { TCB_NONE = 0, TCB_JOB, TCB_PARTNER, TCB_PET, TCB_NEWS, TCB_PROBLEM, TCB_B
 #define TMF_COMPLIMENTED 0x01u
 #define TMF_INSULTED     0x02u
 #define TMF_PROMISED     0x04u
+#define TMF_REFUSED_TODAY 0x08u   /* T6 (K-5): said no to a romance act this town day; the table only
+                                   * (talk_mem_begin turns it into TalkConv.refused), never in mem_flags */
 /* grammar entry points besides core.<act> and react.<act> */
 enum { TGE_OPEN = 0, TGE_CB, TGE_TAG, TGE_HANDOFF, TGE_SAFE, TGE_END_K7, TGE_PET, TGE_IDLE,
        TGE_GRIEF,    /* K-10: the sincere core of a line about grief or loss */
@@ -614,6 +616,61 @@ typedef struct TalkConv {
     uint8_t  mem_flags[TALK_PARTS_MAX];          /* talk memory (T6): TMF_*           */
 } TalkConv;
 
+/* ---- T6: talk memory (core/src/talk_save.c; docs/TALK.md 6e) ------------------
+ * What a resident remembers of the player's talks: the 'TALK' chunk's table
+ * (TALK_MEM_MAX entries, the most recently used first; a 25th person evicts
+ * the last). Ids are a resident, the hero or a family pool id; the pet and
+ * anyone who is gone have no entry. Every call first clears
+ * TMF_REFUSED_TODAY when the town day has changed. The chunk itself is
+ * registered only where the build defines DOOMO_HAS_TALK (the link-time
+ * twin of PLATF_TALK: the native host today); without it this is a plain
+ * table nobody saves, and --gc-sections drops it where nobody calls it. */
+#define TALK_MEM_VERSION 1
+typedef struct TalkMem {
+    uint16_t id;                  /* a resident, the hero or a pool id            */
+    uint16_t day;                 /* the town day (low 16 bits) of the last talk  */
+    uint16_t topic_a, topic_b;    /* the last topic and the one before (12 bits)  */
+    uint8_t  flags;               /* TMF_* (the high nibble is the running conversation's, never saved) */
+    uint8_t  likes_known;         /* bit `which` of talk_gen_like(): 0 food, 1 hobby, 2 music, 3 fear, 4 hated food */
+    uint16_t spare;               /* 0                                            */
+} TalkMem;                        /* TALK_MEM_ENTRY = 12 B                        */
+/* Entries held, and entry i (0 the most recent), NULL past the end. */
+int  talk_mem_count(void);
+const TalkMem *talk_mem_at(int i);
+/* The entry of id, or NULL. An entry whose person is gone is dropped here. */
+const TalkMem *talk_mem_find(int id);
+/* Find or make the entry of id and move it to the front (day = today). 1,
+ * or 0 for the pet and for an id that is nobody. */
+int  talk_mem_touch(int id);
+/* The topic just talked about with id (touches): it becomes topic_a. */
+void talk_mem_note_topic(int id, uint16_t topic);
+/* Set TMF_* for id (touches). TMF_REFUSED_TODAY holds at once. The other
+ * three belong to the running conversation: later conversations see them
+ * once talk_mem_end() has run, never this one ("last time" stays true). */
+void talk_mem_set_flags(int id, unsigned flags);
+/* Clear TMF_* of id, set or pending (a promise kept). Does not touch. */
+void talk_mem_clear_flags(int id, unsigned flags);
+/* The player learned id's like `which` (0..4, as talk_gen_like; touches);
+ * and the query (1 known). */
+void talk_mem_know_like(int id, int which);
+int  talk_mem_like_known(int id, int which);
+/* 1 if id said no to a romance act today (K-5): the gate's refused_today. */
+int  talk_mem_refused_today(int id);
+/* A conversation begins (after talk_gen_begin): fill c->mem_topic and
+ * c->mem_flags (TMF_COMPLIMENTED / INSULTED / PROMISED) of every participant
+ * and set c->refused for those who said no today. A remembered topic the
+ * open database no longer has (a retired id) is left out. */
+void talk_mem_begin(TalkConv *c);
+/* A conversation ends: every participant who spoke, said no or got a flag
+ * is touched; "complimented" and "insulted" become this conversation's,
+ * "promised" stays until cleared, c->refused becomes TMF_REFUSED_TODAY
+ * (for everyone in the room after a K-7 end). */
+void talk_mem_end(const TalkConv *c);
+/* Forget id (the resident left the island; a new one may get the slot). */
+void talk_mem_forget(int id);
+/* Empty the table (a new town does it through the save registry). */
+void talk_mem_reset(void);
+
 /* One generated line. */
 #define TLF_REACTION 0x01u          /* a reaction to another resident                    */
 #define TLF_SAFE     0x02u          /* S3 replaced it with a safe line (a test fails)    */
diff --git a/core/src/talk_save.c b/core/src/talk_save.c
new file mode 100644
index 0000000..d4ce43f
--- /dev/null
+++ b/core/src/talk_save.c
@@ -0,0 +1,296 @@
+/* talk_save.c - talk memory and its save chunk 'TALK' (owner: TK, T6;
+ * docs/TALK.md 6e; design 6.8, 5.5 "Talk memory", 3.6 "Memory").
+ *
+ * The table: at most TALK_MEM_MAX (24) entries of 12 B, the most recently
+ * used first, so the last one is the one a 25th person evicts (LRU). With
+ * its 4 B header that is the whole state: 292 B of .bss (TALK_MEM_WORST),
+ * and the chunk is the same bytes written little endian:
+ *   [u8 version = 1][u8 count][u16 day_of_last] then count x
+ *   {u16 id; u16 day; u16 topic_a; u16 topic_b; u8 flags; u8 likes_known;
+ *    u16 spare = 0}
+ *
+ * "Refused today" (K-5) is cleared when the town day is no longer
+ * day_of_last: every public call checks first, so a save loaded on a later
+ * day forgets it too. The chunk callbacks never roll the day (save.c may
+ * produce a chunk twice and the bytes must not change in between).
+ *
+ * The flags of a running conversation wait in the high nibble (never
+ * saved) until talk_mem_end(): a "you were nice to me last time" callback
+ * can then never speak of the conversation it is said in.
+ *
+ * WHERE IT IS REGISTERED. The save registry is link-time (save_ext.h), so
+ * the runtime bit PLATF_TALK cannot choose: the descriptor is compiled
+ * only with -DDOOMO_HAS_TALK (core/Makefile: the native host; a console
+ * port adds it when it gets Talk). Everywhere else doomo_save_ext_talk
+ * stays the weak NULL, nothing references this file and --gc-sections
+ * drops it whole: 0 B on the GBA and on the PS1 today.
+ *
+ * Loading: no chunk (an old save) or a chunk read() refuses (unknown
+ * version, truncated, too long, a count over 24) leaves the table empty.
+ * The registry reads LIFE (the family pool) before TALK, so "who is still
+ * here" is asked of the loaded town: an entry of someone gone, of the pet,
+ * or a second entry of the same id is dropped. Topic ids are kept as they
+ * are (12 bits): a retired id is skipped when a conversation begins,
+ * because only the open database knows it.
+ *
+ * No stdio, no malloc, no floats.
+ */
+#include "doomo/doomo.h"
+#include "doomo/talk.h"
+#include "doomo/family.h"
+#include "doomo/save_ext.h"
+#include "doomo/save_budget.h"
+
+DOOMO_STATIC_ASSERT(sizeof(TalkMem) == TALK_MEM_ENTRY, talk_mem_entry_is_12_bytes);
+
+#define TMF_LAST    (TMF_COMPLIMENTED | TMF_INSULTED | TMF_PROMISED)
+#define TMF_SAVED   (TMF_LAST | TMF_REFUSED_TODAY)
+#define PEND_SHIFT  4                       /* the running conversation's TMF_LAST bits */
+#define LIKES_MASK  0x1Fu
+#define TOPIC_MASK  0x0FFFu
+
+static struct {
+    uint8_t  count;
+    uint8_t  pad;
+    uint16_t day;                           /* day_of_last: the town day the flags are of */
+    TalkMem  e[TALK_MEM_MAX];
+} mem;                                      /* 292 B */
+
+DOOMO_STATIC_ASSERT(sizeof(mem) == TALK_MEM_WORST, talk_mem_table_is_the_worst_case);
+
+static uint16_t today(void) { return (uint16_t)doomo_town.day; }
+
+/* somebody talk memory may be about: a resident or the hero who is on the
+ * island, or a member of the family pool */
+static int person_ok(int id)
+{
+    if (id >= 0 && id <= DOOMO_PLAYER_ID) {
+        const DoomoResident *r = town_res(id);
+        return r && r->status != RES_EMPTY;
+    }
+    return id > DOOMO_PLAYER_ID && id < TALK_PET_ID && family_find(id) != NULL;
+}
+
+/* the town day changed: nobody has "refused today" any more */
+static void roll(void)
+{
+    int i;
+    if (mem.day == today()) return;
+    for (i = 0; i < mem.count; i++) mem.e[i].flags = (uint8_t)(mem.e[i].flags & ~TMF_REFUSED_TODAY);
+    mem.day = today();
+}
+
+static int index_of(int id)
+{
+    int i;
+    for (i = 0; i < mem.count; i++) if (mem.e[i].id == id) return i;
+    return -1;
+}
+
+static void drop(int i)
+{
+    memmove(&mem.e[i], &mem.e[i + 1], (size_t)(mem.count - 1 - i) * sizeof(TalkMem));
+    mem.count--;
+    memset(&mem.e[mem.count], 0, sizeof(TalkMem));
+}
+
+/* the entry of id if its person is still here (a stale one is dropped) */
+static TalkMem *lookup(int id)
+{
+    int i = index_of(id);
+    if (i < 0) return NULL;
+    if (!person_ok(id)) { drop(i); return NULL; }
+    return &mem.e[i];
+}
+
+/* find or make, move to the front */
+static TalkMem *touch(int id)
+{
+    TalkMem t;
+    int i;
+    if (!person_ok(id)) { if ((i = index_of(id)) >= 0) drop(i); return NULL; }
+    roll();
+    i = index_of(id);
+    if (i < 0) {
+        if (mem.count == TALK_MEM_MAX) mem.count--;          /* LRU: the last one goes */
+        i = mem.count++;
+        memset(&mem.e[i], 0, sizeof(TalkMem));
+        mem.e[i].id = (uint16_t)id;
+    }
+    t = mem.e[i];
+    memmove(&mem.e[1], &mem.e[0], (size_t)i * sizeof(TalkMem));
+    t.day = today();
+    mem.e[0] = t;
+    return &mem.e[0];
+}
+
+int talk_mem_count(void) { return mem.count; }
+
+const TalkMem *talk_mem_at(int i) { return i >= 0 && i < mem.count ? &mem.e[i] : NULL; }
+
+const TalkMem *talk_mem_find(int id)
+{
+    roll();
+    return lookup(id);
+}
+
+int talk_mem_touch(int id) { return touch(id) != NULL; }
+
+void talk_mem_note_topic(int id, uint16_t topic)
+{
+    TalkMem *e;
+    if (topic == TC_NONE || topic > TOPIC_MASK || !(e = touch(id)) || e->topic_a == topic) return;
+    e->topic_b = e->topic_a;
+    e->topic_a = topic;
+}
+
+void talk_mem_set_flags(int id, unsigned flags)
+{
+    TalkMem *e = touch(id);
+    if (!e) return;
+    e->flags = (uint8_t)(e->flags | (flags & TMF_REFUSED_TODAY) | ((flags & TMF_LAST) << PEND_SHIFT));
+}
+
+void talk_mem_clear_flags(int id, unsigned flags)
+{
+    TalkMem *e;
+    roll();
+    if (!(e = lookup(id))) return;
+    flags &= TMF_SAVED;
+    e->flags = (uint8_t)(e->flags & ~(flags | ((flags & TMF_LAST) << PEND_SHIFT)));
+}
+
+void talk_mem_know_like(int id, int which)
+{
+    TalkMem *e;
+    if (which < 0 || which > 4 || !(e = touch(id))) return;
+    e->likes_known = (uint8_t)(e->likes_known | (1u << which));
+}
+
+int talk_mem_like_known(int id, int which)
+{
+    const TalkMem *e = talk_mem_find(id);
+    return e && which >= 0 && which <= 4 && ((e->likes_known >> which) & 1);
+}
+
+int talk_mem_refused_today(int id)
+{
+    const TalkMem *e = talk_mem_find(id);
+    return e && (e->flags & TMF_REFUSED_TODAY) != 0;
+}
+
+/* a remembered topic the open database still has (0: a retired id, or no database) */
+static uint16_t live_topic(uint16_t t)
+{
+    TalkConcept tc;
+    return t && talk_db_concept(t, &tc) ? t : TC_NONE;
+}
+
+void talk_mem_begin(TalkConv *c)
+{
+    int i, k;
+    if (!c) return;
+    roll();
+    /* flags left pending by a conversation that never ended are not "last time" */
+    for (i = 0; i < mem.count; i++) mem.e[i].flags = (uint8_t)(mem.e[i].flags & TMF_SAVED);
+    for (k = 0; k < c->n && k < TALK_PARTS_MAX; k++) {
+        const TalkMem *e = lookup(c->id[k]);
+        c->mem_topic[k] = TC_NONE;
+        c->mem_flags[k] = 0;
+        if (!e) continue;
+        c->mem_topic[k] = live_topic(e->topic_a);
+        if (!c->mem_topic[k]) c->mem_topic[k] = live_topic(e->topic_b);
+        c->mem_flags[k] = (uint8_t)(e->flags & TMF_LAST);
+        if (e->flags & TMF_REFUSED_TODAY) c->refused = (uint8_t)(c->refused | (1u << k));
+    }
+}
+
+void talk_mem_end(const TalkConv *c)
+{
+    int k;
+    if (!c) return;
+    roll();
+    for (k = 0; k < c->n && k < TALK_PARTS_MAX; k++) {
+        int id = c->id[k];
+        TalkMem *e = lookup(id);
+        unsigned pend = e ? (unsigned)(e->flags >> PEND_SHIFT) & TMF_LAST : 0u;
+        unsigned no = c->ended || ((c->refused >> k) & 1);     /* K-5; K-7 locks the room for the day */
+        if (!pend && !no && !((c->spoke >> k) & 1)) continue;   /* took no part */
+        if (!(e = touch(id))) continue;
+        e->flags = (uint8_t)((e->flags & (TMF_PROMISED | TMF_REFUSED_TODAY)) | pend | (no ? TMF_REFUSED_TODAY : 0u));
+    }
+}
+
+void talk_mem_forget(int id)
+{
+    int i = index_of(id);
+    if (i >= 0) drop(i);
+}
+
+void talk_mem_reset(void) { memset(&mem, 0, sizeof mem); }
+
+/* ---- the chunk (only where the build has Talk) ----------------------------- */
+#ifdef DOOMO_HAS_TALK
+static void put16(uint8_t *p, unsigned v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static unsigned get16(const uint8_t *p) { return (unsigned)p[0] | ((unsigned)p[1] << 8); }
+
+/* nothing while the table is empty: like PLAY and PROF, an empty table is
+ * a chunk of 0 bytes */
+static uint32_t talk_size(void)
+{
+    return mem.count ? (uint32_t)(TALK_MEM_HDR + mem.count * TALK_MEM_ENTRY) : 0u;
+}
+
+static uint32_t talk_write(uint8_t *dst, uint32_t cap)
+{
+    uint32_t n = talk_size();
+    int i;
+    if (!n || cap < n) return 0;
+    dst[0] = TALK_MEM_VERSION;
+    dst[1] = mem.count;
+    put16(dst + 2, mem.day);
+    for (i = 0; i < mem.count; i++) {
+        const TalkMem *e = &mem.e[i];
+        uint8_t *p = dst + TALK_MEM_HDR + i * TALK_MEM_ENTRY;
+        put16(p, e->id);
+        put16(p + 2, e->day);
+        put16(p + 4, e->topic_a);
+        put16(p + 6, e->topic_b);
+        p[8] = (uint8_t)(e->flags & TMF_SAVED);
+        p[9] = e->likes_known;
+        put16(p + 10, 0);
+    }
+    return n;
+}
+
+static int talk_read(const uint8_t *src, uint32_t len, uint16_t version)
+{
+    int i, n;
+    talk_mem_reset();
+    if (version != TALK_MEM_VERSION) return 0;               /* a later format: ignored */
+    if (len == 0) return 1;                                   /* the empty chunk */
+    if (len < TALK_MEM_HDR || src[0] != TALK_MEM_VERSION) return 0;
+    n = src[1];
+    if (n > TALK_MEM_MAX || len != (uint32_t)(TALK_MEM_HDR + n * TALK_MEM_ENTRY)) return 0;
+    mem.day = (uint16_t)get16(src + 2);
+    for (i = 0; i < n; i++) {
+        const uint8_t *p = src + TALK_MEM_HDR + i * TALK_MEM_ENTRY;
+        int id = (int)get16(p);
+        TalkMem *e;
+        if (!person_ok(id) || index_of(id) >= 0) continue;   /* gone, the pet, nobody, or twice */
+        e = &mem.e[mem.count++];
+        e->id = (uint16_t)id;
+        e->day = (uint16_t)get16(p + 2);
+        e->topic_a = (uint16_t)(get16(p + 4) & TOPIC_MASK);
+        e->topic_b = (uint16_t)(get16(p + 6) & TOPIC_MASK);
+        e->flags = (uint8_t)(p[8] & TMF_SAVED);
+        e->likes_known = (uint8_t)(p[9] & LIKES_MASK);
+    }
+    return 1;
+}
+
+static const DoomoSaveExt talk_ext = {
+    SAVE_EXT_TAG_TALK, TALK_MEM_VERSION, talk_size, talk_write, talk_read, talk_mem_reset, TALK_MEM_WORST
+};
+const DoomoSaveExt *const doomo_save_ext_talk = &talk_ext;
+#endif /* DOOMO_HAS_TALK */
diff --git a/core/tests/talk_gen/mem.tlk b/core/tests/talk_gen/mem.tlk
new file mode 100644
index 0000000..75b59d2
--- /dev/null
+++ b/core/tests/talk_gen/mem.tlk
@@ -0,0 +1,17 @@
+# core/tests/talk_gen/mem.tlk - the talk memory probes (test_talk_save.c, T6). Not game
+# text. Compiled into TALK_gentest.BIN after gentest.tlk; each rule answers an act that
+# gentest.tlk has no rule for, so a test picks it by the act.
+@rule core.promise act: tease
+  "You promised last time." guard: fact.promised
+  "A first promise." guard: !fact.promised
+@rule core.apologize act: complain
+  "Still cross about last time." guard: fact.insulted
+  "Sorry for what?" guard: !fact.insulted
+@rule core.offer act: thank
+  "You were kind last time." guard: fact.complimented
+  "Oh, thanks." guard: !fact.complimented
+@rule core.ask_advice act: answer
+  "Last time: {mem}." guard: fact.memory
+  "Nothing yet." guard: !fact.memory
+@rule cb.memory
+  "Again {mem}." guard: fact.memory
diff --git a/core/tests/test_talk_save.c b/core/tests/test_talk_save.c
new file mode 100644
index 0000000..338b36d
--- /dev/null
+++ b/core/tests/test_talk_save.c
@@ -0,0 +1,635 @@
+/* test_talk_save.c - T6: talk memory and the 'TALK' save chunk
+ * (core/src/talk_save.c). Owner: TK. docs/TALK.md 6e; design 6.8.
+ *
+ * The table (find, touch, the last two topics, the LRU, likes, who may
+ * have an entry), the day rollover (refused_today only), the flags of a
+ * running conversation (seen from the next one on), the chunk (empty: 0
+ * bytes; the worst case; a full save round trip; an old save; truncated,
+ * too long, wrong version, a count over the cap; a removed resident, the
+ * pet, a double id and a retired concept in a loaded chunk), and the
+ * generator's memory guards and callback through the test grammar
+ * (core/tests/talk_gen/mem.tlk), K-5 across two conversations included.
+ */
+#include "test.h"
+#include <stdlib.h>
+#include "doomo/doomo.h"
+#include "doomo/talk.h"
+#include "doomo/roster.h"
+#include "doomo/family.h"
+#include "doomo/save.h"
+#include "doomo/save_ext.h"
+#include "doomo/save_budget.h"
+
+#define ID_NANA  1
+#define ID_RIVET 13
+#define ID_VEX   666
+
+static uint8_t *gentest;
+static uint32_t gentest_size;
+
+static int open_gentest(void)
+{
+    if (!gentest) {
+        FILE *f = fopen(NAT_TALK_DIR "/TALK_gentest.BIN", "rb");
+        long n;
+        if (!f) return 0;
+        fseek(f, 0, SEEK_END);
+        n = ftell(f);
+        fseek(f, 0, SEEK_SET);
+        gentest = (uint8_t *)malloc((size_t)n);
+        if (!gentest || fread(gentest, 1, (size_t)n, f) != (size_t)n) { fclose(f); return 0; }
+        fclose(f);
+        gentest_size = (uint32_t)n;
+    }
+    return talk_db_open_mem(gentest, gentest_size) == TALK_DB_OK && talk_gen_ready();
+}
+
+static void premade_town(void)
+{
+    test_reset();
+    town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE);
+}
+
+static uint16_t concept(const char *key)
+{
+    uint16_t c = 0, wf = 0;
+    uint32_t tags[4];
+    if (talk_lex_find(key, &c, &wf, tags) < 0) return 0;
+    return c;
+}
+
+/* the n-th resident who is on the island */
+static int alive(int n)
+{
+    int id;
+    for (id = 0; id < DOOMO_PLAYER_ID; id++) {
+        const DoomoResident *r = town_res(id);
+        if (r && r->status != RES_EMPTY && n-- == 0) return id;
+    }
+    return -1;
+}
+
+static const DoomoSaveExt *ext(void) { return doomo_save_ext_talk; }
+
+static void put16(uint8_t *p, unsigned v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+
+/* a chunk by hand: the header and n entries */
+static uint32_t chunk(uint8_t *b, int version, int count, unsigned day)
+{
+    memset(b, 0, TALK_MEM_HDR + (size_t)(count > 0 ? count : 0) * TALK_MEM_ENTRY);
+    b[0] = (uint8_t)version;
+    b[1] = (uint8_t)count;
+    put16(b + 2, day);
+    return (uint32_t)(TALK_MEM_HDR + count * TALK_MEM_ENTRY);
+}
+
+static void entry(uint8_t *b, int i, int id, unsigned day, unsigned ta, unsigned tb, unsigned flags, unsigned likes)
+{
+    uint8_t *p = b + TALK_MEM_HDR + i * TALK_MEM_ENTRY;
+    put16(p, (unsigned)id); put16(p + 2, day); put16(p + 4, ta); put16(p + 6, tb);
+    p[8] = (uint8_t)flags; p[9] = (uint8_t)likes;
+    put16(p + 10, 0xBEEF);                               /* spare: ignored */
+}
