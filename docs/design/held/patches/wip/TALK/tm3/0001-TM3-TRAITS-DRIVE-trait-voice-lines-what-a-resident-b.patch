+/* TM3 (docs/TALK.md 6q): how much of a reply is the traits'. n adults (sliders from a hash), each with two valid
+ * trait sets A and B that share no trait (two traits each, a liked and a disliked topic), through the creator's live
+ * preview (the real generator): for each preview kind (greeting, answer, refusal) the same context (resident, seed)
+ * is said under A, under B, under no traits, and under A again.
+ *   ab    A and B lines that differ        a0   A and the empty set differ       same  A said twice is the same line
+ *   voice A lines that came from an alternative under a trait= guard of one of A's own traits
+ * The hot-headed against the kind person, same sliders and seed, refusal only:
+ *   hk_n people, hk_differ the lines differ, hk_own both lines came from their own trait's bank
+ * Returns 0, or -1 (err) when the database is missing. */
+typedef struct CensusTraits {
+    uint32_t n;
+    uint32_t ab[TP_KINDS], a0[TP_KINDS], same[TP_KINDS], voice[TP_KINDS];
+    uint32_t hk_n, hk_differ, hk_own;
+} CensusTraits;
+int  talk_census_traits(const CensusCfg *cfg, uint32_t n, CensusTraits *res, char *err, int errcap);
+void talk_census_traits_print(const CensusTraits *r, FILE *f);
+
 /* The quality checks of one exchange (Q1-Q4, Q6), for the census and the
  * unit tests: the first failure (QF_*) or QF_NONE. u is the utterance
  * after the gate. */
