+        if (!talk_gen_alt_info(alt, &ai)) break;
+        for (k = 0; k < ai.nterm; k++) {
+            int p = ai.term[2 * k] & 0x7F, neg = (ai.term[2 * k] & 0x80) != 0;
+            if (p == TGP_TRAIT && !neg) tt = ai.term[2 * k + 1];
