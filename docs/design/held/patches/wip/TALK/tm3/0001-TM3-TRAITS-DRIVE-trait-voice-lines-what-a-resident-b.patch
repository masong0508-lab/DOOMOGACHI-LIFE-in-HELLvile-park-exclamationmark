+/* ---- TM3: how much of a reply is the traits' --------------------------------------------------------------- */
+static void tr_person(DoomoResident *r, uint32_t n)
+{
+    uint32_t h = doomo_hash32(n * 0x9E3779B1u + 17u);
+    resident_default(r);
+    RES_SET_STAGE(r, LIFE_ADULT);
+    RES_SET_PERSONA(r, PERS_MOVEMENT, (int)(h & 15)); RES_SET_PERSONA(r, PERS_SPEECH, (int)((h >> 4) & 15));
+    RES_SET_PERSONA(r, PERS_EXPRESSION, (int)((h >> 8) & 15)); RES_SET_PERSONA(r, PERS_ATTITUDE, (int)((h >> 12) & 15));
+    RES_SET_PERSONA(r, PERS_QUIRK, (int)((h >> 16) & 15));
+}
+
+static void tr_set(TalkTraitSet *ts, uint32_t n, int count, const TalkTraitSet *avoid)
+{
+    uint32_t h = doomo_hash32(n * 0x85EBCA6Bu + 99u);
+    int tries = 0;
+    talk_traitset_clear(ts);
+    while (talk_traitset_count(ts) < count && tries++ < 200) {
+        int t = 1 + (int)(h % (uint32_t)(TT_COUNT - 1));
+        h = doomo_hash32(h + 0x1234567u);
+        if (avoid && talk_traitset_has(avoid, t)) continue;
+        talk_traitset_add(ts, t);
+    }
+    talk_traitset_like(ts, 1 + (int)(h % 13u));
+    h = doomo_hash32(h + 7u);
+    talk_traitset_dislike(ts, 1 + (int)(h % 13u));
+}
+
+int talk_census_traits(const CensusCfg *cfg, uint32_t n, CensusTraits *res, char *err, int errcap)
+{
+    Grid g;
+    uint32_t i, base = cfg && cfg->seed ? cfg->seed : 20261115u;
+    memset(res, 0, sizeof *res);
+    if (talk_db_open(lang_find("en")) != TALK_DB_OK || !talk_gen_ready()) {
+        snprintf(err, (size_t)errcap, "no TALK_en.BIN with the generator banks (make -C core talk)");
+        return -1;
+    }
+    if (cfg && cfg->grid && load_grid(cfg->grid, &g, err, errcap) == 0) census_town(&g);
+    else { memset(&doomo_town, 0, sizeof doomo_town); opt_defaults(); town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE); }
+    res->n = n;
+    for (i = 0; i < n; i++) {
+        DoomoResident r;
+        TalkTraitSet a, b, none, hot, kind;
+        int k;
+        tr_person(&r, base + i);
+        tr_set(&a, base + i, 2, NULL);
+        tr_set(&b, base + i + 100000u, 2, &a);
+        talk_traitset_clear(&none);
+        for (k = 0; k < TP_KINDS; k++) {
+            TalkLine la, lb, l0, la2;
+            TalkTrace tr;
+            uint32_t seed = 40000u + i * 3u + (uint32_t)k;
+            memset(&tr, 0, sizeof tr);
+            if (!talk_preview_trace(&r, &a, k, seed, &la, &tr)) continue;
+            talk_preview_line(&r, &b, k, seed, &lb);
+            talk_preview_line(&r, &none, k, seed, &l0);
+            talk_preview_line(&r, &a, k, seed, &la2);
+            res->ab[k] += strcmp(la.text, lb.text) != 0;
+            res->a0[k] += strcmp(la.text, l0.text) != 0;
+            res->same[k] += strcmp(la.text, la2.text) == 0;
+            res->voice[k] += talk_trace_trait_voice(&tr) != 0;
+        }
+        talk_traitset_clear(&hot); talk_traitset_add(&hot, TT_HOTHEADED);
+        talk_traitset_clear(&kind); talk_traitset_add(&kind, TT_KIND);
+        {
+            TalkLine lh, lk;
+            TalkTrace th, tk;
+            uint32_t seed = 70000u + i;
+            memset(&th, 0, sizeof th); memset(&tk, 0, sizeof tk);
+            if (talk_preview_trace(&r, &hot, TP_REFUSAL, seed, &lh, &th) && talk_preview_trace(&r, &kind, TP_REFUSAL, seed, &lk, &tk)) {
+                res->hk_n++;
+                res->hk_differ += strcmp(lh.text, lk.text) != 0;
+                res->hk_own += talk_trace_trait_voice(&th) == TT_HOTHEADED && talk_trace_trait_voice(&tk) == TT_KIND;
+                if (cfg && cfg->sample && res->hk_n <= 40)                    /* the first pairs, for a read of the tone */
+                    fprintf(cfg->sample, "hot-headed [%d]: %s\n     kind [%d]: %s\n", talk_trace_trait_voice(&th), lh.text,
+                            talk_trace_trait_voice(&tk), lk.text);
+            }
+        }
+    }
+    talk_db_close();
+    return 0;
+}
