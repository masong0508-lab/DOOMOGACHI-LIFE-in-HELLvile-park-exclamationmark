+/* test_talk_tm3.c - TM3-TRAITS-DRIVE: traits drive the whole reply (docs/TALK.md 6q).
+ * Owner: TALK. Spec docs/design/talk/TALK_MULTILEVEL.md 5.3 and 5.4.
+ *
+ *   tm3_edgy_inert_preview_table      edgy traits change nothing for a minor (stage x trait x kind x seed)
+ *   tm3_edgy_inert_kid_room           ... nor with a child in the room, and no edgy voice line is picked there
+ *   tm3_trait_lines_guarded           every alternative under a trait= guard: edgy ones are adults-only and
+ *                                     kid-free; none sits in a sincere bank (the lint says so too)
+ *   tm3_trait_voice_reaches_lines     a trait's own line is what the person says (greeting, answer, refusal)
+ *   tm3_bring_up_*                    what a resident brings up on their own: the liked root first, a disliked
+ *                                     root as a mild gripe, never romance, never a grief topic, never in a
+ *                                     room that may not hear it
+ *   tm3_idle_remarks_follow_traits    the drama manager's idle chatter takes the liked root
+ * The census-side share (1,000 people, the hot-headed against the kind) is in test_talk_census.c
+ * (talk_census_traits_share).
+ */
+#include "test.h"
+#include <string.h>
+#include <stdio.h>
+#include "doomo/doomo.h"
+#include "doomo/talk.h"
+#include "doomo/talk_traits.h"
