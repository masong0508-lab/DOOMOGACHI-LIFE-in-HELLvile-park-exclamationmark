+
+# ---- creative ----------------------------------------------------------------------------------
+@rule core.greet.t_creative guard: trait=creative&!cast act: greet
+  "Oh, hello, {you}! Hold still, you've got great shapes." w=14
+  "Hi, {you}! I was just about to make something. Join me?" w=14
+@rule core.invite.t_creative_no guard: trait=creative act: no
+  "I can't, I'm halfway through making something. Sorry." w=16
