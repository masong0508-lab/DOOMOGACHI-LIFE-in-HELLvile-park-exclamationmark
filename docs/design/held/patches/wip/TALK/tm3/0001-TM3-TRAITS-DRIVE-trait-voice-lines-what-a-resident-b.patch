+    {
+        int d1, d2;
+        CHECK_EQ(talk_trait_bring_up(id, &aud, 77u, &d1), talk_trait_bring_up(id, &aud, 77u, &d2));
+        CHECK_EQ(d1, d2);
+    }
+    /* no liked and no disliked root: nothing to bring up */
+    talk_traitset_clear(&ts);
+    talk_traitset_add(&ts, TT_KIND);
+    CHECK_EQ(talk_trait_set(id, &ts), TTE_OK);
+    CHECK_EQ(talk_trait_bring_up(id, &aud, 5u, NULL), 0);
+    CHECK_EQ(talk_trait_bring_up(TALK_PET_ID, &aud, 5u, NULL), 0);
+    CHECK_EQ(talk_trait_bring_up(-1, &aud, 5u, NULL), 0);
+    talk_trait_clear(id);
+    talk_db_close();
+}
+
+TEST(tm3_bring_up_never_romance_nor_unsafe)
+{
+    TalkTraitSet ts;
+    TalkAudience adult_room, kid_room;
+    int id, i, n = 0, rom = 0, kid_n = 0;
+    premade_town();
+    CHECK(open_en());
+    memset(&adult_room, 0, sizeof adult_room);
+    memset(&kid_room, 0, sizeof kid_room);
+    kid_room.any_minor = kid_room.target_minor = 1;
+    /* every resident, the default set: whatever the topic, it is in the set's roots, never romance, never grief,
+     * and the room may hear it */
+    for (id = 0; id < DOOMO_PLAYER_ID; id++) {
+        TalkTraitSet d;
+        if (town_res(id)->status != RES_ALIVE) continue;
+        CHECK(talk_trait_get(id, &d));
+        for (i = 0; i < 6; i++) {
+            const TalkAudience *aud = i & 1 ? &kid_room : &adult_room;
+            int dir = 0;
+            uint16_t t = talk_trait_bring_up(id, aud, 900u + (uint32_t)i * 31u + (uint32_t)id, &dir);
+            TalkConcept tc;
+            int rt;
+            if (!t) continue;
+            n++;
+            kid_n += aud == &kid_room;
+            CHECK(talk_db_concept(t, &tc));
+            rt = root_of(t);
+            rom += rt == TCR_ROMANCE || rt == TCR_SAFETY;
+            CHECK(!(tc.flags & TCF_GRIEF));
+            CHECK(talk_gen_concept_ok(t, aud));
+            CHECK_MSG(dir > 0 ? (d.like[0] == rt || d.like[1] == rt) : (d.dislike[0] == rt || d.dislike[1] == rt),
+                      "resident %d: topic root %d is not in their set", id, rt);
+        }
+    }
+    CHECK_EQ(rom, 0);
+    CHECK(n > 300 && kid_n > 100);
+    /* an adult who likes romance does not bring it up; a minor cannot have it as a topic at all */
+    talk_traitset_clear(&ts);
+    talk_traitset_like(&ts, TCR_ROMANCE);
+    people();
+    CHECK_EQ(talk_trait_set(adults[2], &ts), TTE_OK);
+    for (i = 0; i < 60; i++) {
+        uint16_t t = talk_trait_bring_up(adults[2], &adult_room, 40u + (uint32_t)i, NULL);
+        CHECK_EQ(t, 0);
+    }
+    talk_trait_clear(adults[2]);
+    CHECK(!talk_trait_topic_ok(TCR_ROMANCE, LIFE_CHILD) && !talk_trait_topic_ok(TCR_ROMANCE, LIFE_TEEN));
+    for (i = 0; i < 60; i++) {
+        uint16_t t = talk_trait_bring_up(kids[0], &kid_room, 40u + (uint32_t)i, NULL);
+        CHECK(root_of(t) != TCR_ROMANCE);
+    }
+    printf("      %d idle topics over every resident (%d in a kid room): none romance, safety or grief, all in the speaker's own roots\n",
+           n, kid_n);
+    talk_trait_clear(kids[0]);
+    talk_db_close();
+}
