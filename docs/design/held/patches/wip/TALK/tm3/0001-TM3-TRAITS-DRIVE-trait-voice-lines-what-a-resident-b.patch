+TEST(tm3_edgy_inert_kid_room)
+{
+    static const uint8_t acts[] = { TA_GREET, TA_INVITE, TA_ASK_FAVOR, TA_ASK_OPINION, TA_ASK_ABOUT, TA_COMPLIMENT };
+    int e, a, i, who, other, same = 0, total = 0, adult_voice = 0, adult_total = 0;
+    TalkTraitSet ts, none;
+    premade_town();
+    CHECK(open_en());
+    people();
+    CHECK(nkid >= 1 && nadult >= 4);
+    talk_traitset_clear(&none);
+    for (e = 0; e < 5; e++) {
+        talk_traitset_clear(&ts);
+        talk_traitset_add(&ts, edgy[e]);
+        for (who = 0; who < 3; who++) {
+            int id = who == 0 ? kids[0] : adults[who];                /* a child, then two adults with a child beside them */
+            other = who == 0 ? -1 : kids[0];
+            for (a = 0; a < (int)sizeof acts; a++) {
+                for (i = 0; i < 12; i++) {
+                    TalkLine l, l0;
+                    TalkTrace tr, tr0;
+                    uint32_t seed = 5000u + (uint32_t)(i * 13 + a);
+                    talk_trait_set(id, &ts);
+                    say(id, other, acts[a], 0, seed, &l, &tr);
+                    talk_trait_set(id, &none);
+                    say(id, other, acts[a], 0, seed, &l0, &tr0);
+                    talk_trait_clear(id);
+                    CHECK_MSG(strcmp(l.text, l0.text) == 0 && talk_trace_trait_voice(&tr) == 0,
+                              "edgy trait %d showed in a kid room (act %d): \"%s\" / \"%s\"", edgy[e], acts[a], l.text, l0.text);
+                    total++;
+                    same += strcmp(l.text, l0.text) == 0;
+                }
+            }
+        }
+        /* the sanity check: an adult alone with the player does show it */
+        for (a = 0; a < (int)sizeof acts; a++) {
+            for (i = 0; i < 12; i++) {
+                TalkLine l;
+                TalkTrace tr;
+                talk_trait_set(adults[3], &ts);
+                say(adults[3], -1, acts[a], 0, 5000u + (uint32_t)(i * 13 + a), &l, &tr);
+                talk_trait_clear(adults[3]);
+                adult_total++;
+                adult_voice += talk_trace_trait_voice(&tr) == edgy[e];
+            }
+        }
+    }
+    CHECK_MSG(adult_voice >= 20, "an adult alone shows an edgy trait only %d of %d lines", adult_voice, adult_total);
+    printf("      %d kid-room lines: all the same with and without the edgy trait (%d); an adult alone shows it in %d of %d\n", total,
