+
+static void premade_town(void)
+{
+    test_reset();
+    town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE);
+}
+
+static int open_en(void) { return talk_db_open(lang_find("en")) == TALK_DB_OK && talk_gen_ready(); }
+
+static void sample(DoomoResident *r, int stage, int mov, int spe, int exp, int att, int quirk)
+{
+    resident_default(r);
+    RES_SET_STAGE(r, stage);
+    RES_SET_PERSONA(r, PERS_MOVEMENT, mov); RES_SET_PERSONA(r, PERS_SPEECH, spe);
+    RES_SET_PERSONA(r, PERS_EXPRESSION, exp); RES_SET_PERSONA(r, PERS_ATTITUDE, att);
+    RES_SET_PERSONA(r, PERS_QUIRK, quirk);
+}
+
+static const uint8_t edgy[5] = { TT_HOTHEADED, TT_ROMANTIC, TT_SNOB, TT_JEALOUS, TT_MEAN };
+
+static int is_edgy(int t)
+{
+    int i;
+    for (i = 0; i < 5; i++) if (edgy[i] == t) return 1;
+    return 0;
+}
+
+/* ---- the edgy traits are inert for a minor: the whole table ---------------------------------------------- */
+TEST(tm3_edgy_inert_preview_table)
+{
+    int e, stage, kind, seed, n = 0, live = 0, adult_n = 0;
+    TalkTraitSet none, ts;
+    premade_town();
+    CHECK(open_en());
+    talk_traitset_clear(&none);
+    for (e = 0; e < 5; e++) {
+        talk_traitset_clear(&ts);
+        talk_traitset_add(&ts, edgy[e]);
+        for (stage = 0; stage < LIFE_COUNT; stage++) {
+            DoomoResident r;
+            sample(&r, stage, 3 + e, 7 + stage, 9, 5 + e, 4 + stage);
+            for (kind = 0; kind < TP_KINDS; kind++) {
+                for (seed = 0; seed < 24; seed++) {
+                    TalkLine a, b;
+                    TalkTrace ta;
+                    uint32_t sd = 9000u + (uint32_t)(seed * 7 + kind);
+                    memset(&ta, 0, sizeof ta);
+                    CHECK(talk_preview_trace(&r, &ts, kind, sd, &a, &ta) > 0);
+                    CHECK(talk_preview_line(&r, &none, kind, sd, &b) > 0);
+                    if (LIFE_IS_MINOR(stage)) {
+                        CHECK_MSG(strcmp(a.text, b.text) == 0 && talk_trace_trait_voice(&ta) == 0,
+                                  "edgy trait %d moved a minor's line (stage %d kind %d seed %d): \"%s\" / \"%s\"", edgy[e], stage,
+                                  kind, seed, a.text, b.text);
+                        n++;
+                    } else if (stage == LIFE_ADULT) {
+                        adult_n++;
+                        live += talk_trace_trait_voice(&ta) == edgy[e];
+                    }
+                }
+            }
+        }
+    }
