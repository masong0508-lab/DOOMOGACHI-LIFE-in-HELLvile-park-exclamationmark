+TEST(tm3_idle_remarks_follow_traits)
+{
+    TalkTraitSet likes_food, plain;
+    int ids[2], seed, with[2] = { 0, 0 }, total[2] = { 0, 0 }, pass, i;
+    premade_town();
+    CHECK(open_en());
+    people();
+    CHECK(nadult >= 4);
+    ids[0] = adults[0];
+    ids[1] = adults[1];
+    talk_traitset_clear(&likes_food);
+    talk_traitset_add(&likes_food, TT_CHEERFUL);
+    talk_traitset_like(&likes_food, TCR_FOOD);
+    talk_traitset_clear(&plain);
+    talk_traitset_add(&plain, TT_CHEERFUL);
+    for (pass = 0; pass < 2; pass++) {
+        talk_trait_set(ids[0], pass ? &likes_food : &plain);
+        talk_trait_set(ids[1], pass ? &likes_food : &plain);
+        for (seed = 0; seed < 80; seed++) {
+            TalkState s;
+            uint32_t h0 = talk_safe_lint_hits();
+            talk_dm_begin(&s, DOOMO_PLAYER_ID, ids, 2, 7000u + (uint32_t)seed);
+            for (i = 0; i < 2; i++) {
+                if (!talk_dm_tick(&s, TALK_IDLE_FRAMES)) continue;
+                while (talk_dm_step(&s, NULL)) {
+                    if (s.line[0].to == -1 || !s.line[0].topic) continue;       /* the prod, or a line without a topic */
+                    total[pass]++;
+                    with[pass] += root_of(s.line[0].topic) == TCR_FOOD;
+                }
+            }
+            CHECK_EQ(talk_safe_lint_hits(), h0);
+        }
+    }
+    printf("      idle chatter about a topic, 80 chats: food in %d of %d when they like food, %d of %d when they have no liked root\n",
+           with[1], total[1], with[0], total[0]);
+    CHECK(total[1] >= 40 && total[0] >= 40);
+    CHECK_MSG(with[1] * 100 >= total[1] * 35, "a person who likes food brought it up in only %d of %d idle remarks", with[1], total[1]);
+    CHECK_MSG(with[1] > 2 * with[0], "liked food %d of %d against %d of %d", with[1], total[1], with[0], total[0]);
+    talk_trait_clear(ids[0]);
+    talk_trait_clear(ids[1]);
+    talk_db_close();
+}
