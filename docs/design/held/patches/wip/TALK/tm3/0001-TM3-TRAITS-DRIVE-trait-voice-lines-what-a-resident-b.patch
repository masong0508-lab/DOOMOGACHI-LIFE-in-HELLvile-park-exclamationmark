+/* ---- every trait-guarded alternative is where it may be ------------------------------------------------- */
+TEST(tm3_trait_lines_guarded)
+{
+    int alt, found = 0, edgy_found = 0, per_trait[TT_COUNT] = { 0 }, t;
+    premade_town();
+    CHECK(open_en());
+    for (alt = 0; alt < 60000; alt++) {
