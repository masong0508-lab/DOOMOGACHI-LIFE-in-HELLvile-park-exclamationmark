+    CHECK_MSG(live * 4 >= adult_n, "an adult's edgy trait spoke only %d of %d lines", live, adult_n);
+    printf("      %d minor lines (5 edgy traits x %d stages x 3 kinds x 24 seeds) are the same with and without the trait; an adult's edgy trait speaks %d of %d\n",
+           n, LIFE_COUNT, live, adult_n);
+    talk_db_close();
+}
+
+/* ---- ... and with a child in the room -------------------------------------------------------------------- */
+static int kids[8], nkid, adults[40], nadult;
+
+static void people(void)
+{
+    int id;
+    nadult = nkid = 0;
+    for (id = 0; id < DOOMO_MAX_RESIDENTS; id++) {
+        if (town_res(id)->status != RES_ALIVE || (town_res(id)->flags & RF_CUSTOM)) continue;
+        if (talk_safe_minor(id)) { if (nkid < 8) kids[nkid++] = id; }
+        else if (id < DOOMO_PLAYER_ID && nadult < 40) adults[nadult++] = id;
+    }
+}
+
+static int say(int id, int other, int act, uint16_t topic, uint32_t seed, TalkLine *l, TalkTrace *tr)
+{
+    TalkConv c;
+    int ids[2], n = 1;
+    ids[0] = id;
+    if (other >= 0) ids[n++] = other;
+    talk_gen_begin(&c, DOOMO_PLAYER_ID, ids, n, seed);
+    memset(tr, 0, sizeof *tr);
+    return talk_gen_line(&c, 0, -1, act, topic, l, tr);
+}
