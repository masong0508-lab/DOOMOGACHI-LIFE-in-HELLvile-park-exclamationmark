-void fc_grade_stamp(int cx, int cy, int grade, int t)
+/* ui_sparkle's pixels at x >= xmin only (the speech bubble drawn after the stamp covers the rest) */
+static void sparkle_from(int cx, int cy, int phase, uint8_t c, int xmin)
+{
+    int s = ui_sparkle_size(phase), x0;
+    if (s == 0) return;
+    x0 = DOOMO_MAX(cx - s, xmin);
+    if (x0 <= cx + s) plat_rect(x0, cy, cx + s + 1 - x0, 1, c);
+    if (cx >= xmin) plat_rect(cx, cy - s, 1, 2 * s + 1, c);
+    if (s >= 2) {
+        x0 = DOOMO_MAX(cx - 1, xmin);
+        if (x0 <= cx + 1) plat_rect(x0, cy - 1, cx + 2 - x0, 3, c);
+        if (cx >= xmin) plat_rect(cx, cy, 1, 1, PAL_WHITE);
+    }
+    if (s >= 3) {
+        if (cx - 2 >= xmin) { plat_rect(cx - 2, cy - 2, 1, 1, c); plat_rect(cx - 2, cy + 2, 1, 1, c); }
+        if (cx + 2 >= xmin) { plat_rect(cx + 2, cy + 2, 1, 1, c); plat_rect(cx + 2, cy - 2, 1, 1, c); }
+    }
+}
+
+/* the stamp's ring half-width (and the text scale it is drawn at, 1 for the first two ticks of its pop) */
+int fc_grade_stamp_r(int grade, int t, int *scale)
+{
+    const char *s = cook_grade_names[DOOMO_CLAMP(grade, 0, 4)];
+    int sc = fc_big() ? 3 : 2;
+    if (ui_pop_scale(t) < 160) sc = 1;
+    if (scale) *scale = sc;
+    return ui_text_big_width(s, sc) / 2 + 8;
+}
+
+/* (S4-K) the stamp in parts, so the kept kitchen can redraw the sparkles (which change every second
+ * tick) without the ring and the word: part 0 the ring and the word, 1 and 2 PERFECT's sparkles at
+ * the ring's ends, 3 its star above */
+void fc_grade_stamp_part(int cx, int cy, int grade, int t, int part, int xmin)
 {
     static const uint8_t col[5] = { 0, PAL_RAMP(RAMP_STONE, 1), PAL_PAINT(PAINT_SKY, 1),
                                     PAL_PAINT(PAINT_MINT, 0), PAL_PAINT(PAINT_CHERRY, 1) };
     const char *s = cook_grade_names[DOOMO_CLAMP(grade, 0, 4)];
-    int scale = fc_big() ? 3 : 2, s256 = ui_pop_scale(t), w, r;
+    int scale, w, r = fc_grade_stamp_r(grade, t, &scale);
     uint8_t c = col[DOOMO_CLAMP(grade, 0, 4)];
     if (grade <= GRADE_NONE || plat_draw_skipped()) return;
-    if (s256 < 160) scale = 1;
     w = ui_text_big_width(s, scale);
-    r = w / 2 + 8;
-    /* the stamp: a ring with a ribbon behind the word */
-    ui_fill_ellipse(cx, cy + 1, r + 2, 9 * scale / 2 + 4, ui_darker(c));
-    ui_fill_ellipse(cx, cy, r, 9 * scale / 2 + 2, PAL_WHITE);
-    ui_fill_ellipse(cx, cy, r - 2, 9 * scale / 2, ui_lighter(ui_lighter(c)));
-    ui_text_big(cx - w / 2, cy - 4 * scale, s, scale, c, PAL_WHITE);
-    if (grade == GRADE_PERFECT) {
-        ui_sparkle(cx - r, cy - 6, (t / 2) & 15, PAL_UI_GOLD);
-        ui_sparkle(cx + r, cy + 4, (t / 2 + 7) & 15, PAL_UI_GOLD);
-        ui_star(cx, cy - 9 * scale / 2 - 6, 4, PAL_UI_GOLD);
+    switch (part) {
+    case 0:
+        /* the stamp: a ring with a ribbon behind the word */
+        ui_fill_ellipse(cx, cy + 1, r + 2, 9 * scale / 2 + 4, ui_darker(c));
+        ui_fill_ellipse(cx, cy, r, 9 * scale / 2 + 2, PAL_WHITE);
+        ui_fill_ellipse(cx, cy, r - 2, 9 * scale / 2, ui_lighter(ui_lighter(c)));
+        ui_text_big(cx - w / 2, cy - 4 * scale, s, scale, c, PAL_WHITE);
+        break;
+    case 1:
+        if (grade == GRADE_PERFECT) {
+            if (xmin > 0) sparkle_from(cx - r, cy - 6, (t / 2) & 15, PAL_UI_GOLD, xmin);
+            else ui_sparkle(cx - r, cy - 6, (t / 2) & 15, PAL_UI_GOLD);
+        }
+        break;
+    case 2: if (grade == GRADE_PERFECT) ui_sparkle(cx + r, cy + 4, (t / 2 + 7) & 15, PAL_UI_GOLD); break;
+    default: if (grade == GRADE_PERFECT) ui_star(cx, cy - 9 * scale / 2 - 6, 4, PAL_UI_GOLD); break;
     }
 }
+
+void fc_grade_stamp(int cx, int cy, int grade, int t)
+{
+    int part;
+    for (part = 0; part < 4; part++) fc_grade_stamp_part(cx, cy, grade, t, part, 0);
+}
