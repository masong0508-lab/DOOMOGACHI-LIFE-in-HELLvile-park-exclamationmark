+/* S4-W (plat_ext.h plat_under): a small box of the Mode 4 page being drawn, read and written by halfwords (VRAM
+ * takes no byte writes). The caller keeps x and w even. No RAM: the box lives in the caller's buffer. */
+int plat_under(int op, int x, int y, int w, int h, void *buf)
+{
+    uint16_t *b = (uint16_t *)buf;
+    int r, c, hw = w / 2;
+    if (!buf || ((uintptr_t)buf & 1) || (x & 1) || (w & 1) || w <= 0 || h <= 0 || x < 0 || y < 0 ||
+        x + w > SCREEN_W || y + h > SCREEN_H || (op != PLAT_UNDER_GET && op != PLAT_UNDER_PUT)) return 0;
+    if (gba_nodraw == 1) return 0;
+    if (gba_nodraw == GBA_NODRAW_FIRST) vid_route(0, y, SCREEN_W, y + h);   /* G5: the first 2D call decides */
+    if (gba_nodraw != 0 && gba_nodraw != GBA_NODRAW_MEASURE && gba_nodraw != GBA_NODRAW_PANEL) return 0;  /* tiles */
+    for (r = 0; r < h; r++) {
+        volatile uint16_t *row = (volatile uint16_t *)(void *)((uint8_t *)gba_back + (y + r) * SCREEN_W + x);
+        if (op == PLAT_UNDER_GET) for (c = 0; c < hw; c++) b[c] = row[c];
+        else                      for (c = 0; c < hw; c++) row[c] = b[c];
+        b += hw;
+    }
+    return 1;
+}
+
