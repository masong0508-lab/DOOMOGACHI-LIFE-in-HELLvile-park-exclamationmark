+/* ---- a small box of the frame being drawn, kept and put back (S4-W, docs/GBA.md "Speed wave 3: S4-W") -----------
+ * A held frame (plat_hold_frame) whose scene has a few small things come and go over it (the Prize Wheel's winning
+ * icon lights up and goes out over the pie) keeps the clean pixels under them and puts them back, instead of
+ * drawing the picture under them again.
+ *   PLAT_UNDER_GET   copy the box (x, y, w, h) of the frame being drawn, as drawn so far, into buf (w * h bytes)
+ *   PLAT_UNDER_PUT   copy buf back into that box
+ * x and w are even and the box lies inside the screen (the GBA writes whole halfwords; the caller rounds the box
+ * out); buf is 2-aligned. Returns 1 when done, 0 when the platform cannot (the default; a skipped tick; a tile frame). */
+enum { PLAT_UNDER_GET = 1, PLAT_UNDER_PUT = 2 };
+int  plat_under(int op, int x, int y, int w, int h, void *buf);
+
 /* ---- scene scratch (SP3 / P-I1, docs/ISLAND_SPEED.md I12) ---------------------------------------------------------
  * RAM that belongs to the running scene's code only: on the PS1, the part of the scene overlay slot after the
  * group that is loaded (the island group leaves ~70 KB of it unused). plat_scene_scratch(bytes, &gen) returns
diff --git a/core/native/plat_native.c b/core/native/plat_native.c
index e59fa84..8b3fc8e 100644
--- a/core/native/plat_native.c
+++ b/core/native/plat_native.c
@@ -100,6 +100,20 @@ int plat_strip(int op, int y, int h)
     if (held && held_n == nat_w * nat_h) memcpy(&held_fb[y * nat_w], strip_fb, (size_t)(h * nat_w));
     return 1;
 }
+/* S4-W (plat_ext.h plat_under): a box of the frame, kept and put back */
+int plat_under(int op, int x, int y, int w, int h, void *buf)
+{
+    int r;
+    if (!buf || ((uintptr_t)buf & 1) || (x & 1) || (w & 1) || w <= 0 || h <= 0 || x < 0 || y < 0 || x + w > nat_w || y + h > nat_h)
+        return 0;
+    if (op != PLAT_UNDER_GET && op != PLAT_UNDER_PUT) return 0;
+    for (r = 0; r < h; r++) {
+        uint8_t *row = &nat_fb[(y + r) * nat_w + x];
+        if (op == PLAT_UNDER_GET) memcpy((uint8_t *)buf + r * w, row, (size_t)w);
+        else memcpy(row, (const uint8_t *)buf + r * w, (size_t)w);
+    }
+    return 1;
+}
 int nat_strip_band(int *y, int *h)
 {
     *y = strip_y; *h = strip_h;
