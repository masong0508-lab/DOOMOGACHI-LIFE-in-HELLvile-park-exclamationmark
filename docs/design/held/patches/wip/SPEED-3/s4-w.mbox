+/* S4-W: the box a particle draws in, rounded out to even x and width and clipped to the screen (the platform keeps and
+ * puts back whole halfwords, plat_under). Only the kinds the Prize Wheel makes: -1 for any other, 0 for none on screen */
+static int fx_box(const MgFx *f, int ox, int oy, int b[4])
+{
+    int x = (f->x >> 4) + ox, y = (f->y >> 4) + oy, age = f->max - f->life, r, x0, y0, x1, y1;
+    switch (f->kind) {
+    case MGFX_CONFETTI: x0 = x; y0 = y - 1; x1 = x + 3; y1 = y + 2; break;
+    case MGFX_STAR:     x0 = x - 3; y0 = y - 3; x1 = x + 4; y1 = y + 4; break;
+    case MGFX_PUFF:     r = 2 + age / 3; x0 = x - r - 1; y0 = y - r - 1; x1 = x + r + 2; y1 = y + r + 2; break;
+    default: return -1;
+    }
+    x0 = DOOMO_MAX(x0, 0) & ~1;
+    y0 = DOOMO_MAX(y0, 0);
+    x1 = (DOOMO_MIN(x1, mg_w()) + 1) & ~1;
+    y1 = DOOMO_MIN(y1, mg_h());
+    if (x1 <= x0 || y1 <= y0) return 0;
+    b[0] = x0; b[1] = y0; b[2] = x1 - x0; b[3] = y1 - y0;
+    return 1;
+}
+
+/* S4-W: walk the live particles (a held frame keeps what is under each before it draws it: the Prize Wheel's card).
+ * Each one's kind and box go to keep(); it returns 0 to say no (then nothing more is drawn and the walk says -1). draw = 0 only
+ * asks. Returns the number of particles on screen, or -1: a kind with no box here, a popup alive, or keep() said no */
+int mg_fx_walk(int draw, int (*keep)(int kind, int x, int y, int w, int h))
+{
+    int i, n = 0, b[4];
+    for (i = 0; i < POP_MAX; i++)
+        if (pops[i].life) return -1;
+    for (i = 0; i < FX_MAX; i++) {
+        int r;
+        if (!fx[i].life) continue;
+        r = fx_box(&fx[i], mg.ox, mg.oy, b);
+        if (r < 0) return -1;
+        if (!r) continue;
+        if (keep && !keep(fx[i].kind, b[0], b[1], b[2], b[3])) return -1;
+        if (draw) fx_draw_one(&fx[i], mg.ox, mg.oy);
+        n++;
+    }
+    return n;
+}
