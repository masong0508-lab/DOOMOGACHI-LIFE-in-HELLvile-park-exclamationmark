+static void fx_crect(int x, int y, int w, int h, uint8_t c, int bi)
+{
+    int x1 = x + w, y1 = y + h, ya, yb;
+    const int *e;
+    if (bi == 2) { plat_rect(x, y, w, h, c); return; }
+    e = fx_ex[bi];
+    if (x >= e[2] || x1 <= e[0] || y >= e[3] || y1 <= e[1]) { fx_crect(x, y, w, h, c, bi + 1); return; }
+    if (y < e[1]) fx_crect(x, y, w, e[1] - y, c, bi + 1);
