+/* ---- (S4-W) the Prize Wheel's result card: once its window has popped and the confetti is gone it holds, and a held
+ * tick repaints only the bulbs, the winning icon's light and the hub. The disc (the rim and its shadow, outside the
+ * window) is the same picture as the full frame's on every tick, and when the card goes away (done) the window does
+ * too; the window itself (its glint) and the tent (its sway) stand still while held: the pixel-changing part ------- */
+typedef struct { uint32_t disc[900], win[900]; uint8_t held[900], phase[900]; } WheelRun;
+
+static int wh_in_disc(int x, int y)
+{
+    int big = mg_big(), R = (big ? MG_WHEEL_R_BIG : MG_WHEEL_R_SMALL) + 6;
+    int cx = mg_w() - (R - 6) - (big ? 34 : 14), cy = mg_h() / 2 + (big ? 10 : 8);
+    return (x - cx) * (x - cx) + (y - cy) * (y - cy) <= R * R || (x - cx - 2) * (x - cx - 2) + (y - cy - 3) * (y - cy - 3) <= R * R;
+}
+
+static void wheel_run(int hold, WheelRun *r, int nf)
+{
+    int f, big = mg_big(), ww = big ? 200 : 160, wx = (mg_w() - ww) / 2, wy = mg_h() - 44 - (big ? 16 : 6), res = 0;
+    doomo_init();
+    test_reset();
+    ui_modal_hold_enable(hold);
+    fp_new_island(TOWN_POP_PREMADE, 4242);
+    scene_set(&SCENE_MG_WHEEL, MG_ARG_AUTOSTART | MG_ARG_AUTOPLAY);
+    for (f = 0; f < nf; f++) {
+        int before = ui_modal_hold_enable(-1), x, y, ph = mg_wheel_phase();
+        uint32_t hd = 2166136261u, hw = 2166136261u;
+        res = ph == 4 ? res + 1 : 0;
+        plat_begin_frame();
+        doomo_frame(res == 200 ? BTN_A : 0);                /* leave the card 200 ticks after it appears */
+        plat_end_frame();
+        r->held[f] = (uint8_t)(ui_modal_hold_enable(-1) > before);
+        r->phase[f] = (uint8_t)mg_wheel_phase();            /* the phase the frame was drawn in */
+        for (y = 0; y < nat_h; y++)
+            for (x = 0; x < nat_w; x++) {
+                int win = x >= wx - 2 && x < wx + ww + 4 && y >= wy - 9;
+                if (win) hw = (hw ^ nat_fb[y * nat_w + x]) * 16777619u;
+                else if (wh_in_disc(x, y)) hd = (hd ^ nat_fb[y * nat_w + x]) * 16777619u;
+            }
+        r->disc[f] = hd;
+        r->win[f] = hw;
+    }
+    ui_modal_hold_enable(0);
+}
+
+TEST(modal_hold_fair_wheel_result_card)
+{
+    static WheelRun a, b;
+    int f, nf = 900, held_result = 0, done_from = -1;
+    wheel_run(1, &a, nf);
+    wheel_run(0, &b, nf);
+    for (f = 0; f < nf; f++) {
+        CHECK_MSG(!b.held[f], "wheel: the hold-off run held tick %d", f);
+        CHECK_MSG(a.disc[f] == b.disc[f], "wheel: tick %d (phase %d, held %d): the disc differs from the full frame", f, a.phase[f], a.held[f]);
+        if (a.held[f] && a.phase[f] == 4) held_result++;
+        if (done_from < 0 && a.phase[f] == 5) done_from = f;
+    }
+    CHECK_MSG(done_from > 0, "wheel: the card was never left");
+    CHECK_MSG(held_result > 100, "wheel: only %d held ticks on the result card", held_result);
+    /* the card going away is drawn in full (the window leaves the held frame): the same picture as the hold-off run's */
+    CHECK_MSG(!a.held[done_from] && a.win[done_from] == b.win[done_from], "wheel: the first tick of done was not drawn in full");
+}
