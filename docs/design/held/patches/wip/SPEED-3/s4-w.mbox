+    yb = DOOMO_MIN(y1, e[3]);
+    if (x < e[0]) fx_crect(x, ya, e[0] - x, yb - ya, c, bi + 1);
+    if (x1 > e[2]) fx_crect(e[2], ya, x1 - e[2], yb - ya, c, bi + 1);
