From 0f73a26893fd86250417789603971f85e298a88f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 20:02:29 +0000
Subject: [PATCH 1/3] S4-C: vid_blit's silhouette loops read a halfword a pair
 (22 -> ~13 cycles a pair), exact; engine test: a third of the blit cases are
 silhouettes

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cvDzgwv9nxsL8r6tWV
---
 gba/enginetest/et_blittest.c |  3 ++-
 gba/src/video_loops.s        | 51 +++++++++++++++++++++++++++++-------
 2 files changed, 44 insertions(+), 10 deletions(-)

diff --git a/gba/enginetest/et_blittest.c b/gba/enginetest/et_blittest.c
index dba6a23..05a24c2 100644
--- a/gba/enginetest/et_blittest.c
+++ b/gba/enginetest/et_blittest.c
@@ -148,7 +148,7 @@ void et_blit_test(void)
         uint16_t v = (uint16_t)next();
         PAGE_A[k] = v; PAGE_B[k] = v;
     }
-    for (i = 0; i < 6000 && !bad; i++) {
+    for (i = 0; i < 9000 && !bad; i++) {
         DoomoImage im;
         int w = 1 + (int)(next() % (i & 1 ? 40 : 17)), h = 1 + (int)(next() % 14), off = (int)(next() & 3);
         int dens = (int)(next() % 4), scale = (next() % 5) ? 1 : 1 + (int)(next() % 3);
@@ -156,6 +156,7 @@ void et_blit_test(void)
         int x = (int)(next() % 300) - 40, y = (int)(next() % 200) - 25;
         uint32_t color = 1 + next() % 255;
         int j, y0, y1, r;
+        if (i % 3 == 2) { flags = IMG_SILHOUETTE; scale = 1; }   /* (S4-C) a third of the cases: the ARM silhouette loops */
         if (i % 7 == 0) { x = (int)(next() % 8) - 4; } else if (i % 7 == 1) { x = 240 - (int)(next() % 12); }
         for (j = 0; j < w * h; j++) {
             uint32_t v = next();
diff --git a/gba/src/video_loops.s b/gba/src/video_loops.s
index af4174b..4831727 100644
--- a/gba/src/video_loops.s
+++ b/gba/src/video_loops.s
@@ -461,6 +461,32 @@ r3d_up2:
     b       .Lbl_mdone
     .endm
 
+@ SIL_TAIL loop: BLIT_TAIL with the colour: the pair v (r3) says which pixels are opaque, the pixels written are
+@ the colour (r10; both: one halfword store of colour * 0x101, one: the read-modify-write).
+    .macro SIL_TAIL L
+    cmp     r3, #0
+    beq     8f
+    tst     r3, #0xFF00
+    tstne   r3, #0xFF
+    orrne   r4, r10, r10, lsl #8
+    strneh  r4, [r1], #2
+    cmpne   r1, r2
+    bne     \L
+    cmp     r1, r2
+    beq     .Lbl_mdone
+    tst     r3, #0xFF
+    ldrh    r4, [r1]
+    andne   r4, r4, #0xFF00
+    andeq   r4, r4, #0xFF
+    orrne   r4, r4, r10
+    orreq   r4, r4, r10, lsl #8
+    strh    r4, [r1]
+8:  add     r1, r1, #2
+    cmp     r1, r2
+    bne     \L
+    b       .Lbl_mdone
+    .endm
+
 @ ---------------------------------------------------------------------------
 @ void vid_blit(int x, int y, const DoomoImage *img, int scale, int flags, uint32_t color)
 @ The common case (scale 1, no flip: cached chibis, building sprites, shape
@@ -554,15 +580,22 @@ vid_blit:
     orr     r3, r5, r3, lsl #8
     mov     r5, r4, lsr #8
     BLIT_TAIL .Lbl_od
-.Lbl_sil:                               @ silhouette: opaque pixels become the colour
-    ldrb    r3, [r0], #1
-    ldrb    r4, [r0], #1
-    cmp     r3, #0
-    movne   r3, r10
-    cmp     r4, #0
-    movne   r4, r10, lsl #8
-    orr     r3, r3, r4
-    BLIT_TAIL .Lbl_sil
+.Lbl_sil:                               @ silhouette: opaque pixels become the colour (S4-C: a halfword a pair,
+    tst     r0, #1                      @ the pair's two pixels tested in place; the old loop read two bytes and
+    bne     .Lbl_siodd                  @ built the pair first: 22 cycles a pair, now ~13)
+.Lbl_sial:                              @ aligned source
+    ldrh    r3, [r0], #2
+    SIL_TAIL .Lbl_sial
+.Lbl_siodd:                             @ odd source: as .Lbl_odd
+    sub     r0, r0, #1
+    ldrh    r5, [r0], #2
+    mov     r5, r5, lsr #8
+.Lbl_sio:
+    ldrh    r4, [r0], #2
+    and     r3, r4, #0xFF
+    orr     r3, r5, r3, lsl #8
+    mov     r5, r4, lsr #8
+    SIL_TAIL .Lbl_sio
 .Lbl_mdone:
     tst     r12, #1                     @ odd x1: only the left pixel of its pair
     beq     .Lbl_nodrow
-- 
