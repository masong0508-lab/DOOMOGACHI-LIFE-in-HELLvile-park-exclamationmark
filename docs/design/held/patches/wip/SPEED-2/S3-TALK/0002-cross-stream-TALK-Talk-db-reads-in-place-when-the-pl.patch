 }
 
+const uint8_t *plat_talk_image(void) { return gba_talk_bin; }
+
 uint32_t plat_talk_read(uint32_t off, void *dst, uint32_t len)
 {
     uint32_t size = (uint32_t)(gba_talk_bin_end - gba_talk_bin);
