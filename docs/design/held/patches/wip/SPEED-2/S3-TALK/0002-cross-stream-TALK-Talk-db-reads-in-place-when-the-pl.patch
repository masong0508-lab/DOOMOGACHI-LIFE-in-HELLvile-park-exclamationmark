diff --git a/core/tests/test_talk_lint_speed.c b/core/tests/test_talk_lint_speed.c
index 0e379e6..6d1bc73 100644
--- a/core/tests/test_talk_lint_speed.c
+++ b/core/tests/test_talk_lint_speed.c
@@ -190,3 +190,48 @@ TEST(talk_lint_pair_skip_changes_no_verdict)
         CHECK_MSG(bsk > 4u * a, "the pair table skipped %u words and %u were scanned", (unsigned)bsk, (unsigned)a);
     }
 }
+
+/* ---- plat_talk_image: a platform with the bank in addressable memory (the GBA ROM) reads it in place -------------- */
+#include <stdlib.h>
+#include "doomo/plat_ext.h"
+static const uint8_t *g_img;
+const uint8_t *plat_talk_image(void) { return g_img; }
+
+TEST(talk_db_reads_the_platform_image_in_place)
+{
+    uint8_t a[80], c[80];
+    uint32_t size, id, at;
+    uint8_t *img;
+    g_img = NULL;
+    CHECK(talk_db_open(lang_find("en")) == TALK_DB_OK);
+    size = plat_talk_load("en");
+    CHECK(size > 1000u && size != PLAT_TALK_LOADING);
+    img = (uint8_t *)malloc(size);
+    CHECK(img != NULL);
+    CHECK(plat_talk_read(0, img, size) == size);
+    /* the same reads from the image give the same bytes; a changed image byte shows (the image is what is read) */
+    g_img = img;
+    CHECK(talk_db_open(lang_find("en")) == TALK_DB_OK);
+    for (id = 1; id < TB_COUNT; id++) {
+        uint32_t off, packed, raw;
+        if (!talk_db_bank((int)id, &off, &packed, &raw) || packed < 4) continue;
+        for (at = 0; at + 1 < packed; at += packed / 23 + 1) {
+            uint32_t l = 40 < packed - at ? 40 : packed - at;
+            CHECK(talk_db_read((int)id, at, c, l));
+            CHECK(plat_talk_read(off + at, a, l) == l);
+            CHECK(memcmp(a, c, l) == 0);
+        }
+    }
+    {
+        uint32_t off, packed, raw;
+        CHECK(talk_db_bank(TB_SAFETY, &off, &packed, &raw));
+        img[off + 100] ^= 0xFF;
+        CHECK(talk_db_read(TB_SAFETY, 100, c, 1));
+        CHECK(plat_talk_read(off + 100, a, 1) == 1);
+        CHECK_MSG(c[0] != a[0], "the read did not come from the image");
+        img[off + 100] ^= 0xFF;
+    }
+    g_img = NULL;
+    talk_db_close();
+    free(img);
+}
