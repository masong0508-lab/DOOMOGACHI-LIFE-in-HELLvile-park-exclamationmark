 }
 
 /* ---- S3: the output lint ----------------------------------------------- */
-static int wordc(char c) { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '\''; }
-static int wordch_at(const char *t, int i) { return wordc(t[i]) || (t[i] == '-' && wordc(t[i + 1])); }
+static inline int wordc(char c) { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '\''; }
+static inline int wordch_at(const char *t, int i) { return wordc(t[i]) || (t[i] == '-' && wordc(t[i + 1])); }
+
+/* S3-TALK (speed): a register word can only be in the line where its first two characters stand side by side
+ * (a space in the word matches a run of spaces, so its pair still occurs in the line). The line's character pairs
+ * go into a 1,024-bit table once (a pair is the low five bits of each character: a collision only keeps a word
+ * that cannot match, never drops one), and a word whose first pair is not in it is skipped without reading
+ * the rest of its string or scanning the line. The result of the lint is the same for every line (tested against the
+ * original scan, test_talk_lint_speed.c). On the GBA the scan was 80% of the 100 to 400 ms a generated line cost. */
+#define LINT_PAIRS 128
+#ifdef DOOMO_TALK_DEBUG
+static uint32_t lint_scans, lint_skips;                  /* test counters: words scanned / skipped by the pair table */
+void talk_safe_lint_counts(uint32_t *scans, uint32_t *skips) { *scans = lint_scans; *skips = lint_skips; }
+#define LINT_COUNT(c) (c)++
+#else
+#define LINT_COUNT(c) ((void)0)
+#endif
+static void pairs_of(const char *v, uint8_t *bg)
+{
+    int i;
+    memset(bg, 0, LINT_PAIRS);
+    for (i = 0; v[i] && v[i + 1]; i++) {
+        unsigned k = (unsigned)(((v[i] & 31) << 5) | (v[i + 1] & 31));
+        bg[k >> 3] |= (uint8_t)(1u << (k & 7));
+    }
+}
+static inline int pair_in(const uint8_t *bg, char a, char b)
+{
+    unsigned k = (unsigned)(((a & 31) << 5) | (b & 31));
+    return (bg[k >> 3] >> (k & 7)) & 1;
+}
 
 /* the register word w ("what the hell", spaces match runs of spaces) at t[j]: its end or -1 */
 static int match_body(const char *w, const char *t, int j)
@@ -424,6 +453,7 @@ static int lint_core(const char *line, const TalkAudience *aud, int *swears, int
