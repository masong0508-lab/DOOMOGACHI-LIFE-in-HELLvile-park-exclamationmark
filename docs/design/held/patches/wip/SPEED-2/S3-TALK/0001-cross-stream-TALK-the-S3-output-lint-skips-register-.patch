     SafHdr h;
     char v[TALK_SHOWN_MAX * 3], word[TALK_TOK_LEN * 2];
+    uint8_t bg[LINT_PAIRS], rb[64];
     int i, o = 0, nsw = 0, k;
     if (!line || !aud) return TL_NO_DB;
     if (!saf_hdr(&h)) return TL_NO_DB;
@@ -437,23 +467,38 @@ static int lint_core(const char *line, const TalkAudience *aud, int *swears, int
         v[o++] = c;
     }
     v[o] = 0;
+    pairs_of(v, bg);
     for (k = 0; k < (int)h.nreg; k++) {
-        uint8_t r[8];
+        const uint8_t *r;
         char w[48];
+        uint8_t pk[2];
         uint32_t so;
         int n, len = 0;
-        if (!talk_db_read(TB_SAFETY, h.reg_off + 8u * (uint32_t)k, r, 8)) return TL_NO_DB;
+        if ((k & 7) == 0) {                      /* the records, eight a read */
+            int left = (int)h.nreg - k;
+            if (!talk_db_read(TB_SAFETY, h.reg_off + 8u * (uint32_t)k, rb, 8u * (uint32_t)(left < 8 ? left : 8))) return TL_NO_DB;
+        }
+        r = rb + 8 * (k & 7);
         so = le32(r);
         if (so >= h.str_len) return TL_NO_DB;
+        if (!(r[5] & SR_ALLOW) && h.str_len - so >= 2) {
+            /* the word's first two characters against the line's pairs */
+            if (!talk_db_read(TB_SAFETY, h.str_off + so, pk, 2)) return TL_NO_DB;
+            if (pk[0] && pk[1] && !pair_in(bg, (char)pk[0], (char)pk[1])) { LINT_COUNT(lint_skips); continue; }
+        }
+        LINT_COUNT(lint_scans);
         len = (int)(h.str_len - so < sizeof w - 1 ? h.str_len - so : sizeof w - 1);
         if (!talk_db_read(TB_SAFETY, h.str_off + so, w, (uint32_t)len)) return TL_NO_DB;
         w[len] = 0;
         if (r[5] & SR_ALLOW) {
             /* blank the allowed phrase out of the text before the checks */
-            int p, l = (int)strlen(w);
+            int p, l = (int)strlen(w), blanked = 0;
             for (p = 0; v[p]; p++)
-                if ((p == 0 || !wordch_at(v, p - 1)) && strncmp(v + p, w, (size_t)l) == 0 && !wordch_at(v, p + l))
+                if ((p == 0 || !wordch_at(v, p - 1)) && strncmp(v + p, w, (size_t)l) == 0 && !wordch_at(v, p + l)) {
                     memset(v + p, ' ', (size_t)l);
+                    blanked = 1;
+                }
+            if (blanked) pairs_of(v, bg);       /* blanks made new pairs */
             continue;
         }
         n = count_word(w, r[5] & SR_HEAD, r[5] & SR_TAIL, v);
diff --git a/core/tests/test_talk_lint_speed.c b/core/tests/test_talk_lint_speed.c
new file mode 100644
index 0000000..0e379e6
--- /dev/null
+++ b/core/tests/test_talk_lint_speed.c
@@ -0,0 +1,192 @@
+/* test_talk_lint_speed.c - S3-TALK: the S3 output lint (talk_safe.c lint_core) skips a register word whose first
+ * two characters are not a pair of the line, so a generated line costs a few ms on the GBA instead of 100 to 400.
+ * The skip must change no verdict: this file keeps the original scan (every register word read whole and matched
+ * against the line, `ref_lint` below, a copy of lint_core before S3-TALK) and compares it with talk_safe_lint_probe
+ * on a corpus made of every register word (alone, in a sentence, with a trailing / leading letter, a hyphen, upper
+ * case, line codes, a run of spaces), the allowed phrases, and the lines the generator says over many seeds.
+ * Fails without the skip: the "skips most words" check (the counters count words skipped by the pair table). */
+#define DOOMO_TALK_DEBUG 1
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/talk.h"
+#include "doomo/lang.h"
+
+#define SAF_MAGIC 0x31464153u
+#define SR_HEAD    1u
+#define SR_TAIL    2u
+#define SR_FORBID  4u
+#define SR_SUGGEST 8u
+#define SR_ALLOW   16u
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static int rwordc(char c) { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '\''; }
+static int rwordch_at(const char *t, int i) { return rwordc(t[i]) || (t[i] == '-' && rwordc(t[i + 1])); }
+static int rmatch_body(const char *w, const char *t, int j)
+{
+    while (*w) {
+        if (*w == ' ') {
+            if (t[j] != ' ') return -1;
+            while (t[j] == ' ') j++;
+            w++;
+            continue;
+        }
+        if (t[j] != *w) return -1;
+        j++;
+        w++;
+    }
+    return j;
+}
+static int rcount_word(const char *w, int head, int tail, const char *v)
+{
+    int i, n = 0;
+    for (i = 0; v[i]; i++) {
+        int j, e;
+        if (i > 0 && rwordch_at(v, i - 1)) continue;
+        for (j = i; v[j] && (j == i || rwordch_at(v, j - 1)); j++) {
+            e = rmatch_body(w, v, j);
+            if (e >= 0) {
+                if (tail) while (rwordch_at(v, e)) e++;
+                if (!rwordch_at(v, e)) { n++; break; }
+            }
+            if (!head) break;
+        }
+    }
+    return n;
+}
+
+/* the register part of the original lint_core: the verdict before the hate list, or TL_OK with *nsw_out */
+static int ref_register(const char *line, const TalkAudience *aud, int strict, int *nsw_out)
+{
+    uint8_t b[48];
+    uint32_t nreg, reg_off, str_off, str_len, k;
+    char v[TALK_SHOWN_MAX * 3];
+    int i, o = 0, nsw = 0;
+    if (!talk_db_read(TB_SAFETY, 0, b, 48) || rd32(b) != SAF_MAGIC) return TL_NO_DB;
+    nreg = rd32(b + 4); reg_off = rd32(b + 8); str_off = rd32(b + 36); str_len = rd32(b + 40);
+    for (i = 0; line[i] && o < (int)sizeof v - 1; i++) {
+        char c = line[i];
+        if (c == '[') { while (line[i] && line[i] != ']') i++; if (!line[i]) break; continue; }
+        if (c == '{') { while (line[i] && line[i] != '}') i++; if (!line[i]) break; continue; }
+        if (c == '/') c = ' ';
+        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
+        v[o++] = c;
+    }
+    v[o] = 0;
+    for (k = 0; k < nreg; k++) {
+        uint8_t r[8];
+        char w[48];
+        uint32_t so;
+        int n, len;
+        if (!talk_db_read(TB_SAFETY, reg_off + 8u * k, r, 8)) return TL_NO_DB;
+        so = rd32(r);
+        if (so >= str_len) return TL_NO_DB;
+        len = (int)(str_len - so < sizeof w - 1 ? str_len - so : sizeof w - 1);
+        if (!talk_db_read(TB_SAFETY, str_off + so, w, (uint32_t)len)) return TL_NO_DB;
+        w[len] = 0;
+        if (r[5] & SR_ALLOW) {
+            int p, l = (int)strlen(w);
+            for (p = 0; v[p]; p++)
+                if ((p == 0 || !rwordch_at(v, p - 1)) && strncmp(v + p, w, (size_t)l) == 0 && !rwordch_at(v, p + l))
+                    memset(v + p, ' ', (size_t)l);
+            continue;
+        }
+        n = rcount_word(w, r[5] & SR_HEAD, r[5] & SR_TAIL, v);
+        if (!n) continue;
+        if (r[5] & SR_FORBID) return TL_FORBIDDEN;
+        if (strict) return TL_REGISTER_KID;
+        if (r[4] == TR_HATE || r[4] == TR_REALWORLD || r[4] == TR_DISTRESS) return TL_FORBIDDEN;
+        if (r[4] == TR_SEXUAL || (r[5] & SR_SUGGEST)) {
+            if (aud->any_minor || aud->target_minor || aud->avatar_minor) return TL_REGISTER_KID;
+            if (aud->pet) return TL_SEXUAL_PET;
+            continue;
+        }
+        if (aud->any_minor || aud->target_minor || aud->avatar_minor) return TL_REGISTER_KID;
+        if (r[4] == TR_STRONG) nsw += n;
+    }
+    *nsw_out = nsw;
+    return TL_OK;
+}
+
+/* the verdict of the original lint: the register part, then the rest through the new code with the register words
+ * out of the way is not possible, so the full verdict is compared only when the register part decides, or says OK
+ * and the new lint agrees on OK / not OK with the hate list and the length (those two did not change) */
+static int same_verdict(const char *line, const TalkAudience *aud, int strict)
+{
+    int nsw = 0, ref = ref_register(line, aud, strict, &nsw);
+    int got = talk_safe_lint_probe(line, aud, strict);
+    if (ref != TL_OK) return got == ref;
+    /* the register part passed: the new lint may still say HATE / LENGTH / SWEAR_CAP (probe: no swears pointer) */
+    if (nsw && !strict) return got == TL_HATE || got == TL_LENGTH || got == TL_SWEAR_CAP;
+    return got == TL_OK || got == TL_HATE || got == TL_LENGTH;
+}
+
+static int fails, cases;
+static void one(const char *line)
+{
+    TalkAudience adults, kids, pet;
+    memset(&adults, 0, sizeof adults);
+    memset(&kids, 0, sizeof kids); kids.any_minor = 1;
+    memset(&pet, 0, sizeof pet); pet.pet = 1;
+    cases++;
+    if (!same_verdict(line, &adults, 0) || !same_verdict(line, &kids, 0) || !same_verdict(line, &pet, 0) ||
+        !same_verdict(line, &adults, 1)) {
+        if (fails++ < 5) fprintf(stderr, "lint verdict differs: \"%s\"\n", line);
+    }
+}
+
+TEST(talk_lint_pair_skip_changes_no_verdict)
+{
+    uint8_t b[48];
+    uint32_t nreg, reg_off, str_off, str_len, k, s0, s1;
+    char line[200];
+    static const char *const tpl[] = {
+        "%s", "Well, %s.", "I said %s to the %s man.", "x%s", "%sx", "%s-pie and tea", "a  %s  b", "[R4]%s{.}", "That is so %s!",
+        "pre%s post",
+    };
+    int t, nw = 0;
+    CHECK(talk_db_open(lang_find("en")) == TALK_DB_OK);
+    CHECK(talk_db_read(TB_SAFETY, 0, b, 48) && rd32(b) == SAF_MAGIC);
+    nreg = rd32(b + 4); reg_off = rd32(b + 8); str_off = rd32(b + 36); str_len = rd32(b + 40);
+    CHECK(nreg > 50);
+    talk_safe_lint_counts(&s0, &s1);
+    fails = cases = 0;
+    for (k = 0; k < nreg; k++) {
+        uint8_t r[8];
+        char w[48], up[48];
+        uint32_t so;
+        int len, i;
+        CHECK(talk_db_read(TB_SAFETY, reg_off + 8u * k, r, 8));
+        so = rd32(r);
+        len = (int)(str_len - so < sizeof w - 1 ? str_len - so : sizeof w - 1);
+        CHECK(talk_db_read(TB_SAFETY, str_off + so, w, (uint32_t)len));
+        w[len] = 0;
+        for (i = 0; w[i]; i++) up[i] = (w[i] >= 'a' && w[i] <= 'z') ? (char)(w[i] - 32) : w[i];
+        up[i] = 0;
+        nw++;
+        for (t = 0; t < (int)(sizeof tpl / sizeof *tpl); t++) {
+            snprintf(line, sizeof line, tpl[t], w, w);
+            one(line);
+            if (t == 1) { snprintf(line, sizeof line, tpl[t], up); one(line); }
+        }
+        snprintf(line, sizeof line, "A tug of war, %s, and a pie.", w);
+        one(line);
+        snprintf(line, sizeof line, "%s", w);
+        if (len > 1) { line[1] = 0; one(line); }                     /* a lone first letter */
+    }
+    one("");
+    one("Tug of war in the park!");
+    one("What the hell, you hell-bent  loon. Damn.");
+    one("it's fine, it's fine, isn't it");
+    CHECK(nw == (int)nreg);
+    CHECK_MSG(fails == 0, "%d of %d lines got another verdict than the original scan", fails, cases);
+    {
+        uint32_t a, bsk;
+        talk_safe_lint_counts(&a, &bsk);
+        a -= s0; bsk -= s1;
+        /* most register words cannot be in a line: the pair table must have skipped most of them */
+        CHECK_MSG(bsk > 4u * a, "the pair table skipped %u words and %u were scanned", (unsigned)bsk, (unsigned)a);
+    }
+}
