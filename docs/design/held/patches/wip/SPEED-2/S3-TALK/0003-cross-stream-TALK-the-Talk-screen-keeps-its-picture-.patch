+/* S3-TALK: where a plain line's box and portrait can draw on this screen, wherever the box is in its slide-in
+ * (ui_dialog_band's rules, for the box in its final place): the first row any of it can reach (the portrait and
+ * the name pill stand 48 rows above the box; the '!' hop and a 2-row margin), and the rect [cx0, cx1) x [cy0, cy1)
+ * that is opaque box body on every frame, the slide-in included (the box only moves up, so the rows of that rect
+ * above the box are rows no earlier frame drew in). A host that keeps the picture under the box (talk_scene.c)
+ * keeps rows [reach, screen height) without that rect. A choice window reaches higher: not for those. */
+int ui_dialog_reach(int *cx0, int *cy0, int *cx1, int *cy1)
+{
+    DlgEntry e;
+    DlgBox b;
+    memset(&e, 0, sizeof e);
+    e.speaker = -1;
+    dlg_box(&e, &b);
+    if (cx0) *cx0 = b.x;
+    if (cx1) *cx1 = b.x + b.w;
+    if (cy0) *cy0 = b.y + 1 + 5;
+    if (cy1) *cy1 = b.y - 2 + b.h - 5;
+    return DOOMO_MAX(b.y - 48 - 2, 0);
+}
