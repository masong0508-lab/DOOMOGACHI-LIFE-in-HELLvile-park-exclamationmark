+#if HK_CODE
+/* ---- S3-TALK: the kept Talk picture (GBA; docs/GBA.md "Speed wave 3: S3-TALK") --------------------------------
+ * Talk is a still picture: the scene below it (the title, the house) does not move under it any more than the people
+ * strip does, and the panel changes only when the cursor moves. But Talk is an overlay scene, so every tick the
+ * scene below was drawn in full (24 ms for the title, more for the house), then the strip, the panel and the box of a
+ * line. Now, once a full frame has been drawn, the platform keeps both Mode 4 pages as that picture
+ * (plat_hold_frame) and scene_draw does not draw the scenes below Talk (scene_keep_below, hk_ask asks every frame):
+ *   - the panel is drawn again only when its pixels change (hk_pkey: page, cursor, rows, title, mood, the cursor
+ *     heart's bob), on top of itself with its drop shadow left out (ui_shadow_kept: it is on the page already);
+ *   - the people strip likewise (hk_ssig: names, who is spoken to, the engage bars);
+ *   - a line's box (SCENE_DIALOG, drawn above Talk) draws on a kept band, as the story overworld's does (SP5,
+ *     plat_hold_band): the rows [ui_dialog_reach, screen) without the box's opaque body, with the card's rows;
+ *     when the band does not fit the arena (a scene below with a big scratch) the dialogue frames are full frames;
+ *   - a toast, a tip card, another scene over Talk, a language change or a skipped tick's gap end it: the next frame is
+ *     full, and the picture is kept again after it.
+ * The pixel change (SPEED DEFAULTS, held frames, GBA only): what moves in the scene below Talk stands still while
+ * the screen is kept (the title's drifting dots, the house's idle animations). Everything Talk draws is the same
+ * pixels as a full frame: test_talk_hold.c plays the screens kept and full over a still backdrop and compares. */
+static uint32_t hk_ssig(void)
+{
+    uint32_t h = ui_panel_key();
+    int i;
+    h = ui_key_int(h, plat_screen_w() | plat_screen_h() << 12);
+    h = ui_key_int(h, T.s.nparts | (T.to + 1) << 8);
+    for (i = 0; i < T.s.nparts; i++) {
+        const TalkPart *p = &T.s.part[i];
+        h = ui_key_int(h, p->id | ((p->flags & TPF_LEFT) ? 1 << 14 : 0) | p->engage << 16);
+    }
+    return h ? h : 1;
+}
+
+static uint32_t hk_pkey(int py)
+{
+    char ttl[48], buf[48];
+    const char *mood = mood_word();
+    uint32_t h = ui_panel_key();
+    int i, rows = T.list.count - T.list.top;
+    if (rows > T.list.visible) rows = T.list.visible;
+    h = ui_key_int(h, T.page | T.list.sel << 4 | T.list.top << 12 | T.list.count << 20);
+    h = ui_key_int(h, (mood ? (mood[0] == 'h') + 1 : 0) | (ui_wave((int)doomo_frame_count(), 20, 2) + 2) << 4 |
+                      opt_get(OPT_CURSOR) << 8 | (ui_wave((int)doomo_frame_count(), 24, 1) + 1) << 12 | py << 16);   /* the cursor heart and the scroll arrows bob */
+    h = ui_key_str(h, panel_title(ttl, (int)sizeof ttl));
+    for (i = 0; i < rows; i++) h = ui_key_str(h, row_text(T.list.top + i, buf));
+    return h ? h : 1;
+}
+
+static int hk_card_on(int py) { return !T.busy && py - 14 >= 26; }
+static uint32_t hk_csig(int py) { return (uint32_t)(hk_card_on(py) | (T.page == PG_MAIN) << 1 | 1 << 2); }
+
+static void hk_drop(void)
+{
+    if (T.hk.st) {
+        plat_hold_frame(0);
+        if (T.hk.band) plat_hold_band(PLAT_BAND_DROP, NULL);
+    }
+    memset(&T.hk, 0, sizeof T.hk);
+}
+
+/* scene_draw asks before it draws the scenes below Talk: 1 = Talk keeps the picture this frame (the band is back,
+ * Talk draws what changed), 0 = the full frame */
+static int hk_ask(const DoomoScene *top, int above)
+{
+    uint32_t f = doomo_frame_count();
+    int py;
+    T.hk.keep = 0;
+    if (!T.hk.st) return 0;
+    if (T.hk.frame + 1 != f || !T.active || above > 1 || (above == 1 && top != &SCENE_DIALOG)) { hk_drop(); return 0; }
+    T.hk.frame = f;
+    T.hk.above = (uint8_t)above;
+    if (above) T.hk.core_dirty = 1;                       /* the box draws on the panel's rows */
+    if (plat_draw_skipped()) { T.hk.keep = 1; return 1; }   /* nothing is drawn on a skipped tick */
+    if (ui_toast_pending() || tip_active() || !HK_ON) { hk_drop(); return 0; }
+#if DOOMO_POINTER
+    if (input_pointer(NULL, NULL)) { hk_drop(); return 0; }      /* the arrow moves over the picture */
+#endif
+    py = layout(NULL);
+    if ((above && !T.hk.band) || (!T.hk.band && hk_csig(py) != T.hk.csig)) { hk_drop(); return 0; }
+    if (T.hk.resettle || !plat_hold_frame(4)) {           /* a push or pop of the box released the hold: hold the picture just shown again */
+        if (!plat_hold_frame(2)) { hk_drop(); return 0; }
+        T.hk.resettle = 0;
+    }
+    if (T.hk.band && !plat_hold_band(PLAT_BAND_RESTORE, &T.hk.b)) { hk_drop(); return 0; }
+    T.hk.keep = 1;
+    return 1;
+}
+
+/* a full frame has been drawn (strip, panel): keep it */
+static void hk_save(int py)
+{
+    int cx0, cy0, cx1, cy1, reach, top, card = hk_card_on(py);
+    PlatBand b;
+    const DoomoScene *above = scene_drawn_above();
+    memset(&T.hk, 0, sizeof T.hk);
+    if (!HK_ON || plat_draw_skipped() || ui_toast_pending() || tip_active() ||
+        (above && above != &SCENE_DIALOG)) return;
+    reach = ui_dialog_reach(&cx0, &cy0, &cx1, &cy1);
+    b.y_need = (int16_t)DOOMO_MIN(reach, py);
+    b.y_want = (int16_t)DOOMO_MAX(py - 14, 0);            /* the card's rows too when the arena has room */
+    if (b.y_want > b.y_need) b.y_want = b.y_need;
+    b.cx0 = (int16_t)cx0; b.cy0 = (int16_t)cy0; b.cx1 = (int16_t)cx1; b.cy1 = (int16_t)cy1;
+    top = plat_hold_band(PLAT_BAND_SAVE, &b);
+    if (top >= 0 && (top <= py - 14 || py - 14 < 26)) {   /* the band covers the card's rows: the box and the card come and go on it */
+        T.hk.band = 1;
+        T.hk.b = b;
+    } else if (top >= 0) {
+        plat_hold_band(PLAT_BAND_DROP, NULL);             /* it does not reach the card: no band, the card's state is in the signature */
+    }
+    T.hk.st = 1;
+    T.hk.ssig = hk_ssig();
+    T.hk.pkey = hk_pkey(py);
+    T.hk.csig = hk_csig(py);
+    T.hk.frame = doomo_frame_count();
+    T.hk.above = (uint8_t)(above != NULL);
+    T.hk.core_dirty = 0;
+    (void)card;
+}
+
+/* the frame is kept: only what changed is drawn, on top of itself */
+static void hk_draw(int py)
+{
+    int changed = 0;
+    uint32_t k;
+    T.hk.keep = 0;
+    if (plat_draw_skipped()) return;
+    ui_glint_hold(1);
+    k = hk_ssig();
+    if (k != T.hk.ssig) {
+        ui_shadow_kept(0, 0, plat_screen_w(), 24);
+        draw_strip();
+        T.hk.ssig = k;
+        changed = 1;
+    }
+    k = hk_pkey(py);
+    if (k != T.hk.pkey || (!T.hk.above && T.hk.core_dirty)) {   /* the cursor moved, or the box that drew in the panel is gone */
+        ui_shadow_kept(0, py, plat_screen_w(), plat_screen_h() - py);
+        draw_panel(py);
+        if (T.hk.band) plat_hold_band(PLAT_BAND_SAVE, &T.hk.b);   /* the band is the new panel */
+        T.hk.pkey = k;
+        T.hk.core_dirty = 0;
+        changed = 1;
+    }
+    ui_glint_hold(0);
+    ui_shadow_kept(0, 0, 0, 0);
+    if (changed) {
+#ifdef DOOMO_PLATFORM_GBA
+        T.hk.resettle = 1;                                    /* the other page gets the picture on the next tick */
+#else
+        plat_hold_frame(2);                                   /* native: the held copy is taken now */
+#endif
+    }
+    if (hk_card_on(py)) talk_card(py - 14);
+}
+#endif /* HK_CODE */
+
+static void talk_draw(void)
+{
+    int py;
+#if HK_CODE
+    if (T.hk.keep) { hk_draw(layout(NULL)); return; }
+#endif
+    ui_glint_hold(1);
+    draw_strip();
+    py = layout(NULL);
+    draw_panel(py);
+#if HK_CODE
+    hk_save(py);                                          /* before the card: the band's copy has none */
+#endif
     if (!T.busy && py - 14 >= 26) talk_card(py - 14);   /* not under an open dialogue box (A advances the line) */
 #if DOOMO_POINTER
     pointer_draw();
