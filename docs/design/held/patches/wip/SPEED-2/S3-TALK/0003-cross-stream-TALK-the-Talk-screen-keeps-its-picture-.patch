diff --git a/core/tests/test_talk_hold.c b/core/tests/test_talk_hold.c
new file mode 100644
index 0000000..3398508
--- /dev/null
+++ b/core/tests/test_talk_hold.c
@@ -0,0 +1,145 @@
+/* test_talk_hold.c - S3-TALK: the kept Talk picture (core/src/talk_scene.c hk_*, scene.h scene_keep_below).
+ *
+ * Talk keeps its picture once a full frame has been drawn: the scenes below it are not drawn again, the panel and
+ * the people strip are drawn again on top of themselves only when they change, and the box of a line draws on a
+ * kept band (plat_hold_band) like the story overworld's. The same long Talk run (opener, a cursor that moves, pages,
+ * quick replies, the boxes of every answer, the goodbye and its toast) is played twice over a STILL backdrop, with the
+ * kept picture off (every frame full, as before) and on, and the screens are compared:
+ *   - every frame of the run is the same picture, pixel for pixel (the backdrop does not move, so a kept frame has
+ *     nothing to differ in: the one pixel change of the feature, a moving backdrop standing still, is not in this test);
+ *   - with it on, the backdrop is drawn on a small part of the frames (the keep works), and the band is put back on
+ *     many of them (the box of a line draws on a kept picture too);
+ *   - the same run twice with it off is the same picture (the control: the comparison says something).
+ * At 240x160 and 320x240. S3DBGF=N dumps frame N of both runs to /tmp/s3_dbg_{on,off}.raw (a debugging aid). */
+#define DOOMO_TALK_DEBUG 1
+#include <stdlib.h>
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/talk.h"
+#include "doomo/lang.h"
+#include "doomo/town.h"
+#include "doomo/ui.h"
+#include "doomo/scenes.h"
+#include "doomo/plat_ext.h"
+#include "doomo/portrait.h"
+
+#define ID_NANA 1
+#define MAXF 2600
+
+static uint8_t dbgfb[2][NAT_MAX_W * NAT_MAX_H];
+static int dbgf = -1, dbgn;
+static uint32_t still_draws;
+static void still_draw(void)
+{
+    int w = plat_screen_w(), h = plat_screen_h(), i;
+    still_draws++;
+    plat_clear(PAL_UI_PINK);
+    for (i = 0; i < 12; i++) plat_rect(i * 21 % w, i * 13 % h, 30, 14, (uint8_t)(40 + i * 7));
+    plat_checker(0, h / 2, w, 6, PAL_WHITE);
+}
+static const DoomoScene STILL = { "STILL", NULL, NULL, NULL, still_draw, 0 };
+
+static void frame(uint32_t b) { plat_begin_frame(); doomo_frame(b); plat_end_frame(); }
+
+static void set_res(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+}
+
+static uint32_t hash_fb(void)
+{
+    int n = plat_screen_w() * plat_screen_h(), i;
+    uint32_t h = 2166136261u;
+    for (i = 0; i < n; i++) { h ^= nat_fb[i]; h *= 16777619u; }
+    return h;
+}
+
+/* the pad: a few presses a second, by what the screen shows (the same for both runs: it reads the same state) */
+static uint32_t pad(int f, int bye)
+{
+    TalkSceneDebug d;
+    if (!talk_scene_debug(&d)) return 0;
+    if (bye) return (f % 12 == 0) ? (d.busy ? BTN_A : BTN_B) : 0;
+    if (d.busy) return f % 37 == 0 ? BTN_A : 0;
+    if (strcmp(d.page, "main") != 0) return f % 23 == 5 ? BTN_B : (f % 7 == 3 ? BTN_DOWN : 0);
+    if (f % 61 == 40) return BTN_A;                  /* a quick reply, a category, Options... */
+    if (f % 29 == 5) return BTN_DOWN;
+    if (f % 83 == 20) return BTN_UP;
+    return 0;
+}
+
+static int run(int hold, int w, int h, uint32_t *hs, uint32_t *draws, uint32_t *restores)
+{
+    int f, n = 0;
+    uint32_t r0;
+    set_res(w, h);
+    doomo_init();                                        /* the frame clock starts at 0: the bobs, blinks and idle chatter follow it */
+    test_reset();
+    town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE);
+    talk_mem_reset();
+    talk_outcome_reset();
+    portrait_cache_reset();
+    talk_scene_hold(hold);
+    still_draws = 0;
+    r0 = nat_band_restores;
+    scene_set(&STILL, 0);
+    frame(0); frame(0);
+    if (!home_talk_enter(ID_NANA)) return -1;
+    for (f = 0; f < MAXF; f++) {
+        frame(pad(f, f > MAXF - 900));
+        hs[n++] = hash_fb();
+        if (f == dbgf) memcpy(dbgfb[dbgn & 1], nat_fb, (size_t)(w * h));
+        if (f > MAXF - 120 && scene_top() == &STILL) break;
+    }
+    if (dbgf >= 0) dbgn++;
+    *draws = still_draws;
+    *restores = nat_band_restores - r0;
+    talk_scene_hold(0);
+    return n;
+}
+
+static void dump(int w, int h)
+{
+    int x, y, n0 = 0, x0 = 9999, x1 = 0, y0 = 9999, y1 = 0;
+    FILE *fp;
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+            if (dbgfb[0][y * w + x] != dbgfb[1][y * w + x]) { n0++; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
+    fprintf(stderr, "frame %d: %d pixels differ, box %d,%d..%d,%d\n", dbgf, n0, x0, y0, x1, y1);
+    fp = fopen("/tmp/s3_dbg_on.raw", "wb");
+    if (fp) { fwrite(dbgfb[0], 1, (size_t)(w * h), fp); fclose(fp); }
+    fp = fopen("/tmp/s3_dbg_off.raw", "wb");
+    if (fp) { fwrite(dbgfb[1], 1, (size_t)(w * h), fp); fclose(fp); }
+}
+
+static void same_run(int w, int h)
+{
+    static uint32_t a[MAXF], b[MAXF], c[MAXF];
+    uint32_t da, db, dc, ra, rb, rc;
+    int na, nb, nc, i, first = -1, bad = 0;
+    if (getenv("S3DBGF")) dbgf = atoi(getenv("S3DBGF"));
+    (void)run(0, w, h, c, &dc, &rc);                     /* a warm-up: the first run of a process starts from other statics */
+    dbgn = 0;
+    na = run(0, w, h, a, &da, &ra);
+    nb = run(0, w, h, b, &db, &rb);                      /* the control: the same run twice is the same picture */
+    CHECK(na > 600 && na == nb);
+    for (i = 0; i < na && i < nb; i++) if (a[i] != b[i]) { if (first < 0) first = i; bad++; }
+    CHECK_MSG(bad == 0, "%dx%d: the run is not repeatable (%d frames differ, the first is %d): the test says nothing", w, h, bad, first);
+    first = -1; bad = 0;
+    nc = run(1, w, h, c, &dc, &rc);
+    if (dbgf >= 0) dump(w, h);
+    CHECK_EQ(na, nc);
+    for (i = 0; i < na && i < nc; i++)
+        if (a[i] != c[i]) { if (first < 0) first = i; bad++; }
+    CHECK_MSG(bad == 0, "%dx%d: %d of %d frames differ from the full run, the first is frame %d", w, h, bad, na, first);
+    CHECK_MSG(dc * 3 < da, "%dx%d: the backdrop was drawn %u times kept, %u full: the keep did not engage", w, h, (unsigned)dc, (unsigned)da);
+    CHECK_MSG(rc > 40 && ra == 0, "%dx%d: the band was put back %u times (full run %u)", w, h, (unsigned)rc, (unsigned)ra);
+    (void)db; (void)rb;
+}
+
+TEST(talk_kept_picture_is_the_full_picture_240x160) { same_run(240, 160); }
+TEST(talk_kept_picture_is_the_full_picture_320x240) { same_run(320, 240); }
