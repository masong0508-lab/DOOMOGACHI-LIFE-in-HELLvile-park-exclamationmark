+/* the confetti: the closed form of credits.c, 30 pieces, at both screens, over many frames, and far past a 16-bit count */
+TEST(s3_confetti_positions_match_the_formula)
+{
+    static const int dims[3][2] = { { 240, 160 }, { 320, 240 }, { 240, 200 } };
+    static const uint32_t ts[] = { 0u, 1u, 2u, 3u, 59u, 239u, 240u, 241u, 65535u, 65536u, 1000003u, 4000000u };
+    int16_t xs[30], ys[30];
+    int d, i;
+    uint32_t t, n;
+    for (d = 0; d < 3; d++) {
+        const uint32_t w = (uint32_t)dims[d][0], h = (uint32_t)dims[d][1];
+        for (n = 0; n < 1500u + (uint32_t)(sizeof(ts) / sizeof(ts[0])); n++) {
+            t = n < 1500u ? n : ts[n - 1500u];
+            cr_confetti_xy(t, (int)w, (int)h, xs, ys);
+            for (i = 0; i < 30; i++) {
+                const uint32_t x = ((uint32_t)i * 53u + t * (1u + (uint32_t)i % 3u)) % w;
+                const uint32_t y = ((uint32_t)i * 29u + t * (2u + (uint32_t)i % 4u)) % h;
+                if (xs[i] != (int16_t)x || ys[i] != (int16_t)y) {
+                    CHECK_MSG(0, "%ux%u t %u piece %d: (%d,%d) wanted (%u,%u)", w, h, t, i, xs[i], ys[i], x, y);
+                    return;
+                }
+            }
+        }
+    }
+}
