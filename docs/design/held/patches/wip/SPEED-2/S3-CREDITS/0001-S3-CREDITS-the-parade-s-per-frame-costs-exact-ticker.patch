+/* ---- S3-CREDITS ------------------------------------------------------------------------------------------------ */
+/* a body lookup asked look_run_hash for every marcher on every frame: with no deep run for the id it is all zeros
+ * (a town nobody customised), which the lookup now returns without resolving and hashing 21 fields; with a run it is
+ * still the hash of what the run resolves to, and a change of the run changes it. */
+TEST(s3_run_hash_without_a_run_is_zero_and_with_one_is_the_walk)
+{
+    static const uint8_t run[] = { DF_LASH, 2, DF_MOLE, 1 };
+    DoomoDeep d;
+    int id = 37, chibi;
+    look_pool_drop(id);
+    for (chibi = 0; chibi < 2; chibi++) CHECK_EQ(look_run_hash(id, chibi), 0u);
+    CHECK(look_pool_put(id, RUN_DEEP, run, (int)sizeof(run)));
+    for (chibi = 0; chibi < 2; chibi++) {
+        look_resolve_mask(NULL, id, chibi ? LV_CHIBI : LV_ALL, &d);
+        CHECK_EQ(look_run_hash(id, chibi), deep_hash(&d, chibi));
+    }
+    CHECK(look_run_hash(id, 0) != 0u);                      /* the whole look sees the run */
+    look_pool_drop(id);
+    CHECK_EQ(look_run_hash(id, 0), 0u);                     /* and not once it is gone */
+    CHECK_EQ(look_run_hash(-1, 1), 0u);                     /* ids outside the pool's range */
+    CHECK_EQ(look_run_hash(5000, 1), 0u);
+}
