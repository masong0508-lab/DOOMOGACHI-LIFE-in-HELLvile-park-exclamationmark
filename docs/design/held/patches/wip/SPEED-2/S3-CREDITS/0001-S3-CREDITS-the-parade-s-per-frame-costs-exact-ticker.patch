+/* S3-CREDITS: where the 30 confetti pieces are at drawn frame t on a w x h screen: the x of piece i is
+ * (i * 53 + t * (1 + i % 3)) % w and its y (i * 29 + t * (2 + i % 4)) % h. The ARM7 has no divide (each `%` by a
+ * variable is a library call of ~100 cycles: 60 a frame, ~0.7 ms), so: one remainder of t per axis, its small
+ * multiples by subtraction, and i * 53 % w and i * 29 % h kept running (w >= 53 and h >= 29). Same numbers
+ * (test_portrait_s27.c checks them against the formula). */
+void cr_confetti_xy(uint32_t t, int w, int h, int16_t *xs, int16_t *ys)
+{
+    uint32_t mx[3], my[4], bx = 0, by = 0, k, uw = (uint32_t)w, uh = (uint32_t)h;
+    int i;
+    mx[0] = t % uw;
+    my[0] = t % uh;                       /* my[k] = t * (k + 2) % h: k = 0 holds t % h, the base the others grow from */
+    for (k = 1; k < 3; k++) { mx[k] = mx[k - 1] + mx[0]; if (mx[k] >= uw) mx[k] -= uw; }
+    {
+        uint32_t t1 = my[0], t2, t3, t4, t5;
+        t2 = t1 + t1; if (t2 >= uh) t2 -= uh;
+        t3 = t2 + t1; if (t3 >= uh) t3 -= uh;
+        t4 = t3 + t1; if (t4 >= uh) t4 -= uh;
+        t5 = t4 + t1; if (t5 >= uh) t5 -= uh;
+        my[0] = t2; my[1] = t3; my[2] = t4; my[3] = t5;
+    }
+    for (i = 0, k = 0; i < CR_CONFETTI; i++) {            /* k = i % 3 (a division call each on the ARM7) */
+        uint32_t x = bx + mx[k], y = by + my[i & 3];
+        if (x >= uw) x -= uw;
+        if (y >= uh) y -= uh;
+        xs[i] = (int16_t)x;
+        ys[i] = (int16_t)y;
+        bx += 53; if (bx >= uw) bx -= uw;
+        by += 29; if (by >= uh) by -= uh;
+        if (++k == 3) k = 0;
+    }
+}
