+/* S3-CREDITS: where the nf (<= 12) roadside fans stand and how high they jump at parade tick ct on a screen sw wide:
+ * x = camx - sw * 2 + 40 + i * (sw * 4 - 80) / (nf - 1) and jump = 3 * (the zig-zag of (ct + 9 i) / 3 % 12). The ARM7
+ * has no divide (~100 cycles a call): two a fan a frame become one for ct and a running quotient and remainder of
+ * i * step. Same numbers (test_portrait_s27.c checks them against the formula). */
+void cr_fans_xj(uint32_t ct, int sw, int nf, int32_t camx, int32_t *xs, int *js)
+{
+    int q12 = (int)((ct / 3) % 12), step = sw * 4 - 80, d = nf - 1;
+    int xq = 0, xr = 0, sq = step / d, sr = step % d, i;
+    for (i = 0; i < nf; i++, xq += sq, xr += sr) {
+        int jump = q12 + 3 * i;
+        if (xr >= d) { xr -= d; xq++; }
+        xs[i] = camx - sw * 2 + 40 + xq;
+        while (jump >= 12) jump -= 12;
+        js[i] = jump < 6 ? jump * 3 : (12 - jump) * 3;
+    }
+}
