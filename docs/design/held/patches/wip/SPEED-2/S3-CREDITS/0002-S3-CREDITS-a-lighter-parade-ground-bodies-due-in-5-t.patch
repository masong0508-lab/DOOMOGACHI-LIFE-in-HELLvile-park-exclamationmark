+        const int lite = v->lite;                 /* S3-CREDITS: flat ground, see DoomoOverworldView.lite */
+        uint32_t gcol = 0;                        /* lite: the colour of the last ground cell, as gkey's */
         gm.t = 0;
         for (ty = ty0; ty <= ty1; ty++) {
             const int py = owf.oy + ty * TILE - owf.scrolly;
             const int ya = DOOMO_MAX(py, owf.oy), yb = DOOMO_MIN(py + TILE, owf.oy + owf.oh);
             const DoomoCell *row = (unsigned)ty < (unsigned)m->h ? m->cells + ty * m->w : 0;
             uint32_t mask = 0;
-            int k, px;
+            int k, px, rx0 = 0, rx1 = 0;              /* lite: the run of equal flat cells being filled */
+            uint32_t rcol = 0;
             rmask[ty - ty0] = 0;
             if (py - 16 >= owf.oy + owf.oh || py + TILE <= owf.oy) continue;
             for (k = 0, px = pxa; k < nt; k++, px += TILE) {
                 const int tx = txa + k;
-                const DoomoCell *c = row && (unsigned)tx < (unsigned)m->w ? row + tx
-                                                                         : map_cell_safe(m, tx, ty);
+                const int in = row && (unsigned)tx < (unsigned)m->w;
+                const DoomoCell *c = in ? row + tx : map_cell_safe(m, tx, ty);
+                const uint32_t key = ow_cell_key(c, cal && in);
                 const uint8_t *t;
                 int lvl, x0, x1;
-                if (c->wall || c->floor_h > 0) { mask |= 1u << k; continue; }
-                if (ya >= yb) continue;
-                if (gt && c->floor_tex == g_tex && c->light == g_light && c->floor_h == g_fh) {
-                    t = gt;                       /* same texture, light and height: the same lit tile */
+                if (key == gkey) {
+                    t = gt;                       /* the same texture, light and height, and open ground: the same lit tile */
                 } else {
+                    if (c->wall || c->floor_h > 0) { mask |= 1u << k; continue; }
+                    if (ya >= yb) continue;
                     lvl = cell_level(c);
                     if (c->floor_h < 0) lvl -= 3;
-                    t = tile_src(lit_memo(&gm, c->floor_tex, lvl, 0));
-                    gt = t; g_tex = c->floor_tex; g_light = c->light; g_fh = c->floor_h;
+                    if (lite) {
