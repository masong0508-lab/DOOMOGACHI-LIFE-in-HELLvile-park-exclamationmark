+/* S3-CREDITS: what the ground pass compares between neighbouring cells: the wall, the floor texture, the light and the
+ * floor height in one word (the ceiling is not read), from the cell's two words when its address is aligned (`al`) */
+static inline uint32_t ow_cell_key(const DoomoCell *c, int al)
+{
+    if (al) {
+        const uint32_t *w = (const uint32_t *)(const void *)c;
+        return (w[0] & 0xFF00FFFFu) | ((w[1] & 0xFF00u) << 8);
+    }
+    return (uint32_t)c->wall | (uint32_t)c->floor_tex << 8 | (uint32_t)c->light << 16 | (uint32_t)(uint8_t)c->floor_h << 24;
+}
+
 /* tile at screen (px, py) lifted by `lift` pixels, clipped to the view */
 static void draw_tile(int px, int py, int tex, int lvl, int lift, OwMemo *mo)
 {
@@ -648,40 +660,59 @@ void plat_overworld(const DoomoOverworldView *v)
     {
