diff --git a/core/tests/test_cutbk.c b/core/tests/test_cutbk.c
new file mode 100644
index 0000000..3a60859
--- /dev/null
+++ b/core/tests/test_cutbk.c
@@ -0,0 +1,158 @@
+/* test_cutbk.c - (S3-7) the cutscene vignettes over their kept stills and puff stamps (cutscene.c, backdrop.h). The
+ * native stage (nat_stage_on) keeps the pictures the GBA bakes into its ROM and emulates its two Mode 4 pages: a
+ * vignette drawn with it must be the picture it draws without it, frame for frame (the one row the sky's band seam
+ * leaves to the buffer, h / 3, is not compared: with the stage it is the dither the seam is meant to be, without it
+ * whatever the page held). Every picture a vignette asks for must be in the lists the baker writes. */
+#include "test.h"
+#include "doomo/backdrop.h"
+#include "doomo/textures.h"
+
+#define CUTF 1300
+#define ERUPT_EXACT 170         /* the eruption's cloud passes 50 px at frame ~172 (shot 2 begins at 150, grows 1 px per 2 ticks from 40) */
+
+static void frame(uint32_t b) { plat_begin_frame(); doomo_frame(b); plat_end_frame(); }
+
+static void set_res(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+}
+
+/* the frame without the sky's seam row; `low` = only the rows from the middle of the screen down (the Wall's rows: a kept cloud never reaches them) */
+static uint32_t fb_hash(int low)
+{
+    uint32_t h = 2166136261u;
+    int x, y;
+    for (y = low ? nat_h / 2 : 0; y < nat_h; y++) {
+        if (y == nat_h / 3) continue;                         /* the sky's seam row */
+        for (x = 0; x < nat_w; x++) h = (h ^ nat_fb[y * nat_w + x]) * 16777619u;
+    }
+    return h;
+}
+
+static int kept_n, over_n;
+
+/* a cutscene played to its end: a vignette gets A every 150 frames (a shot moves on after 12), a card runs its 260 */
+static int run(int cut, int n, uint32_t *out, uint32_t *low, int stage)
+{
+    int f, live = 0;
+    nat_stage_on = stage;
+    nat_stage_buffers = 2;
+    nat_stage_reset();
+    test_reset();
+    doomo_init();
+    scene_set(&SCENE_TITLE, 0);
+    frame(0);
+    scene_push(&SCENE_CUTSCENE, cut);
+    kept_n = over_n = 0;
+    for (f = 0; f < n; f++) {
+        int on = scene_top() == &SCENE_CUTSCENE;
+        frame(on && cut > CUT_CHAPTER4 && f % 150 == 149 ? BTN_A : 0);
+        out[f] = on ? fb_hash(0) : 0;                         /* (what comes after it is another scene's) */
+        low[f] = on ? fb_hash(1) : 0;
+        if (on) { live++; if (nat_stage_kept()) kept_n++; }
+    }
+    over_n = nat_stage_stamps();
+    nat_stage_on = 0;
+    return live;
+}
+
+/* exact_to: the frames from there on may differ above the Wall (the eruption's cloud past PUFF_STAMP_MAX is a kept
+ * picture that does not breathe), never below it */
+static int compare(int cut, int w, int h, int need_kept, int need_stamps, int exact_to)
+{
+    static uint32_t off[CUTF], on[CUTF], loff[CUTF], lon[CUTF];
+    int f, live;
+    set_res(w, h);
+    live = run(cut, CUTF, off, loff, 0);
+    run(cut, CUTF, on, lon, 1);
+    for (f = 0; f < CUTF; f++)
+        if (f < exact_to ? off[f] != on[f] : loff[f] != lon[f]) {
+            static uint8_t a[NAT_MAX_W * NAT_MAX_H];
+            char m[300], path[600];
+            int i, x0 = w, y0 = h, x1 = -1, y1 = -1, nd = 0;
+            run(cut, f + 1, off, loff, 0);
+            memcpy(a, nat_fb, (size_t)(w * h));
+            snprintf(path, sizeof(path), "%s/cutbk_%d_off.png", test_tmp_dir, cut);
+            nat_png_write(path, nat_fb, w, h, 2);
+            run(cut, f + 1, on, lon, 1);
+            snprintf(path, sizeof(path), "%s/cutbk_%d_on.png", test_tmp_dir, cut);
+            nat_png_write(path, nat_fb, w, h, 2);
+            for (i = 0; i < w * h; i++)
+                if (a[i] != nat_fb[i] && i / w != h / 3) {
+                    nd++;
+                    x0 = DOOMO_MIN(x0, i % w); x1 = DOOMO_MAX(x1, i % w);
+                    y0 = DOOMO_MIN(y0, i / w); y1 = DOOMO_MAX(y1, i / w);
+                }
+            snprintf(m, sizeof(m), "cutscene %d: frame %d differs with the stage on (%d px in %d,%d..%d,%d)",
+                     cut, f, nd, x0, y0, x1, y1);
+            test_fail(__FILE__, __LINE__, m);
+            return 0;
+        }
+    run(cut, CUTF, on, lon, 1);
+    printf("      cutscene %d: %d frames on stage (%d of them over a kept picture, %d stamps)\n", cut, live, kept_n, over_n);
+    if (live < 250 || kept_n < need_kept * live / 100 || over_n < need_stamps) {
+        char m[200];
+        snprintf(m, sizeof(m), "cutscene %d: the stage kept too little (%d of %d frames, %d stamps)", cut, kept_n, live, over_n);
+        test_fail(__FILE__, __LINE__, m);
+        return 0;
+    }
+    return 1;
+}
+
+/* the cutscenes of speed2_cutscene.txt: card 2's clouds, the home, fog, eruption and Vapula vignettes */
+TEST(cutscene_kept_stills_and_puffs_are_pixel_identical)
+{
+    int ok;
+    ok = compare(1, 240, 160, 0, 500, CUTF);          /* chapter card 2: the five clouds are stamps */
+    ok = ok && compare(10, 240, 160, 90, 0, CUTF);    /* home */
+    ok = ok && compare(5, 240, 160, 90, 500, CUTF);   /* fog */
+    ok = ok && compare(6, 240, 160, 90, 100, ERUPT_EXACT);   /* eruption */
+    ok = ok && compare(7, 240, 160, 90, 100, CUTF);   /* Vapula */
+    set_res(240, 160);
+    CHECK(ok);
+}
+
+/* the stage at another screen size (the native runner keeps whatever it is asked for; the GBA bakes 240x160 only) */
+TEST(cutscene_stage_at_320x240_is_pixel_identical)
+{
+    int ok = compare(5, 320, 240, 0, 0, CUTF) && compare(6, 320, 240, 0, 0, ERUPT_EXACT);
+    set_res(240, 160);
+    CHECK(ok);
+}
+
+/* every picture a vignette asks for is in the baker's lists; the stills' textures stand still (the bake draws them
+ * at one tick); the puff stamps fit the screen (the baker refuses one that touches an edge) */
+TEST(cutscene_pictures_asked_for_are_baked)
+{
+    static uint32_t baked[8192], asked[8192], out[CUTF];
+    static const uint8_t cuts[] = { 1, 5, 6, 7, 10 };
+    int nb = 0, na, i, j, k, fam, kept = 0, puffs = 0;
+    CHECK(!texture_is_animated(TEX_WALLPAPER_HEARTS) && !texture_is_animated(TEX_WOOD_FLOOR) &&
+          !texture_is_animated(TEX_RUST_METAL));
+    for (fam = 0; fam < backdrop_family_count(); fam++) {
+        const DoomoBackdrop *f = backdrop_family(fam);
+        int n = f->keys(asked, 8192);
+        CHECK(n >= 0 && nb + n <= 8192);
+        for (j = 0; j < n; j++) baked[nb++] = (uint32_t)f->id << 24 | (asked[j] & 0xFFFFFFu);
+    }
+    for (j = 1; j < nb; j++)
+        for (k = 0; k < j; k++) CHECK_MSG(baked[j] != baked[k], "key 0x%x is listed twice", (unsigned)baked[j]);
+    set_res(240, 160);
+    for (i = 0; i < (int)sizeof(cuts); i++) {
+        run(cuts[i], CUTF, out, out, 1);
+        na = nat_stage_pics(asked, 8192);
+        CHECK(na > 0 && na <= 8192);
+        for (j = 0; j < na; j++) {
+            for (k = 0; k < nb && baked[k] != asked[j]; k++) {}
+            CHECK_MSG(k < nb, "cutscene %d: picture 0x%x is not baked", cuts[i], (unsigned)asked[j]);
+            if ((asked[j] >> 24) == DOOMO_BACKDROP_CUTSCENE) kept++;
+            if ((asked[j] >> 24) == DOOMO_BACKDROP_CUTSCENE_PUFF) puffs++;
+        }
+    }
+    CHECK(kept >= 8 && puffs >= 20);
+    nat_stage_reset();
+}
