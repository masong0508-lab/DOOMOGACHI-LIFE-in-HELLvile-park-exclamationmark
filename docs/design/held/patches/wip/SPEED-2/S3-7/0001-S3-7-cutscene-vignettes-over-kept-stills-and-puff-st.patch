+/* the sky's seam row, for the baker only: sky_bands leaves half of the row h / 3 to what the buffer held (scene-entry
+ * garbage on the GBA); a kept sky has it painted with the top colour first, the dither the band seam is meant to be */
+static void bk_seam(uint8_t top)
+{
+    plat_rect(0, plat_screen_h() / 3, plat_screen_w(), 1, top);
+}
+
+#if !defined(DOOMO_PLATFORM_PS1)
+/* ---- (S3-7) the kept stills and the puff stamps (GBA: baked into the ROM, backdrop.h) ------------------------------
+ * A vignette's still backdrop (sky, wall, ground, wallpaper) is a picture the platform keeps: one DMA copy instead of
+ * ~10-30 ms of rects and tile blits (cs_keep / cs_keep_band; they return 0 where nothing is kept and the scene draws
+ * the same thing itself). A puff cloud is a pure function of (r, ramp, bright, breath), so its picture is kept too:
+ * a stamp, drawn as one image where the cloud's 20 circles were ~4-8 ms (puff_cloud). */
+#define PUFF_STAMP_MAX 50                 /* a bigger cloud does not fit the screen centred: drawn live (or a kept picture) */
+enum { CK_HOME = 1, CK_FOG, CK_ERUPT_SKY, CK_ERUPT_CLOUD, CK_ERUPT_BAND, CK_VAPULA_SKY, CK_VAPULA_BIG };
+#define CK(kind, a, b) ((uint32_t)(kind) << 16 | (uint32_t)(a) << 8 | (uint32_t)(b))
+
+static void draw_wall_row(int y, int h, int sw);
+static void still_fog(int street);
+static void still_vapula(int late);
+static void vapula_big(int frame, int scale, int sx);
+static void still_home(void);
+static void erupt_cloud(int phase, int shake, int r, uint32_t t, int bake);
+static void erupt_sky(int v, int seam);
+static void still_erupt_band(int flesh, int shake);
+
+/* the Gate's cough: the cloud's size (it swells for 60 ticks of each shot) and the shake of the last two shots */
+static int erupt_r(int phase, uint32_t pt) { return 18 + phase * 22 + (int)DOOMO_MIN(pt, 60u) / 2; }
+static int erupt_shake(int phase, uint32_t t) { return phase >= 2 ? (int)((t * 7) % 7) - 3 : 0; }
+/* Vapula's pose: the frame, the scale of the picture and the wheeze's shudder (panel 0) */
+static void vapula_pose(int panel, uint32_t pt, uint32_t t, int *frame, int *scale, int *sx)
+{
+    *scale = plat_screen_h() >= 200 ? 4 : 3;
+    *frame = panel == 0 ? DFRAME_PAIN : panel == 1 ? DFRAME_DEATH0 + (int)DOOMO_MIN(pt / 12, 3u) : DFRAME_DEATH3;
+    if (panel == 1) *scale = DOOMO_MAX(*scale - (int)DOOMO_MIN(pt / 24, 2u), 1);       /* the Duke lets his air out */
+    *sx = panel == 0 ? ((int)(t * 3) % 5) - 2 : 0;
+}
+
+/* what the baker draws for a key: a key is kind << 16 | a << 8 | b */
+static void bk_draw(uint32_t key)
+{
+    int a = (int)(key >> 8 & 0xFF), b = (int)(key & 0xFF);
+    switch (key >> 16) {
+    case CK_HOME: still_home(); break;
+    case CK_FOG: still_fog(1); break;
+    case CK_ERUPT_SKY: erupt_sky(a, 1); break;
+    case CK_ERUPT_CLOUD:                                    /* sky, the cloud and its grin, breathless (a = phase | shake + 3 << 2) */
+        erupt_sky(DOOMO_MIN(a & 3, 2), 1);
+        erupt_cloud(a & 3, (a >> 2) - 3, b, 0, 1);
+        break;
+    case CK_ERUPT_BAND: still_erupt_band(a, b - 3); break;
+    case CK_VAPULA_SKY: bk_seam(PAL_RAMP(RAMP_SKY, 6)); still_vapula(1); break;
+    case CK_VAPULA_BIG: bk_seam(PAL_RAMP(RAMP_VAPE, 1)); still_vapula(0); vapula_big(a, b >> 4, (b & 15) - 2); break;
+    default: break;
+    }
+}
+static int bk_keys(uint32_t *out, int cap)
+{
+    int n = 0, i, ph, last = -1;
+#define BK(k, a, b) do { if (n < cap) out[n] = CK(k, a, b); n++; } while (0)
+    BK(CK_HOME, 0, 0);
+    BK(CK_FOG, 0, 0);
+    BK(CK_ERUPT_SKY, 0, 0);                                   /* shots 1 and 2, while the cloud is small (puff stamps) */
+    BK(CK_ERUPT_SKY, 1, 0);
+    for (ph = 1; ph < 4; ph++)                                /* the swelling cloud over PUFF_STAMP_MAX, one picture a size */
+        for (i = 0; i <= 60; i += 2) {
+            int r = erupt_r(ph, (uint32_t)i);
+            if (r > PUFF_STAMP_MAX) BK(CK_ERUPT_CLOUD, ph | (erupt_shake(ph, 0) + 3) << 2, r);
+        }
+    BK(CK_ERUPT_BAND, 0, erupt_shake(0, 0) + 3);              /* the Wall over the grass */
+    BK(CK_ERUPT_BAND, 1, erupt_shake(2, 0) + 3);              /* over the flesh-coloured ground, shaken */
+    BK(CK_VAPULA_SKY, 0, 0);
+    for (i = 0; i < 5; i++) {                                 /* the wheezing demon, five shudders */
+        int f, sc, sx;
+        vapula_pose(0, 0, 0, &f, &sc, &sx);
+        BK(CK_VAPULA_BIG, f, sc << 4 | i);
+    }
+    for (i = 0; i < 120; i++) {                               /* the Duke lets his air out: a few poses, in order */
+        int f, sc, sx, k;
+        vapula_pose(1, (uint32_t)i, 0, &f, &sc, &sx);
+        k = f << 8 | sc;
+        if (k != last) BK(CK_VAPULA_BIG, f, sc << 4 | (sx + 2));
+        last = k;
+    }
+#undef BK
+    return n;
+}
+static int bk_part(uint32_t key, int16_t out[2])
+{
+    int a = (int)(key >> 8 & 0xFF), b = (int)(key & 0xFF);
+    switch (key >> 16) {
+    case CK_ERUPT_CLOUD:                                    /* the rows above the Wall */
+        out[0] = 0;
+        out[1] = (int16_t)(plat_screen_h() / 2 + (a >> 2) - 3);
+        return BACKDROP_ROWS;
+    case CK_ERUPT_BAND:                                     /* the Wall and the ground below it */
+        out[0] = (int16_t)(plat_screen_h() / 2 + b - 3);
+        out[1] = (int16_t)plat_screen_h();
+        return BACKDROP_ROWS;
+    default: return BACKDROP_WHOLE;
+    }
+}
+const DoomoBackdrop cut_backdrop_family = { DOOMO_BACKDROP_CUTSCENE, bk_draw, bk_keys, bk_part };
+
+/* 1 when the kept picture of `key` is in the page: the whole screen, or (rows) the rows [y0, y1) of a band */
+static int cs_keep_rows(uint32_t key, int y0, int y1)
+{
+    PlatStageInfo info;
+    if (!plat_stage_begin(DOOMO_BACKDROP_CUTSCENE, key, bk_draw, &info)) return 0;
+    plat_stage_restore(0, y0, plat_screen_w(), y1 - y0);
+    return 1;
+}
+static int cs_keep(uint32_t key) { return cs_keep_rows(key, 0, plat_screen_h()); }
+
+/* the puff stamps: key = r | bright << 8 | (breath + 1) << 12 | ramp << 14. Only the clouds of the vignettes below
+ * (puff_wanted) are baked, and only up to PUFF_STAMP_MAX: a bigger cloud does not fit the screen centred (the baker
+ * refuses a stamp that touches an edge) and is drawn live. */
+static int puff_wanted(int ramp, int bright, int r)
+{
+    if (ramp != RAMP_VAPE || r < 6 || r > PUFF_STAMP_MAX) return 0;
+    if (bright == 4 || bright == 5 || bright == 6) {                /* cards, fog, Vapula */
+        if ((r - 14) % 5 == 0 && r >= 14 && r <= 24) return 1;      /* the fog's and card 2's 14 / 19 / 24 */
+    }
+    if (bright == 5 && r >= 6 && r <= 24) return 1;                  /* Vapula's puffs of vapour (6 + pt / 20) */
+    if (bright == 5 && r >= 18) return 1;                            /* the eruption's cloud, phases 0-1 */
+    if (bright == 4 && r >= 20 && r <= 35) return 1;                 /* its side puffs, phase 1 */
+    if (bright == 2 && r >= 31) return 1;                            /* phases 2-3 */
+    if (bright == 3 && r == 16) return 1;                            /* Vapula's wheezing sky */
+    return 0;
+}
+static uint32_t puff_key(int ramp, int bright, int r, int w)
+{
+    return (uint32_t)r | (uint32_t)bright << 8 | (uint32_t)(w + 1) << 12 | (uint32_t)ramp << 14;
+}
+static void puff_stamp_draw(uint32_t key)
+{
+    puff_draw(plat_screen_w() / 2, plat_screen_h() / 2, (int)(key & 0xFF), (int)(key >> 14) & 15,
+              (int)(key >> 8) & 15, (int)((key >> 12) & 3) - 1);
+}
+static int puff_keys(uint32_t *out, int cap)
+{
+    int n = 0, b, r, w;
+    for (b = 0; b < 8; b++)
+        for (r = 6; r <= PUFF_STAMP_MAX; r++) {
+            if (!puff_wanted(RAMP_VAPE, b, r)) continue;
+            for (w = -1; w <= 1; w++) {
+                if (n < cap) out[n] = puff_key(RAMP_VAPE, b, r, w);
+                n++;
+            }
+        }
+    return n;
+}
+static int puff_part(uint32_t key, int16_t out[2])
+{
+    (void)key;
+    out[0] = (int16_t)(plat_screen_w() / 2);
+    out[1] = (int16_t)(plat_screen_h() / 2);
+    return BACKDROP_STAMP;
+}
+const DoomoBackdrop cut_puff_family = { DOOMO_BACKDROP_CUTSCENE_PUFF, puff_stamp_draw, puff_keys, puff_part };
+#endif
+
+static void puff_cloud(int cx, int cy, int r, int ramp, int bright, uint32_t t)
+{
+    int w = ui_wave((int)t, 48, 1);
+#if !defined(DOOMO_PLATFORM_PS1)
+    if (puff_wanted(ramp, bright, r) &&
+        plat_stage_stamp(DOOMO_BACKDROP_CUTSCENE_PUFF, puff_key(ramp, bright, r, w), cx, cy))
+        return;
+#endif
+    puff_draw(cx, cy, r, ramp, bright, w);
+}
+
