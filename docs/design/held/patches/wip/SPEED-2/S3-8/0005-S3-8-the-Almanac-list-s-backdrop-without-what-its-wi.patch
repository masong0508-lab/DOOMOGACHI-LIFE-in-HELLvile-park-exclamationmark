From f14372668a0e4a7dd11a304cf786a06b45849885 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 18:44:15 +0000
Subject: [PATCH 05/11] S3-8: the Almanac list's backdrop without what its
 windows cover (GBA list move 33.9 -> 30.3 ms)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cvyt9PpfrF57wBDFeR
---
 core/src/lib_almanac.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/core/src/lib_almanac.c b/core/src/lib_almanac.c
index 0b2e58c..7635105 100644
--- a/core/src/lib_almanac.c
+++ b/core/src/lib_almanac.c
@@ -688,7 +688,14 @@ static void alm_draw(void)
         ui_modal_hold_end();
         return;
     }
-    lib_chrome(LIB_WING_ALMANAC, alm_pct);
+    lw = lib_big() ? 140 : 104;
+    {
+        /* S3-8: the two windows are opaque, the backdrop under them (all but their 4-pixel corners) is never seen */
+        int hl[8], wy = 18 + 16 + 1, wh = sh - (18 + 16) - 16;
+        hl[0] = 4 + 4; hl[1] = wy + 4; hl[2] = 4 + lw - 4; hl[3] = wy + wh - 4;
+        hl[4] = lw + 8 + 4; hl[5] = wy + 4; hl[6] = sw - 4 - 4; hl[7] = wy + wh - 4;
+        lib_chrome_holes(LIB_WING_ALMANAC, alm_pct, hl, 2);
+    }
     if (plat_draw_skipped()) return;
     y = 18;
     if (A.letter)
@@ -696,7 +703,6 @@ static void alm_draw(void)
     else
         doomo_snprintf(tabn, sizeof(tabn), "%s", shelf_names[lib_b.tab]);
     y += lib_tab_pill(sw / 2, y, tabn, lib_b.count, lib_b.tab, SH_COUNT, WIN_MINT);
-    lw = lib_big() ? 140 : 104;
     lib_list(4, y + 1, lw, sh - y - 16, 12, WIN_MINT, row);
     preview(lw + 8, y + 1, sw - lw - 12, sh - y - 16);
     {
