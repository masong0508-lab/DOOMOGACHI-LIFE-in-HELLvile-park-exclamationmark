 /* ---- the poster ----------------------------------------------------------- */
+/* (S3-8) the title never moves: a retained panel where the platform keeps them (the GBA; platform.h plat_panel_begin,
+ * solid: the whole rect comes back from the shown page), drawn inside it when the platform says draw (the song
+ * changes, rarely). Nothing draws over it afterwards (the curtains start 9 rows down and at the sides, the spot 36
+ * rows down). */
+static void bulb(const StRect *r, int i, int bottom, int on)
+{
+    ui_fill_circle(r->x + 6 + i * 8, bottom ? r->y + r->h - 5 : r->y + 4, 2,
+                   (on ^ bottom) ? PAL_PAINT(PAINT_LEMON, 2) : PAL_PAINT(PAINT_HONEY, 0));
+}
+
+/* a row of bulbs (bottom 0 / 1) at flip phase (0 / 1) */
+static void bulb_row(const StRect *r, int bottom, int phase)
+{
+    int i, n = (r->w - 8) / 8;
+    for (i = 0; i < n; i++) bulb(r, i, bottom, (i + phase) & 1);
+}
+
+#if !defined(DOOMO_PLATFORM_PS1)
+/* (S3-8) the two rows at the two phases are stamps of the library family: baked (the GBA) as the pictures of bulb_row on
+ * the tab's own rect, they come back as one blit each (~0.5 ms instead of ~2: a circle is a handful of rects) */
+void stage_stamp_draw(uint32_t key)
+{
+    StRect r = st_content();
+    bulb_row(&r, (int)((key >> 1) & 1u), (int)(key & 1u));
+}
+
+int stage_stamp_keys(uint32_t *out, int cap)
+{
+    int i;
+    for (i = 0; i < 4; i++)
+        if (i < cap) out[i] = LIB_PIC_BULBS + (uint32_t)i;
+    return 4;
+}
+#endif
+
+static void poster_marquee(const StRect *r, int t)
+{
+    int row;
+    for (row = 0; row < 2; row++) {
+#if !defined(DOOMO_PLATFORM_PS1)
+        StRect c = st_content();
+        if (r->x == c.x && r->y == c.y && r->w == c.w && r->h == c.h &&
+            plat_stage_stamp(DOOMO_BACKDROP_LIBRARY, LIB_PIC_BULBS + (uint32_t)(row * 2 + ((t / 6) & 1)), r->x, r->y))
+            continue;
+#endif
+        bulb_row(r, row, (t / 6) & 1);
+    }
+}
+
+static void poster_title(const StRect *r)
+{
+    int x = r->x + r->w / 2 - ui_text_big_width(SS->title, 2) / 2, y = r->y + 10;
+#if UI_PANELS
+    uint32_t key = ui_key_int(ui_key_str(ui_panel_key(), SS->title), r->w);
+    if (!plat_panel_begin(PANEL_OW_OBJECTIVE, x - 3, y - 2, ui_text_big_width(SS->title, 2) + 6, 20, key)) {
+        plat_panel_end();
+        return;
+    }
+    plat_panel_solid();
+#endif
+    ui_text_big(x, y, SS->title, 2, PAL_PAINT(PAINT_LEMON, 2), PAL_PAINT(PAINT_BLOOD, 0));
+#if UI_PANELS
+    plat_panel_end();
+#endif
+}
