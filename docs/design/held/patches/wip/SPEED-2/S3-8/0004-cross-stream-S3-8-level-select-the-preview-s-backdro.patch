+/* (S3-8) the level select's title and blurb (levels_select.c): solid panels. The cursor along the levels (the slide), a
+ * page turn if there is one, a mode change, the Spanish translation */
+static void s_level_select(void)
+{
+    story_town();
+    scene_set(&SCENE_LEVEL_SELECT, 0);
+}
+static uint32_t p_level_select(int f)
+{
+    if (f == 60 || f == 100) return BTN_RIGHT;
+    if (f == 140) return BTN_LEFT;
+    if (f == 180) return BTN_R;
+    if (f == 210) return BTN_DOWN;
+    if (f == 240 && lang_find("es") >= 0) opt_set(OPT_LANGUAGE, lang_find("es"));
+    if (f == 270) return BTN_RIGHT;
+    return 0;
+}
+TEST(panel_level_select_text_is_pixel_identical)
+{
+    CHECK(both("level_select", s_level_select, p_level_select, 330, 200));
+}
