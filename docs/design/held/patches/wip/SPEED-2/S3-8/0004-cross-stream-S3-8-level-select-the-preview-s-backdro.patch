diff --git a/core/src/ui_draw.c b/core/src/ui_draw.c
index 9591dad..23599e1 100644
--- a/core/src/ui_draw.c
+++ b/core/src/ui_draw.c
@@ -417,6 +417,30 @@ void ui_backdrop_flat(int style, const int *hl, int n)
     seam_row(b2, w, b.mid, 1);
 }
 
+/* a seam row of seam_row() inside [x, x + w): the same dots (the checker's phase is the call's corner) */
+static void seam_part(int x, int w, int y, uint8_t c, int phase)
+{
+    int s0 = x + ((x - (phase & 1)) & 1);
+    if (s0 < x + w) plat_checker(s0, y, x + w - s0, 1, c);
+}
+
+void ui_backdrop_rows(int style, int x, int y, int w, int h)
+{
+    Backdrop b;
+    int H = plat_screen_h(), b1 = H / 3, b2 = H * 2 / 3, y1 = y + h, a;
+    if (plat_draw_skipped() || w <= 0 || h <= 0) return;
+    backdrop_colors(style, &b);
+    a = DOOMO_MIN(y1, b1);
+    if (y < a) plat_rect(x, y, w, a - y, b.top);
+    if (DOOMO_MAX(y, b1) < DOOMO_MIN(y1, b2)) plat_rect(x, DOOMO_MAX(y, b1), w, DOOMO_MIN(y1, b2) - DOOMO_MAX(y, b1), b.mid);
+    a = DOOMO_MAX(y, b2);
+    if (a < y1) plat_rect(x, a, w, y1 - a, b.bot);
+    if (b1 - 1 >= y && b1 - 1 < y1) seam_part(x, w, b1 - 1, b.mid, 0);
+    if (b1 >= y && b1 < y1) seam_part(x, w, b1, b.top, 1);
+    if (b2 - 1 >= y && b2 - 1 < y1) seam_part(x, w, b2 - 1, b.bot, 0);
+    if (b2 >= y && b2 < y1) seam_part(x, w, b2, b.mid, 1);
+}
