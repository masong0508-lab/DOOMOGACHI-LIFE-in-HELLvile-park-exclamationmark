+    for (i = 0; i < LL_COUNT; i++) {
+        lob_layer(&g, i, status, qimg, qx, qy, b, &key);
+        stage_layer(i, b[0], b[1], b[2], b[3], key);
+    }
+    stage_resolve();
+    for (i = 0; i < LL_COUNT; i++)
+        if (stage_draw(i)) lob_layer_draw(&g, i, status, qimg, qx, qy);
+    stage_end();
+    return 1;
