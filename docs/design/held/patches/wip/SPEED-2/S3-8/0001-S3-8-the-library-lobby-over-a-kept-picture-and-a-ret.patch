diff --git a/core/tests/test_lib_kept.c b/core/tests/test_lib_kept.c
new file mode 100644
index 0000000..6c77402
--- /dev/null
+++ b/core/tests/test_lib_kept.c
@@ -0,0 +1,162 @@
+/* test_lib_kept.c - (S3-8) the kept library lobby, jukebox and studio STAGE (lib_common.c, lib_jukebox.c,
+ * studio_stage.c; docs/GBA.md "Speed wave 3: S3-8"). Each screen is drawn over the retained stage / as retained
+ * panels where the platform keeps them. The native platform emulates the GBA's two Mode 4 pages when nat_stage_on
+ * is set (a frame starts from the picture of two frames ago), so a box the stage fails to put back, a layer it
+ * fails to redraw or a key that misses a change shows up as a differing frame. One tour a screen, played twice
+ * (stage off, stage on); every frame must hash the same. Day and night, 240x160 and 320x240, English and Spanish. */
+#include "test.h"
+#include "../src/lib_int.h"
+#include "doomo/backdrop.h"
+#include "doomo/lang.h"
+
+#define KF_MAX 3000
+
+typedef struct { int16_t at; uint16_t b; } KPad;
+
+static void set_res(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+}
+
+static void kframe(uint32_t b) { plat_begin_frame(); doomo_frame(b); plat_end_frame(); }
+
+static uint32_t kfb_hash(void)
+{
+    uint32_t h = 2166136261u;
+    int i, n = nat_w * nat_h;
+    for (i = 0; i < n; i++) h = (h ^ nat_fb[i]) * 16777619u;
+    return h;
+}
+
+static uint32_t kpad(const KPad *p, int f)
+{
+    for (; p && p->at >= 0; p++)
+        if (p->at == f) return p->b;
+    return 0;
+}
+
+typedef struct {
+    const char *name;
+    const DoomoScene *scene;
+    int arg, frames, night, lang;
+    const KPad *pad;
+    void (*setup)(void);
+} KTour;
+
+static int kept_frames, full_frames;
+
+static int krun(const KTour *k, int stage, uint32_t *out, int upto)
+{
+    int f, n = 0;
+    nat_stage_on = stage;
+    nat_stage_buffers = 2;
+    nat_stage_reset();
+    test_reset();
+    doomo_init();
+    portrait_cache_reset();
+    scene_set(&SCENE_TITLE, 0);
+    kframe(0);
+    kept_frames = full_frames = 0;
+    if (k->setup) k->setup();
+    doomo_town.minute = (uint16_t)(k->night ? 22 * 60 : 12 * 60);
+    doomo_town.opt[OPT_LANGUAGE] = (uint8_t)k->lang;
+    scene_push(k->scene, k->arg);
+    for (f = 0; f < k->frames && n < upto && n < KF_MAX; f++) {
+        kframe(kpad(k->pad, f));
+        out[n++] = kfb_hash();
+        if (nat_stage_kept()) {
+            StageStats st;
+            stage_stats(&st);
+            kept_frames++;
+            full_frames += st.full;
+        }
+    }
+    nat_stage_on = 0;
+    doomo_town.opt[OPT_LANGUAGE] = LANG_EN;
+    return n;
+}
+
+/* plays the tour with the stage off and on at w x h; 0 when a frame differs (a picture of the first one is written) */
+static int kcompare(const KTour *k, int w, int h, int *kept)
+{
+    static uint32_t off[KF_MAX], on[KF_MAX];
+    int n, f;
+    set_res(w, h);
+    n = krun(k, 0, off, KF_MAX);
+    krun(k, 1, on, KF_MAX);
+    *kept = kept_frames;
+    for (f = 0; f < n; f++)
+        if (off[f] != on[f]) {
+            static uint8_t a[NAT_MAX_W * NAT_MAX_H];
+            char m[300], path[600];
+            int i, x0 = w, y0 = h, x1 = -1, y1 = -1, nd = 0;
+            krun(k, 0, off, f + 1);
+            memcpy(a, nat_fb, (size_t)(w * h));
+            snprintf(path, sizeof(path), "%s/lib_kept_%s_%dx%d_off.png", test_tmp_dir, k->name, w, h);
+            nat_png_write(path, nat_fb, w, h, 2);
+            krun(k, 1, on, f + 1);
+            snprintf(path, sizeof(path), "%s/lib_kept_%s_%dx%d_on.png", test_tmp_dir, k->name, w, h);
+            nat_png_write(path, nat_fb, w, h, 2);
+            for (i = 0; i < w * h; i++)
+                if (a[i] != nat_fb[i]) {
+                    nd++;
+                    x0 = DOOMO_MIN(x0, i % w); x1 = DOOMO_MAX(x1, i % w);
+                    y0 = DOOMO_MIN(y0, i / w); y1 = DOOMO_MAX(y1, i / w);
+                }
+            snprintf(m, sizeof(m), "%s %dx%d night %d lang %d: frame %d differs with the stage on (%d px in %d,%d..%d,%d)",
+                     k->name, w, h, k->night, k->lang, f, nd, x0, y0, x1, y1);
+            test_fail(__FILE__, __LINE__, m);
+            return 0;
+        }
+    printf("      kept %s %dx%d night %d lang %d: %d frames, %d over the kept picture, %d of them drawn in full\n", k->name, w, h,
+           k->night, k->lang, n, *kept, full_frames);
+    if (full_frames * 5 > *kept) {
+        test_fail(__FILE__, __LINE__, "the stage drew too many frames in full");
+        return 0;
+    }
+    return n;
+}
+
+/* ---- the lobby: the cursor along the shelf and back, a locked book poked, a book opened and closed ---- */
+static const KPad pad_lobby[] = {
+    { 60, BTN_RIGHT }, { 80, BTN_RIGHT }, { 100, BTN_RIGHT }, { 104, BTN_RIGHT }, { 140, BTN_RIGHT }, { 170, BTN_RIGHT },
+    { 200, BTN_RIGHT }, { 230, BTN_A }, { 270, BTN_A }, { 300, BTN_LEFT }, { 330, BTN_LEFT }, { 360, BTN_LEFT },
+    { 440, BTN_LEFT }, { 470, BTN_LEFT }, { 500, BTN_RIGHT }, { 540, BTN_A }, { 560, BTN_B }, { 640, BTN_RIGHT },
+    { 700, BTN_LEFT }, { 800, BTN_LEFT }, { -1, 0 }
+};
+
+static void lobby_setup(void)
+{
+    town_new(TOWN_FREEPLAY, 4242, TOWN_POP_PREMADE);
+    sim_init();
+}
+
+TEST(lib_kept_lobby_is_pixel_identical)
+{
+    KTour k = { "lobby", &SCENE_LIBRARY, 0, 1000, 0, LANG_EN, pad_lobby, lobby_setup };
+    int kept, n;
+    CHECK(stage_mem_bytes() <= 2048u);
+    n = kcompare(&k, 240, 160, &kept);
+    CHECK(n > 0);
+    CHECK_MSG(kept > n / 3, "only %d of %d frames over the kept picture", kept, n);
+    k.night = 1;
+    CHECK(kcompare(&k, 240, 160, &kept) > 0);
+    k.night = 0;
+    CHECK(kcompare(&k, 320, 240, &kept) > 0);
+    k.night = 1;
+    CHECK(kcompare(&k, 320, 240, &kept) > 0);
+    set_res(240, 160);
+}
+
+TEST(lib_kept_lobby_spanish_is_pixel_identical)
+{
+    KTour k = { "lobby", &SCENE_LIBRARY, 0, 1000, 0, LANG_ES, pad_lobby, lobby_setup };
+    int kept;
+    CHECK(doomo_lang_info[LANG_ES].ready && doomo_lang_tables[LANG_ES]);
+    CHECK(kcompare(&k, 240, 160, &kept) > 0);
+    set_res(240, 160);
+}
