+/* 1 when the frame was drawn over the kept picture */
+static int lobby_kept_draw(int status, const DoomoResident *q)
+{
+    LobGeo g;
+    int i, b[4], qx, qy;
+    uint32_t key;
+    const DoomoImage *qimg;
+    if (!lobby_stage_ready()) return 0;
