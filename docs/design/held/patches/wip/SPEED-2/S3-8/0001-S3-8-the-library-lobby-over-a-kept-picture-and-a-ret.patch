+#if !defined(DOOMO_PLATFORM_PS1)
+    if (lobby_kept_draw(status, q)) {
+        p_hint();
+        return;
+    }
+#endif
+    lob_geo(&g);
+    draw_wall(g.sw, g.sh, g.floor_y);
+    p_window(&g);
+    p_mini_shelves(&g, 0);
+    p_mini_shelves(&g, 1);
+    p_title(&g);
+    p_badge(&g);
+    p_plank(&g);
+    for (i = 0; i < LIB_BOOKS; i++) p_book(&g, i);
+    p_candle(&g);
+    p_skull(&g);
+    {
+        int qx, qy;
+        const DoomoImage *img = quillby_img(&g, status, q, &qx, &qy);    /* Quillby behind the desk */
+        if (img) plat_image(qx, qy, img, 1, 0, 0);
+    }
+    p_desk(&g);
+    p_label(&g);
+    p_info_window(&g);
+    p_info_head(&g);
+    p_info_body(&g, status);
+    p_info_bar(&g);
+    for (i = 0; i < 5; i++) p_mote(&g, i);
