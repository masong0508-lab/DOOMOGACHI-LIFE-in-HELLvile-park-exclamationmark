Subject: [PATCH 07/11] S3-8: the PS1 keeps its old code (no glint helper, no
 holes in the level select, the original text), the Dreamcast keeps the old
 level select text, ls fits its old size, speed2 floors, ui_backdrop_rows test

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cvyt9PpfrF57wBDFeR
---
 core/src/levels_select.c               | 77 ++++++++++++++++++++------
 core/src/ui.c                          | 13 +++++
 core/tests/test_panel.c                | 51 ++++++++++-------
 gba/harness/scripts/speed2_action.txt  |  2 +-
 gba/harness/scripts/speed2_library.txt | 12 ++--
 5 files changed, 111 insertions(+), 44 deletions(-)

diff --git a/core/src/levels_select.c b/core/src/levels_select.c
index 6917dca..cacc230 100644
--- a/core/src/levels_select.c
+++ b/core/src/levels_select.c
@@ -25,10 +25,11 @@ static struct {
     uint8_t  mode, sel, launched, loaded, flash_lv;
     uint32_t unlocked_mask;
 #if !defined(DOOMO_PLATFORM_PS1)
-    uint8_t  pv_held;                /* S2-2: the platform holds the preview: it stands still between level changes */
-    uint32_t pv_key;                 /* S3-8: the key it holds the picture under (the old one stays up during a slide) */
+    uint32_t pv_key;                 /* S2-2 / S3-8: the key the platform holds the preview's picture under (0: none held:
+                                        it stands still between level changes; the old one stays up during a slide) */
 #endif
-    uint16_t t, pv_t, flash_t, msg_t;
+    uint16_t t, pv_t;
+    uint8_t  flash_t, msg_t;         /* (S3-8: bytes, to pay for pv_key: they count down from 90 and 70) */
     int16_t  slide;
     const char *msg;
 } ls;
@@ -168,7 +169,7 @@ static void ls_update(void)
 {
     ls.t++;
 #if !defined(DOOMO_PLATFORM_PS1)
-    if (!ls.pv_held)                 /* S2-2: a held preview no longer orbits (GBA: rendered once per level) */
+    if (!ls.pv_key)                  /* S2-2: a held preview no longer orbits (GBA: rendered once per level) */
 #endif
         ls.pv_t++;
     if (ls.msg_t) ls.msg_t--;
@@ -297,10 +298,10 @@ static int preview(int x, int y, int w, int h)
         uint32_t key = combat_view_key(&v, (uint32_t)ls.sel << 8 | ls.mode);
         /* S3-8 (pixel-changing, GBA): while the slide runs the old level's picture stays where it was (no render per
          * step of the slide: 10 ms of view and 8 ms of copy each); one render when the slide has ended */
-        if (ls.slide && ls.pv_held && plat_view_hold(PLAT_VIEW_PUT, ls.pv_key)) return 1;
+        if (ls.slide && ls.pv_key && plat_view_hold(PLAT_VIEW_PUT, ls.pv_key)) return 1;
         if (plat_view_hold(PLAT_VIEW_PUT, key)) { ls.pv_key = key; return 0; }
         plat_view3d(&v);
-        if (plat_view_hold(PLAT_VIEW_KEEP, key)) { ls.pv_held = 1; ls.pv_key = key; }
+        if (plat_view_hold(PLAT_VIEW_KEEP, key)) ls.pv_key = key;
     }
 #else
     plat_view3d(&v);                 /* (the PS1 holds 30 here: no copy, no resident RAM for it) */
@@ -349,6 +350,15 @@ static void draw_pips(int cy, int big)
     }
 }
 
+/* (S3-8) where the pixel-changing text panels below are used: the GBA (and the native build, which keeps panels the same
+ * way); the PS1 and the Dreamcast keep none and draw as before */
+#if UI_PANELS && !defined(DOOMO_PLATFORM_DC)
+#define LS_KEEP 1
+#else
+#define LS_KEEP 0
+#endif
+
+#if LS_KEEP
 /* S3-8 (pixel-changing, GBA): the title and the blurb are solid retained panels (platform.h plat_panel_begin; outlined
  * text was 6.4 + 3.3 ms of every frame): they stand where the level's text stands, drawn inside the panel when the
  * level, mode, language or style change, put back from the shown page on every other frame. The backdrop under them
@@ -357,7 +367,7 @@ static void draw_pips(int cy, int big)
  * over the title's outline instead of under it). The PS1 and the Dreamcast draw as before. */
 static int text_keep(int id, int x, int y, int w, int h, uint32_t key, int style)
 {
-#if UI_PANELS
+#if LS_KEEP
     if (!plat_panel_begin(id, x, y, w, h, key)) {
         plat_panel_end();
         return 0;
@@ -375,14 +385,14 @@ static void text_title(int sw, int ty, int big, int style, const LevelInfo *L)
     int wide = big && ui_text_big_width(L->title, 2) < sw - 20;
     int tw = wide ? ui_text_big_width(L->title, 2) : ui_text_width(L->title);
     int x = sw / 2 - tw / 2;
-#if UI_PANELS
+#if LS_KEEP
     uint32_t key = ui_key_str(ui_panel_key(), L->title);
     key = ui_key_int(ui_key_int(key, style | wide << 8), sw);
     if (!text_keep(PANEL_OW_OBJECTIVE, x - 3, ty - 1, tw + 6, wide ? 20 : 11, key, style)) return;
 #endif
     if (wide) ui_text_big(x, ty, L->title, 2, PAL_WHITE, ui_style(style)->outline);
     else ui_text_outline(x, ty, L->title, PAL_WHITE, ui_style(style)->outline);
-#if UI_PANELS
+#if LS_KEEP
     plat_panel_end();
 #endif
 }
@@ -404,7 +414,7 @@ static void text_card(int sw, int ty, int big, int style, const LevelInfo *L, in
     boss[0] = 0;
     if (L->boss != LB_NONE)
         doomo_snprintf(boss, sizeof(boss), STR_ICON_SKULL " %s", unl ? lv_boss[L->boss].name : "???");
-#if UI_PANELS
+#if LS_KEEP
     {
         uint32_t key = ui_key_str(ui_key_str(ui_panel_key(), L->blurb), buf);
         key = ui_key_int(ui_key_int(ui_key_str(key, boss), style | big << 8 | ch << 9), sw);
@@ -418,12 +428,13 @@ static void text_card(int sw, int ty, int big, int style, const LevelInfo *L, in
     plat_rect(8, ty - 2, sw - 16, 1, ui_lighter(ui_style(style)->outline));
     ui_text_outline(8, ty, buf, PAL_UI_GOLD, PAL_BLACK);
     if (L->boss != LB_NONE) ui_text_outline(8, ty + 10, boss, PAL_RAMP(RAMP_LAVA, 7), PAL_BLACK);
-#if UI_PANELS
+#if LS_KEEP
     plat_panel_end();
 card_done:
 #endif
     (void)ty;
 }
+#endif
 
 static void ls_draw(void)
 {
@@ -432,11 +443,18 @@ static void ls_draw(void)
     int px = big ? 12 : 10, py = big ? 22 : 19, pw = sw - px * 2, ph = big ? 108 : 54;
     int unl = lv_unlocked(ls.sel), ty, k;
     char buf[64];
+#if !LS_KEEP
+    char tb[12];
+#endif
+#if !defined(DOOMO_PLATFORM_PS1)
     {
         int hole[4];                 /* S3-8: the preview covers its rect: the backdrop under it is never seen */
         hole[0] = px; hole[1] = py; hole[2] = px + pw; hole[3] = py + ph;
         ui_backdrop_holes(style, ls.t, hole, 1);
     }
+#else
+    ui_backdrop(style, ls.t);        /* (the PS1's GPU fills the backdrop for next to nothing) */
+#endif
     if (plat_draw_skipped()) return;
     ui_title(sw / 2, 3, ls.mode != LVM_NORMAL ? lv_mode_names[ls.mode] : page_title(), style);
     if (mode_open(LVM_TIME_TRIAL)) {
@@ -490,18 +508,45 @@ static void ls_draw(void)
             ui_text(nx + 5, ny + 2, "NEW!", PAL_UI_RED_D);
         }
     }
-#if !UI_PANELS
-    draw_pips(py + ph + (big ? 15 : 10), big);
-#endif
+#if LS_KEEP
     /* title + blurb + numbers */
     ty = py + ph + (big ? 30 : 20);
     text_title(sw, ty, big, style, L);
     ty += big ? 20 : 11;
     text_card(sw, ty, big, style, L, unl);
-#if UI_PANELS
     draw_pips(py + ph + (big ? 15 : 10), big);     /* (after the title: see text_title) */
-#endif
     if (L->boss != LB_NONE && big && unl) lvd_boss_figure(L->boss, sw - 34, sh - 18, ls.t, 1, 1);
+#else
+    draw_pips(py + ph + (big ? 15 : 10), big);
+    /* title + blurb + numbers */
+    ty = py + ph + (big ? 30 : 20);
+    if (big && ui_text_big_width(L->title, 2) < sw - 20)
+        ui_text_big(sw / 2 - ui_text_big_width(L->title, 2) / 2, ty, L->title, 2, PAL_WHITE, ui_style(style)->outline);
+    else
+        ui_text_outline(sw / 2 - ui_text_width(L->title) / 2, ty, L->title, PAL_WHITE, ui_style(style)->outline);
+    ty += big ? 20 : 11;
+    ui_text_wrap(8, ty, sw - 16, L->blurb, ui_style(style)->text, 1);
+    ty += 21;
+    if (ls.mode == LVM_TIME_TRIAL) {
+        lvd_time(tb, sizeof(tb), L->dev);
+        doomo_snprintf(buf, sizeof(buf), STR_ICON_BOLT " Gold time %s   %s", tb, lv_gold(ls.sel) ? STR_ICON_STAR " GOLD!" : "no medal yet");
+    } else {
+        lvd_time(tb, sizeof(tb), L->par);
+        doomo_snprintf(buf, sizeof(buf), STR_ICON_STAR " Par %s   Best %s   %s", tb, lv_rank_names[lv_rank(ls.sel)],
+                       ls.mode == LVM_CUTE_ONLY ? STR_ICON_HEART "cute only" :
+                       ls.mode == LVM_BRUTAL_ONLY ? STR_ICON_SKULL "brutal only" : "");
+    }
+    /* the numbers on a dark card in the theme's own outline colour */
+    ui_round_rect(4, ty - 2, sw - 8, L->boss != LB_NONE ? 22 : 12, 4, ui_style(style)->outline);
+    plat_rect(8, ty - 2, sw - 16, 1, ui_lighter(ui_style(style)->outline));
+    ui_text_outline(8, ty, buf, PAL_UI_GOLD, PAL_BLACK);
+    if (L->boss != LB_NONE) {
+        const LevelBoss *b = &lv_boss[L->boss];
+        doomo_snprintf(buf, sizeof(buf), STR_ICON_SKULL " %s", unl ? b->name : "???");
+        ui_text_outline(8, ty + 10, buf, PAL_RAMP(RAMP_LAVA, 7), PAL_BLACK);
+        if (big && unl) lvd_boss_figure(L->boss, sw - 34, sh - 18, ls.t, 1, 1);
+    }
+#endif
     if (ls.msg_t) {
         int w = ui_text_width(ls.msg) + 14, x = sw / 2 - w / 2, y = py + ph / 2 - 6;
         ui_round_rect(x, y + ui_wave(ls.msg_t, 20, 1), w, 13, 6, PAL_UI_GOLD);
