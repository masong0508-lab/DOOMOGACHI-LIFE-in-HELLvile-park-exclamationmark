 /* ui_backdrop_flat(): the bands and seams of ui_backdrop(), none of its dots, hearts and twinkles, and nothing in a hole */
+/* (S3-8) ui_backdrop_rows(style, x, y, w, h) paints the flat backdrop's bands and seams inside the rect, exactly what
+ * ui_backdrop_flat leaves there (at odd and even corners: the seams' checkers keep the phase of the whole row), and
+ * nothing outside it */
+TEST(panel_backdrop_rows_is_the_flat_backdrop_inside_its_rect)
+{
+    static uint8_t flat[NAT_MAX_W * NAT_MAX_H];
+    static const int rects[][4] = { { 6, 40, 200, 30 }, { 7, 50, 101, 61 }, { 0, 0, 240, 160 }, { 13, 104, 33, 6 }, { 8, 51, 9, 4 } };
+    static const int styles[] = { WIN_CREAM, WIN_MINT, WIN_DARK, WIN_HELL, WIN_CUTE };
+    int si, r, i;
+    set_res(240, 160);
+    nat_panel_cache = 0;
+    test_reset();
+    for (si = 0; si < 5; si++) {
+        plat_clear(PAL_BLACK);
+        ui_backdrop_flat(styles[si], NULL, 0);
+        memcpy(flat, nat_fb, (size_t)(nat_w * nat_h));
+        for (r = 0; r < 5; r++) {
+            const int *q = rects[r];
+            plat_clear(PAL_BLACK);
+            ui_backdrop_rows(styles[si], q[0], q[1], q[2], q[3]);
+            for (i = 0; i < nat_w * nat_h; i++) {
+                int px = i % nat_w, py = i / nat_w, in = px >= q[0] && px < q[0] + q[2] && py >= q[1] && py < q[1] + q[3];
+                if (in) CHECK_MSG(nat_fb[i] == flat[i], "style %d rect %d: pixel %d,%d is %d, the flat backdrop's %d", si, r, px, py,
+                                  nat_fb[i], flat[i]);
+                else if (nat_fb[i] != PAL_BLACK) { CHECK_MSG(0, "style %d rect %d: pixel %d,%d outside the rect painted", si, r, px, py); return; }
+            }
+        }
+    }
+}
+
 TEST(panel_backdrop_flat_is_the_backdrop_without_its_drifting_things)
 {
     static uint8_t full[NAT_MAX_W * NAT_MAX_H];
