+/* ---- the jukebox: the record's stamps (the disc for each label colour, the two tonearms) and the backdrop that
+ * leaves out what its windows cover; songs along the list, one played, stopped, the sound FX shelf ---- */
+static const KPad pad_juke[] = {
+    { 20, BTN_DOWN }, { 28, BTN_DOWN }, { 36, BTN_DOWN }, { 50, BTN_A }, { 120, BTN_DOWN }, { 125, BTN_DOWN },
+    { 130, BTN_DOWN }, { 140, BTN_A }, { 200, BTN_DOWN }, { 205, BTN_DOWN }, { 210, BTN_DOWN }, { 215, BTN_DOWN },
+    { 220, BTN_DOWN }, { 225, BTN_DOWN }, { 260, BTN_SELECT }, { 300, BTN_R }, { 330, BTN_DOWN }, { 335, BTN_DOWN },
+    { 360, BTN_A }, { 420, BTN_L }, { 450, BTN_UP }, { 480, BTN_B }, { -1, 0 }
+};
+
+static void juke_setup(void)
+{
+    town_new(TOWN_FREEPLAY, 4242, TOWN_POP_PREMADE);
+    sim_init();
+}
+
+TEST(lib_kept_jukebox_is_pixel_identical)
+{
+    KTour k = { "jukebox", &SCENE_LIB_JUKEBOX, LIB_ARG_DEMO, 500, 0, LANG_EN, pad_juke, juke_setup };
+    int kept;
+    CHECK(kcompare(&k, 240, 160, &kept) > 0);
+    CHECK_MSG(stamps_drawn > 200, "only %d stamps drawn (the disc and the tonearm, a frame each)", stamps_drawn);
+    CHECK(kcompare(&k, 320, 240, &kept) > 0);
+    CHECK(stamps_drawn > 200);
+    k.lang = LANG_ES;
+    CHECK(kcompare(&k, 240, 160, &kept) > 0);
+    set_res(240, 160);
