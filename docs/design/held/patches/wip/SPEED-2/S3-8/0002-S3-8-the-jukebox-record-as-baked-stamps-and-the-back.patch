+}
+
+static void tonearm(int cx, int cy, int r, int playing)
+{
+    int px = cx + r + 4, py = cy - r + 2;
+    int nx = playing ? cx + r / 2 + 2 : cx + r + 2, ny = playing ? cy + 2 : cy - r / 2 + 6;
+    ui_fill_circle(px, py, 4, PAL_RAMP(RAMP_STEEL, 3));
+    ui_fill_circle(px, py, 2, PAL_RAMP(RAMP_STEEL, 6));
+    plat_line(px, py, nx, ny, PAL_RAMP(RAMP_STEEL, 6));
+    plat_line(px + 1, py, nx + 1, ny, PAL_RAMP(RAMP_STEEL, 4));
+    plat_rect(nx - 1, ny - 1, 4, 3, PAL_RAMP(RAMP_STEEL, 5));
+}
+
+#if !defined(DOOMO_PLATFORM_PS1)
+/* (S3-8) the stamps of the library family (lib_int.h LIB_PIC_*): a disc for each label colour and the two tonearms,
+ * each painted by the code above around the anchor (the GBA bakes them; ~3 ms of circles become a 1 ms blit) */
+void juke_stamp_draw(uint32_t key, int ax, int ay)
+{
+    int r = lib_big() ? 34 : 24;
+    if (key >= LIB_PIC_ARM) tonearm(ax, ay, r, (int)(key & 1u));
+    else disc_body(ax, ay, r, PAL_PAINT((int)(key - LIB_PIC_DISC) % PAL_PAINT_COUNT, 1));
+}
+
+int juke_stamp_keys(uint32_t *out, int cap)
+{
+    int i, n = 0;
+    for (i = 0; i < PAL_PAINT_COUNT; i++, n++)
+        if (n < cap) out[n] = LIB_PIC_DISC + (uint32_t)i;
+    for (i = 0; i < 2; i++, n++)
+        if (n < cap) out[n] = LIB_PIC_ARM + (uint32_t)i;
+    return n;
+}
+#endif
+
+static void record(int cx, int cy, int r, int song, int playing)
+{
+    int p = (song * 7 + 4) % PAL_PAINT_COUNT, a = J.spin * 6;
