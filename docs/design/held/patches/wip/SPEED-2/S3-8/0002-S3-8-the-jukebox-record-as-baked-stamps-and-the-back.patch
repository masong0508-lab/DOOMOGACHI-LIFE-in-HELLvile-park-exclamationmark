+    if (!plat_stage_stamp(DOOMO_BACKDROP_LIBRARY, LIB_PIC_DISC + (uint32_t)p, cx, cy))
+#endif
+        disc_body(cx, cy, r, PAL_PAINT(p, 1));
     /* a glint sweeping round as it spins */
