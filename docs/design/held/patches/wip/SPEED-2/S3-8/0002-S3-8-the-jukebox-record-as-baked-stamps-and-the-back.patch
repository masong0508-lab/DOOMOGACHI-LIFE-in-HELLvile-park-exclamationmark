+/* (S3-8) the pictures of the family DOOMO_BACKDROP_LIBRARY (backdrop.h; the GBA bakes them into the ROM): key 0 is the
+ * lobby's (lib_common.c), the others are stamps around an anchor (LIB_ANCHOR_X, LIB_ANCHOR_Y): the jukebox record's
+ * disc and tonearm (lib_jukebox.c: juke_stamp_draw, juke_stamp_keys) */
+#if !defined(DOOMO_PLATFORM_PS1)
+#define LIB_PIC_LOBBY  0u
+#define LIB_PIC_DISC   0x100u       /* + the label's paint (0..PAL_PAINT_COUNT - 1): the disc with its label */
+#define LIB_PIC_ARM    0x200u       /* + 1 while a song plays: the tonearm */
+#define LIB_ANCHOR_X   60
+#define LIB_ANCHOR_Y   60
+void juke_stamp_draw(uint32_t key, int ax, int ay);
+int  juke_stamp_keys(uint32_t *out, int cap);
+#endif
