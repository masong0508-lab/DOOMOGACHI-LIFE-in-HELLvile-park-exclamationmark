@@ -61,6 +61,32 @@ static int      s_depth;                 /* nesting of scene calls       */
 static uint8_t  s_run[OVL_NEST];         /* the group of each scene call */
 static uint32_t s_loads;
 
+/* --- S3-15 PREFETCH (scene.h scene_hint): while a scene waits (a menu's cursor rests on an entry), the END of the
+ * packed group it is about to open is read into the tail of the slot, which is free: after the running group (and its
+ * part, and the scratch it asked for, plat_scene_scratch). The new group's own read then takes the sectors in front
+ * of it only: s_pf.k sectors, the last ones of the stream, are already in place. The read is asynchronous and never
+ * touches what runs: pf_floor() is the end of everything the running scene can use. Any other use of the drive or of
+ * the slot's tail first finishes or drops it (pf_stop). state 0 = none, 1 = reading, 2 = in. --- */
+static struct { uint8_t g, state; uint16_t k; } s_pf;
+static uint8_t *s_scr_hi;                /* end of the highest scratch handed out for the group in the slot */
+
+static void pf_stop(void)
+{
+    if (s_pf.state == 1)
+        CdReadSync(0, 0);                /* finish the read: the drive is busy until then */
+    s_pf.state = 0;
+    s_pf.g = 0;
+    s_pf.k = 0;
+}
+
+/* the drive and the slot's tail are about to be used by someone else (any other reader of the disc) */
+void ovl_cd_claim(void)
+{
+    if (s_pf.state)
+        pf_stop();
+}
+/* --- end S3-15 --- */
+
 /* --- H3 (SPEC C4/C5): a group linked below the slot (the house, ovl_plan.py
  * BORROW) also covers the .bss of world.c and view3d.c. Its loads count
  * here; world_sync() and plat_view3d() call ovl_borrow_take() before they
@@ -152,26 +178,29 @@ static const uint8_t *unlz_token(const uint8_t *src, uint8_t **dp, uint8_t *dst,
 /* read n packed sectors into the slot's tail and decode them to the group's
  * start (dst) as they arrive (a token is at most 129 bytes, so a token is
  * only decoded once the sectors holding it are in) */
-static int read_unpack(int lba, int n, uint32_t bytes, uint8_t *dst, uint32_t *t_wait)
+static int read_unpack(int lba, int n, uint32_t bytes, uint8_t *dst, uint32_t *t_wait, int pre)
 {
     CdlLOC loc;
     int tries;
     uint8_t *tmp = __ovl_slot_end - (uint32_t)n * 2048;
     for (tries = 0; tries < 4; tries++) {
+        int n1 = n - (tries ? 0 : pre);       /* S3-15: the last pre sectors of the stream are in place already */
         uint8_t *d = dst, *end = dst + bytes;
         const uint8_t *src = tmp;
         int left;
-        CdIntToPos(lba, &loc);
-        if (!CdControl(CdlSetloc, &loc, 0))
-            continue;
-        if (!CdRead(n, (uint32_t *)tmp, CdlModeSpeed))
-            continue;
+        if (n1 > 0) {
+            CdIntToPos(lba, &loc);
+            if (!CdControl(CdlSetloc, &loc, 0))
+                continue;
+            if (!CdRead(n1, (uint32_t *)tmp, CdlModeSpeed))
+                continue;
+        }
         while (d < end && src) {
             const uint8_t *avail;
-            left = CdReadSync(1, 0);
+            left = n1 > 0 ? CdReadSync(1, 0) : 0;
             if (left < 0)
                 break;
-            avail = left ? tmp + (uint32_t)(n - left) * 2048 - 130 : tmp + (uint32_t)n * 2048;
+            avail = left ? tmp + (uint32_t)(n1 - left) * 2048 - 130 : tmp + (uint32_t)n * 2048;
             if (src >= avail) {
                 uint32_t t = timer_us();
                 while (CdReadSync(1, 0) == left)
@@ -182,7 +211,7 @@ static int read_unpack(int lba, int n, uint32_t bytes, uint8_t *dst, uint32_t *t
             while (d < end && src && src < avail)
                 src = unlz_token(src, &d, dst, end);
         }
-        if (CdReadSync(0, 0) < 0 || !src || d != end)
+        if ((n1 > 0 && CdReadSync(0, 0) < 0) || !src || d != end)
             continue;
         return 1;
     }
@@ -203,12 +232,24 @@ static void load(int g)
          * place to its start WHILE the drive delivers the sectors, so the
          * load takes as long as reading ~30% fewer sectors (ovl_pack.py
          * only packs a group whose output never overtakes its input) */
+        int pre = 0;
         n = (s_grp[g].packed + 2047) / 2048;
