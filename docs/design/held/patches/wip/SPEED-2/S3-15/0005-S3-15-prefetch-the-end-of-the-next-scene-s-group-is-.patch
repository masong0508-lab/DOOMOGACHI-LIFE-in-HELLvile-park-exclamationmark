diff --git a/core/include/doomo/scene.h b/core/include/doomo/scene.h
index c74ce0b..65fc192 100644
--- a/core/include/doomo/scene.h
+++ b/core/include/doomo/scene.h
@@ -49,6 +49,16 @@ void plat_scene_code_end(int token);
 #ifndef __arm__
 extern int (*scene_enter_loads)(const DoomoScene *s);   /* (not built on the GBA: no overlays) */
 #endif
+/* --- S3-15 (additive): scene_hint(s): "s is the scene most likely to be entered next" (a menu's cursor rests on
+ * its entry; the scene below the one just pushed). The PS1 reads the end of s's code group into the free tail of its
+ * overlay slot meanwhile (plat_scene_prefetch, overlay.c), so entering s then waits for the drive less. It changes
+ * nothing visible, and is cheap to call every frame. Other platforms: nothing (the GBA: not even a call). --- */
+#ifdef __arm__
+#define scene_hint(s) ((void)0)
+#else
+void scene_hint(const DoomoScene *s);
+void plat_scene_prefetch(const DoomoScene *s);
+#endif
 /* --- H4 (additive): a scene's code may also come in PARTS that share one
  * address range (ps1/tools/ovl_plan.py PARTS): the code of one mode of a
  * scene. Before the scene's own code calls into a part it asks for it;
diff --git a/core/src/fp_island.c b/core/src/fp_island.c
