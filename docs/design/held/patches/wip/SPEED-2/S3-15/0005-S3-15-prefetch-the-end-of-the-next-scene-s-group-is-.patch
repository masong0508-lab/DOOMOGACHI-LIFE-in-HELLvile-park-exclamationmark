     if (borrows(g))
@@ -243,6 +285,44 @@ int plat_scene_code(const DoomoScene *s)
     return prev;
 }
 
+/* --- S3-15 PREFETCH (scene.h scene_hint): the scene s is about to be entered (a menu's cursor rests on its entry, or
+ * it is the one below that was pushed over). Read the end of its group into the free tail of the slot (see s_pf). --- */
+void plat_scene_prefetch(const DoomoScene *s)
+{
+    int p, g, n, k;
+    uint8_t *lo, *dst;
+    CdlLOC loc;
+    if (s_lba < 0 || !(g = group_of(s, &p)) || g == s_cur || s_pf.g == g || s_pf.state == 1)
+        return;                          /* nothing to read, asked for already, or busy with another guess */
+    pf_stop();
+    s_pf.g = (uint8_t)g;                 /* (kept when nothing fits: it is not asked again on every frame) */
+    if (!s_grp[g].packed)
+        return;
+    lo = s_cur ? s_grp[s_cur].dst + s_grp[s_cur].bytes : __ovl_slot;
+    if (s_cur && s_part && s_grp[s_part].dst + s_grp[s_part].bytes > lo)
+        lo = s_grp[s_part].dst + s_grp[s_part].bytes;
+    if (s_scr_hi > lo)
+        lo = s_scr_hi;
+    if (lo < __ovl_slot)
+        lo = __ovl_slot;
+    if (lo >= __ovl_slot_end)
+        return;
+    n = (int)((s_grp[g].packed + 2047) / 2048);
+    k = (int)((uint32_t)(__ovl_slot_end - lo) / 2048);
+    if (k > n)
+        k = n;
+    if (k < 1)
+        return;
+    dst = __ovl_slot_end - (uint32_t)k * 2048;
+    CdIntToPos(s_lba + (int)s_grp[g].sector + n - k, &loc);
+    if (!CdControl(CdlSetloc, &loc, 0) || !CdRead(k, (uint32_t *)dst, CdlModeSpeed))
+        return;
+    s_pf.k = (uint16_t)k;
+    s_pf.state = 1;
+    dbg("ovl: prefetch %s, the last %d of %d sectors\n", ps1_ovl_name[g], k, n);
+}
+/* --- end S3-15 --- */
+
 /* --- S3-15 (scene.h scene_enter_loads): would calling s's entry points load a group or a part? A scene change
  * made from inside a scene's own code then runs s's enter() after that call has returned (scene.c), instead of
  * reading s's group, the caller's group back and s's group again on the next frame. --- */
@@ -312,6 +392,10 @@ void *plat_scene_scratch(uint32_t bytes, uint32_t *gen)
     lo = (uint8_t *)(((uint32_t)lo + 3u) & ~3u);
     if (lo < __ovl_slot || bytes > (uint32_t)(__ovl_slot_end - lo))
         return NULL;
+    if (lo + bytes > s_scr_hi)
+        s_scr_hi = lo + bytes;           /* S3-15: the prefetch stays above it */
+    if (s_pf.k && lo + bytes > __ovl_slot_end - (uint32_t)s_pf.k * 2048)
+        pf_stop();                       /* S3-15: the scene wants more than it asked for before */
     return lo;
 }
 /* --- end SP3 --- */
@@ -361,6 +445,8 @@ void overlay_init(void)
 #else  /* engine test: everything is resident */
 
 void overlay_init(void) {}
+void ovl_cd_claim(void) {}
+void plat_scene_prefetch(const DoomoScene *s) { (void)s; }
 uint32_t overlay_loads(void) { return 0; }
 int ovl_borrow_take(uint32_t *seen) { (void)seen; return 0; }   /* H3: nothing borrows */
 void plat_code_part(int part) { (void)part; }                     /* H4: no parts */
