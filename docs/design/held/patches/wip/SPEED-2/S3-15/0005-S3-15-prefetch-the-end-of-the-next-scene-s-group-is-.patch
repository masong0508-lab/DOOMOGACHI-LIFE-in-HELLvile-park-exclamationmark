diff --git a/core/src/scene.c b/core/src/scene.c
index 34bb6bd..fa0c3ba 100644
--- a/core/src/scene.c
+++ b/core/src/scene.c
@@ -25,6 +25,14 @@ static int depth;
 __attribute__((weak)) int plat_scene_code(const DoomoScene *s) { (void)s; return 0; }
 __attribute__((weak)) void plat_scene_code_end(int token) { (void)token; }
 __attribute__((weak)) void plat_code_part(int part) { (void)part; }   /* H4: scene.h */
+#ifndef __arm__
+__attribute__((weak)) void plat_scene_prefetch(const DoomoScene *s) { (void)s; }   /* S3-15: scene.h */
+void scene_hint(const DoomoScene *s) { if (s) plat_scene_prefetch(s); }
+/* a scene was just pushed: the one below it is where the way back leads (a pop loads its code) */
+#define HINT_BELOW() do { if (depth >= 2) scene_hint(stack[depth - 2].s); } while (0)
+#else
+#define HINT_BELOW() ((void)0)
+#endif
 
 /* S3-15 (scene.h scene_push_late): a scene change that its caller marks "late", made from inside a scene's update,
  * whose new scene's enter() lives in a code group that is not loaded: on the PS1 that enter() would read the new
@@ -50,6 +58,7 @@ static void run_enter(const DoomoScene *s, int arg)
     int t = plat_scene_code(s);
     s->enter(arg);
     plat_scene_code_end(t);
+    HINT_BELOW();
 }
 
 #if SCENE_LATE
diff --git a/core/tests/test_scene_defer.c b/core/tests/test_scene_defer.c
index 3766e8d..04c72be 100644
--- a/core/tests/test_scene_defer.c
+++ b/core/tests/test_scene_defer.c
@@ -122,3 +122,34 @@ TEST(scene_late_enter_runs_before_the_next_draw)
     CHECK_STR(log_s, "v");
     end();
 }
+
+/* S3-15 prefetch: scene_hint reaches the platform; a push hints the scene below (where a pop leads), a set does not */
+static const DoomoScene *pf_last;
+static int pf_n;
+void plat_scene_prefetch(const DoomoScene *s) { pf_last = s; pf_n++; }
+
+TEST(scene_hint_reaches_the_platform)
+{
+    test_reset();
+    pf_n = 0; pf_last = NULL;
+    scene_hint(&SB);
+    CHECK(pf_n == 1 && pf_last == &SB);
+    scene_hint(NULL);
+    CHECK(pf_n == 1);
+    scene_set(&SA_IDLE, 0);
+    CHECK(pf_n == 1);                       /* a set has nothing below */
+    scene_push(&SB, 1);
+    CHECK(pf_n == 2 && pf_last == &SA_IDLE);   /* the way back */
+    test_reset();
+}
+
+TEST(scene_late_push_hints_after_its_enter)
+{
+    scene_enter_loads = s_hook;
+    begin(&SA_LATE);
+    pf_n = 0; pf_last = NULL;
+    scene_update();
+    CHECK_STR(log_s, "uxb7");
+    CHECK(pf_n == 1 && pf_last == &SA_LATE);
+    end();
+}
