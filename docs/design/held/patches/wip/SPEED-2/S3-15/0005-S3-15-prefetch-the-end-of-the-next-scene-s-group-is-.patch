+#ifndef __arm__
+/* S3-15: the scene an entry opens (scene_hint: the PS1 reads its code while the cursor rests on the entry) */
+static const DoomoScene *entry_scene(const Entry *e)
+{
+    if (!e->enabled) return NULL;
+    switch (e->code) {
+    case E_APTS: return &SCENE_APARTMENTS;
+    case E_MOVE_IN: case E_CREATE_HILL: case E_CREATE_HELL: case E_AVATAR: return &SCENE_CREATOR;
+    case E_SHOP: case E_CAFE_SHOP: case E_BLACK_MARKET: return &SCENE_SHOP;
+    case E_PRACTICE: return &SCENE_EXORCISM;
+    case E_WORKSHOP: return &SCENE_WORKSHOP;
+    case E_ARENA: return &SCENE_ARENA;
+    case E_GRAVES: return &SCENE_GRAVEYARD;
+    case E_STROLL: case E_VISIT_HELL: return &SCENE_STORY;
+    case E_SAVELOAD: return &SCENE_SAVELOAD;
+    case E_OPTIONS: return &SCENE_OPTIONS;
+    case E_UNLOCKS: return &SCENE_UNLOCKS;
+    case E_HELP: return &SCENE_LIB_HELP;
+    case E_NEWS: return &SCENE_NEWS;
+    case E_ROSTER: return &SCENE_ROSTER;
+    case E_FAMILY: return &SCENE_FAMILY;
+    default: return NULL;
+    }
+}
+#endif
