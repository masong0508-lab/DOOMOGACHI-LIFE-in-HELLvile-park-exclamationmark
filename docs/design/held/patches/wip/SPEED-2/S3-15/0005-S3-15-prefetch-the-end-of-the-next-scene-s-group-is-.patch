+            if (s_pf.state == 1 && CdReadSync(0, 0) < 0)
+                s_pf.k = 0;
+            pre = s_pf.k;
+            s_pf.state = 0;
+            s_pf.g = 0;
+            s_pf.k = 0;
+        }
+        pf_stop();
