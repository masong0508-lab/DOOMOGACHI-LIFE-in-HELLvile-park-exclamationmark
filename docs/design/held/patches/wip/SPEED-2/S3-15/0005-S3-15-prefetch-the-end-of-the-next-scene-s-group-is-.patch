         while (!read_sectors(s_lba + (int)s_grp[g].sector, (int)n, s_grp[g].dst)) {
             dbg("ovl: read error, group %d (%s), retrying\n", g, ps1_ovl_name[g]);
@@ -221,6 +262,7 @@ static void load(int g)
