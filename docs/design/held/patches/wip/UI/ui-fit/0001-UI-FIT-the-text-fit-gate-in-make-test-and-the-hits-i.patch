diff --git a/core/tests/textfit_engine.c b/core/tests/textfit_engine.c
new file mode 100644
index 0000000..0aef454
--- /dev/null
+++ b/core/tests/textfit_engine.c
@@ -0,0 +1,382 @@
+/* textfit_engine.c - the text-fit gate: runs every registered screen at both sizes in every language pack and
+ * collects (a) overflow, (b) cut words, (c) text covering other text or a block. API: doomo/textfit.h;
+ * documentation: docs/UI_TEXTFIT.md. The measuring uses the core's own metric functions (ui_text_width,
+ * ui_width_raw, the wrap rule of ui_text_wrap), which every port shares. */
+#include <stdarg.h>
+#include "test.h"
+#include "../src/fp_int.h"
+#include "../src/ui_internal.h"
+#include "textfit_engine.h"
+
+#define TF_MAX_RECTS 160
+
+typedef struct { int x, y, w, h; char what[48]; } TfRect;
+
+struct TfScreen {
+    TfReport *rep;
+    const char *name;
+    int sw, sh, lang;
+    char state[64];
+    TfRect runs[TF_MAX_RECTS], blocks[TF_MAX_RECTS];
+    int nruns, nblocks;
+};
+
+static struct { const char *name; TfScreenFn fn; } reg[64];
+static int nreg;
+
+void textfit_register(const char *name, TfScreenFn fn)
+{
+    if (nreg < (int)DOOMO_COUNTOF(reg)) { reg[nreg].name = name; reg[nreg].fn = fn; nreg++; }
+}
+
+int tf_sw(const TfScreen *s) { return s->sw; }
+int tf_sh(const TfScreen *s) { return s->sh; }
+int tf_big(const TfScreen *s) { return s->sh >= 200; }
+int tf_lang(const TfScreen *s) { return s->lang; }
+
+static void hit(TfScreen *s, const char *fmt, ...)
+{
+    char msg[220];
+    int i, bit = (s->sh >= 200 ? 16 : 0) + s->lang;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, ap);
+    va_end(ap);
+    for (i = 0; i < s->rep->nhits; i++)
+        if (strcmp(s->rep->hits[i].msg, msg) == 0) { s->rep->hits[i].mask |= 1u << bit; return; }
+    if (s->rep->nhits >= TF_MAX_HITS) { s->rep->dropped++; return; }
+    snprintf(s->rep->hits[s->rep->nhits].msg, sizeof(s->rep->hits[0].msg), "%s", msg);
+    s->rep->hits[s->rep->nhits].mask = 1u << bit;
+    s->rep->nhits++;
+}
+
+void tf_state(TfScreen *s, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(s->state, sizeof(s->state), fmt, ap);
+    va_end(ap);
+    s->nruns = s->nblocks = 0;
+}
+
+static int overlap(const TfRect *a, const TfRect *b)
+{
+    return a->x < b->x + b->w && b->x < a->x + a->w && a->y < b->y + b->h && b->y < a->y + a->h;
+}
+
+/* The wrap rule of ui_text_wrap (ui.c wrap_core), on text that is translated already: lines, and whether a
+ * line had to be cut inside a word. widest = the widest line in pixels. */
+static int wrap_sim(const char *t, int w, int *forced, int *widest)
+{
+    int maxc = w / FONT_ADVANCE, lines = 0;
+    const char *p = t;
+    if (maxc < 1) maxc = 1;
+    if (maxc > 63) maxc = 63;
+    *forced = 0;
+    *widest = 0;
+    while (*p) {
+        int n = 0, last_space = -1, len, adv;
+        char line[80];
+        while (p[n] && p[n] != '\n' && n < maxc) {
+            if (p[n] == ' ') last_space = n;
+            n++;
+        }
+        if (p[n] == 0 || p[n] == '\n') { len = n; adv = n + (p[n] == '\n'); }
+        else if (p[n] == ' ') { len = n; adv = n + 1; }
+        else if (last_space > 0) { len = last_space; adv = last_space + 1; }
+        else { len = n; adv = n; *forced = 1; }
+        memcpy(line, p, (size_t)len);
+        line[len] = 0;
+        if (ui_width_raw(line) > *widest) *widest = ui_width_raw(line);
+        lines++;
+        p += adv;
+    }
+    return lines;
+}
+
+int textfit_wrap(const char *t, int w, int *forced)
+{
+    int widest;
+    return wrap_sim(t, w, forced, &widest);
+}
+
+void tf_block(TfScreen *s, const char *what, int x, int y, int w, int h)
+{
+    TfRect *r;
+    if (s->nblocks >= TF_MAX_RECTS) return;
+    r = &s->blocks[s->nblocks++];
+    r->x = x; r->y = y; r->w = w; r->h = h;
+    snprintf(r->what, sizeof(r->what), "%s", what);
+}
+
+static void shorten(char *d, int cap, const char *s)
+{
+    int n = (int)strlen(s), i;
+    if (n > cap - 1) n = cap - 1;
+    for (i = 0; i < n; i++) d[i] = (unsigned char)s[i] < 32 ? '/' : s[i];
+    d[n] = 0;
+}
+
+/* What the draw code shows for str: the whole text's translation, or, with none, the runs between the A / B button
+ * icons and line breaks translated one by one (ui.c text_draw), which ui_text_width does not measure. */
+static const char *tf_tr(const char *str, char *out, int cap)
+{
+    const char *t = lang_tr(str);
+    int n = 0;
+    const char *p;
+    if (t != str || lang_get() == LANG_EN) return t;
+    for (p = str; *p;) {
+        char run[128];
+        int k = 0;
+        const char *r;
+        while (p[k] && p[k] != '\n' && (unsigned char)p[k] != ICON_BTN_A && (unsigned char)p[k] != ICON_BTN_B && k < 127) k++;
+        memcpy(run, p, (size_t)k);
+        run[k] = 0;
+        r = k ? lang_tr(run) : run;
+        while (*r && n < cap - 2) out[n++] = *r++;
+        p += k;
+        if (*p && n < cap - 2) out[n++] = *p++;
+    }
+    out[n] = 0;
+    return out;
+}
+
+void tf_text(TfScreen *s, const char *what, const char *str, int x, int y, int w, int maxlines, int flags)
+{
+    char squeezed[200], pieced[200];
+    const char *t = (flags & TF_RAW) ? str : (flags & TF_WRAP) ? lang_tr(str) : tf_tr(str, pieced, sizeof(pieced));
+    int lines = 1, pw, ph, px, over = 0;
+    TfRect r, *q;
+    char shown[64];
+    int i;
+    s->rep->checked++;
+    if (maxlines < 1) maxlines = 1;
+    if ((flags & TF_BAR) && ui_width_raw(t) > w) {
+        /* ui_hint's first rule: one space between items when the bar is too wide (ui.c); a cut is what is left */
+        int k, n = 0;
+        for (k = 0; t[k] && n < (int)sizeof(squeezed) - 1; k++)
+            if (!(t[k] == ' ' && n && squeezed[n - 1] == ' ')) squeezed[n++] = t[k];
+        squeezed[n] = 0;
+        t = squeezed;
+    }
+    shorten(shown, sizeof(shown), t);
+    if (flags & TF_WRAP) {
+        int forced;
+        lines = wrap_sim(t, w, &forced, &pw);
+        if (forced) hit(s, "%s [%s] / %s: a word is cut (wider than the %d px box): \"%s\"", s->name, s->state, what, w, shown);
+        if (lines > maxlines)
+            hit(s, "%s [%s] / %s: %d lines, the box has %d: \"%s\"", s->name, s->state, what, lines, maxlines, shown);
+    } else {
+        pw = ui_width_raw(t);
+        if (pw > w) {
+            over = pw - w;
+            hit(s, "%s [%s] / %s: %d px past a %d px box: \"%s\"", s->name, s->state, what, over, w, shown);
+        }
+        if (flags & TF_BAR) {
+            if (strchr(t, '\n')) hit(s, "%s [%s] / %s: a bar has a line break: \"%s\"", s->name, s->state, what, shown);
+        }
+    }
+    ph = lines * FONT_LINE - 1;
+    px = (flags & TF_RIGHT) ? x + w - pw : (flags & TF_CENTER) ? x + (w - pw) / 2 : x;
+    if (!over && (px < 0 || px + pw > s->sw || y < 0 || y + ph > s->sh))
+        hit(s, "%s [%s] / %s: off the %dx%d screen: \"%s\"", s->name, s->state, what, s->sw, s->sh, shown);
+    r.x = px; r.y = y; r.w = pw; r.h = ph;
+    snprintf(r.what, sizeof(r.what), "%s", what);
+    {
+        for (i = 0; i < s->nblocks; i++)
+            if (overlap(&r, &s->blocks[i]))
+                hit(s, "%s [%s]: \"%s\" (%s) covers %s", s->name, s->state, what, shown, s->blocks[i].what);
+        for (i = 0; i < s->nruns; i++)
+            if (overlap(&r, &s->runs[i]))
+                hit(s, "%s [%s]: \"%s\" overlaps \"%s\": \"%s\"", s->name, s->state, what, s->runs[i].what, shown);
+    }
+    if (s->nruns < TF_MAX_RECTS) { q = &s->runs[s->nruns++]; *q = r; }
+}
+
+void tf_fit(TfScreen *s, const char *what, int need_w, int avail_w)
+{
+    s->rep->checked++;
+    if (need_w > avail_w) hit(s, "%s [%s] / %s: needs %d px, has %d", s->name, s->state, what, need_w, avail_w);
+}
+
+/* ---- running ---------------------------------------------------------------------------------------------- */
+void textfit_set_size(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+}
+
+static void set_lang(int lang)
+{
+    doomo_town.opt[OPT_LANGUAGE] = (uint8_t)lang;
+    lang_flush();
+}
+
+void textfit_run_fn(TfReport *rep, const char *name, TfScreenFn fn, int w, int h, int lang)
+{
+    static TfScreen s;                      /* big: not on the stack */
+    memset(&s, 0, sizeof(s));
+    s.rep = rep; s.name = name; s.sw = w; s.sh = h; s.lang = lang;
+    snprintf(s.state, sizeof(s.state), "-");
+    rep->runs++;
+    fn(&s);
+}
+
+void textfit_run_all(TfReport *rep)
+{
+    static const int sizes[2][2] = { { 240, 160 }, { 320, 240 } };
+    int z, l, i;
+    memset(rep, 0, sizeof(*rep));
+    rep->screens = nreg;
+    for (z = 0; z < 2; z++) {
+        textfit_set_size(sizes[z][0], sizes[z][1]);
+        test_reset();
+        for (l = 0; l < LANG_COUNT; l++) {
+            if (l != LANG_EN && !doomo_lang_info[l].ready) continue;
+            set_lang(l);
+            for (i = 0; i < nreg; i++) textfit_run_fn(rep, reg[i].name, reg[i].fn, sizes[z][0], sizes[z][1], l);
+        }
+        set_lang(LANG_EN);
+    }
+    textfit_set_size(240, 160);
+}
+
+void textfit_format(const TfReport *rep, char *buf, int cap)
+{
+    int i, n = 0;
+    buf[0] = 0;
+    for (i = 0; i < rep->nhits && n < cap - 300; i++) {
+        char where[96];
+        int w = 0, l, z;
+        for (z = 0; z < 2; z++) {
+            int any = 0;
+            for (l = 0; l < LANG_COUNT; l++)
+                if (rep->hits[i].mask & (1u << (z * 16 + l))) {
+                    if (!any) w += snprintf(where + w, sizeof(where) - (size_t)w, "%s@%d:", w ? " " : "", z ? 320 : 240);
+                    any = 1;
+                    w += snprintf(where + w, sizeof(where) - (size_t)w, " %s", doomo_lang_info[l].code);
+                }
+        }
+        n += snprintf(buf + n, (size_t)(cap - n), "\n  (%s) %s", where, rep->hits[i].msg);
+    }
+    if (rep->dropped) snprintf(buf + n, (size_t)(cap - n), "\n  ... and %d more", rep->dropped);
+}
+
+/* ---- the gate's own tests: each fails without the rule it names ------------------------------------------ */
+static void st_overflow(TfScreen *s)
+{
+    tf_state(s, "x");
+    tf_text(s, "fits", "Hello", 10, 10, 60, 1, TF_ONE);                    /* 29 px in 60 */
+    tf_text(s, "wide", "This label is far too long for it", 10, 30, 60, 1, TF_ONE);
+}
+static void st_cut_word(TfScreen *s)
+{
+    tf_state(s, "x");
+    tf_text(s, "words", "Short words wrap fine here", 10, 10, 90, 3, TF_WRAP);
+    tf_text(s, "long word", "A Supercalifragilistic word", 10, 60, 60, 4, TF_WRAP);   /* 10 chars max, word is 20 */
+}
+static void st_lines(TfScreen *s)
+{
+    tf_state(s, "x");
+    tf_text(s, "tall", "one two three four five six seven eight nine ten", 10, 10, 60, 2, TF_WRAP);
+}
+static void st_cover(TfScreen *s)
+{
+    tf_state(s, "a");
+    tf_block(s, "cursor", 40, 10, 8, 8);
+    tf_text(s, "label", "Crosshair colour", 10, 10, 100, 1, TF_ONE);          /* runs under the cursor */
+    tf_text(s, "value", "Red", 12, 10, 30, 1, TF_ONE);                        /* and over the label */
+    tf_state(s, "b");                                                          /* a new state: nothing to cover */
+    tf_text(s, "alone", "Red", 12, 10, 30, 1, TF_ONE);
+}
+static void st_clean(TfScreen *s)
+{
+    tf_state(s, "x");
+    tf_text(s, "a", "Options", 10, 10, 100, 1, TF_ONE);
+    tf_text(s, "b", "Both rows fit and sit apart.", 10, 30, 120, 2, TF_WRAP);
+    tf_text(s, "c", "Right", 10, 60, 100, 1, TF_ONE | TF_RIGHT);
+    tf_block(s, "button", 150, 60, 20, 12);
+}
+
+static int self_run(TfScreenFn fn, TfReport *rep)
+{
+    memset(rep, 0, sizeof(*rep));
+    textfit_set_size(240, 160);
+    textfit_run_fn(rep, "self", fn, 240, 160, LANG_EN);
+    return rep->nhits;
+}
+
+static int has(const TfReport *r, const char *needle)
+{
+    int i;
+    for (i = 0; i < r->nhits; i++) if (strstr(r->hits[i].msg, needle)) return 1;
+    return 0;
+}
+
+TEST(textfit_engine_flags_overflow_cut_words_and_cover)
+{
+    static TfReport r;
+    CHECK_EQ(self_run(st_clean, &r), 0);
+    CHECK_EQ(self_run(st_overflow, &r), 1);
+    CHECK(has(&r, "wide") && has(&r, "px past a 60 px box"));
+    CHECK_EQ(self_run(st_cut_word, &r), 1);
+    CHECK(has(&r, "long word") && has(&r, "a word is cut"));
+    CHECK_EQ(self_run(st_lines, &r), 1);
+    CHECK(has(&r, "box has 2"));
+    CHECK_EQ(self_run(st_cover, &r), 2);
+    CHECK(has(&r, "covers cursor") && has(&r, "overlaps \"label\""));
+}
+
+/* a text with a button icon and no translation of its own is drawn with its pieces translated (ui.c text_draw), which
+ * ui_text_width does not count: the gate measures what is drawn */
+static int piece_w;
+static void st_pieces(TfScreen *s)
+{
+    tf_state(s, "x");
+    tf_text(s, "icon + word", STR_ICON_A "Options", 10, 10, piece_w, 1, TF_ONE);
+}
+TEST(textfit_engine_measures_translated_pieces)
+{
+    static TfReport r;
+    doomo_town.opt[OPT_LANGUAGE] = (uint8_t)LANG_ES;
+    lang_flush();
+    piece_w = 8 + ui_width_raw(lang_tr("Options"));          /* the cap is 8 px, then the Spanish word */
+    CHECK(piece_w > 8 + ui_width_raw("Options"));
+    textfit_set_size(240, 160);
+    memset(&r, 0, sizeof(r));
+    textfit_run_fn(&r, "self", st_pieces, 240, 160, LANG_ES);
+    CHECK_EQ(r.nhits, 0);
+    piece_w--;
+    textfit_run_fn(&r, "self", st_pieces, 240, 160, LANG_ES);
+    CHECK_EQ(r.nhits, 1);
+    doomo_town.opt[OPT_LANGUAGE] = LANG_EN;
+    lang_flush();
+}
+
+/* the gate's wrap simulation gives the line count ui_text_wrap draws, for English and every pack */
+TEST(textfit_wrap_matches_ui_text_wrap)
+{
+    static const char *const s[] = {
+        "Classic: L + D-pad looks. Modern: L/R strafe. Dual stick: left moves, right looks.",
+        "Cute: confetti, hearts, plush. Brutal: full Doom.", "One", "A\nB two\nthree", "Supercalifragilisticexpialidocious long word",
+        "Every first-time tip shows again, once, the next time you reach its place."
+    };
+    int i, w, l;
+    textfit_set_size(240, 160);
+    for (l = 0; l < 2; l++) {
+        doomo_town.opt[OPT_LANGUAGE] = (uint8_t)(l ? LANG_ES : LANG_EN);
+        lang_flush();
+        for (i = 0; i < (int)DOOMO_COUNTOF(s); i++)
+            for (w = 36; w <= 220; w += 23) {
+                int forced;
+                CHECK_MSG(textfit_wrap(lang_tr(s[i]), w, &forced) == ui_text_wrap(0, 0, w, s[i], 0, 0),
+                          "wrap of \"%s\" at %d: gate %d, draw %d", s[i], w, textfit_wrap(lang_tr(s[i]), w, &forced),
+                          ui_text_wrap(0, 0, w, s[i], 0, 0));
+            }
+    }
+    doomo_town.opt[OPT_LANGUAGE] = LANG_EN;
+    lang_flush();
+}
