diff --git a/core/src/fp_options.c b/core/src/fp_options.c
index deacf37..846bf7d 100644
--- a/core/src/fp_options.c
+++ b/core/src/fp_options.c
@@ -634,3 +634,93 @@ int fp_options_help_overflow(char *why, int cap)
     }
     return bad;
 }
+
+#if defined(DOOMO_TEXTFIT) && DOOMO_TEXTFIT
+/* (UI-FIT, docs/UI_TEXTFIT.md) every string of the Options screen with its real box, for the text-fit gate:
+ * the same geometry as opt_draw (x = 10, rows at x + 12, the help pill, the tab strip, the hint bar). */
+#include "doomo/textfit.h"
+#include "doomo/unlocks.h"
+
+static void tf_row(TfScreen *s, const char *label, const char *value, int raw)
+{
+    int sw = tf_sw(s), x0 = 10 + 12, rw = sw - 20 - 18, right = x0 + rw, y = 36;
+    int vw = ui_text_width(value);
+    tf_state(s, "row %s = %s", label, value);
+    tf_block(s, "left arrow", right - vw - 19, y, 6, 8);
+    tf_block(s, "right arrow", right - 8, y, 6, 8);
+    tf_text(s, "label", label, x0 + 2, y, rw - 2, 1, TF_ONE);
+    tf_text(s, "value", value, x0, y, rw - 11, 1, TF_ONE | TF_RIGHT | (raw ? TF_RAW : 0));
+}
+
+static void tf_help(TfScreen *s, const char *what, const char *h, int raw)
+{
+    tf_state(s, "help %s", what);
+    tf_text(s, what, h, 10 + 2, 36 + (tf_big(s) ? 13 : 7) * 11 + (tf_big(s) ? 6 : 3) + 2, tf_sw(s) - 20 - 4,
+            OPT_HELP_LINES, TF_WRAP | (raw ? TF_RAW : 0));
+}
+
+void fp_options_textfit(TfScreen *s)
+{
+    int sw = tf_sw(s), opt, v, i, first, count, k, p, nopt = OPT_COUNT + (OPT2_END - OPT2_FIRST);
+    char buf[160], name[64];
+    for (i = 0; i < nopt; i++) {
+        const DoomoOptionInfo *oi;
+        opt = i < OPT_COUNT ? i : OPT2_FIRST + i - OPT_COUNT;
+        oi = info_of(opt);
+        if (!oi->name) continue;
+        if (oi->values) {
+            for (v = 0; v < oi->count; v++) tf_row(s, oi->name, oi->values[v], 0);
+        } else {
+            doomo_snprintf(buf, sizeof(buf), "%d", oi->count - 1);
+            tf_row(s, oi->name, buf, 1);
+        }
+        doomo_snprintf(name, sizeof(name), "help of %s", oi->name);
+        if (opt == OPT_CONTROL_SCHEME || opt == OPT_TURN_SWAP || opt == OPT_CAMERA_DEFAULT) {
+            const char *const *a = opt == OPT_CONTROL_SCHEME ? help_controls : opt == OPT_TURN_SWAP ? help_turn : help_camera;
+            for (k = 0; k < PAD_COUNT; k++) tf_help(s, name, a[k], 0);
+        } else {
+            const char *h = help_of(opt);
+            if (h && h[0]) tf_help(s, name, h, 0);
+        }
+        for (v = 1; v < oi->count; v++) {              /* a locked value: "Next: ??? (how)" */
+            const DoomoUnlock *u = opt >= OPT_CHEAT_BIG_HEAD ? unlock_find(UL_CAT_CHEAT, 0, opt)
+                                                             : unlock_find(UL_CAT_SKIN, opt, v);
+            if (u && u->how) {
+                doomo_snprintf(buf, sizeof(buf), "Next: ??? (%s)", u->how);
+                doomo_snprintf(name, sizeof(name), "unlock hint of %s", oi->name);
+                tf_help(s, name, buf, 0);
+            }
+        }
+    }
+    for (p = 0; p < PRESET_N; p++) {
+        tf_row(s, "Preset", preset_name[p], 0);
+        tf_help(s, "preset help", preset_help[p], 0);
+    }
+    tf_row(s, STR_ICON_STAR " Reset page to defaults", "", 1);
+    tf_help(s, "reset help", "Put every setting on this page back.", 0);
+    tf_row(s, tips_reset_label, "", 1);
+    tf_help(s, "tips reset help", tips_reset_help, 0);
+    /* the page tabs: a window of 3 (240x160) or 5 (320x240) around the current page */
+    for (p = 0; p < OPTPAGE_COUNT; p++) {
+        int big = tf_big(s), cx = 10;
+        first = p > 2 ? p - 2 : 0;
+        count = big ? 5 : 3;
+        if (first + count > OPTPAGE_COUNT) first = OPTPAGE_COUNT - count;
+        tf_state(s, "tabs at page %d", p);
+        if (first > 0) tf_block(s, "left arrow", 2, 22, 6, 8);
+        if (first + count < OPTPAGE_COUNT) tf_block(s, "right arrow", sw - 8, 22, 6, 8);
+        for (k = 0; k < count; k++) {
+            int tw = ui_text_width(doomo_option_page_names[first + k]) + 10;
+            tf_text(s, "tab", doomo_option_page_names[first + k], cx + 5, 24, tw - 10, 1, TF_ONE);
+            cx += tw + 2;
+        }
+        tf_fit(s, "tab strip", cx - 2, first + count < OPTPAGE_COUNT ? sw - 10 : sw - 2);
+    }
+    tf_state(s, "hint row");
+    tf_text(s, "hint (row)", STR_ICON_ARROW_L STR_ICON_ARROW_R " Change  L/R Page  " STR_ICON_B " Done", 8, 0, sw - 16, 1, TF_BAR);
+    tf_state(s, "hint preset");
+    tf_text(s, "hint (preset)", STR_ICON_ARROW_L STR_ICON_ARROW_R " Pick  " STR_ICON_A " Apply  L/R Page  " STR_ICON_B " Done", 8, 0, sw - 16, 1, TF_BAR);
+    tf_state(s, "hint tips reset");
+    tf_text(s, "hint (tips reset)", tips_reset_hint, 8, 0, sw - 16, 1, TF_BAR);
+}
+#endif
