diff --git a/core/include/doomo/textfit.h b/core/include/doomo/textfit.h
new file mode 100644
index 0000000..e413eb0
--- /dev/null
+++ b/core/include/doomo/textfit.h
@@ -0,0 +1,63 @@
+/* textfit.h - the text-fit gate's registration API (owner: UI stream; docs/UI_TEXTFIT.md).
+ *
+ * A "screen" is a function that, for one screen size and one language, lists every UI string of that screen
+ * with the box it is drawn into and the other things drawn next to it. The gate (core/tests/textfit_engine.c)
+ * calls every registered screen at 240x160 and at 320x240 in every ready language pack, and fails on
+ *   (a) overflow: a text wider or taller than its box,
+ *   (b) a cut word: a wrapped text that has to break inside a word (a word wider than the box), or a single
+ *       line that the draw code would cut ("...", dropped words),
+ *   (c) cover: the drawn rectangle of a text run intersects a block (button, cursor, arrow, portrait) or the
+ *       drawn rectangle of another text run of the same state.
+ *
+ * A screen function only describes; it draws nothing. Strings are passed in English (the source literal):
+ * the gate translates them with lang_tr(), exactly as ui_text() does. Texts built at run time (snprintf of a
+ * number, a name) are passed already built with TF_RAW, in their longest form.
+ *
+ * A stream adds its screens in a test file of its own (core/tests/textfit_<stream>.c):
+ *
+ *     static void talk_screen(TfScreen *s)
+ *     {
+ *         tf_state(s, "answer list");
+ *         tf_text(s, "answer 1", "Tell me more", 12, 120, tf_sw(s) - 24, 1, TF_ONE);
+ *         tf_block(s, "portrait", 4, 100, 40, 40);
+ *     }
+ *     TEXTFIT_SCREEN(talk, talk_screen)
+ *
+ * The enumerator may live in the screen's own source file under `#if defined(DOOMO_TEXTFIT) && DOOMO_TEXTFIT` (the native core build
+ * defines it; the consoles do not, so it costs them no byte): then it can read the file's static tables. */
+#ifndef DOOMO_TEXTFIT_H
+#define DOOMO_TEXTFIT_H
+
+typedef struct TfScreen TfScreen;
+typedef void (*TfScreenFn)(TfScreen *s);
+
+enum {
+    TF_ONE    = 0,          /* one line, never wrapped (a label, a button, a hint bar) */
+    TF_WRAP   = 1,          /* wrapped on word boundaries into at most maxlines lines of width w */
+    TF_RIGHT  = 2,          /* right aligned in the box */
+    TF_CENTER = 4,          /* centred in the box */
+    TF_RAW    = 8,          /* already built / translated text: no lookup */
+    TF_BAR    = 16          /* the prompt bar: the draw code drops whole words past w, that is a cut */
+};
+
+int  tf_sw(const TfScreen *s);                 /* the screen size of this run */
+int  tf_sh(const TfScreen *s);
+int  tf_big(const TfScreen *s);                /* 1 at 320x240 (the draw code's `big`) */
+int  tf_lang(const TfScreen *s);               /* LANG_* of this run */
+/* Start a new group of things that are on screen together. Runs of different states are never compared. */
+void tf_state(TfScreen *s, const char *fmt, ...);
+/* A text: (x, y) top left of its box, w wide, maxlines lines tall (TF_ONE: 1). */
+void tf_text(TfScreen *s, const char *what, const char *str, int x, int y, int w, int maxlines, int flags);
+/* Something a text must not cover: a button, cursor, arrow, portrait, bar. */
+void tf_block(TfScreen *s, const char *what, int x, int y, int w, int h);
+
+/* Something that is not one text but must fit as a whole (a tab strip, a row of buttons): need_w px of
+ * content in avail_w px. */
+void tf_fit(TfScreen *s, const char *what, int need_w, int avail_w);
+
+void textfit_register(const char *name, TfScreenFn fn);
+#define TEXTFIT_SCREEN(name, fn)                                                   \
+    __attribute__((constructor)) static void tf_reg_##name(void)                   \
+    { textfit_register(#name, fn); }
+
+#endif
