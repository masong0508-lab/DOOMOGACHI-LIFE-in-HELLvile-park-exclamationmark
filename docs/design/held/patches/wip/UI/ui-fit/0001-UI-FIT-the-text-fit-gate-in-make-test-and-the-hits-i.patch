+/* textfit_engine.h - the text-fit gate's runner (see doomo/textfit.h for the API a screen uses). */
+#ifndef DOOMO_TEXTFIT_ENGINE_H
+#define DOOMO_TEXTFIT_ENGINE_H
+#include "doomo/textfit.h"
+
+#define TF_MAX_HITS 600
+typedef struct {
+    char     msg[220];          /* what is wrong, without size and language */
+    uint32_t mask;              /* bit (size * 16 + lang): where it happens */
+} TfHit;
+typedef struct {
+    TfHit hits[TF_MAX_HITS];
+    int   nhits, dropped;       /* dropped: hits past TF_MAX_HITS */
+    int   checked;              /* texts measured */
+    int   screens, runs;        /* screens and (screen, size, language) runs */
+} TfReport;
+
+/* Run one screen function at one size and language into rep. */
+void textfit_run_fn(TfReport *rep, const char *name, TfScreenFn fn, int w, int h, int lang);
+/* Run every registered screen at both sizes in every ready language; the screen size is left at 240x160 and
+ * the language at English. */
+void textfit_run_all(TfReport *rep);
+/* The hit list, one line per hit with where it happens ("es fr @240"), into buf. */
+void textfit_format(const TfReport *rep, char *buf, int cap);
+/* The wrapped line count the gate's own wrapper computes (the same rule as ui_text_wrap); *forced = 1 when the
+ * text must be cut inside a word. For the tests that keep the two in step. */
+int  textfit_wrap(const char *t, int w, int *forced);
+void textfit_set_size(int w, int h);
+
+#endif
