+/* textfit_screens.c - the shared screens of the text-fit gate (docs/UI_TEXTFIT.md) and the gate itself.
+ *
+ * Registered here: the Options screen (its enumerator sits in fp_options.c next to the geometry), the shared
+ * pause menu, and a scan of the source: every literal that goes to ui_hint(), ui_confirm() or a fixed-width
+ * ui_button() in the core sources is measured in its real box, so a new hint or prompt is covered the day it is
+ * written. Other streams add theirs in textfit_<stream>.c (doomo/textfit.h). */
+#include <dirent.h>
+#include <stdlib.h>
+#include "test.h"
+#include "../src/fp_int.h"
+#include "../src/ui_internal.h"
+#include "textfit_engine.h"
+
+void fp_options_textfit(TfScreen *s);
+TEXTFIT_SCREEN(options, fp_options_textfit)
+void fp_shop_textfit(TfScreen *s);
+TEXTFIT_SCREEN(shop, fp_shop_textfit)
+void fp_title_textfit(TfScreen *s);
+TEXTFIT_SCREEN(title, fp_title_textfit)
+
+/* ---- the shared pause menu: the labels that the callers pass (combat_scene.c, levels_play.c, arena_modes.c,
+ * mg.c; "Weapons: <name>" holds the player's own weapon name, which the menu cuts with "..." on purpose) ---- */
+static const char *const pause_labels[] = {
+    "Resume", "Music: off", "Music volume 10", "Camera: 1st person", "Camera: 3rd person", "Options",
+    "Quit level", "Restart level", "Give up", "Quit"
+};
+
+static void pause_screen(TfScreen *s)
+{
+    int n, big = tf_big(s), w = big ? 200 : 176, i, x = tf_sw(s) / 2 - w / 2;
+    tf_state(s, "pause menu");
+    for (n = 0; n < (int)DOOMO_COUNTOF(pause_labels); n++) {
+        int row = big ? 18 : 16, h, y;
+        (void)i;
+        h = 8 * row + 24;
+        y = tf_sh(s) / 2 - h / 2 + 2;
+        tf_state(s, "pause label %s", pause_labels[n]);
+        /* the button is x+16 .. x+w-16; the draw code cuts a label wider than w - 44 with "..." */
+        tf_text(s, "button label", pause_labels[n], x + 16, y + 12, w - 44, 1, TF_ONE | TF_CENTER);
+        tf_block(s, "left arrow", x + 6, y + 15, 6, 8);
+        tf_block(s, "right arrow", x + w - 12, y + 15, 6, 8);
+    }
+    tf_state(s, "pause title");
+    tf_text(s, "title", "PAUSED", x, 0, w, 1, TF_ONE | TF_CENTER);
+    tf_state(s, "pause hint 1");
+    tf_text(s, "hint (A B)", STR_ICON_A " Select  " STR_ICON_B " Resume", 8, 0, tf_sw(s) - 16, 1, TF_BAR);
+    tf_state(s, "pause hint 2");
+    tf_text(s, "hint (L R)", STR_ICON_A " Select  " STR_ICON_ARROW_L STR_ICON_ARROW_R " Change  " STR_ICON_B " Resume",
+            8, 0, tf_sw(s) - 16, 1, TF_BAR);
+}
+TEXTFIT_SCREEN(pause, pause_screen)
+
+/* ---- the source scan ---------------------------------------------------------------------------------------- */
+#define SC_MAX 700
+typedef struct { char file[40]; int line; int kind; char text[200]; int w; } ScanItem;
+enum { SC_HINT, SC_CONFIRM, SC_BUTTON, SC_TITLE };
+static ScanItem scan[SC_MAX];
+static int nscan;
+static int scanned;
+
+static const struct { const char *name; const char *val; } macros[] = {
+    { "STR_ICON_HEART", STR_ICON_HEART }, { "STR_ICON_SKULL", STR_ICON_SKULL }, { "STR_ICON_STAR", STR_ICON_STAR },
+    { "STR_ICON_COIN", STR_ICON_COIN }, { "STR_ICON_CROSS", STR_ICON_CROSS }, { "STR_ICON_PENTA", STR_ICON_PENTA },
+    { "STR_ICON_NOTE", STR_ICON_NOTE }, { "STR_ICON_A", STR_ICON_A }, { "STR_ICON_B", STR_ICON_B },
+    { "STR_ICON_FIRE", STR_ICON_FIRE }, { "STR_ICON_GHOST", STR_ICON_GHOST }, { "STR_ICON_ARROW_R", STR_ICON_ARROW_R },
+    { "STR_ICON_ARROW_L", STR_ICON_ARROW_L }, { "STR_ICON_ARROW_U", STR_ICON_ARROW_U },
+    { "STR_ICON_ARROW_D", STR_ICON_ARROW_D }, { "STR_ICON_SMILE", STR_ICON_SMILE }, { "STR_ICON_FROWN", STR_ICON_FROWN },
+    { "STR_ICON_DROP", STR_ICON_DROP }, { "STR_ICON_BOLT", STR_ICON_BOLT }, { "STR_ICON_FOOD", STR_ICON_FOOD },
+    { "STR_ICON_ZZZ", STR_ICON_ZZZ }, { "STR_ICON_SPARK", STR_ICON_SPARK }, { "STR_ICON_BOMB", STR_ICON_BOMB },
+    { "STR_ICON_GUN", STR_ICON_GUN }, { "STR_ICON_WRENCH", STR_ICON_WRENCH }, { "STR_ICON_EGG", STR_ICON_EGG },
+    { "STR_ICON_HOUSE", STR_ICON_HOUSE }, { "STR_ICON_CLOUD", STR_ICON_CLOUD }, { "STR_ICON_CHECK", STR_ICON_CHECK },
+    { "STR_ICON_X", STR_ICON_X }
+};
+
+static const char *skip_ws(const char *p)
+{
+    for (;;) {
+        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
+        if (p[0] == '/' && p[1] == '*') { p += 2; while (*p && !(p[0] == '*' && p[1] == '/')) p++; if (*p) p += 2; continue; }
+        if (p[0] == '/' && p[1] == '/') { while (*p && *p != '\n') p++; continue; }
+        return p;
+    }
+}
+
+/* One argument made only of string literals and STR_ICON_ names (concatenated): decoded into out. Returns the
+ * position after it, or NULL when the argument is anything else (a variable, a ternary, a call). */
+static const char *parse_lit_arg(const char *p, char *out, int cap)
+{
+    int n = 0, any = 0;
+    for (;;) {
+        p = skip_ws(p);
+        if (*p == '"') {
+            p++;
+            while (*p && *p != '"') {
+                int c = (unsigned char)*p++;
+                if (c == '\\') {
+                    c = (unsigned char)*p++;
+                    if (c == 'n') c = '\n';
+                    else if (c == 't') c = '\t';
+                    else if (c == 'x') {
+                        c = 0;
+                        while ((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F'))
+                            c = c * 16 + (*p >= 'a' ? *p - 'a' + 10 : *p >= 'A' ? *p - 'A' + 10 : *p - '0'), p++;
+                    }
+                    else if (c >= '0' && c <= '7') { c -= '0'; while (*p >= '0' && *p <= '7') c = c * 8 + *p++ - '0'; }
+                }
+                if (n < cap - 1) out[n++] = (char)c;
+            }
+            if (*p != '"') return NULL;
+            p++;
+            any = 1;
+        } else if (strncmp(p, "STR_ICON_", 9) == 0) {
+            int k, len = 0;
+            while ((p[len] >= 'A' && p[len] <= 'Z') || p[len] == '_' || (p[len] >= '0' && p[len] <= '9')) len++;
+            for (k = 0; k < (int)DOOMO_COUNTOF(macros); k++)
+                if ((int)strlen(macros[k].name) == len && strncmp(macros[k].name, p, (size_t)len) == 0) break;
+            if (k == (int)DOOMO_COUNTOF(macros)) return NULL;
+            if (n < cap - 1) out[n++] = macros[k].val[0];
+            p += len;
+            any = 1;
+        } else break;
+    }
+    out[n] = 0;
+    p = skip_ws(p);
+    return any && (*p == ',' || *p == ')') ? p : NULL;
+}
+
+/* the start of argument k (0-based) of the call whose '(' is at p; NULL if there are fewer */
+static const char *nth_arg(const char *p, int k)
+{
+    int depth = 0, in_str = 0, arg = 0;
+    p++;                                           /* after the '(' */
+    if (k == 0) return p;
+    for (; *p; p++) {
+        if (in_str) { if (*p == '\\' && p[1]) p++; else if (*p == '"') in_str = 0; }
+        else if (*p == '"') in_str = 1;
+        else if (*p == '\'') { p++; if (*p == '\\') p++; }
+        else if (*p == '(' || *p == '[' || *p == '{') depth++;
+        else if (*p == ')' || *p == ']' || *p == '}') { if (depth == 0) return NULL; depth--; }
+        else if (*p == ',' && depth == 0 && ++arg == k) return p + 1;
+    }
+    return NULL;
+}
+
+static void add(const char *file, int line, int kind, const char *text, int w)
+{
+    int i;
+    for (i = 0; i < nscan; i++)
+        if (scan[i].kind == kind && scan[i].w == w && strcmp(scan[i].text, text) == 0) return;   /* same text, same box */
+    if (nscan >= SC_MAX) return;
+    snprintf(scan[nscan].file, sizeof(scan[0].file), "%s", file);
+    scan[nscan].line = line;
+    scan[nscan].kind = kind;
+    scan[nscan].w = w;
+    snprintf(scan[nscan].text, sizeof(scan[0].text), "%s", text);
+    nscan++;
+}
+
+static void scan_file(const char *name, const char *src)
+{
+    static const struct { const char *fn; int kind; } calls[] = {
+        { "ui_hint(", SC_HINT }, { "ui_confirm(", SC_CONFIRM }, { "ui_button(", SC_BUTTON }, { "ui_button_off(", SC_BUTTON }, { "ui_title(", SC_TITLE }
+    };
+    int c;
+    for (c = 0; c < (int)DOOMO_COUNTOF(calls); c++) {
+        const char *p = src;
+        size_t fl = strlen(calls[c].fn);
+        while ((p = strstr(p, calls[c].fn)) != NULL) {
+            const char *open = p + fl - 1, *a;
+            char text[200];
+            int line = 1, w = 0;
+            const char *q;
+            if (p > src && ((p[-1] >= 'a' && p[-1] <= 'z') || p[-1] == '_' || (p[-1] >= '0' && p[-1] <= '9'))) { p += fl; continue; }
+            for (q = src; q < p; q++) if (*q == '\n') line++;
+            p += fl;
+            if (calls[c].kind == SC_BUTTON) {                  /* ui_button(x, y, <width>, "label", ...) */
+                a = nth_arg(open, 2);
+                if (!a) continue;
+                a = skip_ws(a);
+                if (!(*a >= '0' && *a <= '9')) continue;
+                w = atoi(a);
+                a = nth_arg(open, 3);
+                if (!a || !parse_lit_arg(a, text, sizeof(text))) continue;
+            } else if (calls[c].kind == SC_TITLE) {                /* ui_title(cx, y, "text", style) */
+                a = nth_arg(open, 2);
+                if (!a || !parse_lit_arg(a, text, sizeof(text))) continue;
+            } else {
+                a = skip_ws(open + 1);
+                if (!parse_lit_arg(a, text, sizeof(text))) continue;
+            }
+            add(name, line, calls[c].kind, text, w);
+        }
+    }
+}
+
+static void scan_sources(void)
+{
+    char dir[512], path[600];
+    DIR *d;
+    struct dirent *e;
+    if (scanned) return;
+    scanned = 1;
+    snprintf(dir, sizeof(dir), "%s/../../src", test_golden_dir);
+    d = opendir(dir);
+    if (!d) return;
+    while ((e = readdir(d)) != NULL) {
+        size_t n = strlen(e->d_name);
+        FILE *f;
+        long len;
+        char *buf;
+        if (n < 3 || strcmp(e->d_name + n - 2, ".c") != 0) continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        f = fopen(path, "rb");
+        if (!f) continue;
+        fseek(f, 0, SEEK_END);
+        len = ftell(f);
+        fseek(f, 0, SEEK_SET);
+        buf = (char *)malloc((size_t)len + 1);
+        if (buf && fread(buf, 1, (size_t)len, f) == (size_t)len) { buf[len] = 0; scan_file(e->d_name, buf); }
+        free(buf);
+        fclose(f);
+    }
+    closedir(d);
+}
+
+/* hints that the code draws only on a bigger screen (`big &&` before them): their first words, and the
+ * smallest screen width they are drawn at */
+static const struct { const char *text; int min_w; } big_only[] = {
+    { "\x88\x87 Pick  " STR_ICON_A " Go!  START Name  L/R Villager", 320 }          /* fp_newisland.c, big only */
+};
+static int hint_not_drawn_here(const ScanItem *it, int sw)
+{
+    int k;
+    for (k = 0; k < (int)DOOMO_COUNTOF(big_only); k++)
+        if (strncmp(it->text, big_only[k].text, strlen(big_only[k].text)) == 0 && sw < big_only[k].min_w) return 1;
+    return 0;
+}
+
+static void scan_screen(TfScreen *s)
+{
+    int i, sw = tf_sw(s), sh = tf_sh(s);
+    scan_sources();
+    for (i = 0; i < nscan; i++) {
+        const ScanItem *it = &scan[i];
+        char what[80];
+        snprintf(what, sizeof(what), "%.40s:%d", it->file, it->line);
+        tf_state(s, "%s", what);
+        if (it->kind == SC_HINT) {
+            /* ui_hint: one space between items first, then whole words go (ui.c); a cut is a hit */
+            if (hint_not_drawn_here(it, sw)) continue;
+            tf_text(s, "hint bar", it->text, 8, sh - 11, sw - 16, 1, TF_BAR);
+        } else if (it->kind == SC_CONFIRM) {
+            /* ui_confirm (ui_modal.c): the window is min(sw-32, 220) wide; the height is made for the line count
+             * at w-20, the text is drawn wrapped at w-24 from y+11; the buttons sit at y+h-22 */
+            int w = DOOMO_MIN(sw - 32, 220), x = (sw - w) / 2, lines, h, y, forced;
+            const char *t = lang_tr(it->text);
+            lines = ui_text_wrap(0, 0, w - 24, it->text, 0, 0);
+            h = lines * FONT_LINE + 44;
+            y = (sh - h) / 2 - 4;
+            (void)forced;
+            tf_block(s, "Yes / No buttons", x, y + h - 22, w, 14);
+            tf_text(s, "question", t, x + 12, y + 11, w - 24, lines, TF_WRAP | TF_RAW);
+            if (y < 0 || y + h > sh) tf_fit(s, "confirm window height", h, sh);
+        } else if (it->kind == SC_TITLE) {
+            /* a title pill is centred on the screen: its text, 9 px of pill each side, fits the screen */
+            tf_text(s, "title", it->text, 9, 3, sw - 18, 1, TF_ONE | TF_CENTER);
+        } else {
+            /* a button of fixed width: the label centred, a pill border of 3 px each side */
+            tf_text(s, "button label", it->text, (sw - it->w) / 2 + 3, 40, it->w - 6, 1, TF_ONE | TF_CENTER);
+        }
+    }
+}
+TEXTFIT_SCREEN(scanned_hints_prompts_buttons, scan_screen)
+
+/* ---- the gate ----------------------------------------------------------------------------------------------- */
+TEST(textfit_gate_every_shared_screen_fits_in_every_language)
+{
+    static TfReport rep;
+    static char list[24000];
+    textfit_run_all(&rep);
+    textfit_format(&rep, list, sizeof(list));
+    if (rep.nhits) {
+        static char msg[26000];
+        snprintf(msg, sizeof(msg), "%d text-fit hits (%d texts, %d runs of %d screens):%s", rep.nhits + rep.dropped,
+                 rep.checked, rep.runs, rep.screens, list);
+        test_fail(__FILE__, __LINE__, msg);
+    }
+}
+
+/* the scan really finds the literals (a scan that finds nothing would pass the gate for nothing) */
+TEST(textfit_scan_finds_the_hints_prompts_and_buttons)
+{
+    int i, h = 0, c = 0, b = 0;
+    scan_sources();
+    for (i = 0; i < nscan; i++) { h += scan[i].kind == SC_HINT; c += scan[i].kind == SC_CONFIRM; b += scan[i].kind == SC_BUTTON; }
+    CHECK_MSG(h >= 20 && c >= 5 && b >= 2, "scan found %d hints, %d confirms, %d buttons", h, c, b);
+}
