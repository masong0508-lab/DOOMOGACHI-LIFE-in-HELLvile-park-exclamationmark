+/* the detail card: a window over the page, the long explanation, and where the row stands */
+static void draw_card(int sw, int style, int id)
+{
+    const UiStyle *st = ui_style(style);
+    int big = fp_big(), cx = 14, cw = sw - 28, cy = big ? 40 : 28, ch = big ? 150 : 100, tx = cx + 10, tw = cw - 20;
+    const char *text, *name;
+    char val[24], buf[80];
+    ui_window(cx, cy, cw, ch, style);
+    if (id == ROW_PRESET) { name = preset_name[O.preset]; text = preset_card[O.preset]; }
+    else { name = info_of(id)->name; text = card_of(id); }
+    ui_text(tx, cy + 6, name, st->accent);
+    plat_rect(tx, cy + 17, tw, 1, st->outline);
+    if (text) fp_wrap_lines(tx, cy + 21, tw, text, st->text, 6);
+    if (id == ROW_PRESET) {
+        fp_wrap_lines(tx, cy + ch - 34, tw, preset_card_end, st->text_dim, 3);
+    } else {
+        const DoomoOptionInfo *oi = info_of(id);
+        char dv[24];
+        doomo_snprintf(buf, sizeof(buf), "%s: %s", lang_tr("Now"), lang_tr(value_text(id, opt_get(id), 0, val, (int)sizeof(val))));
+        ui_text(tx, cy + ch - 24, buf, st->text);
+        doomo_snprintf(buf, sizeof(buf), "%s: %s", lang_tr("Default"), lang_tr(value_text(id, oi->def, 0, dv, (int)sizeof(dv))));
+        ui_text(tx, cy + ch - 14, buf, st->text_dim);
     }
 }
 
