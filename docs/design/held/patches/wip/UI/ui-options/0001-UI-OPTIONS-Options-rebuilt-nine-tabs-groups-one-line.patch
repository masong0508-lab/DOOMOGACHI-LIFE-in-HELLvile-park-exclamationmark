+/* ---- live previews (under the help line, only where they cost a swatch or one text line) ---------------- */
+enum { PV_NONE, PV_CROSS, PV_FOV, PV_TEXT, PV_CLOCK, PV_HUD };
+static int preview_of(int id)
+{
+    switch (id) {
+    case OPT_CROSSHAIR: case OPT_CROSSHAIR_COLOR: return PV_CROSS;
+    case OPT_FOV: return PV_FOV;
+    case OPT_TEXT_SPEED: return PV_TEXT;
+    case OPT_CLOCK_24H: return PV_CLOCK;
+    case OPT_HUD_LAYOUT: return PV_HUD;
+    }
+    return PV_NONE;
+}
+
+static const char pv_label[] = "Preview";
+static const char pv_sample[] = "Hi! I'm your Boreagotchi. Feed me?";
+static const char pv_clock12[] = "3:07 PM";
+static const char pv_clock24[] = "15:07";
+static const char *const pv_hud[4] = {
+    STR_ICON_HEART STR_ICON_HEART STR_ICON_HEART "  24", "HEALTH 100%   AMMO 24", "100 / 24", "Crosshair only"
+};
+static const uint8_t pv_cross_col[6] = { PAL_WHITE, PAL_PAINT(PAINT_BUBBLEGUM, 2), PAL_UI_MINT, PAL_UI_GOLD,
+                                         PAL_UI_RED, PAL_PAINT(PAINT_CYAN, 2) };
+
+/* the crosshair in its colour, small (the shooter's own is combat_hud.c's: same shapes, no spread) */
+static void pv_crosshair(int cx, int cy, int kind, uint8_t col)
+{
+    int a;
+    switch (kind) {
+    case 0: plat_rect(cx - 1, cy - 1, 3, 3, PAL_BLACK); plat_rect(cx, cy, 1, 1, col); break;
+    case 1:
+        plat_rect(cx - 7, cy - 1, 4, 3, PAL_BLACK); plat_rect(cx + 4, cy - 1, 4, 3, PAL_BLACK);
+        plat_rect(cx - 1, cy - 7, 3, 4, PAL_BLACK); plat_rect(cx - 1, cy + 4, 3, 4, PAL_BLACK);
+        plat_rect(cx - 6, cy, 3, 1, col); plat_rect(cx + 4, cy, 3, 1, col);
+        plat_rect(cx, cy - 6, 1, 3, col); plat_rect(cx, cy + 4, 1, 3, col);
+        break;
+    case 2:
+        for (a = 0; a < 4096; a += 256) plat_rect(cx + FIX2INT(fx_cos(a) * 5), cy + FIX2INT(fx_sin(a) * 5), 1, 1, col);
+        plat_rect(cx, cy, 1, 1, col);
+        break;
+    case 3: ui_heart(cx, cy, 4, col); break;
+    case 4: ui_star(cx, cy, 5, col); break;
+    case 5: plat_text(cx - 4, cy - 4, STR_ICON_SKULL, col); break;
+    case 6:
+        plat_rect(cx - 3, cy, 7, 4, col);
+        plat_rect(cx - 5, cy - 3, 2, 3, col); plat_rect(cx - 2, cy - 5, 2, 3, col);
+        plat_rect(cx + 1, cy - 5, 2, 3, col); plat_rect(cx + 4, cy - 3, 2, 3, col);
+        break;
+    default: break;
+    }
+}
+
+static void draw_preview(int pv, int x, int y, int w, int h, const UiStyle *st)
+{
+    char buf[40];
+    int v;
+    fp_pill(x - 4, y, w + 8, h, st->fill, st->outline, st->fill_hi);
+    ui_text(x + 2, y + (h - FONT_LINE) / 2, pv_label, st->text_dim);
+    x += 64;
+    y += (h - FONT_LINE) / 2;
+    switch (pv) {
+    case PV_CROSS:
+        v = opt_get(OPT_CROSSHAIR_COLOR);
+        if (opt_get(OPT_CROSSHAIR) > 6) ui_text(x, y, "None", st->text);
+        else pv_crosshair(x + 20, y + 4, opt_get(OPT_CROSSHAIR), pv_cross_col[v >= 0 && v < 6 ? v : 0]);
+        break;
+    case PV_FOV: {                                   /* a frame as wide as the view: Narrow, Normal, Wide */
+        static const uint8_t fw[3] = { 36, 60, 84 };
+        int fv = opt_get(OPT_FOV), pw = fw[fv >= 0 && fv < 3 ? fv : 1], px = x + 45 - pw / 2, py = y - 1;
+        plat_rect(px, py, pw, 1, st->accent); plat_rect(px, py + 9, pw, 1, st->accent);
+        plat_rect(px, py, 1, 10, st->accent); plat_rect(px + pw - 1, py, 1, 10, st->accent);
+        break;
+    }
+    case PV_TEXT: {                                  /* one sample line typed at the chosen speed */
+        static const uint8_t per4[4] = { 1, 3, 6, 255 };      /* letters per 4 ticks: Slow, Normal, Fast, Instant */
+        int n = (int)sizeof(pv_sample) - 1, ts = opt_get(OPT_TEXT_SPEED), shown;
+        ts = DOOMO_CLAMP(ts, 0, 3);
+        shown = ts == 3 ? n : (O.t * per4[ts] / 4) % (n + 4 * per4[ts] + 8);    /* typed, then it rests */
+        if (shown > n) shown = n;
+        memcpy(buf, pv_sample, (size_t)shown);
+        buf[shown] = 0;
+        ui_text(x, y, buf, st->text);
+        break;
+    }
+    case PV_CLOCK:
+        ui_text(x, y, opt_get(OPT_CLOCK_24H) ? pv_clock24 : pv_clock12, st->text);
+        break;
+    case PV_HUD:
+        v = opt_get(OPT_HUD_LAYOUT);
+        ui_text(x, y, pv_hud[v >= 0 && v < 4 ? v : 0], st->text);
+        break;
+    default: break;
+    }
+}
+
+/* ---- the tab strip: every page, the open one by name ------------------------------------------------- */
+static void draw_tabs(int x, int y, int sw, int style)
+{
+    const UiStyle *st = ui_style(style);
+    int p, cx = x + 4;
+    char lab[24];
+    ui_text(2, y + 1, STR_ICON_ARROW_L, st->accent);
+    ui_text(sw - 9, y + 1, STR_ICON_ARROW_R, st->accent);
+    for (p = 0; p < OPTPAGE_COUNT; p++) {
+        if (p == O.page) {
+            int tw;
+            doomo_snprintf(lab, sizeof(lab), "%s %s", page_icon[p], lang_tr(doomo_option_page_names[p]));
+            tw = ui_text_width(lab) + 8;
+            fp_shadow(cx + 1, y - 1, tw, 13);
+            fp_pill(cx, y - 2, tw, 13, st->accent, ui_darker(ui_darker(st->accent)), ui_lighter(st->accent));
+            ui_text_shadow(cx + 4, y + 1, lab, PAL_WHITE, ui_darker(st->accent));
+            cx += tw + 2;
+        } else {
+            int tw = ui_text_width(page_icon[p]) + 6;
+            fp_pill(cx, y, tw, 11, st->fill_lo, st->outline, st->fill_hi);
+            ui_text(cx + 3, y + 2, page_icon[p], st->text_dim);
+            cx += tw + 1;
+        }
+    }
+}
+
+/* ---- the hint bar: at most three actions ------------------------------------------------------------ */
+static void draw_hint(int style, int id)
+{
+    UiPrompt p[3];
+    int n = 0, info = input_pad() == PAD_DC ? BTN_X : BTN_SELECT;
+#define PR(b, pr, v) do { p[n].btn = (uint16_t)(b); p[n].prio = (pr); p[n].verb = (v); n++; } while (0)
+    if (O.card) {
+        PR(BTN_LEFT | BTN_RIGHT, 0, "Change");
+        if (id >= 0 && row_resettable(id)) PR(BTN_Y, 1, "Reset");
+        PR(BTN_B, 0, "Close");
+    } else if (id == ROW_PRESET) {
+        PR(BTN_A, 0, "Apply"); PR(info, 1, "Info"); PR(BTN_B, 0, "Back");
+    } else if (id == ROW_TIPS_RESET || id < 0) {
+        PR(BTN_A, 0, "Reset"); PR(BTN_L | BTN_R, 1, "Page"); PR(BTN_B, 0, "Back");
+    } else {
+        PR(BTN_LEFT | BTN_RIGHT, 0, "Change");
+        if (row_changed(id) && row_resettable(id)) PR(BTN_Y, 1, "Reset");
+        else if (row_has_card(id)) PR(info, 1, "Info");
+        else PR(BTN_L | BTN_R, 1, "Page");
+        PR(BTN_B, 0, "Back");
+    }
+#undef PR
+    ui_prompts(p, n, style);
+}
+
+/* the help line's text: what the row does, or what the next locked value needs (c = its colour) */
+static const char *help_line(int id, uint8_t *c, const UiStyle *st)
+{
+    const char *help = reset_page_help;
+    *c = st->text_dim;
+    if (id == ROW_PRESET) return preset_help[O.preset];
+    if (id == ROW_TIPS_RESET) return tips_reset_help;
+    if (id >= 0) {
+        int v = opt_get(id), k;
+        const DoomoOptionInfo *oi = info_of(id);
+        help = help_of(id);
+        for (k = 1; k < oi->count; k++) {
+            int nv = (v + k) % oi->count;
+            if (!value_ok(id, nv)) {
+                const DoomoUnlock *u = id >= OPT_CHEAT_BIG_HEAD ? unlock_find(UL_CAT_CHEAT, 0, id)
+                                                                : unlock_find(UL_CAT_SKIN, id, nv);
+                if (u && u->how && k == 1) {
+                    doomo_snprintf(fp_tmp, sizeof(fp_tmp), "Next: ??? (%s)", u->how);
+                    help = fp_tmp;
+                    *c = PAL_UI_GOLD;
+                }
+                break;
+            }
+        }
+    }
+    return help;
+}
+
+/* a row's value as text: a name as it is (constant text: lang_tr() remembers its translation, L1), a number or
+ * (bar) the slider's bar built in val */
+static const char *value_text(int id, int v, int bar, char *val, int cap)
+{
+    const DoomoOptionInfo *oi = info_of(id);
+    if (bar && id >= OPT_MUSIC_VOL && id <= OPT_VOICE_VOL) {
+        int k;
+        for (k = 0; k < 10 && k + 1 < cap; k++) val[k] = k < v ? '|' : '.';
+        val[k] = 0;
+        return val;
+    }
+    if (oi->values) return oi->values[v];
+    doomo_snprintf(val, (size_t)cap, "%d", v);
+    return val;
+}
