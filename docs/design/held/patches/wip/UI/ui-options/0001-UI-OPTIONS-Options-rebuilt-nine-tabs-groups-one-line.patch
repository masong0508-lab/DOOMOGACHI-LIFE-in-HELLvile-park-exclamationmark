diff --git a/core/tests/test_ui_options.c b/core/tests/test_ui_options.c
new file mode 100644
index 0000000..cd16b6e
--- /dev/null
+++ b/core/tests/test_ui_options.c
@@ -0,0 +1,318 @@
+/* test_ui_options.c - UI-OPTIONS (docs/design/UI_PLAN.md section 4): the Options screen's census and behaviour.
+ * Every option has exactly one page and a place on it, no page lists more than 12 rows, every help line is one
+ * line at both sizes in every ready language, every default loads, old saves (the ids) still mean the same, the
+ * cursor skips the group headers, Y puts one row back (never Language or Monster Mode), SELECT opens the detail
+ * card, and the page left is the page Options opens on again. */
+#include "test.h"
+#include "../src/fp_int.h"
+#include "doomo/options_store.h"
+#include "doomo/ending.h"
+#include "doomo/lang.h"
+
+int  fp_options_help_overflow(char *why, int cap);
+int  fp_options_page_rows(int page, uint8_t *out, int cap, int all);
+int  fp_options_cur(void);
+int  fp_options_page(void);
+int  fp_options_card_open(void);
+const char *fp_options_counter(void);
+
+#define ROW_PRESET 100
+#define ROW_TIPS_RESET 101
+#define ROW_HDR 128
+#define PAGE_ROWS_MAX 12
+#define CHEAT_ROWS_MAX 13     /* the page of the 12 cheats and the Slider range (UI_PLAN 4.1) */
+
+static void set_res(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+}
+static void frames(uint32_t b, int n)
+{
+    int i;
+    for (i = 0; i < n; i++) { plat_begin_frame(); doomo_frame(b); plat_end_frame(); }
+}
+static void press(uint32_t b) { frames(b, 1); frames(0, 1); }
+static void fresh(int page)
+{
+    test_reset();
+    opt_defaults();
+    scene_set(&SCENE_OPTIONS, page);
+    frames(0, 3);
+}
+/* DOWN until the cursor is on row id (-1: the page's reset row) */
+static int goto_row(int id)
+{
+    int i;
+    for (i = 0; i < 40 && fp_options_cur() != id; i++) press(BTN_DOWN);
+    return fp_options_cur() == id;
+}
+
+static int opt_total(void) { return OPT_COUNT + OPT2_COUNT; }
+static int opt_at(int i) { return i < OPT_COUNT ? i : OPT2_FIRST + i - OPT_COUNT; }
+static const DoomoOptionInfo *info(int opt)
+{
+    return opt >= OPT2_FIRST ? &doomo_option2_info[opt - OPT2_FIRST] : &doomo_option_info[opt];
+}
+
+TEST(uio_every_option_has_exactly_one_page_and_a_place_on_it)
+{
+    int i, p, k, seen[OPT2_END] = { 0 };
+    for (p = 1; p < OPTPAGE_COUNT; p++) {
+        uint8_t rows[32];
+        int n = fp_options_page_rows(p, rows, (int)sizeof(rows), 1);
+        for (k = 0; k < n; k++) {
+            if (rows[k] >= ROW_HDR || rows[k] >= ROW_PRESET) continue;
+            CHECK_MSG(rows[k] < OPT2_END, "page %d lists id %d", p, rows[k]);
+            CHECK_MSG(info(rows[k])->page == p, "\"%s\" sits on page %d but says page %d", info(rows[k])->name, p, info(rows[k])->page);
+            seen[rows[k]]++;
+        }
+    }
+    for (i = 0; i < opt_total(); i++) {
+        int o = opt_at(i);
+#if defined(DOOMO_PLATFORM_PS1)
+        if (o == OPT_NOTES || o == OPT_MEMORIAL) continue;
+#endif
+        CHECK_MSG(info(o)->page != OPTPAGE_QUICK && info(o)->page < OPTPAGE_COUNT, "\"%s\": page %d", info(o)->name, info(o)->page);
+        CHECK_MSG(seen[o] == 1, "\"%s\" (id %d) is on %d page layouts", info(o)->name, o, seen[o]);
+    }
+}
+
+TEST(uio_no_page_lists_more_than_twelve_rows_or_three_groups)
+{
+    int p, k;
+    for (p = 0; p < OPTPAGE_COUNT; p++) {
+        uint8_t rows[32];
+        int n = fp_options_page_rows(p, rows, (int)sizeof(rows), 1), rr = 0, hh = 0;
+        for (k = 0; k < n; k++) {
+            if (rows[k] >= ROW_HDR) hh++;
+            else {
+                int j;
+                rr++;
+                for (j = 0; j < k; j++) CHECK_MSG(rows[j] != rows[k], "page %d lists row %d twice", p, rows[k]);
+            }
+        }
+        CHECK_MSG(rr > 0, "page %d is empty", p);
+        CHECK_MSG(rr <= (p == OPTPAGE_CHEATS ? CHEAT_ROWS_MAX : PAGE_ROWS_MAX), "page %d (%s) has %d rows", p, doomo_option_page_names[p], rr);
+        CHECK_MSG(hh <= 3, "page %d has %d groups", p, hh);
+        CHECK_MSG(n > 0 && (hh == 0 || rows[0] >= ROW_HDR), "page %d: its first group has no header", p);
+    }
+}
+
+TEST(uio_a_header_is_only_there_for_a_row_that_shows)
+{
+    uint8_t rows[32];
+    int n, k;
+    test_reset();
+    n = fp_options_page_rows(OPTPAGE_CONTROLS, rows, (int)sizeof(rows), 0);
+    for (k = 0; k + 1 < n; k++) CHECK(!(rows[k] >= ROW_HDR && rows[k + 1] >= ROW_HDR));
+    CHECK(rows[n - 1] < ROW_HDR);
+}
+
+TEST(uio_help_is_one_line_at_both_sizes_in_every_ready_language)
+{
+    char why[900];
+    int l, sizes;
+    for (sizes = 0; sizes < 2; sizes++) {
+        set_res(sizes ? 320 : 240, sizes ? 240 : 160);
+        test_reset();
+        for (l = 0; l < LANG_COUNT; l++) {
+            if (!doomo_lang_info[l].ready) continue;
+            opt_set(OPT_LANGUAGE, l);
+            CHECK_MSG(fp_options_help_overflow(why, sizeof(why)) == 0, "%dx%d %s: %s", sizes ? 320 : 240, sizes ? 240 : 160,
+                      doomo_lang_info[l].name, why);
+        }
+        opt_set(OPT_LANGUAGE, LANG_EN);
+    }
+    set_res(240, 160);
+}
+
+TEST(uio_every_default_loads_and_the_ids_keep_their_meaning)
+{
+    int i;
+    test_reset();
+    opt_defaults();
+    for (i = 0; i < opt_total(); i++) {
+        int o = opt_at(i);
+        CHECK_MSG(info(o)->def < info(o)->count, "\"%s\": default %d of %d", info(o)->name, info(o)->def, info(o)->count);
+        CHECK_MSG(opt_get(o) == info(o)->def, "\"%s\" loads %d, default %d", info(o)->name, opt_get(o), info(o)->def);
+    }
+    /* old saves: the option bytes are kept by id, so the ids and the meaning of their values are pinned */
+    CHECK_EQ(OPT_GORE, 0); CHECK_EQ(OPT_MONSTER_MODE, 1); CHECK_EQ(OPT_DIFFICULTY, 2); CHECK_EQ(OPT_MUSIC_VOL, 3);
+    CHECK_EQ(OPT_CAMERA_DEFAULT, 11); CHECK_EQ(OPT_CONTROL_SCHEME, 12); CHECK_EQ(OPT_WINDOW_SKIN, 33);
+    CHECK_EQ(OPT2_FIRST, 64); CHECK_EQ(OPT_MATURE, 64); CHECK_EQ(OPT_LOSS, 65);
+    /* a save written by the old build (ten pages): every byte reads as it did, whatever page it moved to */
+    memset(doomo_town.opt, 0, sizeof(doomo_town.opt));
+    doomo_town.opt[OPT_GORE] = GORE_BRUTAL;
+    doomo_town.opt[OPT_CROSSHAIR] = 4;               /* was on the Shooter page, now Display */
+    doomo_town.opt[OPT_DEMON_DENSITY] = 2;           /* was Shooter, now Perf */
+    doomo_town.opt[OPT_WEATHER] = 2;                 /* was Life Sim, now Life */
+    doomo_town.opt[OPT_FONT_STYLE] = 99;             /* out of range reads as the default */
+    CHECK_EQ(opt_get(OPT_GORE), GORE_BRUTAL);
+    CHECK_EQ(opt_get(OPT_CROSSHAIR), 4);
+    CHECK_EQ(opt_get(OPT_DEMON_DENSITY), 2);
+    CHECK_EQ(opt_get(OPT_WEATHER), 2);
+    CHECK_EQ(opt_get(OPT_FONT_STYLE), info(OPT_FONT_STYLE)->def);
+    opt_defaults();
+}
+
+TEST(uio_the_cursor_skips_group_headers_and_wraps_through_the_reset_row)
+{
+    int seen_reset = 0, i;
+    fresh(OPTPAGE_CONTROLS);
+    CHECK_EQ(fp_options_cur(), OPT_CONTROL_SCHEME);            /* not the "Pad" header above it */
+    for (i = 0; i < 20; i++) {
+        press(BTN_DOWN);
+        CHECK(fp_options_cur() < ROW_HDR);
+        if (fp_options_cur() == -1) seen_reset = 1;
+    }
+    CHECK(seen_reset);
+    fresh(OPTPAGE_CONTROLS);
+    press(BTN_UP);
+    CHECK_EQ(fp_options_cur(), -1);                            /* up from the first row: the reset row */
+    press(BTN_UP);
+    CHECK(fp_options_cur() < ROW_HDR && fp_options_cur() != -1);
+}
+
+TEST(uio_the_header_counts_rows_without_headers)
+{
+    fresh(OPTPAGE_SOUND);
+    CHECK_STR(fp_options_counter(), "1 / 5");                  /* four rows and the reset row */
+    press(BTN_DOWN);
+    CHECK_STR(fp_options_counter(), "2 / 5");
+    press(BTN_UP); press(BTN_UP);
+    CHECK_STR(fp_options_counter(), "5 / 5");                  /* the reset row is the last */
+    fresh(OPTPAGE_CONTROLS);
+    press(BTN_DOWN);
+    CHECK_STR(fp_options_counter(), "2 / 11");                 /* the three headers do not count: 10 rows (no stick or motor here) and the reset row */
+}
+
+TEST(uio_y_puts_one_row_back_and_never_touches_language_or_monster_mode)
+{
+    fresh(OPTPAGE_DISPLAY);
+    opt_set(OPT_CROSSHAIR, 3);
+    opt_set(OPT_FOV, 2);
+    CHECK(goto_row(OPT_CROSSHAIR));
+    press(BTN_Y);
+    CHECK_EQ(opt_get(OPT_CROSSHAIR), info(OPT_CROSSHAIR)->def);
+    CHECK_EQ(opt_get(OPT_FOV), 2);                             /* only that row */
+    press(BTN_Y);                                              /* already at its default: nothing */
+    CHECK_EQ(opt_get(OPT_CROSSHAIR), info(OPT_CROSSHAIR)->def);
+    fresh(OPTPAGE_GAME);
+    opt_set(OPT_LANGUAGE, LANG_ES);
+    opt_set(OPT_MONSTER_MODE, 1);
+    CHECK(goto_row(OPT_LANGUAGE));
+    press(BTN_Y);
+    CHECK_EQ(opt_get(OPT_LANGUAGE), LANG_ES);
+    CHECK(goto_row(OPT_MONSTER_MODE));
+    press(BTN_Y);
+    CHECK_EQ(opt_get(OPT_MONSTER_MODE), 1);
+    opt_set(OPT_LANGUAGE, LANG_EN);
+    opt_set(OPT_MONSTER_MODE, 0);
+}
+
+TEST(uio_select_opens_the_detail_card_and_b_closes_it)
+{
+    fresh(OPTPAGE_GAME);
+    CHECK(goto_row(OPT_MATURE));
+    CHECK(!fp_options_card_open());
+    press(BTN_SELECT);
+    CHECK(fp_options_card_open());
+    press(BTN_B);
+    CHECK(!fp_options_card_open());
+    CHECK(scene_top() == &SCENE_OPTIONS);
+    fresh(OPTPAGE_GAME);
+    CHECK(goto_row(OPT_AUTOSAVE));
+    press(BTN_SELECT);
+    CHECK(!fp_options_card_open());                            /* a row with no long text has no card */
+    CHECK(goto_row(OPT_GORE));
+    press(BTN_SELECT);
+    CHECK(fp_options_card_open());
+    press(BTN_RIGHT);
+    CHECK_EQ(opt_get(OPT_GORE), GORE_BRUTAL);
+    press(BTN_Y);
+    CHECK_EQ(opt_get(OPT_GORE), GORE_CUTE);
+    press(BTN_B);
+    CHECK(!fp_options_card_open());
+    CHECK(scene_top() == &SCENE_OPTIONS);                      /* B closed the card, not the screen */
+    CHECK_EQ(fp_options_page(), OPTPAGE_GAME);
+}
+
+TEST(uio_a_chord_with_select_is_not_the_card)
+{
+    fresh(OPTPAGE_GAME);
+    CHECK(goto_row(OPT_GORE));
+    frames(BTN_SELECT | BTN_Y, 1);                             /* the pad's Y with SELECT held */
+    frames(0, 2);
+    CHECK(!fp_options_card_open());
+}
+
+TEST(uio_options_opens_on_the_page_it_was_left_on)
+{
+    test_reset();
+    scene_set(&SCENE_TITLE, 0);
+    frames(0, 2);
+    scene_push(&SCENE_OPTIONS, 0);
+    frames(0, 3);
+    CHECK_EQ(fp_options_page(), OPTPAGE_QUICK);
+    press(BTN_R); press(BTN_R); press(BTN_R);
+    CHECK_EQ(fp_options_page(), OPTPAGE_DISPLAY);
+    press(BTN_B);
+    frames(0, 3);
+    CHECK(scene_top() == &SCENE_TITLE);
+    scene_push(&SCENE_OPTIONS, 0);
+    frames(0, 3);
+    CHECK_EQ(fp_options_page(), OPTPAGE_DISPLAY);              /* memory */
+    press(BTN_L); press(BTN_L); press(BTN_L);
+    CHECK_EQ(fp_options_page(), OPTPAGE_QUICK);
+    press(BTN_L);
+    CHECK_EQ(fp_options_page(), OPTPAGE_COUNT - 1);            /* L wraps to the last tab */
+    scene_push(&SCENE_OPTIONS, OPTPAGE_CONTROLS);              /* an explicit page wins (the pause menus ask for it) */
+    frames(0, 3);
+    CHECK_EQ(fp_options_page(), OPTPAGE_CONTROLS);
+    test_reset();
+}
+
+TEST(uio_page_reset_keeps_language_and_monster_mode_and_puts_the_rest_back)
+{
+    fresh(OPTPAGE_GAME);
+    opt_set(OPT_LANGUAGE, LANG_ES);
+    opt_set(OPT_MONSTER_MODE, 1);
+    opt_set(OPT_GORE, GORE_BRUTAL);
+    opt_set(OPT_AUTOSAVE, 0);
+    CHECK(goto_row(-1));
+    press(BTN_A);
+    frames(0, 2);
+    press(BTN_LEFT);                                           /* the confirm's default is No: pick Yes */
+    press(BTN_A);
+    frames(0, 3);
+    CHECK_EQ(opt_get(OPT_GORE), GORE_CUTE);
+    CHECK_EQ(opt_get(OPT_AUTOSAVE), info(OPT_AUTOSAVE)->def);
+    CHECK_EQ(opt_get(OPT_LANGUAGE), LANG_ES);
+    CHECK_EQ(opt_get(OPT_MONSTER_MODE), 1);
+    opt_set(OPT_LANGUAGE, LANG_EN);
+    opt_set(OPT_MONSTER_MODE, 0);
+}
+
+TEST(uio_a_preset_still_leaves_the_performance_rows_alone_but_may_set_demon_density)
+{
+    fresh(OPTPAGE_QUICK);
+    opt_set(OPT_EFFECTS, 0);
+    opt_set(OPT_SHOW_FPS, 1);
+    opt_set(OPT_3D_FAST, 2);
+    CHECK(goto_row(ROW_PRESET));
+    press(BTN_RIGHT); press(BTN_RIGHT); press(BTN_RIGHT); press(BTN_RIGHT);   /* Hardcore */
+    press(BTN_A);
+    frames(0, 2);
+    press(BTN_LEFT);
+    press(BTN_A);
+    frames(0, 3);
+    CHECK_EQ(opt_get(OPT_DEMON_DENSITY), 2);
+    CHECK_EQ(opt_get(OPT_EFFECTS), 0);
+    CHECK_EQ(opt_get(OPT_SHOW_FPS), 1);
+    CHECK_EQ(opt_get(OPT_3D_FAST), 2);
+    opt_defaults();
+}
