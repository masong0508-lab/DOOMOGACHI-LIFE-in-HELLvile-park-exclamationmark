diff --git a/core/tests/test_busy.c b/core/tests/test_busy.c
new file mode 100644
index 00000000..d3634520
--- /dev/null
+++ b/core/tests/test_busy.c
@@ -0,0 +1,167 @@
+/* test_busy.c - S2-10: plat_busy / plat_busy_step, the hooks that keep the screen alive while a save, a load or a
+ * town build runs in one tick (plat_ext.h; owner: speed). The hooks here are strong and only count, so every
+ * other test in this binary runs with them too: nothing they see may change a result.
+ *
+ * Also the cut-off tests of the streamed save: a write that stops at any point leaves the previous save as it
+ * was (natively: the new file is written aside and renamed on commit, like the GBA's trailer written last
+ * and the Dreamcast's replace). */
+#include "test.h"
+#include "doomo/save.h"
+#include "doomo/plat_ext.h"
+
+static int b_calls, b_kind, b_steps, b_bad, b_max_done, b_steps_before_busy, b_busy_calls_since;
+
+void plat_busy(int kind)
+{
+    b_calls++;
+    b_busy_calls_since++;
+    b_kind = kind;
+    if (b_steps) b_steps_before_busy++;      /* a step that came before its busy call */
+}
+
+void plat_busy_step(int done, int total)
+{
+    b_steps++;
+    if (done < 0 || done > total || total != DOOMO_MAX_RESIDENTS) b_bad++;
+    if (done > b_max_done) b_max_done = done;
+}
+
+static void busy_reset(void)
+{
+    b_calls = b_kind = b_steps = b_bad = b_max_done = b_steps_before_busy = b_busy_calls_since = 0;
+}
+
+extern int nat_save_stream, nat_stream_fail_at;
+extern uint32_t nat_stream_writes;
+
+TEST(busy_town_new_steps_every_citizen)
+{
+    busy_reset();
+    town_new(TOWN_STORY, 1, TOWN_POP_PREMADE);
+    CHECK_EQ(b_calls, 1);
+    CHECK_EQ(b_kind, PLAT_BUSY_BUILD);
+    CHECK_EQ(b_steps, DOOMO_MAX_RESIDENTS);          /* one step per citizen built: never a long run without one */
+    CHECK_EQ(b_bad, 0);
+    CHECK_EQ(b_max_done, DOOMO_MAX_RESIDENTS - 1);
+    CHECK_EQ(b_steps_before_busy, 0);
+
+    busy_reset();
+    town_new(TOWN_FREEPLAY, 31337, TOWN_POP_RANDOM);
+    CHECK_EQ(b_calls, 1);
+    CHECK_EQ(b_steps, DOOMO_MAX_RESIDENTS);
+    CHECK_EQ(b_bad, 0);
+
+    busy_reset();
+    town_new(TOWN_FREEPLAY, 1, TOWN_POP_EMPTY);       /* nothing to build: called (the platform decides if late) */
+    CHECK_EQ(b_calls, 1);
+    CHECK_EQ(b_kind, PLAT_BUSY_BUILD);
+    CHECK_EQ(b_steps, 0);
+}
+
+static uint8_t keep[DOOMO_SAVE_SLOT1_MAX], now[DOOMO_SAVE_SLOT1_MAX];
+
+TEST(busy_save_and_load_step_every_citizen)
+{
+    DoomoTown snap;
+    int pass;
+    for (pass = 0; pass < 2; pass++) {
+        nat_save_stream = pass ? 4096 : 0;           /* 0: the whole image in one pass; else the GBA's two passes */
+        town_new(TOWN_FREEPLAY, 5, TOWN_POP_PREMADE);
+        resident_sanitize(&doomo_town.player);
+        rel_normalize();
+        snap = doomo_town;
+
+        busy_reset();
+        CHECK(save_game(1));
+        CHECK_EQ(b_calls, 1);
+        CHECK_EQ(b_kind, PLAT_BUSY_SAVE);
+        CHECK_EQ(b_steps_before_busy, 0);
+        CHECK(b_steps >= DOOMO_MAX_RESIDENTS * (pass ? 2 : 1));      /* every citizen, once per pass */
+        CHECK(b_steps <= DOOMO_MAX_RESIDENTS * (pass ? 4 : 2));
+        CHECK_EQ(b_bad, 0);
+
+        memset(&doomo_town, 0x5A, sizeof(doomo_town));
+        busy_reset();
+        CHECK(load_game(1));
+        CHECK_EQ(b_calls, 1);
+        CHECK_EQ(b_kind, PLAT_BUSY_LOAD);
+        CHECK_EQ(b_steps_before_busy, 0);
+        CHECK(b_steps >= DOOMO_MAX_RESIDENTS);       /* the applying decode rebuilds every citizen */
+        CHECK_EQ(b_bad, 0);
+        CHECK(memcmp(&snap.res, &doomo_town.res, sizeof(snap.res)) == 0);
+    }
+    nat_save_stream = 0;
+}
+
+TEST(busy_a_missing_save_does_not_start_a_busy_card)
+{
+    nat_save_stream = 0;
+    plat_save_erase(1);
+    busy_reset();
+    CHECK(!load_game(1));
+    CHECK_EQ(b_calls, 0);                            /* nothing to wait for: no card for a quick "no save" */
+    CHECK_EQ(b_steps, 0);
+    nat_save_stream = 4096;
+    busy_reset();
+    CHECK(!load_game(1));
+    CHECK_EQ(b_calls, 0);
+    nat_save_stream = 0;
+}
+
+static uint32_t slot_image(int slot, uint8_t *buf)
+{
+    uint32_t size = 0;
+    if (!plat_save_read(slot, buf, DOOMO_SAVE_SLOT1_MAX, &size)) return 0;
+    return size;
+}
+
+static void island(uint32_t seed)
+{
+    town_new(TOWN_FREEPLAY, seed, TOWN_POP_RANDOM);
+    resident_sanitize(&doomo_town.player);
+    rel_normalize();
+}
+
+/* a save cut off at the first write, in the middle and at the last one: the previous save is untouched,
+ * byte for byte, and loads; the next complete save then replaces it */
+TEST(save_cut_at_any_write_keeps_the_previous_save)
+{
+    uint32_t n0, n;
+    DoomoTown a;
+    int writes, cuts[7], k;
+    nat_save_stream = 512;
+    island(11);
+    a = doomo_town;
+    CHECK(save_game(1));
+    n0 = slot_image(1, keep);
+    CHECK(n0 > 4 * 512);
+    island(12);                                    /* the island that is saved over it */
+    nat_stream_writes = 0;
+    CHECK(save_game(1));                           /* a clean run counts the writes */
+    writes = (int)nat_stream_writes;
+    CHECK(writes > 8);
+    n = slot_image(1, now);
+    CHECK(n != n0 || memcmp(keep, now, n0) != 0);  /* it really replaced the first one */
+    CHECK(plat_save_write(1, keep, n0));           /* the first one back in the slot */
+    cuts[0] = 1; cuts[1] = 2; cuts[2] = 3; cuts[3] = writes / 4; cuts[4] = writes / 2; cuts[5] = writes - 1;
+    cuts[6] = writes;
+    for (k = 0; k < 7; k++) {
+        island(12);
+        nat_stream_fail_at = cuts[k];
+        CHECK_MSG(!save_game(1), "a save cut at write %d of %d reported success", cuts[k], writes);
+        nat_stream_fail_at = 0;
+        n = slot_image(1, now);
+        CHECK_EQ(n, n0);
+        CHECK_MSG(memcmp(keep, now, n0) == 0, "the previous save changed after a cut at write %d", cuts[k]);
+        CHECK(save_verify(1));
+        memset(&doomo_town, 0x5A, sizeof(doomo_town));
+        CHECK(load_game(1));
+        CHECK(memcmp(&a.res, &doomo_town.res, sizeof(a.res)) == 0);
+    }
+    island(12);                                    /* a complete save after all those cuts works */
+    CHECK(save_game(1));
+    CHECK(save_verify(1));
+    n = slot_image(1, now);
+    CHECK(n != n0 || memcmp(keep, now, n0) != 0);
+    nat_save_stream = 0;
+}
diff --git a/core/tests/test_save_golden.c b/core/tests/test_save_golden.c
new file mode 100644
index 00000000..840282bb
--- /dev/null
+++ b/core/tests/test_save_golden.c
@@ -0,0 +1,98 @@
+/* test_save_golden.c - the bytes a save puts on the medium never change (S2-10; owner: speed).
+ *
+ * S2-10 made the screen live while a save, a load and a town build run (plat_busy / plat_busy_step); the saved
+ * bytes had to stay exactly what they were, because old saves load and the GBA, PS1 and Dreamcast ports compare
+ * files. The CRC-32 of the whole image of a few deterministic islands was taken on the tree before S2-10 and is
+ * fixed here: a change to the codec, the record rebuild or the section order shows up as a different number.
+ * (A deliberate format change bumps DOOMO_SAVE_VERSION and these numbers with it.) */
+#include "test.h"
+#include "doomo/save.h"
+
+/* taken on the tree before S2-10 (ee686c74): the whole image's size and CRC-32 */
+#define GOLDEN_EMPTY_SIZE   420u
+#define GOLDEN_EMPTY_CRC    0x401C4EB3u
+#define GOLDEN_CLASSIC_SIZE 6890u
+#define GOLDEN_CLASSIC_CRC  0x7653CF70u
+#define GOLDEN_LIVED_SIZE   29894u
+#define GOLDEN_LIVED_CRC    0x81EBCB91u
+#define GOLDEN_RANDOM_SIZE  27691u
+#define GOLDEN_RANDOM_CRC   0xA7A2BF6Fu
+
+static uint8_t image[DOOMO_SAVE_SLOT1_MAX + 64];
+
+/* the image of the current town, as the whole-image path writes it */
+static uint32_t image_crc(uint32_t *size)
+{
+    uint32_t n;
+    resident_sanitize(&doomo_town.player);
+    rel_normalize();
+    n = save_serialize(image, sizeof(image));
+    if (size) *size = n;
+    return n ? save_crc32(image, n) : 0;
+}
+
+/* a lived-in island: every third citizen is custom, the others got older and moodier */
+static void live_in(uint32_t seed)
+{
+    DoomoRng r;
+    int i;
+    rng_seed(&r, seed);
+    doomo_town.day = 77;
+    doomo_town.minute = 600;
+    doomo_town.money = 4321;
+    memcpy(doomo_town.pet.name, "Puffy", 6);
+    for (i = 0; i < DOOMO_MAX_RESIDENTS; i++) {
+        DoomoResident *res = &doomo_town.res[i];
+        if (res->status == RES_EMPTY) continue;
+        if (i % 3 == 0) {
+            resident_generate(res, 70000u + (uint32_t)i);
+            res->flags |= RF_CUSTOM;
+        } else if (i % 3 == 1) {
+            res->mood = (uint8_t)rng_range(&r, MOOD_COUNT);
+            res->level = (uint8_t)rng_range(&r, 100);
+        }
+    }
+    for (i = 0; i < 300; i++) rel_adjust(rng_range(&r, 1000), rng_range(&r, 1000), rng_between(&r, -50, 50));
+}
+
+TEST(save_bytes_golden_empty_island)
+{
+    uint32_t n = 0, c;
+    town_new(TOWN_FREEPLAY, 1, TOWN_POP_EMPTY);
+    c = image_crc(&n);
+    printf("      golden empty island: %u bytes, crc 0x%08X\n", n, c);
+    CHECK_EQ(n, GOLDEN_EMPTY_SIZE);
+    CHECK_EQ_U(c, GOLDEN_EMPTY_CRC);
+}
+
+TEST(save_bytes_golden_classic_untouched)
+{
+    uint32_t n = 0, c;
+    town_new(TOWN_STORY, 5, TOWN_POP_PREMADE);
+    c = image_crc(&n);
+    printf("      golden classic, untouched: %u bytes, crc 0x%08X\n", n, c);
+    CHECK_EQ(n, GOLDEN_CLASSIC_SIZE);
+    CHECK_EQ_U(c, GOLDEN_CLASSIC_CRC);
+}
+
+TEST(save_bytes_golden_classic_lived_in)
+{
+    uint32_t n = 0, c;
+    town_new(TOWN_FREEPLAY, 9, TOWN_POP_PREMADE);
+    live_in(3);
+    c = image_crc(&n);
+    printf("      golden classic, lived in: %u bytes, crc 0x%08X\n", n, c);
+    CHECK_EQ(n, GOLDEN_LIVED_SIZE);
+    CHECK_EQ_U(c, GOLDEN_LIVED_CRC);
+}
+
+TEST(save_bytes_golden_random_island)
+{
+    uint32_t n = 0, c;
+    town_new(TOWN_FREEPLAY, 31337, TOWN_POP_RANDOM);
+    live_in(8);
+    c = image_crc(&n);
+    printf("      golden random island: %u bytes, crc 0x%08X\n", n, c);
+    CHECK_EQ(n, GOLDEN_RANDOM_SIZE);
+    CHECK_EQ_U(c, GOLDEN_RANDOM_CRC);
+}
