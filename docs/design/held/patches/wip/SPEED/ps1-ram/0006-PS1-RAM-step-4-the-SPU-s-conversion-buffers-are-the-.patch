From 5f0b7621d08f85ef6329f84559377141fbcfa38e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 23:43:07 +0000
Subject: [PATCH 06/14] PS1-RAM step 4: the SPU's conversion buffers are the
 idle display lists at boot (+8,640 B)

The PCM chunk, its ADPCM blocks and the DMA's word-aligned copy (3,584 +
1,024 + 4,096 B of .bss) are only used while a waveform or an effect is
converted. On the game disc that is boot only: audio_hw_init() builds the
waveforms and audio_hw_sfx_preload() converts all of SFX.BIN before the
first game frame; every effect is ready or failed after that, so nothing
converts later. stage_open() now takes the three buffers from the display
lists, idle until the game loop starts (plat_save_scratch), and
stage_close() drops them; a conversion without buffers fails like a full
SPU RAM. The engine test converts at run time too (its self test) and keeps
the statics.

Game disc with the boot FMV: 125,616 -> 134,256 B below the stack top.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RLcGbHBa2kju7ynbaJLHT6
---
 ps1/src/spu.c | 62 +++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 53 insertions(+), 9 deletions(-)

diff --git a/ps1/src/spu.c b/ps1/src/spu.c
index 4692f273..44331d8a 100644
--- a/ps1/src/spu.c
+++ b/ps1/src/spu.c
@@ -64,17 +64,61 @@ static uint32_t s_age;
 static int      s_bg_next = 1;
 static int      s_ready;
 
+/* ---- staging -------------------------------------------------------------
+ * PCM -> ADPCM staging, shared by the boot-time waveforms and the converted
+ * effects (load_pcm8): the PCM of one chunk, its ADPCM blocks, and the
+ * word-aligned copy the SPU DMA wants (spu_upload).
+ * (RAM headroom 2026-11-12) On the game disc every conversion runs at boot,
+ * before the first game frame: the waveforms (audio_hw_init) and all of
+ * SFX.BIN (audio_hw_sfx_preload). So the three buffers are no .bss there
+ * (8.7 KB): stage_open() takes them from the display lists, which are idle
+ * until the game loop starts (plat_save_scratch, gfx.c), and stage_close()
+ * drops them. Nothing converts later (every effect is ready or failed by
+ * then); a conversion that found no buffer would fail like a full SPU RAM.
+ * The engine test also converts at run time (its self test) and keeps the
+ * buffers as statics. */
+#define STAGE_PCM    (28 * 64)          /* samples per chunk       */
+#define STAGE_ADPCM  (64 * 16)          /* their ADPCM blocks      */
+#define STAGE_UP     4096               /* bytes per DMA transfer  */
+#if defined(DOOMO_SFX_ON_DISC) && !defined(DOOMO_ENGINE_TEST)
+static int16_t  *s_pcm;
+static uint8_t  *s_adpcm;
+static uint32_t *s_up;
+typedef char stage_fits[STAGE_UP + STAGE_PCM * 2 + STAGE_ADPCM <= 2 * PRIM_BYTES ? 1 : -1];
+
+static void stage_open(void)
+{
+    uint8_t *b = (uint8_t *)plat_save_scratch(NULL);
+    s_up = (uint32_t *)b;
+    s_pcm = (int16_t *)(b + STAGE_UP);
+    s_adpcm = b + STAGE_UP + STAGE_PCM * 2;
+}
+
+static void stage_close(void)
+{
+    s_up = NULL;
+    s_pcm = NULL;
+    s_adpcm = NULL;
+}
+#else
+static int16_t  s_pcm[STAGE_PCM];
+static uint8_t  s_adpcm[STAGE_ADPCM];
+static uint32_t s_up[STAGE_UP / 4];
+static void stage_open(void) {}
+static void stage_close(void) {}
+#endif
+
 /* ---- upload ------------------------------------------------------------- */
 static uint32_t s_up_sum = 2166136261u;    /* FNV-1a of every byte sent to SPU RAM (the boot log) */
 
 static void spu_upload(uint32_t addr, const void *data, size_t bytes)
 {
     /* DMA wants 64-byte chunks of word-aligned data */
-    static uint32_t tmp[1024];
+    uint32_t *tmp = s_up;
     const uint8_t *src = (const uint8_t *)data;
     s_up_sum = sum_bytes(s_up_sum, src, bytes);
     while (bytes) {
-        size_t n = bytes > sizeof(tmp) ? sizeof(tmp) : bytes;
+        size_t n = bytes > STAGE_UP ? STAGE_UP : bytes;
         size_t padded = (n + 63) & ~(size_t)63;
         memset(tmp, 0, padded);
         memcpy(tmp, src, n);
@@ -109,11 +153,7 @@ static int16_t wave_sample(int wave, int i, int len, uint32_t *rng)
 }
 
 #define NOISE_LEN (28 * 64)
-
-/* PCM -> ADPCM staging, shared by the boot-time waveforms and the lazily
- * converted effects (load_pcm8): 4.5 KB once instead of twice */
-static int16_t s_pcm[28 * 64];
-static uint8_t s_adpcm[64 * 16];
+typedef char noise_fits[NOISE_LEN <= STAGE_PCM ? 1 : -1];
 
 static void build_waves(void)
 {
@@ -227,14 +267,14 @@ static uint32_t load_pcm8(const int8_t *src, uint32_t len)
     if (len > 44100u * 3u)
         len = 44100u * 3u;
     bytes = (len + 27) / 28 * 16 + 16;
-    if (s_sfx_top + bytes > SPU_SFX_END)
+    if (s_sfx_top + bytes > SPU_SFX_END || !pcm)
         return 0;
     /* chunks of 64 blocks; the encoder state restarts per chunk (filter 0
      * on each chunk's first block), inaudible at these lengths */
     while (done < len) {
         uint32_t n = len - done, i;
         int blocks;
-        if (n > sizeof(s_pcm) / 2) n = sizeof(s_pcm) / 2;
+        if (n > STAGE_PCM) n = STAGE_PCM;
         for (i = 0; i < n; i++)
             pcm[i] = (int16_t)(src[done + i] * 256);
         blocks = adpcm_encode(pcm, (int)n, adpcm, 1);
@@ -318,7 +358,9 @@ void audio_hw_init(void)
     SpuInit();
     SPU_MASTER_VOL_L = 0x3fff;
     SPU_MASTER_VOL_R = 0x3fff;
+    stage_open();
     build_waves();
+    stage_close();
     for (v = 0; v < 24; v++) {
         SPU_CH_VOL_L(v) = 0;
         SPU_CH_VOL_R(v) = 0;
@@ -336,8 +378,10 @@ void audio_hw_sfx_preload(void)
     int id, ok = 0;
     if (!s_ready)
         return;
+    stage_open();
     for (id = 1; id < SFX_COUNT; id++)
         ok += convert_sfx(id);
+    stage_close();
     s_bg_next = SFX_COUNT;
     /* what is in SPU RAM now: the same line from two builds = the same sound data */
     dbg("spu: %d of %d effects, top %05x, sum %08x\n", ok, SFX_COUNT - 1, (unsigned)s_sfx_top,
