+    if (f == 270) return BTN_L;                                 /* the Armory */
+    if (f >= 280 && f < 340 && f % 10 == 0) return f < 310 ? BTN_DOWN : BTN_UP;
+    if (f == 350) return BTN_R;
+    if (f >= 360 && f < 410 && f % 5 == 0) return BTN_RIGHT;
+    return 0;
+}
