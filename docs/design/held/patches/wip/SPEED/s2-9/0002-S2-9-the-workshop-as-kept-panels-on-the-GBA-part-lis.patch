+    RECT_OUTSIDE(0, b2, w, h - b2, b.bot);
+    seam_row(b1 - 1, w, b.mid, 0);
+    seam_row(b1, w, b.top, 1);
+    seam_row(b2 - 1, w, b.bot, 0);
+    seam_row(b2, w, b.mid, 1);
