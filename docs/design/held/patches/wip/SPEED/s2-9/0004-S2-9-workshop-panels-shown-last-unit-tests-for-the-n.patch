-+    uint32_t res = 0, bit = 1u << 30;
-+    while (bit > v) bit >>= 2;
-+    while (bit) {
-+        if (v >= res + bit) {
-+            v -= res + bit;
-+            res = (res >> 1) + bit;
-+        } else {
-+            res >>= 1;
-+        }
-+        bit >>= 2;
-+    }
-+    return res;
