-+    if (c) g->px[y * g->w + x] = c;                        /* (get() said it is on the canvas) */
-+}
-+
-+static void clear_px(G *g, int x, int y)
-+{
-+    if (!sl_one(g->sl)) return;
-+    if ((unsigned)x < (unsigned)g->w && (unsigned)y < (unsigned)g->h) g->px[y * g->w + x] = 0;
