+#!/usr/bin/env python3
+"""audit_compare.py - a speed audit's per-window tables with the previous audit's number beside each window.
+
+usage:
+  audit_compare.py --prev OLD_AUDIT.md LOG [LOG..]
+
+Each LOG is a GBA harness log (--worklog), a PS1 run.py tty.log or a dcrun log (tools/speed2.py `table` detects
+the format and makes the rows). OLD_AUDIT.md is the previous audit (docs/design/SPEED_AUDIT3.md): its section
+"### 2.1 GBA" / "### 2.2 PS1" / "### 2.3 Dreamcast" tables give the old number of a window with the same name
+(PS1: the same tag). Printed: one markdown table per LOG with the columns of tools/speed2.py, the previous
+audit's number and now ("13.2 -> 30.0"; "new" when the old audit has no such window), and the verdict of the
+owner's rule EVERYTHING AT 30 (OWNER_DECISIONS 2026-11-15): OK only when logic and drawn fps hold 30 and no
+presented frame took over 33 ms. A miss is "slow" (logic under 29.5 ticks/s: slow motion), "low" (a quarter or
+more of the frames over 33 ms), "hitch" (3 or more), "1x" (one or two). Dreamcast: ticks over 33.3 ms of work
+(no "low": dcrun counts ticks, not presented frames), and a presented-picture gap over 40 ms counts as one long
+frame. Stdlib only.
+"""
+import contextlib
+import io
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import speed2  # noqa: E402
+
+SECTIONS = (("### 2.1 GBA", "gba"), ("### 2.2 PS1", "ps1"), ("### 2.3 Dreamcast", "dc"))
+
+
+def prev_table(path):
+    """{platform: {name: (fps, logic)}} from the previous audit's section 2 tables (fps None on the DC)"""
+    out = {"gba": {}, "ps1": {}, "dc": {}}
+    plat = None
+    for line in open(path, errors="replace"):
+        s = line.strip()
+        if s.startswith("### "):
+            plat = next((p for h, p in SECTIONS if s.startswith(h)), None)
+            continue
+        if s.startswith("## ") and not s.startswith("## 2"):
+            plat = None
+        if not plat or not s.startswith("|") or s.startswith("|---") or s.startswith("| window"):
+            continue
+        c = [x.strip() for x in s.strip("|").split("|")]
+        try:
+            if plat == "gba":
+                out[plat].setdefault(c[0], (float(c[2]), float(c[1])))
+            elif plat == "ps1":
+                out[plat].setdefault(c[0], (float(c[1]), float(c[1])))
+            else:
+                out[plat].setdefault(c[0], (None, float(c[1])))
+        except (ValueError, IndexError):
+            continue
+    return out
+
+
+def classify(logic, fps, o33, frames):
+    if logic < 29.5:
+        return "MISS slow"
+    if o33 == 0 and fps >= 29.5:
+        return "OK"
+    if frames and o33 * 4 >= frames:
+        return "MISS low"
+    if o33 >= 3 or o33 == 0:
+        return "MISS hitch"
+    return "MISS 1x"
+
+
+def rows_of(log):
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf):
+        table(log)
+    lines = buf.getvalue().splitlines()
+    return lines[0], [[x.strip() for x in l.strip("|").split("|")] for l in lines[2:] if l.startswith("|")]
+
+
+def table(log):
+    head = open(log, errors="replace").read(1 << 20)
+    if "harness: fps" in head or "harness: work" in head:
+        speed2.table_gba(log)
+    elif "vsyncs-per-frame" in head or re.search(r"fps \S+ [\d.]+ \(\d+ frames", head):
+        speed2.table_ps1(log)
+    else:
+        speed2.table_dc(log)
+
+
+def hist_frames(h):
+    n = 0
+    for x in h.split():
+        a, b = x.split(":")
+        n += int(b)
+    return n
+
+
+def compare(log, prev):
+    header, rows = rows_of(log)
+    out = []
+    if header.startswith("| window | logic t/s | drawn fps"):              # GBA
+        out.append("| window | logic t/s | drawn fps | work avg / max ms | >33 / >50 ms | worst ms | audit 3 -> now "
+                   "| verdict |")
+        out.append("|---|---:|---:|---:|---:|---:|---|---|")
+        for c in rows:
+            logic, fps, o33, o50 = float(c[1]), float(c[2]), int(c[6]), int(c[7])
+            old = prev["gba"].get(c[0])
+            was = "%.1f (%.1f) -> %.1f (%.1f)" % (old[0], old[1], fps, logic) if old else "new"
+            out.append("| %s | %s | %s | %s / %s | %d / %d | %s | %s | %s |" % (
+                c[0], c[1], c[2], c[3], c[4], o33, o50, c[8], was, classify(logic, fps, o33, hist_frames(c[5]))))
+    elif header.startswith("| window | fps (= logic)"):                      # PS1
+        out.append("| window | fps (= logic) | frames by vsyncs | >33 / >50 ms | worst ms | overlay loads ms "
+                   "| audit 3 -> now | verdict |")
+        out.append("|---|---:|---|---:|---:|---|---|---|")
+        for c in rows:
+            fps, o33, o50 = float(c[1]), int(c[3]), int(c[4])
+            old = prev["ps1"].get(c[0])
+            was = "%.2f -> %.2f" % (old[0], fps) if old else "new"
+            out.append("| %s | %s | %s | %d / %d | %s | %s | %s | %s |" % (
+                c[0], c[1], c[2], o33, o50, c[5], c[6], was,
+                # one tick a frame: a short window's fps falls with its long frames, so those say what it is
+                classify(30.0 if o33 else fps, fps, o33, hist_frames(c[2]))))
+    else:                                                                    # Dreamcast
+        out.append("| window | logic t/s | work mean / worst ms | ticks >33.3 / >50 ms | worst picture gap ms "
+                   "| audit 3 -> now | verdict |")
+        out.append("|---|---:|---:|---:|---:|---|---|")
+        for c in rows:
+            logic, o33, o50 = float(c[1]), int(c[4]), int(c[5])
+            gap = float(c[6]) if c[6] not in ("-", "") else 0.0
+            n = o33 + (1 if o33 == 0 and gap > 40.0 else 0)
+            old = prev["dc"].get(c[0])
+            was = "%.1f -> %.1f" % (old[1], logic) if old else "new"
+            out.append("| %s | %s | %s / %s | %d / %d | %s | %s | %s |" % (
+                c[0], c[1], c[2], c[3], o33, o50, c[6], was, classify(logic, logic, n, 0)))
+    return out
+
+
+def main():
+    a = sys.argv[1:]
+    if len(a) < 3 or a[0] != "--prev":
+        print(__doc__)
+        return 2
+    prev = prev_table(a[1])
+    for log in a[2:]:
+        print("\n".join(compare(log, prev)))
+        print()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
