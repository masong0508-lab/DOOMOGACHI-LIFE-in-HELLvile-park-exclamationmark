+#!/usr/bin/env python3
+"""test_audit_compare.py - tools/audit_compare.py: the verdict classes and the previous audit's lookup."""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+import audit_compare as ac  # noqa: E402
+
+fails = 0
+
+
+def check(name, cond):
+    global fails
+    print("%s %s" % ("ok  " if cond else "FAIL", name))
+    if not cond:
+        fails += 1
+
+
+check("steady 30 is OK", ac.classify(30.0, 30.0, 0, 90) == "OK")
+check("slow logic", ac.classify(20.0, 15.0, 40, 40) == "MISS slow")
+check("a quarter of the frames long is low", ac.classify(30.0, 22.0, 30, 100) == "MISS low")
+check("three long frames is a hitch", ac.classify(30.0, 29.6, 3, 100) == "MISS hitch")
+check("one long frame is 1x", ac.classify(30.0, 29.8, 1, 100) == "MISS 1x")
+check("one long frame in a short window is 1x, not a hitch", ac.classify(30.0, 23.0, 1, 5) == "MISS 1x")
+check("no long frame but under 29.5 drawn is a miss", ac.classify(30.0, 29.0, 0, 0) != "OK")
+
+DOC = """# audit
+### 2.1 GBA
+| window | logic t/s | drawn fps | rest |
+|---|---:|---:|---|
+| fair: whack | 29.9 | 20.9 | x |
+### 2.2 PS1 (PCSX-Redux)
+| window | fps (= logic) | frames |
+|---|---:|---|
+| fair_whack | 30.12 | 2:90 |
+### 2.3 Dreamcast (Flycast)
+| window | logic t/s | ticks |
+|---|---:|---:|
+| fair: whack | 30.0 | 0 / 0 |
+## 3. Ranked misses
+| 1 | not a window | 1.0 | 2.0 |
+"""
+with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
+    f.write(DOC)
+p = ac.prev_table(f.name)
+os.unlink(f.name)
+check("GBA: drawn fps and logic", p["gba"].get("fair: whack") == (20.9, 29.9))
+check("PS1: by tag", p["ps1"].get("fair_whack") == (30.12, 30.12))
+check("Dreamcast: logic", p["dc"].get("fair: whack") == (None, 30.0))
+check("rows after section 2 are not windows", "1" not in p["gba"] and len(p["gba"]) == 1)
+
+LOG = """harness: fps start: 30.0 logic ticks/s, 30.0 drawn frames/s, work avg 1.0 ms max 1.0 ms (1 ticks, 2 video frames)
+harness: work 1 40.0
+harness: work 2 41.0
+harness: fps fair: whack: 30.0 logic ticks/s, 22.0 drawn frames/s, work avg 40.5 ms max 41.0 ms (60 ticks, 120 video frames)
+harness: gaps fair: whack: vblanks-per-frame histogram 2:10 3:30 max 3 (50.1 ms)
+"""
+with tempfile.NamedTemporaryFile("w", suffix=".log", delete=False) as f:
+    f.write(LOG)
+rows = ac.compare(f.name, {"gba": {"fair: whack": (20.9, 29.9)}, "ps1": {}, "dc": {}})
+os.unlink(f.name)
+check("a GBA row: old -> now and the class", rows[2].endswith("| 20.9 (29.9) -> 22.0 (30.0) | MISS low |"))
+print("test_audit_compare: %d failed" % fails)
+sys.exit(1 if fails else 0)
