---
 tools/tests/test_winprof.py |  9 +++++++++
 tools/winprof.py            | 38 ++++++++++++++++++++++++++-----------
 2 files changed, 36 insertions(+), 11 deletions(-)

diff --git a/tools/tests/test_winprof.py b/tools/tests/test_winprof.py
index 0b07faef..5ceb42ea 100644
--- a/tools/tests/test_winprof.py
+++ b/tools/tests/test_winprof.py
@@ -49,6 +49,9 @@ try:
     check("an unknown window refused", False)
 except SystemExit:
     check("an unknown window refused", True)
+out = winprof.cut(["seed 1\n", "fps a\n", "wait 5\n", "fps b\n", "press A\n", "wait 7\n", "fps c\n"], "c", 1)
+check("no fps start: the window opens at the previous window's fps", out == ["seed 1", "fps a", "wait 5", "fps b",
+                                                                          "press A", "profile 7", "fps c"])
 try:
     winprof.cut(["fps start\n", "hold LEFT 60\n", "fps g: held\n"], "g: held", 1)
     check("a window without a wait refused", False)
@@ -67,6 +70,12 @@ check("summary takes the window's drawn fps", fps == 20.0)
 check("summary ms a frame = share x 1000 / fps", abs(rows[0][1] - 25.0) < 1e-9 and rows[0][2] == "vid_rect")
 check("summary slow frames", slow.startswith("slow frames: 3 of 4"))
 check("summary slow+ lines", len(plus) == 1 and plus[0].startswith("2.00 ms/frame  vid_rect"))
+EARLIER = """harness: profile of 9 instructions, 9 cycles (1.0 video frames), 0.0% outside known symbols
+harness:    90.0%  old_func
+harness: slow frames: 9 of 9 over 33.3 ms (worst 99.0 ms)
+"""
+rows, slow, _, _ = winprof.summary(EARLIER + LOG)
+check("summary reads the last profile only", rows[0][2] == "vid_rect" and len(rows) == 2 and "3 of 4" in slow)
 rows, _, _, fps = winprof.summary(LOG, 10.0)
 check("summary fps override", fps == 10.0 and abs(rows[1][1] - 10.0) < 1e-9)
 print("test_winprof: %d failed" % fails)
