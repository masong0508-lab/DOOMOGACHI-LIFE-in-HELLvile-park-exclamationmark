-    NULL, NULL, NULL, dy_stamp, dy_stamp_keys, dy_stamp_strip
+    NULL, NULL, NULL, MG_BAKED(dy_stamp), MG_BAKED(dy_stamp_keys), MG_BAKED(dy_stamp_strip)
 };
 
