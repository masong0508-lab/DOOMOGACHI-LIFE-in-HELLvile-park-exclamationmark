From 59bfa3c1840863917fd564f7f829ead091ce11b8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 13:42:24 +0000
Subject: [PATCH 08/15] S2-4b: the Dodge's first hit no longer costs a frame
 over 33 ms (ldm/stm checker, hearts drawn once in READY)

The late Dodge window had one 50 ms frame, the first one that shows a hit (work 39.3 ms:
the full-screen flash checker 7.9 ms, the hit's six heart shapes computed for the cache
~4 ms). The checker of the UI group takes eight words at a time with ldm / stm
(7.9 -> ~5 ms; et_blittest compares it with plat_checker_m4 on 3,000 clipped cases, 6,300
cases ok) and the Dodge draws its three heart colours at both sizes once while READY goes
by (GBA only; the backdrop paints over them). Frames equal to the base ROM from tick 0
in all six games (the same 10 load-fade frames as before). UI overlay group 4,772 ->
5,152 B (the slot is sized by the 3D group: IWRAM unchanged).
Late window: 29.9 fps with one 50 ms frame -> 30.0, work max 30.6 ms, no frame over 33 ms.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RLcGbHBa2kju7ynbaJLHT6
---
 core/src/mg_dodge.c | 19 +++++++++++++++++++
 gba/src/blit2.c     | 25 +++++++++++++++++++++++++
 2 files changed, 44 insertions(+)

diff --git a/core/src/mg_dodge.c b/core/src/mg_dodge.c
index be8fe5e8..7bfbbd20 100644
--- a/core/src/mg_dodge.c
+++ b/core/src/mg_dodge.c
@@ -437,9 +437,28 @@ static void cherub(int x, int y, int t, int flap, int focus, int hide)
         }
 }
 
+#if defined(DOOMO_PLATFORM_GBA)
+/* (S2-4b) The hit's hearts (mg_lose_life, the burst, the mercy hearts: three colours, two sizes) are shapes from ui_raster.c's
+ * cache: each is computed once (a mask, its shading, ~0.7 ms) and then replayed. The first hit of a round computed all six in one
+ * frame and was the only frame of the late window over 33 ms (39 ms). They are drawn once while READY goes by (a cheap frame) and
+ * the backdrop paints over them: the same pixels, the cost moved. Not for a shape cut by the screen's edge (it is not cached). */
+static void warm_hearts(void)
+{
+    uint8_t col[3];
+    int i;
+    col[0] = PAL_PAINT(PAINT_ROSE, 2);
+    col[1] = PAL_GRAY_L;
+    col[2] = PAL_PAINT(PAINT_BUBBLEGUM, 2);
+    for (i = 0; i < 6; i++) ui_heart(24 + 36 * i, 60, 3 - (i & 1), col[i >> 1]);
+}
+#endif
+
 static void dg_draw(void)
 {
     int i, t = mg.play_t + mg.t, ox = mg.ox, oy = mg.oy;
+#if defined(DOOMO_PLATFORM_GBA)
+    if (mg.phase == MGP_READY && mg.t >= 3 && mg.t < 12 && !mg_big() && !plat_draw_skipped()) warm_hearts();
+#endif
     lounge_bg(t);
     vapula(t);
     cherub(S->px16 / 16 + ox, S->py16 / 16 + oy, t, S->flap, S->focus, S->inv && (S->inv & 4));
diff --git a/gba/src/blit2.c b/gba/src/blit2.c
index 34bbfb48..76a77f28 100644
--- a/gba/src/blit2.c
+++ b/gba/src/blit2.c
@@ -262,6 +262,31 @@ static inline __attribute__((always_inline)) void checker_body(int x, int y, int
         if (px & 1) { keep = 0x00FF00FFu; put = color << 8 | color << 24; }
         else        { keep = 0xFF00FF00u; put = color | color << 16; }
         if (((uintptr_t)p & 2) && n) { *p = (uint16_t)((*p & keep) | put); p++; n--; }
+        /* (S2-4b) 8 words (16 pixels) a time with ldm / stm: the one-word loop costs ~13.8 cycles a word on the
+         * 16-bit VRAM bus (a read, two ALU ops, a write and the loop), this ~6.8: the full-screen flash 7.9 -> ~4 ms.
+         * ldm and stm give the same register the same word of the eight, so the order the compiler picks is free. */
+        if (n >= 16) {
+            volatile uint32_t *q = (volatile uint32_t *)p;
+            for (; n >= 16; n -= 16, p += 16) {
+                register uint32_t a0 __asm__("r3"), a1 __asm__("r4"), a2 __asm__("r5"), a3 __asm__("r6"),
+                                  a4 __asm__("r7"), a5 __asm__("r8"), a6 __asm__("r9"), a7 __asm__("r10");
+                __asm__ volatile(
+                    "ldmia %[q], {r3-r10}\n\t"
+                    "and r3, r3, %[k]\n\torr r3, r3, %[p]\n\t"
+                    "and r4, r4, %[k]\n\torr r4, r4, %[p]\n\t"
+                    "and r5, r5, %[k]\n\torr r5, r5, %[p]\n\t"
+                    "and r6, r6, %[k]\n\torr r6, r6, %[p]\n\t"
+                    "and r7, r7, %[k]\n\torr r7, r7, %[p]\n\t"
+                    "and r8, r8, %[k]\n\torr r8, r8, %[p]\n\t"
+                    "and r9, r9, %[k]\n\torr r9, r9, %[p]\n\t"
+                    "and r10, r10, %[k]\n\torr r10, r10, %[p]\n\t"
+                    "stmia %[q], {r3-r10}"
+                    : "=&r"(a0), "=&r"(a1), "=&r"(a2), "=&r"(a3), "=&r"(a4), "=&r"(a5), "=&r"(a6), "=&r"(a7)
+                    : [q] "r"(q), [k] "r"(keep), [p] "r"(put)
+                    : "memory");
+                q += 8;
+            }
+        }
         for (; n >= 2; n -= 2, p += 2) {
             volatile uint32_t *q = (volatile uint32_t *)p;
             *q = (*q & keep) | put;
-- 
2.43.0

