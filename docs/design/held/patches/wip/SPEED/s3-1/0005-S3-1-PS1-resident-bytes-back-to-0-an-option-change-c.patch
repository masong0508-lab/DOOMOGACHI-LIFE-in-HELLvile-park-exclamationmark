+/* the fastest shipped clock (speed_q 16, ticks_per_minute_q 75) earns 14.2 slots a tick: sim_tick's loop ends
+ * on its own and never goes over SIM_BATCH */
+DOOMO_STATIC_ASSERT(SIM_PASS_NUM * 16 <= (SIM_BATCH - 1) * SIM_PASS_DEN * 75, sim_pass_fits_a_tick);
+
 void sim_tick(void)
 {
-    int per, spd, steps = 0, i;
+    int per, spd, steps = 0;
     uint32_t credit, need;
     sim_ensure_init();
     sim_s.ops = 0;
@@ -848,18 +853,19 @@ void sim_tick(void)
         steps++;
     }
     if (sim_s.acc >= per) sim_s.acc = (uint16_t)(per - 1);
-    /* S3-1: the pass moves with the clock (sim_int.h), one slot per `need` of credit; SIM_BATCH is the
-     * hard cap of one tick (the shipped clocks need 15 slots at most: credit over the cap is dropped, the
-     * pass then simply takes longer than SIM_INTERVAL and every update covers the minutes it really waited) */
+    /* S3-1: the pass moves with the clock (sim_int.h): one slot per `need` of credit. What is left is under
+     * one slot. The shipped clocks earn at most SIM_BATCH - 1 slots a tick (static assert above); only a
+     * change of the day length between two ticks leaves more credit behind (in the old clock's units), and
+     * a tick never pays out more than SIM_BATCH slots. */
     need = (uint32_t)(SIM_PASS_DEN * per);
     credit = sim_s.pass_credit + (uint32_t)(SIM_PASS_NUM * spd);
-    for (i = 0; i < SIM_BATCH && credit >= need; i++) {
+    if (credit > need * SIM_BATCH) credit = need * SIM_BATCH;
+    while (credit >= need) {
         int id = sim_s.cursor;
         credit -= need;
         sim_s.cursor = (uint16_t)(sim_s.cursor + 1 >= DOOMO_MAX_RESIDENTS ? 0 : sim_s.cursor + 1);
         update_resident(id);
     }
-    if (credit > need) credit = need;
     sim_s.pass_credit = (uint16_t)credit;
     sim_edges_step(SIM_EDGE_BATCH);
     if (sim_s.ops > sim_s.max_ops) sim_s.max_ops = sim_s.ops;
@@ -892,7 +898,7 @@ void sim_advance_minutes(int minutes)
         if (chunk > left) chunk = left;
         for (i = 0; i < chunk; i++) minute_step();
         sim_s.job_budget = 32;
-        for (i = 0; i < DOOMO_MAX_RESIDENTS; i++) update_resident_ex(i, 1, SIM_MIN_ELAPSED);
+        for (i = 0; i < DOOMO_MAX_RESIDENTS; i++) update_resident_ex(i, 1);
     }
     /* give the graph a proportional share of attention (at most one full pass) */
     passes = (int)(sim_s.edge_credit / 60u);
diff --git a/core/src/sim_int.h b/core/src/sim_int.h
index a97da735..3901f815 100644
--- a/core/src/sim_int.h
+++ b/core/src/sim_int.h
@@ -22,17 +22,18 @@
 #define SIM_MAX_ELAPSED 720        /* minutes one resident update may cover */
 #define SIM_MIN_ELAPSED 15         /* a fast-forward chunk updates a resident
                                       only when 15 game minutes have passed */
+#define SIM_INTERVAL    15         /* S3-1: game minutes in which every resident is visited once    */
+#define SIM_PASS_MIN    8          /* ... and a visit of the pass lives at least this many of them  */
 /* S3-1: the resident pass is spread over the whole interval. The cursor
  * moves at a steady DOOMO_MAX_RESIDENTS slots per SIM_INTERVAL game minutes
  * (about 0.9 slots a tick at the default clock, 14.2 at the fastest), so
  * every resident is updated once per SIM_INTERVAL and no tick does a
  * town's worth of work. A tick earns SIM_PASS_NUM * speed credit, a slot
- * costs SIM_PASS_DEN * ticks_per_minute_q (200 / 3 = 1000 / 15). A visit
- * that would cover less than SIM_PASS_MIN minutes (the first pass after
- * sim_init, a load or a fast-forward set every stamp to "now") is left to
- * the next pass: no minute is lost or counted twice. */
-#define SIM_INTERVAL    15
-#define SIM_PASS_MIN    ((SIM_INTERVAL + 1) / 2)
+ * costs SIM_PASS_DEN * ticks_per_minute_q (200 / 3 = 1000 / 15). The first
+ * pass after sim_init, a load or a fast-forward finds every stamp at "now":
+ * a visit that would live fewer than SIM_PASS_MIN minutes leaves the stamp
+ * alone and the next one lives them all, so no minute is lost or counted
+ * twice. */
 #define SIM_PASS_NUM    (DOOMO_MAX_RESIDENTS / 5)
 #define SIM_PASS_DEN    (SIM_INTERVAL / 5)
 DOOMO_STATIC_ASSERT(SIM_PASS_NUM * 5 == DOOMO_MAX_RESIDENTS && SIM_PASS_DEN * 5 == SIM_INTERVAL,
@@ -105,7 +106,6 @@ void sim_social_init(void);              /* rebuild taken / crush bitsets  */
 void sim_edges_step(int max_visits);
 void sim_venue_meet(int id, DoomoResident *r, int minutes);
 void sim_taken_update(int id);
