         }
-        remove_edge(best);
+        rel_remove_at(best);
     }
     k = ((uint32_t)a << 16) | (uint32_t)b;
     i = lower_bound(k);
diff --git a/core/tests/test_sim_pass.c b/core/tests/test_sim_pass.c
