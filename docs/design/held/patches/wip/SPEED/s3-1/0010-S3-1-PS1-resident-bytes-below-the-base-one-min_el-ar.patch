From 0fcd7c38e31cc6451f16220d0958b75521d824b9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 16:34:51 +0000
Subject: [PATCH 10/12] S3-1: PS1 resident bytes below the base (one min_el
 argument), the sim group's fps floors 29.5

On the rebased tree (0x801ef580 = origin f91bd3e4's end) the first cut still cost the PS1 16 B: .text +4 B, and the
base's text ended exactly on the 16-byte boundary where .rodata starts. update_resident_ex takes the fewest game
minutes an update may cover (SIM_PASS_MIN for the pass, SIM_MIN_ELAPSED for a fast-forward chunk, which also chooses
the routine again) instead of a flag and a conditional line: the same behaviour, update_resident_ex -16 B on the
PS1 and 168 B on the GBA. PS1 text now -12 B against the base: the EXE ends at 0x801ef580, the same as origin.

speed2_sim.txt: the shop, picker and pet windows' expect-fps floors 29.5 (29.8-30.0 measured); the pet window sat
exactly on 29.8 and an unrelated cost change would have failed the group by 0.1 fps. expect-gap 51 stays: it is
the check that sees the pass burst.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RLcGbHBa2kju7ynbaJLHT6
---
 core/src/sim.c                     | 20 ++++++++++----------
 gba/harness/scripts/speed2_sim.txt | 16 +++++++++-------
 2 files changed, 19 insertions(+), 17 deletions(-)

diff --git a/core/src/sim.c b/core/src/sim.c
index 0663f59a..c014f8f4 100644
--- a/core/src/sim.c
+++ b/core/src/sim.c
@@ -676,12 +676,12 @@ int sim_mood_of(int id)
 
 /* ---------------------------------------------------------------------- */
 /* one resident                                                             */
-/* force_decide: a fast-forward chunk stands on the last minute of the hour the
- * elapsed span belongs to, so the routine is chosen again even though the clock
- * has not crossed an hour boundary since the last update.
- * An update that would cover too few game minutes is skipped, the stamp stays and the next visit applies them
- * all: under SIM_MIN_ELAPSED for a fast-forward chunk, under SIM_PASS_MIN for the pass. */
-static void update_resident_ex(int id, int force_decide)
+/* min_el: the fewest game minutes an update may cover. An update that would cover fewer is skipped, the stamp
+ * stays and the next visit applies them all. SIM_PASS_MIN for the pass of sim_tick (S3-1); SIM_MIN_ELAPSED for a
+ * fast-forward chunk (sim_advance_minutes), which also chooses the routine again (min_el > SIM_PASS_MIN): a chunk
+ * stands on the last minute of the hour the elapsed span belongs to, so the clock has not crossed an hour boundary
+ * since the last update. (One argument for both jobs: 16 B less PS1 resident code than a flag and a conditional line.) */
+static void update_resident_ex(int id, int min_el)
 {
     DoomoResident *r = &doomo_town.res[id];
     uint16_t now16;
@@ -691,13 +691,13 @@ static void update_resident_ex(int id, int force_decide)
     sim_s.ops++;
     now16 = (uint16_t)sim_now();
     el = (uint16_t)(now16 - sim_s.stamp[id]);
-    if (el < (force_decide ? SIM_MIN_ELAPSED : SIM_PASS_MIN)) return;
+    if (el < min_el) return;
     if (el > SIM_MAX_ELAPSED) el = SIM_MAX_ELAPSED;
     sim_s.stamp[id] = now16;
     res_in(r, &in);
 
     /* routines change on the hour (or when a need gets urgent) */
-    if (force_decide || doomo_town.minute / 60 != ((doomo_town.minute + 1440 - el) % 1440) / 60 || el >= 60 ||
+    if (min_el > SIM_PASS_MIN || doomo_town.minute / 60 != ((doomo_town.minute + 1440 - el) % 1440) / 60 || el >= 60 ||
         r->stat[STAT_HEALTH] < 25 || r->stat[STAT_HUNGER] < 28 || r->stat[STAT_ENERGY] < 12 ||
         r->status != RES_ALIVE) {
         act = decide_activity(id, r, &in);
@@ -712,7 +712,7 @@ static void update_resident_ex(int id, int force_decide)
     sim_mood_of(id);
 }
 
-static void update_resident(int id) { update_resident_ex(id, 0); }
+static void update_resident(int id) { update_resident_ex(id, SIM_PASS_MIN); }
 
 /* ---------------------------------------------------------------------- */
 /* the clock                                                                */
@@ -898,7 +898,7 @@ void sim_advance_minutes(int minutes)
         if (chunk > left) chunk = left;
         for (i = 0; i < chunk; i++) minute_step();
         sim_s.job_budget = 32;
-        for (i = 0; i < DOOMO_MAX_RESIDENTS; i++) update_resident_ex(i, 1);
+        for (i = 0; i < DOOMO_MAX_RESIDENTS; i++) update_resident_ex(i, SIM_MIN_ELAPSED);
     }
     /* give the graph a proportional share of attention (at most one full pass) */
     passes = (int)(sim_s.edge_credit / 60u);
diff --git a/gba/harness/scripts/speed2_sim.txt b/gba/harness/scripts/speed2_sim.txt
index fa54d649..cdcb4b3e 100644
--- a/gba/harness/scripts/speed2_sim.txt
+++ b/gba/harness/scripts/speed2_sim.txt
@@ -10,10 +10,12 @@
 # clock (day length 1 hour, speed x1), so one pass is inside it wherever it starts. The hub window waits out the
 # settle after the new island (map parts and portraits, ~250 ticks) and the hub's own 67 ms frame at tick ~670.
 # The scenes are the ones the audit saw hitch: the island hub, the shop's gifts tab, the citizen picker, the pet.
-# Gates (GBA only; tools/speed2.py drops them for the PS1 and the Dreamcast): `expect-fps 29.8` and `expect-gap 51`
-# after each window: no presented frame of 4 vblanks (67 ms) or more. Before S3-1 the pass gave 4-6 vblank frames
-# in every window (worst 67 / 84 / 100 / 100 ms). What is left is a few single 50 ms frames in the picker and pet
-# windows: their ticks are within 3 ms of the budget on their own and the sim now costs ~0.4 ms in every tick.
+# Gates (GBA only; tools/speed2.py drops them for the PS1 and the Dreamcast): `expect-gap 51` after each window (no
+# presented frame of 4 vblanks, 67 ms, or more) is the one that sees the pass burst again: before S3-1 the pass gave
+# 4-6 vblank frames in every window (worst 67 / 84 / 100 / 100 ms). The fps floors are 29.8 for the hub (30.0 measured)
+# and 29.5 for the shop, picker and pet (29.8-30.0 measured): the picker and pet windows have a few single 50 ms frames
+# of their own (their ticks are within 3 ms of the budget and the sim costs 0.4-1.2 ms of average work in every tick),
+# and an unrelated change of a tick's cost must not fail this group by 0.1 fps.
 wait 40
 expect-log doomo: init
 sync on 61
@@ -43,7 +45,7 @@ press R
 wait 16
 fps start
 wait 1200
-expect-fps 29.8 sim: shop gifts tab, one interval
+expect-fps 29.5 sim: shop gifts tab, one interval
 expect-gap 51
 shot sim_shop_gifts
 press B
@@ -54,7 +56,7 @@ push PICKER 0
 wait 30
 fps start
 wait 1200
-expect-fps 29.8 sim: citizen picker, one interval
+expect-fps 29.5 sim: citizen picker, one interval
 expect-gap 51
 shot sim_picker
 press B
@@ -70,6 +72,6 @@ press START
 wait 100
 fps start
 wait 1200
-expect-fps 29.8 sim: pet main, one interval
+expect-fps 29.5 sim: pet main, one interval
 expect-gap 51
 shot sim_pet
-- 
