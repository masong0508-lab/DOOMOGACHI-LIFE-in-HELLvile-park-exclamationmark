From c8ef38b1e3e682b32edcaf3ce25d6a84993e941b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 20:44:25 +0000
Subject: [PATCH] S3-12: big text made once (the shape cache keeps the titles
 in use)

When the shape pool or entry table fills, the big outlined text (K_TEXT) drawn in the
last 3 frames by the scene on top moves to the front and stays; everything else goes
as before. A shape whose recording fills the pool keeps recording into the freed
pool instead of failing and being rasterised a second time. A title partly off the
screen (READY? dropping in) is recorded whole and replayed clipped, so it is made once.
0 B: the frame stamp is 8 bits of the entry word that held start/n.

GBA: chapter card 4 22.0 -> 30.0 fps (12 frames of 83-88 ms -> 0 over 33 ms);
Fun Fair game starts 85-176 -> 69-160 ms. Frames exact (vhash-seq, load fade off).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RLcGbHBa2kju7ynbaJLHT6
---
 core/src/ui_raster.c        | 116 ++++++++++++++++++++++++++++---
 core/tests/test_ui_raster.c | 134 ++++++++++++++++++++++++++++++++++++
 2 files changed, 241 insertions(+), 9 deletions(-)

diff --git a/core/src/ui_raster.c b/core/src/ui_raster.c
index 1e783964..4ef8c2f2 100644
--- a/core/src/ui_raster.c
+++ b/core/src/ui_raster.c
@@ -158,7 +158,8 @@ enum { K_HEART = 1, K_TINY, K_STAR, K_GLYPH, K_TEXT, K_ELLIPSE };
 typedef uint32_t SRect;
 typedef struct {
     uint32_t k0, k1, k2;
-    uint16_t start, n;
+    uint32_t start : 12, n : 12;       /* its rects: sc_pool[start .. start + n) */
+    uint32_t seen : 8;                 /* (S3-12) low bits of the frame it was last drawn in */
     uint8_t pal[SC_PAL];
 #if !defined(DOOMO_PLATFORM_GBA)
     DoomoImage img;                    /* its pixels, valid iff igen == si_gen */
@@ -171,6 +172,31 @@ static SEnt sc_ent[SC_ENT];
 static int sc_top, sc_nent;
 static uint8_t sc_hash[SC_HASH];       /* entry index + 1, 0 = empty slot   */
 static uint32_t sc_resets, sc_misses, sc_hits, sc_replayed;
+DOOMO_STATIC_ASSERT(SC_POOL <= 4096 && SC_ENT <= 255, sc_fields_fit);
+
+/* (S3-12) Big outlined text (K_TEXT) is the dearest shape to make again (a wide title: text_emit + the run
+ * emitter, 20-45 ms on the GBA). When the pool fills, the big text drawn in the last few frames stays (it is
+ * moved to the front); everything else goes, as before. A title that leaves the screen is gone after
+ * SC_LIVE frames, so a scene "pins" its titles just by drawing them. */
+#define SC_LIVE 3u
+static int sc_keep_off;                /* set: sc_evict keeps nothing */
+static const DoomoScene *sc_scene;     /* the scene on top when a shape was last stamped, */
+static uint32_t sc_scene_at;           /* and the frame it came up (a new scene keeps nothing of the old) */
+static uint32_t sc_now(void)
+{
+    uint32_t now = doomo_frame_count();
+    if (scene_top() != sc_scene) {
+        sc_scene = scene_top();
+        sc_scene_at = now;
+    }
+    return now & 255u;
+}
+
+static int sc_keep(const SEnt *e)
+{
+    uint32_t age = (sc_now() - e->seen) & 255u, up = doomo_frame_count() - sc_scene_at;
+    return !sc_keep_off && (e->k0 & 255u) == K_TEXT && age <= SC_LIVE && age <= up;
+}
 
 static unsigned sc_slot(uint32_t k0, uint32_t k1, uint32_t k2)
 {
@@ -220,6 +246,66 @@ static void sc_reset(void)
 static SEnt *rec_e;
 static int rec_ax, rec_ay, rec_fail, rec_npal;
 
+static void sc_rehash(void)
+{
+    int i;
+    memset(sc_hash, 0, sizeof(sc_hash));
+    for (i = 0; i < sc_nent; i++) {
+        unsigned slot = sc_slot(sc_ent[i].k0, sc_ent[i].k1, sc_ent[i].k2);
+        while (sc_hash[slot]) slot = (slot + 1) & (SC_HASH - 1);
+        sc_hash[slot] = (uint8_t)(i + 1);
+    }
+}
+
+/* (S3-12) The pool or the entry table is full: drop every shape but the big text in use (sc_keep), which moves
+ * to the front of the pool in its order. A shape being recorded (rec_e, not yet an entry) moves behind it with
+ * the rects it has so far, so the recording goes on: nothing is rasterised twice. With nothing to keep this is
+ * sc_reset. Images (PS1 / native) all start over as in sc_reset: a kept shape paints its image again. */
+static void sc_evict(void)
+{
+    int i, k = 0, top = 0;
+    for (i = 0; i < sc_nent; i++)
+        if (sc_keep(&sc_ent[i])) break;
+    if (i == sc_nent) {
+        SEnt r;
+        if (rec_e) r = *rec_e;
+        sc_reset();
+        if (rec_e) {
+            memmove(&sc_pool[0], &sc_pool[r.start], sizeof(SRect) * r.n);
+            r.start = 0;
+            sc_ent[0] = r;
+            rec_e = &sc_ent[0];
+        }
+        return;
+    }
+    for (i = 0; i < sc_nent; i++) {
+        SEnt *e = &sc_ent[i];
+        if (!sc_keep(e)) continue;
+        if (e->start != (uint32_t)top) memmove(&sc_pool[top], &sc_pool[e->start], sizeof(SRect) * e->n);
+        e->start = (uint32_t)top;
+#if SC_IMAGES
+        e->igen = 0;
+#endif
+        top += e->n;
+        if (k != i) sc_ent[k] = *e;
+        k++;
+    }
+    if (rec_e) {
+        SEnt r = *rec_e;
+        memmove(&sc_pool[top], &sc_pool[r.start], sizeof(SRect) * r.n);
+        r.start = (uint32_t)top;
+        sc_ent[k] = r;
+        rec_e = &sc_ent[k];
+    }
+#if SC_IMAGES
+    si_reset();
+#endif
+    sc_top = top;
+    sc_nent = k;
+    sc_rehash();
+    sc_resets++;
+}
+
 static void rec_add(int x, int y, int w, int h, uint8_t c)
 {
     int rx = x - rec_ax, ry = y - rec_ay, i;
@@ -229,7 +315,17 @@ static void rec_add(int x, int y, int w, int h, uint8_t c)
         rec_fail = 2;                   /* this shape cannot be cached     */
         return;
     }
-    if (sc_top + rec_e->n >= SC_POOL) { rec_fail = 1; return; }    /* full */
+    if (sc_top + rec_e->n >= SC_POOL) {
+        /* full: make room (S3-12: the big text in use stays) and go on recording; a shape that does not fit
+         * even beside nothing is drawn directly (ur_cache_end returns 0) */
+        sc_evict();
+        if (sc_top + rec_e->n >= SC_POOL && sc_top > 0) {
+            sc_keep_off = 1;
+            sc_evict();
+            sc_keep_off = 0;
+        }
+        if (sc_top + rec_e->n >= SC_POOL) { rec_fail = 1; return; }
+    }
     for (i = 0; i < rec_npal && rec_e->pal[i] != c; i++) {}
     if (i == rec_npal) {
         if (rec_npal == SC_PAL) { rec_fail = 2; return; }
@@ -343,6 +439,7 @@ int ur_cache_draw(uint32_t k0, uint32_t k1, uint32_t k2, int ax, int ay)
     for (n = 0; n < SC_HASH && sc_hash[slot]; n++, slot = (slot + 1) & (SC_HASH - 1)) {
         SEnt *e = &sc_ent[sc_hash[slot] - 1];
         if (e->k0 == k0 && e->k1 == k1 && e->k2 == k2) {
+            if ((k0 & 255u) == K_TEXT) e->seen = sc_now();     /* (only big text is kept) */
 #if SC_IMAGES
             if (si_draw(e, ax, ay)) { sc_hits++; return 1; }
 #endif
@@ -374,11 +471,14 @@ void ur_cache_image_stats(uint32_t *replayed, uint32_t *built, uint32_t *drawn)
 
 void ur_cache_begin(uint32_t k0, uint32_t k1, uint32_t k2, int ax, int ay)
 {
+    rec_e = NULL;
+    if (sc_nent == SC_ENT) sc_evict();
     if (sc_nent == SC_ENT) sc_reset();
     rec_e = &sc_ent[sc_nent];
     rec_e->k0 = k0; rec_e->k1 = k1; rec_e->k2 = k2;
-    rec_e->start = (uint16_t)sc_top;
+    rec_e->start = (uint32_t)sc_top;
     rec_e->n = 0;
+    rec_e->seen = (k0 & 255u) == K_TEXT ? sc_now() : 0;
 #if SC_IMAGES
     rec_e->igen = 0;
     rec_e->last = 0;
@@ -395,11 +495,7 @@ int ur_cache_end(void)
     SEnt *e = rec_e;
     rec_e = NULL;
     if (!e) return 0;
-    if (rec_fail) {
-        /* pool full: start over (the shapes in use come back next frame) */
-        if (rec_fail == 1) sc_reset();
-        return 0;
-    }
+    if (rec_fail) return 0;            /* (S3-12: the pool was made room for in rec_add) */
     sc_top += e->n;
     sc_nent++;
     {
@@ -1559,7 +1655,9 @@ static void text_emit(const TextBlock *tb, const uint8_t col[4])
         int rel = q - 1, is_top = 0, run_x = 0, run_c = -1;
         uint32_t any = 0;
         text_grow(tb, q + 1, gd);
-        if (oy + q < 0 || oy + q >= sh) { rec_clipped(); continue; }
+        /* (S3-12) rows off the screen are skipped, but a shape being recorded keeps them: the replay clips (every
+         * plat_rect does), so a title dropping in from the top is made once, not twice a frame */
+        if ((oy + q < 0 || oy + q >= sh) && !rec_e) continue;
         for (k = 0; k < nw; k++) {
             dil[k] = gu[k] | g[k] | gd[k];
             any |= dil[k] | gs[k];
diff --git a/core/tests/test_ui_raster.c b/core/tests/test_ui_raster.c
index 8d3130e3..ba670fd5 100644
--- a/core/tests/test_ui_raster.c
+++ b/core/tests/test_ui_raster.c
@@ -443,3 +443,137 @@ TEST(ui_raster_const_tables)
         CHECK_EQ(row, r);
     }
 }
+
+/* ---- (S3-12) big text made once ------------------------------------------------------------------------- */
+static uint32_t sc_stat_misses(int *used)
+{
+    int u, n;
+    uint32_t h, m, r;
+    ur_cache_stats(&u, &n, &h, &m, &r);
+    if (used) *used = u;
+    return m;
+}
+
+static uint32_t sc_stat_resets(void)
+{
+    int u, n;
+    uint32_t h, m, r;
+    ur_cache_stats(&u, &n, &h, &m, &r);
+    return r;
+}
+
+/* fill the shape cache with distinct hearts (not big text) until it has been made room for at least once */
+static void sc_flood(int seed)
+{
+    uint32_t r0 = sc_stat_resets();
+    int i;
+    for (i = 0; i < 400 && sc_stat_resets() == r0; i++)
+        ui_heart(120, 80, 6 + i % 24, (uint8_t)(16 + (seed * 7 + i / 24) % 200));
+    for (; i < 460; i++) ui_heart(120, 80, 6 + i % 24, (uint8_t)(16 + (seed * 7 + i / 24) % 200));
+}
+
+#define T_BIG(x, y, s, sc) ui_text_big(x, y, s, sc, PAL_PAINT(PAINT_BUBBLEGUM, 1), PAL_RAMP(RAMP_PASTEL_PINK, 1))
+
+/* a title on screen stays made while the pool turns over under it (chapter card 4: hearts of five sizes
+ * pushed the two titles out every ~10 frames, 12 frames of 83-87 ms on the GBA) */
+TEST(ui_raster_big_text_kept)
+{
+    uint32_t m;
+    test_reset();
+    doomo_frame(0);
+    bg();
+    T_BIG(20, 40, "Chapter 4", 2);
+    T_BIG(20, 40, "Chapter 4", 2);                  /* made (if it was not) */
+    sc_flood(1);
+    m = sc_stat_misses(NULL);
+    T_BIG(20, 40, "Chapter 4", 2);
+    CHECK_MSG(sc_stat_misses(NULL) == m, "the title in use was dropped when the pool was made room for");
+    /* the pixels are still the reference's */
+    SAME(ref_text_big(20, 40, "Chapter 4", 2, PAL_PAINT(PAINT_BUBBLEGUM, 1), PAL_RAMP(RAMP_PASTEL_PINK, 1)),
+         T_BIG(20, 40, "Chapter 4", 2));
+}
+
+/* one that has not been drawn for a few frames goes like any other shape */
+TEST(ui_raster_big_text_expires)
+{
+    uint32_t m;
+    int i;
+    test_reset();
+    doomo_frame(0);
+    T_BIG(20, 40, "Gone soon", 2);
+    for (i = 0; i < 6; i++) doomo_frame(0);
+    sc_flood(2);
+    m = sc_stat_misses(NULL);
+    T_BIG(20, 40, "Gone soon", 2);
+    CHECK_MSG(sc_stat_misses(NULL) == m + 1, "a title off the screen for 6 frames was kept");
+}
+
+/* a shape whose recording fills the pool is still made (the pool is made room for under it and the recording
+ * goes on), so it is not rasterised twice in that frame and again in the next */
+TEST(ui_raster_big_text_fills_pool)
+{
+    uint32_t m, r0;
+    int used = 0, i;
+    test_reset();
+    for (i = 0; i < 8; i++) doomo_frame(0);         /* nothing is kept */
+    sc_flood(3);
+    r0 = sc_stat_resets();
+    for (i = 0; i < 400; i++) {
+        sc_stat_misses(&used);
+        if (used > 2300) break;                       /* (the native pool is 2560 rects) */
+        ui_heart(120, 80, 6 + i % 24, (uint8_t)(16 + (11 + i / 24) % 200));
+    }
+    CHECK(used > 2300);
+    CHECK_EQ(sc_stat_resets(), r0);
+    bg();
+    T_BIG(10, 30, "DOOMOGACHI", 4);                 /* > 260 rects: fills the pool while it is recorded */
+    keep_ref();
+    CHECK(sc_stat_resets() > r0);
+    m = sc_stat_misses(NULL);
+    bg();
+    T_BIG(10, 30, "DOOMOGACHI", 4);
+    CHECK_MSG(sc_stat_misses(NULL) == m, "the shape that filled the pool was not kept");
+    CHECK_EQ(fb_diff(), 0);
+    SAME(ref_text_big(10, 30, "DOOMOGACHI", 4, PAL_PAINT(PAINT_BUBBLEGUM, 1), PAL_RAMP(RAMP_PASTEL_PINK, 1)),
+         T_BIG(10, 30, "DOOMOGACHI", 4));
+}
+
+/* a title partly above or below the screen (READY? dropping in) is made once and replayed clipped */
+TEST(ui_raster_big_text_clipped_kept)
+{
+    static const int ys[] = { -20, -5, 150, 160 };
+    uint32_t m;
+    int i;
+    test_reset();
+    for (i = 0; i < DOOMO_COUNTOF(ys); i++) {
+        case_a = ys[i];
+        SAME(ref_text_big(40, ys[i], "READY?", 3, PAL_PAINT(PAINT_BUBBLEGUM, 1), PAL_RAMP(RAMP_PASTEL_PINK, 1)),
+             T_BIG(40, ys[i], "READY?", 3));
+    }
+    m = sc_stat_misses(NULL);
+    for (i = 0; i < DOOMO_COUNTOF(ys); i++) T_BIG(40, ys[i] + 3, "READY?", 3);
+    CHECK_MSG(sc_stat_misses(NULL) == m, "a title partly off the screen was not kept");
+}
+
+/* a new scene keeps nothing of the old one's titles, even ones drawn a frame ago (the Fun Fair's first
+ * frame after the title screen: the logo letters would crowd the booth's shapes out) */
+static const DoomoScene sc_test_scene = { "TESTKEEP", NULL, NULL, NULL, NULL, 0 };
+TEST(ui_raster_big_text_new_scene)
+{
+    uint32_t m;
+    test_reset();
+    doomo_frame(0);
+    T_BIG(20, 40, "Old scene", 2);
+    scene_push(&sc_test_scene, 0);
+    doomo_frame(0);                                  /* (the next frame draws the new scene) */
+    sc_flood(4);
+    m = sc_stat_misses(NULL);
+    T_BIG(20, 40, "Old scene", 2);
+    CHECK_MSG(sc_stat_misses(NULL) == m + 1, "the old scene's title was kept over a scene change (%u misses)", (unsigned)(sc_stat_misses(NULL) - m));
+    T_BIG(20, 40, "New scene", 2);
+    sc_flood(5);
+    m = sc_stat_misses(NULL);
+    T_BIG(20, 40, "New scene", 2);
+    CHECK_EQ(sc_stat_misses(NULL), m);
+    test_reset();
+}
-- 
