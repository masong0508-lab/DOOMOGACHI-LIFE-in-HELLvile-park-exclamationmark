 }
+
+/* (MEM2) the id -> entry map is generated too (core/gen/unlock_index.c doomo_ul_by_id: 2 KB of ROM, not of EWRAM).
+ * ul_by_check() proves it is the registry's first-entry-per-id map, and finds the duplicate ids as ul_init's own map
+ * did; when it is not (a stale file), unlock_by_id scans the registry (slow, not wrong). */
+extern const uint16_t doomo_ul_by_id_n;          /* DOOMO_UNLOCK_BITS; 0 = the weak default (stubs.c) */
+extern const int16_t  doomo_ul_by_id[];
+static uint8_t ul_by_ok;
+
+static int ul_by_scan(int id)
+{
+    int g;
+    for (g = 0; g < ul_total; g++)
+        if (unlock_at(g)->id == id) return g;
+    return -1;
+}
+
+/* 1: no id is named twice; 0: one is (or the map is stale and the answer unknown: the slow paths count) */
+static int ul_by_check(void)
+{
+    int g, firsts = 0, mapped = 0, dup = 0, i;
+    ul_by_ok = 0;
+    if (*(const volatile uint16_t *)&doomo_ul_by_id_n != DOOMO_UNLOCK_BITS) return 0;
+    for (g = 0; g < ul_total; g++) {
+        int id = unlock_at(g)->id, at;
+        if (id >= DOOMO_UNLOCK_BITS) continue;
+        at = doomo_ul_by_id[id];
+        if (at == g) firsts++;
+        else if (at >= 0 && at < g && unlock_at(at)->id == id) dup = 1;
+        else return 0;                       /* the map names a later entry, or none: stale */
+    }
+    for (i = 0; i < DOOMO_UNLOCK_BITS; i++) mapped += doomo_ul_by_id[i] >= 0;
+    if (mapped != firsts) return 0;          /* an id the registry does not have */
+    ul_by_ok = 1;
+    return !dup;
+}
+#define UL_BY_ID(id) (ul_by_ok ? (int)doomo_ul_by_id[id] : ul_by_scan(id))
+#else
+static int16_t  ul_by_id[DOOMO_UNLOCK_BITS];      /* global index or -1 */
+#define UL_BY_ID(id) ul_by_id[id]
 #endif
 
 int unlock_index_active(void)
 {
 #if defined(UL_HAVE_INDEX)
     unlock_count();
-    return ul_ix_ok;
+    return ul_ix_ok && ul_by_ok;
 #else
     return 0;
 #endif
@@ -282,8 +320,8 @@ int unlock_index_use(int on)
 #if defined(UL_HAVE_INDEX)
     int was = unlock_index_active();
     memset(ul_fc, 0, sizeof(ul_fc));      /* the C3 memo: the next answers come from the chosen path */
-    if (!on) ul_ix_ok = 0;
-    else ul_ix_check();
+    if (!on) ul_ix_ok = ul_by_ok = 0;
+    else { ul_ix_check(); ul_by_check(); }
     return was;
 #else
     (void)on;
@@ -297,21 +335,20 @@ static void ul_init(void)
     if (ul_ready) return;
     ul_ready = 1;
     memset(ul_fc, 0, sizeof(ul_fc));
+#if !defined(UL_HAVE_INDEX)
     for (i = 0; i < DOOMO_UNLOCK_BITS; i++) ul_by_id[i] = -1;
+#endif
