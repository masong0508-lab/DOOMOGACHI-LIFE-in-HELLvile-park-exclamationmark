index f5a60abb..c9534549 100644
--- a/core/tests/test_integration.c
+++ b/core/tests/test_integration.c
@@ -354,3 +354,31 @@ TEST(x3_unlock_index_matches_the_scan)
     CHECK(unlock_index_active());
     memcpy(doomo_town.unlocks, saved, sizeof(saved));
 }
+
+/* (MEM2) unlock_by_id through the generated id map (core/gen/unlock_index.c doomo_ul_by_id, ROM instead of a 2 KB
+ * RAM table) names the same entry as the registry scan for every id, and the owned count is the scan's */
+TEST(mem2_unlock_by_id_map_matches_the_scan)
+{
+    uint8_t saved[sizeof(doomo_town.unlocks)];
+    int id, i, a_n, b_n;
+    CHECK_MSG(unlock_index_active(), "core/gen/unlock_index.c is stale: run make -C core gen");
+    for (id = -2; id <= DOOMO_UNLOCK_BITS + 1; id++) {
+        const DoomoUnlock *a, *b;
+        unlock_index_use(1);
+        a = unlock_by_id(id);
+        unlock_index_use(0);
+        b = unlock_by_id(id);
+        CHECK_MSG(a == b, "id %d: map %p scan %p", id, (const void *)a, (const void *)b);
+        CHECK(!a || a->id == id);
+    }
+    memcpy(saved, doomo_town.unlocks, sizeof(saved));
+    for (i = 0; i < (int)sizeof(saved); i++) doomo_town.unlocks[i] = (uint8_t)(i * 37u + 11u);
+    unlock_index_use(1);
+    a_n = unlock_owned_count();
+    unlock_index_use(0);
+    b_n = unlock_owned_count();
+    CHECK_EQ(a_n, b_n);
+    unlock_index_use(1);
+    CHECK(unlock_index_active());
+    memcpy(doomo_town.unlocks, saved, sizeof(saved));
+}
