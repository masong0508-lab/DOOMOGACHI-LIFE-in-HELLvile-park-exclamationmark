                 if (ul_by_id[u[i].id] < 0) ul_by_id[u[i].id] = (int16_t)g;
-                else {
-                    plat_log("unlocks: duplicate unlock id");
-#if !defined(DOOMO_PLATFORM_PS1)
-                    ul_ready = 2;                /* (S2-6) unlock_owned_count cannot count bits */
-#endif
-                }
+                else plat_log("unlocks: duplicate unlock id");
             }
+#endif
             {
                 unsigned hb = UL_HASH(u[i].cat, u[i].list, u[i].index);
                 ul_filter[hb >> 3] |= (uint8_t)(1u << (hb & 7));
@@ -333,6 +370,10 @@ static void ul_init(void)
     ul_total = (uint16_t)g;
 #if defined(UL_HAVE_INDEX)
     ul_ix_check();
+    if (!ul_by_check()) {
+        if (ul_by_ok) plat_log("unlocks: duplicate unlock id");
+        ul_ready = 2;                            /* (S2-6) unlock_owned_count cannot count bits */
+    }
 #endif
 }
 
@@ -356,8 +397,8 @@ const DoomoUnlock *unlock_at(int i)
 const DoomoUnlock *unlock_by_id(int id)
 {
     ul_init();
-    if (id < 0 || id >= DOOMO_UNLOCK_BITS || ul_by_id[id] < 0) return NULL;
-    return unlock_at(ul_by_id[id]);
+    if (id < 0 || id >= DOOMO_UNLOCK_BITS) return NULL;
+    return unlock_at(UL_BY_ID(id));
 }
 
 static int ul_is_alias(int list, int index)
@@ -592,7 +633,7 @@ int unlock_owned_count(void)
         for (i = 0; i < DOOMO_UNLOCK_BITS / 8; i++) {
             unsigned b = doomo_town.unlocks[i], j;
             for (j = 0; b; j++, b >>= 1)
-                if ((b & 1) && ul_by_id[i * 8 + (int)j] >= 0) c++;
+                if ((b & 1) && UL_BY_ID(i * 8 + (int)j) >= 0) c++;
         }
