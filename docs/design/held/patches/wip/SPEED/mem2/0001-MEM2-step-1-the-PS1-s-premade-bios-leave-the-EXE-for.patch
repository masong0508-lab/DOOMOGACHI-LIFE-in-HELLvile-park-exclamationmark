diff --git a/core/include/doomo/roster.h b/core/include/doomo/roster.h
index 6bedb742..a4e8730d 100644
--- a/core/include/doomo/roster.h
+++ b/core/include/doomo/roster.h
@@ -36,6 +36,20 @@ int roster_premade_record(int id, DoomoResident *out);
  * stays valid for the next 7 calls only: use it at once, or copy it (roster_premade_record). */
 const DoomoResident *roster_premade(int id);   /* 0..999 */
 const char *roster_bio(int id);                /* <= 60 chars */
+/* (MEM2) DOOMO_ROSTER_BIO_EXT (the PS1): the bios are not linked. They sit in fixed records of
+ * ROSTER_BIO_REC bytes outside the EXE (ps1/tools/rosterbin.py -> ROSTER.BIN -> SPU RAM), and
+ * roster_bio() reads one through plat_roster_bio_read() into a ring of ROSTER_BIO_RING buffers:
+ * its pointer stays valid until ROSTER_BIO_RING other bios have been read (use it at once, as
+ * every caller does). plat_roster_bio_read(id, dst) fills ROSTER_BIO_REC bytes (4-byte aligned
+ * dst; the record is the bio, NUL padded) and returns 1, or 0 when the store is missing (the bio
+ * then reads as ""). roster_bio_ext() is that path with the reader as an argument, so the
+ * native tests run it (DOOMO_ROSTER_BIO_EXT_TEST). */
+#define ROSTER_BIO_REC  64
+#define ROSTER_BIO_RING 4
+#if defined(DOOMO_ROSTER_BIO_EXT) || defined(DOOMO_ROSTER_BIO_EXT_TEST)
+int plat_roster_bio_read(int id, void *dst);
+const char *roster_bio_ext(int id, int (*read)(int id, void *dst));
+#endif
 const char *roster_job(int id);                /* "Baker", "Imp Accountant" */
 
 /* Pre-seeded relationships between premade citizens. */
@@ -60,6 +74,7 @@ extern const uint16_t doomo_story_npc[NPC_COUNT];
 
 /* Text limits (characters, without the NUL). */
 #define ROSTER_BIO_MAX 60
+DOOMO_STATIC_ASSERT(ROSTER_BIO_MAX < ROSTER_BIO_REC, a_bio_and_its_nul_fit_a_record);
 #define ROSTER_JOB_MAX 20
 
 /* Story NPC resident ids (the values of doomo_story_npc[], fixed so other
diff --git a/core/src/roster.c b/core/src/roster.c
index e0c12675..f9512a72 100644
--- a/core/src/roster.c
+++ b/core/src/roster.c
@@ -43,9 +43,41 @@ const DoomoResident *roster_premade(int id)
     return r;
 }
 
+#if defined(DOOMO_ROSTER_BIO_EXT) || defined(DOOMO_ROSTER_BIO_EXT_TEST)
+/* (MEM2) the bios live outside the EXE (roster.h): the ROSTER_BIO_RING newest reads are kept
+ * (oldest replaced first); a hit costs no read. The union keeps every record 4-byte aligned for
+ * the DMA. */
+static union { uint32_t w[ROSTER_BIO_REC / 4]; char s[ROSTER_BIO_REC]; } bio_buf[ROSTER_BIO_RING];
+static int16_t bio_id[ROSTER_BIO_RING] = { -1, -1, -1, -1 };
+static uint8_t bio_next;
+DOOMO_STATIC_ASSERT(ROSTER_BIO_RING == 4, bio_ring_init_lists_four);
+
+const char *roster_bio_ext(int id, int (*read)(int id, void *dst))
+{
+    int i, k;
+    if (!valid(id)) return "";
+    for (i = 0; i < ROSTER_BIO_RING; i++)
+        if (bio_id[i] == id) return bio_buf[i].s;
+    k = bio_next;
+    bio_next = (uint8_t)((k + 1) % ROSTER_BIO_RING);
+    if (!read(id, bio_buf[k].w)) {
+        bio_id[k] = -1;
+        bio_buf[k].s[0] = 0;
+        return bio_buf[k].s;
+    }
+    bio_buf[k].s[ROSTER_BIO_REC - 1] = 0;
+    bio_id[k] = (int16_t)id;
+    return bio_buf[k].s;
+}
+#endif
+
 const char *roster_bio(int id)
 {
+#ifdef DOOMO_ROSTER_BIO_EXT
+    return roster_bio_ext(id, plat_roster_bio_read);
+#else
     return valid(id) ? doomo_roster_bio_text + doomo_roster_bio_ofs[id] : "";
+#endif
 }
 
 const char *roster_job(int id)
diff --git a/core/tests/test_roster.c b/core/tests/test_roster.c
index 1dec52f3..9665bb21 100644
--- a/core/tests/test_roster.c
+++ b/core/tests/test_roster.c
@@ -425,3 +425,62 @@ TEST(roster_v2_record_edges)
     CHECK(roster_premade(ROSTER_COUNT) == NULL);
     CHECK(roster_premade(999) != NULL);
 }
+
+/* (MEM2) the PS1's bios outside the EXE (roster.h DOOMO_ROSTER_BIO_EXT): roster_bio_ext() through a
+ * fake store that serves the linked text as records, counting its reads */
+static int bio_reads, bio_fail;
+static int fake_bio_read(int id, void *dst)
+{
+    const char *b = doomo_roster_bio_text + doomo_roster_bio_ofs[id];
+    bio_reads++;
+    if (bio_fail) return 0;
+    memset(dst, 0, ROSTER_BIO_REC);
+    memcpy(dst, b, strlen(b));
+    return 1;
+}
+
+TEST(mem2_roster_bio_ext_reads_each_bio_like_the_linked_text)
+{
+    int i;
+    bio_fail = 0;
+    for (i = 0; i < ROSTER_COUNT; i++) {
+        const char *b = roster_bio_ext(i, fake_bio_read);
+        CHECK_MSG(((uintptr_t)b & 3u) == 0, "[%d] record not 4-byte aligned", i);
+        CHECK_MSG(strcmp(b, doomo_roster_bio_text + doomo_roster_bio_ofs[i]) == 0, "[%d] bio %s", i, b);
+        CHECK_MSG(strlen(doomo_roster_bio_text + doomo_roster_bio_ofs[i]) < ROSTER_BIO_REC, "[%d] too long", i);
+    }
+    CHECK_STR(roster_bio_ext(-1, fake_bio_read), "");
+    CHECK_STR(roster_bio_ext(ROSTER_COUNT, fake_bio_read), "");
+}
+
+TEST(mem2_roster_bio_ext_keeps_the_newest_reads)
+{
+    const char *p[ROSTER_BIO_RING];
+    int i, before;
+    bio_fail = 0;
+    for (i = 0; i < ROSTER_BIO_RING; i++) p[i] = roster_bio_ext(100 + i, fake_bio_read);
+    before = bio_reads;
+    /* the ROSTER_BIO_RING newest bios are hits: no read, the same pointer, the text intact */
+    for (i = 0; i < ROSTER_BIO_RING; i++) {
+        CHECK(roster_bio_ext(100 + i, fake_bio_read) == p[i]);
+        CHECK_STR(p[i], doomo_roster_bio_text + doomo_roster_bio_ofs[100 + i]);
+    }
+    CHECK_EQ(bio_reads, before);
+    /* one more bio replaces the oldest only */
+    roster_bio_ext(200, fake_bio_read);
+    CHECK_EQ(bio_reads, before + 1);
+    for (i = 1; i < ROSTER_BIO_RING; i++)
+        CHECK_STR(p[i], doomo_roster_bio_text + doomo_roster_bio_ofs[100 + i]);
+    roster_bio_ext(100, fake_bio_read);
+    CHECK_EQ(bio_reads, before + 2);
+}
+
+TEST(mem2_roster_bio_ext_missing_store_reads_empty)
+{
+    bio_fail = 1;
+    CHECK_STR(roster_bio_ext(321, fake_bio_read), "");
+    /* a failed read is not kept: the next call asks the store again */
+    roster_bio_ext(321, fake_bio_read);
+    bio_fail = 0;
+    CHECK_STR(roster_bio_ext(321, fake_bio_read), doomo_roster_bio_text + doomo_roster_bio_ofs[321]);
+}
