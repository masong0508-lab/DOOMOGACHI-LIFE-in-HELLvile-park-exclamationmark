diff --git a/ps1/tools/rosterbin.py b/ps1/tools/rosterbin.py
new file mode 100644
index 00000000..a987ba94
--- /dev/null
+++ b/ps1/tools/rosterbin.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""rosterbin.py - write ROSTER.BIN, the premade citizens' bios for the PS1 disc (owner: ps1, MEM2).
+
+    rosterbin.py core/gen/roster_data.c ROSTER.BIN
+
+The PS1 EXE does not link the bios (core/gen/roster_data.c `doomo_roster_bio_text`, 45 KB; roster.h
+DOOMO_ROSTER_BIO_EXT): src/rosterbio.c reads this file at boot into SPU RAM, and roster_bio() reads one
+record back with an SPU DMA read when a page shows a bio.
+
+Layout: records of 64 bytes (ROSTER_BIO_REC). Record 0 is the header: "RBIO", u16 count, u16 record
+size, u32 FNV-1a of every bio record, the rest zero. Record 1 + id is the bio of premade `id`, NUL
+padded. The file is padded to whole 2,048-byte sectors.
+
+The bios are read back from the generated C (tools/roster_build.py writes each as one string literal
+with "\\0" and an id comment per line, escaping only \\\\, \\" and \\?) and checked against
+`doomo_roster_bio_ofs[]`, so a change of that format fails here instead of writing wrong text.
+Stdlib only, deterministic.
+"""
+import re
+import struct
+import sys
+
+SECTOR = 2048
+REC = 64
+MAGIC = b"RBIO"
+
+
+def unescape(lit):
+    out = bytearray()
+    i = 0
+    while i < len(lit):
+        c = lit[i]
+        if c != "\\":
+            out += c.encode("utf-8")
+            i += 1
+            continue
+        n = lit[i + 1]
+        if n in "\\\"?'":
+            out += n.encode()
+            i += 2
+        elif n == "0" and (i + 2 >= len(lit) or lit[i + 2] not in "01234567"):
+            out += b"\0"
+            i += 2
+        elif n == "n":
+            out += b"\n"
+            i += 2
+        else:
+            raise ValueError("unexpected escape \\%s" % n)
+    return bytes(out)
+
+
+def bios_from(src):
+    m = re.search(r"const char doomo_roster_bio_text\[\] =\n(.*?)\n\s*;\n", src, re.S)
+    if not m:
+        raise ValueError("no doomo_roster_bio_text[]")
+    blob = b"".join(unescape(s) for s in re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1)))
+    o = re.search(r"const uint16_t doomo_roster_bio_ofs\[ROSTER_COUNT\] = \{(.*?)\};", src, re.S)
+    if not o:
+        raise ValueError("no doomo_roster_bio_ofs[]")
+    ofs = [int(v) for v in re.findall(r"\d+", o.group(1))]
+    bios = []
+    for k, a in enumerate(ofs):
+        end = blob.index(b"\0", a)
+        if k + 1 < len(ofs) and ofs[k + 1] != end + 1:
+            raise ValueError("bio %d: the offsets do not follow the text" % k)
+        bios.append(blob[a:end])
+    if ofs and len(blob) != ofs[-1] + len(bios[-1]) + 1:
+        raise ValueError("bio text has %d bytes, the offsets end at %d" % (len(blob), ofs[-1] + len(bios[-1]) + 1))
+    return bios
+
+
+def pack(bios):
+    body = bytearray()
+    for k, b in enumerate(bios):
+        if len(b) >= REC:
+            raise ValueError("bio %d is %d bytes: a record holds %d with its NUL" % (k, len(b), REC - 1))
+        body += b + bytes(REC - len(b))
+    h = 0x811C9DC5
+    for x in body:
+        h = ((h ^ x) * 16777619) & 0xFFFFFFFF
+    head = MAGIC + struct.pack("<HHI", len(bios), REC, h)
+    data = head + bytes(REC - len(head)) + body
+    return data + bytes(-len(data) % SECTOR)
+
+
+def main(argv):
+    if len(argv) != 3:
+        sys.stderr.write(__doc__)
+        return 2
+    try:
+        bios = bios_from(open(argv[1], encoding="utf-8").read())
+        data = pack(bios)
+    except ValueError as e:
+        sys.stderr.write("rosterbin: %s\n" % e)
+        return 1
+    with open(argv[2], "wb") as f:
+        f.write(data)
+    print("rosterbin: %d bios, %d bytes (%d sectors)" % (len(bios), len(data), len(data) // SECTOR))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
