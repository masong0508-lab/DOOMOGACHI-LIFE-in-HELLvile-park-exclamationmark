diff --git a/ps1/src/rosterbio.c b/ps1/src/rosterbio.c
new file mode 100644
index 00000000..a63a07a4
--- /dev/null
+++ b/ps1/src/rosterbio.c
@@ -0,0 +1,80 @@
+/* rosterbio.c - the premade citizens' bios in SPU RAM (owner: ps1; MEM2, docs/PS1.md "Memory wave 2").
+ *
+ * The bios are 45 KB of text that a page shows one at a time (the citizen page, the roster's
+ * card, the Almanac, the exorcism's file, a story line's {B}). The EXE does not link them
+ * (DOOMO_ROSTER_BIO_EXT, core/include/doomo/roster.h): ps1/tools/rosterbin.py writes ROSTER.BIN
+ * (a 64-byte header record, then one 64-byte record per premade id), this file reads it at boot
+ * into the display lists' scratch (idle until the game loop starts, like PARTS.BIN) and uploads
+ * it to SPU RAM at SPU_ROSTER_BASE, between the sound effects and the part store.
+ * plat_roster_bio_read() copies one record back with one 64-byte SPU DMA read; roster.c keeps the
+ * last four in a ring, so a page that shows a bio reads it once.
+ *
+ * Nothing writes SPU RAM after boot (spu.c "staging", partstore.c "audio driver lock"), so a read
+ * never races an upload. The engine-test build does not load the store (its bios read as "").
+ */
+#include <string.h>
+#include <psxapi.h>
+#include <psxcd.h>
+#include <psxspu.h>
+#include "ps1.h"
+
+#if defined(DOOMO_HAVE_CORE) && defined(DOOMO_ROSTER_BIO_EXT)
+#include "doomo/roster.h"
+
+#define SECTOR 2048
+#define RB_RECS (ROSTER_COUNT + 1)
+#define RB_BYTES ((RB_RECS * ROSTER_BIO_REC + SECTOR - 1) / SECTOR * SECTOR)
+typedef char rb_fits[SPU_ROSTER_BASE + RB_BYTES <= SPU_PARTS_BASE ? 1 : -1];
+
+static int      s_ok;
+static uint32_t s_reads;
+
+int plat_roster_bio_read(int id, void *dst)
+{
+    if (!s_ok || id < 0 || id >= ROSTER_COUNT)
+        return 0;
+    SpuSetTransferStartAddr(SPU_ROSTER_BASE + (uint32_t)(id + 1) * ROSTER_BIO_REC);
+    SpuRead((uint32_t *)dst, ROSTER_BIO_REC);
+    SpuIsTransferCompleted(SPU_TRANSFER_WAIT);
+    s_reads++;
+    return 1;
+}
+
+/* After partstore_boot(): ROSTER.BIN -> SPU RAM in one read and one upload, through the display
+ * lists' scratch. The header is read back from SPU RAM: the log says whether the store works. */
+void rosterbio_boot(void)
+{
+    uint32_t cap = 0, sum = 0;
+    uint8_t *buf = (uint8_t *)plat_save_scratch(&cap);
+    CdlFILE f;
+    int tries, ok = 0;
+    s_ok = 0;
+    if (!buf || cap < RB_BYTES + ROSTER_BIO_REC || !CdSearchFile(&f, "\\ROSTER.BIN;1") || f.size < RB_RECS * ROSTER_BIO_REC)
+        goto done;
+    for (tries = 0; tries < 4 && !ok; tries++) {
+        CdlLOC loc;
+        CdIntToPos(CdPosToInt(&f.pos), &loc);
+        ok = CdControl(CdlSetloc, &loc, 0) && CdRead(RB_BYTES / SECTOR, (uint32_t *)buf, CdlModeSpeed) &&
+             CdReadSync(0, 0) >= 0;
+    }
+    if (!ok || memcmp(buf, "RBIO", 4) != 0 || (buf[4] | (buf[5] << 8)) != ROSTER_COUNT ||
+        (buf[6] | (buf[7] << 8)) != ROSTER_BIO_REC)
+        goto done;
+    SpuSetTransferStartAddr(SPU_ROSTER_BASE);
+    SpuWrite((const uint32_t *)buf, RB_BYTES);
+    SpuIsTransferCompleted(SPU_TRANSFER_WAIT);
+    sum = (uint32_t)buf[8] | ((uint32_t)buf[9] << 8) | ((uint32_t)buf[10] << 16) | ((uint32_t)buf[11] << 24);
+    {
+        uint8_t *chk = buf + RB_BYTES;      /* past the file in the scratch: the header back from SPU RAM */
+        SpuSetTransferStartAddr(SPU_ROSTER_BASE);
+        SpuRead((uint32_t *)chk, ROSTER_BIO_REC);
+        SpuIsTransferCompleted(SPU_TRANSFER_WAIT);
+        s_ok = memcmp(chk, buf, ROSTER_BIO_REC) == 0;
+    }
+done:
+    dbg("roster: bios %s, %d at spu %05x, sum %08x\n", s_ok ? "loaded" : "MISSING", s_ok ? ROSTER_COUNT : 0,
+        (unsigned)SPU_ROSTER_BASE, (unsigned)sum);
+}
+
+uint32_t rosterbio_reads(void) { return s_reads; }
+#endif
