 core/src/studio_edit.c                     |  2 ++
 core/src/studio_stage.c                    | 10 ++++++++
 gba/harness/scripts/speed2_studio.txt      |  2 +-
 gba/harness/scripts/speed2_studio_tabs.txt | 28 +++++++++++-----------
 5 files changed, 33 insertions(+), 24 deletions(-)

diff --git a/core/src/studio.c b/core/src/studio.c
index 03c1de45..1fe5310e 100644
--- a/core/src/studio.c
+++ b/core/src/studio.c
@@ -343,20 +343,17 @@ int ed_undo(void)
         uint32_t off = rd16(tr), ln = rd16(tr + 2), enc = rd16(tr + 4);
         int join = (ln & JOIN) != 0;
         ln &= ~JOIN;
+        int big = 0;
         if (off == BIG_OFF && enc == 0) {
             /* the whole-song before-image in the scene scratch (gone if another scene took the scratch: the step stays) */
-            if (ez && ez->before_ok) {
-                if (keep && !redo_push(ez, 0, (int)sizeof(DoomoSong), !first)) keep = 0;
-                first = 0;
-                memcpy(&studio.song, ez->before, sizeof(DoomoSong));
-            } else {
-                keep = 0;
-            }
-        } else if (off + ln <= sizeof(DoomoSong) && enc + 6 <= studio.undo_used) {
+            if (ez && ez->before_ok) { off = 0; big = 1; } else { off = 0xFFFFu; keep = 0; }
+        }
+        if (off + ln <= sizeof(DoomoSong) && enc + 6 <= studio.undo_used) {
             /* the first record pushed is the last one a redo pops: it carries no JOIN, the rest do */
             if (keep && !redo_push(ez, (int)off, (int)ln, !first)) keep = 0;
             first = 0;
-            rle_decode(tr - enc, (int)enc, (uint8_t *)&studio.song + off, (int)ln);
+            if (big) memcpy(&studio.song, ez->before, sizeof(DoomoSong));
+            else rle_decode(tr - enc, (int)enc, (uint8_t *)&studio.song + off, (int)ln);
         }
         studio.undo_used = (uint16_t)(studio.undo_used - 6 - enc);
         if (!join || studio.undo_used < 6) break;
diff --git a/core/src/studio_edit.c b/core/src/studio_edit.c
index f60b487f..86bd6aaf 100644
--- a/core/src/studio_edit.c
+++ b/core/src/studio_edit.c
@@ -289,7 +289,9 @@ static void draw_record(int cx, int cy, int r, int t, int playing)
 {
     int a = playing ? t * 3 : t / 2, g[2];
     g[0] = r; g[1] = SS->genre & 3;
+#if ST_BAKE
     if (!st_bake(0x40u | (uint32_t)r << 8, (uint32_t)g[1], cx - r - 3, cy - r - 3, record_rects, g, 4200))
+#endif
         record_rects(cx - r - 3, cy - r - 3, g);
     /* the shine sweeps around */
     {
diff --git a/core/src/studio_stage.c b/core/src/studio_stage.c
index 74777136..692a489e 100644
--- a/core/src/studio_stage.c
+++ b/core/src/studio_stage.c
@@ -832,6 +832,7 @@ void stage_draw_full(void)
  * Four bulbs are one 32x5 picture (two phases, the bulbs alternate), so a row is 7 plat_image calls. The pictures are
  * what ui_fill_circle(.., 2, ..) paints (test_studio.c studio_bulbs_equal_the_circles). Returns how many bulbs it drew
  * (a multiple of 4; the rest are drawn as circles). */
+#if !defined(DOOMO_PLATFORM_PS1)           /* the PS1 keeps the circles (no resident bytes for it: PS1.md) */
 #define BL_ON PAL_PAINT(PAINT_LEMON, 2)
 #define BL_OFF PAL_PAINT(PAINT_HONEY, 0)
 #define BL_E(c) 0, c, c, c, 0, 0, 0, 0
@@ -850,6 +851,9 @@ int st_bulbs(int rx, int ry, int rw, int rh, int phase)
     }
     return n;
 }
+#else
+int st_bulbs(int rx, int ry, int rw, int rh, int phase) { (void)rx; (void)ry; (void)rw; (void)rh; (void)phase; return 0; }
+#endif
 
 /* ---- the poster ----------------------------------------------------------- */
 void tab_stage_draw(StRect r)
@@ -902,6 +906,7 @@ void tab_stage_draw(StRect r)
             bx[k] = x - BODYSPR_W / 2;
             by[k] = y - BODYSPR_H - (((t / 10) + k) % 8 == 0);
         }
+#if !defined(DOOMO_PLATFORM_PS1)                          /* the PS1 has no sprites: no code there */
         if (n > 0 && !studio.pop_n && !studio.msg_t && !studio.picking && !studio.help && !ui_toast_pending() &&
             !tip_active() && plat_stage_obj_begin()) {
             for (k = n - 1; k >= 0; k--) {
@@ -913,12 +918,17 @@ void tab_stage_draw(StRect r)
                 spr[k] = (uint8_t)!hit;
             }
         }
+#else
+        (void)bt; (void)sx1; (void)spr;
+#endif
         for (k = 0; k < n; k++) {
             int id = song_singer_id(SS, slots[k]);
+#if !defined(DOOMO_PLATFORM_PS1)
             if (spr[k]) {
                 const DoomoImage *img = bodyspr_image(id, 0, 0);
                 if (img && plat_stage_obj(slots[k], bx[k], by[k], img, 0, NULL, 0)) continue;
             }
+#endif
             st_chibi(id, bx[k], by[k], 0, 0, 0, 0);
         }
     }
