diff --git a/core/src/studio.c b/core/src/studio.c
index 67b0adf4..03c1de45 100644
--- a/core/src/studio.c
+++ b/core/src/studio.c
@@ -104,6 +104,7 @@ void st_set_tab(int tab)
 /* ====================================================================== */
 /* undo journal                                                             */
 #define JOIN 0x8000u
+#define BIG_OFF 0xFFFEu              /* a journal record with no bytes: the before-image is StEasy.before (STUDIO-30) */
 
 static int rle_encode(const uint8_t *src, int n, uint8_t *dst, int cap)
 {
@@ -202,7 +203,7 @@ static void redo_clear(void)
 void ed_reset(void)
 {
     StEasy *ez = st_easy();
-    if (ez) ez->mk_valid = 0;
+    if (ez) { ez->mk_valid = 0; ez->before_ok = 0; }
     studio.undo_used = 0;
     studio.undo_open = 0;
     studio.undo_steps = 0;
@@ -220,6 +221,25 @@ static void touch_rec(const void *field, int len, int keep_redo)
     off = (int)(p - base);
     enc = rle_encode(p, len, NULL, 0);
     if (enc + 6 > STUDIO_UNDO_BYTES) {
+        StEasy *ez = off == 0 && len == (int)sizeof(DoomoSong) && !studio.undo_open ? st_easy() : NULL;
+        if (ez) {
+            /* STUDIO-30: a whole song too big for the journal (a composed song a take is made over): the before-image
+             * is kept raw in the scene scratch and the journal holds one record that names it. The history before it
+             * is dropped as it always was (it could not be reached past this step), the redo journal stays when a
+             * redo is replaying. */
+            uint16_t ru = ez->redo_used;
+            uint8_t rs = ez->redo_steps;
+            memcpy(ez->before, base, sizeof(DoomoSong));
+            ed_reset();
+            if (keep_redo) { ez->redo_used = ru; ez->redo_steps = rs; }
+            ez->before_ok = 1;
+            wr16(studio.undo, BIG_OFF);
+            wr16(studio.undo + 2, (uint32_t)sizeof(DoomoSong));
+            wr16(studio.undo + 4, 0);
+            studio.undo_used = 6;
+            studio.undo_open = 1;
+            return;
+        }
         /* too big to remember: the history before it is useless now */
         ed_reset();
         studio.undo_open = 2;              /* this step cannot be undone */
@@ -323,7 +343,16 @@ int ed_undo(void)
         uint32_t off = rd16(tr), ln = rd16(tr + 2), enc = rd16(tr + 4);
         int join = (ln & JOIN) != 0;
         ln &= ~JOIN;
-        if (off + ln <= sizeof(DoomoSong) && enc + 6 <= studio.undo_used) {
+        if (off == BIG_OFF && enc == 0) {
+            /* the whole-song before-image in the scene scratch (gone if another scene took the scratch: the step stays) */
+            if (ez && ez->before_ok) {
+                if (keep && !redo_push(ez, 0, (int)sizeof(DoomoSong), !first)) keep = 0;
+                first = 0;
+                memcpy(&studio.song, ez->before, sizeof(DoomoSong));
+            } else {
+                keep = 0;
+            }
+        } else if (off + ln <= sizeof(DoomoSong) && enc + 6 <= studio.undo_used) {
             /* the first record pushed is the last one a redo pops: it carries no JOIN, the rest do */
             if (keep && !redo_push(ez, (int)off, (int)ln, !first)) keep = 0;
             first = 0;
@@ -744,7 +773,7 @@ static void ez_init(StEasy *e)
     e->level = (studio_stats.lines & STUDIO_LINES_LEVEL) ? 1 : 0;
 }
 #define BAKE_ENTS  40
-#define BAKE_POOL  (10752 - STUDIO_TABSTATE)  /* BakeSt is the whole 12 KB scene scratch (CHOIR's tiles are ~750 B each) */
+#define BAKE_POOL  (10752 - STUDIO_TABSTATE - (int)sizeof(DoomoSong))  /* BakeSt is the whole 12 KB scene scratch (CHOIR's tiles are ~750 B each) */
 typedef struct { uint32_t k0, k1; DoomoImage img; int16_t bx, by; } BakeEnt;
 /* xs: the open tab's own small state (st_tab_state, the PLAY tab's pads); xs[0] is 0 on a fresh claim */
 typedef struct { uint16_t top, n; BakeEnt e[BAKE_ENTS]; uint8_t xs[STUDIO_TABSTATE]; uint8_t pix[BAKE_POOL]; StEasy ez; } BakeSt;   /* ez: ST-EASY (+448 B) */
diff --git a/core/src/studio_int.h b/core/src/studio_int.h
index 12d4e52e..bc7937f6 100644
--- a/core/src/studio_int.h
+++ b/core/src/studio_int.h
@@ -159,6 +159,8 @@ typedef struct StEasy {
     uint8_t  mk_style, mk_mood, mk_tempo, mk_length;
     uint16_t mk_mark;           /* studio.undo_used right after that step */
     uint32_t mk_seed;
+    uint8_t  before_ok;         /* STUDIO-30: `before` holds the song a take (Make it! / Shuffle / a template) was made over */
+    uint8_t  before[sizeof(DoomoSong)];   /* its raw image, for a step whose RLE image is over the journal's size */
     uint8_t  csel, style, mood, tempo, length;   /* the Start card */
     uint16_t help_t;            /* ticks of the one-line help left on the bar */
     uint32_t seed;              /* the Start card's seed */
diff --git a/core/tests/test_studio.c b/core/tests/test_studio.c
index 3946f722..67652b01 100644
--- a/core/tests/test_studio.c
+++ b/core/tests/test_studio.c
@@ -1229,6 +1229,48 @@ TEST(studio_make_it_undoes_and_redoes_whole)
     test_reset();
 }
 
+/* STUDIO-30: a take over an already composed song (the before-image is over the journal's 768 bytes) is undoable and
+ * redoable too; the before-image lives in the scene scratch */
+TEST(studio_take_over_a_composed_song_undoes_and_redoes)
+{
+    DoomoSong composed, take1, take2;
+    open_blank_studio();
+    ed_reset();
+    press(BTN_A);                                           /* Make it! on the blank song: a composed song */
+    {   /* hand edits make it dense: every note and lyric byte differs, so the RLE image is over the journal */
+        int i;
+        uint8_t *n = &studio.song.notes[0][0][0];
+        for (i = 0; i < (int)sizeof(studio.song.notes); i++) n[i] = (uint8_t)(2 + (i * 7 + i / 5) % 29);
+        for (i = 0; i < SONG_LYRIC_LINES; i++) {
+            int j;
+            for (j = 0; j < SONG_LYRIC_LEN - 1; j++) studio.song.lyrics[i][j] = (char)('a' + (i * 13 + j * 7 + j / 3) % 26);
+            studio.song.lyrics[i][SONG_LYRIC_LEN - 1] = 0;
+        }
+        for (i = 0; i < SONG_SINGERS; i++) studio.song.singer[i] = (uint16_t)(i * 37 + 5);
+    }
+    composed = studio.song;
+    CHECK(!studio.card);
+    ed_reset();
+    st_card_open();                                         /* the card over the composed song */
+    CHECK(studio.card);
+    press(BTN_UP);                                          /* Shuffle */
+    press(BTN_A);
+    take1 = studio.song;
+    CHECK(memcmp(&take1, &composed, sizeof composed) != 0);
+    CHECK_EQ(ed_undo_steps(), 1);
+    press(BTN_A);                                           /* a second take replaces the first */
+    take2 = studio.song;
+    CHECK(memcmp(&take2, &take1, sizeof take1) != 0);
+    CHECK_EQ(ed_undo_steps(), 1);
+    CHECK(ed_undo());                                       /* one undo: the composed song, not a half song */
+    CHECK(memcmp(&studio.song, &composed, sizeof composed) == 0);
+    CHECK(ed_redo());                                       /* and the last take comes back whole */
+    CHECK(memcmp(&studio.song, &take2, sizeof take2) == 0);
+    CHECK(ed_undo());
+    CHECK(memcmp(&studio.song, &composed, sizeof composed) == 0);
+    test_reset();
+}
+
 TEST(studio_redo_clears_when_the_scratch_is_taken)
 {
     open_blank_studio();
