From 788f7cb3b7361bc4e1cf06b311b5cc47d8b89f76 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 15:26:03 +0000
Subject: [PATCH 2/5] DC6B: the solid block past the map's edge is drawn
 (border-cell picture gap, sky colour looking up)

The reference's map_cell_safe is a solid block of texture 1 past the edge; a ray that
went over a low border block under the open sky hits it and sees a wall 256 units above
the block. view3d.c emitted nothing there, so such views (eye by the edge, maps with a
low border) were the sky colour. emit_cell now draws that wall. Host parity
(dcv3d_test): level views 79.2 -> 85.6 %, looking up 80.2 -> 90.1 %, level frames
under 45 %: 16 -> 1 of 788. test_edge_wall fails without it (19 %); gates raised
(level 80 %, pitched 85 %, at most 1 % of frames under 45 %).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cx9wuhKv8Rqec7pX14
---
 dc/src/view3d.c              | 12 +++++++++---
 dc/tests/gfx2d/test_dc_v3d.c | 33 +++++++++++++++++++++++++++++----
 2 files changed, 38 insertions(+), 7 deletions(-)

diff --git a/dc/src/view3d.c b/dc/src/view3d.c
index 96ae2ba4..34b41cf8 100644
--- a/dc/src/view3d.c
+++ b/dc/src/view3d.c
@@ -388,13 +388,19 @@ static void emit_cell(int cx, int cy)
         for (k = 0; k < 4; k++) {
             int nx = cx + nb[k][0], ny = cy + nb[k][1], ntop;
             const DoomoCell *n;
-            if (!in_map(nx, ny)) continue;
+            if ((k == 0 && s_ey <= Y0) || (k == 1 && s_ex >= X1) || (k == 2 && s_ey >= Y1) || (k == 3 && s_ex <= X0))
+                continue;
+            if (!in_map(nx, ny)) {
+                /* past the map's edge the reference has a solid block of texture 1 (map_cell_safe) that
+                 * rises 256 units above the roof the ray went over: a wall at the edge, picture and all */
+                vface(cx + nb[k][2], cy + nb[k][3], cx + nb[k][4], cy + nb[k][5], top, top + 256, 1,
+                      light - (k == 0 || k == 2), 0);
+                continue;
+            }
             n = &M->cells[ny * M->w + nx];
             if (!n->wall) continue;
             ntop = roof_top(n, nx, ny);
             if (ntop <= top) continue;
-            if ((k == 0 && s_ey <= Y0) || (k == 1 && s_ex >= X1) || (k == 2 && s_ey >= Y1) || (k == 3 && s_ex <= X0))
-                continue;
             vface(cx + nb[k][2], cy + nb[k][3], cx + nb[k][4], cy + nb[k][5], top, ntop, n->wall,
                   light - (k == 0 || k == 2), 0);
         }
diff --git a/dc/tests/gfx2d/test_dc_v3d.c b/dc/tests/gfx2d/test_dc_v3d.c
index 80da0423..7964e1c1 100644
--- a/dc/tests/gfx2d/test_dc_v3d.c
+++ b/dc/tests/gfx2d/test_dc_v3d.c
@@ -40,9 +40,9 @@
 void ref_view3d(const DoomoView3D *v);
 
 #define TOL         40
-#define PARITY_MIN  0.75   /* measured 79.2% on 2026-11-13; the gap is listed in docs/DREAMCAST.md section 9 */
+#define PARITY_MIN  0.80   /* measured 85.6% (79.2% before the map-edge wall); see docs/DREAMCAST.md section 9 */
 #define FRAME_MIN   0.45   /* at most 3% of the level frames may be below it */
-#define PITCH_MIN   0.60
+#define PITCH_MIN   0.85   /* measured 90.1% (80.2% before the map-edge wall) */
 #define SPR_MIN     0.72   /* sprite rectangles (measured 79.1%), see test_sprites */
 #define SPR_FRAME_MIN 0.25
 #define SPR_PX_MIN  0.85   /* the sprites' own pixels (measured 90.5%; 77.9% with the exact rectangle off) */
@@ -165,7 +165,7 @@ static void test_parity(void)
                             png_write_rgb(nm, rgb, DC2D_W, DC2D_H);
                         }
                     }
-                    if (png && p < FRAME_MIN && !pitch && nbad < 40) {
+                    if (png && p < FRAME_MIN + (pitch ? 0.15 : 0.0) && nbad < 60) {
                         char nm[512];
                         snprintf(nm, sizeof(nm), "%s/v3d_bad%02d_m%d_%d_%d_h%dp%d_nat.png", png, nbad, maps[mi], cells[k][0], cells[k][1], hd, pitch);
                         nat_png_write(nm, nat_fb, nat_w, nat_h, 1);
