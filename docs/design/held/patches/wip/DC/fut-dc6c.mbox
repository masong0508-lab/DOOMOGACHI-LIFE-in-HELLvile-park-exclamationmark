diff --git a/dc/src/view3d.c b/dc/src/view3d.c
index 36cc16a6..a48f6643 100644
--- a/dc/src/view3d.c
+++ b/dc/src/view3d.c
@@ -89,14 +89,84 @@
 
 typedef struct Col { float r, g, b; } Col;
 
-static int s_view_dist = DC_V3D_DIST_MAX;
+static int s_view_dist = DC_V3D_DIST_MAX;   /* the distance of the view being built */
