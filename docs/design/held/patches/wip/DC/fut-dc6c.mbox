@@ -495,7 +564,7 @@ static void cast(float rdx, float rdy, float sb, float st, float eps)
 
 static void visibility(float plane, int vw)
 {
-    int n = vw / 2 + 5, i, cx = (int)floorf(s_ex / CELL), cy = (int)floorf(s_ey / CELL), dx, dy;
+    int n = vw / dc_gov_rays(opt_get(OPT_3D_FAST)) + 5, i, cx = (int)floorf(s_ex / CELL), cy = (int)floorf(s_ey / CELL), dx, dy;
     float span = 1.0f + 4.0f / (float)(n - 1);          /* two rays beyond each edge */
     float dc = 2.0f * span / (float)(n - 1);
     float st = (cam.cy - cam.vy0) / cam.focal, sb = (cam.cy - cam.vy1) / cam.focal;
@@ -709,6 +778,7 @@ void plat_view3d(const DoomoView3D *v)
     }
     t0 = dc3d_be_us();
     s_new_tex = 0;
+    gov_begin(dc3d_frame_no());
     M = v->map;
     s_time = v->time;
     if (++s_stamp == 0) {
diff --git a/dc/tests/gfx2d/test_dc_v3d.c b/dc/tests/gfx2d/test_dc_v3d.c
index 52a26c54..49607f2a 100644
