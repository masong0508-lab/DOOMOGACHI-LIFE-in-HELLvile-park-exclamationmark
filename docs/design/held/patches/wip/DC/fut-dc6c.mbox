diff --git a/dc/harness/scripts/gen_detail.sh b/dc/harness/scripts/gen_detail.sh
new file mode 100644
index 00000000..0c3fda98
--- /dev/null
+++ b/dc/harness/scripts/gen_detail.sh
@@ -0,0 +1,60 @@
+#!/bin/sh
+# gen_detail.sh MODE [DIST] [PLAY] - DC6C: the first-person view in Flycast at one Options "Combat detail" mode
+# (OPT_3D_FAST id 63: 0 Balanced, 1 Smooth, 2 Max detail) and one "Draw distance" (OPT_DRAW_DIST id 60:
+# 0 Near, 1 Normal). The seven Hell Breach levels (push BREACH N), each entered fresh (the entry tick is the
+# first tick after `push`) and played ~900 ticks, shots at 150, 450 and 850. PLAY = walk (default: a pad
+# walks, turns and fires, no bot) or demo (push BREACH 4096+N: the autopilot plays; its planning is core
+# work and spikes by itself) or combat (push COMBAT 0 1 2 4 6, 120 ticks walked each: five entries).
+# Prints a dcrun script; dcrun's summary gives the ticks over 33.3 ms.
+#   sh dc/harness/scripts/gen_detail.sh 2 1 > /tmp/max.txt
+mode=${1:-0}; dist=${2:-1}; play=${3:-walk}
+echo "# generated by gen_detail.sh $mode $dist $play: do not edit"
+echo "opt 63 $mode"
+echo "opt 60 $dist"
+echo "wait 40"
+if [ "$play" = combat ]; then
+  for l in 0 1 2 4 6; do
+    echo "seed 1"
+    echo "scene TITLE"
+    echo "wait 4"
+    echo "push COMBAT $l"
+    echo "log detail: begin combat $l mode $mode dist $dist"
+    echo "wait 30"
+    echo "stick 0 -127"
+    echo "wait 60"
+    echo "stick 90 -127"
+    echo "wait 20"
+    echo "stick 0 -127"
+    echo "wait 40"
+    echo "stick 0 0"
+    echo "shot detail_m${mode}_d${dist}_combat_l${l}"
+  done
+  exit 0
+fi
+for l in 0 1 2 3 4 5 6; do
+  echo "seed 1"
+  echo "scene TITLE"
+  echo "wait 4"
+  if [ "$play" = demo ]; then echo "push BREACH $((4096 + l))"; else echo "push BREACH $l"; fi
+  echo "log detail: begin level $l mode $mode dist $dist $play"
+  echo "wait 90"
+  for rep in 1 2 3 4 5 6 7 8; do
+    echo "down A"
+    echo "stick 0 -127"
+    echo "wait 50"
+    echo "stick 100 -90"
+    echo "wait 14"
+    echo "stick 0 -127"
+    echo "wait 24"
+    echo "stick -100 -90"
+    echo "wait 14"
+    echo "stick 0 -127"
+    echo "wait 10"
+    if [ $rep = 1 ]; then echo "shot detail_m${mode}_d${dist}_${play}_l${l}_a"; fi
+    if [ $rep = 4 ]; then echo "shot detail_m${mode}_d${dist}_${play}_l${l}_b"; fi
+    if [ $rep = 8 ]; then echo "shot detail_m${mode}_d${dist}_${play}_l${l}_c"; fi
+  done
+  echo "up A"
+  echo "stick 0 0"
+  echo "log detail: end level $l"
+done
