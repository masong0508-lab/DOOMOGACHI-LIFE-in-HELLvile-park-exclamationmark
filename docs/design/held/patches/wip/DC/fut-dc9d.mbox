From 42af76f8cb3465901c0c7bb9c5a6dfa31a6462eb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 18:29:44 +0000
Subject: [PATCH 1/2] DC9D: audio-test compares with a +-12 s lag search (the
 native seed reads Talk's bank inside a held command since TD1: music starts
 10.8 s after power on, was 3.4 s)

Found by the DC9D sweep: harness-test failed in audio-test on every script (title r 0.49, lag +4.8 s, which was the search edge).
Bisected to 2d9d6db3 (TD1 sector-per-tick read: hcmd's native seed pumps the whole bank, 7.4 s of silent stream). With the lag
search widened the music lines up again: title 0.992, invasion 0.983, combat 0.940 (bar 0.8), repeat identical. Test script only.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cx9wuhKv8Rqec7pX14
---
 dc/tests/audio/run_flycast.sh | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/dc/tests/audio/run_flycast.sh b/dc/tests/audio/run_flycast.sh
index 8ed5003d..6d827870 100644
--- a/dc/tests/audio/run_flycast.sh
+++ b/dc/tests/audio/run_flycast.sh
@@ -28,6 +28,9 @@
 #   repeat     title.txt a second time: the content hash after 600 tick
 #              slots (dc_mailbox.snd_hash600) must be the same (the sound
 #              is a function of the game's ticks)
+# DC9D: --max-lag is 12 s. Since TD1 the harness's --native-seed reads Talk's whole bank at once, inside the
+# held command: 7.4 s of Flycast time with the AICA stream silent, so the WAV's music starts about 10.8 s after
+# power on (3.4 s before) and a +-5 s search locked on a wrong lag (title r 0.49).
 # OUTDIR/<check>/ gets the logs, the WAVs and the envelope plots;
 # OUTDIR/summary.txt one line per check. Exit status 1 when one fails.
 set -u
@@ -62,7 +65,7 @@ for name in title invasion combat; do
         DCSND_WAV="$d/ref.wav" "$IRQR" --quiet --script "$d/ref_script.txt" --shots "$d/ref_shots" --saves "$d/ref_saves" \
             --w 320 --h 240 > "$d/runner_irq.log" 2>&1
         [ $? -eq 0 ] || nr=1
-        vsb=$(python3 -I "$here/compare.py" "$d/bridge.wav" "$d/dc.wav" --label "$name" --max-lag 5 \
+        vsb=$(python3 -I "$here/compare.py" "$d/bridge.wav" "$d/dc.wav" --label "$name" --max-lag 12 \
               --drop-gaps 256 2>&1 | sed 's/^[A-Za-z]* //')
         vsb="; vs bridge (not gated): $vsb"
     fi
@@ -72,7 +75,7 @@ for name in title invasion combat; do
     # (sync stops) are not the game's sound (compare.py, DC8)
     gaps="--drop-gaps 256"; bar=
     [ -n "$IRQR" ] && { gaps=; [ $name = combat ] && bar="--min-corr 0.8"; }
-    c=$(python3 -I "$here/compare.py" "$d/ref.wav" "$d/dc.wav" --label "$name" --max-lag 5 \
+    c=$(python3 -I "$here/compare.py" "$d/ref.wav" "$d/dc.wav" --label "$name" --max-lag 12 \
         $gaps $bar $clip --plot "$d/envelope.png" 2>&1)
     cr=$?
     stats=$(grep '^dcrun: sound' "$d/dcrun.log" | sed 's/^dcrun: //')
-- 
2.43.0


