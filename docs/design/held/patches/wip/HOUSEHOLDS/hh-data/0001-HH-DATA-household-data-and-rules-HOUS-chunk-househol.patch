+    CHECK_EQ(household_rel_count(h), 1);
+    CHECK_EQ(household_rel(h, a, b), HREL_SPOUSE);
+    CHECK_EQ(household_rel_set(h, b, a, HREL_CHILD), 0);                  /* "b is a's child": replaces the couple */
+    CHECK_EQ(household_rel_count(h), 1);
+    CHECK_EQ(household_rel(h, a, b), HREL_PARENT);               /* b is a's child */
+    CHECK_EQ(household_rel_set(h, a, b, HREL_NONE), 0);
+    CHECK_EQ(household_rel_count(h), 0);
+    CHECK_EQ(household_rel(h, a, b), HREL_NONE);
+    CHECK_EQ(household_rel(h, a, a), -1);
+    CHECK_EQ(household_rel(h, a, mk(LIFE_ADULT)), -1);           /* not in this household */
+}
