+TEST(hh_setting_a_relation_fills_the_other_side_for_every_relation)
+{
+    int rel, a, b, h;
+    fresh();
+    for (rel = HREL_SPOUSE; rel < HREL_COUNT; rel++) {
+        town_new(TOWN_FREEPLAY, 41, TOWN_POP_EMPTY);
+        sim_init();
+        h = pair_(&a, &b);
+        if (rel == HREL_CHILD || rel == HREL_STEPCHILD || rel == HREL_GRANDCHILD || rel == HREL_NIECE_NEPHEW) {
+            int t = a; a = b; b = t;                              /* the younger one says it */
+        }
+        CHECK_MSG(household_rel_set(h, a, b, rel) == 0, "set %d: %s", rel,
+                  household_reason_text(household_rel_check(h, a, b, rel)));
+        CHECK_EQ(household_rel(h, a, b), rel);
+        CHECK_EQ(household_rel(h, b, a), household_rel_reverse(rel));
+        CHECK_EQ(household_rel_count(h), 1);                     /* one row per pair */
+    }
+}
