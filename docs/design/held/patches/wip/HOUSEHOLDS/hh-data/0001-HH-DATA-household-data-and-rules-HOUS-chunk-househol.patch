+/* build a chunk by hand: records are (head, n, flags, members, nrel, rows) */
+static uint32_t put16(uint8_t *d, uint32_t o, int v) { d[o] = (uint8_t)v; d[o + 1] = (uint8_t)(v >> 8); return o + 2; }
+static uint32_t put_rec(uint8_t *d, uint32_t o, const int *mem, int n, const uint8_t *rows, int nr)
+{
+    int i;
+    o = put16(d, o, mem[0]);
+    d[o++] = (uint8_t)n; d[o++] = 0;
+    for (i = 0; i < n; i++) o = put16(d, o, mem[i]);
+    d[o++] = (uint8_t)nr;
+    for (i = 0; i < 3 * nr; i++) d[o++] = rows[i];
+    return o;
+}
