+TEST(hh_load_rejects_framing_errors_and_leaves_nothing_behind)
+{
+    static uint8_t buf[256];
+    int a, b, m[2];
+    uint32_t o = 1, good;
+    fresh();
+    a = mk(LIFE_ADULT); b = mk(LIFE_ADULT);
+    m[0] = a; m[1] = b;
+    buf[0] = 1;
+    good = put_rec(buf, o, m, 2, NULL, 0);
+    CHECK(household_load(buf, good));
+    CHECK(!household_load(buf, good - 1));                           /* cut short */
+    CHECK_EQ(household_count(), 1);
+    CHECK(!household_load(buf, good + 1));                           /* trailing byte */
+    CHECK(!household_load(buf, 0));
+    buf[0] = 0;
+    CHECK(!household_load(buf, good));                               /* a count of nothing */
+    buf[0] = 1 + HH_MAX_RECS + 1;
+    CHECK(!household_load(buf, good));                               /* too many records */
+    buf[0] = 1;
+    buf[3] = 21;                                                     /* a record of 21 */
+    CHECK(!household_load(buf, good));
+    CHECK_EQ(household_count(), 1);
+}
+
+/* ---- fuzz ------------------------------------------------------------------------------------------------ */
+static uint32_t fz_;
+static uint32_t rnd(void) { fz_ ^= fz_ << 13; fz_ ^= fz_ >> 17; fz_ ^= fz_ << 5; return fz_; }
+
+/* what must hold after any load: a household is 2..20 live residents, each in one place, rows sane */
+static int sane(void)
+{
+    int h, i, j, n = household_count();
+    if (n < 1 || n > 1 + HH_MAX_RECS) return 0;
+    for (h = 1; h < n; h++) {
+        int sz = household_size(h);
+        if (sz < 2 || sz > HH_MEMBERS_MAX) return 0;
+        for (i = 0; i < sz; i++) {
+            int id = household_member(h, i);
+            if (id < 0 || id >= DOOMO_MAX_RESIDENTS || town_res(id)->status != RES_ALIVE) return 0;
+            if (household_of(id) != h) return 0;
+            for (j = 0; j < i; j++) if (household_member(h, j) == id) return 0;
+        }
+        if (household_rel_count(h) > HH_RELS_MAX) return 0;
+    }
+    if (household_rel_count(0) > HH_RELS_MAX) return 0;
+    {   /* the chunk it would write is exactly as big as it says and loads back to the same size */
+        static uint8_t out[SAVE_EXT_MAX_HOUS + 8];
+        uint32_t s = household_save_size();
+        if (s > SAVE_EXT_MAX_HOUS) return 0;
+        if (household_save(out, sizeof(out)) != s) return 0;
+    }
+    return 1;
+}
+
+TEST(hh_fuzzed_chunk_bytes_never_crash_and_always_leave_a_sane_state)
+{
+    static uint8_t good[SAVE_EXT_MAX_HOUS + 8], buf[SAVE_EXT_MAX_HOUS + 8];
+    int ids[8], n, i, k, iter, ok = 0;
+    uint32_t len, cut;
+    fresh();
+    for (i = 0; i < 20; i++) mk(LIFE_ADULT);                          /* a pool of ids to hit */
+    build_world(ids, &n);
+    len = household_save(good, sizeof(good));
+    CHECK(len > 0);
+    fz_ = 0x2545F491u;
+    for (iter = 0; iter < 4000; iter++) {
+        if (iter % 3 == 0) {                                          /* pure noise */
+            cut = rnd() % 200 + 1;
+            for (i = 0; i < (int)cut; i++) buf[i] = (uint8_t)rnd();
+            if (rnd() & 1) buf[0] = (uint8_t)(rnd() % 4);
+        } else {                                                      /* a valid chunk, damaged */
+            memcpy(buf, good, len);
+            cut = len;
+            for (k = (int)(rnd() % 4) + 1; k > 0; k--) buf[rnd() % len] ^= (uint8_t)(1u << (rnd() % 8));
+            if (iter % 3 == 2) cut = rnd() % (len + 1);
+        }
+        if (household_load(buf, cut)) ok++;
+        CHECK_MSG(sane(), "iter %d", iter);
+    }
+    CHECK(ok > 100);                                                  /* the fuzz did reach the parser's insides */
+    CHECK(household_load(good, len));                                 /* and the good one still loads */
+    CHECK_EQ(household_save_size(), len);
+    for (cut = 0; cut < len; cut++) {                                 /* every truncation is refused, never trusted */
+        CHECK(!household_load(good, cut));
+        CHECK_EQ(household_count(), 1);
+    }
+}
