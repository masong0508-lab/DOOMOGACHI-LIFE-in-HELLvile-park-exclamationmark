+int family_slot_move(int from, int to)
+{
+    FamilyMember keep;
+    uint8_t bond;
+    if (from < 0 || to < 0 || from >= fam_n_ || to >= fam_n_) return 0;
+    if (from == to) return 1;
+    keep = fam_[from];
+    bond = bond_[from];
+    if (from < to) {
+        memmove(&fam_[from], &fam_[from + 1], (size_t)(to - from) * sizeof(fam_[0]));
+        memmove(&bond_[from], &bond_[from + 1], (size_t)(to - from));
+    } else {
+        memmove(&fam_[to + 1], &fam_[to], (size_t)(from - to) * sizeof(fam_[0]));
+        memmove(&bond_[to + 1], &bond_[to], (size_t)(from - to));
+    }
+    fam_[to] = keep;
+    bond_[to] = bond;
+    return 1;
+}
