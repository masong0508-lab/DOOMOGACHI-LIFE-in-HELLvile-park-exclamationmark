+    fresh();
+    id = household_new_person(0, HREL_CHILD);
+    CHECK(id >= 0);
+    CHECK_EQ(household_of(id), 0);
+    CHECK_EQ(family_role(id), FAMROLE_CHILD);
+    CHECK(LIFE_IS_MINOR(sim_life_stage(id)));
+    CHECK_EQ(household_rel(0, PL, id), HREL_PARENT);
+}
+
+/* fill every free place with a custom adult of level 50 */
+static void fill_town(int stage)
+{
+    int id;
+    while ((id = mk(stage)) >= 0) TOWN_RES(id)->level = 50;
+}
+
+TEST(hh_in_a_full_town_the_lowest_friendship_adult_in_no_household_moves_away_with_a_news_line)
+{
+    int head, h, id, leaver, n0, nid;
+    fresh();
+    head = mk(LIFE_ADULT);
+    h = household_create(head);
+    fill_town(LIFE_ADULT);
+    CHECK_EQ(town_alloc(0) < 0 && town_alloc(1) < 0, 1);
+    leaver = 80;                                                       /* (77 is Father Fuzz: a story citizen) */
+    TOWN_RES(leaver)->level = 3;
+    TOWN_RES(5)->level = 9;
+    n0 = sim_news_count();
+    id = household_new_person(h, HREL_NONE);
+    CHECK_EQ(id, leaver);                                              /* the new person took the place ... */
+    CHECK(TOWN_RES(id)->status == RES_ALIVE && (TOWN_RES(id)->flags & RF_CUSTOM));
+    CHECK(TOWN_RES(id)->level == 0);                                   /* ... and is new, not the one who left */
+    CHECK_EQ(household_of(id), h);
+    CHECK_EQ(sim_news_count(), n0 + 1);
+    {   int k, found = 0;
+        for (k = 0; k < sim_news_count(); k++) if (strstr(sim_news(k), "moved away to make room")) found = 1;
+        CHECK(found);
+    }
+    nid = household_new_person(h, HREL_NONE);                          /* the next lowest */
+    CHECK_EQ(nid, 5);
+    CHECK_EQ(household_size(h), 3);
+}
+
+TEST(hh_nobody_who_is_a_minor_a_story_citizen_a_premade_the_avatar_or_housed_is_asked_to_leave)
+{
+    int head, h, id, got;
+    DoomoResident p;
+    fresh();
+    head = mk(LIFE_ADULT);
+    h = household_create(head);
+    fill_town(LIFE_CHILD);                                             /* every other place holds a minor */
+    CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_NO_SPOT));
+    CHECK_STR(household_reason_text(HH_ERR(HHR_NO_SPOT)), "The island is full.");
+    CHECK_EQ(household_size(h), 1);                                    /* nothing was changed */
+    for (id = 6; id < 200 && !(roster_stage(id) == LIFE_ADULT && !ending_kid_cast(id)); id++) {}
+    CHECK(id < 200);
+    resident_set_stage(TOWN_RES(id), LIFE_ADULT);                      /* the one adult, the lowest friendship */
+    TOWN_RES(id)->level = 1;
+    CHECK_EQ(TOWN_RES(id)->status, RES_ALIVE);
+    TOWN_RES(id)->flags |= RF_STORY_NPC;
+    CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_NO_SPOT));           /* a story citizen */
+    TOWN_RES(id)->flags &= (uint8_t)~RF_STORY_NPC;
+    TOWN_RES(id)->flags |= RF_PLAYER;
+    CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_NO_SPOT));           /* the hero */
+    TOWN_RES(id)->flags &= (uint8_t)~RF_PLAYER;
+    CHECK(roster_premade_record(id, &p));
+    *TOWN_RES(id) = p;                                                 /* the premade citizen again, untouched */
+    resident_set_stage(TOWN_RES(id), LIFE_ADULT);
+    TOWN_RES(id)->level = 1;
+    CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_NO_SPOT));           /* a premade citizen */
+    TOWN_RES(id)->flags |= RF_CUSTOM;                                  /* made over by the player: theirs now ... */
+    {   /* ... but a housemate of someone else is skipped */
+        int h2, mate = 0;
+        while (mate == id || mate == head) mate++;
+        h2 = household_create(id);
+        CHECK(h2 > 0 && household_add(h2, mate, HREL_NONE) >= 0);
+        CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_NO_SPOT));
+        household_remove(mate);                                        /* the household dissolves: id is alone */
+    }
+    got = household_new_person(h, HREL_NONE);                          /* a custom adult in no household: yes */
+    CHECK_EQ(got, id);
+}
+
+TEST(hh_a_new_person_never_leaves_a_household_member_behind_when_it_fails_the_rules)
+{
+    int head, h, n0, id;
+    fresh();
+    head = mk(LIFE_ELDER);
+    h = household_create(head);
+    n0 = household_size(h);
+    id = household_new_person(h, HREL_PARENT);                        /* nobody older than an elder */
+    CHECK(id < 0);
+    CHECK_EQ(household_size(h), n0);
+    CHECK_EQ(household_new_person(h, HREL_STEPPARENT) < 0, 1);
+    CHECK_EQ(town_alloc(0) >= 0, 1);                                  /* the slot was given back */
+}
+
+TEST(hh_the_whole_thing_works_when_the_island_holds_500_where_the_ids_only_live_in_slots)
+{
+    /* the same calls on the GBA's 500 (make -C core LIVE=500 test runs the file): ids come from the town */
+    int ids[2], h, id;
+    fresh();
+    h = hh_of(2, ids);
+    id = household_new_person(h, HREL_ROOMMATE);
+    CHECK(id >= 0 && TOWN_RES(id)->status == RES_ALIVE);
+    CHECK_EQ(household_rel(h, id, ids[0]), HREL_ROOMMATE);
+    household_remove(id);
+    town_free(id);
+    CHECK_EQ(household_size(h), 2);
+    CHECK(save_serialize(image, sizeof(image)) > 0);
+}
