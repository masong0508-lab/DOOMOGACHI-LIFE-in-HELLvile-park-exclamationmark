diff --git a/core/tests/test_household.c b/core/tests/test_household.c
new file mode 100644
index 0000000..aa86f82
--- /dev/null
+++ b/core/tests/test_household.c
@@ -0,0 +1,1191 @@
+/* test_household.c - HH-DATA: households for everyone (household.h; docs/design/HOUSEHOLDS_PLAN.md).
+ * The data model, the rulebook of section 3, the 'HOUS' chunk and the new-person placement of section 4.
+ * Owner: HOUSEHOLDS. Every test builds its own people in an empty free play island (no roster edges,
+ * so only the stages and the preferences decide the romance rules). */
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/household.h"
+#include "doomo/family.h"
+#include "doomo/playas.h"
+#include "doomo/roster.h"
+#include "doomo/save.h"
+#include "doomo/save_ext.h"
+#include "doomo/save_budget.h"
+#include "doomo/ending.h"
+#include "doomo/home.h"
+#include "doomo/sim.h"
+
+#define PL DOOMO_PLAYER_ID
+
+static void fresh(void)
+{
+    town_new(TOWN_FREEPLAY, 41, TOWN_POP_EMPTY);
+    sim_init();
+    resident_set_stage(&doomo_town.player, LIFE_ADULT);            /* the player is a grown-up open to romance */
+    resident_set_romance(&doomo_town.player, ROMANCE_ANY);
+}
+
+/* a new live custom citizen of this stage, open to romance (stages decide the rules); -1 if the island is full */
+static int mk(int stage)
+{
+    int id = town_alloc(0);
+    DoomoResident *r;
+    if (id < 0) id = town_alloc(1);
+    if (id < 0) return -1;
+    r = TOWN_RES(id);
+    resident_generate(r, 7000u + (uint32_t)id);
+    resident_set_stage(r, stage);
+    resident_set_romance(r, ROMANCE_ANY);
+    r->status = RES_ALIVE;
+    r->flags = RF_CUSTOM;
+    r->level = 20;
+    resident_sanitize(r);
+    return id;
+}
+
+/* a household of n adults with the first as head (rel NONE); returns its number, fills ids */
+static int hh_of(int n, int *ids)
+{
+    int i, h;
+    for (i = 0; i < n; i++) ids[i] = mk(LIFE_ADULT);
+    h = household_create(ids[0]);
+    for (i = 1; i < n; i++) household_add(h, ids[i], HREL_NONE);
+    return h;
+}
+
+static uint8_t image[256 * 1024];
+
+/* ---- the tables ------------------------------------------------------------------- */
+TEST(hh_reverse_table_is_pure_and_symmetric_ones_map_to_themselves)
+{
+    int r;
+    for (r = 1; r < HREL_COUNT; r++) {
+        CHECK_EQ(household_rel_reverse(household_rel_reverse(r)), r);
+        CHECK(household_rel_reverse(r) > 0);
+    }
+    CHECK_EQ(household_rel_reverse(HREL_PARENT), HREL_CHILD);
+    CHECK_EQ(household_rel_reverse(HREL_STEPPARENT), HREL_STEPCHILD);
+    CHECK_EQ(household_rel_reverse(HREL_GRANDPARENT), HREL_GRANDCHILD);
+    CHECK_EQ(household_rel_reverse(HREL_AUNT_UNCLE), HREL_NIECE_NEPHEW);
+    CHECK_EQ(household_rel_reverse(HREL_PET_OWNER), HREL_PET);
+    CHECK_EQ(household_rel_reverse(HREL_NONE), HREL_NONE);
+    CHECK_EQ(household_rel_reverse(HREL_COUNT), HREL_NONE);
+    CHECK(household_rel_symmetric(HREL_SPOUSE) && household_rel_symmetric(HREL_PARTNER) &&
+          household_rel_symmetric(HREL_FIANCE) && household_rel_symmetric(HREL_SIBLING) &&
+          household_rel_symmetric(HREL_STEPSIBLING) && household_rel_symmetric(HREL_COUSIN) &&
+          household_rel_symmetric(HREL_ROOMMATE));
+    CHECK(!household_rel_symmetric(HREL_PARENT) && !household_rel_symmetric(HREL_PET_OWNER));
+}
+
+TEST(hh_relation_names_follow_the_pronoun_and_every_reason_has_a_plain_line)
+{
+    int c;
+    CHECK_STR(household_rel_name(HREL_PARENT, PRONOUN_SHE), "mother");
+    CHECK_STR(household_rel_name(HREL_PARENT, PRONOUN_HE), "father");
+    CHECK_STR(household_rel_name(HREL_PARENT, PRONOUN_THEY), "parent");
+    CHECK_STR(household_rel_name(HREL_CHILD, PRONOUN_XE), "child");
+    CHECK_STR(household_rel_name(HREL_NONE, PRONOUN_SHE), "");
+    for (c = 1; c < HHR_COUNT; c++) {
+        CHECK(household_reason_text(c)[0] != 0);
+        CHECK_STR(household_reason_text(-c), household_reason_text(c));
+        CHECK(strlen(household_reason_text(c)) <= 48);          /* one line on the GBA */
+    }
+    CHECK_STR(household_reason_text(0), "");
+}
+
+/* ---- households: create, add, the 20, one at a time -------------------------------------- */
+TEST(hh_create_and_add_keep_the_order_and_find_everyone)
+{
+    int ids[4], h;
+    fresh();
+    CHECK_EQ(household_count(), 1);
+    h = hh_of(4, ids);
+    CHECK_EQ(h, 1);
+    CHECK_EQ(household_count(), 2);
+    CHECK_EQ(household_size(h), 4);
+    CHECK_EQ(household_head(h), ids[0]);
+    CHECK_EQ(household_member(h, 3), ids[3]);
+    CHECK_EQ(household_member(h, 4), -1);
+    CHECK_EQ(household_of(ids[2]), 1);
+    CHECK_EQ(household_of(PL), 0);
+    CHECK_EQ(household_of(mk(LIFE_ADULT)), -1);                 /* alone: no record, no cost */
+    CHECK_EQ(household_head(0), PL);
+    CHECK_EQ(household_size(0), 1);
+}
+
+TEST(hh_a_resident_is_in_one_household_at_a_time)
+{
+    int a[2], b[2], h1, h2, fam;
+    fresh();
+    h1 = hh_of(2, a);
+    h2 = hh_of(2, b);
+    CHECK_EQ(household_add(h2, a[1], HREL_NONE), HH_ERR(HHR_DUP));
+    CHECK_EQ(household_create(a[0]), HH_ERR(HHR_DUP));
+    CHECK_EQ(household_add(h1, a[1], HREL_NONE), HH_ERR(HHR_DUP));      /* even the same one twice */
+    fam = mk(LIFE_ADULT);
+    CHECK(household_add(0, fam, HREL_NONE) >= 0);                        /* the player's own table */
+    CHECK_EQ(household_of(fam), 0);
+    CHECK_EQ(household_add(h1, fam, HREL_NONE), HH_ERR(HHR_DUP));
+    CHECK_EQ(household_create(fam), HH_ERR(HHR_DUP));
+    CHECK_EQ(household_add(0, b[0], HREL_NONE), HH_ERR(HHR_DUP));        /* in a record: not in 0 too */
+    CHECK_EQ(household_add(h1, PL, HREL_NONE), HH_ERR(HHR_HEAD));
+}
+
+TEST(hh_a_household_holds_twenty_and_refuses_the_21st)
+{
+    int ids[HH_MEMBERS_MAX], extra, h;
+    fresh();
+    h = hh_of(HH_MEMBERS_MAX, ids);
+    CHECK_EQ(household_size(h), 20);
+    extra = mk(LIFE_ADULT);
+    CHECK_EQ(household_add(h, extra, HREL_NONE), HH_ERR(HHR_FULL));
+    CHECK_EQ(household_size(h), 20);
+    CHECK_EQ(household_of(extra), -1);
+    CHECK_EQ(household_move(extra, h), HH_ERR(HHR_FULL));
+    CHECK_EQ(household_new_person(h, HREL_NONE), HH_ERR(HHR_FULL));
+}
+
+TEST(hh_the_players_household_takes_twenty_besides_the_player)
+{
+    int i, extra;
+    fresh();
+    CHECK_EQ(household_cap(0), 21);
+    CHECK_EQ(household_cap(1), 0);                              /* no such household yet */
+    for (i = 0; i < 20; i++) CHECK(household_add(0, mk(LIFE_ADULT), HREL_NONE) >= 0);
+    CHECK_EQ(household_size(0), 21);
+    CHECK_EQ(family_count(), 20);
+    extra = mk(LIFE_ADULT);
+    CHECK_EQ(household_add(0, extra, HREL_NONE), HH_ERR(HHR_FULL));
+    CHECK_EQ(household_member(0, 0), PL);
+    CHECK_EQ(household_member(0, 1), family_member(0));
+    CHECK_EQ(household_member(0, 20), family_member(19));
+}
+
+TEST(hh_only_residents_join_a_residents_household_and_pool_people_stay_with_the_player)
+{
+    int ids[2], h, pool;
+    fresh();
+    h = hh_of(2, ids);
+    pool = family_pool_add(FAMROLE_HOUSEMATE, LIFE_ADULT, 5u, "Zed", -1);
+    CHECK(pool >= 0);
+    CHECK_EQ(household_of(pool), 0);
+    CHECK_EQ(household_add(h, pool, HREL_NONE), HH_ERR(HHR_POOL));
+    CHECK_EQ(household_move(pool, h), HH_ERR(HHR_POOL));
+    CHECK_EQ(household_create(pool), HH_ERR(HHR_POOL));
+    CHECK_EQ(household_add(h, 999, HREL_NONE), HH_ERR(HHR_BAD_ID));     /* nobody lives there */
+    CHECK_EQ(household_add(7, ids[0], HREL_NONE), HH_ERR(HHR_BAD_HOUSEHOLD));
+}
+
+TEST(hh_at_most_hh_max_recs_households_and_a_clear_reason)
+{
+    int i, id, h = 0;
+    fresh();
+    for (i = 0; i < HH_MAX_RECS; i++) {
+        int a = mk(LIFE_ADULT), b = mk(LIFE_ADULT);
+        if (a < 0 || b < 0) return;                             /* a small island cannot test it */
+        h = household_create(a);
+        CHECK(h > 0 && household_add(h, b, HREL_NONE) >= 0);
+    }
+    CHECK_EQ(household_count(), 1 + HH_MAX_RECS);
+    id = mk(LIFE_ADULT);
+    CHECK_EQ(household_create(id), HH_ERR(HHR_NO_ROOM));
+    CHECK_STR(household_reason_text(HH_ERR(HHR_NO_ROOM)), "No room in town for more households.");
+}
+
+/* ---- leaving, moving, head, order ---------------------------------------------------------- */
+TEST(hh_the_head_who_leaves_passes_the_head_on_and_the_rows_close_up)
+{
+    int ids[4], h;
+    fresh();
+    h = hh_of(4, ids);
+    CHECK_EQ(household_rel_set(h, ids[2], ids[3], HREL_SIBLING), 0);
+    CHECK_EQ(household_rel_set(h, ids[0], ids[1], HREL_ROOMMATE), 0);
+    CHECK_EQ(household_remove(ids[0]), 0);                       /* the head moves out */
+    CHECK_EQ(household_head(h), ids[1]);
+    CHECK_EQ(household_size(h), 3);
+    CHECK_EQ(household_of(ids[0]), -1);
+    CHECK_EQ(household_rel(h, ids[2], ids[3]), HREL_SIBLING);    /* slots shifted, the row still right */
+    CHECK_EQ(household_rel_count(h), 1);                         /* the row with the one who left is gone */
+    CHECK_EQ(household_remove(ids[0]), HH_ERR(HHR_NOT_MEMBER));
+}
+
+TEST(hh_a_household_left_with_one_person_is_dissolved_and_later_ones_move_up)
+{
+    int a[2], b[2], c[2], h1, h2, h3;
+    fresh();
+    h1 = hh_of(2, a); h2 = hh_of(2, b); h3 = hh_of(2, c);
+    CHECK_EQ((h1 << 8) | (h2 << 4) | h3, 0x123);
+    CHECK_EQ(household_remove(a[1]), 1);                         /* 1 = dissolved */
+    CHECK_EQ(household_count(), 3);
+    CHECK_EQ(household_of(a[0]), -1);
+    CHECK_EQ(household_of(b[0]), 1);                             /* the later ones moved up */
+    CHECK_EQ(household_of(c[1]), 2);
+    CHECK_EQ(household_head(2), c[0]);
+    CHECK_EQ(household_remove(c[0]), 1);
+    CHECK_EQ(household_count(), 2);
+}
+
+TEST(hh_move_leaves_the_old_household_first_and_follows_a_dissolving_one)
+{
+    int a[3], b[2], h1, h2;
+    fresh();
+    h1 = hh_of(3, a);
+    h2 = hh_of(2, b);
+    CHECK_EQ(household_move(a[2], h2), 0);
+    CHECK_EQ(household_size(h1), 2);
+    CHECK_EQ(household_size(h2), 3);
+    CHECK_EQ(household_of(a[2]), 2);
+    CHECK_EQ(household_move(a[1], h2), 0);                       /* h1 drops to one: dissolved ... */
+    CHECK_EQ(household_count(), 2);                              /* ... and h2 is now number 1 */
+    CHECK_EQ(household_of(a[1]), 1);
+    CHECK_EQ(household_size(1), 4);
+    CHECK_EQ(household_of(a[0]), -1);
+    CHECK_EQ(household_move(a[1], 1), 0);                        /* already there: nothing */
+    CHECK_EQ(household_move(PL, 1), HH_ERR(HHR_HEAD));
+    CHECK_EQ(household_move(a[1], 5), HH_ERR(HHR_BAD_HOUSEHOLD));
+}
+
+TEST(hh_move_in_and_out_of_the_players_household)
+{
+    int ids[2], h, n;
+    fresh();
+    h = hh_of(2, ids);
+    CHECK_EQ(household_move(ids[1], 0), 0);                      /* moves in with the player */
+    CHECK_EQ(household_of(ids[1]), 0);
+    CHECK_EQ(family_role(ids[1]), FAMROLE_HOUSEMATE);
+    CHECK_EQ(household_count(), 1);                              /* h dissolved: one left */
+    CHECK_EQ(household_of(ids[0]), -1);
+    (void)h;
+    n = mk(LIFE_ADULT);
+    h = household_create(ids[0]);
+    CHECK(h > 0 && household_add(h, n, HREL_NONE) >= 0);
+    CHECK_EQ(household_move(ids[1], h), 0);                      /* ... and out again */
+    CHECK_EQ(household_of(ids[1]), h);
+    CHECK_EQ(family_count(), 0);
+    CHECK_EQ(household_remove(PL), HH_ERR(HHR_HEAD));
+}
+
+TEST(hh_set_head_swaps_with_the_head_and_the_rows_follow)
+{
+    int ids[3], h;
+    fresh();
+    h = hh_of(3, ids);
+    CHECK_EQ(household_rel_set(h, ids[1], ids[2], HREL_SIBLING), 0);
+    CHECK_EQ(household_rel_set(h, ids[0], ids[2], HREL_ROOMMATE), 0);
+    CHECK_EQ(household_set_head(h, ids[2]), 0);
+    CHECK_EQ(household_head(h), ids[2]);
+    CHECK_EQ(household_member(h, 2), ids[0]);
+    CHECK_EQ(household_rel(h, ids[1], ids[2]), HREL_SIBLING);
+    CHECK_EQ(household_rel(h, ids[0], ids[2]), HREL_ROOMMATE);
+    CHECK_EQ(household_set_head(h, ids[2]), 0);                  /* already the head */
+    CHECK_EQ(household_set_head(h, mk(LIFE_ADULT)), HH_ERR(HHR_NOT_MEMBER));
+    CHECK_EQ(household_set_head(0, ids[0]), HH_ERR(HHR_HEAD));
+}
+
+TEST(hh_reorder_moves_a_member_along_the_strip_and_keeps_the_head_first)
+{
+    int ids[4], h;
+    fresh();
+    h = hh_of(4, ids);
+    CHECK_EQ(household_rel_set(h, ids[1], ids[3], HREL_SIBLING), 0);
+    CHECK_EQ(household_reorder(h, 3, 1), 0);                     /* the last to second place */
+    CHECK_EQ(household_member(h, 0), ids[0]);
+    CHECK_EQ(household_member(h, 1), ids[3]);
+    CHECK_EQ(household_member(h, 2), ids[1]);
+    CHECK_EQ(household_member(h, 3), ids[2]);
+    CHECK_EQ(household_rel(h, ids[1], ids[3]), HREL_SIBLING);    /* the pair is still the pair */
+    CHECK_EQ(household_reorder(h, 1, 3), 0);
+    CHECK_EQ(household_member(h, 3), ids[3]);
+    CHECK_EQ(household_rel(h, ids[3], ids[1]), HREL_SIBLING);
+    CHECK_EQ(household_reorder(h, 0, 2), HH_ERR(HHR_BAD_ID));     /* the head does not move this way */
+    CHECK_EQ(household_reorder(h, 1, 4), HH_ERR(HHR_BAD_ID));
+}
+
+TEST(hh_reorder_in_the_players_household_swaps_the_family_table_and_keeps_the_bond)
+{
+    int a, b, c;
+    fresh();
