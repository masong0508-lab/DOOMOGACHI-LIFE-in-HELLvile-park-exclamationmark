+    h = household_create(g);
+    CHECK(household_add(h, p, HREL_NONE) >= 0 && household_add(h, c1, HREL_NONE) >= 0 &&
+          household_add(h, c2, HREL_NONE) >= 0);
+    /* a direct parent: refused */
+    CHECK_EQ(household_rel_set(h, g, p, HREL_PARENT), 0);
+    CHECK_EQ(household_rel_check(h, g, p, HREL_SPOUSE), HHR_KIN);
+    CHECK_EQ(household_rel_check(h, p, g, HREL_PARTNER), HHR_KIN);
+    /* a grandparent by the tree (never stated): the parent chain makes them kin */
+    c3 = mk(LIFE_CHILD);
+    CHECK(household_add(h, c3, HREL_NONE) >= 0);
+    CHECK_EQ(household_rel_set(h, p, c3, HREL_PARENT), 0);
+    CHECK_EQ(household_rel_check(h, g, c3, HREL_FIANCE), HHR_ADULTS_ONLY);   /* minors go first */
+    resident_set_stage(TOWN_RES(c3), LIFE_ADULT);
+    CHECK_EQ(household_rel_check(h, g, c3, HREL_FIANCE), HHR_KIN);
+    /* siblings by a shared parent, never stated */
+    CHECK_EQ(household_rel_set(h, p, c1, HREL_PARENT), HH_ERR(HHR_PARENT_OLDER));   /* adult / adult: not older */
+    resident_set_stage(TOWN_RES(p), LIFE_ELDER);
+    resident_set_stage(TOWN_RES(c3), LIFE_ADULT);
+    CHECK_EQ(household_rel_set(h, p, c1, HREL_PARENT), 0);
+    CHECK_EQ(household_rel_check(h, c1, c3, HREL_PARTNER), HHR_KIN);
+    CHECK_EQ(household_rel_check(h, c3, c1, HREL_SPOUSE), HHR_KIN);
+    /* a stated cousin, sibling, step-sibling */
+    CHECK_EQ(household_rel_set(h, c1, c2, HREL_COUSIN), 0);
+    CHECK_EQ(household_rel_check(h, c1, c2, HREL_SPOUSE), HHR_KIN);
+    CHECK_EQ(household_rel_set(h, c1, c2, HREL_STEPSIBLING), 0);
+    CHECK_EQ(household_rel_check(h, c2, c1, HREL_PARTNER), HHR_KIN);
+    /* a stranger to all of them is fine */
+    CHECK_EQ(household_rel_check(h, g, c2, HREL_PARTNER), 0);
+}
