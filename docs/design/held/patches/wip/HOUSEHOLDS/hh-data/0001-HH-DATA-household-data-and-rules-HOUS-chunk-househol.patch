+    CHECK_EQ(household_rel_set(h, a, b, HREL_PARENT), 0);
+    CHECK_EQ(household_rel_set(h, b, c, HREL_PARENT), 0);
+    resident_set_stage(TOWN_RES(a), LIFE_ADULT);                /* the creator ages them differently ... */
+    resident_set_stage(TOWN_RES(c), LIFE_ELDER);
+    CHECK_EQ(household_rel_check(h, c, a, HREL_PARENT), HHR_CYCLE);      /* c over a would close a loop a - b - c - a */
+    CHECK_EQ(household_rel_check(h, a, c, HREL_CHILD), HHR_CYCLE);       /* the same in the other words */
+    CHECK_EQ(household_rel_check(h, c, a, HREL_GRANDPARENT), HHR_CYCLE);
+    CHECK_EQ(household_rel_check(h, c, a, HREL_AUNT_UNCLE), 0);          /* not an ancestor link */
+    CHECK_EQ(household_rel_set(h, c, a, HREL_PARENT), HH_ERR(HHR_CYCLE));
