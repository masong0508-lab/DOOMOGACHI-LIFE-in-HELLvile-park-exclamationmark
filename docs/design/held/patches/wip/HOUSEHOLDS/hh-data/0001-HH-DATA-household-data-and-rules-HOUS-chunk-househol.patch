+/* ---- relations: reverse, rows ------------------------------------------------------------------ */
+/* two people for a relation: older (ELDER) a, younger (ADULT) b, in one household */
+static int pair_(int *a, int *b)
+{
+    int h;
+    *a = mk(LIFE_ELDER);
+    *b = mk(LIFE_ADULT);
+    h = household_create(*a);
+    household_add(h, *b, HREL_NONE);
+    return h;
+}
