+/* fill the three kinds of data: records, their rows, and household 0's rows */
+static void build_world(int *ids, int *nids)
+{
+    int h1, h2, i, n = 0, a, b, c;
+    a = mk(LIFE_ELDER); b = mk(LIFE_ADULT); c = mk(LIFE_CHILD);
+    h1 = household_create(a);
+    household_add(h1, b, HREL_NONE);
+    household_add(h1, c, HREL_NONE);
+    household_rel_set(h1, a, b, HREL_PARENT);
+    household_rel_set(h1, b, c, HREL_PARENT);
+    household_rel_set(h1, a, c, HREL_GRANDPARENT);
+    ids[n++] = a; ids[n++] = b; ids[n++] = c;
+    a = mk(LIFE_ADULT); b = mk(LIFE_ADULT);
+    h2 = household_create(a);
+    household_add(h2, b, HREL_SPOUSE);
+    ids[n++] = a; ids[n++] = b;
+    a = mk(LIFE_ADULT); b = mk(LIFE_ADULT);
+    household_add(0, a, HREL_FIANCE);
+    household_add(0, b, HREL_NONE);
+    household_rel_set(0, a, b, HREL_COUSIN);
+    ids[n++] = a; ids[n++] = b;
+    for (i = 0; i < n; i++) CHECK(ids[i] >= 0);
+    *nids = n;
+}
