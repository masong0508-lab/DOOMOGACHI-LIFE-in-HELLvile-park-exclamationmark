diff --git a/core/include/doomo/household.h b/core/include/doomo/household.h
new file mode 100644
index 0000000..b4487fd
--- /dev/null
+++ b/core/include/doomo/household.h
@@ -0,0 +1,161 @@
+/* household.h - households for everyone (owner: HOUSEHOLDS; HH-DATA; docs/design/HOUSEHOLDS_PLAN.md).
+ *
+ * Household 0 is the player's: its members stay in family.h's table (up to FAMILY_MAX = 20 besides the
+ * player, every platform), and this file only adds its pairwise relation list. Households 1.. are
+ * residents' households: a head and up to HH_MEMBERS_MAX = 20 residents (the head counts, ids 0..999,
+ * never pool ids), at most HH_MAX_RECS of them. A resident is in one household at a time:
+ * household_of(id) is 0 (the player's), 1.., or -1 (alone; a lone resident costs nothing).
+ * Household numbers are positions: 1..household_count()-1. A household that is dissolved or created
+ * shifts the later ones, so keep the head's id, not the number, between calls.
+ *
+ * Relations (HREL_*) read "a is b's X". One row per pair; the reverse is a pure table. Household 0's
+ * pairs with the player fall back to the old FamilyMember.role when no row exists. household_rel_check()
+ * is the rulebook (plan section 3): it reads life stages, sim_romance_ok (through playas_romance_ok) and
+ * the kid-cast list through the sim, and NEVER writes mature_adult_ok or the kid-cast list.
+ *
+ * Saved in the 'HOUS' chunk (own tag, version 1, SAVE_EXT_MAX_HOUS). Nothing is written while there are
+ * no residents' households and no relation rows, so an island without them saves byte for byte as before.
+ *
+ * Calls return 0 / a count / an index on success and a negative HH_ERR_* on failure (-HHR_*; the creator
+ * shows household_reason_text() as one plain line). Nothing changes on an error.
+ */
+#ifndef DOOMO_HOUSEHOLD_H
+#define DOOMO_HOUSEHOLD_H
+
+#include "types.h"
+
+#define HH_MEMBERS_MAX 20            /* a household's size, the head included (the player's: besides the player) */
+#ifndef HH_MAX_RECS
+#define HH_MAX_RECS    24            /* residents' households; -DHH_MAX_RECS=12 is the PS1 fallback */
+#endif
+#define HH_RELS_MAX    32            /* relation rows per household */
+
+/* Relations: "a is b's ...". Saved as numbers: add at the end only. */
+enum {
+    HREL_NONE = 0,
+    HREL_SPOUSE, HREL_PARTNER, HREL_FIANCE,          /* symmetric; adults only */
+    HREL_PARENT, HREL_CHILD,                         /* a is b's parent / child */
+    HREL_STEPPARENT, HREL_STEPCHILD,
+    HREL_SIBLING, HREL_STEPSIBLING,                  /* symmetric */
+    HREL_GRANDPARENT, HREL_GRANDCHILD,
+    HREL_AUNT_UNCLE, HREL_NIECE_NEPHEW,
+    HREL_COUSIN,                                     /* symmetric */
+    HREL_ROOMMATE,                                   /* symmetric */
+    HREL_PET_OWNER, HREL_PET,                        /* a owns b / a is b's pet */
+    HREL_COUNT
+};
+/* The other side: reverse(PARENT) = CHILD, reverse(SPOUSE) = SPOUSE, ... HREL_NONE for a bad value. */
+int household_rel_reverse(int rel);
+int household_rel_symmetric(int rel);
+/* "mother", "father", "parent", ... for rel as someone of this PRONOUN_* ("" for HREL_NONE / bad). Static text. */
+const char *household_rel_name(int rel, int pronoun);
+
+/* Why something was refused (HHR_*); the calls return -HHR_*. */
+enum {
+    HHR_OK = 0,
+    HHR_BAD_ID,          /* not a resident who lives here                       */
+    HHR_BAD_HOUSEHOLD,   /* no such household                                   */
+    HHR_DUP,             /* already in a household                              */
+    HHR_FULL,            /* the household has its 20                            */
+    HHR_NO_ROOM,         /* no room in the town's households or the save file   */
+    HHR_NOT_MEMBER,      /* one of the two is not in this household             */
+    HHR_SELF,            /* a person and themselves                             */
+    HHR_BAD_REL,         /* not a relation (or one this call cannot make)       */
+    HHR_ADULTS_ONLY,     /* a partner, spouse, fiance or crush must be an adult */
+    HHR_ROMANCE,         /* the romance rules say no (sim_romance_ok)           */
+    HHR_KIN,             /* family never pairs up                               */
+    HHR_ONE_AT_A_TIME,   /* one spouse, partner or fiance at a time             */
+    HHR_PARENT_ADULT,    /* the older side must be a grown-up                   */
+    HHR_PARENT_OLDER,    /* and older than the younger side                     */
+    HHR_CYCLE,           /* nobody is their own ancestor                        */
+    HHR_GENERATION,      /* a parent's parent is a grandparent                  */
+    HHR_MINOR_ROOMMATE,  /* a minor is never a grown-up's roommate              */
+    HHR_PET_OTHER,       /* a pet has just its owner                            */
+    HHR_PET_OWNER,       /* the owner must be a person                          */
+    HHR_HEAD,            /* the player always heads their own household         */
+    HHR_POOL,            /* pool people live only in the player's household     */
+    HHR_NO_SPOT,         /* the island is full and nobody can move away         */
+    HHR_FAMILY,          /* the old household table refused the role            */
+    HHR_COUNT
+};
+#define HH_ERR(code) (-(code))
+/* One plain sentence for a reason code (positive or negative; "" for OK). Static text. */
+const char *household_reason_text(int code);
+
+/* ---- households ------------------------------------------------------------ */
+int  household_count(void);                    /* 1 + the residents' households: valid numbers are 0..count-1 */
+int  household_head(int h);                    /* the player (DOOMO_PLAYER_ID) for 0, else the head; -1 if none */
+int  household_size(int h);                    /* people in it, head included (0: the player + family_count()) */
+int  household_member(int h, int i);           /* the i-th person, 0 = the head; -1 if out of range */
+int  household_of(int id);                     /* 0 (the player or a family member), 1.., or -1 */
+int  household_cap(int h);                     /* most people it holds (0: the player + family_cap(); else 20); 0 if no such household */
+
+/* A new household with `head` (a resident in no household) alone in it: returns its number. A lone
+ * household is not saved: add someone (a household of one person is dissolved by a save and a load). */
+int  household_create(int head);
+/* Add resident `id` (a live resident in no household; for household 0 also a free pool id) as `rel_to_head`:
+ * "id is the head's ..." (HREL_NONE = no stated relation). The relation passes household_rel_check.
+ * Returns the person's position. For household 0 the old family table does the adding (family_add):
+ * the role comes from the relation (a partner, child, parent, sibling, grandparent, pet; otherwise a housemate). */
+int  household_add(int h, int id, int rel_to_head);
+/* Move a resident to household `to` (0 = the player's). It leaves the old household first (a head who
+ * leaves passes the head on; a household left with one person is dissolved). */
+int  household_move(int id, int to);
+/* Take a person out of their household: 0, or 1 when that dissolved the household (its number is gone).
+ * A head who leaves passes the head to the next member. For household 0 it is family_remove(); the player
+ * cannot be removed. Relation rows with the person go. */
+int  household_remove(int id);
+/* The new head of a residents' household (the person swaps places with the head). */
+int  household_set_head(int h, int id);
+/* Move the person at position `from` to position `to` (1..size-1; the head stays first). For household 0 it
+ * reorders the family table (the bond bytes follow). */
+int  household_reorder(int h, int from, int to);
+
+/* ---- relations -------------------------------------------------------------- */
+/* a is b's ... : the stored row (either way round), else for household 0 the old FamilyMember.role against
+ * the player, else HREL_NONE. -1 if a household or person is bad. */
+int  household_rel(int h, int a, int b);
+/* The rulebook: 0 or a HHR_* reason. Checks only; writes nothing. */
+int  household_rel_check(int h, int a, int b, int rel);
+/* Set "a is b's rel" (the reverse side is implied): replaces the pair's row; HREL_NONE clears it.
+ * 0, or HH_ERR(reason). In household 0 a relation with the player also updates the old role when
+ * it maps to one (partner, child, parent, sibling, grandparent, housemate, pet). */
+int  household_rel_set(int h, int a, int b, int rel);
+/* Rows stored in household h. */
+int  household_rel_count(int h);
+/* Crush feelings (a town-graph edge, set by the creator's Feelings page): 0 or a reason. Adults only,
+ * both ways, sim_romance_ok. Not stored here. */
+int  household_crush_check(int a, int b);
+
+/* ---- a new person for a household ------------------------------------------ */
+/* Make room for and create a new person: the first free resident place of the household's district (else
+ * the other), else the resident with the lowest friendship level who is in no household, is an adult and
+ * is not a story or premade citizen, the avatar or the hero moves away (news "X moved away to make room",
+ * town_free). The new person is a fresh generated resident of the stage the relation suggests (a child
+ * for HREL_CHILD / STEPCHILD / GRANDCHILD / NIECE_NEPHEW, else an adult) and joins household h as
+ * `rel_to_head` ("is the head's ..."). The creator then edits that slot in place; if it is cancelled, it
+ * calls household_remove(id) and town_free(id). Returns the new resident's id, or HH_ERR(reason). */
+int  household_new_person(int h, int rel_to_head);
+
+/* ---- upkeep ------------------------------------------------------------------ */
+/* A person who is no longer a household member (family_remove calls this): their rows go. */
+void household_forget(int id);
+/* Drop everyone who is dead or gone, dissolve households left with fewer than two. Returns how many left. */
+int  household_sweep(void);
+/* No households (a new town; the HOUS chunk's reset). */
+void household_clear(void);
+
+/* ---- the 'HOUS' chunk (version 1) --------------------------------------------
+ * count u8, then per record: head u16, n u8, flags u8, n x member u16, nrel u8, then nrel x row.
+ * A residents' record: head = member[0], rows are (slot a u8, slot b u8, rel u8). Household 0's
+ * relation list, when it has rows, is the FIRST record with head 0xFFFF and n 0; its rows are
+ * (id a u16, id b u16, rel u8) because its members live in the family table. */
+#define HH_REC_HEAD     4u                 /* head u16, n u8, flags u8 */
+#define HH_REC_WORST    (HH_REC_HEAD + 2u * HH_MEMBERS_MAX + 1u + 3u * HH_RELS_MAX)   /* 141 */
+#define HH_REC0_WORST   (HH_REC_HEAD + 1u + 5u * HH_RELS_MAX)                         /* 165 */
+#define HH_SAVE_WORST   (1u + HH_REC0_WORST + (uint32_t)HH_MAX_RECS * HH_REC_WORST)   /* 3,550 with 24 */
+uint32_t household_save_size(void);
+uint32_t household_save(uint8_t *dst, uint32_t cap);
+int      household_load(const uint8_t *src, uint32_t len);
+
+#endif
