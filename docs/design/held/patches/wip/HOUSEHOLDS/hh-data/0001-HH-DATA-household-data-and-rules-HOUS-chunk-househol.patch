+    uint32_t o = 1;
+    uint8_t rows[6] = { 0, 1, HREL_ROOMMATE, 1, 2, HREL_ROOMMATE };
+    fresh();
+    a = mk(LIFE_ADULT); b = mk(LIFE_ADULT); c = mk(LIFE_ADULT); d = mk(LIFE_ADULT);
+    e = mk(LIFE_ADULT); f = mk(LIFE_ADULT); g = mk(LIFE_ADULT);
+    town_res(c)->status = RES_DEAD;                                  /* c died since the save */
+    household_add(0, g, HREL_NONE);                                  /* g lives with the player now */
+    m1[0] = a; m1[1] = b; m1[2] = c; m1[3] = 980;                    /* a, b, dead c, nobody at 980 */
+    buf[0] = 4;
+    o = put_rec(buf, o, m1, 4, rows, 2);
+    m2[0] = b; m2[1] = d; m2[2] = e;                                 /* b again: stays in the first record only */
+    o = put_rec(buf, o, m2, 3, NULL, 0);
+    m3[0] = f; m3[1] = g;                                            /* g is the player's now: f is left alone */
+    o = put_rec(buf, o, m3, 2, NULL, 0);
+    m4[0] = e; m4[1] = e; m4[2] = f;                                 /* named twice in one record */
+    o = put_rec(buf, o, m4, 3, NULL, 0);
+    CHECK(household_load(buf, o));
+    CHECK_EQ(household_count(), 3);                                  /* two households survive */
+    CHECK_EQ(household_of(a), 1);
+    CHECK_EQ(household_of(b), 1);
+    CHECK_EQ(household_size(1), 2);                                  /* dead c and nobody at 980 dropped */
+    CHECK_EQ(household_rel(1, a, b), HREL_ROOMMATE);                 /* the row between the survivors stays ... */
+    CHECK_EQ(household_rel_count(1), 1);                             /* ... the one with dead c is gone */
+    CHECK_EQ(household_of(d), 2);                                    /* the second record lost b: d and e remain */
+    CHECK_EQ(household_of(e), 2);
+    CHECK_EQ(household_size(2), 2);
+    CHECK_EQ(household_of(g), 0);                                    /* the player's, not in a record as well */
+    CHECK_EQ(household_of(f), -1);                                   /* the third record (f, g) and the fourth (e, e, f) fell to one */
