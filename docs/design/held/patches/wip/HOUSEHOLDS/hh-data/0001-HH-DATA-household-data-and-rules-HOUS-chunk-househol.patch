index 0000000..a08c8ac
--- /dev/null
+++ b/core/src/household.c
@@ -0,0 +1,872 @@
+/* household.c - households for everyone (owner: HOUSEHOLDS; HH-DATA; household.h, docs/design/HOUSEHOLDS_PLAN.md).
+ *
+ * The data and the rulebook. Residents' households are records of up to 20 residents with a list of
+ * relation rows (slot a, slot b, rel: "a is b's rel"). Household 0 (the player's) keeps its members in
+ * family.c and owns just a list of rows by id. Nothing here draws or runs per frame: the sim (HH-USE)
+ * and the creator (HH-CREATOR, HH-REL) call it.
+ *
+ * Memory: HH_MAX_RECS x 140 B + 192 B, plain .bss (no allocation).
+ */
+#include <string.h>
+#include "doomo/doomo.h"
+#include "doomo/household.h"
+#include "doomo/family.h"
+#include "doomo/playas.h"
+#include "doomo/sim.h"
+#include "doomo/town.h"
+#include "doomo/roster.h"
+#include "doomo/ending.h"
+#include "doomo/part_meta.h"
+#include "doomo/portrait.h"
+#include "doomo/save_ext.h"
+#include "doomo/save_budget.h"
+
+#define PLAYER DOOMO_PLAYER_ID
+
+typedef struct HouseRel { uint8_t a, b, rel; } HouseRel;          /* slots in the record */
+typedef struct HouseRec {
+    uint8_t  n, flags, nrel, spare;
+    uint16_t member[HH_MEMBERS_MAX];                             /* [0] is the head */
+    HouseRel rel[HH_RELS_MAX];
+} HouseRec;                                                      /* 140 B */
+DOOMO_STATIC_ASSERT(sizeof(HouseRec) == 140, house_rec_is_140_bytes);
+
+static HouseRec rec_[HH_MAX_RECS];                               /* household number h = rec_[h - 1] */
+static uint8_t  nrec_;
+static uint16_t h0a_[HH_RELS_MAX], h0b_[HH_RELS_MAX];            /* household 0's rows, by id */
+static uint8_t  h0r_[HH_RELS_MAX], nh0_;
+
+/* ---- the plain tables ---------------------------------------------------------- */
+static const uint8_t rev_[HREL_COUNT] = {
+    HREL_NONE, HREL_SPOUSE, HREL_PARTNER, HREL_FIANCE, HREL_CHILD, HREL_PARENT,
+    HREL_STEPCHILD, HREL_STEPPARENT, HREL_SIBLING, HREL_STEPSIBLING, HREL_GRANDCHILD,
+    HREL_GRANDPARENT, HREL_NIECE_NEPHEW, HREL_AUNT_UNCLE, HREL_COUSIN, HREL_ROOMMATE,
+    HREL_PET, HREL_PET_OWNER
+};
+
+int household_rel_reverse(int rel) { return rel > 0 && rel < HREL_COUNT ? rev_[rel] : HREL_NONE; }
+int household_rel_symmetric(int rel) { return rel > 0 && rel < HREL_COUNT && rev_[rel] == rel; }
+
+/* she / he / they words; the other pronouns use the neutral one */
+static const char *const relname_[HREL_COUNT][3] = {
+    { "", "", "" },
+    { "wife", "husband", "spouse" }, { "partner", "partner", "partner" },
+    { "fiancee", "fiance", "fiance" },
+    { "mother", "father", "parent" }, { "daughter", "son", "child" },
+    { "stepmother", "stepfather", "stepparent" }, { "stepdaughter", "stepson", "stepchild" },
+    { "sister", "brother", "sibling" }, { "stepsister", "stepbrother", "stepsibling" },
+    { "grandmother", "grandfather", "grandparent" }, { "granddaughter", "grandson", "grandchild" },
+    { "aunt", "uncle", "aunt or uncle" }, { "niece", "nephew", "niece or nephew" },
+    { "cousin", "cousin", "cousin" }, { "roommate", "roommate", "roommate" },
+    { "owner", "owner", "owner" }, { "pet", "pet", "pet" }
+};
+
+const char *household_rel_name(int rel, int pronoun)
+{
+    if (rel <= 0 || rel >= HREL_COUNT) return "";
+    return relname_[rel][pronoun == PRONOUN_SHE ? 0 : pronoun == PRONOUN_HE ? 1 : 2];
+}
+
+static const char *const reason_[HHR_COUNT] = {
+    "", "That person is not here.", "There is no such household.", "They already live in a household.",
+    "A household holds 20 people at most.", "No room in town for more households.",
+    "Both must live in this household.", "That is the same person.", "That is not a relation.",
+    "Only grown-ups can be a couple.", "They would not be a couple.", "Family cannot be a couple.",
+    "One partner at a time.", "A parent must be a grown-up.", "A parent must be older.",
+    "Nobody can be their own ancestor.", "A parent's parent is a grandparent.",
+    "A child cannot be a grown-up's roommate.", "A pet only has its owner.",
+    "A pet needs a person as its owner.", "The player always leads their own household.",
+    "Only the player's household takes pool people.", "The island is full.",
+    "The household cannot take that role."
+};
+
+const char *household_reason_text(int code)
+{
+    if (code < 0) code = -code;
+    return code >= 0 && code < HHR_COUNT ? reason_[code] : "";
+}
+
+/* ---- people ---------------------------------------------------------------------- */
+static int res_ok_(int id)
+{
+    const DoomoResident *r;
+    if (id < 0 || id >= DOOMO_MAX_RESIDENTS) return 0;
+    r = town_res(id);
+    return r && (r->status == RES_ALIVE || r->status == RES_GHOST);
+}
+
+static int is_pool_(int id) { return id >= FAMILY_POOL_FIRST && id <= FAMILY_POOL_LAST; }
+
+static int stage_(int id)
+{
+    if (id >= 0 && id <= PLAYER) return sim_life_stage(id);
+    { const FamilyMember *m = family_find(id); return m ? m->stage : LIFE_ADULT; }
+}
+static int adult_(int id) { return LIFE_IS_ADULT(stage_(id)); }
+/* BABY < TODDLER < CHILD < TEEN < ADULT < ELDER */
+static int rank_(int stage)
+{
+    static const uint8_t r[LIFE_COUNT] = { 4, 0, 1, 2, 3, 5 };
+    return stage >= 0 && stage < LIFE_COUNT ? r[stage] : 4;
+}
+
+static int hh_valid_(int h) { return h >= 0 && h <= nrec_; }
+
+int household_count(void) { return 1 + nrec_; }
+
+int household_size(int h)
+{
+    if (h == 0) return 1 + family_count();
+    return hh_valid_(h) ? rec_[h - 1].n : 0;
+}
+
+int household_cap(int h)
+{
+    if (h == 0) return 1 + family_cap();
+    return hh_valid_(h) ? HH_MEMBERS_MAX : 0;
+}
+
+int household_member(int h, int i)
+{
+    if (!hh_valid_(h) || i < 0 || i >= household_size(h)) return -1;
+    if (h == 0) return i == 0 ? PLAYER : family_member(i - 1);
+    return rec_[h - 1].member[i];
+}
+
+int household_head(int h) { return household_member(h, 0); }
+
+/* position of id in household h, -1 if not a member */
+static int pos_(int h, int id)
+{
+    int i, n;
+    if (h == 0) {
+        if (id == PLAYER) return 0;
+        n = family_count();
+        for (i = 0; i < n; i++) if (family_member(i) == id) return i + 1;
+        return -1;
+    }
+    if (!hh_valid_(h)) return -1;
+    for (i = 0; i < rec_[h - 1].n; i++) if (rec_[h - 1].member[i] == id) return i;
+    return -1;
+}
+
+int household_of(int id)
+{
+    int i;
+    if (id < 0) return -1;
+    if (id == PLAYER || family_find(id)) return 0;
+    for (i = 0; i < nrec_; i++) if (pos_(i + 1, id) >= 0) return i + 1;
+    return -1;
+}
+
+/* ---- relation rows (by id) ---------------------------------------------------------- */
+static int row_n_(int h) { return h == 0 ? nh0_ : rec_[h - 1].nrel; }
+
+static void row_get_(int h, int i, int *a, int *b, int *rel)
+{
+    if (h == 0) { *a = h0a_[i]; *b = h0b_[i]; *rel = h0r_[i]; return; }
+    { const HouseRec *r = &rec_[h - 1];
+      *a = r->member[r->rel[i].a]; *b = r->member[r->rel[i].b]; *rel = r->rel[i].rel; }
+}
+
+static void row_del_(int h, int i)
+{
+    if (h == 0) {
+        memmove(&h0a_[i], &h0a_[i + 1], (size_t)(nh0_ - i - 1) * sizeof(h0a_[0]));
+        memmove(&h0b_[i], &h0b_[i + 1], (size_t)(nh0_ - i - 1) * sizeof(h0b_[0]));
+        memmove(&h0r_[i], &h0r_[i + 1], (size_t)(nh0_ - i - 1));
+        nh0_--;
+    } else {
+        HouseRec *r = &rec_[h - 1];
+        memmove(&r->rel[i], &r->rel[i + 1], (size_t)(r->nrel - i - 1) * sizeof(r->rel[0]));
+        r->nrel--;
+    }
+}
+
+/* the row of the pair (either order): its index, *flip = 1 when stored as (b, a); -1 if none */
+static int row_find_(int h, int a, int b, int *flip)
+{
+    int i, x, y, rel;
+    for (i = 0; i < row_n_(h); i++) {
+        row_get_(h, i, &x, &y, &rel);
+        if (x == a && y == b) { *flip = 0; return i; }
+        if (x == b && y == a) { *flip = 1; return i; }
+    }
+    return -1;
+}
+
+/* store "a is b's rel" (replacing the pair's row); both must be members. 0, or -1 when the list is full */
+static int row_put_(int h, int a, int b, int rel)
+{
+    int i, flip;
+    if ((i = row_find_(h, a, b, &flip)) >= 0) row_del_(h, i);
+    if (row_n_(h) >= HH_RELS_MAX) return -1;
+    if (h == 0) {
+        h0a_[nh0_] = (uint16_t)a; h0b_[nh0_] = (uint16_t)b; h0r_[nh0_] = (uint8_t)rel; nh0_++;
+    } else {
+        HouseRec *r = &rec_[h - 1];
+        r->rel[r->nrel].a = (uint8_t)pos_(h, a);
+        r->rel[r->nrel].b = (uint8_t)pos_(h, b);
+        r->rel[r->nrel].rel = (uint8_t)rel;
+        r->nrel++;
+    }
+    return 0;
+}
+
+/* household 0 only: what the old FamilyMember.role says about a pair that includes the player */
+static int derive_(int a, int b)
+{
+    int m, r;
+    if (a == PLAYER) m = b; else if (b == PLAYER) m = a; else return HREL_NONE;
+    switch (family_role(m)) {          /* "m is the player's ..." */
+    case FAMROLE_PARTNER: r = HREL_PARTNER; break;
+    case FAMROLE_CHILD: r = HREL_CHILD; break;
+    case FAMROLE_PARENT: r = HREL_PARENT; break;
+    case FAMROLE_SIBLING: r = HREL_SIBLING; break;
+    case FAMROLE_GRANDPARENT: r = HREL_GRANDPARENT; break;
+    case FAMROLE_HOUSEMATE: r = HREL_ROOMMATE; break;
+    case FAMROLE_PET: r = HREL_PET; break;
+    default: return HREL_NONE;
+    }
+    return a == m ? r : household_rel_reverse(r);
+}
+
+/* the relation of a to b: the stored row, else (household 0) the derived one */
+static int direct_(int h, int a, int b)
+{
+    int i, flip, x, y, rel;
+    if ((i = row_find_(h, a, b, &flip)) >= 0) {
+        row_get_(h, i, &x, &y, &rel);
+        return flip ? household_rel_reverse(rel) : rel;
+    }
+    return h == 0 ? derive_(a, b) : HREL_NONE;
+}
+
+int household_rel(int h, int a, int b)
+{
+    if (!hh_valid_(h) || a == b || pos_(h, a) < 0 || pos_(h, b) < 0) return -1;
+    return direct_(h, a, b);
+}
+
+int household_rel_count(int h) { return hh_valid_(h) ? row_n_(h) : 0; }
+
+/* ---- the rulebook ------------------------------------------------------------------- */
+#define IS_KIN_REL(r)  ((r) >= HREL_PARENT && (r) <= HREL_COUSIN)
+#define IS_COUPLE(r)   ((r) == HREL_SPOUSE || (r) == HREL_PARTNER || (r) == HREL_FIANCE)
+#define IS_PARENTISH(r) ((r) == HREL_PARENT || (r) == HREL_STEPPARENT)
+
+/* the explicit rows of a pet: it has one: its owner's */
+static int is_pet_(int h, int id)
+{
+    int i, x, y, rel;
+    if (h == 0 && id != PLAYER && family_role(id) == FAMROLE_PET) return 1;
+    for (i = 0; i < row_n_(h); i++) {
+        row_get_(h, i, &x, &y, &rel);
+        if ((y == id && rel == HREL_PET_OWNER) || (x == id && rel == HREL_PET)) return 1;
+    }
+    return 0;
+}
+
+/* how many relations id has with anyone but `skip` (rows and the old roles) */
+static int other_rels_(int h, int id, int skip)
+{
+    int i, n = household_size(h), c = 0, m;
+    for (i = 0; i < n; i++) {
+        m = household_member(h, i);
+        if (m != id && m != skip && direct_(h, id, m) != HREL_NONE) c++;
+    }
+    return c;
+}
+
+/* does `id` have a spouse / partner / fiance other than `other`? */
+static int couple_tie_(int h, int id, int other)
+{
+    int i, n = household_size(h), m;
+    for (i = 0; i < n; i++) {
+        m = household_member(h, i);
+        if (m != id && m != other && IS_COUPLE(direct_(h, id, m))) return 1;
+    }
+    return 0;
+}
+
+/* Is `anc` an ancestor of `desc` through parent / step-parent links (the link between skip_a and
+ * skip_b not counted)? A closure over the members: at most 21 of them, never recursion. */
+static int ancestor_(int h, int anc, int desc, int skip_a, int skip_b)
+{
+    uint32_t reach;
+    int n = household_size(h), i, j, round, pd = pos_(h, desc), pa = pos_(h, anc);
+    if (pd < 0 || pa < 0 || anc == desc) return 0;
+    reach = 1u << pd;
+    for (round = 0; round < HH_MEMBERS_MAX; round++) {
+        uint32_t add = 0;
+        for (i = 0; i < n; i++) {
+            int x;
+            if ((reach >> i) & 1u) continue;
+            x = household_member(h, i);
+            for (j = 0; j < n; j++) {
+                int y;
+                if (!((reach >> j) & 1u)) continue;
+                y = household_member(h, j);
+                if ((x == skip_a && y == skip_b) || (x == skip_b && y == skip_a)) continue;
+                if (IS_PARENTISH(direct_(h, x, y))) { add |= 1u << i; break; }
+            }
+        }
+        if (!add) break;
+        reach |= add;
+    }
+    return (int)((reach >> pa) & 1u);
+}
+
+/* kin: a stated family relation, an ancestor either way, or a shared parent */
+static int kin_(int h, int a, int b)
+{
+    int i, n = household_size(h), x;
+    if (IS_KIN_REL(direct_(h, a, b))) return 1;
+    if (ancestor_(h, a, b, -1, -1) || ancestor_(h, b, a, -1, -1)) return 1;
+    for (i = 0; i < n; i++) {
+        x = household_member(h, i);
+        if (x != a && x != b && IS_PARENTISH(direct_(h, x, a)) && IS_PARENTISH(direct_(h, x, b))) return 1;
+    }
+    return 0;
+}
+
+/* a premade citizen on the kid-coded cast (a custom citizen in that slot is somebody else) */
+static int kid_coded_(int id)
+{
+    const DoomoResident *r;
+    if (id < 0 || id >= DOOMO_MAX_RESIDENTS || !ending_kid_cast(id)) return 0;
+    r = town_res(id);
+    return r && !(r->flags & RF_CUSTOM) && strncmp(roster_name(id), r->name, DOOMO_NAME_LEN) == 0;
+}
+
+/* may a and b be a couple at all as people: stages, the kid-cast list and (when asked) the sim's rule.
+ * Reads only: mature_adult_ok and the kid-cast list stay the ending module's. */
+static int couple_people_(int a, int b, int orient)
+{
+    if (!adult_(a) || !adult_(b)) return HHR_ADULTS_ONLY;
+    if (kid_coded_(a) || kid_coded_(b)) return HHR_ADULTS_ONLY;
+    if (orient && !is_pool_(a) && !is_pool_(b) &&
+        !(playas_romance_ok(a, b) && playas_romance_ok(b, a)))
+        return HHR_ROMANCE;
+    return 0;
+}
+
+/* orient = 0 skips the sim's orientation rule (a saved pair was legal when chosen) */
+static int check_(int h, int a, int b, int rel, int orient)
+{
+    int c;
+    if (!hh_valid_(h)) return HHR_BAD_HOUSEHOLD;
+    if (rel < 0 || rel >= HREL_COUNT) return HHR_BAD_REL;
+    if (a == b) return HHR_SELF;
+    if (pos_(h, a) < 0 || pos_(h, b) < 0) return HHR_NOT_MEMBER;
+    if (rel == HREL_NONE) return 0;
+    if (rel == HREL_PET) { c = a; a = b; b = c; rel = HREL_PET_OWNER; }     /* a owns b */
+    if (rel == HREL_PET_OWNER) {
+        if (is_pet_(h, a)) return HHR_PET_OWNER;
+        if (b == PLAYER || other_rels_(h, b, a) > 0) return HHR_PET_OTHER;
+        return 0;
+    }
+    if (is_pet_(h, a) || is_pet_(h, b)) return HHR_PET_OTHER;
+    if (rel == HREL_CHILD || rel == HREL_STEPCHILD || rel == HREL_GRANDCHILD || rel == HREL_NIECE_NEPHEW) {
+        c = a; a = b; b = c; rel = household_rel_reverse(rel);            /* now a is the older side */
+    }
+    switch (rel) {
+    case HREL_PARENT: case HREL_STEPPARENT: case HREL_GRANDPARENT: case HREL_AUNT_UNCLE:
+        if (!adult_(a)) return HHR_PARENT_ADULT;
+        if (rank_(stage_(a)) <= rank_(stage_(b))) return HHR_PARENT_OLDER;
+        if (rel != HREL_AUNT_UNCLE) {
+            if (ancestor_(h, b, a, a, b)) return HHR_CYCLE;
+            if (IS_PARENTISH(rel) && ancestor_(h, a, b, a, b)) return HHR_GENERATION;
+        }
+        return 0;
+    case HREL_SPOUSE: case HREL_PARTNER: case HREL_FIANCE:
+        if ((c = couple_people_(a, b, orient)) != 0) return c;
+        if (kin_(h, a, b)) return HHR_KIN;
+        if (couple_tie_(h, a, b) || couple_tie_(h, b, a)) return HHR_ONE_AT_A_TIME;
+        return 0;
+    case HREL_ROOMMATE:
+        return adult_(a) != adult_(b) ? HHR_MINOR_ROOMMATE : 0;
+    default:                                    /* sibling, step-sibling, cousin: no age rule */
+        return 0;
+    }
+}
+
+int household_rel_check(int h, int a, int b, int rel) { return check_(h, a, b, rel, 1); }
+
+int household_crush_check(int a, int b)
+{
+    if (a == b) return HHR_SELF;
+    if (!(a == PLAYER || res_ok_(a)) || !(b == PLAYER || res_ok_(b))) return HHR_BAD_ID;
+    return couple_people_(a, b, 1);
+}
+
+/* ---- room in the save file ------------------------------------------------------------- */
+static int room_(uint32_t extra)
+{
+    return save_budget_fits(doomo_town.mode == TOWN_STORY ? 0 : 1, extra);
+}
+
+/* ---- household 0's old role for a relation to the player ------------------------------------ */
+/* the old role for "the member is the player's rel", FAMROLE_NONE when none says it */
+static int role_of_rel_(int rel)
+{
+    switch (rel) {
+    case HREL_SPOUSE: case HREL_PARTNER: case HREL_FIANCE: return FAMROLE_PARTNER;
+    case HREL_CHILD: return FAMROLE_CHILD;
+    case HREL_PARENT: return FAMROLE_PARENT;
+    case HREL_SIBLING: return FAMROLE_SIBLING;
+    case HREL_GRANDPARENT: return FAMROLE_GRANDPARENT;
+    case HREL_ROOMMATE: return FAMROLE_HOUSEMATE;
+    case HREL_PET: return FAMROLE_PET;
+    default: return FAMROLE_NONE;               /* no old role says it: the row does */
+    }
+}
+
+static int famerr_(int e, int role, int stage)
+{
+    switch (e) {
+    case FAM_ERR_FULL: return HHR_FULL;
+    case FAM_ERR_DUP: return HHR_DUP;
+    case FAM_ERR_ID: return HHR_BAD_ID;
+    case FAM_ERR_ROLE: return role == FAMROLE_PARTNER ? HHR_ONE_AT_A_TIME : HHR_FAMILY;
+    case FAM_ERR_GATE: return LIFE_IS_ADULT(stage) ? HHR_ROMANCE : HHR_ADULTS_ONLY;
+    default: return HHR_FAMILY;
+    }
+}
+
+static int stage_for_rel_(int rel)
+{
+    return rel == HREL_CHILD || rel == HREL_STEPCHILD || rel == HREL_GRANDCHILD ||
+           rel == HREL_NIECE_NEPHEW ? LIFE_CHILD : LIFE_ADULT;
+}
+
+/* ---- households ---------------------------------------------------------------------------- */
+int household_create(int head)
+{
+    HouseRec *r;
+    if (!res_ok_(head)) return HH_ERR(is_pool_(head) ? HHR_POOL : HHR_BAD_ID);
+    if (household_of(head) >= 0) return HH_ERR(HHR_DUP);
+    if (nrec_ >= HH_MAX_RECS || !room_(HH_REC_HEAD + 3u)) return HH_ERR(HHR_NO_ROOM);
+    r = &rec_[nrec_];
+    memset(r, 0, sizeof(*r));
+    r->n = 1;
+    r->member[0] = (uint16_t)head;
+    return ++nrec_;
+}
+
+static int add0_(int id, int rel)
+{
+    int role = role_of_rel_(rel), stage = stage_for_rel_(rel), slot, c;
+    if (role == FAMROLE_NONE) role = FAMROLE_HOUSEMATE;
+    if (id < DOOMO_MAX_RESIDENTS ? !res_ok_(id) : !is_pool_(id)) return HH_ERR(HHR_BAD_ID);
+    if (household_of(id) >= 0) return HH_ERR(HHR_DUP);
+    if (household_size(0) >= household_cap(0)) return HH_ERR(HHR_FULL);
+    if (id < DOOMO_MAX_RESIDENTS) stage = sim_life_stage(id);
+    if (IS_COUPLE(rel)) {                          /* say "adults only" before "one at a time" */
+        c = id < DOOMO_MAX_RESIDENTS ? couple_people_(id, PLAYER, 1) : !LIFE_IS_ADULT(stage) ? HHR_ADULTS_ONLY : 0;
+        if (c) return HH_ERR(c);
+    }
+    if ((slot = family_add(id, role, stage)) < 0) return HH_ERR(famerr_(slot, role, stage));
+    if (rel != HREL_NONE) {
+        if ((c = check_(0, id, PLAYER, rel, 1)) != 0) { family_remove(id); return HH_ERR(c); }
+        if (direct_(0, id, PLAYER) != rel && (!room_(5u) || row_put_(0, id, PLAYER, rel) < 0)) {
+            family_remove(id);
+            return HH_ERR(HHR_NO_ROOM);
+        }
+    }
+    return slot + 1;
+}
+
+int household_add(int h, int id, int rel)
+{
+    HouseRec *r;
+    int p, c;
+    if (!hh_valid_(h)) return HH_ERR(HHR_BAD_HOUSEHOLD);
+    if (rel < 0 || rel >= HREL_COUNT) return HH_ERR(HHR_BAD_REL);
+    if (id == PLAYER) return HH_ERR(HHR_HEAD);
+    if (h == 0) return add0_(id, rel);
+    if (is_pool_(id)) return HH_ERR(HHR_POOL);
+    if (!res_ok_(id)) return HH_ERR(HHR_BAD_ID);
+    if (household_of(id) >= 0) return HH_ERR(HHR_DUP);
+    r = &rec_[h - 1];
+    if (r->n >= HH_MEMBERS_MAX) return HH_ERR(HHR_FULL);
+    if (!room_(2u + 3u)) return HH_ERR(HHR_NO_ROOM);
+    p = r->n;
+    r->member[p] = (uint16_t)id;
+    r->n++;
+    if (rel != HREL_NONE) {
+        if ((c = check_(h, id, r->member[0], rel, 1)) != 0) { r->n--; return HH_ERR(c); }
+        if (row_put_(h, id, r->member[0], rel) < 0) { r->n--; return HH_ERR(HHR_NO_ROOM); }
+    }
+    return p;
+}
+
+/* take position p out of record h (rows with them go, later slots close up); 1 if that dissolved it */
+static int rec_drop_(int h, int p)
+{
+    HouseRec *r = &rec_[h - 1];
+    int i, k = 0;
+    for (i = 0; i < r->nrel; i++) {
+        HouseRel x = r->rel[i];
+        if (x.a == p || x.b == p) continue;
+        if (x.a > p) x.a--;
+        if (x.b > p) x.b--;
+        r->rel[k++] = x;
+    }
+    r->nrel = (uint8_t)k;
+    memmove(&r->member[p], &r->member[p + 1], (size_t)(r->n - p - 1) * sizeof(r->member[0]));
+    r->n--;
+    if (r->n >= 2) return 0;
+    memmove(r, r + 1, (size_t)(nrec_ - h) * sizeof(*r));
+    nrec_--;
+    memset(&rec_[nrec_], 0, sizeof(rec_[0]));
+    return 1;
+}
+
+int household_remove(int id)
+{
+    int h = household_of(id), p;
+    if (id == PLAYER) return HH_ERR(HHR_HEAD);
+    if (h < 0) return HH_ERR(HHR_NOT_MEMBER);
+    if (h == 0) return family_remove(id) ? 0 : HH_ERR(HHR_NOT_MEMBER);
+    p = pos_(h, id);
+    return rec_drop_(h, p);
+}
+
+int household_move(int id, int to)
+{
+    int from, head_to = -1, c;
+    if (!hh_valid_(to)) return HH_ERR(HHR_BAD_HOUSEHOLD);
+    if (id == PLAYER) return HH_ERR(HHR_HEAD);
+    if (is_pool_(id)) return HH_ERR(HHR_POOL);
+    if (!res_ok_(id)) return HH_ERR(HHR_BAD_ID);
+    from = household_of(id);
+    if (from == to) return 0;
+    if (household_size(to) >= household_cap(to)) return HH_ERR(HHR_FULL);
+    if (to > 0) head_to = rec_[to - 1].member[0];
+    if (from >= 0 && (c = household_remove(id)) < 0) return c;
+    if (to > 0) to = household_of(head_to);                  /* the old household may have been dissolved */
+    return household_add(to, id, HREL_NONE) < 0 ? HH_ERR(HHR_NO_ROOM) : 0;
+}
+
+int household_set_head(int h, int id)
+{
+    HouseRec *r;
+    int p, i, t;
+    if (h == 0) return HH_ERR(HHR_HEAD);
+    if (!hh_valid_(h)) return HH_ERR(HHR_BAD_HOUSEHOLD);
+    if ((p = pos_(h, id)) < 0) return HH_ERR(HHR_NOT_MEMBER);
+    if (p == 0) return 0;
+    r = &rec_[h - 1];
+    t = r->member[0]; r->member[0] = r->member[p]; r->member[p] = (uint16_t)t;
+    for (i = 0; i < r->nrel; i++) {
+        if (r->rel[i].a == 0) r->rel[i].a = (uint8_t)p; else if (r->rel[i].a == p) r->rel[i].a = 0;
+        if (r->rel[i].b == 0) r->rel[i].b = (uint8_t)p; else if (r->rel[i].b == p) r->rel[i].b = 0;
+    }
+    return 0;
+}
+
+int household_reorder(int h, int from, int to)
+{
+    HouseRec *r;
+    uint8_t perm[HH_MEMBERS_MAX];
+    uint16_t keep;
+    int i, n;
+    if (!hh_valid_(h)) return HH_ERR(HHR_BAD_HOUSEHOLD);
+    n = household_size(h);
+    if (from < 1 || to < 1 || from >= n || to >= n) return HH_ERR(HHR_BAD_ID);
+    if (from == to) return 0;
+    if (h == 0) return family_slot_move(from - 1, to - 1) ? 0 : HH_ERR(HHR_BAD_ID);
+    r = &rec_[h - 1];
+    for (i = 0; i < n; i++) perm[i] = (uint8_t)i;                      /* old slot -> new slot */
+    keep = r->member[from];
+    if (from < to) {
+        for (i = from; i < to; i++) { r->member[i] = r->member[i + 1]; perm[i + 1] = (uint8_t)i; }
+    } else {
+        for (i = from; i > to; i--) { r->member[i] = r->member[i - 1]; perm[i - 1] = (uint8_t)i; }
+    }
+    r->member[to] = keep;
+    perm[from] = (uint8_t)to;
+    for (i = 0; i < r->nrel; i++) { r->rel[i].a = perm[r->rel[i].a]; r->rel[i].b = perm[r->rel[i].b]; }
+    return 0;
+}
+
+int household_rel_set(int h, int a, int b, int rel)
+{
+    int c, i, flip;
+    if ((c = check_(h, a, b, rel, 1)) != 0) return HH_ERR(c);
+    if (rel == HREL_NONE) {
+        if ((i = row_find_(h, a, b, &flip)) >= 0) row_del_(h, i);
+        return 0;
+    }
+    if (h == 0 && (a == PLAYER || b == PLAYER)) {            /* the old role follows the player's pair */
+        int m = a == PLAYER ? b : a, role = role_of_rel_(a == m ? rel : household_rel_reverse(rel));
+        if (role != FAMROLE_NONE && family_role(m) != role && family_role(m) != FAMROLE_PET && role != FAMROLE_PET &&
+            (c = family_set_role(m, role)) < 0)
+            return HH_ERR(famerr_(c, role, stage_(m)));
+        if (derive_(a, b) == rel) {                           /* what the role already says: no row */
+            if ((i = row_find_(h, a, b, &flip)) >= 0) row_del_(h, i);
+            return 0;
+        }
+    }
+    if (row_find_(h, a, b, &flip) < 0 && !room_(h == 0 ? 5u : 3u)) return HH_ERR(HHR_NO_ROOM);
+    return row_put_(h, a, b, rel) < 0 ? HH_ERR(HHR_NO_ROOM) : 0;
+}
+
+/* ---- upkeep ---------------------------------------------------------------------------------- */
+void household_forget(int id)
+{
+    int i;
+    for (i = nh0_ - 1; i >= 0; i--)
+        if (h0a_[i] == id || h0b_[i] == id) row_del_(0, i);
+}
+
+int household_sweep(void)
+{
+    int h, p, i, gone = 0;
+    for (h = nrec_; h >= 1; h--) {
+        if (h > nrec_) continue;
+        for (p = rec_[h - 1].n - 1; p >= 0; p--)
+            if (!res_ok_(rec_[h - 1].member[p])) { gone++; if (rec_drop_(h, p)) break; }
+    }
+    for (i = nh0_ - 1; i >= 0; i--)
+        if (pos_(0, h0a_[i]) < 0 || pos_(0, h0b_[i]) < 0) row_del_(0, i);
+    return gone;
+}
+
+void household_clear(void)
+{
+    memset(rec_, 0, sizeof(rec_));
+    nrec_ = 0;
+    memset(h0a_, 0, sizeof(h0a_));
+    memset(h0b_, 0, sizeof(h0b_));
+    memset(h0r_, 0, sizeof(h0r_));
+    nh0_ = 0;
+}
+
+/* ---- a new person --------------------------------------------------------------------------------- */
+/* is this a story, hero or premade-roster citizen (never asked to leave)? */
+static int protected_(int id)
+{
+    const DoomoResident *r = town_res(id);
+    DoomoResident p;
+    int i;
+    if (!r || (r->flags & (RF_PLAYER | RF_STORY_NPC)) || id == playas_avatar()) return 1;
+    for (i = 0; i < NPC_COUNT; i++) if (doomo_story_npc[i] == id) return 1;
+    if (!(r->flags & RF_CUSTOM) && roster_premade_record(id, &p) &&
+        memcmp(p.name, r->name, DOOMO_NAME_LEN) == 0)
+        return 1;
+    return 0;
+}
+
+/* the adult in no household with the lowest friendship level who may move away, or -1 */
+static int leaver_(void)
+{
+    int id, best = -1, lv = 256;
+    for (id = 0; id < DOOMO_MAX_RESIDENTS; id++) {
+        const DoomoResident *r = town_res(id);
+        if (!r || r->status != RES_ALIVE || r->level >= lv) continue;
+        if (household_of(id) >= 0 || !adult_(id) || protected_(id) || sim_partner_of(id) >= 0) continue;
+        best = id;
+        lv = r->level;
+    }
+    return best;
+}
+
+int household_new_person(int h, int rel)
+{
+    DoomoResident r;
+    int id, d, head, stage, c;
+    if (!hh_valid_(h)) return HH_ERR(HHR_BAD_HOUSEHOLD);
+    if (rel < 0 || rel >= HREL_COUNT || rel == HREL_PET) return HH_ERR(HHR_BAD_REL);
+    if (household_size(h) >= household_cap(h)) return HH_ERR(HHR_FULL);
+    if (!room_(8u)) return HH_ERR(HHR_NO_ROOM);
+    head = household_head(h);
+    /* the stage the relation suggests, and a first look at the rules before anybody has to leave */
+    stage = stage_for_rel_(rel);
+    if (rel == HREL_PARENT || rel == HREL_STEPPARENT || rel == HREL_GRANDPARENT || rel == HREL_AUNT_UNCLE)
+        stage = LIFE_ELDER;
+    else if (rel == HREL_ROOMMATE && !adult_(head)) stage = stage_(head);
+    else if (!adult_(head) && !IS_COUPLE(rel) && stage == LIFE_ADULT) stage = stage_(head);
+    if ((rel == HREL_PARENT || rel == HREL_STEPPARENT || rel == HREL_GRANDPARENT || rel == HREL_AUNT_UNCLE) &&
+        rank_(stage_(head)) >= rank_(LIFE_ELDER))
+        return HH_ERR(HHR_PARENT_OLDER);                   /* nobody is older than an elder */
+    if (stage_for_rel_(rel) != LIFE_ADULT && !adult_(head)) return HH_ERR(HHR_PARENT_ADULT);   /* a minor has no children */
+    if (IS_COUPLE(rel)) {
+        if (!adult_(head)) return HH_ERR(HHR_ADULTS_ONLY);
+        if (household_size(h) > 1 && couple_tie_(h, head, -1)) return HH_ERR(HHR_ONE_AT_A_TIME);
+    }
+    d = head < DOOMO_MAX_RESIDENTS ? RES_DISTRICT(head) : 0;
+    id = town_alloc(d);
+    if (id < 0) id = town_alloc(!d);
+    if (id < 0) {
+        char msg[48];
+        if ((id = leaver_()) < 0) return HH_ERR(HHR_NO_SPOT);
+        d = RES_DISTRICT(id);
+        doomo_snprintf(msg, sizeof(msg), "%s moved away to make room", town_res(id)->name);
+        town_free(id);
+        sim_news_push(msg);
+        if ((id = town_alloc(d)) < 0) return HH_ERR(HHR_NO_SPOT);
+    }
+    {
+        uint32_t seed = doomo_hash32(doomo_town.seed ^ ((uint32_t)id * 0x9E3779B1u) ^ (doomo_town.day * 7919u) ^
+                                     ((uint32_t)h << 20) ^ 0x4B1D5EEDu);
+        if (RES_DISTRICT(id)) resident_generate_hellborn(&r, seed); else resident_generate(&r, seed);
+    }
+    resident_set_stage(&r, stage);
+    resident_set_romance(&r, !LIFE_IS_ADULT(stage) ? ROMANCE_NONE : IS_COUPLE(rel) ? ROMANCE_ANY : (int)RES_ROMANCE(&r));
+    part_age_filter_resident(&r, -1);
+    r.status = RES_ALIVE;
+    r.flags = (uint8_t)((r.flags & (RF_HELLBORN | RF_FAVORITE)) | RF_CUSTOM);
+    r.exorcism = 0;
+    r.level = 0;
+    resident_sanitize(&r);
+    *TOWN_RES(id) = r;
+    portrait_invalidate(id);
+    if ((c = household_add(h, id, rel)) < 0) { town_free(id); return c; }
+    return id;
+}
+
+/* ---- the 'HOUS' chunk -------------------------------------------------------------------------------- */
+static void put16_(uint8_t *d, uint32_t v) { d[0] = (uint8_t)v; d[1] = (uint8_t)(v >> 8); }
+static uint32_t get16_(const uint8_t *s) { return (uint32_t)(s[0] | (s[1] << 8)); }
+
+static int saved_(const HouseRec *r) { return r->n >= 2; }          /* a lone household is not saved */
+
+uint32_t household_save_size(void)
+{
+    uint32_t sz = 0;
+    int i, recs = 0;
+    for (i = 0; i < nrec_; i++)
+        if (saved_(&rec_[i])) { recs++; sz += HH_REC_HEAD + 2u * rec_[i].n + 1u + 3u * rec_[i].nrel; }
+    if (nh0_) { recs++; sz += HH_REC_HEAD + 1u + 5u * nh0_; }
+    return recs ? 1u + sz : 0;
+}
+
+uint32_t household_save(uint8_t *dst, uint32_t cap)
+{
+    uint32_t o = 1;
+    int i, j, recs = 0;
+    if (!household_save_size() || cap < household_save_size()) return 0;
+    if (nh0_) {
+        put16_(dst + o, 0xFFFFu); dst[o + 2] = 0; dst[o + 3] = 0; dst[o + 4] = nh0_; o += 5;
+        for (i = 0; i < nh0_; i++) {
+            put16_(dst + o, h0a_[i]); put16_(dst + o + 2, h0b_[i]); dst[o + 4] = h0r_[i]; o += 5;
+        }
+        recs++;
+    }
+    for (i = 0; i < nrec_; i++) {
+        const HouseRec *r = &rec_[i];
+        if (!saved_(r)) continue;
+        put16_(dst + o, r->member[0]); dst[o + 2] = r->n; dst[o + 3] = r->flags; o += HH_REC_HEAD;
+        for (j = 0; j < r->n; j++) { put16_(dst + o, r->member[j]); o += 2; }
+        dst[o++] = r->nrel;
+        for (j = 0; j < r->nrel; j++) {
+            dst[o] = r->rel[j].a; dst[o + 1] = r->rel[j].b; dst[o + 2] = r->rel[j].rel; o += 3;
+        }
+        recs++;
+    }
+    dst[0] = (uint8_t)recs;
+    return o;
+}
+
+/* is id already somebody's (household 0's table or a record built so far)? */
+static int taken_(int id) { return household_of(id) >= 0; }
+
+/* One record from the file. Whatever cannot be right is dropped, never trusted: a person who does not
+ * exist (or is dead), is in the player's household or an earlier record, or is named twice stays only in the
+ * first place; a row whose people are gone, that names itself, repeats a pair or breaks a rule is dropped;
+ * a record left with fewer than two people dissolves. Returns the bytes used, 0 on a framing error. */
+static uint32_t read_rec_(const uint8_t *s, uint32_t len)
+{
+    uint32_t o = HH_REC_HEAD;
+    uint8_t map[HH_MEMBERS_MAX];
+    HouseRec *r;
+    int n, i, nr, kept = 0, h;
+    if (len < HH_REC_HEAD) return 0;
+    n = s[2];
+    if (n < 1 || n > HH_MEMBERS_MAX || len < o + 2u * (uint32_t)n + 1u) return 0;
+    nr = s[o + 2u * (uint32_t)n];
+    if (nr > HH_RELS_MAX || len < o + 2u * (uint32_t)n + 1u + 3u * (uint32_t)nr) return 0;
+    if (nrec_ >= HH_MAX_RECS) return o + 2u * (uint32_t)n + 1u + 3u * (uint32_t)nr;      /* more than this build keeps */
+    r = &rec_[nrec_];
+    memset(r, 0, sizeof(*r));
+    r->flags = s[3];
+    nrec_++;                                       /* installed while it is built, so taken_() sees it */
+    for (i = 0; i < n; i++) {
+        int id = (int)get16_(s + o + 2u * (uint32_t)i);
+        map[i] = 0xFF;
+        if (!res_ok_(id) || taken_(id)) continue;
+        map[i] = (uint8_t)kept;
+        r->member[kept++] = (uint16_t)id;
+        r->n = (uint8_t)kept;
+    }
+    h = nrec_;
+    o += 2u * (uint32_t)n + 1u;
+    if (kept < 2) {
+        nrec_--;
+        memset(r, 0, sizeof(*r));
+        return o + 3u * (uint32_t)nr;
+    }
+    for (i = 0; i < nr; i++, o += 3) {
+        int sa = s[o], sb = s[o + 1], rel = s[o + 2];
+        if (sa >= n || sb >= n || map[sa] == 0xFF || map[sb] == 0xFF || rel <= HREL_NONE || rel >= HREL_COUNT)
+            continue;
+        if (check_(h, r->member[map[sa]], r->member[map[sb]], rel, 0) != 0) continue;
+        row_put_(h, r->member[map[sa]], r->member[map[sb]], rel);
+    }
+    return o;
+}
+
+int household_load(const uint8_t *src, uint32_t len)
+{
+    uint32_t o = 1;
+    int cnt, k;
+    household_clear();
+    if (len < 1) return 0;
+    cnt = src[0];
+    if (cnt < 1 || cnt > 1 + HH_MAX_RECS) return 0;
+    for (k = 0; k < cnt; k++) {
+        uint32_t used;
+        if (len - o >= HH_REC_HEAD && get16_(src + o) == 0xFFFFu) {         /* household 0's rows: first only */
+            uint16_t ra[HH_RELS_MAX], rb[HH_RELS_MAX];
+            uint8_t rr[HH_RELS_MAX];
+            int nr, i;
+            if (k != 0 || src[o + 2] != 0 || len - o < HH_REC_HEAD + 1u) goto bad;
+            nr = src[o + HH_REC_HEAD];
+            if (nr > HH_RELS_MAX || len - o < HH_REC_HEAD + 1u + 5u * (uint32_t)nr) goto bad;
+            for (i = 0; i < nr; i++) {
+                const uint8_t *p = src + o + HH_REC_HEAD + 1u + 5u * (uint32_t)i;
+                ra[i] = (uint16_t)get16_(p); rb[i] = (uint16_t)get16_(p + 2); rr[i] = p[4];
+            }
+            for (i = 0; i < nr; i++) {
+                if (rr[i] <= HREL_NONE || rr[i] >= HREL_COUNT) continue;
+                if (check_(0, ra[i], rb[i], rr[i], 0) != 0) continue;
+                row_put_(0, ra[i], rb[i], rr[i]);
+            }
+            o += HH_REC_HEAD + 1u + 5u * (uint32_t)nr;
+            continue;
+        }
+        if ((used = read_rec_(src + o, len - o)) == 0) goto bad;
+        o += used;
+    }
+    if (o != len) goto bad;
+    return 1;
+bad:
+    household_clear();
+    return 0;
+}
+
+/* ---- the registry entry (save_ext.h; the 15th slot) --------------------------------------------------- */
+static int hous_read_(const uint8_t *s, uint32_t len, uint16_t ver)
+{
+    if (ver != 1) { household_clear(); return 0; }
+    return household_load(s, len);
+}
+
+static const DoomoSaveExt hous_ext = {
+    SAVE_EXT_TAG_HOUS, 1, household_save_size, household_save, hous_read_, household_clear, SAVE_EXT_MAX_HOUS
+};
+const DoomoSaveExt *const doomo_save_ext_households = &hous_ext;
+
+DOOMO_STATIC_ASSERT(HH_SAVE_WORST <= SAVE_EXT_MAX_HOUS, hous_worst_case_fits_the_declared_maximum);
