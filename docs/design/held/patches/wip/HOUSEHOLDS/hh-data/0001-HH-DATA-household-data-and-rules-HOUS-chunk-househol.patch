+/* ---- the rules: parents, roommates, pets ------------------------------------------------------------ */
+TEST(hh_a_parent_is_an_adult_and_older_in_stage_for_every_parent_kind)
+{
+    static const int kinds[4] = { HREL_PARENT, HREL_STEPPARENT, HREL_GRANDPARENT, HREL_AUNT_UNCLE };
+    int k, ad, ad2, eld, teen, kid, h;
+    fresh();
+    ad = mk(LIFE_ADULT); ad2 = mk(LIFE_ADULT); eld = mk(LIFE_ELDER); teen = mk(LIFE_TEEN); kid = mk(LIFE_CHILD);
+    h = household_create(ad);
+    household_add(h, ad2, HREL_NONE); household_add(h, eld, HREL_NONE);
+    household_add(h, teen, HREL_NONE); household_add(h, kid, HREL_NONE);
+    for (k = 0; k < 4; k++) {
+        int r = kinds[k], rv = household_rel_reverse(r);
+        CHECK_EQ(household_rel_check(h, ad, kid, r), 0);                      /* an adult over a child */
+        CHECK_EQ(household_rel_check(h, kid, ad, rv), 0);                     /* the same said from the child */
+        CHECK_EQ(household_rel_check(h, teen, kid, r), HHR_PARENT_ADULT);     /* a teen is no parent */
+        CHECK_EQ(household_rel_check(h, ad, teen, rv), HHR_PARENT_ADULT);     /* "ad is the teen's child" */
+        CHECK_EQ(household_rel_check(h, kid, teen, r), HHR_PARENT_ADULT);
+        CHECK_EQ(household_rel_check(h, ad, ad2, r), HHR_PARENT_OLDER);       /* equal stages */
+        CHECK_EQ(household_rel_check(h, ad2, eld, r), HHR_PARENT_OLDER);      /* the elder is older */
+        CHECK_EQ(household_rel_check(h, eld, ad2, r), 0);
+    }
+}
