+
+/* ---- AI flags (LV6a; plan 8.4) -------------------------------------------------------------
+ * One uint16 per actor (ai_st in actor.c, which also holds the hit flash and the line-of-sight bit, so
+ * the three old byte arrays became one: RAM net zero). The tick tests ONE bit mask; every rule lives
+ * in the ai_* helpers behind it. A level or skin sets them with actor_set_ai().
+ *   FREEZER   while combat_ai_showtime is on it holds still and shots ping off (showtime)
+ *   SPLITTER  its death leaves two half-HP copies that do not split again
+ *   THIEF     a melee hit steals (combat_ai_stolen++) and it runs away for a while
+ *   SLEEPER   idle until combat_ai_noise reaches AI_NOISE_WAKE or it is hurt; sight does not wake it
+ *   STALKER   unkillable, awake from the start, walks straight at its target, never shoots
+ *   FLEE_LIGHT never steps into a cell combat_ai_lit() calls lit
+ *   SWIMMER   in lava: under (cannot be hit) for half of a 120 tick cycle, surfaced for the rest; lava does not hurt it
+ *   ORBITER   circles its target instead of closing in
+ *   POSER     holds its pose: never walks, only turns and attacks when its cooldown is over */
+enum { AIF_FREEZER = 1, AIF_SPLITTER = 2, AIF_THIEF = 4, AIF_SLEEPER = 8, AIF_STALKER = 16,
+       AIF_FLEE_LIGHT = 32, AIF_SWIMMER = 64, AIF_ORBITER = 128, AIF_POSER = 256,
+       AIF_ALL = 511 };
+#define AI_NOISE_WAKE 128
+extern uint8_t combat_ai_showtime;                 /* 1 = the lights are on: freezers freeze        */
+extern uint8_t combat_ai_noise;                    /* 0..255, raised by the noise rule (LV5)         */
+extern uint8_t combat_ai_stolen;                   /* thefts so far this session (LV5 reads it)      */
+extern int (*combat_ai_lit)(int cx, int cy);       /* NULL = no cell is lit                          */
+void actor_set_ai(int idx, unsigned flags);        /* AIF_* (0 clears)                               */
+unsigned actor_ai(int idx);
 
