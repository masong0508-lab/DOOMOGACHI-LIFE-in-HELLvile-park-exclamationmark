+#if FOES_NEW
+/* ---- AI flags (LV6a): the rules behind the one bit test; see combat_int.h --------------------- */
+void actor_set_ai(int idx, unsigned flags)
+{
+    if (idx >= 0 && idx < ACTOR_MAX)
+        ai_st[idx] = (uint16_t)((ai_st[idx] & ~(AIF_ALL | AIS_FLEE)) | (flags & AIF_ALL));
+}
+
+unsigned actor_ai(int idx)
+{
+    return idx >= 0 && idx < ACTOR_MAX ? (unsigned)(ai_st[idx] & AIF_ALL) : 0u;
+}
+
+/* lit-cell rule: a shade never steps from the dark into a lit cell */
+static int ai_step_ok(int idx, fix16 nx, fix16 ny)
+{
+    const DoomoActor *a = &doomo_actors[idx];
+    if (!combat_ai_lit) return 1;
+    return !combat_ai_lit(FIX2INT(nx) / CELLU, FIX2INT(ny) / CELLU) ||
+           combat_ai_lit(FIX2INT(a->x) / CELLU, FIX2INT(a->y) / CELLU);
+}
+
+/* the thief's grab: counts the theft (LV5's repossession reads it) and runs for ~4 s */
+static void ai_thief_grab(int idx)
+{
+    if (combat_ai_stolen < 255) combat_ai_stolen++;
+    ai_st[idx] = (uint16_t)((ai_st[idx] & ~AIS_FLEE) | (5u * AIS_FLEE_ONE));
+}
+
+/* 1 = shots do nothing: the stalker always, the freezer while the lights are on */
+static int ai_immune(int idx)
+{
+    unsigned f = ai_st[idx];
+    return (f & AIF_STALKER) || ((f & AIF_FREEZER) && combat_ai_showtime);
+}
+
+/* sleeper: only noise wakes it; stalker: awake from the start */
+static int ai_wakes(int idx)
+{
+    if (doomo_player.hp <= 0) return 0;
+    if (ai_st[idx] & AIF_STALKER) return 1;
+    return combat_ai_noise >= AI_NOISE_WAKE;
+}
+
+/* splitter: two half-HP copies, they do not split again and keep the kill group */
+static void ai_split(int idx)
+{
+    const DoomoActor *a = &doomo_actors[idx];
+    int k, i;
+    for (k = 0; k < 2; k++) {
+        fix16 off = k ? INT2FIX(12) : -INT2FIX(12);
+        i = actor_spawn_demon(a->type, a->x + off, a->y, 0, a->tflags & THF_KILL_EVENT, a->arg);
+        if (i < 0) return;
+        doomo_actors[i].hp = (int16_t)DOOMO_MAX(DEMON(a->type)->hp / 2, 1);
+        doomo_actors[i].state = AST_CHASE;
+        doomo_actors[i].target = TARGET_PLAYER;
+        doomo_actors[i].z = a->z;
+        ai_st[i] = (uint16_t)((ai_st[i] & ~(AIF_ALL | AIS_FLEE)) | (ai_st[idx] & AIF_ALL & ~AIF_SPLITTER));
+    }
+}
+
+/* Before the attack timers. 1 = the demon does nothing this tick. */
+static int ai_pre(int idx)
+{
+    DoomoActor *a = &doomo_actors[idx];
+    unsigned f = ai_st[idx];
+    if ((f & AIF_FREEZER) && combat_ai_showtime) return 1;             /* held in its pose */
+    if (f & AIS_FLEE) {                                                /* thief: no attacks while running */
+        if (a->cooldown < 3) a->cooldown = 3;
+        if ((a->anim % 24) == 0) ai_st[idx] -= AIS_FLEE_ONE;
+    }
+    if ((f & AIF_SWIMMER) && a->state != AST_PAIN) {
+        const DoomoCell *c = map_cell_safe(&doomo_map, FIX2INT(a->x) / CELLU, FIX2INT(a->y) / CELLU);
+        if ((c->flags & CELL_LAVA) && (a->anim % 120) < 60) {          /* under: cannot be hit, cannot bite */
+            a->flags &= (uint8_t)~AF_SHOOTABLE;
+            if (a->cooldown < 3) a->cooldown = 3;
+        } else {
+            a->flags |= AF_SHOOTABLE;
+        }
+    }
+    return 0;
+}
+
+/* Movement. 0 = leave it to the AI personality, 1 = hold still, 2 = walk `*want` (skips hold-the-line). */
+static int ai_steer(int idx, int ang, fix16 dist, int *want)
+{
+    DoomoActor *a = &doomo_actors[idx];
+    unsigned f = ai_st[idx];
+    if (f & AIS_FLEE) { *want = ang + 2048; return 2; }
+    if (f & AIF_STALKER) { *want = ang; return 2; }
+    if (f & AIF_ORBITER) {
+        if (dist < INT2FIX(3 * CELLU)) *want = ang + a->strafe * 1300;       /* too close: drift out */
+        else if (dist < INT2FIX(6 * CELLU)) *want = ang + a->strafe * 1000;  /* the ring */
+        else *want = ang;                                                    /* close in */
