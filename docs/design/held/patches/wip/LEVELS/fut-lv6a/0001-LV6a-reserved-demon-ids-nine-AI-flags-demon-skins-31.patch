+
+/* A skin is in the Library once its level is on this build and has a rank (cleared at least once). */
+int lvf_skin_known(int skin)
+{
+    int l;
+    if (skin < 0 || skin >= LV_SKIN_N) return 0;
+    l = lv_skin[skin].level;
+    return lv_built(l) && lv_rank(l) != RANK_NONE;
+}
+
+int lvf_skin_known_count(void)
+{
+    int i, n = 0;
+    for (i = 0; i < LV_SKIN_N; i++) n += lvf_skin_known(i);
+    return n;
+}
+
+int lvf_skin_nth_known(int n)
+{
+    int i;
+    for (i = 0; i < LV_SKIN_N; i++)
+        if (lvf_skin_known(i) && n-- == 0) return i;
+    return -1;
+}
+
+/* Dress demon `a` as the skin: its AI flags and the ambush spawn flag. Scale, tint and glow are
+ * billboard dressing done where the view is built (LV7c); the base stats stay the base demon's. */
+void lvf_skin_apply(int a, int skin)
+{
+    const DemonSkin *s;
+    if (skin < 0 || skin >= LV_SKIN_N || a < 0 || a >= ACTOR_MAX) return;
+    s = &lv_skin[skin];
+    if (doomo_actors[a].type != s->base) return;
+    actor_set_ai(a, s->ai);
+    if (s->flags & DSF_AMBUSH) doomo_actors[a].tflags |= THF_AMBUSH;
+}
+
+/* ---- Boss Rush sets ------------------------------------------------------------------------ */
+const RushSet lv_rush_set[RUSHSET_COUNT] = {
+    { "Classic 7", 7,
+      { LB_CELLAR_WRAITH, LB_GUTTERKING, LB_FLUFFNUTS, LB_WIDOW, LB_BONEBOTTOM, LB_GRUMBLEGUTS, LB_VAPULA } },
+    /* the 16 breach bosses: the six old ones, the nine new ones, Lord Vapula last */
+    { "Breach 16", 16,
+      { LB_CELLAR_WRAITH, LB_GUTTERKING, LB_FLUFFNUTS, LB_WIDOW, LB_BONEBOTTOM, LB_GRUMBLEGUTS,
+        LB_BATHROBE, LB_UNHUGGABLE, LB_CAROUSEL, LB_SCREAM, LB_FOREMAN, LB_GARY, LB_LEASEHOLD,
+        LB_NOTARY, LB_SIGH, LB_VAPULA } },
+    /* Arrears: every Notice boss that is a fight (no Duchess first encounter, no chase, no epilogue) */
+    { "Arrears", 12,
+      { LB_OVERSEER, LB_POSTMASTER, LB_TERRY, LB_COMPOUND, LB_LEVIATHAN, LB_AUCTIONEER, LB_WITHHOLD,
+        LB_TRIBUTE, LB_BLANK, LB_FORECLOSER, LB_COLLATERAL, LB_DUCHESS2 } },
+};
+
+/* A set is offered once it has bosses and none of them is a placeholder. */
+int lvf_rush_ready(int set)
+{
+    int i;
+    const RushSet *r;
+    if (set < 0 || set >= RUSHSET_COUNT) return 0;
+    r = &lv_rush_set[set];
+    if (r->n == 0) return 0;
+    for (i = 0; i < r->n; i++)
+        if (r->boss[i] >= LB_COUNT || (lv_boss[r->boss[i]].flags & LBF_UNBUILT)) return 0;
+    return 1;
+}
+
