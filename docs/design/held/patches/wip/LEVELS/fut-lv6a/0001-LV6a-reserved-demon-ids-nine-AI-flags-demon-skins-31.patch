diff --git a/core/tests/test_levels_foes.c b/core/tests/test_levels_foes.c
new file mode 100644
index 00000000..28709f61
--- /dev/null
+++ b/core/tests/test_levels_foes.c
@@ -0,0 +1,412 @@
+/* test_levels_foes.c - LV6a (owner: levels): the four reserved demon ids, the nine AI flags (one test
+ * each, every one fails without its rule in actor.c), the DemonSkin table, the Library gate, the 31
+ * boss rows with mechanic ids and the Boss Rush set tables. Host only: the PS1 has no FOES_NEW. */
+#include "test.h"
+#include "../src/levels_int.h"
+#include "../src/lib_int.h"
+
+#if FOES_NEW
+
+static void tick(int n) { while (n-- > 0) { input_update(0); combat_tick(); } }
+
+static void arena(void)
+{
+    opt_set(OPT_DIFFICULTY, DIFF_PLUSHIE);
+    combat_start_at(MAPID_ARENA, CGOAL_ENDLESS, 16, 22, 3072);
+    doomo_player.hp = 30000;
+}
+
+/* an awake demon of `type` at a cell, with AI flags */
+static int mk(int type, int cx, int cy, unsigned ai)
+{
+    int a = combat_spawn(type, cx, cy, 0);
+    if (a < 0) return -1;
+    actor_set_ai(a, ai);
+    doomo_actors[a].state = AST_CHASE;
+    doomo_actors[a].target = TARGET_PLAYER;
+    doomo_actors[a].cooldown = 250;                    /* no shooting in the movement tests */
+    return a;
+}
+
+static int dist_to_player(int a)
+{
+    return FIX2INT(fx_dist(doomo_actors[a].x - doomo_player.x, doomo_actors[a].y - doomo_player.y));
+}
+
+static int alive_demons(int type)
+{
+    int i, n = 0;
+    for (i = 0; i < ACTOR_MAX; i++)
+        if ((doomo_actors[i].flags & AF_USED) && doomo_actors[i].type == type && doomo_actors[i].hp > 0 &&
+            doomo_actors[i].state != AST_DYING)
+            n++;
+    return n;
+}
+
+static int lit_south(int cx, int cy) { (void)cx; return cy >= 16; }
+
+/* ---- the four reserved base demons ----------------------------------------------------------- */
+TEST(foes_new_base_demon_ids)
+{
+    int t, a;
+    CHECK_EQ(THING_DUCHESS + 1, THING_COUNT);
+    CHECK_EQ(THING_LATE_FEE, THING_PARTY_PAL + 1);
+    CHECK(THING_PARTY_PAL > THING_SPAWNER);                       /* appended after the props */
+    for (t = THING_PARTY_PAL; t <= THING_DUCHESS; t++) {
+        CHECK(IS_DEMON(t));
+        CHECK(DEMON(t)->name[0] != 0 && DEMON(t)->hp > 0);
+        CHECK(sprite_image(DEMON(t)->spr, 0) != NULL);            /* reuses a drawn set: nothing drawn wrong */
+    }
+    CHECK(IS_DEMON(THING_IMPLING) && IS_DEMON(THING_LORD_VAPULA));
+    CHECK(!IS_DEMON(THING_NONE) && !IS_DEMON(THING_HEALTH_SMALL) && !IS_DEMON(THING_SPAWNER));
+    CHECK(!IS_DEMON(AK_PROJECTILE) && !IS_DEMON(AK_GIB));
+    CHECK(DEMON(THING_IMPLING) == &combat_demon_info[0]);
+    CHECK(DEMON(THING_LORD_VAPULA) == &combat_demon_info[10]);
+    CHECK(DEMON(THING_PARTY_PAL) == &combat_demon_info[11] && DEMON(THING_DUCHESS) == &combat_demon_info[14]);
+    arena();
+    a = combat_spawn(THING_REPO_MAN, 16, 10, 0);
+    CHECK(a >= 0 && doomo_actors[a].hp == DEMON(THING_REPO_MAN)->hp * 3 / 4);   /* Plushie */
+}
+
+/* ---- 1. freezer: holds still and cannot be hurt while the lights are on ------------------------- */
+TEST(foes_freezer_holds_and_ignores_shots_in_showtime)
+{
+    int f, c, x0, y0, hp0, i;
+    arena();
+    f = mk(THING_IMPLING, 16, 10, AIF_FREEZER);
+    c = mk(THING_IMPLING, 22, 10, 0);
+    combat_ai_showtime = 1;
+    x0 = doomo_actors[f].x; y0 = doomo_actors[f].y; hp0 = doomo_actors[f].hp;
+    tick(40);
+    CHECK(doomo_actors[f].x == x0 && doomo_actors[f].y == y0);   /* frozen in its pose */
+    CHECK(doomo_actors[c].x != INT2FIX(22 * CELLU + CELLU / 2) || doomo_actors[c].y != INT2FIX(10 * CELLU + CELLU / 2));
+    CHECK_EQ(actor_damage(f, 50, PLAYER_OWNER, 0, 0, 0, 0), 0);
+    CHECK_EQ(doomo_actors[f].hp, hp0);                           /* shots ping off */
+    combat_ai_showtime = 0;                                       /* lights off: they move, they can be hurt */
+    for (i = 0; i < 20; i++) tick(1);
+    CHECK(doomo_actors[f].x != x0 || doomo_actors[f].y != y0);
+    actor_damage(f, 10, PLAYER_OWNER, 0, 0, 0, 0);
+    CHECK(doomo_actors[f].hp < hp0);
+}
+
+/* ---- 2. splitter: two half-HP copies that do not split again ------------------------------------ */
+TEST(foes_splitter_leaves_two_halves)
+{
+    int a, i, kids = 0, hpk = 0, split_again = 0;
+    arena();
+    a = mk(THING_IMPLING, 16, 10, AIF_SPLITTER);
+    CHECK_EQ(actor_damage(a, 500, PLAYER_OWNER, 0, 0, 0, 0), 1);
+    for (i = 0; i < ACTOR_MAX; i++)
+        if (i != a && (doomo_actors[i].flags & AF_USED) && doomo_actors[i].type == THING_IMPLING && doomo_actors[i].hp > 0) {
+            kids++;
+            hpk = doomo_actors[i].hp;
+            split_again |= (actor_ai(i) & AIF_SPLITTER) != 0;
+        }
+    CHECK_EQ(kids, 2);
+    CHECK_EQ(hpk, DEMON(THING_IMPLING)->hp / 2);
+    CHECK(!split_again);
+    for (i = 0; i < ACTOR_MAX; i++)                              /* killing a copy leaves nothing behind */
+        if (i != a && (doomo_actors[i].flags & AF_USED) && doomo_actors[i].type == THING_IMPLING && doomo_actors[i].hp > 0)
+            actor_damage(i, 500, PLAYER_OWNER, 0, 0, 0, 0);
+    CHECK_EQ(alive_demons(THING_IMPLING), 0);
+    a = mk(THING_IMPLING, 16, 10, 0);                            /* no flag, no copies */
+    actor_damage(a, 500, PLAYER_OWNER, 0, 0, 0, 0);
+    CHECK_EQ(alive_demons(THING_IMPLING), 0);
+}
+
+/* ---- 3. thief: a melee hit steals and the thief runs ---------------------------------------------- */
+TEST(foes_thief_steals_then_runs)
+{
+    int t, c, i, d0, d1;
+    arena();
+    t = mk(THING_IMPLING, 16, 21, AIF_THIEF);
+    c = mk(THING_IMPLING, 17, 21, 0);
+    CHECK_EQ(combat_ai_stolen, 0);
+    for (i = 0; i < 2; i++) {
+        int a = i ? c : t;
+        doomo_actors[a].x = doomo_player.x + INT2FIX(i ? -34 : 34);
+        doomo_actors[a].y = doomo_player.y;
+        doomo_actors[a].cooldown = 0;
+        doomo_actors[a].state = AST_MELEE;
+        doomo_actors[a].timer = 0;
+    }
+    tick(10);
+    CHECK_EQ(combat_ai_stolen, 1);                               /* only the thief counts */
+    d0 = dist_to_player(t);
+    tick(30);
+    d1 = dist_to_player(t);
+    CHECK(d1 > d0 + 20);                                         /* running away */
+    CHECK(doomo_actors[t].state != AST_MELEE);
+    tick(200);                                                    /* and it comes back once it is done running */
+    CHECK(dist_to_player(t) < d1 + 400);
+}
+
+/* ---- 4. sleeper: sight does not wake it, noise does ---------------------------------------------- */
+TEST(foes_sleeper_wakes_on_noise)
+{
+    int s, c;
+    arena();
+    s = combat_spawn(THING_GARGOYLE, 16, 12, 0);
+    c = combat_spawn(THING_GARGOYLE, 20, 12, 0);
+    actor_set_ai(s, AIF_SLEEPER);
+    tick(120);
+    CHECK_EQ(doomo_actors[c].state == AST_IDLE, 0);              /* the control saw the player */
+    CHECK_EQ(doomo_actors[s].state, AST_IDLE);                   /* the sleeper did not */
+    combat_ai_noise = AI_NOISE_WAKE - 1;
+    tick(20);
+    CHECK_EQ(doomo_actors[s].state, AST_IDLE);                   /* not loud enough */
+    combat_ai_noise = AI_NOISE_WAKE;
+    tick(20);
+    CHECK(doomo_actors[s].state != AST_IDLE);
+}
+
+/* ---- 5. stalker: unkillable, awake from the start, walks straight at the player ------------------ */
+TEST(foes_stalker_cannot_be_killed_and_keeps_coming)
+{
+    int s, c, d0;
+    arena();
+    s = combat_spawn(THING_IMPLING, 16, 8, 0);
+    actor_set_ai(s, AIF_STALKER);
+    c = combat_spawn(THING_IMPLING, 22, 8, 0);
+    d0 = doomo_actors[s].hp;
+    CHECK_EQ(actor_damage(s, 5000, PLAYER_OWNER, 0, 0, 0, 0), 0);
+    CHECK_EQ(doomo_actors[s].hp, d0);
+    CHECK_EQ(actor_damage(c, 5000, PLAYER_OWNER, 0, 0, 0, 0), 1);   /* the control dies */
+    d0 = dist_to_player(s);
+    tick(60);
+    CHECK(doomo_actors[s].state != AST_IDLE);                    /* woke without being seen or hurt */
+    CHECK(dist_to_player(s) < d0 - 40);
+    CHECK(doomo_actors[s].hp > 0);
+}
+
+/* ---- 6. flee-light: never steps into a lit cell ---------------------------------------------------- */
+TEST(foes_flee_light_stays_in_the_dark)
+{
+    int s, c, ys = 0, yc = 0;
+    arena();
+    combat_ai_lit = lit_south;
+    s = mk(THING_VAPE_WRAITH, 12, 10, AIF_FLEE_LIGHT);
+    c = mk(THING_VAPE_WRAITH, 20, 10, 0);
+    for (int i = 0; i < 400; i++) {
+        int ys_now, yc_now;
+        tick(1);
+        ys_now = FIX2INT(doomo_actors[s].y) / CELLU;
+        yc_now = FIX2INT(doomo_actors[c].y) / CELLU;
+        if (ys_now > ys) ys = ys_now;
+        if (yc_now > yc) yc = yc_now;
+    }
+    CHECK(yc >= 16);                                             /* the control crosses into the light */
+    CHECK(ys < 16);                                              /* the shade never does */
+}
+
+/* ---- 7. swimmer: under it cannot be hit, lava does not hurt it ----------------------------------- */
+TEST(foes_swimmer_submerges_in_lava)
+{
+    int s, c, i, under = 0, up = 0, hp_c, hp_s;
+    arena();
+    ((DoomoCell *)&doomo_map.cells[12 * doomo_map.w + 10])->flags |= CELL_LAVA;
+    ((DoomoCell *)&doomo_map.cells[12 * doomo_map.w + 22])->flags |= CELL_LAVA;
+    s = combat_spawn(THING_SLIME_BELCHER, 10, 12, 0);
+    c = combat_spawn(THING_SLIME_BELCHER, 22, 12, 0);
+    actor_set_ai(s, AIF_SWIMMER);
+    hp_c = doomo_actors[c].hp;
+    hp_s = doomo_actors[s].hp;
+    for (i = 0; i < 240; i++) {
+        tick(1);
+        if (doomo_actors[s].flags & AF_SHOOTABLE) up++; else under++;
+        if (!(doomo_actors[s].flags & AF_SHOOTABLE))
+            CHECK_EQ(actor_damage(s, 20, PLAYER_OWNER, 0, 0, 0, 0), 0);   /* under: nothing hits it */
+    }
+    CHECK(under > 60 && up > 60);                                /* both halves of the cycle */
+    CHECK_EQ(doomo_actors[s].hp, hp_s);                          /* lava is its home */
+    CHECK(doomo_actors[c].hp < hp_c);                            /* the control burns */
+}
+
+/* ---- 8. orbiter: rides a ring round its target instead of closing in ------------------------------ */
+TEST(foes_orbiter_keeps_its_ring)
+{
+    int o, c, i, mo = 9999, mc = 9999;
+    arena();
+    o = mk(THING_BRUTE, 16, 15, AIF_ORBITER);
+    for (i = 0; i < 400; i++) {
+        tick(1);
+        mo = DOOMO_MIN(mo, dist_to_player(o));
+    }
+    arena();
+    c = mk(THING_BRUTE, 16, 15, 0);
+    for (i = 0; i < 400; i++) {
+        tick(1);
+        mc = DOOMO_MIN(mc, dist_to_player(c));
+    }
+    CHECK_MSG(mc < 3 * CELLU, "the control closes in (%d)", mc);
+    CHECK_MSG(mo >= 3 * CELLU, "the orbiter keeps its ring (%d)", mo);
+}
+
+/* ---- 9. poser: holds its pose, turning but never walking ---------------------------------------- */
+TEST(foes_poser_holds_its_pose)
+{
+    int p, c, x0, y0;
+    arena();
+    p = mk(THING_BONE_JESTER, 16, 14, AIF_POSER);
+    c = mk(THING_BONE_JESTER, 20, 14, 0);
+    x0 = doomo_actors[p].x; y0 = doomo_actors[p].y;
+    tick(80);
+    CHECK(doomo_actors[p].x == x0 && doomo_actors[p].y == y0);
+    CHECK(doomo_actors[c].x != INT2FIX(20 * CELLU + CELLU / 2) || doomo_actors[c].y != INT2FIX(14 * CELLU + CELLU / 2));
+    /* it still attacks: a poser in melee reach hits the player */
+    doomo_actors[p].x = doomo_player.x + INT2FIX(30);
+    doomo_actors[p].y = doomo_player.y;
+    doomo_actors[p].cooldown = 0;
+    doomo_player.hp = 500;
+    tick(40);
+    CHECK(doomo_player.hp < 500);
+}
+
+/* ---- the flags are per actor and a recycled slot starts clean ------------------------------------- */
+TEST(foes_ai_flags_are_per_actor_and_cleared_on_reuse)
+{
+    int a, b;
+    arena();
+    a = combat_spawn(THING_IMPLING, 16, 10, 0);
+    b = combat_spawn(THING_IMPLING, 18, 10, 0);
+    actor_set_ai(a, AIF_THIEF | AIF_POSER);
+    CHECK_EQ(actor_ai(a), AIF_THIEF | AIF_POSER);
+    CHECK_EQ(actor_ai(b), 0);
+    CHECK_EQ(actor_ai(-1), 0);
+    CHECK_EQ(actor_ai(ACTOR_MAX), 0);
+    actor_set_ai(a, 0xFFFF);
+    CHECK_EQ(actor_ai(a), AIF_ALL);                              /* only the nine bits */
+    doomo_actors[a].flags = 0;                                   /* free the slot, then allocate it again */
+    {
+        int n = actor_alloc(0);
+        CHECK_EQ(n, a);
+        CHECK_EQ(actor_ai(n), 0);
+    }
+    combat_ai_showtime = 1; combat_ai_noise = 9; combat_ai_stolen = 3;
+    combat_start_at(MAPID_ARENA, CGOAL_ENDLESS, 16, 22, 3072);   /* a new session clears the globals */
+    CHECK(!combat_ai_showtime && !combat_ai_noise && !combat_ai_stolen && combat_ai_lit == NULL);
+}
+
+/* ---- the skin table ------------------------------------------------------------------------------- */
+TEST(foes_skin_table_is_sound)
+{
+    int i, j, lv = LV_HB8;
+    CHECK_EQ(LV_SKIN_N, 12);
+    for (i = 0; i < LV_SKIN_N; i++) {
+        const DemonSkin *s = &lv_skin[i];
+        CHECK_MSG(IS_DEMON(s->base), "skin %d base", i);
+        CHECK_MSG(s->level >= LV_HB8 && s->level <= LV_HB10 && s->level >= lv, "skin %d level order", i);
+        lv = s->level;
+        CHECK(s->name[0] && strlen(s->name) <= 24);
+        CHECK_MSG(strlen(s->blurb) >= 30 && strlen(s->blurb) <= 130, "blurb of %s", s->name);
+        CHECK(s->scale == 0 || (s->scale >= 128 && s->scale <= 1024));
+        CHECK((s->ai & ~(unsigned)AIF_ALL) == 0);
+        CHECK(s->flags < 32 && s->glow < 16);
+        for (j = 0; j < i; j++) CHECK(strcmp(lv_skin[j].name, s->name) != 0);
+        CHECK_MSG(sprite_image(DEMON(s->base)->spr, 0) != NULL, "skin %d sprite", i);
+    }
+    CHECK(lv_skin[4].ai == AIF_FLEE_LIGHT && lv_skin[6].ai == AIF_SLEEPER);   /* Shade, Mourner */
+}
+
+TEST(foes_skin_apply_dresses_the_demon)
+{
+    int g, i;
+    arena();
+    g = combat_spawn(THING_GARGOYLE, 16, 10, 0);
+    lvf_skin_apply(g, 99);                                       /* bad id: no-op */
+    CHECK_EQ(actor_ai(g), 0);
+    lvf_skin_apply(g, 0);                                        /* Towel Impling is not a gargoyle */
+    CHECK_EQ(actor_ai(g), 0);
+    for (i = 0; i < LV_SKIN_N && lv_skin[i].base != THING_GARGOYLE; i++) {}
+    CHECK(i < LV_SKIN_N);
+    lvf_skin_apply(g, i);
+    CHECK_EQ(actor_ai(g), AIF_SLEEPER);
+    CHECK(doomo_actors[g].tflags & THF_AMBUSH);
+}
+
+/* ---- the Library only shows skins whose level is built and cleared --------------------------------- */
+TEST(foes_library_shows_no_unbuilt_demon)
+{
+    int i;
+    test_reset();
+    for (i = 0; i < LV_SKIN_N; i++) CHECK_EQ(lvf_skin_known(i), 0);   /* LV8-10 are not built yet */
+    CHECK_EQ(lvf_skin_known(-1), 0);
+    CHECK_EQ(lvf_skin_known(LV_SKIN_N), 0);
+    CHECK_EQ(lvf_skin_known_count(), 0);
+    CHECK_EQ(lvf_skin_nth_known(0), -1);
+    CHECK_EQ(lib_bestiary_skin_count(), 0);
+    CHECK_STR(lib_bestiary_skin_name(0), "");
+    CHECK_STR(lib_bestiary_skin_blurb(0), "");
+    /* a built level that is cleared lifts exactly its skins: level 0 has none, so the count stays 0 */
+    CHECK(lv_built(LV_VAPE_CELLAR));
+    lv_set_rank(LV_VAPE_CELLAR, RANK_S);
+    CHECK_EQ(lvf_skin_known_count(), 0);
+}
+
+/* ---- 31 bosses with mechanic ids ------------------------------------------------------------------ */
+TEST(foes_boss_table_has_31_rows_with_mechanics)
+{
+    int i, seen[LBM_COUNT] = { 0 }, unbuilt = 0;
+    CHECK_EQ(LB_COUNT, 31);
+    CHECK_EQ(LB_COUNT, LV_COUNT);
+    CHECK_EQ((int)sizeof(((LevelBoss *)0)->flags), 2);           /* the flags grew to 16 bits */
+    for (i = 0; i < LB_COUNT; i++) {
+        const LevelBoss *b = &lv_boss[i];
+        CHECK_MSG(b->name && b->name[0] && b->title && b->title[0], "boss %d names", i);
+        CHECK_MSG(IS_DEMON(b->type) && IS_DEMON(b->add), "boss %d types", i);
+        CHECK_MSG(b->mech < LBM_COUNT, "boss %d mech", i);
+        CHECK_MSG(sprite_image(b->spr, 0) != NULL, "boss %d sprite", i);
+        if (i < LV_OLD_COUNT) {
+            CHECK_MSG(!(b->flags & (LBF_UNBUILT | LBF_SCRIPTED)) && b->mech == LBM_NONE, "old boss %d unchanged", i);
+        } else {
+            CHECK_MSG(b->flags & LBF_UNBUILT, "new boss %d is a placeholder", i);
+            unbuilt++;
+            if (b->mech) seen[b->mech]++;
+        }
+    }
+    CHECK_EQ(unbuilt, 24);
+    for (i = 1; i < LBM_COUNT; i++) CHECK_MSG(seen[i] == 1, "mechanic %d is used %d times", i, seen[i]);
+    /* the old six flag sets and looks are exactly as before */
+    CHECK_EQ(lv_boss[LB_WIDOW].flags, LBF_GHOST | LBF_BLINK | LBF_SUMMON);
+    CHECK_EQ(lv_boss[LB_GUTTERKING].flags, LBF_SUMMON | LBF_PULSE);
+    CHECK_EQ(lv_boss[LB_VAPULA].flags, 0);
+    CHECK_EQ(lv_boss[LB_GRUMBLEGUTS].scale, 435);
+    CHECK_EQ(lv_boss[LB_BATHROBE].type, THING_BRUTE);
+    CHECK_EQ(lv_boss[LB_GARY].type, THING_PARTY_PAL);
+    CHECK_EQ(lv_boss[LB_DUCHESS2].type, THING_DUCHESS);
+    CHECK_EQ(lv_boss[LB_COMPOUND].mech, LBM_SPLIT);
+}
+
+/* ---- Boss Rush sets -------------------------------------------------------------------------------- */
+TEST(foes_boss_rush_sets)
+{
+    int s, i, j;
+    CHECK_EQ(lv_rush_set[RUSHSET_CLASSIC7].n, 7);
+    CHECK_EQ(lv_rush_set[RUSHSET_BREACH16].n, 16);
+    CHECK_EQ(lv_rush_set[RUSHSET_ARREARS].n, 12);
+    CHECK_STR(lv_rush_set[RUSHSET_CLASSIC7].name, "Classic 7");
+    CHECK_STR(lv_rush_set[RUSHSET_BREACH16].name, "Breach 16");
+    CHECK_STR(lv_rush_set[RUSHSET_ARREARS].name, "Arrears");
+    for (s = 0; s < RUSHSET_COUNT; s++) {
+        const RushSet *r = &lv_rush_set[s];
+        CHECK(r->n <= RUSH_MAX);
+        for (i = 0; i < r->n; i++) {
+            CHECK_MSG(r->boss[i] < LB_COUNT, "set %d slot %d", s, i);
+            for (j = 0; j < i; j++) CHECK_MSG(r->boss[i] != r->boss[j], "set %d repeats a boss", s);
+        }
+    }
+    /* Classic 7 is the old lineup, in the old order, and ends on Lord Vapula */
+    CHECK_EQ(lv_rush_set[RUSHSET_CLASSIC7].boss[0], LB_CELLAR_WRAITH);
+    CHECK_EQ(lv_rush_set[RUSHSET_CLASSIC7].boss[6], LB_VAPULA);
+    CHECK_EQ(lv_rush_set[RUSHSET_BREACH16].boss[15], LB_VAPULA);
+    /* only Classic is offered while the new bosses are placeholders */
+    CHECK_EQ(lvf_rush_ready(RUSHSET_CLASSIC7), 1);
+    CHECK_EQ(lvf_rush_ready(RUSHSET_BREACH16), 0);
+    CHECK_EQ(lvf_rush_ready(RUSHSET_ARREARS), 0);
+    CHECK_EQ(lvf_rush_ready(-1), 0);
+    CHECK_EQ(lvf_rush_ready(RUSHSET_COUNT), 0);
+    arena_rush_set(RUSHSET_ARREARS);                              /* not ready: falls back to Classic */
