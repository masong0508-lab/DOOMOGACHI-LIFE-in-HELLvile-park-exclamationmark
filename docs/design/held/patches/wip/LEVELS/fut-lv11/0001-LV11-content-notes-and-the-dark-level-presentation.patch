+
+#if !defined(DOOMO_PLATFORM_PS1)
+/* (LV11) the card of a dark level on a later visit: the same card with the content note's one line above the goal */
+int ccard_height_note(int w, const char *note, const char *goal, const char *rule)
+{
+    return ccard_height(w, goal, rule) + (NOTE_ON(note) ? FONT_LINE : 0);
 }
+
+void ccard_draw_above_note(int cx, int bottom, int w, int style, const char *note, const char *goal, const char *rule)
+{
+    char l[CCARD_MAX_LINES][CCARD_LINE_CAP];
+    int n, h;
+    if (plat_draw_skipped()) return;
+    n = ccard_lines(l, CCARD_MAX_LINES, w - 12);
+    h = 6 + (n + 1 + (goal && goal[0]) + (rule && rule[0]) + (NOTE_ON(note) ? 1 : 0)) * FONT_LINE + 2;
+    ccard_draw_lines(cx - w / 2, bottom - h, w, h, style, note, goal, rule, l, n);
+}
+
+/* (LV11) the note page of a dark level's first visit: the full text in a window, 6 px margins, centred on
+ * (cx, y + h / 2); the scene adds its own hint. ccard_note_page_h() is its height for the same text. */
+int ccard_note_page_h(int w, const char *note)
+{
+    return 6 + ui_text_wrap(0, 0, w - 12, note, 0, 0) * FONT_LINE + 2;
+}
+
+void ccard_note_page(int cx, int y, int w, int style, const char *note)
+{
+    if (plat_draw_skipped()) return;
+    ui_window(cx - w / 2, y, w, ccard_note_page_h(w, note), style);
+    ui_text_wrap(cx - w / 2 + 6, y + 4, w - 12, note, ui_style(style)->text, 1);
+}
+#endif
