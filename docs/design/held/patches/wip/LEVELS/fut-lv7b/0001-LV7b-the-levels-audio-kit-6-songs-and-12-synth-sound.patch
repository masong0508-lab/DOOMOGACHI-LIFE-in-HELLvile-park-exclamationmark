diff --git a/core/tests/test_levels_audio.c b/core/tests/test_levels_audio.c
new file mode 100644
index 00000000..e88bcfdc
--- /dev/null
+++ b/core/tests/test_levels_audio.c
@@ -0,0 +1,120 @@
+/* test_levels_audio.c - the levels audio kit (LV7b): 6 songs and 12 synth SFX
+ * (docs/LEVELS.md "Audio kit"). */
+#include "test.h"
+#include "../src/audio_int.h"
+#include "doomo/unlocks.h"
+#include "doomo/unlock_ids.h"
+#include "../src/mus_int.h"
+
+static void ticks(int n) { while (n-- > 0) audio_tick(); }
+
+TEST(levels_audio_six_songs_are_appended_and_valid)
+{
+    int s;
+    /* the old songs keep their ids; the six come after them */
+    CHECK_EQ(SONG_OLD_COUNT, 29);
+    CHECK_EQ(SONG_NUMBER_TEN, SONG_OLD_COUNT - 1);
+    CHECK_EQ(SONG_SPA_BOSSA, SONG_OLD_COUNT);
+    CHECK_EQ(SONG_GREAT_RAIN, SONG_COUNT_ALL - 1);
+    CHECK_EQ(SONG_COUNT_ALL - SONG_OLD_COUNT, 6);
+    CHECK_EQ(SONG_COUNT, SONG_COUNT_ALL);                 /* (the host is not the PS1) */
+    for (s = SONG_SPA_BOSSA; s <= SONG_GREAT_RAIN; s++) {
+        const char *err = NULL;
+        int ch;
+        uint32_t len;
+        CHECK_MSG(audio_song_check(s, &err), "song %d: %s", s, err ? err : "?");
+        len = audio_song_length(s);
+        /* 8 bars, 6 to 32 seconds a pass at 30 ticks a second (as the old songs) */
+        CHECK_MSG(len >= 6u * 30u && len <= 32u * 30u, "song %s is %u ticks", audio_song_name(s), (unsigned)len);
+        CHECK(audio_song_name(s)[0] != 0);
+        for (ch = 0; ch < AUDIO_CH; ch++) {
+            CHECK_MSG(audio_songs[s].ch[ch] && strlen(audio_songs[s].ch[ch]) < 300, "song %d channel %d", s, ch);
+        }
+        /* it plays: notes start and the sequencer loops it */
+        test_reset();
+        audio_init();
+        audio_music(s);
+        CHECK_EQ(audio_music_current(), s);
+        ticks((int)len + 2);
+        CHECK(audio_note_count() > 20);
+        CHECK_EQ(audio_music_current(), s);
+        audio_music(SONG_NONE);
+    }
+    CHECK(!audio_song_check(SONG_COUNT_ALL, NULL));
+}
+
+TEST(levels_audio_songs_have_bank_cues_and_unique_ids)
+{
+    int s, t;
+    for (s = SONG_SPA_BOSSA; s <= SONG_GREAT_RAIN; s++) {
+        int cue = mus_bind_cue(s, -1, -1, 0);
+        CHECK_MSG(cue != MC_NONE && music_cue_exists(cue), "song %d has no bank cue", s);
+        for (t = SONG_NONE + 1; t < s; t++) CHECK_MSG(mus_bind_cue(t, -1, -1, 0) != cue, "cue %d used twice", cue);
+        CHECK_MSG(cue < MC_SFX_SCRATCH, "song cue %d is in the sfx area", cue);
+    }
+}
+
+TEST(levels_audio_jukebox_lists_the_six_and_none_is_unlocked)
+{
+    int s, n = 0;
+    const DoomoUnlock *u;
+    for (s = SONG_SPA_BOSSA; s <= SONG_GREAT_RAIN; s++) {
+        int id = UL_STORY_SONG3(s);
+        CHECK(id >= UL_STORY_SONG3_FIRST && id <= UL_STORY_SONG3_LAST);
+        CHECK(UL_STORY_SONG3_FIRST > UL_STORY_END_LAST && UL_STORY_SONG3_LAST < UL_STORY_SPARE_FIRST);
+        CHECK(UL_STORY_SPARE_FIRST <= UL_IDS_STORY_LAST);
+        u = unlock_by_id((uint16_t)id);
+        CHECK_MSG(u != NULL, "no unlock row for id %d", id);
+        if (u) {
+            CHECK_EQ(u->cat, UL_CAT_GALLERY);
+            CHECK_EQ(u->list, GAL_JUKEBOX);
+            CHECK_EQ(u->index, s);
+            n++;
+        }
+    }
+    CHECK_EQ(n, 6);
+    /* a new Story game has not heard them: the jukebox keeps them hidden until a level grants them */
+    town_new(TOWN_STORY, 1, TOWN_POP_PREMADE);
+    for (s = SONG_SPA_BOSSA; s <= SONG_GREAT_RAIN; s++)
+        CHECK_MSG(!unlock_ok(UL_CAT_GALLERY, GAL_JUKEBOX, s), "song %d is unlocked already", s);
+    /* the old songs are listed as before */
+    CHECK(unlock_by_id(UL_STORY_SONG2(SONG_NUMBER_TEN)) != NULL);
+}
+
+TEST(levels_audio_twelve_synth_sfx_are_short_and_never_pcm)
+{
+    int s;
+    static const char *const want[12] = { "valve", "tube", "stamp", "showtime", "zipline", "raft",
+                                          "tow hook", "till", "gavel", "scream", "page", "rain" };
+    CHECK_EQ(SFX_SYNTH_OLD_COUNT, 15);                    /* the first fifteen keep their ids */
+    CHECK_EQ(SFX_VALVE, SFX_SYNTH_OLD_END);
+    CHECK_EQ(SFX_SYNTH_END_ALL - SFX_VALVE, 12);
+    CHECK_EQ(SFX_SYNTH_COUNT, 27);
+    CHECK_EQ(SFX_CREAK, SFX_SYNTH_OLD_END - 1);
+    for (s = SFX_VALVE; s < SFX_SYNTH_END_ALL; s++) {
+        int f = audio_sfx_synth_frames(s), i;
+        uint32_t samples, tones;
+        test_reset();
+        audio_init();
+        samples = nat_sample_calls;
+        tones = nat_tone_calls;
+        CHECK_MSG(f >= 1 && f <= 12, "%s lasts %d frames", audio_sfx_synth_name(s), f);
+        CHECK_MSG(strcmp(audio_sfx_synth_name(s), want[s - SFX_VALVE]) == 0, "name of %d", s);
+        audio_sfx(s);
+        CHECK(audio_sfx_synth_busy());
+        CHECK(!audio_fx_owns(0) && !audio_fx_owns(1));    /* the music's lead and harmony keep playing */
+        for (i = 0; i < 13; i++) audio_tick();
+        CHECK(!audio_sfx_synth_busy());
+        CHECK_EQ(nat_sample_calls, samples);              /* 0 B of PCM: the 48 KB budget is untouched */
+        CHECK(nat_tone_calls > tones);
+    }
+    /* the PCM budget is what it was: sfxgen.py --check says 47,793 of 49,152 */
+    CHECK(audio_sfx_total_bytes() <= AUDIO_SFX_BUDGET);
+    CHECK_EQ(audio_sfx_total_bytes(), 47793u);
+    CHECK_EQ(SFX_COUNT, 36);
+    /* an id past the table is silent, not a crash */
+    test_reset();
+    audio_init();
+    audio_sfx(SFX_SYNTH_END_ALL);
+    CHECK(!audio_sfx_synth_busy());
+}
