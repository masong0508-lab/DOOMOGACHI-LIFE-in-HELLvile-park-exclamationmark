@@ -401,11 +401,97 @@ static void s_vape_storm(ArtImg *im, int f, int n)
     }
 }
 
+/* ---- LV7 skies --------------------------------------------------------------------------- */
+/* overcast: a low grey lid in slow bands, a pale seam at the horizon and a row of far dark
+ * roofs; the outdoor window of the dark levels */
+static void s_overcast(ArtImg *im, int f, int n)
+{
+    int x, y;
+    (void)f; (void)n;
+    for (y = 0; y < SKY_H; y++)
+        for (x = 0; x < SKY_W; x++) {
+            int v = art_fbm2(x, y * 2, 32, 3, SKY_W, 256, 0x0CA57u);
+            int base = 255 - y * 130 / SKY_H;          /* lighter toward the horizon */
+            PX(x, y, art_ramp_v(RAMP_STEEL, 1, 5, (v * 2 + base) / 3, x, y, 1));
+        }
+    for (x = 0; x < SKY_W; x++) {
+        int bx = x % 24;
+        int h = 80 - ((bx < 12) ? 4 + (x / 24 % 4) * 2 - art_abs(bx - 6) / 2 : 0);
+        for (y = h; y < SKY_H; y++) PX(x, y, RP(RAMP_STEEL, 0));
+    }
+}
+
+/* ink: black-blue paper with faint ledger rules, ink drips running down from the top and a
+ * pale round stamp seal for a moon; the Ledger's sky */
+static void s_ink(ArtImg *im, int f, int n)
+{
+    int x, y, i;
+    (void)f; (void)n;
+    for (y = 0; y < SKY_H; y++)
+        for (x = 0; x < SKY_W; x++) {
+            int v = art_fbm2(x, y, 16, 3, SKY_W, 128, 0x1A2Bu);
+            PX(x, y, art_ramp_v(RAMP_STEEL, 0, 2, v * (y + 40) / 140, x, y, 1));
+        }
+    for (y = 9; y < SKY_H; y += 12)
+        for (x = 0; x < SKY_W; x++) if (x & 1) PX(x, y, RP(RAMP_STEEL, 2));
+    for (x = 0; x < SKY_W; x += 32) for (y = 0; y < SKY_H; y++) if (y & 1) PX(x, y, RP(RAMP_STEEL, 2));
+    for (i = 0; i < 12; i++) {
+        uint32_t h = art_hash((uint32_t)i, 1u, 0x1A2Cu);
+        int dx = (int)(h % (uint32_t)SKY_W), len = 14 + (int)((h >> 8) % 40u);
+        for (y = 0; y < len; y++) PX(dx, y, RP(RAMP_STEEL, 0));
+        PX(dx - 1, len, RP(RAMP_STEEL, 0)); PX(dx, len + 1, RP(RAMP_STEEL, 0)); PX(dx + 1, len, RP(RAMP_STEEL, 0));
+    }
+    /* the seal */
+    {
+        ArtMat m = art_mat_ramp(RAMP_BONE, 4, 7);
+        img_ball(im, 168, 30, 15, 15, &m, 1);
+        img_ring(im, 168, 30, 10, 11, RP(RAMP_BONE, 3));
+    }
+    for (i = 0; i < 30; i++) {
+        uint32_t h = art_hash((uint32_t)i, 2u, 0x1A2Du);
+        PX((int)(h % (uint32_t)SKY_W), (int)((h >> 8) % 60u), RP(RAMP_BONE, 2 + (int)(i & 1)));
+    }
+}
+
+/* dusk_lanterns: violet to amber dusk, rows of floating paper lanterns on their strings over a
+ * low roofline; the Mingle's sky */
+static void s_dusk_lanterns(ArtImg *im, int f, int n)
+{
+    uint8_t cols[4];
+    int ys[4] = {0, 30, 58, 78};
+    int x, y, i;
+    (void)f; (void)n;
+    cols[0] = RP(RAMP_VAPE, 1); cols[1] = RP(RAMP_VAPE, 3); cols[2] = RP(RAMP_PEACH, 4); cols[3] = RP(RAMP_CANDY, 4);
+    gradient(im, cols, ys, 4);
+    for (y = 0; y < 70; y++)
+        for (x = 0; x < SKY_W; x++)
+            if (art_fbm2(x, y, 24, 3, SKY_W, 256, 0xD05Cu) > 178) PX(x, y, RP(RAMP_VAPE, 2 + y / 24));
+    for (i = 0; i < 26; i++) {
+        uint32_t h = art_hash((uint32_t)i, 3u, 0xD05Du);
+        int lx = (i * 10 + (int)(h % 7u)) % SKY_W, ly = 14 + (int)((h >> 8) % 44u);
+        int r = 3 + (int)((h >> 16) % 3u);
+        ArtMat m = (i & 1) ? art_mat_ramp(RAMP_CANDY, 3, 7) : art_mat_ramp(RAMP_BLOOD, 3, 7);
+        for (y = 0; y < ly - r; y += 2) PX(lx, y, RP(RAMP_VAPE, 0));
+        img_ball(im, lx, ly, r, r + 1, &m, 0);
+        PX(lx, ly - r - 1, RP(RAMP_VAPE, 0));
+        PX(lx, ly + r + 2, RP(RAMP_CANDY, 6));
+    }
+    for (x = 0; x < SKY_W; x++) {
+        int bx = x % 20;
+        int h = 82 - ((bx < 14) ? 5 - art_abs(bx - 7) / 2 : 0) - (x / 20 % 3);
+        for (y = h; y < SKY_H; y++) PX(x, y, RP(RAMP_VAPE, 0));
+        if (bx > 2 && bx < 6 && ((x / 20) & 1)) PX(x, h + 5, RP(RAMP_CANDY, 6));
+    }
+}
+
 const ArtSkyDef art_skies[] = {
     {SKY_PASTEL_DAY, "pastel_day", 1, 1, DOOMO_ANIM_LOOP, s_pastel_day},
     {SKY_SUNSET, "sunset", 1, 1, DOOMO_ANIM_LOOP, s_sunset},
     {SKY_NIGHT_STARS, "night_stars", 1, 1, DOOMO_ANIM_LOOP, s_night},
     {SKY_HELL, "hell", 1, 1, DOOMO_ANIM_LOOP, s_hell},
     {SKY_VAPE_STORM, "vape_storm", 1, 1, DOOMO_ANIM_LOOP, s_vape_storm},
+    {SKY_OVERCAST, "overcast", 1, 1, DOOMO_ANIM_LOOP, s_overcast},
+    {SKY_INK, "ink", 1, 1, DOOMO_ANIM_LOOP, s_ink},
+    {SKY_DUSK_LANTERNS, "dusk_lanterns", 1, 1, DOOMO_ANIM_LOOP, s_dusk_lanterns},
 };
 const int art_skies_n = (int)(sizeof art_skies / sizeof art_skies[0]);
diff --git a/core/art/tex_lv.c b/core/art/tex_lv.c
new file mode 100644
index 00000000..d9fdef20
--- /dev/null
+++ b/core/art/tex_lv.c
@@ -0,0 +1,217 @@
+/* tex_lv.c - the 7 shared level textures (LV7, ids 48..54 in textures.h).
+ *
+ *   steam_tile     pale aqua bath-house tile, dewy              (Steam Room Panic)
+ *   pipe_steel     four horizontal steel pipes, flanges, rust   (Glum Pipes)
+ *   office_carpet  grey-blue speckled carpet with a seam grid   (Department of Contracts)
+ *   cubicle_fabric woven peach panel with a pin strip           (Department of Contracts)
+ *   felt           green baize with a faint diamond quilt       (Bandstand, Boneyard Buffet)
+ *   ledger_page    cream ruled paper, red margin, tick marks    (The Ledger)
+ *   vault_metal    dark steel plates, bolts, an amber lamp      (Vault of Unfelt Things)
+ *
+ * Same rules as the other texture files: 64x64, seamless, integer only.
+ * Nothing here is adult-only or gory.
+ */
+#include "art.h"
+
+#define PX(x, y, c) img_put(im, (x), (y), (uint8_t)(c))
+#define GX(x, y) img_get(im, (x), (y))
+
+static void bolt(ArtImg *im, int x, int y)
+{
+    PX(x, y, RP(RAMP_STEEL, 6));
+    PX(x + 1, y, RP(RAMP_STEEL, 4));
+    PX(x, y + 1, RP(RAMP_STEEL, 4));
+    PX(x + 1, y + 1, RP(RAMP_STEEL, 2));
+}
+
+static void t_steam_tile(ArtImg *im, int f, int n)
+{
+    int x, y, i;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int lx = x % 16, ly = y % 16;
+            uint32_t id = art_hash((uint32_t)(x / 16), (uint32_t)(y / 16), 0x57E4u);
+            int s = 4 + (int)(id & 1u);
+            if (lx == 0 || ly == 0) { PX(x, y, RP(RAMP_STONE, 3)); continue; }
+            s += tx_bevel(lx - 1, ly - 1, 15, 15, 1);
+            if (art_noise(x, y, 8, 64, 0x57E5u) > 200) s++;
+            if (art_hash((uint32_t)x, (uint32_t)y, 0x57E6u) % 23u == 0) s--;
+            PX(x, y, RP(RAMP_MINT, s));
+        }
+    /* condensation: a bright bead with a dark tail */
+    for (i = 0; i < 14; i++) {
+        uint32_t h = art_hash((uint32_t)i, 3u, 0x57E7u);
+        int bx = (int)(h % 64u), by = (int)((h >> 8) % 60u);
+        if (bx % 16 < 2 || by % 16 < 2) continue;
+        PX(bx, by, RP(RAMP_MINT, 7));
+        PX(bx, by + 1, RP(RAMP_MINT, 4));
+        PX(bx, by + 2, RP(RAMP_MINT, 4));
+    }
+}
+
+static void t_pipe_steel(ArtImg *im, int f, int n)
+{
+    static const uint8_t prof[16] = {0, 2, 4, 5, 6, 7, 6, 5, 4, 4, 3, 3, 2, 2, 1, 0};
+    int x, y;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int s = prof[y % 16];
+            int fl = art_wrap(x, 32);
+            if (art_noise(x, y, 4, 64, 0x91BEu) > 215) s++;
+            if (fl < 4 || fl > 28) s = (s > 1 ? s - 1 : 0) + (fl == 0 || fl == 31 ? 0 : 1);
+            PX(x, y, RP(RAMP_STEEL, s));
+        }
+    for (y = 0; y < 64; y += 16) {
+        bolt(im, 1, y + 3); bolt(im, 1, y + 11);
+        bolt(im, 33, y + 3); bolt(im, 33, y + 11);
+    }
+    /* rust weeps down from the flanges */
+    for (x = 0; x < 64; x++) {
+        int fl = art_wrap(x, 32);
+        if (fl > 6 && fl < 26) continue;
+        for (y = 0; y < 64; y++) {
+            int ly = y % 16;
+            if (ly < 8 || ly > 14) continue;
+            if (art_noise(x, y, 4, 64, 0x91BFu) > 140 + (ly - 8) * 10)
+                PX(x, y, PP(PAINT_RUST, ly > 11 ? 0 : 1));
+        }
+    }
+}
+
+static void t_office_carpet(ArtImg *im, int f, int n)
+{
+    int x, y;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int v = (int)(art_hash((uint32_t)x, (uint32_t)y, 0xCA12u) % 100u);
+            int s = 3;
+            if (v < 20) s = 2;
+            else if (v > 86) s = 4;
+            if (((x + y) & 7) == 0 && v < 60) s++;
+            if (x % 32 == 0 || y % 32 == 0) s = 1;
+            else if (x % 32 == 1 || y % 32 == 1) s = 2;
+            PX(x, y, RP(RAMP_STEEL, s));
+        }
+    /* a few dropped staples, because it is an office */
+    for (n = 0; n < 4; n++) {
+        uint32_t h = art_hash((uint32_t)n, 9u, 0xCA13u);
+        int bx = 3 + (int)(h % 56u), by = 3 + (int)((h >> 8) % 56u);
+        if (bx % 32 < 3 || by % 32 < 3) continue;
+        PX(bx, by, RP(RAMP_STEEL, 7)); PX(bx + 1, by, RP(RAMP_STEEL, 6)); PX(bx + 2, by, RP(RAMP_STEEL, 7));
+    }
+}
+
+static void t_cubicle_fabric(ArtImg *im, int f, int n)
+{
+    int x, y;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int s = 3 + (((x ^ y) & 1) ? 1 : 0);
+            if ((y & 3) == 0) s--;
+            if (art_noise(x, y, 4, 64, 0xCB1Cu) > 200) s++;
+            PX(x, y, RP(RAMP_PEACH, s));
+        }
+    /* the metal trim and its pin holes */
+    for (x = 0; x < 64; x++) {
+        PX(x, 28, RP(RAMP_STEEL, 6));
+        PX(x, 29, RP(RAMP_STEEL, 4));
+        PX(x, 30, RP(RAMP_STEEL, 3));
+        PX(x, 31, RP(RAMP_STEEL, 1));
+    }
+    for (x = 4; x < 64; x += 8) PX(x, 29, RP(RAMP_STEEL, 1));
+    /* a stitched seam down the middle */
+    for (y = 0; y < 64; y++)
+        if (y % 4 < 2 && (y < 28 || y > 31)) { PX(31, y, RP(RAMP_PEACH, 1)); PX(32, y, RP(RAMP_PEACH, 6)); }
+}
+
+static void t_felt(ArtImg *im, int f, int n)
+{
+    int x, y;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int v = (int)(art_hash((uint32_t)x, (uint32_t)y, 0xFE17u) % 100u);
+            int s = 2;
+            if (v < 25) s = 1;
+            else if (v > 80) s = 3;
+            if (art_noise(x, y, 8, 64, 0xFE18u) > 190) s++;
+            if (((x + y) % 16 == 0) || (art_wrap(x - y, 16) == 0)) s++;
+            PX(x, y, RP(RAMP_GRASS, s));
+        }
+    /* buttons at the quilt crossings */
+    for (y = 0; y < 64; y += 16)
+        for (x = 0; x < 64; x += 16) {
+            PX(x, y, RP(RAMP_GRASS, 0));
+            PX(x + 1, y, RP(RAMP_GRASS, 4));
+        }
+}
+
+static void t_ledger_page(ArtImg *im, int f, int n)
+{
+    int x, y, row;
+    (void)f; (void)n;
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 64; x++) {
+            int s = 6;
+            if (art_hash((uint32_t)x, (uint32_t)y, 0x1ED6u) % 17u == 0) s = 5;
+            PX(x, y, RP(RAMP_BONE, s));
+        }
+    for (y = 7; y < 64; y += 8)
+        for (x = 0; x < 64; x++) PX(x, y, RP(RAMP_SKY, 4));
+    for (y = 0; y < 64; y++) {
+        PX(10, y, PP(PAINT_CHERRY, 1));
+        PX(12, y, PP(PAINT_CHERRY, 1));
+        PX(40, y, RP(RAMP_SKY, 3));
+        PX(52, y, RP(RAMP_SKY, 3));
+    }
+    /* pencilled ticks and short totals, one row at a time */
+    for (row = 0; row < 8; row++) {
+        uint32_t h = art_hash((uint32_t)row, 5u, 0x1ED7u);
+        int len = 3 + (int)(h % 6u), x0 = 16 + (int)((h >> 8) % 14u), y0 = row * 8 + 3;
+        for (x = 0; x < len; x++) PX(x0 + x * 2, y0 + (x & 1), RP(RAMP_STEEL, 1));
+        for (x = 42; x < 42 + 3 + (int)((h >> 16) % 7u); x++) PX(x, y0 + 2, RP(RAMP_STEEL, 2));
