+/* G2-CR: a region's window on the held frame: shades are cut to it and its own drop shadow (on the
+ * kept pages already) is not drawn again */
+static void held_rect(int x, int y, int w, int h)
+{
+    (void)ui_modal_hold(&crl, 1, x, y, w, h);
+}
+
+/* G2-CR: a tick on the held frame. 0: it cannot be drawn held after all (the hold is dropped, nothing
+ * was drawn): the caller draws the full frame. */
+static int draw_held(void)
+{
+    if (!cr.hd_in && !plat_draw_skipped()) {
+        /* the first held tick: both pages carry the last full frame, so what it drew */
+        int r;
+        for (r = 0; r < CRR_COUNT; r++)
+            if (cr.hd_n[r]) cr.hd_n[r] = 2;
+        cr.hd_in = 1;
+    }
+    ui_glint_hold(1);
+    held_rect(0, crl.sh - 13, crl.sw, 13);
+    if (!draw_hint()) {
+        ui_glint_hold(0);
+        ui_modal_hold_end();
+        ui_modal_drop();
+        return 0;
+    }
+    held_rect(crl.px, crl.py, crl.pw, crl.ph);
+    draw_pane();
+    held_rect(crl.lx, crl.ly, crl.lw, crl.lh);
+    if (cr.phase == CRP_GRID) cr_grid_draw();
+    else draw_list();
+    held_rect(0, 0, crl.sw, crl.py);
+    draw_tabs();
+    ui_glint_hold(0);
+    ui_modal_hold_end();
+    return 1;
+}
+#endif
