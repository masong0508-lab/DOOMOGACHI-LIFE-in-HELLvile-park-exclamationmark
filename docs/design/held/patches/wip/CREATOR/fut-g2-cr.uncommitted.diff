+/* ====================================================================== */
+/* G2-CR: the held frame (GBA: CR_CALM with panels; docs/CREATOR.md "Speed", docs/GBA.md G2-CR).
+ * On the still stage nothing but the creator's four regions ever changes: the tab strip, the list
+ * window (or the part grid in its place), the preview pane and the button bar. So after one full
+ * frame the platform keeps the picture in both pages (ui_modal_hold) and a tick draws only the
+ * regions whose key changed: on two drawn ticks, because the two pages flip and each needs it (the
+ * second is the retained panel's copy from the page just shown); after that the region is left
+ * alone. A tick with nothing new draws nothing. The same pixels as the full frame: the backdrop
+ * and the windows' drop shadows are on the kept pages, every shade is cut to the region's window
+ * and the bar's rows have a clean copy to take a wider bar away (plat_strip). */
+#if defined(DOOMO_PLATFORM_PS1)
+#define CR_HOLD 0
+#else
+#define CR_HOLD (UI_PANELS && CR_CALM)
+#endif
+
+/* plat_panel_begin for region r: 1 draw it, 0 kept (its shading, then plat_panel_end), 2 on the
+ * held frame both pages carry it: nothing to do (no plat_panel_end) */
+int cr_region(int r, int id, int x, int y, int w, int h, uint32_t key)
+{
+    if (CR_HOLD && !plat_draw_skipped()) {
+        if (cr.hd_n[r] && cr.hd_key[r] == key) {
+            if (cr.hd_in && cr.hd_n[r] >= 2) return 2;
+            cr.hd_n[r] = 2;
+        } else {
+            cr.hd_key[r] = key;
+            cr.hd_n[r] = 1;
+        }
+    }
+    return plat_panel_begin(id, x, y, w, h, key);
+}
+
+/* the frame can be held: nothing outside the four regions moves, and each is a retained panel
+ * (or says so itself: the pane while a sparkle flies) */
+static int cr_still(void)
+{
+    if (!CR_HOLD) return 0;
+    if (cr.phase != CRP_MAIN && cr.phase != CRP_GRID) return 0;
+    if (cr.phase_t < 12 || cr.tab_t < 6) return 0;
+    if (cr.phase == CRP_MAIN && (cr.tab == CR_TAB_PERSONA || cr.tab == CR_TAB_HOME)) return 0;
+    return 1;
+}
+
+/* the backdrop a full frame draws (+ 1), so a held frame is never kept over another one */
+static int cr_backdrop_sig(void) { return 1 + (cr_is_hellish() ? 1 : 0) + (crl.big ? 2 : 0); }
+
