+        for (i = 0; i < cr_tabs[t].nrows; i++) {
+            const CrRow *row = &cr_tabs[t].rows[i];
+            if (row->kind != RK_ENUM && row->kind != RK_DEEP && row->kind != RK_PAINT && row->kind != RK_PAINT_NONE) continue;
+            CHECK_MSG(!cr_value_scrolls(row), "tab %d row %s scrolls", t, row->label);   /* calm: no marquee on these rows */
+            for (v = 0; v < cr_row_count(row); v++) {
+                const char *nm = cr_choice_name(row, v, nb);
+                int saved = cr.browse;
+                cr.browse = v;
+                cr_footer_text(row, crl.lw - 14, f);
+                cr.browse = saved;
+                if (ui_text_width(nm) <= crl.lw - 14) {
+                    CHECK_MSG(strstr(f, nm) != NULL, "footer of %s lost the name '%s' (%s)", row->label, nm, f);
+                    long_names += ui_text_width(nm) > crl.lw - 14 - 40;
+                }
+            }
+        }
+    }
+    CHECK(long_names >= 0);
+}
+
+TEST(cr_ui_tab_strip_has_room_for_one_more_page)
+{
+    open_creator(-1);
+    cr_layout();
+    CHECK(crl.sw >= (CR_TAB_COUNT + 1) * crl.tcell + 30);
+}
+
+TEST(cr_ui_no_caption_repeats_the_tab)
+{
+    int t, i;
+    for (t = 0; t < CR_TAB_COUNT; t++)
+        for (i = 0; i < cr_tabs[t].nrows; i++) {
+            const CrRow *row = &cr_tabs[t].rows[i];
+            if (row->kind != RK_HEADER) continue;
+            CHECK_MSG(strcmp(row->label, cr_tabs[t].name) != 0 && strcmp(row->label, cr_tabs[t].shortname) != 0,
+                      "tab %d caption '%s' repeats the tab", t, row->label);
+        }
+    CHECK(cr_tabs[CR_TAB_HAIR].rows[0].kind != RK_HEADER);
+}
+
+/* CR-UI: a build slider's line says the cheat's reach ("x3"); voice sliders and x1 say nothing */
+TEST(cr_ui_slider_line_names_the_range)
+{
+    const CrRow *h = NULL;
+    char f[64];
+    int i;
+    for (i = 0; i < cr_tabs[CR_TAB_BODY].nrows; i++)
+        if (strcmp(cr_tabs[CR_TAB_BODY].rows[i].label, "Height") == 0) h = &cr_tabs[CR_TAB_BODY].rows[i];
+    CHECK(h != NULL);
+    if (!h) return;
+    open_creator(-1);
+    cr_layout();
+    opt2_set(OPT_SLIDER_RANGE, 0);
+    cr_footer_text(h, crl.lw - 14, f);
+    CHECK(strstr(f, " x") == NULL);
+    opt2_set(OPT_SLIDER_RANGE, 2);
+    cr_footer_text(h, crl.lw - 14, f);
+    CHECK(strstr(f, "x3") != NULL);
+    opt2_set(OPT_SLIDER_RANGE, 0);
+}
