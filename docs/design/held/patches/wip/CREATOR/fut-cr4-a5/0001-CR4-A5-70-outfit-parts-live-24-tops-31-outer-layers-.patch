+# core/data/parts/outfit/tops_b.txt - tops, batch A5 (CR4): 24 tops on the gene list `top` values 25..48.
+# A scripted top is drawn OVER the plain long-sleeved top the painter gives an unknown value, in the top
+# colour: group 1 after the torso (stripes, plackets, emblems, pockets: torso anchor, 256 = the torso
+# half size; on the bust only the upper half shows, y -256 the collar line), group 4 after the head and
+# the arms (collars, necklines, sleeve bands over the arms). The trim colour is the accessory colour.
+# No block draws on a chibi (its torso is 4 x 2 px).
+
+def tdark
+  mat top_color dark
+  shade flat
+  decal
+enddef
+def tlight
+  mat top_color light
+  shade flat
+  decal
+enddef
+def trim
+  mat accessory_color
+  shade ball
+  solid
+enddef
+def trimd
+  mat accessory_color
+  shade flat
+  decal
+enddef
+def trimdark
+  mat accessory_color dark
+  shade flat
+  decal
+enddef
+def sleeves R
+  mat top_color
+  shade ball
+  solid
+  mirror on
+  capsule -215 -170 -165 -10 $R $R
+enddef
+
+list top 25                       # Breton Stripes: bands across the chest and the arms
+block group=1 anchor=torso lod=all view=portrait,figure,fighter
+  use trimd
+  line -250 -190 250 -190 1
+  line -250 -120 250 -120 1
+  line -250 -50 250 -50 1
+  line -250 20 250 20 1
+end
+block group=4 anchor=torso lod=all view=portrait,figure,fighter
+  use trimdark
+  mirror on
+  line -250 -150 -150 -150 1
+  line -230 -90 -150 -90 1
+  line -220 -30 -140 -30 1
+end
+
+list top 26                       # Turtleneck: a tall rolled neck
+block group=4 anchor=torso lod=all view=portrait,figure,fighter
+  mat top_color
+  shade ball
+  solid
+  band 0 -230 160 50
+  use tdark
+  line -150 -230 150 -230 1
+  line -90 -256 -90 -190 1
+  line 0 -256 0 -190 1
+  line 90 -256 90 -190 1
+end
+
+list top 27                       # Polo: a folded collar and a short placket
+block group=4 anchor=torso lod=all view=portrait,figure,fighter
+  mat accessory_color
+  shade ball
+  solid
+  mirror on
+  tri -230 -256 -20 -256 -130 -120
+end
+block group=1 anchor=torso lod=all view=portrait,figure,fighter
+  use trimdark
+  line 0 -100 0 50 1
+  dot 0 -70 1
+  dot 0 -20 1
+  dot 0 30 1
+end
+
+list top 28                       # Henley: a button strip down the chest
+block group=1 anchor=torso lod=all view=portrait,figure,fighter
+  use trim
+  band 0 -90 38 140
+  use trimdark
+  dot 0 -170 1
+  dot 0 -110 1
+  dot 0 -50 1
+  dot 0 10 1
+end
+
+list top 29                       # V-Neck Tee: a deep V
+block group=4 anchor=torso lod=all view=portrait,figure,fighter
+  mat skin
+  shade ball
+  solid
+  tri -150 -256 150 -256 0 -40
+  mat top_color dark
+  shade flat
+  decal
+  line -150 -256 0 -40 1
+  line 150 -256 0 -40 1
+  line -110 -256 0 -90 1
+  line 110 -256 0 -90 1
+end
+
+list top 30                       # Sailor Top: a square collar and a tie
+block group=4 anchor=torso lod=all view=portrait,figure,fighter
+  use trim
+  mirror on
+  tri -240 -256 -20 -256 -220 -60
+  use trimdark
+  line -200 -240 -170 -90 1
+  line -150 -230 -125 -110 1
+end
+block group=1 anchor=torso lod=all view=portrait,figure,fighter
