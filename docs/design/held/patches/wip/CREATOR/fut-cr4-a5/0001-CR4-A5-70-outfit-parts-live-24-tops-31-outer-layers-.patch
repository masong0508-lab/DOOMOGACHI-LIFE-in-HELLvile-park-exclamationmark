+# core/data/parts/wardrobe/outer_b.txt - outer layers (CR4 A5), gene list `outer` values 1..31.
+# The painters' hook draws a script in three layer groups: 0 behind the body (a cape's back), 1 over the
+# top, 4 over the chin (collars, lapels). Torso anchor, 256 = the torso half size. On the bust the torso
+# is 18 x 15 px and only its upper half shows (y -256 is the collar line, y 0 the paws; the shoulders
+# are drawn over group 1), on the figure it is 10 x 6 px and shows whole. The colour is the accessory
+# colour. No block draws on a chibi (its torso is 4 x 2 px).
+
+def body
+  mat accessory_color
+  shade ball
+  solid
+enddef
+def light
+  mat accessory_color light
+  decal
+enddef
+def dark
+  mat accessory_color dark
+  decal
+enddef
+# a front panel pair: the outer edge x, the half width r, from the collar (y0) to the hem (y1)
+def panels X R Y0 Y1
+  mat accessory_color
+  shade ball
+  solid
+  mirror on
+  capsule -$X $Y0 -$X $Y1 $R $R
+enddef
+
+# two sleeves over the arms: the shoulder to the paw, drawn in group 4 (after the arms and the head)
+def sleeves R
+  mat accessory_color
+  shade ball
+  solid
+  mirror on
+  capsule -215 -170 -165 -10 $R $R
+enddef
+def cuffs
+  mat accessory_color light
+  decal
+  mirror on
+  line -200 -50 -135 -40 2
+  line -195 -35 -130 -25 2
+enddef
