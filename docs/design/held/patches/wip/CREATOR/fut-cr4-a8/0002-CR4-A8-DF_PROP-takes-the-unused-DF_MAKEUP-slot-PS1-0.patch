     for (i = 0; i + 1 < len; i += 2) {
         int f = run[i], v = run[i + 1] & 0x7F;
         if (f >= DF_COUNT) continue;
         if (lv == LV_CHIBI && !(doomo_df_flags[f] & DFF_CHIBI)) continue;
