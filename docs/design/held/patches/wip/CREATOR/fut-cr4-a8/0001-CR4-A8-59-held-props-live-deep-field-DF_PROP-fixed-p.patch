diff --git a/core/tests/test_cr4_a8.c b/core/tests/test_cr4_a8.c
new file mode 100644
index 00000000..6d1d73af
--- /dev/null
+++ b/core/tests/test_cr4_a8.c
@@ -0,0 +1,146 @@
+/* test_cr4_a8.c - CR4 art batch A8 (docs/CREATOR.md "CR4 batch A8"): held props, the pool-backed deep field DF_PROP.
+ *
+ * - the catalog: 59 props live and scripted, two of them adult, the rest all ages, under the cost cap;
+ * - every prop changes the bust, the figure and the fighter, and is different from every other (summed over the views);
+ * - the left paw draws it on the other side of the picture; the chibi never draws one;
+ * - the age gate: a minor or a teen never draws an adult prop, even from a pool run;
+ * - fixed colours (`mat wood` ..): a prop is the same colour on a red and a blue citizen (only accessory-colour props change).
+ */
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/part_meta.h"
+#include "doomo/look_fields.h"
+#include "doomo/look_pool.h"
+#include "doomo/portrait.h"
+
+#define A8_LIVE 60
+#define A8_COST_CAP 80
+#define A8_GATE 6
+#define VW (PORTRAIT_W * PORTRAIT_H + FIGURE_W * FIGURE_H + 3 * FIGHTER_W * FIGHTER_H)
+
+static DoomoLook bench(void)
+{
+    DoomoResident r;
+    DoomoLook l;
+    resident_default(&r);
+    l = *RES_LOOK_VIEW(&r);
+    l.top = TOP_TSHIRT; l.top_color = PAINT_LEMON; l.accessory = 0; l.accessory_color = PAINT_COBALT;
+    return l;
+}
+
+static void render(const DoomoLook *l, const DoomoDeep *d, uint8_t *out)
+{
+    portrait_render_deep(l, d, RES_ALIVE, EXPR_NEUTRAL, 0, out);
+    out += PORTRAIT_W * PORTRAIT_H;
+    figure_render_deep(l, d, RES_ALIVE, EXPR_NEUTRAL, 0, out);
+    out += FIGURE_W * FIGURE_H;
+    fighter_render_d(l, d, RES_ALIVE, 4, 0, -1, out);
+    out += FIGHTER_W * FIGHTER_H;
+    fighter_render_d(l, d, RES_ALIVE, 2, 0, -1, out);
+    out += FIGHTER_W * FIGHTER_H;
+    fighter_render_d(l, d, RES_ALIVE, 0, 0, -1, out);
+}
+
+static int diff(const uint8_t *a, const uint8_t *b, int n)
+{
+    int i, c = 0;
+    for (i = 0; i < n; i++) c += a[i] != b[i];
+    return c;
+}
+
+TEST(cr4_a8_the_catalog_has_59_scripted_props_two_of_them_adult)
+{
+    const PartSlotInfo *sl = part_slot_of_list(PL_DEEP0 + DF_PROP);
+    int v, adult = 0;
+    CHECK(sl != NULL);
+    if (!sl) return;
+    CHECK_EQ(sl->live, A8_LIVE);
+    CHECK(!(doomo_df_flags[DF_PROP] & DFF_CHIBI));
+    CHECK(DF_PROP >= DF_POOL_FIRST && DF_PROP < DF_POOL_FIRST + DF_POOL_N);
+    CHECK_EQ(DF_LASH, 6);                        /* the ids of the CR5 saves did not move */
+    for (v = 1; v < A8_LIVE; v++) {
+        const PartMeta *m = part_meta_find(PL_DEEP0 + DF_PROP, v);
+        CHECK_MSG(m, "prop %d missing", v);
+        if (!m) continue;
+        CHECK(PMF_STATE(m->flags) == PSTATE_LIVE);
+        CHECK(m->flags & PMF_SCRIPTED);
+        CHECK_MSG(m->cost <= A8_COST_CAP, "prop %d costs %d", v, m->cost);
+        if (PMF_AGE(m->flags) == PAGE_ADULT) adult++;
+        else CHECK_EQ(PMF_AGE(m->flags), PAGE_ALL);
+    }
+    CHECK_EQ(adult, 2);
+}
+
+TEST(cr4_a8_every_prop_draws_and_every_pair_differs)
+{
+    static uint8_t pic[A8_LIVE][VW], base[VW];
+    DoomoDeep d0 = doomo_deep_zero;
+    DoomoLook l = bench();
+    int v, w, bad = 0;
+    render(&l, &d0, base);
+    for (v = 1; v < A8_LIVE; v++) {
+        DoomoDeep d = doomo_deep_zero;
+        d.v[DF_PROP] = (uint8_t)v;
+        render(&l, &d, pic[v]);
+        if (diff(base, pic[v], VW) < 8) { fprintf(stderr, "    prop %d draws nothing\n", v); bad++; }
+    }
+    for (v = 1; v < A8_LIVE; v++)
+        for (w = 1; w < v; w++)
+            if (diff(pic[v], pic[w], VW) < A8_GATE) { fprintf(stderr, "    props %d and %d differ by %d px\n", v, w, diff(pic[v], pic[w], VW)); bad++; }
+    CHECK_EQ(bad, 0);
+}
+
+TEST(cr4_a8_the_left_paw_holds_it_on_the_other_side_and_the_chibi_never_draws_one)
+{
+    static uint8_t r[PORTRAIT_W * PORTRAIT_H], lf[PORTRAIT_W * PORTRAIT_H];
+    static uint8_t a[BODYSPR_W * BODYSPR_H], b[BODYSPR_W * BODYSPR_H];
+    DoomoDeep d = doomo_deep_zero, dl;
+    DoomoLook l = bench();
+    d.v[DF_PROP] = 5;
+    dl = d;
+    dl.v[DF_HANDED] = 1;
+    portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, r);
+    portrait_render_deep(&l, &dl, RES_ALIVE, EXPR_NEUTRAL, 0, lf);
+    CHECK(diff(r, lf, PORTRAIT_W * PORTRAIT_H) > 10);
+    bodyspr_render_deep(&l, &doomo_deep_zero, RES_ALIVE, 0, 0, a);
+    bodyspr_render_deep(&l, &d, RES_ALIVE, 0, 0, b);
+    CHECK(memcmp(a, b, sizeof(a)) == 0);
+}
+
+TEST(cr4_a8_a_minor_never_draws_an_adult_prop_even_from_a_pool_run)
+{
+    static const uint8_t run[] = { DF_PROP, 15 };       /* Wine Glass */
+    static const uint8_t run2[] = { DF_PROP, 14 };      /* Soda Cup */
+    int stage;
+    look_pool_load(NULL, 0);
+    for (stage = 0; stage < LIFE_COUNT; stage++) {
+        DoomoResident r;
+        DoomoDeep d;
+        int grown = stage == LIFE_ADULT || stage == LIFE_ELDER;      /* teens are not adults either */
+        resident_default(&r);
+        gene_set(r.gene, GF_AGE, (uint32_t)stage);
+        CHECK(look_pool_put(12, RUN_DEEP, run, (int)sizeof(run)));
+        look_resolve_mask(&r, 12, LV_ALL, &d);
+        CHECK_EQ(d.v[DF_PROP], grown ? 15 : 0);
+        CHECK(look_pool_put(12, RUN_DEEP, run2, (int)sizeof(run2)));
+        look_resolve_mask(&r, 12, LV_ALL, &d);
+        CHECK_EQ(d.v[DF_PROP], 14);
+        CHECK(look_pool_put(12, RUN_DEEP, NULL, 0));
+    }
+}
+
+TEST(cr4_a8_fixed_colours_do_not_follow_the_citizens_colours)
+{
+    static uint8_t a[VW], b[VW];
+    DoomoDeep d = doomo_deep_zero;
+    DoomoLook l1 = bench(), l2 = bench();
+    l2.accessory_color = PAINT_CHERRY;
+    d.v[DF_PROP] = 8;                                   /* Apple: fixed colours only */
+    render(&l1, &d, a);
+    render(&l2, &d, b);
+    CHECK(memcmp(a, b, sizeof(a)) == 0);
+    d.v[DF_PROP] = 28;                                  /* Balloon: the accessory colour */
+    render(&l1, &d, a);
+    render(&l2, &d, b);
+    CHECK(memcmp(a, b, sizeof(a)) != 0);
+}
