+6   "Bandit Mask"     set=critter tags=critter,silly method=S
+7   "Blaze"           set=critter tags=critter method=S
+8   "Half and Half"   set=indieart tags=silly method=S
+9   "Freckle Dust"    set=basics tags=cute method=S
+10  "Brindle"         set=critter tags=critter method=S
+11  "Temple Patches"  set=critter tags=critter method=S
