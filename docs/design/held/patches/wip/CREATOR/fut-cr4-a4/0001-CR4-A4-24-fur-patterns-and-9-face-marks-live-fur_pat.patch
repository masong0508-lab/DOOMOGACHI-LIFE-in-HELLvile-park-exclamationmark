+13  "Heart Patch"     set=candy tags=cute method=S
+14  "Speckles"        set=basics tags=plain,nature method=S
+15  "Zebra Bars"      set=critter tags=critter method=S
+16  "Giraffe Tiles"   set=critter tags=critter,nature method=S
