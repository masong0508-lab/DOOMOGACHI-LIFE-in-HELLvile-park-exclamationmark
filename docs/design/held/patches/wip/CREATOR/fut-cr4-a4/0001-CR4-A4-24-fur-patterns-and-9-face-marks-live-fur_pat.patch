+# core/data/parts/catalog/fur_pattern.txt - fur patterns, gene field fur_pattern (CR4 A4; format: tools/partcat_build.py).
+# Scripted head decals in the third fur colour (core/data/parts/fur/fur_a4.txt); value 0 draws nothing.
+slot fur_pattern list=fur_pattern name="Fur patterns" method=P target=24 new=T gate=24
+
+0   "None"            set=basics tags=plain
+1   "Tabby Stripes"   set=critter tags=critter method=S
+2   "Leopard Spots"   set=critter tags=critter,spooky method=S
+3   "Cow Patches"     set=critter tags=critter,silly method=S
+4   "Dalmatian Dots"  set=critter tags=critter,silly method=S
