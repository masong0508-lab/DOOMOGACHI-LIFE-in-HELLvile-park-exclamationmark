 typedef struct A7Slot { const char *key; int df, live, gate, age; } A7Slot;
 /* gate: the least pixel difference between two parts of the slot summed over the views below (measured on 2026-11-15) */
@@ -181,3 +182,46 @@ TEST(cr4_a7_the_accessory_set_is_the_registry_tail_so_the_ps1_can_drop_it)
         CHECK_EQ(e->set == doomo_part_script_count - 1, e->list >= 128 + DF_MASK);
     }
 }
+
+/* TEXT FITS EVERYWHERE (owner 2026-11-15): every A7 part name fits the value column of its row (not selected, scroll bar
+ * showing: the narrowest case) and the grid caption, at 240x160 and 320x240, and every row label leaves room for it. */
+static void a7_res(int w, int h)
+{
+    NatOptions o;
+    memset(&o, 0, sizeof(o));
+    o.w = w; o.h = h; o.seed = 0x5EED1234u; o.quiet = 1;
+    o.save_dir = test_tmp_dir;
+    nat_init(&o);
+    cr_layout();
+}
+
+static int a7_fit_at(int w, int h)
+{
+    int tab, i, bad = 0, rows = 0;
+    a7_res(w, h);
+    for (tab = 0; tab < CR_TAB_COUNT; tab++) {
+        const CrRow *row;
+        for (i = 0; (row = cr_row_at(tab, i)) != NULL; i++) {
+            int n, c;
+            if (row->kind != RK_DEEP || row->field < CR_DEEP0 + DF_MASK || row->field > CR_DEEP0 + DF_PIERCE) continue;
+            rows++;
+            n = cr_row_count(row);
+            for (c = 0; c < n; c++) {
+                char b[48];
+                const char *nm = cr_choice_name(row, c, b);
+                if (ui_text_width(nm) > cr_value_room(row) || ui_text_width(nm) > crl.lw - 16) {
+                    printf("A7 text does not fit at %dx%d: row \"%s\" part \"%s\" (%d px, room %d)\n", w, h,
+                           cr_row_label(row), nm, ui_text_width(nm), cr_value_room(row));
+                    bad++;
+                }
+            }
+        }
+    }
+    return rows == 8 ? bad : 1000 + rows;      /* the eight A7 rows were all found */
+}
+
+TEST(cr4_a7_every_part_name_fits_its_row_and_the_caption_on_both_screens)
+{
+    CHECK_EQ(a7_fit_at(240, 160), 0);
+    CHECK_EQ(a7_fit_at(320, 240), 0);
+}
