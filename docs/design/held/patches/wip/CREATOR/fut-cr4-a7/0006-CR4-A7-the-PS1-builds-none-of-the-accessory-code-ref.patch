+                text = text[:k] + "#if !defined(DOOMO_PLATFORM_PS1)       /* DOOMO_ACC_DEEP 0 */\n" + text[k:] + "#endif\n"
             with open(os.path.join(root, "core", "gen", "parts_%s.c" % d), "w") as f:
