diff --git a/core/include/doomo/look_fields.h b/core/include/doomo/look_fields.h
index 063ece6f..1184828b 100644
--- a/core/include/doomo/look_fields.h
+++ b/core/include/doomo/look_fields.h
@@ -33,6 +33,16 @@ enum {
 /* CR5: the deep fields the look pool carries and the save keeps (look_pool.c, the creator's chunk): the
  * ones with no gene field. The others (DF_PUPIL .. DF_HOOD_HEAD, DF_FUR_PATTERN .. DF_HANDED) ride in
  * the gene (look_gene_deep). */
+/* CR4 A7: the accessory rows (DF_MASK .. DF_PIERCE) are drawn and offered on every platform but the PS1: its resident
+ * share (CREATOR 21,504 B, CR10) has 480 B left and the painters' hooks, the part refs and the age gate cost 1,376 B.
+ * The pool run, the save and the look hash carry the ids everywhere (a GBA look shows on the PS1 without them). */
+#ifndef DOOMO_ACC_DEEP
+#if defined(DOOMO_PLATFORM_PS1)
+#define DOOMO_ACC_DEEP 0
+#else
+#define DOOMO_ACC_DEEP 1
+#endif
+#endif
 #define DF_POOL_FIRST DF_LASH
 #define DF_POOL_N     (DF_PIERCE - DF_LASH + 1)
 
