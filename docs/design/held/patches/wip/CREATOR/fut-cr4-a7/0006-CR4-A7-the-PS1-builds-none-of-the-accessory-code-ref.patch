+# CR4 A7: the sets the PS1 does not build yet (DOOMO_ACC_DEEP 0, look_fields.h): no resident PartRef rows there, and
+# partsbin.py leaves them out of PARTS.BIN. They sort last, so the PS1's registry is a prefix of everyone's.
+PS1_SKIP = ("acc",)
+
+
 def part_dirs():
     base = os.path.join(ROOT, "core", "data", "parts")
-    return [d for d in sorted(os.listdir(base)) if d != "catalog" and os.path.isdir(os.path.join(base, d))]
+    return sorted((d for d in os.listdir(base) if d != "catalog" and os.path.isdir(os.path.join(base, d))),
+                  key=lambda d: (d in PS1_SKIP, d))
 
 
