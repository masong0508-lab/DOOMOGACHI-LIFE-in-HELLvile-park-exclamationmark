          " * DO NOT EDIT: add a dir under core/data/parts/ and run `python3 tools/parts_build.py`. */",
          '#include "doomo/doomo.h"', '#include "doomo/parts.h"', ""]
+    nps1 = len([d for d in dirs if d not in PS1_SKIP])               # the PS1's sets: a prefix
+    skipl = [lst for lst in sorted(owner) if dirs[owner[lst]] in PS1_SKIP]
+    if skipl != sorted(owner)[len(owner) - len(skipl):]:
+        raise PartError("a skipped set's lists must have the highest list ids (the PS1 drops the table's tail)")
     L += ["extern const PartSet doomo_parts_%s;" % d for d in dirs]
     L += ["", "const PartSet *const doomo_part_scripts[%d] = {" % max(1, len(dirs))]
-    L += ["    &doomo_parts_%s," % d for d in dirs] or ["    0,"]
-    L += ["};", "const uint8_t doomo_part_script_count = %d;" % len(dirs), "",
+    for i, d in enumerate(dirs):
+        if i == nps1 and nps1 < len(dirs):
+            L.append("#if !defined(DOOMO_PLATFORM_PS1)       /* CR4 A7: not on the PS1 (DOOMO_ACC_DEEP 0) */")
+        L.append("    &doomo_parts_%s," % d)
+    L += (["#endif"] if nps1 < len(dirs) else []) + ["};"]
+    L += ["#if defined(DOOMO_PLATFORM_PS1)", "const uint8_t doomo_part_script_count = %d;" % nps1, "#else",
+          "const uint8_t doomo_part_script_count = %d;" % len(dirs), "#endif", "",
           "const PartListSet doomo_part_script_lists[%d] = {" % max(1, len(owner))]
-    L += ["    { %d, %d, %d }," % (lst, owner[lst], allmin[lst]) for lst in sorted(owner)] or ["    { 0xFFFF, 0, 255 },"]
-    L += ["};", "const uint8_t doomo_part_script_nlists = %d;" % len(owner), "",
+    for lst in sorted(owner):
+        if lst == (skipl[0] if skipl else None):
+            L.append("#if !defined(DOOMO_PLATFORM_PS1)")
+        L.append("    { %d, %d, %d }," % (lst, owner[lst], allmin[lst]))
+    if not owner: L.append("    { 0xFFFF, 0, 255 },")
+    L += (["#endif"] if skipl else []) + ["};",
+          "#if defined(DOOMO_PLATFORM_PS1)", "const uint8_t doomo_part_script_nlists = %d;" % (len(owner) - len(skipl)), "#else",
+          "const uint8_t doomo_part_script_nlists = %d;" % len(owner), "#endif", "",
           "/* the smallest scripted value of each gene list (0xFF: none) */",
           "const uint8_t doomo_part_minv[128] = {"]
     mv = [allmin.get(i, 255) for i in range(128)]
@@ -789,6 +810,9 @@ def main(argv):
         os.makedirs(os.path.join(root, "core", "gen"), exist_ok=True)
         for d in dirs:
