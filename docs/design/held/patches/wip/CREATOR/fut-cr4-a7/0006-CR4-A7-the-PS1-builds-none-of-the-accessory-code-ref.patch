     ((value) >= doomo_part_minv[(list)] && ps_slot((c), (list), (value), (group)))
 #define PS_SCRIPTED(value, list) ((value) >= doomo_part_minv[(list)])
 /* CR4 A7: the pool-backed deep accessory fields (DF_MASK .. DF_PIERCE): the worn value's blocks of group `group` */
+#if DOOMO_ACC_DEEP
 #define PS_DEEP(c, df, group) \
     ((c)->d->v[(df)] && ps_slot((c), 128 + (df), (c)->d->v[(df)], (group)))     /* 128 = PL_DEEP0 */
 #define PS_DEEP_FRAME(c, df, group) \
     ((c)->d->v[(df)] && ps_slot_frame((c), 128 + (df), (c)->d->v[(df)], (group)))
+#else
+#define PS_DEEP(c, df, group) ((void)(c), 0)                 /* the PS1 (look_fields.h DOOMO_ACC_DEEP) */
+#define PS_DEEP_FRAME(c, df, group) ((void)(c), 0)
+#endif
 #define PS_SLOT_FRAME(c, list, value, group) \
     ((value) >= doomo_part_minv[(list)] && ps_slot_frame((c), (list), (value), (group)))
 #else
diff --git a/core/tests/test_cr4_a7.c b/core/tests/test_cr4_a7.c
index 0d2a285d..356bd86b 100644
--- a/core/tests/test_cr4_a7.c
+++ b/core/tests/test_cr4_a7.c
@@ -12,6 +12,7 @@
 #include "test.h"
 #include "doomo/doomo.h"
 #include "doomo/part_meta.h"
+#include "doomo/parts.h"
 #include "doomo/look_fields.h"
 #include "doomo/look_pool.h"
 #include "doomo/portrait.h"
@@ -166,3 +167,17 @@ TEST(cr4_a7_a_teen_only_pool_run_does_not_resolve_on_a_minor)
         CHECK(look_pool_put(12, RUN_DEEP, NULL, 0));
     }
 }
+
+/* The PS1 builds the registry without the accessory set (DOOMO_ACC_DEEP 0; parts_index.c drops the last set and the last
+ * list rows there): the set must be last and own only the highest list ids, or the PS1's prefix would hold holes. */
+extern const PartSet doomo_parts_acc;
+TEST(cr4_a7_the_accessory_set_is_the_registry_tail_so_the_ps1_can_drop_it)
+{
+    int i;
+    CHECK_EQ(doomo_part_script_count, 10);
+    CHECK(doomo_part_scripts[doomo_part_script_count - 1] == &doomo_parts_acc);
+    for (i = 0; i < doomo_part_script_nlists; i++) {
+        const PartListSet *e = &doomo_part_script_lists[i];
+        CHECK_EQ(e->set == doomo_part_script_count - 1, e->list >= 128 + DF_MASK);
+    }
+}
