+static void acc_rows(const char *key, int *out, int max)
+{
+    int i, n = 0;
+    for (i = 0; i < PART_SLOT_COUNT; i++) {
+        const PartSlotInfo *sl = &doomo_part_slots[i];
+        int k;
+        if (strcmp(sl->key, key)) continue;
+        for (k = sl->first; k < sl->first + sl->count && n < max; k++)
+            if (doomo_part_meta[k].value && PMF_STATE(doomo_part_meta[k].flags) == PSTATE_LIVE) out[n++] = k;
+    }
+    out[n] = -1;
+}
