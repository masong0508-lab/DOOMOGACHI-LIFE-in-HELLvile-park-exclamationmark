+    CHECK_EQ(DF_LID, 7);
+    CHECK_EQ(DF_LINER, 8);
+    for (s = 0; s < 8; s++) {
+        CHECK(slots[s].df >= DF_POOL_FIRST && slots[s].df < DF_POOL_FIRST + DF_POOL_N);
+        CHECK(!(doomo_df_flags[slots[s].df] & DFF_CHIBI));
+    }
+}
+
+TEST(cr4_a7_every_slot_has_its_first_tranche_live_scripted_and_inside_the_cost_cap)
+{
+    int s, v, total = 0;
+    for (s = 0; s < 8; s++) {
+        const PartSlotInfo *sl = part_slot_of_list(PL_DEEP0 + slots[s].df);
+        CHECK_MSG(sl != NULL, "slot %s", slots[s].key);
+        if (!sl) continue;
+        CHECK_EQ(sl->live, slots[s].live);
+        for (v = 1; v < slots[s].live; v++) {
+            const PartMeta *m = part_meta_find(PL_DEEP0 + slots[s].df, v);
+            CHECK_MSG(m, "%s %d missing", slots[s].key, v);
+            if (!m) continue;
+            CHECK(PMF_STATE(m->flags) == PSTATE_LIVE);
+            CHECK(m->flags & PMF_SCRIPTED);
+            CHECK_EQ(PMF_AGE(m->flags), slots[s].age);
+            CHECK_MSG(m->cost <= A7_COST_CAP, "%s %d costs %d", slots[s].key, v, m->cost);
+            total++;
+        }
+    }
+    CHECK(total >= 100);
+}
+
+TEST(cr4_a7_every_part_changes_the_picture_and_every_pair_differs_by_the_gate)
+{
+    static uint8_t pic[24][VW];
+    static uint8_t base[VW];
+    int s, v, w, bad = 0;
+    DoomoDeep d0 = doomo_deep_zero;
+    DoomoLook l = bench();
+    render(&l, &d0, base);
+    for (s = 0; s < 8; s++) {
+        int n = slots[s].live;
+        for (v = 1; v < n; v++) {
+            DoomoDeep d = doomo_deep_zero;
+            d.v[slots[s].df] = (uint8_t)v;
+            render(&l, &d, pic[v]);
+            if (diff(base, pic[v], VW) < 3) { fprintf(stderr, "    %s %d draws nothing\n", slots[s].key, v); bad++; }
+        }
+        for (v = 1; v < n; v++)
+            for (w = 1; w < v; w++)
+                if (diff(pic[v], pic[w], VW) < slots[s].gate) {
+                    fprintf(stderr, "    %s %d and %d differ by %d px\n", slots[s].key, v, w, diff(pic[v], pic[w], VW));
+                    bad++;
+                }
+    }
+    CHECK_EQ(bad, 0);
+}
+
+TEST(cr4_a7_the_chibi_never_changes)
+{
+    static uint8_t a[BODYSPR_W * BODYSPR_H], b[BODYSPR_W * BODYSPR_H];
