index 00000000..4580b1c4
--- /dev/null
+++ b/core/tests/test_cr4_a7.c
@@ -0,0 +1,149 @@
+/* test_cr4_a7.c - CR4 art batch A7 (docs/CREATOR.md "CR4 batch A7"): masks, neckwear, backpieces, gloves, wristwear, belts, ear
+ * jewellery and face piercings, the pool-backed deep fields DF_MASK .. DF_PIERCE.
+ *
+ * - the catalog: every slot has its first tranche live and scripted, piercings are teen, the rest all ages, under the cost cap;
+ * - the deep ids of the old saves did not move (DF_LASH .. DF_LINER), the new ones sit inside the pool range;
+ * - the hooks: every part changes the picture (bust, figure, fighter from behind and in front) and every pair of a slot differs by
+ *   at least the slot's gate, summed over those views; without a painter hook all of them would render alike;
+ * - the chibi never changes (the fields are not chibi-visible: crowds pay nothing);
+ * - a run in the look pool resolves to the new fields and a part above the citizen's age is not asked for here (the age gate swaps
+ *   a part, see test_part_age.c).
+ */
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/part_meta.h"
+#include "doomo/look_fields.h"
+#include "doomo/look_pool.h"
+#include "doomo/portrait.h"
+
+typedef struct A7Slot { const char *key; int df, live, gate, age; } A7Slot;
+/* gate: the least pixel difference between two parts of the slot summed over the views below (measured on 2026-11-15) */
+static const A7Slot slots[8] = {
+    { "mask", DF_MASK, 18, 20, PAGE_ALL },   { "neck", DF_NECK, 21, 6, PAGE_ALL },     { "back", DF_BACK, 20, 12, PAGE_ALL },
+    { "gloves", DF_GLOVE, 10, 6, PAGE_ALL }, { "wrist", DF_WRIST, 10, 4, PAGE_ALL },   { "belt", DF_BELT, 14, 6, PAGE_ALL },
+    { "ear_acc", DF_EARJEW, 15, 4, PAGE_ALL }, { "face_pierce", DF_PIERCE, 11, 3, PAGE_TEEN },
+};
+#define A7_COST_CAP 60
+
+static DoomoLook bench(void)
+{
+    DoomoResident r;
+    DoomoLook l;
+    resident_default(&r);
+    l = *RES_LOOK_VIEW(&r);
+    l.accessory_color = PAINT_COBALT;
+    l.top = TOP_TSHIRT; l.top_color = PAINT_LEMON; l.bottom = BOTTOM_PANTS;
+    return l;
+}
+
+/* bust, figure, fighter from behind, fighter in front, concatenated */
+#define VW (PORTRAIT_W * PORTRAIT_H + FIGURE_W * FIGURE_H + 2 * FIGHTER_W * FIGHTER_H)
+static void render(const DoomoLook *l, const DoomoDeep *d, uint8_t *out)
+{
+    portrait_render_deep(l, d, RES_ALIVE, EXPR_NEUTRAL, 0, out);
+    out += PORTRAIT_W * PORTRAIT_H;
+    figure_render_deep(l, d, RES_ALIVE, EXPR_NEUTRAL, 0, out);
+    out += FIGURE_W * FIGURE_H;
+    fighter_render_d(l, d, RES_ALIVE, 0, 0, -1, out);
+    out += FIGHTER_W * FIGHTER_H;
+    fighter_render_d(l, d, RES_ALIVE, 3, 0, -1, out);
+}
+
+static int diff(const uint8_t *a, const uint8_t *b, int n)
+{
+    int i, c = 0;
+    for (i = 0; i < n; i++) c += a[i] != b[i];
+    return c;
+}
+
+TEST(cr4_a7_deep_ids_of_old_saves_did_not_move_and_the_new_ones_are_in_the_pool_range)
+{
+    int s;
