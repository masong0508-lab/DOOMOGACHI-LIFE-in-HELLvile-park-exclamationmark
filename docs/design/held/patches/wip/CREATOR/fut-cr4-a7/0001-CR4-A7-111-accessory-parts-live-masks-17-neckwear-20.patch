+    bodyspr_render_deep(&l, &d0, RES_ALIVE, 0, 0, a);
+    for (s = 0; s < 8; s++) {
+        DoomoDeep d = doomo_deep_zero;
+        d.v[slots[s].df] = 1;
+        bodyspr_render_deep(&l, &d, RES_ALIVE, 0, 0, b);
+        CHECK_MSG(memcmp(a, b, sizeof(a)) == 0, "%s shows on the chibi", slots[s].key);
+    }
+}
+
+TEST(cr4_a7_a_pool_run_resolves_to_the_new_fields)
+{
+    static const uint8_t run[] = { DF_MASK, 3, DF_BACK, 5, DF_PIERCE, 2, DF_LASH, 1 };
+    DoomoDeep d;
+    int len;
+    look_pool_load(NULL, 0);
+    CHECK(look_pool_put(9, RUN_DEEP, run, (int)sizeof(run)));
+    look_resolve(NULL, 9, &d);
+    CHECK_EQ(d.v[DF_MASK], 3);
+    CHECK_EQ(d.v[DF_BACK], 5);
+    CHECK_EQ(d.v[DF_PIERCE], 2);
+    CHECK_EQ(d.v[DF_LASH], 1);
+    CHECK_EQ(d.v[DF_NECK], 0);
+    CHECK(look_pool_find(9, RUN_DEEP, &len) != NULL && len == (int)sizeof(run));
+    CHECK(look_pool_put(9, RUN_DEEP, NULL, 0));
+}
