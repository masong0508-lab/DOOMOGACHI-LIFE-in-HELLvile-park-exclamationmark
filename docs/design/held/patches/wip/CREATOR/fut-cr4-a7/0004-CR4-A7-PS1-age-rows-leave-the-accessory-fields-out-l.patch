From e54a33c5c257c76db50bd7fe5a8b1a64af063b27 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 19:36:42 +0000
Subject: [PATCH 4/9] CR4 A7: PS1 age rows leave the accessory fields out;
 look_pool stage only where pool runs are saved

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xd63cvvRYHgPW3b8GJby1n
---
 core/gen/part_age_data.c |  7 +++++++
 core/src/look_pool.c     |  2 ++
 tools/partcat_build.py   | 12 ++++++++----
 3 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/core/gen/part_age_data.c b/core/gen/part_age_data.c
index e490387b..e33327f9 100644
--- a/core/gen/part_age_data.c
+++ b/core/gen/part_age_data.c
@@ -3,6 +3,12 @@
  * (src/part_age.c, the renderer and the generators read it). DO NOT EDIT. */
 #include "doomo/part_meta.h"
 
+#if defined(DOOMO_PLATFORM_PS1)       /* CR4 A7: no pool-backed accessory parts on the PS1 */
+const PartAgeRow doomo_part_age_rows[1] = {
+    { 0xFFFF, 0, 0 },     /* none yet: a sentinel */
+};
+const uint16_t doomo_part_age_count = 0;
+#else
 const PartAgeRow doomo_part_age_rows[10] = {
     { 144, 1, 1 },
     { 144, 2, 1 },
@@ -16,3 +22,4 @@ const PartAgeRow doomo_part_age_rows[10] = {
     { 144, 10, 1 },
 };
 const uint16_t doomo_part_age_count = 10;
+#endif
diff --git a/core/src/look_pool.c b/core/src/look_pool.c
index 4fe0d32d..18605f07 100644
--- a/core/src/look_pool.c
+++ b/core/src/look_pool.c
@@ -106,7 +106,9 @@ void look_resolve_mask(const DoomoResident *r, int id, uint32_t lv, DoomoDeep *o
     look_gene_deep(r, lv, out);                         /* CR3: the gene's own new fields (r may be NULL) */
     run = look_pool_find(id, RUN_DEEP, &len);
     if (!run) return;
+#if LOOK_POOL_SAVED                                     /* (the PS1 has no pool puts: no deep run to gate there) */
     if (r) stage = (int)gene_get(r->gene, GF_AGE);
+#endif
     for (i = 0; i + 1 < len; i += 2) {
         int f = run[i], v = run[i + 1] & 0x7F;
         if (f >= DF_COUNT) continue;
diff --git a/tools/partcat_build.py b/tools/partcat_build.py
index 67b1b409..73c5e42c 100644
--- a/tools/partcat_build.py
+++ b/tools/partcat_build.py
@@ -515,10 +515,14 @@ def emit(cat):
     A = ["/* part_age_data.c - GENERATED by tools/partcat_build.py from core/data/parts/catalog/ (CR12).",
          " * The parts whose age class is not ALL, sorted by (list, value): resident on every platform",
          " * (src/part_age.c, the renderer and the generators read it). DO NOT EDIT. */",
-         '#include "doomo/part_meta.h"', "",
-         "const PartAgeRow doomo_part_age_rows[%d] = {" % max(1, len(ages))]
-    A += ["    { %d, %d, %d }," % r for r in ages] or ["    { 0xFFFF, 0, 0 },     /* none yet: a sentinel */"]
-    A += ["};", "const uint16_t doomo_part_age_count = %d;" % len(ages), ""]
+         '#include "doomo/part_meta.h"', ""]
+    pages = sorted((s["list"], p["value"], p["age"]) for s, p in parts if p["age"] and not ps1_skipped(s))
+    for tag, rows in (("#if defined(DOOMO_PLATFORM_PS1)       /* CR4 A7: no pool-backed accessory parts on the PS1 */", pages), ("#else", ages)):
+        A.append(tag)
+        A.append("const PartAgeRow doomo_part_age_rows[%d] = {" % max(1, len(rows)))
+        A += ["    { %d, %d, %d }," % r for r in rows] or ["    { 0xFFFF, 0, 0 },     /* none yet: a sentinel */"]
+        A += ["};", "const uint16_t doomo_part_age_count = %d;" % len(rows)]
+    A += ["#endif", ""]
     M = ["/* CR3: the live count of every gene list (index: GF_* id): its values 0..N-1 are selectable,",
           " * saved and kept by resident_sanitize; 0 for a field that is not a catalogued part list. */",
           "const uint8_t doomo_part_live[PART_GENE_FIELDS] = {"]
-- 
