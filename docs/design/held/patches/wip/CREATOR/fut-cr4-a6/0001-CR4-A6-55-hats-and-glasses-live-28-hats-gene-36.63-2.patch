index 00000000..a85db798
--- /dev/null
+++ b/core/tests/test_cr4_a6.c
@@ -0,0 +1,224 @@
+/* test_cr4_a6.c - CR4 art batch A6 (hats and glasses), docs/CREATOR.md "CR4 batch A6": the gene-stored parts of the
+ * accessory rows: 28 hats (gene `hat` 36..63, the list is full: 64) and 27 glasses (gene `glasses` 5..31, full: 32).
+ *
+ * - both lists are full, every new part is catalogued, scripted, live, age class ALL and inside the cost cap;
+ * - the shape gate the generic test (test_part_render.c) cannot run for glasses (a gene-only field): every pair differs from
+ *   every other value by its pixels on the bust, with the eyes at the sheet's size;
+ * - every glasses value shows on the bust (>= 10 px), the figure (>= 3 px) and the chibi (>= A6_CHIBI_MIN px);
+ * - every hat shows on the bust and the figure, and no hat or glasses costs more than the cap;
+ * - a child may wear all of it, and the gene values survive a save and resident_sanitize;
+ * - glasses go with every hat and with the painted accessory glasses (their own slot).
+ */
+#include "test.h"
+#include "doomo/doomo.h"
+#include "doomo/part_meta.h"
+#include "doomo/look_fields.h"
+#include "doomo/portrait.h"
+#include "doomo/save.h"
+
+#define A6_COST_CAP 48
+#define A6_CHIBI_MIN 8               /* px of the chibi the glasses change (measured minimum 9) */
+#define A6_GLASSES_MIN_DIFF 20       /* px of the bust between two pairs of glasses (measured minimum 24 on 2026-11-15) */
+
+typedef struct A6Range { int list, first, last, live; } A6Range;
+static const A6Range ranges[2] = { { GF_HAT, 36, 63, 64 }, { GF_GLASSES, 5, 31, 32 } };
+
+static DoomoLook bench(void)
+{
+    DoomoResident r;
+    DoomoLook l;
+    resident_default(&r);
+    l = *RES_LOOK_VIEW(&r);
+    l.accessory_color = PAINT_COBALT;
+    l.hat_color = PAINT_LAVENDER;
+    l.eye_size = 12;                                   /* the sheet's size: the pairs read */
+    return l;
+}
+
+static int diff(const uint8_t *a, const uint8_t *b, int n)
+{
+    int i, d = 0;
+    for (i = 0; i < n; i++) d += a[i] != b[i];
+    return d;
+}
+
+TEST(cr4_a6_lists_are_full_and_every_new_part_is_catalogued)
+{
+    int s, v, n = 0;
+    for (s = 0; s < 2; s++) {
+        CHECK_EQ(part_live_count(ranges[s].list), ranges[s].live);
+        for (v = ranges[s].first; v <= ranges[s].last; v++) {
+            const PartMeta *m = part_meta_find(ranges[s].list, v);
+            CHECK_MSG(m, "list %d value %d missing", ranges[s].list, v);
+            if (!m) continue;
+            CHECK(PMF_STATE(m->flags) == PSTATE_LIVE);
+            CHECK(m->flags & PMF_SCRIPTED);
+            CHECK_EQ(PMF_AGE(m->flags), PAGE_ALL);
+            CHECK_MSG(m->cost <= A6_COST_CAP, "%s costs %d", part_meta_name(m), m->cost);
+            n++;
+        }
+    }
+    CHECK_EQ(n, 55);
+}
+
+TEST(cr4_a6_glasses_differ_from_every_other_value)
+{
+    static uint8_t bust[32][PORTRAIT_W * PORTRAIT_H];
+    int v, o, bad = 0, min = 1 << 30;
+    for (v = 0; v < 32; v++) {
+        DoomoLook l = bench();
+        DoomoDeep d = doomo_deep_zero;
+        look_part_set(&l, &d, GF_GLASSES, v);
+        portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, bust[v]);
+    }
+    for (v = 5; v <= 31; v++)
+        for (o = 0; o < 32; o++) {
+            int dd;
+            if (o == v) continue;
+            dd = diff(bust[v], bust[o], PORTRAIT_W * PORTRAIT_H);
+            if (dd < min) min = dd;
+            if (dd < A6_GLASSES_MIN_DIFF) {
+                fprintf(stderr, "    glasses %d vs %d differ by %d px\n", v, o, dd);
+                bad++;
+            }
+        }
+    fprintf(stderr, "    glasses bust min pair diff %d px\n", min);
+    CHECK_EQ(bad, 0);
+    CHECK(min >= A6_GLASSES_MIN_DIFF);
+}
+
+TEST(cr4_a6_glasses_show_on_the_bust_the_figure_and_the_chibi)
+{
+    static uint8_t a[PORTRAIT_W * PORTRAIT_H], b[PORTRAIT_W * PORTRAIT_H];
+    static uint8_t fa[FIGURE_W * FIGURE_H], fb[FIGURE_W * FIGURE_H];
+    static uint8_t sa[BODYSPR_W * BODYSPR_H], sb[BODYSPR_W * BODYSPR_H];
+    int v, bad = 0, cd, cmin = 1 << 30;
+    for (v = 5; v <= 31; v++) {
+        DoomoLook l = bench(), z = bench();
+        DoomoDeep d = doomo_deep_zero, dz = doomo_deep_zero;
+        look_part_set(&l, &d, GF_GLASSES, v);
+        portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, a);
+        portrait_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, b);
+        if (diff(a, b, (int)sizeof(a)) < 10) { fprintf(stderr, "    glasses %d hidden on the bust\n", v); bad++; }
+        figure_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, fa);
+        figure_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, fb);
+        if (diff(fa, fb, (int)sizeof(fa)) < 3) { fprintf(stderr, "    glasses %d hidden on the figure\n", v); bad++; }
+        bodyspr_render_deep(&l, &d, RES_ALIVE, 0, 0, sa);
+        bodyspr_render_deep(&z, &dz, RES_ALIVE, 0, 0, sb);
+        cd = diff(sa, sb, (int)sizeof(sa));
+        if (cd < cmin) cmin = cd;
+        if (cd < A6_CHIBI_MIN) { fprintf(stderr, "    glasses %d hidden on the chibi (%d px)\n", v, cd); bad++; }
+    }
+    fprintf(stderr, "    glasses chibi min diff %d px\n", cmin);
+    CHECK_EQ(bad, 0);
+}
+
+TEST(cr4_a6_every_new_hat_shows_on_the_bust_and_the_figure)
+{
+    static uint8_t a[PORTRAIT_W * PORTRAIT_H], b[PORTRAIT_W * PORTRAIT_H];
+    static uint8_t fa[FIGURE_W * FIGURE_H], fb[FIGURE_W * FIGURE_H];
+    int v, bad = 0;
+    for (v = 36; v <= 63; v++) {
+        DoomoLook l = bench(), z = bench();
+        DoomoDeep d = doomo_deep_zero, dz = doomo_deep_zero;
+        look_part_set(&l, &d, GF_HAT, v);
+        portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, a);
+        portrait_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, b);
+        if (diff(a, b, (int)sizeof(a)) < 24) { fprintf(stderr, "    hat %d hidden on the bust\n", v); bad++; }
+        figure_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, fa);
+        figure_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, fb);
+        if (diff(fa, fb, (int)sizeof(fa)) < 12) { fprintf(stderr, "    hat %d hidden on the figure\n", v); bad++; }
+    }
+    CHECK_EQ(bad, 0);
+}
+
+TEST(cr4_a6_glasses_go_with_every_hat_and_with_the_painted_accessory_glasses)
+{
+    static uint8_t a[PORTRAIT_W * PORTRAIT_H], b[PORTRAIT_W * PORTRAIT_H];
+    int h, bad = 0;
+    for (h = 0; h <= 63; h += 3) {
+        DoomoLook l = bench(), z = bench();
+        DoomoDeep d = doomo_deep_zero, dz = doomo_deep_zero;
+        look_part_set(&l, &d, GF_HAT, h);
+        look_part_set(&z, &dz, GF_HAT, h);
+        look_part_set(&l, &d, GF_GLASSES, 6);
+        portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, a);
+        portrait_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, b);
+        if (diff(a, b, (int)sizeof(a)) < 10) { fprintf(stderr, "    glasses lost under hat %d\n", h); bad++; }
+    }
+    CHECK_EQ(bad, 0);
+    {
+        DoomoLook l = bench(), z = bench();
+        DoomoDeep d = doomo_deep_zero, dz = doomo_deep_zero;
+        l.accessory = ACC_MASK;
+        z.accessory = ACC_MASK;
+        look_part_set(&l, &d, GF_GLASSES, 9);
+        portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, a);
+        portrait_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, b);
+        CHECK(diff(a, b, (int)sizeof(a)) >= 10);               /* a mask and heart shades together */
+    }
+}
+
+TEST(cr4_a6_a_child_may_wear_all_of_it_and_every_stage_keeps_it)
+{
+    static const int stages[] = { LIFE_BABY, LIFE_TODDLER, LIFE_CHILD, LIFE_TEEN, LIFE_ADULT, LIFE_ELDER };
+    int s, v, k;
+    for (k = 0; k < 6; k++)
+        for (s = 0; s < 2; s++)
+            for (v = ranges[s].first; v <= ranges[s].last; v++) {
+                DoomoLook in = bench(), out;
+                DoomoDeep d = doomo_deep_zero;
+                look_part_set(&in, &d, ranges[s].list, v);
+                look_for_stage(&in, stages[k], &out);
+                CHECK_EQ(PMF_AGE(part_meta_find(ranges[s].list, v)->flags), PAGE_ALL);
+            }
+}
+
+TEST(cr4_a6_gene_values_survive_a_save_and_sanitize)
+{
+    static uint8_t img[DOOMO_SAVE_SLOT1_MAX];
+    static uint8_t want[DOOMO_GENE_BYTES];
+    DoomoResident *r;
+    uint32_t n;
+    town_new(TOWN_FREEPLAY, 4242u, TOWN_POP_PREMADE);
+    r = town_res(77);
+    CHECK(r != NULL);
+    if (r->status == RES_EMPTY) r->status = RES_ALIVE;
+    res_gset(r, GF_HAT, 63);
+    res_gset(r, GF_GLASSES, 31);
+    CHECK_EQ(resident_sanitize(r), 0);                          /* both are live choices: nothing is fixed */
+    memcpy(want, r->gene, DOOMO_GENE_BYTES);
+    n = save_serialize(img, sizeof(img));
+    CHECK(n > 0);
+    memset(r->gene + 30, 0, 18);
+    CHECK(save_deserialize(img, n));
+    r = town_res(77);
+    CHECK(memcmp(r->gene, want, DOOMO_GENE_BYTES) == 0);
+    CHECK_EQ((int)res_gget(r, GF_HAT), 63);
+    CHECK_EQ((int)res_gget(r, GF_GLASSES), 31);
+}
+
+TEST(cr4_a6_the_new_parts_draw_on_another_citizen_too)
+{
+    static uint8_t a[PORTRAIT_W * PORTRAIT_H], b[PORTRAIT_W * PORTRAIT_H];
+    static const uint32_t seeds[3] = { 11u, 4242u, 9001u };
+    int c, s, v, bad = 0;
+    for (c = 0; c < 3; c++) {
+        DoomoResident r;
+        DoomoLook base;
+        if (c == 1) resident_generate_hellborn(&r, seeds[c]); else resident_generate(&r, seeds[c]);
+        base = *RES_LOOK_VIEW(&r);
+        base.accessory_color = PAINT_COBALT;
+        base.hat = 0;
+        for (s = 0; s < 2; s++)
+            for (v = ranges[s].first; v <= ranges[s].last; v++) {
+                DoomoLook l = base, z = base;
+                DoomoDeep d = doomo_deep_zero, dz = doomo_deep_zero;
+                look_part_set(&l, &d, ranges[s].list, v);
+                portrait_render_deep(&l, &d, RES_ALIVE, EXPR_NEUTRAL, 0, a);
+                portrait_render_deep(&z, &dz, RES_ALIVE, EXPR_NEUTRAL, 0, b);
+                if (diff(a, b, (int)sizeof(a)) < 6) bad++;
+            }
+    }
+    CHECK_MSG(bad <= 6, "%d draws of 165 were hidden on another citizen", bad);
+}
