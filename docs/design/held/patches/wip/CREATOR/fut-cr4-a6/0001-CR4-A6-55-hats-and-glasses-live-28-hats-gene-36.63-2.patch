@@ -0,0 +1,398 @@
+# core/data/parts/glasses/glasses_b.txt - glasses (CR4 A6): gene list `glasses` values 5..31.
+# The pair-of-eyes frame (portrait_hair.c glasses_script): x +-256 are the two eye centres, y 0 the
+# eyes' height, radii in eye radii (256 = one eye). `scale 128` doubles every number, so a lens at
+# x 128 is centred on its eye and a radius of 90 is a lens 1.4 eyes wide. `mirror on` draws a lens
+# once for each eye. The colour is the accessory colour (the creator's accessory colour row). They
+# go with any accessory and any hat. All are plain optical or novelty frames: nothing sexual,
+# nothing worn to hide a face, no real-world symbols.
+
+def frame
+  mat accessory_color
+  shade flat
+  decal
+enddef
+
+def tint
+  mat ink
+  shade flat
+  decal
+enddef
+
+def glint
+  mat white
+  shade flat
+  decal
+enddef
+
+# the bridge across the nose and the stubs of the arms to the temples
+def bridge R
+  mat accessory_color
+  shade flat
+  decal
+  line -$R -10 $R -10 2
+enddef
+def arms X
+  mat accessory_color
+  shade flat
+  decal
+  mirror on
+  line $X -10 $X+20 -30 1
+  mirror off
+enddef
+
+list glasses 5                    # Aviators: two big drops, a double bridge
+block group=5 anchor=frame lod=all view=all
+  scale 128
+  mirror on
+  use tint
+  ellipse 128 8 82 78
+  use frame
+  ring 128 8 84 14
+  use glint
+  dot 98 -30 4
+  mirror off
+  use bridge 44
+  use arms 214
+end
+
+list glasses 6                    # Big Round: thick round rims
+block group=5 anchor=frame lod=all view=all
+  scale 128
+  mirror on
+  use frame
+  ring 128 0 100 22
+  use glint
+  dot 84 -40 4
+  mirror off
+  use bridge 28
+  use arms 228
+end
+
+list glasses 7                    # Pin Specs: tiny round lenses on thin rims
+block group=5 anchor=frame lod=all view=all
+  scale 128
+  mirror on
+  use frame
+  ring 128 0 52 10
+  mirror off
+  use bridge 76
+  use arms 180
+end
+
+list glasses 8                    # Hex Frames: six-sided rims
+block group=5 anchor=frame lod=all view=all
+  scale 128
+  mirror on
+  use frame
+  line 62 -60 194 -60 2
+  line 194 -60 226 0 2
+  line 226 0 194 60 2
+  line 194 60 62 60 2
+  line 62 60 30 0 2
+  line 30 0 62 -60 2
+  mirror off
+  use arms 226
+end
+
+list glasses 9                    # Heart Shades: two dark hearts
+block group=5 anchor=frame lod=all view=all
+  scale 128
+  mirror on
+  use tint
+  ellipse 98 -22 50 46
+  ellipse 158 -22 50 46
+  tri 52 -4 204 -4 128 100
+  use glint
+  dot 84 -36 3
+  mirror off
+  use bridge 38
+end
+
+list glasses 10                   # Star Shades: two dark five-point stars
+block group=5 anchor=frame lod=all view=all
+  scale 128
