+static int row_of(int tab, int field)
+{
+    int i;
+    for (i = 0; i < cr_tabs[tab].nrows; i++)
+        if (cr_tabs[tab].rows[i].field == field && cr_tabs[tab].rows[i].kind == RK_SLIDER) return i;
+    return -1;
+}
