+                render(&hi, &PB);
+                if (pic_diff(&PA, &PB) == 0 && bo == 0) {         /* a few bodies hide a mouth under the chest: body 0 is the gate */
+                    fprintf(stderr, "    slider %s does nothing on species %d (%s)\n", row->label, sp, doomo_species_names[sp]);
+                    bad++;
+                }
+            }
+    }
+    CHECK_EQ(bad, 0);
+    CHECK_EQ(g_overflow, 0);
+}
