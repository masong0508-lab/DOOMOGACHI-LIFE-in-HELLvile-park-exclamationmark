+  shade ball
+  solid
+  ellipse 150 -225 30 30
+end
+
+list ears 25                        # Fan Ears: wide pleated fans
+block group=0 anchor=head lod=all view=all
+  scale 128
+  use esk
+  mirror on
+  tri 110 -45 110 45 190 -105
+  tri 110 -45 110 45 190 0
+  tri 110 -45 110 45 190 105
+  use ein
+  line 115 0 180 -90 1
+  line 115 0 180 0 1
+  line 115 0 180 90 1
+end
+
+list ears 26                        # Jug Ears: big round side ears
+block group=0 anchor=head lod=all view=all
