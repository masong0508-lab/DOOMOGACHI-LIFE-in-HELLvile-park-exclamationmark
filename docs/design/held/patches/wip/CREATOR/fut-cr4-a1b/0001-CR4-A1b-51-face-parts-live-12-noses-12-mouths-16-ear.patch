+
+list mouth_style 25                 # Crooked: low on one side, high on the other
+block group=3 anchor=frame lod=all view=all
+  use mink
+  capsule -254 90 0 90 70 70
+  capsule 0 90 254 -100 70 70
+end
+
+list mouth_style 26                 # Wail: an open triangle
+block group=3 anchor=frame lod=all view=all
