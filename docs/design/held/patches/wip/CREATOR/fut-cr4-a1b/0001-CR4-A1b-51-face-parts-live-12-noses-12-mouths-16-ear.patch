diff --git a/core/data/parts/face/a1b_nose.txt b/core/data/parts/face/a1b_nose.txt
new file mode 100644
index 00000000..3c171ae9
--- /dev/null
+++ b/core/data/parts/face/a1b_nose.txt
@@ -0,0 +1,114 @@
+# core/data/parts/face/a1b_nose.txt - CR4 batch A1b: 12 noses (values 12..23 of nose_style).
+# Frame blocks: 256 = the nose radius the size slider gives (a few px), centred on the nose. Skin
+# shapes use the citizen's skin ramp, ink shapes the fixed jet black, white the fixed white. They draw
+# on the chibi too (a nose is a dot there). Muzzled species keep their nose on the muzzle.
+
+def nskin
+  mat skin
+  shade ball
+  solid
+enddef
+def nink
+  mat ink
+  shade flat
+  decal
+enddef
+def nglint X Y
+  mat white
+  decal
+  dot $X $Y 1
+enddef
+
+list nose_style 12                  # Snub: a short round nose with two nostrils
+block group=3 anchor=frame lod=all view=all
+  use nskin
+  ellipse 0 30 200 150
+  use nink
+  dot -70 80 1
+  dot 70 80 1
+end
+
+list nose_style 13                  # Beak: a long pointed nose
+block group=3 anchor=frame lod=all view=all
+  use nskin
+  tri -120 100 120 100 0 -254
+end
+
+list nose_style 14                  # Triangle: an ink triangle
+block group=3 anchor=frame lod=all view=all
+  use nink
+  tri -150 80 150 80 0 -110
+end
+
+list nose_style 15                  # Heart Nose
+block group=3 anchor=frame lod=all view=all
+  use nink
+  ellipse -90 -40 110 110
+  ellipse 90 -40 110 110
+  tri -190 0 190 0 0 170
+end
+
+list nose_style 16                  # Two Dots: nostrils only
+block group=3 anchor=frame lod=all view=all
+  use nink
+  ellipse -90 40 60 80
+  ellipse 90 40 60 80
+end
+
+list nose_style 17                  # Bulb: a big round shiny nose
+block group=3 anchor=frame lod=all view=all
+  use nskin
+  ellipse 0 20 254 230
+  use nglint -80 -50
+end
+
+list nose_style 18                  # Cone: a long cone in the accessory colour
+block group=3 anchor=frame lod=all view=all
+  mat accessory_color
+  shade ball
+  solid
+  tri -130 -100 130 -100 0 254
+end
+
+list nose_style 19                  # Snout: wide, with two holes
+block group=3 anchor=frame lod=all view=all
+  use nskin
+  ellipse 0 20 254 150
+  use nink
+  ellipse -90 20 40 80
+  ellipse 90 20 40 80
+end
+
+list nose_style 20                  # Cat Y: an ink Y under a small bridge
+block group=3 anchor=frame lod=all view=all
+  use nink
+  capsule 0 -90 0 40 36 36
+  capsule 0 40 -140 120 36 36
+  capsule 0 40 140 120 36 36
+  ellipse 0 -90 90 50
+end
+
+list nose_style 21                  # Plaster: a white strip across the nose
+block group=3 anchor=frame lod=all view=all
+  mat white
+  shade flat
+  solid
+  capsule -254 50 254 -50 90 90
+  use nink
+  dot -40 20 1
+  dot 40 -20 1
+end
+
+list nose_style 22                  # Wet Nose: a big dark nose with a shine
+block group=3 anchor=frame lod=all view=all
+  use nink
+  ellipse 0 20 230 160
+  use nglint -100 -40
+end
+
+list nose_style 23                  # L Nose: one ink line down and a hook
+block group=3 anchor=frame lod=all view=all
+  use nink
+  capsule 0 -200 0 130 70 70
+  capsule 0 130 -200 130 70 70
+end
