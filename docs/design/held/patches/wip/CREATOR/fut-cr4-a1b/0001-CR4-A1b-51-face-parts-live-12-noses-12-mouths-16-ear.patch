+# core/data/parts/face/a1b_mouth.txt - CR4 batch A1b: 12 mouths (values 20..31 of mouth_style: 20 are live, the gene is 5 bits).
+# Frame blocks: 256 = the mouth half width, centred on the mouth, y down. Ink (fixed jet black) and
+# white teeth. Drawn in a neutral face only: an expression or talking draws the painter's smile.
+
+def mink
+  mat ink
+  shade flat
+  decal
+enddef
+def mteeth
+  mat white
+  shade flat
+  decal
+enddef
+
+list mouth_style 20                 # Cat Mouth: a bold w
+block group=3 anchor=frame lod=all view=all
+  use mink
+  capsule -230 -50 -115 70 70 70
+  capsule -115 70 0 -50 70 70
+  capsule 0 -50 115 70 70 70
+  capsule 115 70 230 -50 70 70
+end
+
+list mouth_style 21                 # Zigzag: a bold m, peaks up
+block group=3 anchor=frame lod=all view=all
+  use mink
+  capsule -230 70 -115 -80 70 70
+  capsule -115 -80 0 70 70 70
+  capsule 0 70 115 -80 70 70
+  capsule 115 -80 230 70 70 70
+end
+
+list mouth_style 22                 # Slash: a diagonal swipe
+block group=3 anchor=frame lod=all view=all
+  use mink
+  capsule -230 100 230 -100 110 110
+end
+
+list mouth_style 23                 # Dot: one round dot
+block group=3 anchor=frame lod=all view=all
+  use mink
+  ellipse 0 0 130 130
+end
+
+list mouth_style 24                 # Toothy Block: a wide open box with a tooth row
+block group=3 anchor=frame lod=all view=all
+  use mink
+  capsule -170 0 170 0 180 180
+  use mteeth
+  capsule -150 -110 150 -110 40 40
