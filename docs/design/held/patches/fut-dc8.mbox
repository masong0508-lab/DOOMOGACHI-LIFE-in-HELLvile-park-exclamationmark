+        } else {
+            r.obj[0].w0 = HO_W0(furn, 0, 0);
+            r.obj[0].pos = HO_POS(2, 2);
+        }
+        r.obj[0].pa = r.obj[0].pb = FURN_PAINT_DEFAULT;
