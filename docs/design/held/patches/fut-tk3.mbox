+COMPLIMENT	warm	THANK,JOKE,COMPLIMENT,TEASE,DISMISS,LAUGH
+PRAISE_OTHER	warm	AGREE,DISAGREE,JOKE,TEASE,GOSSIP
+COMFORT	warm	THANK,ANSWER,COMPLAIN,JOKE
+ENCOURAGE	warm	THANK,YES,JOKE,COMPLAIN
+SYMPATHIZE	warm	THANK,COMPLAIN,AGREE,JOKE
+JOKE	warm	LAUGH,JOKE,TEASE,DISMISS,MOCK,AGREE
+LAUGH	warm	LAUGH,JOKE,TEASE,BACKCHANNEL,COMPLAIN
+OFFER	warm	YES,NO,THANK,JOKE
+INVITE	warm	YES,NO,JOKE,ASK_ABOUT
+PROMISE	warm	THANK,TEASE,JOKE,DISMISS,AGREE
+INSULT	cool	INSULT,COMPLAIN,DISMISS,JOKE,TEASE,THREATEN,MOCK,LAUGH
+CRITICIZE	cool	DISAGREE,AGREE,COMPLAIN,DISMISS,JOKE,APOLOGIZE
+TEASE	cool	TEASE,LAUGH,JOKE,COMPLAIN,DISMISS,AGREE
+MOCK	cool	MOCK,COMPLAIN,DISMISS,JOKE,INSULT,LAUGH
+COMPLAIN	cool	SYMPATHIZE,AGREE,DISAGREE,JOKE,DISMISS,COMFORT,COMPLAIN,TEASE
+BLAME	cool	DISAGREE,APOLOGIZE,BLAME,COMPLAIN,DISMISS,JOKE
+DISMISS	cool	COMPLAIN,DISMISS,JOKE,TEASE,LAUGH
