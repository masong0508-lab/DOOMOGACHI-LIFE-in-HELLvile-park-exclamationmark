+/* ---- the run ------------------------------------------------------------------ */
+static void census_town(const Grid *g)
+{
+    memset(&doomo_town, 0, sizeof doomo_town);
+    opt_defaults();
+    town_new(TOWN_FREEPLAY, g->town ? g->town : 7u, TOWN_POP_PREMADE);
+}
+
+int talk_census_run(const CensusCfg *cfg, CensusResult *res, char *err, int errcap)
+{
+    Grid g;
+    HSet hs, hk, hm, hc;
+    uint32_t i, s, contexts, convs;
+    uint32_t h0;
+    clock_t t0;
+    memset(res, 0, sizeof *res);
+    if (talk_db_open(lang_find("en")) != TALK_DB_OK || !talk_gen_ready()) {
+        snprintf(err, (size_t)errcap, "no TALK_en.BIN with the generator banks (make -C core talk)");
+        return -1;
+    }
+    if (load_grid(cfg->grid, &g, err, errcap) < 0) return -1;
+    census_town(&g);
+    contexts = cfg->contexts ? cfg->contexts : g.contexts;
+    convs = cfg->conversations;
+    s = cfg->seed ? cfg->seed : (g.seed ? g.seed : 1u);
+    res->nres = (uint32_t)g.nres; res->ntopics = (uint32_t)g.ntopics; res->nacts = (uint32_t)g.nacts;
+    if (!hs_init(&hs, contexts) || !hs_init(&hk, contexts) || !hs_init(&hm, contexts)) {
+        snprintf(err, (size_t)errcap, "out of memory");
+        return -1;
+    }
+    h0 = talk_safe_lint_hits();
+    t0 = clock();
+    for (i = 0; i < contexts; i++) {
+        Ctx x;
+        TalkConv c;
+        TalkUtter u;
+        TalkExchange ex;
+        TalkTrace tr[TALK_EXCHANGE_MAX];
+        int q;
+        draw_context(&g, &s, &x);
+        begin(&c, &g, &x, s ^ (i * 2654435761u));
+        memset(&u, 0, sizeof u);
+        u.act[0] = x.act;
+        u.topic[0] = x.topic;
+        u.target = (int8_t)x.target;
+        u.conf = 15;
+        talk_gen_exchange(&c, &u, &ex, tr);
+        res->contexts++;
+        res->lines += ex.n;
+        if (c.aud.any_minor) res->kid_rooms++;
+        if (cfg->sample && cfg->sample_every && i % cfg->sample_every == 0) write_sample(cfg->sample, i, &c, &u, &ex, tr);
+        q = ex.n ? talk_census_check(&c, &u, &ex, tr) : QF_Q1_FALLBACK;
+        res->fail[q]++;
+        if (q && cfg->fails) {
+            fprintf(cfg->fails, "%s\t", talk_census_qf_names[q]);
+            write_sample(cfg->fails, i, &c, &u, &ex, tr);
+        }
+        if (q == QF_NONE) {
+            Hashes hh = exchange_hashes(&c, &ex, tr);
+            res->exchanges_ok++;
+            hs_add(&hs, hh.surface);
+            hs_add(&hk, hh.skeleton);
+            hs_add(&hm, hh.meaning);
+        }
+        if (!cfg->quiet && contexts >= 200000 && i % 200000 == 199999)
+            fprintf(stderr, "talk_census: %u / %u contexts\n", i + 1, contexts);
+    }
+    res->secs = (double)(clock() - t0) / CLOCKS_PER_SEC;
+    hs_tier(&hs, &res->surface);
+    hs_tier(&hk, &res->skeleton);
+    hs_tier(&hm, &res->meaning);
+    hs_free(&hs); hs_free(&hk); hs_free(&hm);
+    /* the conversation tier: 6 player turns a conversation */
+    if (convs) {
+        t0 = clock();
+        if (!hs_init(&hc, (uint64_t)convs * 6u)) { snprintf(err, (size_t)errcap, "out of memory"); return -1; }
+        for (i = 0; i < convs; i++) {
+            Ctx x;
+            TalkConv c;
+            uint64_t seq[6], masked[6];
+            int t, k, j, q5 = 0, distinct = 1;
+            char seen[6 * TALK_EXCHANGE_MAX][TALK_LINE_MAX];
+            int nseen = 0;
+            uint8_t last_act = TA_GREET;
+            uint16_t topic;
+            draw_context(&g, &s, &x);
+            begin(&c, &g, &x, s ^ (i * 0x9E3779B9u));
+            topic = x.topic;
+            for (t = 0; t < 6; t++) {
+                TalkUtter u;
+                TalkExchange ex;
+                TalkTrace tr[TALK_EXCHANGE_MAX];
+                Hashes hh;
+                memset(&u, 0, sizeof u);
+                /* the bot: a reply the adjacency table allows to the last line, a topic from the chips */
+                if (t == 0) u.act[0] = TA_GREET;
+                else {
+                    int tries;
+                    u.act[0] = g.act[rnd(&s) % (uint32_t)g.nacts];
+                    for (tries = 0; tries < 8 && !talk_gen_adjacent(last_act, u.act[0]); tries++)
+                        u.act[0] = g.act[rnd(&s) % (uint32_t)g.nacts];
+                }
+                if (rnd(&s) % 3u == 0) {
+                    uint16_t a[TALK_ASSOC_TOP];
+                    int na = talk_db_assoc(topic, a, NULL);
+                    if (na) topic = a[rnd(&s) % (uint32_t)na];
+                } else if (rnd(&s) % 4u == 0) topic = g.topic[rnd(&s) % (uint32_t)g.ntopics];
+                u.topic[0] = topic;
+                u.target = (int8_t)((rnd(&s) % 10u) < 7 ? (int)(rnd(&s) % (uint32_t)x.n) : -1);
+                u.conf = 15;
+                talk_gen_exchange(&c, &u, &ex, tr);
+                hh = exchange_hashes(&c, &ex, tr);
+                seq[t] = hh.surface;
+                if (ex.n) last_act = ex.line[ex.n - 1].act;
+                /* Q5: no line twice in a conversation; a core template once a speaker in 6 turns */
+                for (k = 0; k < ex.n; k++) {
+                    for (j = 0; j < nseen; j++)
+                        if (strcmp(seen[j], ex.line[k].text) == 0) {
+                            if (!q5 && cfg->fails) fprintf(cfg->fails, "Q5 repeat\t%u\t%s\n", i, ex.line[k].text);
+                            q5 = 1;
+                        }
+                    if (nseen < 6 * TALK_EXCHANGE_MAX) strcpy(seen[nseen++], ex.line[k].text);
+                }
+            }
+            /* two conversations are distinct when their hash sequences differ in 2 of the 6 or more:
+             * keep it if no kept conversation shares any of its 6 leave-one-out keys */
+            for (t = 0; t < 6; t++) {
+                uint64_t h = FNV0;
+                for (k = 0; k < 6; k++) {
+                    uint64_t v = k == t ? 0x5A5A5A5Aull : seq[k];
+                    h = fnv64(h, (const char *)&v, 8);
+                }
+                masked[t] = h;
+                if (hs_has(&hc, h)) distinct = 0;
+            }
+            if (distinct) {
+                for (t = 0; t < 6; t++) hs_add(&hc, masked[t]);
+                res->conv_distinct++;
+            }
+            res->conv_q5 += (uint64_t)q5;
+            res->conversations++;
+            if (!cfg->quiet && convs >= 200000 && i % 200000 == 199999)
+                fprintf(stderr, "talk_census: %u / %u conversations\n", i + 1, convs);
+        }
+        res->conv_secs = (double)(clock() - t0) / CLOCKS_PER_SEC;
+        hs_free(&hc);
+    }
+    res->lint_hits = talk_safe_lint_hits() - h0;
+    talk_db_close();
+    return 0;
+}
+
+static void tier_line(FILE *f, const char *name, const CensusTier *t, uint64_t n, uint64_t target)
+{
+    fprintf(f, "  %-9s %10llu distinct of %llu (%.1f%% unique), Chao1 %.0f, target %llu%s\n", name,
+            (unsigned long long)t->distinct, (unsigned long long)n, n ? 100.0 * (double)t->distinct / (double)n : 0.0,
+            t->chao1, (unsigned long long)target, t->distinct >= target ? "" : "  (MISSED)");
+}
+
+void talk_census_print(const CensusResult *r, FILE *f)
+{
+    int q;
+    uint64_t failed = r->contexts - r->exchanges_ok;
+    fprintf(f, "talk_census: %llu contexts (%u residents, %u topics, %u acts; %llu kid rooms), %llu lines, %.1f s\n",
+            (unsigned long long)r->contexts, r->nres, r->ntopics, r->nacts, (unsigned long long)r->kid_rooms,
+            (unsigned long long)r->lines, r->secs);
+    fprintf(f, "  quality: %llu passed, %llu failed (%.2f%%; the bar is 1%%)\n", (unsigned long long)r->exchanges_ok,
+            (unsigned long long)failed, r->contexts ? 100.0 * (double)failed / (double)r->contexts : 0.0);
+    for (q = 1; q < QF_COUNT; q++)
+        if (r->fail[q]) fprintf(f, "    %-30s %llu\n", talk_census_qf_names[q], (unsigned long long)r->fail[q]);
+    tier_line(f, "Surface", &r->surface, r->exchanges_ok, 1000000);
+    tier_line(f, "Skeleton", &r->skeleton, r->exchanges_ok, 100000);
+    tier_line(f, "Meaning", &r->meaning, r->exchanges_ok, 5000);
+    if (r->conversations)
+        fprintf(f, "  conversations: %llu distinct of %llu (differ in 2 or more of 6 exchanges), target 1000000%s; "
+                   "Q5 repeats in %llu; %.1f s\n",
+                (unsigned long long)r->conv_distinct, (unsigned long long)r->conversations,
+                r->conv_distinct >= 1000000 ? "" : "  (MISSED)", (unsigned long long)r->conv_q5, r->conv_secs);
+    fprintf(f, "  S3 lint hits: %llu\n", (unsigned long long)r->lint_hits);
+}
+
+int talk_census_targets_met(const CensusResult *r)
+{
+    uint64_t failed = r->contexts - r->exchanges_ok;
+    return r->surface.distinct >= 1000000 && r->skeleton.distinct >= 100000 && r->meaning.distinct >= 5000 &&
+           r->conv_distinct >= 1000000 && failed * 100 <= r->contexts && r->lint_hits == 0 &&
+           r->fail[QF_Q6_LINT] == 0 && r->fail[QF_Q6_KIDROOM] == 0 && r->fail[QF_Q6_MATURE] == 0;
+}
+
+#ifndef TALK_CENSUS_NO_MAIN
+#include "native.h"
+
+/* --pick: 32 residents covering the 16 persona types in both districts, 4 of
+ * the cast, 4 elders, 4 teens, 4 children; 400 topics over the categories */
+static int picked(const int *c, int n, int id)
+{
+    int j;
+    for (j = 0; j < n; j++) if (c[j] == id) return 1;
+    return 0;
+}
+
+static void pick(void)
+{
+    static const int cast[] = { 1, 5, 666, 729 };          /* Nana Puddin, Bonejangles, Vex, Grumbleguts */
+    int chosen[64], n = 0, i, id, t, kids = 0, teens = 0, elders = 0;
+    for (i = 0; i < 4; i++) {
+        chosen[n++] = cast[i];
+        if (sim_life_stage(cast[i]) == LIFE_ELDER) elders++;
+    }
+    /* one adult of each of the 16 persona types, the districts taking turns */
+    for (t = 0; t < PERSONA_TYPE_COUNT; t++) {
+        int d, found = 0;
+        for (d = 0; d < 2 && !found; d++) {
+            int dist = (t + d) & 1;
+            for (id = dist * DOOMO_DISTRICT_SIZE; id < (dist + 1) * DOOMO_DISTRICT_SIZE && !found; id++) {
+                const DoomoResident *r = town_res(id);
+                if (!r || r->status != RES_ALIVE || persona_type(r) != t || talk_safe_minor(id) ||
+                    sim_life_stage(id) == LIFE_ELDER || picked(chosen, n, id))
+                    continue;
+                chosen[n++] = id;
+                found = 1;
+            }
+        }
+    }
+    /* to 20 adults (the cast's adults included) */
+    for (id = DOOMO_MAX_RESIDENTS - 1; id >= 0 && n - elders < 20; id--) {
+        const DoomoResident *r = town_res(id);
+        if (!r || r->status != RES_ALIVE || talk_safe_minor(id) || sim_life_stage(id) == LIFE_ELDER ||
+            picked(chosen, n, id))
+            continue;
+        chosen[n++] = id;
+    }
+    /* elders, teens and children (Pip among them) to 4 each */
+    if (!picked(chosen, n, 42)) { chosen[n++] = 42; kids++; }
+    for (id = 0; id < DOOMO_MAX_RESIDENTS && (kids < 4 || teens < 4 || elders < 4); id++) {
+        int st = sim_life_stage(id);
+        const DoomoResident *r = town_res(id);
+        if (!r || r->status != RES_ALIVE || picked(chosen, n, id)) continue;
+        if (st == LIFE_CHILD && kids < 4) { chosen[n++] = id; kids++; }
+        else if (st == LIFE_TEEN && teens < 4) { chosen[n++] = id; teens++; }
+        else if (st == LIFE_ELDER && elders < 4) { chosen[n++] = id; elders++; }
+    }
+    for (i = 0; i < n; i++) {
+        const DoomoResident *r = town_res(chosen[i]);
+        printf("resident %d\t# %s, %s, %s, %s\n", chosen[i], r->name, doomo_persona_type_names[persona_type(r)],
+               doomo_life_stage_names[sim_life_stage(chosen[i])], RES_DISTRICT(chosen[i]) ? "Hellvile" : "Hillvile");
+    }
+    {
+        int ncat = talk_db_ncats(), cat, round, got = 0, nc = talk_db_nconcepts();
+        for (round = 0; got < 400 && round < 64; round++)
+            for (cat = 1; cat <= ncat && got < 400; cat++) {
+                uint8_t parent, flags;
+                int k = 0, c;
+                char key[48];
+                if (!talk_db_cat(cat, &parent, &flags) || !parent || !(flags & TCAT_TALKABLE) ||
+                    (flags & (TCAT_SAFETY | TCAT_GATED | TCAT_DESCRIBE)))
+                    continue;
+                for (c = 1; c <= nc; c++) {
+                    TalkConcept tc;
+                    if (!talk_db_concept(c, &tc) || tc.cat != cat || tc.age == TAGE_NEVER || tc.reg >= TR_SEXUAL)
+                        continue;
+                    if (k++ != round * 7) continue;
+                    talk_db_form(c, TF_LEMMA, key, (int)sizeof key);
+                    for (k = 0; key[k]; k++) key[k] = key[k] == ' ' ? '_' : (char)tolower((unsigned char)key[k]);
+                    printf("topic %s\n", key);
+                    got++;
+                    break;
+                }
+            }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    CensusCfg cfg;
+    CensusResult r;
+    NatOptions o;
+    char err[256];
+    int i, smoke = 0, do_pick = 0, full = 0;
+    const char *sample = NULL;
+    memset(&cfg, 0, sizeof cfg);
+    cfg.grid = "core/data/talk/census_en.tsv";
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--grid") == 0 && i + 1 < argc) cfg.grid = argv[++i];
+        else if (strcmp(argv[i], "--contexts") == 0 && i + 1 < argc) cfg.contexts = (uint32_t)strtoul(argv[++i], NULL, 10);
+        else if (strcmp(argv[i], "--conversations") == 0 && i + 1 < argc)
+            cfg.conversations = (uint32_t)strtoul(argv[++i], NULL, 10);
+        else if (strcmp(argv[i], "--seed") == 0 && i + 1 < argc) cfg.seed = (uint32_t)strtoul(argv[++i], NULL, 10);
+        else if (strcmp(argv[i], "--sample") == 0 && i + 1 < argc) sample = argv[++i];
+        else if (strcmp(argv[i], "--every") == 0 && i + 1 < argc) cfg.sample_every = (uint32_t)strtoul(argv[++i], NULL, 10);
+        else if (strcmp(argv[i], "--fails") == 0 && i + 1 < argc) {
+            cfg.fails = fopen(argv[++i], "w");
+            if (!cfg.fails) { perror(argv[i]); return 2; }
+        }
+        else if (strcmp(argv[i], "--smoke") == 0) smoke = 1;
+        else if (strcmp(argv[i], "--full") == 0) full = 1;
+        else if (strcmp(argv[i], "--pick") == 0) do_pick = 1;
+        else if (strcmp(argv[i], "--quiet") == 0) cfg.quiet = 1;
+        else { fprintf(stderr, "usage: talk_census [--grid F] [--full|--smoke] [--contexts N] [--conversations N] "
+                               "[--seed N] [--sample F --every N] [--fails F] [--pick]\n"); return 2; }
+    }
+    memset(&o, 0, sizeof o);
+    o.w = 320; o.h = 240; o.seed = 1; o.quiet = getenv("DOOMO_TALK_LOG") ? 0 : 1; o.save_dir = "/tmp";
+    nat_init(&o);
+    doomo_init();
+    if (do_pick) {
+        memset(&doomo_town, 0, sizeof doomo_town);
+        opt_defaults();
+        town_new(TOWN_FREEPLAY, 7, TOWN_POP_PREMADE);
+        if (talk_db_open(lang_find("en")) != TALK_DB_OK) { fprintf(stderr, "talk_census: no TALK_en.BIN\n"); return 2; }
+        pick();
+        return 0;
+    }
+    if (sample) {
+        cfg.sample = fopen(sample, "w");
+        if (!cfg.sample) { perror(sample); return 2; }
+        if (!cfg.sample_every) cfg.sample_every = 1000;
+    }
+    if (smoke) {
+        Grid g;
+        /* the grid's smoke sizes (read it once for them) */
+        if (talk_db_open(lang_find("en")) == TALK_DB_OK && load_grid(cfg.grid, &g, err, (int)sizeof err) == 0) {
+            if (!cfg.contexts) cfg.contexts = g.smoke_contexts;
+            if (!cfg.conversations) cfg.conversations = g.smoke_conversations;
+        }
+        talk_db_close();
+    } else if (full) {
+        Grid g;
+        if (talk_db_open(lang_find("en")) == TALK_DB_OK && load_grid(cfg.grid, &g, err, (int)sizeof err) == 0)
+            if (!cfg.conversations) cfg.conversations = g.conversations;
+        talk_db_close();
+    }
+    if (talk_census_run(&cfg, &r, err, (int)sizeof err) < 0) {
+        fprintf(stderr, "talk_census: %s\n", err);
+        return 2;
+    }
+    if (cfg.sample) fclose(cfg.sample);
+    if (cfg.fails) fclose(cfg.fails);
+    talk_census_print(&r, stdout);
+    if (full) {
+        int ok = talk_census_targets_met(&r);
+        printf("talk_census: %s\n", ok ? "every target met" : "a target was missed");
+        return ok ? 0 : 1;
+    }
+    return 0;
+}
+#endif
diff --git a/core/tools/talk_census.h b/core/tools/talk_census.h
new file mode 100644
index 0000000..c640997
--- /dev/null
+++ b/core/tools/talk_census.h
@@ -0,0 +1,77 @@
+/* talk_census.h - Talk T7: the census and the quality checks (owner: TK;
+ * docs/TALK.md "The census"; design 3.7). Host only: core/tools/talk_census.c
+ * is the `talk_census` program (make -C core talk-census) and, compiled
+ * with TALK_CENSUS_NO_MAIN, the smoke census of the unit tests
+ * (core/tests/test_talk_census.c). It links the core and reads
+ * core/build/talk/TALK_en.BIN through the native platform.
+ */
+#ifndef TALK_CENSUS_H
+#define TALK_CENSUS_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include "doomo/talk.h"
+
+/* why an exchange did not count (design 3.7, Q1-Q6; Q7 is the human read) */
+enum {
+    QF_NONE = 0,
+    QF_Q1_FALLBACK,     /* nothing fitted: a safe line                    */
+    QF_Q1_CODE,         /* an unresolved {, a stray }, an unknown code     */
+    QF_Q1_SPACE,        /* two spaces, a space before punctuation          */
+    QF_Q1_CASE,         /* no capital letter at the start                  */
+    QF_Q1_END,          /* no end punctuation                              */
+    QF_Q1_ARTICLE,      /* "a apple", "an pie"                             */
+    QF_Q1_BUBBLE,       /* more than the bubble's lines                    */
+    QF_Q1_SENTENCES,    /* more than 4 sentences                           */
+    QF_Q2_ACT,          /* a reply act the adjacency table does not allow  */
+    QF_Q2_TOPIC,        /* a topic that is not the player's, a 1-hop one or (CHANGE_TOPIC) a like */
+    QF_Q3_VOICE,        /* a voice guard that does not hold for the speaker */
+    QF_Q3_EXCL,         /* more exclamation marks than the speaker's budget */
+    QF_Q3_TIC,          /* another persona type's tic                       */
+    QF_Q4_FACT,         /* a callback that is not true                      */
+    QF_Q5_REPEAT,       /* a line twice, or a core template twice in 6 turns (conversations) */
+    QF_Q6_LINT,         /* the S3 lint replaced or refuses a line           */
+    QF_Q6_KIDROOM,      /* a register word, LOVE face or romance rule in a kid room */
+    QF_Q6_MATURE,       /* a Mature variant without the option or the adults */
+    QF_COUNT
+};
+extern const char *const talk_census_qf_names[QF_COUNT];
+
+typedef struct CensusCfg {
+    const char *grid;            /* census_<lang>.tsv                                   */
+    uint32_t contexts;           /* exchanges to sample (0: the grid's @contexts)        */
+    uint32_t conversations;      /* bot conversations of 6 turns (0: none)               */
+    uint32_t seed;               /* 0: the grid's @seed                                 */
+    FILE    *sample;             /* NULL, or the review sheet's source rows (talk_sample.py) */
+    uint32_t sample_every;       /* write every Nth exchange to `sample`                 */
+    FILE    *fails;              /* NULL, or every exchange that failed a check, with why  */
+    int      quiet;
+} CensusCfg;
+
+typedef struct CensusTier { uint64_t distinct, f1, f2; double chao1; } CensusTier;
+
+typedef struct CensusResult {
+    uint64_t contexts, exchanges_ok, lines, kid_rooms;
+    CensusTier surface, skeleton, meaning;
+    uint64_t fail[QF_COUNT];       /* failures by reason (an exchange counts once, for its first) */
+    uint64_t lint_hits;            /* talk_safe_lint_hits() during the run                  */
+    uint64_t conversations, conv_distinct, conv_q5;
+    double   secs, conv_secs;
+    uint32_t nres, ntopics, nacts;
+} CensusResult;
+
+/* Load the grid and run. Returns 0, or -1 when the grid or the database is
+ * missing (err says which). */
+int  talk_census_run(const CensusCfg *cfg, CensusResult *res, char *err, int errcap);
+/* The report (design 3.7: distinct per tier, uniqueness, Chao1, the failure
+ * histogram, the conversation tier). */
+void talk_census_print(const CensusResult *r, FILE *f);
+/* The design's targets for a full run: 1 if every one holds. */
+int  talk_census_targets_met(const CensusResult *r);
+
+/* The quality checks of one exchange (Q1-Q4, Q6), for the census and the
+ * unit tests: the first failure (QF_*) or QF_NONE. u is the utterance
+ * after the gate. */
+int  talk_census_check(const TalkConv *c, const TalkUtter *u, const TalkExchange *x, const TalkTrace *tr);
+
+#endif
diff --git a/core/tools/talk_sample.py b/core/tools/talk_sample.py
new file mode 100644
index 0000000..794ea37
--- /dev/null
+++ b/core/tools/talk_sample.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""talk_sample.py - Talk T7: the Q7 human review sheet (owner: TK; docs/TALK.md
+"The census", design 3.7 quality check Q7). stdlib only.
+
+Q7 is the release gate no machine can pass: a person reads exchanges and
+rates each 1-5 for "sounds like a person in this game". The pass is a mean
+of 3.5 or better with 2% or fewer rated 1 ("nonsense / word salad"). A bank
+that fails is rewritten, not re-weighted.
+
+  python3 core/tools/talk_sample.py draw [--n 300] [--seed S] [--out FILE]
+      Run the census (core/build/talk_census, make -C core talk first) over
+      enough contexts and draw N exchanges, spread over the grid, into a
+      review sheet (Markdown-friendly TSV): number, what the player did and
+      about what, who is in the room, the lines, an empty RATING and NOTE.
+      The template references are kept in a last column for the bank's
+      writer; the reviewer can ignore it ("blind": no template names, no
+      persona banks shown).
+  python3 core/tools/talk_sample.py score FILE
+      Read a rated sheet: the mean, the share of 1s, PASS or FAIL against the
+      bar, and the templates of every line rated 1 or 2 (file:line), so the
+      writer knows what to rewrite. Exit 1 on FAIL or when a row is unrated.
+  python3 core/tools/talk_sample.py selftest
+      Score a built-in sheet both ways (the unit check of this tool).
+"""
+import os
+import random
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
+CORE = os.path.join(ROOT, "core")
+CENSUS = os.path.join(CORE, "build", "talk_census")
+GRID = os.path.join(CORE, "data", "talk", "census_en.tsv")
+HEADER = ["N", "PLAYER DID", "ABOUT", "IN THE ROOM", "LINES", "RATING (1-5)", "NOTE", "TEMPLATES"]
+MEAN_BAR = 3.5
+ONES_BAR = 0.02
+
+
+def alt_locations():
+    """alternative id -> 'file:line' of the English banks (talkc_gen)"""
+    sys.path.insert(0, HERE)
+    import talkc
+    import talkc_gen as tg
+    b = talkc.Build("en")
+    _, _, info = tg.build_grammar(b, tg.grammar_files("en"), talkc.die, talkc.rel)
+    return info["alt_where"]
+
+
+def draw(n, seed, out):
+    if not os.path.exists(CENSUS):
+        sys.exit("talk_sample: %s is missing (make -C core build/talk_census talk)" % os.path.relpath(CENSUS, ROOT))
+    every = 37                                     # a prime: spread over the grid's draws
+    contexts = n * every * 2
+    with tempfile.TemporaryDirectory() as d:
+        raw = os.path.join(d, "sample.tsv")
+        subprocess.run([CENSUS, "--grid", GRID, "--contexts", str(contexts), "--seed", str(seed), "--sample", raw,
+                        "--every", str(every), "--quiet"], check=True, stdout=subprocess.DEVNULL)
+        rows = [line.rstrip("\n").split("\t") for line in open(raw, encoding="latin-1")]
+    rnd = random.Random(seed)
+    rows = rnd.sample(rows, min(n, len(rows)))
+    rows.sort(key=lambda r: int(r[0]))
+    where = alt_locations()
+    with open(out, "w", encoding="utf-8", newline="\n") as f:
+        f.write("# Talk Q7 review sheet (core/tools/talk_sample.py, seed %d). Rate every exchange 1-5:\n" % seed)
+        f.write("# 5 = sounds like a person in this game, 1 = nonsense / word salad. Fill RATING, NOTE optional.\n")
+        f.write("# Pass: mean %.1f or better and %d%% or fewer rated 1. Then: talk_sample.py score THIS_FILE\n"
+                % (MEAN_BAR, int(ONES_BAR * 100)))
+        f.write("\t".join(HEADER) + "\n")
+        for k, r in enumerate(rows, 1):
+            lines = [c for c in r[4:] if not c.startswith("#alts")]
+            alts = [c for c in r[4:] if c.startswith("#alts")]
+            refs = []
+            for a in (alts[0].split()[1:] if alts else []):
+                a = int(a)
+                refs.append(where[a] if 0 <= a < len(where) else "safe line")
+            f.write("\t".join([str(k), r[1], r[2], r[3], " / ".join(lines), "", "", "; ".join(refs)]) + "\n")
+    print("talk_sample: %d exchanges in %s" % (len(rows), out))
+
+
+def score_rows(rows):
+    """[(rating, templates)] -> (mean, ones share, unrated, low [(rating, templates, lines)])"""
+    rated = [r for r in rows if r[0] is not None]
+    unrated = len(rows) - len(rated)
+    if not rated:
+        return 0.0, 1.0, unrated, []
+    mean = sum(r[0] for r in rated) / len(rated)
+    ones = sum(1 for r in rated if r[0] == 1) / len(rated)
+    low = [r for r in rated if r[0] <= 2]
+    return mean, ones, unrated, low
+
+
+def read_sheet(path):
+    rows = []
+    for line in open(path, encoding="utf-8"):
+        if line.startswith("#") or line.startswith("N\t") or not line.strip():
+            continue
+        c = line.rstrip("\n").split("\t")
+        while len(c) < len(HEADER):
+            c.append("")
+        v = c[5].strip()
+        if v and not (v.isdigit() and 1 <= int(v) <= 5):
+            sys.exit("talk_sample: row %s: RATING %r is not 1-5" % (c[0], v))
+        rows.append((int(v) if v else None, c[7], c[4]))
+    return rows
+
+
+def score(path):
+    rows = read_sheet(path)
+    mean, ones, unrated, low = score_rows(rows)
+    ok = unrated == 0 and mean >= MEAN_BAR and ones <= ONES_BAR
+    print("talk_sample: %d exchanges, %d unrated; mean %.2f (bar %.1f), rated 1: %.1f%% (bar %d%%): %s"
+          % (len(rows), unrated, mean, MEAN_BAR, 100 * ones, int(ONES_BAR * 100), "PASS" if ok else "FAIL"))
+    for r, refs, lines in low:
+        print("  %d  %s\n      %s" % (r, lines, refs))
+    return 0 if ok else 1
+
+
+def selftest():
+    good = [(4, "a", "x"), (5, "b", "y"), (3, "c", "z"), (4, "d", "w")]
+    bad = [(1, "a", "x"), (2, "b", "y"), (5, "c", "z"), (4, "d", "w")]
+    m, o, u, low = score_rows(good)
+    if not (abs(m - 4.0) < 1e-9 and o == 0 and u == 0 and not low):
+        sys.exit("talk_sample: selftest good")
+    m, o, u, low = score_rows(bad)
+    if not (m == 3.0 and o == 0.25 and len(low) == 2):
+        sys.exit("talk_sample: selftest bad")
+    print("talk_sample: selftest OK")
+    return 0
+
+
+def main(argv):
+    if len(argv) < 2:
+        print(__doc__)
+        return 2
+    cmd, args = argv[1], argv[2:]
+    if cmd == "draw":
+        n, seed, out = 300, 1, "talk_review.tsv"
+        i = 0
+        while i < len(args):
+            if args[i] == "--n":
+                n = int(args[i + 1])
+            elif args[i] == "--seed":
+                seed = int(args[i + 1])
+            elif args[i] == "--out":
+                out = args[i + 1]
+            else:
+                print(__doc__)
+                return 2
+            i += 2
+        draw(n, seed, out)
+        return 0
+    if cmd == "score" and len(args) == 1:
+        return score(args[0])
+    if cmd == "selftest":
+        return selftest()
+    print(__doc__)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
