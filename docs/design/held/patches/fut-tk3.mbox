+           "%d of 300 ghost / graveyard / zombie replies still joke\n", lines, ng, comforts, named, jokes_on_death);
+    CHECK(comforts > 50 && named > 5);
+    talk_db_close();
+}
diff --git a/core/tests/test_talk_gen.c b/core/tests/test_talk_gen.c
