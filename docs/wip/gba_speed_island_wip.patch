+/* one pixel, a halfword read-modify-write (volatile: a plain one may be
+ * compiled into a byte store, which VRAM mirrors into both bytes) */
+void vid_pixel(int x, int y, uint32_t color)
+{
+    volatile uint16_t *p = gba_back + y * (SCREEN_W / 2) + (x >> 1);
+    if (x & 1) *p = (uint16_t)((*p & 0x00FF) | (color << 8));
+    else *p = (uint16_t)((*p & 0xFF00) | color);
+}
+
 int plat_screen_w(void) { return SCREEN_W; }
 int plat_screen_h(void) { return SCREEN_H; }
 
