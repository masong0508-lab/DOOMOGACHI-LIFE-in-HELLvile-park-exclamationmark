+
 /* "seed N": plat_entropy() returns the pinned value while gba_entropy_pinned
  * (like the native runner's fixed entropy), so the next town_new() and every
  * later entropy read are reproducible. */
diff --git a/gba/src/layer.c b/gba/src/layer.c
new file mode 100644
index 0000000..b57aafa
--- /dev/null
+++ b/gba/src/layer.c
@@ -0,0 +1,79 @@
+/* layer.c - the kept static layer of platform.h (plat_layer_*; owner: gba).
+ *
+ * A scene draws a layer that does not move (the free play island's land,
+ * patches and roads: ~600 spans and ellipses, ~35 ms of THUMB a frame)
+ * once between plat_layer_begin and plat_layer_end; afterwards
+ * plat_layer_restore puts the same pixels back from runs (layer_rows,
+ * ARM in IWRAM: layer_loops.s), a few ms.
+ *
+ * begin clears the rows to index 0, which no 2D primitive ever draws
+ * (they all turn 0 into PAL_BLACK), so end can tell the layer's pixels
+ * from "nothing": it reads the rows back from the back page and keeps,
+ * per row, a count and the runs of one colour (x0, length, colour; 3 B).
+ * The runs live in gba_big (bigbuf.c), claimed as GBA_BIG_BY_LAYER: the
+ * 3D views, the overworld, the house and the save code take the block
+ * over in turn, which drops the layer (the scene then simply captures it
+ * again). A layer with more runs than fit is not kept (the scene draws
+ * it, and is not asked again for that key).
+ *
+ * RAM: 12 B of .bss; the runs are in gba_big.
+ */
+#include "gba_plat.h"
+#include "video_int.h"
+
+void layer_rows(const uint8_t *s, int y0, int y1) IWRAM_CALL;
+
+static uint32_t lay_key, lay_bad;       /* held / too big to keep         */
+static uint8_t  lay_y0, lay_y1;         /* rows of the layer              */
+static uint8_t  lay_ok, lay_open;
+
+int plat_layer_begin(uint32_t key, int y0, int y1)
+{
+    if (gba_nodraw || (key == lay_bad && key)) return 0;
+    if (y0 < 0) y0 = 0;
+    if (y1 > SCREEN_H) y1 = SCREEN_H;
+    if (y1 <= y0) return 0;
+    gba_big_claim(GBA_BIG_BY_LAYER);
+    lay_ok = 0;
+    lay_key = key;
+    lay_y0 = (uint8_t)y0;
+    lay_y1 = (uint8_t)y1;
+    lay_open = 1;
+    vid_rect_full(0, y0, SCREEN_W, y1, 0);   /* index 0: "nothing" */
+    return 1;
+}
+
+void plat_layer_end(void)
+{
+    uint8_t *d = gba_big, *const end = gba_big + GBA_BIG_SIZE;
+    int y;
+    if (!lay_open) return;
+    lay_open = 0;
+    if (gba_big_owner() != GBA_BIG_BY_LAYER) return;     /* taken meanwhile */
+    for (y = lay_y0; y < lay_y1; y++) {
+        const volatile uint8_t *row = (const volatile uint8_t *)gba_back + y * SCREEN_W;
+        uint8_t *cnt = d++;
+        int x = 0, n = 0;
+        while (x < SCREEN_W) {
+            const uint8_t c = row[x];
+            const int x0 = x;
+            while (++x < SCREEN_W && row[x] == c) {}
+            if (!c) continue;
+            if (d + 3 + 1 > end) { lay_bad = lay_key; return; }   /* too big */
+            d[0] = (uint8_t)x0;
+            d[1] = (uint8_t)(x - x0);
+            d[2] = c;
+            d += 3;
+            n++;
+        }
+        *cnt = (uint8_t)n;
+    }
+    lay_ok = 1;
+}
+
+int plat_layer_restore(uint32_t key)
+{
+    if (!lay_ok || key != lay_key || gba_big_owner() != GBA_BIG_BY_LAYER) return 0;
+    if (!gba_nodraw) layer_rows(gba_big, lay_y0, lay_y1);
+    return 1;
+}
diff --git a/gba/src/layer_loops.s b/gba/src/layer_loops.s
new file mode 100644
index 0000000..7d28c62
--- /dev/null
+++ b/gba/src/layer_loops.s
@@ -0,0 +1,75 @@
+@ layer_loops.s - plat_layer_restore's row loop, ARM in IWRAM (owner: gba).
+
+    .section .iwram, "ax", %progbits
+    .arm
+    .align 2
+
+@ void layer_rows(const uint8_t *s, int y0, int y1)
+@ A kept layer (layer.c) is, per row, a count and runs of (x0, length,
+@ colour). A row's span from its first run's word to its last run's end
+@ is DMA'd into a line buffer on the stack, the runs are stored there with
+@ plain byte / word stores (VRAM would need halfword read-modify-writes)
+@ and the span is DMA'd back: the pixels between runs go back as they
+@ were, so the layer stays transparent there.
+    .global layer_rows
+    .type   layer_rows, %function
+layer_rows:
+    push    {r4-r11, lr}
+    sub     sp, sp, #240
+    ldr     r10, =gba_back
+    ldr     r10, [r10]
+    ldr     r11, =0x040000D4            @ REG_DMA3SAD (DAD, CNT follow)
+1:  cmp     r1, r2
+    bge     9f
+    ldrb    r3, [r0], #1                @ runs in this row
+    cmp     r3, #0
+    beq     8f
+    add     r5, r3, r3, lsl #1
+    add     r5, r0, r5                  @ end of the row's runs
+    ldrb    r4, [r0]
+    bic     r4, r4, #3                  @ a: first word
+    ldrb    r6, [r5, #-3]
+    ldrb    r7, [r5, #-2]
+    add     r6, r6, r7
+    add     r6, r6, #3
+    sub     r6, r6, r4
+    mov     r6, r6, lsr #2              @ words
+    orr     r6, r6, #0x84000000         @ DMA enable, 32-bit
+    mov     r7, #240
+    mla     r8, r1, r7, r10
+    add     r8, r8, r4                  @ VRAM row + a
+    add     r9, sp, r4                  @ line buffer + a
+    stmia   r11, {r8, r9}               @ VRAM -> buffer
+    str     r6, [r11, #8]
+2:  ldrb    r3, [r0], #1                @ x0
+    ldrb    r7, [r0], #1                @ length
+    ldrb    r12, [r0], #1               @ colour
+    add     r3, sp, r3
+    orr     r12, r12, r12, lsl #8
+    orr     r12, r12, r12, lsl #16
+3:  tst     r3, #3                      @ bytes up to a word boundary
+    beq     4f
+    strb    r12, [r3], #1
+    subs    r7, r7, #1
+    bne     3b
+    b       6f
+4:  subs    r7, r7, #4                  @ words
+    strge   r12, [r3], #4
+    bgt     4b
+    beq     6f
+    add     r7, r7, #4                  @ the last 1..3 bytes
+5:  strb    r12, [r3], #1
+    subs    r7, r7, #1
+    bne     5b
+6:  cmp     r0, r5
+    blt     2b
+    str     r9, [r11]                   @ buffer -> VRAM
+    str     r8, [r11, #4]
+    str     r6, [r11, #8]
+8:  add     r1, r1, #1
+    b       1b
+9:  add     sp, sp, #240
+    pop     {r4-r11, lr}
+    bx      lr
+    .size   layer_rows, . - layer_rows
+    .ltorg
