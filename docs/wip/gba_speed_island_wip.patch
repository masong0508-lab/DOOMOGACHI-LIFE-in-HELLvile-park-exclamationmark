 {
     static uint32_t stack_hw;
@@ -199,6 +211,7 @@ void plat_end_frame(void)
         gba_mailbox.work_sum += w;
         gba_mailbox.work_n++;
         if (w > gba_mailbox.work_max) gba_mailbox.work_max = w;
