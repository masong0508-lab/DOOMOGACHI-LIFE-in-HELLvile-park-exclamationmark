diff --git a/core/tests/test_layer.c b/core/tests/test_layer.c
new file mode 100644
index 0000000..2c32a7f
--- /dev/null
+++ b/core/tests/test_layer.c
@@ -0,0 +1,57 @@
+/* test_layer.c - the kept static layer (platform.h plat_layer_*; owner:
+ * gba speed pass). A scene that keeps a layer must draw exactly the same
+ * pixels as when the platform keeps nothing: the free play island is run
+ * frame by frame at both resolutions, day / dusk / night, with the native
+ * platform's layer on and off, and every frame is compared. */
+#include "test.h"
+#include "../src/fp_int.h"
+#include "../src/fp_island.h"
+
+static uint32_t frame_hash(void)
+{
+    uint32_t h = 2166136261u;
+    int p;
+    for (p = 0; p < nat_w * nat_h; p++) h = (h ^ nat_fb[p]) * 16777619u;
+    return h;
+}
+
+/* each frame of the island drawn twice, with the layer kept (as the
+ * game does: captured on the first frame, restored after) and without */
+static int island_check(int minute, int n)
+{
+    int k;
+    fp_new_island(TOWN_POP_PREMADE, 4242);
+    scene_set(&SCENE_ISLAND, FP_ISLAND_ARG_RETURN);
+    for (k = 0; k < n; k++) {
+        uint32_t kept, drawn;
+        doomo_town.minute = (uint16_t)minute;
+        plat_begin_frame();
+        doomo_frame(0);
+        plat_end_frame();
+        SCENE_ISLAND.draw();
+        kept = frame_hash();
+        nat_layer_off = 1;
+        SCENE_ISLAND.draw();
+        nat_layer_off = 0;
+        drawn = frame_hash();
+        if (kept != drawn) return k;
+    }
+    return -1;
+}
+
+TEST(layer_island_same_pixels_as_drawn)
+{
+    static const int minutes[] = { 8 * 60, 19 * 60, 23 * 60 };
+    int res, m, bad;
+    for (res = 0; res < 2; res++) {
+        nat_w = res ? 320 : 240;
+        nat_h = res ? 240 : 160;
+        for (m = 0; m < DOOMO_COUNTOF(minutes); m++) {
+            bad = island_check(minutes[m], 200);
+            CHECK_MSG(bad < 0, "island %dx%d minute %d: frame %d differs with the layer kept",
+                      nat_w, nat_h, minutes[m], bad);
+        }
+    }
+    nat_w = 240;
+    nat_h = 160;
+}
