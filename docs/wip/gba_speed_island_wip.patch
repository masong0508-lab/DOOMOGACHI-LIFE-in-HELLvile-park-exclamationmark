+/* GBA_HC_FRAME_HASH (hcmd.h): the drawn frame's FNV-1a, logged */
+uint16_t gba_fhash_left;
+static void fhash_log(void)
+{
+    const uint32_t *p = (const uint32_t *)gba_back;
+    uint32_t h = 2166136261u;
+    int i;
+    for (i = 0; i < SCREEN_W * SCREEN_H / 4; i++) h = (h ^ p[i]) * 16777619u;
+    gba_fhash_left--;
+    gba_logf("fhash %u %x", (unsigned)gba_frames, (unsigned)h);
+}
+
