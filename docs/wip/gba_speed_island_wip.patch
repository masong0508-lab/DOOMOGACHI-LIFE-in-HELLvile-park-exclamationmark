+/* the kept static layer (platform.h): a copy of its rows, 0 = nothing
+ * drawn there (the 2D layer never draws index 0 on purpose); tests can
+ * switch it off (nat_layer_off) to compare against drawing it */
+int nat_layer_off;
+static uint8_t lay_pix[NAT_MAX_W * NAT_MAX_H];
+static uint32_t lay_key;
+static int lay_y0, lay_y1, lay_w, lay_ok, lay_open;
+
+int plat_layer_begin(uint32_t key, int y0, int y1)
+{
+    if (nat_layer_off) return 0;
+    y0 = DOOMO_CLAMP(y0, 0, nat_h);
+    y1 = DOOMO_CLAMP(y1, y0, nat_h);
+    lay_ok = 0;
+    lay_open = 1;
+    lay_key = key;
+    lay_y0 = y0;
+    lay_y1 = y1;
+    lay_w = nat_w;
+    memset(&nat_fb[y0 * nat_w], 0, (size_t)((y1 - y0) * nat_w));
+    return 1;
+}
+
+void plat_layer_end(void)
+{
+    if (!lay_open) return;
+    lay_open = 0;
+    memcpy(lay_pix, &nat_fb[lay_y0 * lay_w], (size_t)((lay_y1 - lay_y0) * lay_w));
+    lay_ok = 1;
+}
+
+int plat_layer_restore(uint32_t key)
+{
+    int i, n;
+    const uint8_t *s;
+    uint8_t *d;
+    if (nat_layer_off || !lay_ok || key != lay_key || lay_w != nat_w || lay_y1 > nat_h) return 0;
+    n = (lay_y1 - lay_y0) * lay_w;
+    s = lay_pix;
+    d = &nat_fb[lay_y0 * lay_w];
+    for (i = 0; i < n; i++) if (s[i]) d[i] = s[i];
+    return 1;
+}
