+/* the reaction over an actor: !, hearts, the bubble, the sweat drop */
+static void draw_reaction(const DoomoRoomView *v)
+{
+    const DoomoRoomActor *a = NULL;
+    int sx, sy, age = H->react_age, idx;
+    Proj p;
