+        }
+        break;
+    }
+    case HMN_ROOMS:
+        H->menu = HMN_NONE;
+        if (H->rows[H->sel] != H->room) start_cut(CUT_ROOM, H->rows[H->sel]);
+        break;
+    case HMN_GROUP:
+        H->menu = HMN_NONE;
+        if (H->sel == GI_COPY) { home_edit_copy(&H->ed, H->sel_idx, H->nsel, &H->clip); say("Copied."); }
+        else if (H->sel == GI_PASTE) {
