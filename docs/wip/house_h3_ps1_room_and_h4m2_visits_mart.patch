+            H->ins_age = 0;
+            audio_music_mute(ht[HT_INSERT]);
+            camfx_shake(SHK_IMPACT);
+        }
+    } else if (H->hn == HN_INSERT && H->hn_age > ht[HT_INSERT] + ht[HT_INSERT_GAP] + ht[HT_FINE_AT]) {
+        say(H->pet_on ? "bep?" : "...it's fine.");
