+/* ---- camera --------------------------------------------------------------------- */
+static void look_from(int ang, int32_t lx, int32_t ly, int32_t lz, int32_t *ex, int32_t *ey, int32_t *ez)
+{
+    /* eye = look-at - forward * CAM_DIST; forward = (cos a cos p, sin a cos p, sin p) */
+    int cp = icos(CAM_PITCH), sp = isin(CAM_PITCH);
+    int32_t fwd = (cp * CAM_DIST) >> 4;                    /* x 2^8 -> 16.16 below */
+    *ex = lx - ((icos(ang) * fwd) >> 4);
+    *ey = ly - ((isin(ang) * fwd) >> 4);
+    *ez = lz - ((sp * CAM_DIST) << 4);
+}
+
+/* fit the room's box into the viewport for view k at zoom 1.0 */
+static void fit(RC *c, int k)
+{
+    const DoomoRoomView *v = c->v;
+    uint32_t key = mix(mix(mix(mix(0x51u, (uint32_t)c->W), (uint32_t)c->D), (uint32_t)k),
+                       (uint32_t)(c->vw | (c->vh << 10) | (v->room_kind << 20)));
+    int32_t ex, ey, ez, lx = (c->W * RT) << 15, ly = (c->D * RT) << 15, lz = LOOK_Z << 16;
+    int ang = (YAW_BASE - k * 1024) & 4095, i, H0 = 600, top = v->room_kind == ROOMK_WALLS ? WALL_H : 8;
+    int minx = 9999, maxx = -9999, miny = 9999, maxy = -9999, bw, bh, s;
+    if (key == R.fit_key) return;
+    look_from(ang, lx, ly, lz, &ex, &ey, &ez);
+    r3_camera(ex, ey, ez, ang, CAM_PITCH, 0, 0, c->vw, c->vh, H0, CAM_FAR, CAM_FAR, 0);
+    c->cx = g_cam.px; c->cy = g_cam.py; c->cz = g_cam.pz;
+    for (i = 0; i < 8; i++)
+        vset(c, i, (i & 1) ? c->W * RT : 0, (i & 2) ? c->D * RT : 0, (i & 4) ? top : -LIP_H);
+    xform(c, 8);
+    for (i = 0; i < 8; i++) {
+        int x = SXV(c, i), y = SYV(c, i);
+        if (x < minx) minx = x;
+        if (x > maxx) maxx = x;
+        if (y < miny) miny = y;
+        if (y > maxy) maxy = y;
+    }
+    bw = maxx - minx + 1;
+    bh = maxy - miny + 1;
+    s = ((c->vw - 20) << 8) / bw;
+    if (((c->vh - 14) << 8) / bh < s) s = ((c->vh - 14) << 8) / bh;
+    R.fit_h = (H0 * s) >> 8;
+    /* the box's centre goes to the viewport's centre */
+    R.fit_dx = (int16_t)(-(((minx + maxx) / 2 - c->vw / 2) * s >> 8));
+    R.fit_dy = (int16_t)(-(((miny + maxy) / 2 - c->vh / 2) * s >> 8));
+    R.fit_key = key;
+}
+
+/* the spring, the cutaway and the drop-and-pop; dt = ticks since last call */
+static int camera_step(RC *c, int dt)
+{
+    const DoomoRoomView *v = c->v;
+    int32_t tgt, cur;
+    int a, w;
+    int reset = !R.have || dt > 40;
+    /* unwrap the target next to the spring's */
+    tgt = R.yaw_tgt + ((((int)v->yaw - (int)(R.yaw_tgt & 4095)) + 2048) & 4095) - 2048;
+    if (reset) {
+        tgt = v->yaw & 4095;
+        tw_spring_init(&R.yaw, TW_BOING, tgt * 16);
+        R.have = 1;
+    }
+    if (tgt != R.yaw_tgt || reset) tw_spring_target(&R.yaw, tgt * 16);
+    R.yaw_tgt = tgt;
+    cur = tgt * 16;
+    {
+        int i;
+        for (i = 0; i < dt && i < 4; i++) cur = tw_spring_step(&R.yaw);
+        if (!dt) cur = R.yaw.e + R.yaw.target;
+    }
+    if (reset) cur = tgt * 16;
+    a = (YAW_BASE - (cur >> 4)) & 4095;
+    /* cutaway: a wall whose outward normal faces the camera is a stub */
+    {
+        int ca = icos(a), sa = isin(a), d[4], hy = 600;
+        d[0] = sa; d[1] = ca; d[2] = -sa; d[3] = -ca;        /* > 0: faces the camera */
+        for (w = 0; w < 4; w++) {
+            int back = R.wall_back[w];
+            if (reset) back = d[w] <= 0;
+            else if (d[w] > hy) back = 0;
+            else if (d[w] < -hy) back = 1;
+            if (back != R.wall_back[w] && !reset) R.wall_age[w] = 0;
+            if (reset) R.wall_age[w] = 0xFF;
+            R.wall_back[w] = (uint8_t)back;
+        }
+    }
+    /* the drop-and-pop: falling walls bounce off the floor, rising ones overshoot */
+    for (w = 0; w < 4; w++) {
+        static const uint8_t drop[4] = { 70, 22, 4, 16 }, rise[4] = { 40, 104, 140, 124 };
+        int age = R.wall_age[w];
+        int h = R.wall_back[w] ? WALL_H : STUB_H;
+        if (age != 0xFF) {
+            if (age < 4) h = R.wall_back[w] ? rise[age] : drop[age];
+            age += dt;
+            R.wall_age[w] = (uint8_t)(age >= 4 ? 0xFF : age);
+        }
+        c->wall_h[w] = v->room_kind == ROOMK_WALLS ? h : 0;
+    }
+    return a;
+}
+
+/* ---- the frame ------------------------------------------------------------------ */
+static uint32_t cache_sum(const RCV *e, int n)
+{
+    const uint16_t *p = (const uint16_t *)e;
+    uint32_t s = 0x1234u;
+    int i;
+    for (i = 0; i < n * 5; i++) s += p[i] + (s << 1);
+    return s;
+}
+
+static void lamps(RC *c)
+{
+    const DoomoRoomView *v = c->v;
+    int i;
+    c->nlamp = 0;
+    for (i = 0; i < v->nobj && c->nlamp < 4; i++) {
+        const DoomoRoomObj *o = &v->objs[i];
+        const DoomoFurn *f = furn_of(o);
+        int W, D;
+        if (!f || !(f->flags & FF_LIGHT) || (o->flags & RO_GHOST)) continue;
+        if (!(o->flags & RO_FULLBRIGHT) && v->daylight >= 9) continue;
+        W = (RO_ROT(o) & 1) ? f->fd : f->fw;
+        D = (RO_ROT(o) & 1) ? f->fw : f->fd;
+        c->lamp_x[c->nlamp] = o->x * RT + (W ? W : 1) * RT / 2;
+        c->lamp_y[c->nlamp] = o->y * RT + (D ? D : 1) * RT / 2;
+        c->lamp_r2[c->nlamp] = (f->light_r ? f->light_r : 2) * RT;
+        c->lamp_r2[c->nlamp] *= c->lamp_r2[c->nlamp];
+        c->nlamp++;
+    }
+}
+
+static void render(const DoomoRoomView *v)
+{
+    RC c;
+    int a, k, dt, i, H, zoom, punch;
+    uint32_t t0 = timer_us(), key;
+    int32_t lx, ly, lz, ex, ey, ez;
+    uint8_t wall_pix[WALL_TW * WALL_TH], floor_pix[FLOOR_TW * 16];
+    DoomoImage wimg, fimg;
+    TexRef wt, ft;
+    uint16_t clut;
+    memset(&c, 0, offsetof(RC, in));
+    c.v = v;
+    c.W = clampi(v->w, 1, 16);
+    c.D = clampi(v->d, 1, 16);
+    c.vw = v->vw ? v->vw : plat_screen_w();
+    c.vh = v->vh ? v->vh : plat_screen_h();
+    dt = (uint16_t)(v->time - R.time);
+    R.time = v->time;
+    a = camera_step(&c, dt);
+    k = (((int)(v->yaw & 4095) + 512) >> 10) & 3;
+    fit(&c, k);
+    /* zoom: overview / close-up on the player, smoothed */
+    {
+        int want = v->zoom ? 410 : 256;
+        int32_t tlx = (c.W * RT) << 15, tly = (c.D * RT) << 15;
+        if (v->zoom)
+            for (i = 0; i < v->nact; i++)
+                if (v->actors[i].flags & RA_PLAYER) {
+                    tlx = tlx / 5 + (v->actors[i].x * RT / 5) * 4;
+                    tly = tly / 5 + (v->actors[i].y * RT / 5) * 4;
+                }
+        if (!R.zoom_q8 || dt > 40) { R.zoom_q8 = want; R.lx = tlx; R.ly = tly; }
+        R.zoom_q8 += (want - R.zoom_q8) / 3;
+        R.lx += (tlx - R.lx) / 3;
+        R.ly += (tly - R.ly) / 3;
+        zoom = R.zoom_q8;
+        lx = R.lx; ly = R.ly; lz = LOOK_Z << 16;
+    }
+    punch = v->punch_q8 > 0 ? v->punch_q8 : 256;
+    H = (int)(((((int64_t)R.fit_h * zoom) >> 8) * punch >> 8) * postfx_zoom_q8() >> 8);
+    if (H < 64) H = 64;
+    look_from(a, lx, ly, lz, &ex, &ey, &ez);
+    r3_camera(ex, ey, ez, a, CAM_PITCH, v->vx, v->vy, c.vw, c.vh, H, CAM_FAR, CAM_FAR, 0);
+    {
+        /* the fitted centre (scaled with the zoom) and the brake / pan shake */
+        int dx = (R.fit_dx * zoom) >> 8, dy = (R.fit_dy * zoom) >> 8;
+        if (v->zoom) dx = dy = 0;
+        g_cam.cx += dx + v->pan_x;
+        g_cam.cy += dy + v->pan_y;
+        gte_SetGeomOffset(g_cam.cx, g_cam.cy);
+    }
+    c.cx = g_cam.px; c.cy = g_cam.py; c.cz = g_cam.pz;
+    /* light: day colour, the key light turning with the camera */
+    {
+        int d = v->daylight > 15 ? 15 : v->daylight, rot = a - YAW_BASE;
+        int l0x = 77, l0y = 141, cs = icos(rot), sn = isin(rot);
+        c.amb_r = k_day[d][0]; c.amb_g = k_day[d][1]; c.amb_b = k_day[d][2];
+        c.night = 15 - d;
+        c.lx = (l0x * cs - l0y * sn) >> 12;
+        c.ly = (l0x * sn + l0y * cs) >> 12;
+        c.lz = 200;                     /* Q8: shade() gives -256..256 */
+    }
+    lamps(&c);
+    /* background */
+    {
+        TILE *bg = (TILE *)gfx_alloc(sizeof(TILE));
+        if (bg) {
+            uint32_t col = v->room_kind == ROOMK_WALLS ? g_rgb[PAL_RAMP(RAMP_VAPE, 1)]
+                                                       : rgb_q7(g_rgb[PAL_RAMP(RAMP_SKY, 5)], c.amb_r, c.amb_g, c.amb_b);
+            setTile(bg);
+            *(uint32_t *)&bg->r0 = col | ((uint32_t)bg->code << 24);
+            setXY0(bg, v->vx, v->vy);
+            setWH(bg, c.vw, c.vh);
+            gfx_chain(bg);
+        }
+    }
+    if (!r3_begin()) return;
+    /* textures + the CLUT row */
+    {
+        int pat = v->wallpaper == 0xFF ? 0 : (v->wallpaper & 3);
+        int wp = v->wall_paint < 32 ? v->wall_paint : PAINT_BUBBLEGUM;
+        int fp = v->floor_paint < 32 ? v->floor_paint : PAINT_CARAMEL;
+        gen_wall(wall_pix, pat);
+        gen_floor(floor_pix);
+        wimg.w = WALL_TW; wimg.h = WALL_TH; wimg.pix = wall_pix; wimg.uid = 0x524F4F00u | (uint32_t)pat;
+        fimg.w = FLOOR_TW; fimg.h = 16; fimg.pix = floor_pix; fimg.uid = 0x524F4F10u;
+        clut = room_clut(&c, wp, fp, dt != 1);
+        if (!vram_image(&wimg, 0, 0, &wt) || !vram_image(&fimg, 0, 0, &ft)) {
+            r3_end();
+            return;
+        }
+        wt.clut = ft.clut = clut;
+    }
+    /* the cache: key over everything static */
+    {
+        RCHdr *h = (RCHdr *)v->plat_cache;
+        uint32_t cap = v->plat_cache_cap;
+        key = mix(mix(mix(0xC0FFEEu, (uint32_t)a), (uint32_t)H), (uint32_t)(g_cam.cx | (g_cam.cy << 12)));
+        key = mix(mix(key, (uint32_t)(c.cx ^ (c.cy << 11) ^ (c.cz << 22))), (uint32_t)(c.W | (c.D << 5) | (v->room_kind << 10)));
+        key = mix(key, (uint32_t)(v->wallpaper | (v->floor << 8) | (v->wall_paint << 16) | ((uint32_t)v->floor_paint << 24)));
+        key = mix(key, (uint32_t)(v->daylight | (c.wall_h[0] << 4) | (c.wall_h[1] << 12) | (c.wall_h[2] << 20)));
+        key = mix(key, (uint32_t)(c.wall_h[3] | (R.wall_back[0] << 8) | (R.wall_back[1] << 9) | (R.wall_back[2] << 10) | (R.wall_back[3] << 11)));
+        key = mix(key, (uint32_t)g_rgb[PAL_PAINT(1, 1)] ^ (uint32_t)g_rgb[PAL_RAMP(1, 4)]);
+        for (i = 0; i < c.nlamp; i++) key = mix(key, (uint32_t)(c.lamp_x[i] | (c.lamp_y[i] << 12)));
+        for (i = 0; i < v->nobj; i++) {
+            const DoomoRoomObj *o = &v->objs[i];
+            const DoomoFurn *f = furn_of(o);
+            if (f && is_static(o, f)) {
+                const uint32_t *w = (const uint32_t *)o;
+                key = mix(mix(mix(mix(key, (uint32_t)i), w[0]), w[1]), w[2]);
+            }
+        }
+        c.mode = RM_LIVE;
+        if (h && cap >= sizeof(RCHdr) + 64 * sizeof(RCV) && ((uintptr_t)h & 3) == 0) {
+            c.hdr = h;
+            c.cv = (RCV *)(h + 1);
+            c.ccap = (int)((cap - sizeof(RCHdr)) / sizeof(RCV));
+            if (h->magic == RC_MAGIC && h->key == key && h->n <= c.ccap &&
+                h->sum == cache_sum(c.cv, h->n)) {
+                c.mode = RM_REPLAY;
+            } else {
+                /* choose what to keep: the shell, then the biggest static pieces */
+                int left = c.ccap - (2 * (c.W + 1) * c.D + 4 * (2 * 17 + 8) + 8);
+                uint8_t done[96];
+                memset(h, 0, sizeof(*h));
+                memset(done, 0, sizeof(done));
+                for (;;) {
+                    int best = -1, bn = 0;
+                    for (i = 0; i < v->nobj && i < 96; i++) {
+                        const DoomoRoomObj *o = &v->objs[i];
+                        const DoomoFurn *f = furn_of(o);
+                        int n;
+                        if (done[i] || !f || !is_static(o, f) || piece_hidden(&c, o, f)) continue;
+                        n = obj_verts(o, f);
+                        if (n <= left && n > bn) { bn = n; best = i; }
+                    }
+                    if (best < 0) break;
+                    done[best] = 1;
+                    h->objmask[best >> 5] |= 1u << (best & 31);
+                    left -= bn;
+                }
+                c.mode = RM_FILL;
+            }
+        }
+    }
+    /* the room box */
+    c.caching = 1;
+    draw_floor(&c, &ft);
+    if (v->room_kind == ROOMK_WALLS) {
+        for (i = 0; i < 4; i++) draw_wall(&c, i, &wt);
+    } else {
+        draw_lip(&c);
+    }
+    c.caching = 0;
+    /* furniture */
+    for (i = 0; i < v->nobj; i++) {
+        const DoomoRoomObj *o = &v->objs[i];
+        const DoomoFurn *f = furn_of(o);
+        int cached;
+        if (!f || piece_hidden(&c, o, f)) continue;
+        cached = c.mode != RM_LIVE && i < 96 && ((c.hdr->objmask[i >> 5] >> (i & 31)) & 1);
+        draw_piece(&c, o, f, cached);
+    }
+    if (c.mode == RM_FILL) {
+        if (!c.bad && c.cn <= c.ccap) {
+            c.hdr->n = (uint16_t)c.cn;
+            c.hdr->cap = (uint16_t)c.ccap;
+            c.hdr->key = key;
+            c.hdr->sum = cache_sum(c.cv, c.cn);
+            c.hdr->magic = RC_MAGIC;
+        }
+    } else if (c.mode == RM_REPLAY && (c.bad || c.cn != (int)c.hdr->n)) {
+        c.hdr->magic = 0;
+    }
+    /* actors */
+    for (i = 0; i < v->nact; i++) {
+        const DoomoRoomActor *ac = &v->actors[i];
+        if (ac->flags & RA_PLAYER) player(&c, ac);
+        else billboard(&c, ac);
+    }
+    /* cursor and the rubber band */
+    if (v->cursor_x >= 0 && v->cursor_y >= 0 && v->cursor_x < c.W && v->cursor_y < c.D) {
+        uint32_t col = ((v->time >> 3) & 1) ? 0xFFFFFFu : g_rgb[PAL_UI_GOLD];
+        tile_mark(&c, v->cursor_x, v->cursor_y, col, 0);
+        tile_mark(&c, v->cursor_x, v->cursor_y, 0x302010u, 1);
+    }
+    for (i = 0; i < c.W * c.D && i < 128; i++)
+        if ((v->sel_mask[i >> 3] >> (i & 7)) & 1)
+            tile_mark(&c, i % c.W, i / c.W, 0x402818u, 1);
+    r3_end();
+    /* the hell / possession tint (the overworld's full-view TILE) */
+    if (v->tint != TINT_NONE && v->tint < TINT_COUNT && v->tint_level > 0) {
+        static const uint8_t tint_rgb[TINT_COUNT][3] = {
+            {0, 0, 0}, {200, 20, 20}, {220, 180, 40}, {40, 200, 60}, {150, 50, 210}, {0, 0, 0} };
+        int lv = v->tint_level > 15 ? 15 : v->tint_level;
+        TILE *t = (TILE *)gfx_alloc(sizeof(TILE));
+        if (t) {
+            if (v->tint == TINT_NIGHT) {
+                int s = lv * 6;
+                gfx_tpage(getTPage(0, 2, 0, 0));
+                setTile(t);
+                setColor0(t, r3_rgb(s * 2, s * 2, s));
+            } else {
+                int fl = ((v->time >> 2) & 3) == 0 ? 4 : 0;          /* the flicker */
+                gfx_tpage(getTPage(0, 1, 0, 0));
+                setTile(t);
+                setColor0(t, r3_rgb(tint_rgb[v->tint][0] * (lv + fl) / 24, tint_rgb[v->tint][1] * (lv + fl) / 24,
+                                    tint_rgb[v->tint][2] * (lv + fl) / 24));
+            }
+            setSemiTrans(t, 1);
+            setXY0(t, v->vx, v->vy);
+            setWH(t, c.vw, c.vh);
+            gfx_chain(t);
+        }
+    }
+    g_r3stats.polys = (uint16_t)(g_r3stats.polys + c.polys);
+    g_r3stats.cpu_us = timer_us() - t0;
+    g_r3stats.cells = (uint16_t)(c.mode == RM_REPLAY ? 2 : c.mode == RM_FILL ? 1 : 0);
+}
+
+/* ---- harness layouts (hcmd.c `room-test N`) ---------------------------------------- */
+static void put(HomeRoom *r, int furn, int x, int y, int rot, int z4, int pa, int pb)
+{
+    HomeObj *o = &r->obj[r->nobj++];
+    o->w0 = HO_W0(furn, rot, z4 > 0);
+    o->pos = HO_POS(x, y);
+    o->z = (uint8_t)z4;
+    o->pa = (uint8_t)(pa < 0 ? FURN_PAINT_DEFAULT : pa);
+    o->pb = (uint8_t)(pb < 0 ? FURN_PAINT_DEFAULT : pb);
+}
+
+/* The parity layout of core/tests/test_home_render.c (as gba/src/room.c). */
+static void parity_room(HomeRoom *r)
+{
+    home_room_template(HOME_ROOM_LIVING, r);
+    put(r, FURN_CLOUD_BED, 4, 1, 0, 0, -1, -1);
+    put(r, FURN_MARSHMALLOW_SOFA, 1, 4, 0, 0, PAINT_LAVENDER, -1);
+    put(r, FURN_TEACUP_TABLE, 2, 2, 0, 0, -1, -1);
+    put(r, FURN_CUPCAKE_LAMP, 5, 4, 0, 0, -1, -1);
+    put(r, FURN_DAISY_RUG, 3, 3, 0, 0, -1, -1);
+    put(r, FURN_BUNNY_BEANBAG, 4, 4, 1, 0, PAINT_SKY, -1);
+    put(r, FURN_RAINBOW_BOOKCASE, 2, 0, 0, 0, -1, -1);
+    put(r, FURN_HEART_MIRROR, 3, 0, 0, 6, -1, -1);
+    put(r, FURN_PIPS_BEE_DRAWING, 0, 3, 1, 8, -1, -1);
+    put(r, FURN_JELLYBEAN_JAR, 2, 2, 0, 5, -1, -1);
+    put(r, FURN_HORNED_POOP_PLUSH, 0, 5, 0, 0, -1, -1);
+    put(r, FURN_POTTED_FERN, 5, 2, 0, 0, -1, -1);
+}
+
+/* STEADY: the parity room + 3 animated pieces + 3 walking citizens (the
+ * scene's own player, cursor and ghost stay); ORBIT: the same while the yaw
+ * turns 12 units a tick; CELLAR: 8x8, 40 pieces, dim; DROP: STEADY with
+ * the bed in its soft DROP squash. */
+static void test_render(const DoomoRoomView *v)
+{
+    static const uint16_t cellar_set[8] = {
+        FURN_CUPCAKE_LAMP, FURN_POTTED_FERN, FURN_TEACUP_TABLE, FURN_BUNNY_BEANBAG,
+        FURN_HORNED_POOP_PLUSH, FURN_JELLYBEAN_JAR, FURN_LAVA_LAMP, FURN_TUBE_TV };
+    HomeRoom rr;
+    DoomoRoomObj objs[HOME_OBJ_MAX + 4];
+    DoomoRoomActor acts[6];
+    DoomoRoomView tv = *v;
+    uint32_t t = v->time;
+    int i, n = 0, na = 0, walkers = 0, mode = g_room_test;
+    if (mode == ROOM_TEST_CELLAR) {
+        tv.w = tv.d = 8;
+        home_room_template(HOME_ROOM_CELLAR, &rr);
+        for (i = 0; i < rr.nobj && n < HOME_OBJ_MAX; i++) home_obj_view(&rr.obj[i], &objs[n++]);
+        for (i = 0; n < HOME_OBJ_MAX; i++) {
+            memset(&objs[n], 0, sizeof(objs[n]));
+            objs[n].furn = cellar_set[i & 7];
+            objs[n].x = (uint8_t)(1 + (i % 7));
+            objs[n].y = (uint8_t)(1 + (i / 7) % 7);
+            objs[n].rot_anim = RO_ROT_ANIM(i & 3, (t >> 3) & 1);
+            objs[n].paint_a = (uint8_t)(i % 5 == 0 ? PAINT_MINT : 0xFF);
+            objs[n].paint_b = 0xFF;
+            n++;
+        }
+        tv.daylight = 6;
+    } else {
+        parity_room(&rr);
+        tv.w = (uint8_t)HR_W(&rr);
+        tv.d = (uint8_t)HR_D(&rr);
+        tv.wallpaper = home_room_defs[HOME_ROOM_LIVING].wallpaper;
+        tv.floor = home_room_defs[HOME_ROOM_LIVING].floor;
+        tv.wall_paint = home_room_defs[HOME_ROOM_LIVING].wall_paint;
+        tv.floor_paint = home_room_defs[HOME_ROOM_LIVING].floor_paint;
+        tv.room_kind = ROOMK_WALLS;
+        for (i = 0; i < rr.nobj; i++) home_obj_view(&rr.obj[i], &objs[n++]);
+        {
+            static const uint8_t ax[3] = { 0, 1, 5 }, ay[3] = { 1, 2, 0 };
+            static const uint16_t af[3] = { FURN_TUBE_TV, FURN_LAVA_LAMP, FURN_LULLA_NIGHTLIGHT };
+            for (i = 0; i < 3; i++) {
+                memset(&objs[n], 0, sizeof(objs[n]));
+                objs[n].furn = af[i];
+                objs[n].x = ax[i];
+                objs[n].y = ay[i];
+                objs[n].rot_anim = RO_ROT_ANIM(i == 0 ? 1 : 0, (t >> 3) & 1);
+                objs[n].paint_a = objs[n].paint_b = 0xFF;
+                objs[n].flags = RO_FULLBRIGHT;
+                n++;
+            }
+        }
+        if (mode == ROOM_TEST_DROP) {
+            objs[0].sq_x = 20;               /* the soft DROP's mid-squash, 1.16 / 0.84 */
+            objs[0].sq_y = -20;
+        }
+        if (mode == ROOM_TEST_ORBIT) tv.yaw = (int16_t)((t * 12) & 4095);
+        walkers = 3;
+    }
+    for (i = 0; i < v->nobj && n < HOME_OBJ_MAX + 4; i++)
+        if (v->objs[i].flags & RO_GHOST) objs[n++] = v->objs[i];
+    for (i = 0; i < v->nact && na < 2; i++) acts[na++] = v->actors[i];
+    for (i = 0; i < walkers && na < 6; i++) {
+        uint32_t ph = (t * (uint32_t)(3 + i)) % 160u;
+        fix16 p = (fix16)(ph < 80 ? ph : 160 - ph) * (FIX_ONE / 16);
+        memset(&acts[na], 0, sizeof(acts[na]));
+        acts[na].img = bodyspr_image(1 + i % 3, ph < 80 ? 0 : 3, (int)(t >> 2) & 3);
+        acts[na].x = (i & 1) ? INT2FIX(1) / 2 + p : INT2FIX(i % 5) + FIX_ONE / 2;
+        acts[na].y = (i & 1) ? INT2FIX(i % 5) + FIX_ONE / 2 : INT2FIX(1) / 2 + p;
+        acts[na].sx = acts[na].sy = 256;
+        acts[na].flags = (uint8_t)((ph < 80 ? 0 : BB_FLIPX) | BB_SHADOW);
+        na++;
+    }
+    tv.objs = objs;
+    tv.nobj = n;
+    tv.actors = acts;
+    tv.nact = na;
+    render(&tv);
+}
+
+void plat_room(const DoomoRoomView *v)
+{
+    if (!v || plat_draw_skipped())
+        return;
+    if (g_room_test)
+        test_render(v);
+    else
+        render(v);
+}
