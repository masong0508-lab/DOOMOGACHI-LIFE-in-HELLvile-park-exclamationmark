+        int k = H->react_actor - AC_VISITOR0, i, seen = 0;
+        for (i = 0; i < H->nact; i++)
+            if (H->act[i].img != &spr_pet && i > 0 && seen++ == k) { idx = i; break; }
+    }
+    if (idx >= v->nact) return;
