+void music_pos(MusPos *out)
+{
+    uint32_t u, c;
+    int meter;
+    const MusBarLog *l;
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+    if (!DECK_A_ON()) return;
+    c = (clk() - C.lat) & MUS_POS_MASK;
