+/* mus_vinyl.c - the record-scratch DSP: patterns, the platter speed and
+ * DECK scrubbing (owner: MU1; docs/design/music/SPEC.md sec.7, D6, D11,
+ * CF-19, CF-20, CF-40).
+ *
+ * A pattern is a list of 4-byte segments (mus_data.h MUS_MISC_VINYL): a
+ * length in units, a platter speed v0 -> v1 in 1/16 along a curve (linear,
+ * ease, a sine hump v0 -> v1 -> v0, exponential), a fader action and a
+ * seeded 0-11 % hand jitter. The 17 built-in patterns below are sec.7.2's;
+ * a bank that brings its own vinyl table (MU4d) overrides them by id.
+ *
+ * mus_vinyl_speed(p, t, seed) is a pure function of the unit t since the
+ * pattern's start, called by the driver every control frame (pitch and
+ * gain) and by the arranger once per unit (where the playhead P is), so
+ * the two agree bit for bit (T9). P = start + sum of the speeds / 256.
+ *
+ * DECK (everywhere, 0 B): ring A keeps its look-ahead under a mute window
+ * (the ghost keeps time), the driver bends deck A's voices, and each
+ * music_update() looks a window of clamp(gap + 8, 16, 48) mt ahead (CF-19):
+ * every 3 units it asks the scrub decoder (deck B's storage, CF-20's bar
+ * log) which note each pitched voice sounds at P and posts a re-key on ring
+ * B whenever it changes, so scratching backwards plays the earlier notes in
+ * reverse with fresh attacks. TAPE is M7: VSRC_TAPE falls back to DECK. */
+#include "mus_int.h"
+
+MusVinylRt mus_vy;
+
+#define SG(len, v0, v1, curve, fader, jit) len, (uint8_t)(int8_t)(v0), (uint8_t)(int8_t)(v1), \
+    (uint8_t)((curve) | ((fader) << 2) | ((jit) << 5))
+#define HUMP(len, v, fd, j) SG(len, 0, v, MVC_SINE, fd, j)
+#define HOLD(len, v, fd) SG(len, v, v, MVC_LIN, fd, 0)
+
+/* MusVinyl header { n_seg, flags (AFTER_* | MVY_BEND_ONLY), beats_q4, 0 } + segments */
+static const uint8_t vy_baby[]   = { 2, AFTER_RESUME, 2, 0, HUMP(12, 38, MVD_OPEN, 2), HUMP(12, -38, MVD_OPEN, 2) };
+static const uint8_t vy_fwd[]    = { 3, AFTER_RESUME, 1, 0, SG(4, 0, 48, MVC_EASE, MVD_OPEN, 1),
+                                     SG(4, 48, 0, MVC_EASE, MVD_OPEN, 1), HUMP(4, -32, MVD_CLOSED, 0) };
+static const uint8_t vy_chirp[]  = { 2, AFTER_RESUME, 1, 0, HUMP(6, 42, MVD_CHIRP, 1), HUMP(6, -42, MVD_CHIRP, 1) };
+static const uint8_t vy_trans[]  = { 2, AFTER_RESUME, 4, 0, HOLD(24, 19, MVD_GATE32), HOLD(24, -19, MVD_GATE32) };
+static const uint8_t vy_tear[]   = { 3, AFTER_RESUME, 2, 0, HUMP(6, 32, MVD_OPEN, 2), HUMP(6, 32, MVD_OPEN, 2),
+                                     HUMP(12, -40, MVD_OPEN, 2) };
+static const uint8_t vy_flare[]  = { 2, AFTER_RESUME, 2, 0, HUMP(12, 38, MVD_FLARE, 1), HUMP(12, -38, MVD_FLARE, 1) };
+static const uint8_t vy_scrib[]  = { 8, AFTER_RESUME, 2, 0, HOLD(3, 21, 0), HOLD(3, -21, 0), HOLD(3, 21, 0),
+                                     HOLD(3, -21, 0), HOLD(3, 21, 0), HOLD(3, -21, 0), HOLD(3, 21, 0), HOLD(3, -21, 0) };
+static const uint8_t vy_wikka[]  = { 8, AFTER_RESUME, 4, 0, HUMP(6, 19, 0, 1), HUMP(6, -19, 0, 1), HUMP(6, 26, 0, 1),
+                                     HUMP(6, -26, 0, 1), HUMP(6, 32, 0, 1), HUMP(6, -32, 0, 1), HUMP(6, 38, 0, 1),
+                                     HUMP(6, -38, 0, 1) };
+static const uint8_t vy_rewind[] = { 2, AFTER_CONTINUE, 4, 0, SG(12, 16, -64, MVC_EXP, MVD_OPEN, 0), HOLD(36, -64, 0) };
+static const uint8_t vy_spin[]   = { 1, AFTER_RESUME, 16, 0, SG(192, -96, 0, MVC_EXP, MVD_OPEN, 0) };
+static const uint8_t vy_stop[]   = { 1, AFTER_STOP, 2, 0, SG(24, 16, 0, MVC_EXP, MVD_OPEN, 0) };
+static const uint8_t vy_needle[] = { 2, AFTER_STOP, 1, 0, SG(4, 16, 48, MVC_LIN, MVD_OPEN, 0),
+                                     SG(8, 48, 0, MVC_EXP, MVD_OPEN, 0) };
+static const uint8_t vy_stut[]   = { 8, AFTER_RESUME, 2, 0, HOLD(3, -64, 0), HOLD(3, 16, 0), HOLD(3, -64, 0),
+                                     HOLD(3, 16, 0), HOLD(3, -64, 0), HOLD(3, 16, 0), HOLD(3, -64, 0), HOLD(3, 16, 0) };
+static const uint8_t vy_slowmo[] = { 3, AFTER_RESUME, 16, 0, SG(48, 16, 8, MVC_EASE, 0, 0), HOLD(96, 8, 0),
+                                     SG(48, 8, 16, MVC_EASE, 0, 0) };
+static const uint8_t vy_wobble[] = { 2, AFTER_RESUME | MVY_BEND_ONLY, 0, 0, SG(60, 16, 17, MVC_SINE, 0, 0),
+                                     SG(60, 16, 15, MVC_SINE, 0, 0) };
+static const uint8_t vy_tstop[]  = { 1, AFTER_STOP, 2, 0, SG(24, 16, 7, MVC_LIN, MVD_OPEN, 0) };
+
+static const uint8_t *const vy_builtin[VINYL_TAPESTOP + 1] = {
+    NULL, vy_baby, vy_fwd, vy_chirp, vy_trans, vy_tear, vy_flare, vy_scrib, vy_wikka, vy_rewind,
+    vy_spin, vy_stop, vy_needle, vy_stut, NULL /* CRACKLE: a toggle */, vy_slowmo, vy_wobble, vy_tstop
+};
+
+int mus_vinyl_get(int pattern, MusVinylView *out)
+{
+    const uint8_t *p = NULL, *tab = mus_bank_misc(MUS_MISC_VINYL);
+    int i;
+    if (pattern <= 0) return 0;
+    if (tab && pattern < mus_bank()->n_vinyl && mus_rd16(tab + 2 * pattern)) p = tab + mus_rd16(tab + 2 * pattern);
+    else if (pattern <= VINYL_TAPESTOP) p = vy_builtin[pattern];
+    if (!p || !p[0]) return 0;
+    out->seg = p + 4;
+    out->n_seg = p[0];
+    out->flags = p[1];
+    out->len = 0;
+    for (i = 0; i < p[0]; i++) out->len = (uint16_t)(out->len + p[4 + 4 * i]);
+    return 1;
+}
+
+/* the segment holding unit t (patterns with beats_q4 = 0 loop) */
+static const uint8_t *seg_at(const MusVinylView *p, int *t, int *k)
+{
+    const uint8_t *s = p->seg;
+    int i;
+    if (p->len && *t >= p->len) {
+        if (!(p->flags & MVY_BEND_ONLY)) { *k = p->n_seg - 1; *t = s[4 * *k]; return s + 4 * *k; }
+        *t %= p->len;
+    }
+    for (i = 0; i < p->n_seg; i++, s += 4) {
+        if (*t < s[0] || i == p->n_seg - 1) { *k = i; return s; }
+        *t -= s[0];
+    }
+    *k = 0;
+    return p->seg;
+}
+
+int mus_vinyl_speed(const MusVinylView *p, int t, uint32_t seed)
+{
+    int k, f, c, v0, v1, v, jit;
+    const uint8_t *s = seg_at(p, &t, &k);
+    f = s[0] ? (t * 256) / s[0] : 256;
+    if (f > 256) f = 256;
+    switch (s[3] & 3) {
+    case MVC_EASE: c = (f * f * (768 - 2 * f)) >> 16; break;
+    case MVC_SINE: { int a = f * 8; c = (int)(doomo_sin_q[a <= 1024 ? a : 2048 - a] >> 8); break; }
+    case MVC_EXP:  c = 256 - (((256 - f) * (256 - f)) >> 8); break;
+    default:       c = f; break;
+    }
+    v0 = (int8_t)s[1] * 16;
+    v1 = (int8_t)s[2] * 16;
+    v = v0 + (((v1 - v0) * c) >> 8);
+    jit = (s[3] >> 5) * 4;
+    if (jit) v += (v * ((int)(mus_h(seed, S_VINYL, (uint32_t)k, 0) % (uint32_t)(2 * jit + 1)) - jit)) >> 8;
+    return v;
+}
+
+int mus_vinyl_fader(const MusVinylView *p, int t)
+{
+    int k;
+    const uint8_t *s = seg_at(p, &t, &k);
+    switch ((s[3] >> 2) & 7) {
+    case MVD_CLOSED: return 0;
+    case MVD_CHIRP:  return 2 * t < s[0];
+    case MVD_GATE32: return (t / 3) % 2 == 0;
+    case MVD_FLARE:  return t < s[0] / 2 - 1 || t > s[0] / 2;
+    default:         return 1;
+    }
+}
+
+int32_t mus_vinyl_disp(const MusVinylView *p, int t, uint32_t seed)
+{
+    int32_t d = 0;
+    int i;
+    for (i = 0; i < t; i++) d += mus_vinyl_speed(p, i, seed);
+    return d;
+}
+
+/* 192 log2(|v| / 256) in 1/16 semitones */
+int mus_vinyl_pitch(int v)
+{
+    static const uint8_t lg[17] = { 0, 17, 33, 48, 62, 75, 88, 101, 112, 124, 134, 145, 155, 165, 174, 183, 192 };
+    int e = 0, m, i;
+    if (v < 0) v = -v;
+    if (v < 16) return -4 * 192;
+    m = v;
+    while (m >= 512) { m >>= 1; e++; }
+    while (m < 256) { m <<= 1; e--; }
+    i = (m - 256) >> 4;
+    return e * 192 + lg[i] + (((lg[i + 1] - lg[i]) * (m & 15)) >> 4);
+}
+
+int mus_vinyl_gain(int v)
+{
+    if (v < 0) v = -v;
+    return v < 16 ? 0 : v >= 128 ? 256 : 2 * v;
+}
+
+/* ---- DECK: re-keys for the window ahead (CF-19) ---------------------------------- */
+void mus_vinyl_update(void)
+{
+    MusScrubNote nt[MUS_A_VOICES];
+    MusVinylView vw;
+    uint32_t until;
+    int t_end, win, i;
+    if (!mus_vy.on || mus_vy.live || !mus_vinyl_get(mus_vy.pattern, &vw)) return;
+    /* the window: 16 mt on the bridge (gaps of 8 mt), 48 mt under an IRQ driver */
+    win = (int)((mus_drv_tempo() * (mus_core_bridge() ? 16u : 48u)) >> 16) + 1;
+    until = (mus_drv_clock() + (uint32_t)win) & MUS_POS_MASK;
+    t_end = (int)mus_pdiff(until, mus_vy.start);
+    if (t_end > vw.len) t_end = vw.len;
+    while (mus_vy.t < t_end) {
+        int t = mus_vy.t;
+        if (t % 3 == 0 && mus_drv_room(1) >= 2 * MUS_A_VOICES) {
+            uint32_t pos = (mus_vy.start + (uint32_t)t) & MUS_POS_MASK;
+            uint8_t got;
+            mus_vy.P = (mus_vy.start + (uint32_t)((mus_vy.disp + 128) >> 8)) & MUS_POS_MASK;
+            got = mus_core_scrub(mus_vy.P, nt);
+            for (i = 0; i < MUS_A_VOICES; i++) {
+                int has = (got >> i) & 1;
+                if (!has && !mus_vy.key[i]) continue;
+                if (has && mus_vy.key[i] == nt[i].pitch && mus_vy.kstart[i] == nt[i].start) continue;
+                if (has) {
+                    mus_drv_push(1, MEV_MAKE_POS(MEV_INST, pos), MEV_INST_ARG(i, nt[i].inst, MUS_INST(nt[i].inst)->tparam, nt[i].vel));
+                    mus_drv_push(1, MEV_MAKE_POS(MEV_NOTE, pos), MEV_NOTE_ARG(i, nt[i].pitch, nt[i].vel, 0, 0));
+                    mus_vy.key[i] = nt[i].pitch;
+                    mus_vy.kstart[i] = nt[i].start;
+                } else {
+                    mus_drv_push(1, MEV_MAKE_POS(MEV_OFF, pos), MEV_OFF_ARG(i, MOFF_RELEASE));
+                    mus_vy.key[i] = 0;
+                }
+            }
+        } else if (t % 3 == 0) break;                           /* ring B full: next tick */
+        mus_vy.disp += mus_vinyl_speed(&vw, t, mus_vy.seed);
+        mus_vy.t++;
+    }
+    if (mus_vy.t >= vw.len) mus_core_vinyl_done();
+}
