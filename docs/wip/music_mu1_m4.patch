+    push_b(MEV_GAIN, mus_core_pos_in(DOOMO_MAX(from, 1)), MEV_GAIN_ARG(24, DOOMO_CLAMP(gain_q8, 0, 255), 16));
+    push_b(MEV_GAIN, mus_core_pos_in(to), MEV_GAIN_ARG(24, 255, 32));
