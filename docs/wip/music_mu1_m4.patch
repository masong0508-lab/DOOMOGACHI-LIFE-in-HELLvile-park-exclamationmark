+static void catchup_run(void)
+{
+    MusScrubNote nt[MUS_A_VOICES];
+    uint8_t got;
+    int i;
+    if (!C.cu_mask || !DECK_A_ON() || C.b_mode == BM_DUAL || (C.b_mode == BM_STING && C.b.d.state == MGS_PLAY)) return;
