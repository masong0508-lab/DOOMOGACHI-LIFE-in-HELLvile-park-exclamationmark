diff --git a/core/include/doomo/mus_data.h b/core/include/doomo/mus_data.h
index a4358e1..b506cd3 100644
--- a/core/include/doomo/mus_data.h
+++ b/core/include/doomo/mus_data.h
@@ -203,6 +203,60 @@ enum { MTF_TEMPO_RAMP = 1, MTF_KEEP_TEMPO = 2, MTF_DUCK = 4, MTF_FAST_MORPH = 8
 typedef struct MusTrans { uint8_t from, to, grid, type, arg, entry /* 0xFE resume */, max_wait, flags; } MusTrans; /* 8 */
 typedef struct MusParamDef { uint8_t rise, fall, def, flags; } MusParamDef;    /* 4 */
 
+/* --- music: MU1T/MU4d shared bank layouts (M1.5; core/music/common/*.dms) ---
+ * Sections, all 4-aligned, between the instruments and the cue blobs:
+ *   comp_off    u16 idx[n_comp] (from the section start), MusComp records
+ *   groove_off  MusGroove[n_groove]
+ *   misc_off    u32 off[MUS_MISC_COUNT] from the bank start, 0 = absent:
+ *     FILLS  u16 idx[n_fill], MusFill records
+ *     MOTIFS u16 idx[n_motif] by MOTIF_* id (0 = no motif), MusMotif records
+ *     VINYL  u16 idx[n_vinyl] by VINYL_* id (0 = none), MusVinyl records
+ *     TRANS  MusTrans[n_trans] sorted by (from, to); 0xFF = any
+ *     TURNS  u8 n_turn, n_fam, pad[2]; u8 cad[n_fam][24]; MusTurn[n_turn]
+ * MusComp: flags = family (MCPF_*) | MCP_BASS | MCP_VOICELEAD | MCP_SWING,
+ *   len_beats = beats (one bar), pad = dial band mask (bit n = Sn); then
+ *   n_ev x { onset in 1/12 beat, tone << 4 | LEN_TAB index } (MCT_* tones).
+ * MusGroove: kit = KIT_*; flags = MGRF_* | band mask << 3; steps 12 / 16;
+ *   hit[r] = KH_* of row r, pad[r] = the intensity rank the row enters at;
+ *   prob nibble of row r step s at prob[r * 8 + s / 2] (s odd: high nibble):
+ *   the hit plays iff mus_h(..) % 15 < p (15 = a core step).
+ * MusFill: n_hit counts hit[0] = { band mask, MFLF_* } and the hits;
+ *   beats; each hit { onset in 1/24 beat, KH_* | accent 0-3 << 3 | tom 0-7 << 5 }.
+ * MusMotif: n_note, head (protected notes), mode = MMODE_* | MMF_FIXED |
+ *   MMF_GLIDE, pad = the canonical tonic pitch class; each note
+ *   { int8 scale degree from the tonic, LEN_TAB index | acc << 4 (0, 1 = +1,
+ *   2 = -1) | MMN_REST | MMN_GLIDE }.
+ * MusVinyl: n_seg, flags = MVF_*, beats_q4 = length in quarter beats (0 =
+ *   frame-timed or looping), pad = the AFTER_* default; each segment
+ *   { len (units, or frames with MVF_FRAMES), v0, v1, curve | fader << 2 |
+ *   jitter/2 << 5 }; v = MVS_REV | L, speed |v| = 2^((L - 64) / 24) (half
+ *   semitones), L = 0 stopped.
+ * Cadence bitmaps: bit ((out_class * 4 + in_class) * 12 + interval) of the
+ *   family (MCAD_FAM_*), classes MCC_*; interval = in root - out root mod 12.
+ * MDK_SFX cue: one silent node; common = u8 n_seg + n x { t0, n, a, b, wc,
+ *   vol }, audio_fx.c's SynthSeg verbatim (D14, CF-3). */
+enum { MUS_MISC_FILLS, MUS_MISC_MOTIFS, MUS_MISC_VINYL, MUS_MISC_TRANS, MUS_MISC_REHARM,
+       MUS_MISC_PARAMS, MUS_MISC_TURNS, MUS_MISC_GENSPECS, MUS_MISC_COUNT };
+enum { MCPF_ARP, MCPF_STAB, MCPF_ALBERTI, MCPF_PAD, MCPF_ROOT5, MCPF_WALK, MCPF_GALLOP, MCPF_CHUG,
+       MCPF_PEDAL, MCPF_OCTAVE, MCPF_CHARLESTON, MCPF_WALTZ };
+enum { MCP_BASS = 16, MCP_VOICELEAD = 32, MCP_SWING = 64 };
+enum { MCT_ROOT, MCT_THIRD, MCT_FIFTH, MCT_SEVENTH, MCT_ROOT_UP, MCT_THIRD_UP, MCT_FIFTH_UP,
+       MCT_CHORD, MCT_ROOT_DOWN, MCT_FIFTH_DOWN, MCT_APPROACH, MCT_NEXT, MCT_HOLD, MCT_NINTH };
+enum { MGRF_GHOSTS = 1, MGRF_HALFTIME = 2, MGRF_BLAST = 4 };
+enum { MFLF_CRASH = 1 };
+enum { MMODE_MAJOR, MMODE_MINOR, MMODE_HARMONIC, MMODE_DORIAN, MMODE_PHRYGIAN, MMODE_MIXOLYDIAN };
+enum { MMF_FIXED = 0x40, MMF_GLIDE = 0x80, MMN_REST = 0x40, MMN_GLIDE = 0x80 };
+enum { MVF_TAPE = 1, MVF_ZIP = 2, MVF_CRACKLE = 4, MVF_CLICKS = 8, MVF_SNAP = 16, MVF_SILENCE = 32,
+       MVF_LOOP = 64, MVF_FRAMES = 128 };
+enum { MVC_LIN, MVC_EASE, MVC_EXP, MVC_SIN };                          /* segment curve */
+enum { MVD_OPEN, MVD_CLOSED, MVD_CHIRP, MVD_GATE32, MVD_FLARE };       /* segment fader */
+#define MVS_REV 0x80
+typedef struct MusTurn { uint8_t id, bands, targets /* 1 major 2 minor */, weight, chord[2], pad[2]; } MusTurn; /* 8 */
+enum { MCAD_FAM_MAJOR, MCAD_FAM_MINOR, MCAD_FAM_METAL };              /* S0-S1, S2, S3-S4 */
+enum { MCC_MAJ, MCC_MIN, MCC_DOM, MCC_OTHER };
+#define MUS_CAD_BYTES 24
+/* --- end music --- */
+
 /* ---- events: rings A (deck A) and B (deck B, SFX deck, urgent) ------------------- */
 /* pos = master units (bits 0-27) | kind << 28; arg packed per kind,
  * low bits first (MEV_* helpers below). */
@@ -329,6 +383,7 @@ MUS_ASSERT_SIZE(MusInst, 20);
 MUS_ASSERT_SIZE(MusGroove, 64);
 MUS_ASSERT_SIZE(MusTrans, 8);
 MUS_ASSERT_SIZE(MusParamDef, 4);
+MUS_ASSERT_SIZE(MusTurn, 8);              /* music: MU1T M1.5 */
 MUS_ASSERT_SIZE(MusGenSpec, 12);
 MUS_ASSERT_SIZE(DoomoMusEv, 8);
 MUS_ASSERT_SIZE(DoomoVoice, 12);
diff --git a/core/music/common/comps.dms b/core/music/common/comps.dms
new file mode 100644
index 0000000..2aaf4d0
--- /dev/null
+++ b/core/music/common/comps.dms
@@ -0,0 +1,50 @@
+# core/music/common/comps.dms - comp patterns: harmony, arps and bass over
+# the chord chart (owner: MU4d; docs/design/music/SPEC.md sec.5 MusComp,
+# 8.2). A cue's `comp=pool:NAME,...` lane plays one per bar, rotated per
+# pass with no repeat (sec.8.2); the pick inside a pool is hashed.
+#
+#   comp NAME role=harm|bass family=F bands=Sa..Sb [meter=3] [voicelead] [swing] : TONES
+#
+# TONES are comp tones with MML lengths (l sets the default):
+#   R 3 5 7 9  chord tones (the nearest inversion with `voicelead`)
+#   R' 3' 5'   an octave up       R, 5,  an octave down
+#   C          the whole chord (the chip chord: a 60 Hz arp on one voice)
+#   A          a chromatic approach into the next chord's root
+#   N          the next chord's root (anticipation)
+#   ~          hold the previous tone       r   rest
+# family: ARP STAB ALBERTI PAD ROOT5 WALK GALLOP CHUG PEDAL OCTAVE
+#         CHARLESTON WALTZ. Every pattern is one bar.
+
+# ---- harmony: S0 music box / S1 toy pop -------------------------------------------
+comp box_arp_up      role=harm family=ARP     bands=S0..S1 : l8 R 3 5 R' 5 3 R 3
+comp box_arp_down    role=harm family=ARP     bands=S0..S1 : l8 R' 5 3 R 3' 5 3 5
+comp box_alberti     role=harm family=ALBERTI bands=S0..S1 : l8 R 5 3 5 R 5 3 5
+comp toy_offbeat     role=harm family=STAB    bands=S1..S2 : l8 r C r C r C r C
+comp toy_skank       role=harm family=STAB    bands=S1..S2 : l16 r8 C r r8 C C r8 C r r8 C8
+comp toy_charleston  role=harm family=CHARLESTON bands=S1..S2 : C4. C8 ~2
+comp chip_8ths       role=harm family=ARP     bands=S0..S2 : l8 C C C C C C C C
+comp chip_pad        role=harm family=PAD     bands=S0..S3 : C1
+comp soft_pad_2      role=harm family=PAD     bands=S0..S2 voicelead : C2 C2
+comp waltz_oompah    role=harm family=WALTZ   bands=S0..S2 meter=3 : r4 C4 C4
+comp waltz_box       role=harm family=ARP     bands=S0..S1 meter=3 : l8 R 5 3' 5 R' 5
+# ---- harmony: S2 spooky swing --------------------------------------------------------
+comp spook_arp       role=harm family=ARP     bands=S2..S2 swing : l8 R 3 5 7 5 3 R 3
+comp spook_stab      role=harm family=STAB    bands=S2..S3 swing : r4 C8 r8 r4 C8 C8
+comp lounge_comp     role=harm family=CHARLESTON bands=S1..S2 swing voicelead : C4. C8 r2
+# ---- harmony: S3 chip rock / S4 metal -------------------------------------------------
+comp rock_8ths       role=harm family=CHUG    bands=S3..S4 : l8 C C C C C C C C
+comp rock_push       role=harm family=STAB    bands=S3..S4 : C4. C8 ~4 C8 C8
+comp metal_chug16    role=harm family=CHUG    bands=S4..S4 : l16 C C r C C C r C C C r C C r C C
+comp metal_gallop    role=harm family=GALLOP  bands=S4..S4 : l16 C8 C C C8 C C C8 C C C8 C C
+# ---- bass -------------------------------------------------------------------------------
+comp bass_root5      role=bass family=ROOT5   bands=S1..S3 : l4 R 5, R' 5,
+comp bass_root_long  role=bass family=PEDAL   bands=S0..S1 : R2 5,2
+comp bass_octave8    role=bass family=OCTAVE  bands=S3..S4 : l8 R R' R R' R R' R R'
+comp bass_walk       role=bass family=WALK    bands=S1..S2 : l4 R 3 5 A
+comp bass_walk_up    role=bass family=WALK    bands=S1..S2 swing : l4 R 5 R' A
+comp bass_charleston role=bass family=CHARLESTON bands=S1..S2 : R4. 5,8 ~2
+comp bass_gallop     role=bass family=GALLOP  bands=S4..S4 : l16 R8 R R R8 R R R8 R R R8 R R
+comp bass_chug       role=bass family=CHUG    bands=S3..S4 : l8 R R R R R R R N
+comp bass_pedal      role=bass family=PEDAL   bands=S0..S4 : R1
+comp bass_waltz      role=bass family=WALTZ   bands=S0..S2 meter=3 : R4 r4 5,4
+comp bass_waltz_walk role=bass family=WALTZ   bands=S1..S2 meter=3 : R4 5,4 A4
diff --git a/core/music/common/fills.dms b/core/music/common/fills.dms
new file mode 100644
index 0000000..ddec18a
--- /dev/null
+++ b/core/music/common/fills.dms
@@ -0,0 +1,28 @@
+# core/music/common/fills.dms - drum fills (owner: MU4d; docs/design/music/
+# SPEC.md sec.5 MusFill, 8.2). A fill replaces the KIT over its last beats;
+# fills are sized by the intensity jump with no immediate repeat, and a
+# crash follows only a fill or a rise.
+#
+#   fill NAME beats=N bands=Sa..Sb [crash] : HITS
+#
+# HITS: K S H O C T P r with MML lengths; ! after a hit = accent (two !! =
+# strong), a digit after T = the tom (0 high .. 7 low). The hits sum to
+# `beats` quarters. `crash` = the next downbeat crashes.
+
+fill snare_4       beats=1 bands=S1..S4 crash : l16 S S S! S!!
+fill snare_8       beats=2 bands=S2..S4 crash : l16 S S S S S S! S! S!!
+fill tom_roll      beats=1 bands=S1..S4 crash : l16 T0 T2 T4 T6!
+fill tom_roll_2    beats=2 bands=S3..S4 crash : l16 T0 T0 T2 T2 T4 T4 T6! T7!!
+fill kick_snare    beats=1 bands=S1..S4 crash : l16 K S K S!
+fill clap_pop      beats=1 bands=S1..S2 : P8 r16 P16!
+fill toy_rattle    beats=1 bands=S0..S1 : l16 H H O H!
+fill box_tick      beats=1 bands=S0..S0 : l8 H H
+fill swing_brush   beats=1 bands=S2..S2 : l12 S S S!
+fill swing_rims    beats=2 bands=S2..S2 : l12 P r P S S! S!!
+fill rock_break    beats=1 bands=S3..S4 crash : l8 K S!
+fill rock_toms     beats=2 bands=S3..S4 crash : l16 S S T2 T2 T4 T4 T6 T6!
+fill metal_blast   beats=1 bands=S4..S4 crash : l32 S S S S S S S S
+fill metal_double  beats=2 bands=S4..S4 crash : l32 K S K S K S K S T0 T2 T4 T6 K K S! S!!
+fill metal_triplet beats=2 bands=S4..S4 crash : l12 T0 T2 T4 T0 T2 T4!
+fill stop_hit      beats=1 bands=S1..S4 : C8! r8
+fill waltz_lift    beats=1 bands=S0..S2 : l16 S S T2 T4!
diff --git a/core/music/common/grooves.dms b/core/music/common/grooves.dms
new file mode 100644
index 0000000..c436cf5
--- /dev/null
+++ b/core/music/common/grooves.dms
@@ -0,0 +1,111 @@
+# core/music/common/grooves.dms - drum DNA (owner: MU4d; docs/design/music/
+# SPEC.md sec.5 MusGroove, 8.2; the prototype's styles, design_generative.md
+# sec.3.5). A KIT lane's `dna=pool:NAME,...` plays one per bar.
+#
+#   groove NAME kit=TOY|BONES|808|PLUSH|FORGE|CLASSIC bands=Sa..Sb [steps=12] [ghosts] [halftime] [blast]
+#     HIT I  pppp pppp pppp pppp
+#
+# One row per drum (<= 6): HIT = K kick, S snare, H hat, O open hat, C crash,
+# T tom, P clap; I = the intensity rank (0-5) at which the row enters; then
+# one hex digit per 16th step: the hit plays iff
+# mus_h(seed, S_DRUM, node.pass, role.bar.step) % 15 < p, so f = always
+# (a core step, the only steps the T3 signatures count), 0 = never. Ghost
+# notes (I3+) and accents are the runtime's (sec.8.2).
+
+# ---- S0 music box: a ticking clock -------------------------------------------------
+groove box_clock   kit=TOY bands=S0..S0
+  K 1  f000 0000 0000 0000
+  H 2  0000 9000 0000 9000
+groove box_tick    kit=TOY bands=S0..S0 steps=12
+  K 1  f000 0000 0000
+  H 2  0000 9000 9000
+# ---- S1 toy pop ---------------------------------------------------------------------
+groove toy_pop     kit=TOY bands=S1..S1
+  K 1  f000 0040 d003 0040
+  S 2  0000 f000 0000 f003
+  H 2  a0d0 a0d0 a0d0 a0d0
+  O 4  0000 0000 0000 0030
+  P 3  0000 4000 0000 4000
+groove toy_bounce  kit=TOY bands=S1..S1
+  K 1  f000 00a0 f000 0000
+  S 2  0000 f000 0000 f000
+  H 2  f0f0 f0f0 f0f0 f0f3
+  T 4  0000 0000 0000 0034
+groove toy_shuffle kit=PLUSH bands=S1..S2 steps=12
+  K 1  f00 000 f00 000
+  S 2  000 f00 000 f03
+  H 2  f0d f0d f0d f0d
+groove toy_waltz   kit=PLUSH bands=S0..S2 steps=12
+  K 1  f000 0000 0000
+  H 2  0000 d000 d000
+  S 3  0000 0000 0040
+# ---- S2 spooky swing: rims and claps --------------------------------------------------
+groove spook_swing kit=BONES bands=S2..S2
+  K 1  f000 0030 9004 0000
+  S 2  0000 c000 0000 c004
+  H 2  c040 c040 c040 c040
+  P 3  0000 9000 0000 9030
+  T 4  0000 0000 0000 0003
+groove spook_tiptoe kit=BONES bands=S2..S2 halftime
+  K 1  f000 0000 0000 0000
+  P 2  0000 0000 f000 0000
+  H 2  9000 9000 9000 9040
+# ---- S3 chip rock ------------------------------------------------------------------------
+groove rock_beat   kit=CLASSIC bands=S3..S3
+  K 1  f000 0000 f060 0030
+  S 2  0000 f000 0000 f002
+  H 2  d0d0 d0d0 d0d0 d0d0
+  O 4  0000 0000 0000 0040
+groove rock_drive  kit=CLASSIC bands=S3..S4
+  K 1  f000 00f0 f000 0040
+  S 2  0000 f000 0000 f000
+  H 2  f0f0 f0f0 f0f0 f0f0
+  C 5  f000 0000 0000 0000
+groove rock_half   kit=808 bands=S3..S4 halftime
+  K 1  f000 0000 0040 0000
+  S 2  0000 0000 f000 0000
+  H 2  d0d0 d0d0 d0d0 d0d0
+# ---- S4 chip metal: double kick ---------------------------------------------------------
+groove metal_dbl   kit=FORGE bands=S4..S4
+  K 1  fefe fefe fefe fefe
+  S 2  0000 f000 0000 f002
+  H 2  c0c0 c0c0 c0c0 c0c0
+  T 4  0000 0000 0000 0003
+groove metal_march kit=FORGE bands=S4..S4
+  K 1  f000 f000 f000 f0f0
+  S 2  0000 f000 0000 f000
+  T 3  0000 0000 00f0 0000
+  H 3  f000 f000 f000 f000
+groove metal_blast kit=FORGE bands=S4..S4 blast
+  K 1  f0f0 f0f0 f0f0 f0f0
+  S 2  0f0f 0f0f 0f0f 0f0f
+  H 3  ffff ffff ffff ffff
+groove metal_half  kit=FORGE bands=S4..S4 halftime
+  K 1  f0f0 0000 f000 0040
+  S 2  0000 0000 f000 0000
+  C 3  f000 0000 0000 0000
+  H 2  f0f0 f0f0 f0f0 f0f0
+# ---- world flavours ---------------------------------------------------------------------
+groove bossa       kit=808 bands=S1..S2
+  K 1  f00f 00f0 f00f 00f0
+  P 2  f00f 00f0 00f0 0f00
+  H 2  d0d0 d0d0 d0d0 d0d0
+groove polka       kit=CLASSIC bands=S1..S2
+  K 1  f000 0000 f000 0000
+  S 1  0000 f000 0000 f000
+  H 3  00a0 00a0 00a0 00a0
+groove calypso     kit=PLUSH bands=S1..S2
+  K 1  f000 0000 f000 0000
+  P 2  000f 00f0 000f 00f0
+  H 2  f0d0 f0d0 f0d0 f0d0
+groove industrial  kit=FORGE bands=S3..S4
+  K 1  f00f 00f0 0000 f000
+  S 2  0000 f000 0000 f000
+  T 3  0000 0000 f00f 0000
+  H 2  f0f0 f0f0 f0f0 f0f0
+groove lofi        kit=808 bands=S2..S3 halftime
+  K 1  f000 000a 00f0 0000
+  S 2  0000 f000 0000 f000
+  H 2  d0d0 d0d0 d0d0 d0d4
+groove clock_bed   kit=TOY bands=S0..S4
+  H 0  f000 f000 f000 f000
diff --git a/core/music/common/inst.dms b/core/music/common/inst.dms
new file mode 100644
index 0000000..cd2447e
--- /dev/null
+++ b/core/music/common/inst.dms
@@ -0,0 +1,86 @@
+# core/music/common/inst.dms - the shared instrument bank (owner: MU4d;
+# docs/design/music/SPEC.md sec.5 MusInst, sec.13). Compiled by
+# tools/mmlc.py into the bank's MusInst rows after the 24 classic ones
+# (rows 0-23 = songs.c's audio_insts, imported verbatim); each name's row
+# is its INST_* id in core/music/ids/common.lock (append-only).
+#
+#   inst NAME timbre=T[/ALT] duty=N atk=F dec=D sus=S rel=R lvl=L gate=G
+#             vib=DEPTH,SPEED,DELAY arp=A sweep=S [psg=SOFT]
+#
+# The 30 Hz envelope law of the classic sequencer (MIF_ENV30, mus_drv.c):
+# lvl / sus 0..15, the peak is lvl x 16; atk = frames to the peak; dec /
+# rel = level drop per frame on that 0..240 scale; gate = eighths of the
+# note; vib depth 1/16 st, speed = phase per frame (256 = a cycle), delay
+# frames; arp = NONE MAJOR MINOR OCTAVE POWER SUS4 DIM MAJ7 TRILL (the chip
+# chord is re-chorded at 60 Hz from the CHORD event at M4); sweep 1/16 st
+# per frame; duty in 1/32 for PULSE (4 = 12.5 %, 8 = 25 %, 16 = 50 %).
+# mmlc fits psg_env (the GBA NRx2 byte; 0 = soft envelope) and the PS1
+# spu_adsr1/2 to every row. ALT = timbre_alt, the fallback where a timbre
+# is missing (the GBA PSG in tier L, AU10's speaker).
+#
+# Defaults: duty=16 atk=0 dec=0 sus=15 rel=8 lvl=12 gate=7 vib=0,0,0 arp=NONE sweep=0
+
+# ---- leads (S0 cute -> S4 metal) ---------------------------------------------
+inst box_lead      timbre=PULSE        duty=4  dec=14 sus=0  rel=6  lvl=13 gate=6           # S0 music box, fast decay
+inst celesta_arp   timbre=PULSE        duty=4  dec=18 sus=0  rel=8  lvl=11 gate=4
+inst toy_lead      timbre=PULSE        duty=8  dec=9  sus=11 rel=12 lvl=13 gate=7 vib=4,22,10   # S1, delayed vibrato
+inst cute_lead     timbre=PWM/PULSE    duty=8  dec=10 sus=10 rel=10 lvl=13 gate=7 vib=3,20,12
+inst wobble_lead   timbre=PULSE        duty=4  dec=4  sus=11 rel=8  lvl=12 gate=7 vib=10,18,0   # S2 spooky
+inst lounge_lead   timbre=PULSE        duty=16 atk=1  dec=4 sus=12 rel=10 lvl=12 gate=8 vib=3,14,14
+inst sync_lead     timbre=SYNC_SAW/PULSE duty=8 dec=3 sus=13 rel=6  lvl=14 gate=7 vib=4,26,16   # S3-4
