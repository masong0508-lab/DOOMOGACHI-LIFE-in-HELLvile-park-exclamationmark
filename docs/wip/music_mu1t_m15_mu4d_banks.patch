+CADS = ['PAC', 'HC', 'DC', 'PLAGAL', 'AEOL']
+VFADERS = ['open', 'closed', 'chirp', 'gate32', 'flare']
+VCURVES = ['lin', 'ease', 'exp', 'sin']
+VFLAGS = {'tape': 1, 'zip': 2, 'crackle': 4, 'clicks': 8, 'snap': 16, 'silence': 32, 'loop': 64}
+VFRAMES = 128
+AFTERS = ['DEFAULT', 'RESUME', 'CONTINUE', 'STOP', 'NEXT_CUE']
