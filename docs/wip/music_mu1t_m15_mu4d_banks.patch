+                'mmaj7': 'MMAJ7', '5': 'POWER', 'add9': 'ADD9', 'm9': 'MIN9', '6': 'SIX'}
+CLASS_OF = {'MAJ': 0, 'MAJ7': 0, 'ADD9': 0, 'SIX': 0, 'SUS2': 0, 'MIN': 1, 'MIN7': 1, 'MIN9': 1,
