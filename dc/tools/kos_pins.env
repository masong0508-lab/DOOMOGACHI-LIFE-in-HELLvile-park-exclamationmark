# Pinned versions for the Dreamcast toolchain (read by dc/tools/setup_kos.sh
# and by .github/actions/setup-kos, whose cache key hashes this file).
#
# Plain KEY=value lines only: no spaces around '=', no quotes, no shell code.
# Changing any line makes setup_kos.sh rebuild the parts that depend on it.
#
# To move to a newer KallistiOS: change KOS_COMMIT, run
#   dc/tools/setup_kos.sh --print-profile
# and copy the binutils/gcc/newlib versions it prints into the KOS_*_VER lines
# (the script refuses to build when they disagree with kos-chain's profile).
# Owner: dreamcast.

# KallistiOS (kernel, libs, host utils, and the kos-chain toolchain builder).
# Fetched with git: plain curl to github.com is refused by some proxies.
KOS_REPO=https://github.com/KallistiOS/KallistiOS.git
KOS_COMMIT=d81aa3fda0520b6ca64098ce9d1d43e7562142d9

# kos-chain profile (utils/kos-chain/profiles/dreamcast/<profile>.mk).
# "stable" is the DECISIONS.md default: GCC 15.2.0.
KOS_CHAIN_PROFILE=stable
KOS_BINUTILS_VER=2.45.1
KOS_GCC_VER=15.2.0
KOS_NEWLIB_VER=4.6.0.20260123

# SH4 floating-point ABIs. Both multilibs are built; m4-single is the
# KallistiOS default (and what core/tools/xcheck.sh checks against).
KOS_PRECISION_MODES=m4-single,m4-single-only
KOS_DEFAULT_PRECISION=m4-single

# Languages built into the cross compiler. The game is C only; C++ and
# Objective-C would add about 15 minutes and 150 MB.
KOS_LANGUAGES=c

# img4dc (cdi4dc: ISO + IP.BIN -> self-booting .cdi image).
IMG4DC_REPO=https://github.com/Kazade/img4dc.git
IMG4DC_COMMIT=d28df15db97db1b410e52191eeb45534dcbba252
