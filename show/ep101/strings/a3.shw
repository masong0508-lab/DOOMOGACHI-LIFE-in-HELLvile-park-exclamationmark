# ---- 3-01 act card (the Mayor's clipboard, his hand) ----
string s_a3_01_card       "22:00 Bedtime!" font=child_hand
string s_a3_01_card_over  "weather" font=child_hand size=small

# ---- 3-02 ----
string s_a3_02_tent_sign  "BAKE TENT" font=game

# ---- 3-03 the HUD (32-px strip) ----
string s_a3_03_hud_plate_pump   "PARTY PUMP" font=hud
string s_a3_03_hud_plate_slaughter "SLAUGHTER" font=hud
string s_a3_03_hud_sub          "RIP AND TEAR... GENTLY" font=hud size=small
string s_a3_03_hud              "GORE: BRUTAL" font=hud color=red
string s_a3_03_sticker          "HELLVILE PARK BOARD OF DECENCY (approved)" font=game
string s_a3_03_ghost_back       "THANK YOU FOR NOT SCREAMING -Mayor" font=child_hand
string s_a3_03_ammo_box         "PARTY POPPERS" font=game
string s_a3_03_ammo_box_under   "SHELLS" font=game

# ---- 3-04 ----
string s_a3_04_fail       "FAIL x2" font=game

# ---- 3-05 ----
string s_a3_05_plate_saw_purr  "PURRING SAW" font=hud
string s_a3_05_plate_saw       "MEATCLEAVER" font=hud
string s_a3_05_tent_sign       "BAKE TEN" font=game          # the one persistent change

# ---- 3-06 the tin and the sign-up sheet (many hands) ----
string s_a3_06_slip         "Charlotte's turn: no. 9" font=child_hand
string s_a3_06_sheet_title  "MIDSUMMER MINGLE - WHO'S BRINGING WHAT?" font=child_hand
