string s_a3_06_sheet_02     "Giggs: cupcakes (+1)" font=child_hand
string s_a3_06_sheet_03     "Charlotte: cookies (sorry)" font=child_hand
string s_a3_06_sheet_04     "Fuzz: hugs" font=child_hand
string s_a3_06_sheet_05     "Bonejangles: music" font=child_hand
string s_a3_06_sheet_06     "Clinker: a poem (will rate yours)" font=child_hand

# ---- EC3 ----
string s_ec3out  "22:59" font=game
string s_ec3in   "22:59" font=game
string s_a3_03_house_sign "NOTHING INSIDE! (we checked) -Mayor" font=game on=housesign
