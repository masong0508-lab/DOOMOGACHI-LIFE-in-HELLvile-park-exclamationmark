# show/ep101/shots/ec3.shw - EYECATCH PAIR 3 (16:40-16:50, 300 f), seg co_mt. Included in episode.shw after act three.
# OUT: the flame's gutter on frame 0, the HEE_HEE bell, the hook in major. IN: a 4-f hellify flash,
# then ONE change: the last flame leans toward the Wall (screen right). Mascotty, same depth.
# Shot list: shotlists/co_mt.md.

act EC3 "Eyecatch pair 3"
  beat e101_ec3_out len=150 shots=ec3o
  beat e101_ec3_in  len=150 shots=ec3i
end

shot ec3o beat=e101_ec3_out len=150 set=eyecatch:ec3_out px=1 look=pixel cut=CUT matte=open scene=ec3 gore=CUTE cue=theme_eyecatch_out@bar:1
  +0    sfx FX_FLAME_GUTTER                                   # the act-out sound
  +0    mx theme_eyecatch_out start
  +6    mx heehee_bell_150 start gain=-6dB                    # choice: the bell 6 f after the act-out sound
  +0    fx flicker at=prop:candle3 period=10 seed=301         # the gold flame; smoke curls like question marks on 1 and 2
  ad "Three candles on the bandstand rail, two out. The clock reads 10:59."
end

shot ec3i beat=e101_ec3_in len=150 set=eyecatch:ec3_in px=1 look=pixel cut=CUT matte=open gore=CUTE cue=theme_eyecatch_in@bar:1
  prop  mascotty art=gen:mascotty_tiny(h=8) plane=back at=40,40 anchor=bottom
  +0    flash PAL_HELLIFY 8 4 ; sfx FX_HELLIFY_FLASH
  +0    mx theme_eyecatch_in start                            # TODO(AUDIO): cue not in series/music.shw yet
  +4    fx flicker at=prop:candle3 period=10 seed=301
  ad "The same card - but the last flame leans toward the Wall, as if listening."
end
