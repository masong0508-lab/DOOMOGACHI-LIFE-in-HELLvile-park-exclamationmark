# show/ep101/shots/co_mt.shw - MAIN TITLE "Doomtastic Times" (main title cut), 00:01:40:00-00:02:30:00.
# Seg co_mt. Cut to the theme master's bar map (series/music.shw theme_main_title: 150 bpm,
# 48 f per bar, 30 bars = 1,440 f + a 60-f ring; bar B starts at MT frame 48 x (B-1)), not to
# the beat sheet's provisional section TCs (DECISIONS). Shot list: shotlists/co_mt.md.
# STANDARDS: Pip pops in in mt03 only; mt03 is never reprised under hellify (FC). No child in
# the corridor (mt09). Red stays local to the burst. The silhouette in mt10 has no look, no face.

shot mt01 beat=e101_mt_1 len=240 set=hahaland_crane:day px=1 look=pixel cut=SMASH matte=open scene=mt
  +0    sfx FX_EGG_CRACK ; mx theme_main_title start          # the CRACK = bar 1.1 = the song's first downbeat
  +0    flash PAL_WHITE 8 3                                   # white flash off the crack: 3 f, level 8 of 16 (reduced; Harding)
  +0    cam3d rail=crane from=+0 to=+240                      # crane up over pastel HaHaland, ease OUT
  ad "A white flash. The camera cranes up over the pastel town of HaHaland."
end


# Render pass (Oct 25): every bar anchor is written as +N from the 48 f/bar map (the compiler's
# midi bar map resolves 60 f/bar, so @bar: drifted). The beat rows live in rundown.shw (re-cut
# there to the bar map); mt03 is split in two (BEAT_ACTORS: 8 actors per shot).

shot mt02 beat=e101_mt_1 len=192 set=cast_popin:day px=1 look=pixel cut=CUT matte=open
  prop  logo1 art=gen:logo(part=doomogachi,scale=3) at=160,28 anchor=top hidden=yes
  prop  logo2 art=gen:logo(part=life,scale=3)       at=160,74 anchor=top hidden=yes
  prop  logo3 art=gen:logo(part=park,scale=2)       at=160,110 anchor=top hidden=yes
  +0    sfx FX_WHOOSH gain=-18dB                              # choice: frame-0 sound
  +0    cam to scale=1.060 over=192 ease=INOUT                # motion: a slow push through the drops
  +0    cam pan dx=15.1 dy=5.1 over=192 ease=INOUT
  +0    show logo1 ; sfx FX_LETTER_DROP                       # bar 6.1: DOOMOGACHI lands
  +1    shake SHK_TAP ; fx sparkle at=160,40 n=10 seed=201
  +48   show logo2 ; sfx FX_LETTER_DROP                       # bar 7.1: LIFE
  +49   shake SHK_TAP ; fx sparkle at=160,84 n=10 seed=202
  +96   show logo3 ; sfx FX_LETTER_DROP                       # bar 8.1: in HELLvile Park!
  +97   shake SHK_TAP ; fx sparkle at=160,118 n=10 seed=203
  +144  sfx FX_BOING gain=-12dB ; punch 0 -2                  # bar 9.1: the whole lockup boings
  +146  fx sparkle at=100,60 n=6 seed=204 ; fx sparkle at=220,60 n=6 seed=205
  ad "The show's logo drops in, word by word: DOOMOGACHI LIFE in HELLvile Park!"
end

shot mt03 beat=e101_mt_2 len=96 set=cast_popin:day px=1 look=pixel cut=CUT matte=open
  note "one POP per beat (4-6 f, overshoot), each with a name plate; bars 10-11"
  actor sunny  who=sunny  kind=chibi at=36,148 px=3 face=R hidden      # front row (near)
  prop  suitcase art=gen:suitcase(seed=1) at=52,150 anchor=bottom hidden=yes
  actor pet    who=pet    kind=sprite at=80,154 px=2 face=L hidden      # at Sunny's feet, looking up at her
  actor mayor  who=mayor  kind=chibi at=110,118 px=2 face=R hidden     # back row (far)
  actor nana   who=nana   kind=chibi at=140,148 px=3 face=L hidden     # front, turned to the Mayor
  actor pip    who=pip    kind=chibi at=198,152 px=2 face=R hidden      # KID: filter on; never reprised under hellify
  actor fuzz   who=fuzz   kind=chibi at=214,116 px=2 face=L hidden     # back row
  actor bloom  who=bloom  kind=chibi at=258,148 px=3 face=L hidden
  actor steamy who=steamy kind=chibi at=290,120 px=2 face=L hidden     # back row
  +0    sfx FX_WHOOSH gain=-20dB
  +0    cam to scale=1.060 over=96 ease=INOUT
  +0    cam pan dx=9.1 dy=2.1 over=96 ease=INOUT
  +0    show sunny ; take pop_in sunny ; show suitcase ; super s_mt_np_sunny style=pop at=36,164 until=end ; sfx FX_NAME_POP
  +12   show pet ; take pop_in pet ; super s_mt_np_pet style=pop at=80,170 until=end ; sfx FX_NAME_POP
  +24   show mayor ; take pop_in mayor ; super s_mt_np_mayor style=pop at=110,134 until=end ; sfx FX_NAME_POP
  +36   show nana ; take pop_in nana ; super s_mt_np_nana style=pop at=140,164 until=end ; sfx FX_NAME_POP
  +48   show pip ; take pop_in pip ; super s_mt_np_pip style=pop at=198,170 until=end ; sfx FX_NAME_POP
  +60   show fuzz ; take pop_in fuzz ; super s_mt_np_fuzz style=pop at=214,132 until=end ; sfx FX_NAME_POP
  +72   show bloom ; take pop_in bloom ; super s_mt_np_bloom style=pop at=258,164 until=end ; sfx FX_NAME_POP
  +84   show steamy ; take pop_in steamy ; super s_mt_np_steamy style=pop at=290,136 until=end ; sfx FX_NAME_POP
  +14   take react_small sunny ; headturn sunny 232 3          # Sunny looks down at the pet popping in
  +26   headturn mayor 232 3                                   # the Mayor eyes Nana as she lands
  +30   blink sunny 2 ; headturn sunny 24 3
  +40   take react_small mayor
  +54   headturn nana 24 3 ; blink mayor 2                     # Nana turns to shield Pip from the Mayor's glance
  +62   take react_small pip ; headturn fuzz 232 3             # Fuzz looks down at the kid
  +74   headturn pip 24 3 ; take react_small fuzz
  +80   blink nana 2 ; headturn bloom 232 3                    # Bloom turns to Steamy as it puffs in
  +82   take react_small bloom
  waive TIME-READ "name plates are on screen 12-96 f; the line-up carries them"
  ad "The cast pops in one by one, each with a name plate."
end

shot mt03b beat=e101_mt_2 len=96 set=cast_popin:day px=1 look=pixel cut=CUT matte=open
  note "bars 12-13: the rest of the line-up; Mascotty never pops, never moves"
  actor fuzz   who=fuzz   kind=chibi at=24,116 px=2 face=R      # back
  actor bloom  who=bloom  kind=chibi at=58,148 px=3 face=R      # front
  actor steamy who=steamy kind=chibi at=100,120 px=2 face=L      # back, turned to Bloom
  actor hattie who=hattie kind=chibi at=140,148 px=3 face=R hidden
  actor grampy who=grampy kind=chibi at=178,118 px=2 face=L hidden
  actor bones  who=bonejangles kind=chibi at=218,148 px=3 face=R hidden
  actor rivet  who=rivet  kind=chibi at=252,120 px=2 face=R hidden    # welding mask and sparks only
  actor mascotty who=mascotty kind=chibi at=298,104 px=2 face=L idle=none   # far right, perfectly still, from frame 0
  +0    sfx FX_WHOOSH gain=-22dB
  cam at=-12,0
  +0    cam to x=12 y=0 scale=1.04 over=96 ease=INOUT          # track along the line-up to the still bunny
  +0    show hattie ; take pop_in hattie ; super s_mt_np_hattie style=pop at=140,164 until=end ; sfx FX_NAME_POP
  +12   show grampy ; take pop_in grampy ; super s_mt_np_grampy style=pop at=178,134 until=end ; sfx FX_NAME_POP
  +24   show bones ; take pop_in bones ; super s_mt_np_bonejangles style=pop at=218,164 until=end ; sfx FX_NAME_POP
  +36   show rivet ; take pop_in rivet ; super s_mt_np_rivet style=pop at=252,136 until=end ; sfx FX_NAME_POP ; fx sparks at=252,108 n=8 seed=313
  +8    blink fuzz 2 ; headturn bloom 232 3 ; take react_small steamy   # Bloom and Steamy bicker
  +20   headturn grampy 232 3 ; take react_small hattie        # Grampy turns on Hattie as she lands
  +54   headturn steamy 24 3 ; headturn hattie 24 3            # the line-up glances at the still bunny (a ripple)
  +56   headturn grampy 24 3 ; headturn bones 24 3
  +57   take react_small rivet                                 # the one who notices
  +66   move hattie to=150,148 over=10 ; move bones to=206,148 over=10   # both edge back from the bunny
  +78   headturn steamy 232 4 ; headturn hattie 232 4 ; blink grampy 2
  waive TIME-READ "name plates are on screen 60-96 f; the line-up holds through bar 13"
  ad "The rest of the cast pops in. A bunny mascot stands at the edge, perfectly still."
end

shot mt04 beat=e101_mt_3 len=36 set=hahaland_wall_pan:day px=1 look=pixel cut=CUT matte=open
  +0    sfx FX_WHOOSH gain=-16dB ; cam3d rail=pan from=+0 to=+36   # establishing only: the wall window bar arrives on the Wall
  ad "The camera pans across the park to the Wall."
end

shot mt05 beat=e101_mt_3 len=72 set=wall_split:day px=1 look=pixel cut=WIPE:brick matte=open
  note "mirrored to the frame: the Hellvile lane is the HaHaland lane flipped about x 160"
  crowd hh looks=kset:giggle_adults seed=501 n=5 tags=CITIZEN age=adult kind=chibi form=lane from=40 dy=140 dir=R spacing=12 speed=1.5 ripple=0..2 cycle=walk4
  end
  crowd hv looks=kset:hellvile_silhouettes seed=501 n=5 tags=CITIZEN,SILHOUETTE,HELLVILE age=adult kind=chibi form=lane from=280 dy=140 dir=L spacing=12 speed=1.5 ripple=0..2 cycle=walk4
  end
  +0    sfx FX_BRICK_WIPE                                     # the brick wipe runs down x 160
  +0    cam to scale=1.060 over=72 ease=INOUT
  +0    cam pan dx=15.1 dy=5.1 over=72 ease=INOUT
  +12   sfx FX_KNOCK_WALL pan=L ; sfx FX_KNOCK_WALL pan=R ; shake SHK_TAP    # bar 15.1 "Knock,
  +18   sfx FX_KNOCK_WALL pan=L ; sfx FX_KNOCK_WALL pan=R ; shake SHK_TAP    #  knock,
  +24   sfx FX_KNOCK_WALL pan=L ; sfx FX_KNOCK_WALL pan=R ; shake SHK_IMPACT #  knock!"
  ad "Split screen at the Wall: both sides run up to it and knock at the same moment."
end

shot mt06 beat=e101_mt_4 len=36 set=sealed_gate:night px=1 look=pixel cut=CUT matte=open
  +0    sfx FX_RECORD_SCRATCH ; tapestop 5                     # the drop is the record scratch
  +5    mx theme_main_title duck -30dB 14                      # 14 f of near-silence
  +0    shake SHK_TAP                                         # the scratch stops the picture with a jolt
  +0    cam to scale=1.080 over=36 ease=OUT                   # a hard push on the KEEP OUT sign
  +0    cam pan dx=11.9 dy=6.7 over=36 ease=OUT
  +20   pop lock4 TWT_HOP1                                    # one padlock twitches in the silence
  ad "The sealed gate: seven padlocks, a sign - KEEP OUT. FOREVER. - and a small shuttered grille."
end

shot mt07 beat=e101_mt_5 len=96 set=hahaland_crane:day px=1 look=pixel cut=CUT matte=open replay=mt01@+120
  note "the rot runs on a verse shot with no child in it (FC standards); establishing only"
  +0    pal PAL_HELLIFY 16 over=21 ; sfx FX_HELLIFY_FLASH gain=-12dB   # hellify 0 -> 16 over 21 f, on the lift
  ad "On the chorus the pastel town rots, pixel by pixel."
end

shot mt08 beat=e101_mt_5 len=96 set=bandstand_cu:north_night px=2 look=pixel cut=CUT matte=open
  prop  candle1 art=gen:candle(state=lit,size=3) art.out=gen:candle(state=out,size=3) at=104,100 anchor=bottom
  prop  candle2 art=gen:candle(state=lit,size=3) art.out=gen:candle(state=out,size=3) at=160,100 anchor=bottom
  prop  candle3 art=gen:candle(state=lit,size=3) art.out=gen:candle(state=out,size=3) at=216,100 anchor=bottom
  +0    cam to scale=1.100 over=96 ease=OUT                   # insert push
  +0    cam pan dx=14.5 dy=8.2 over=96 ease=OUT
  +0    show candle1:out ; sfx FX_CANDLE_OUT_BEAT ; fx smoke at=104,70 n=3 seed=801     # bar 19 beats 1, 3, then 20.1
  +24   show candle2:out ; sfx FX_CANDLE_OUT_BEAT ; fx smoke at=160,70 n=3 seed=802
  +48   show candle3:out ; sfx FX_CANDLE_OUT_BEAT ; fx smoke at=216,70 n=3 seed=803
  +60   fx smoke at=160,60 n=4 seed=804
  ad "Three candles go out, one by one, in rhythm."
end

shot mt09 beat=e101_mt_5 len=144 set=title_corridor:cute px=1 look=pixel cut=CUT matte=open gore=CUTE
  note "no child in the corridor (STD-KIDS); red local to the burst (Harding). TODO(lane3): hud, gore switch, lens gibs"
  actor demon who=puff_demon kind=sprite at=200,96 idle=on
  +0    cam3d rail=run from=+0 to=+144                         # first person, the rail
  +0    sfx FX_PUFF_DRIFT gain=-10dB ; move demon to=160,104 over=96   # bobs toward the lens
  +0    pose demon puff_idle
  +96   pal PAL_HELLIFY 16 over=1 ; state demon dead ; fx burst at=160,96 n=24 seed=901 ; sfx FX_GORE_BURST   # bar 23.1, on "side!"
  +96   hitstop 3
  +98   shake SHK_IMPACT ; fx sparkle at=150,80 n=6 seed=902 ; sfx FX_GIB_SPLAT
  +110  sfx FX_TOOTH_TINK
  +112  sfx FX_LENS_DRIP gain=-6dB
  +0    tag shot gore_truth
  ad "A fluffy demon floats toward us - then bursts in red mist against the lens while the song keeps smiling."
end

shot mt10 beat=e101_mt_5 len=48 set=sealed_gate:night px=1 look=pixel cut=CUT matte=open gore=CUTE
  prop  rear art=gen:gate_silhouette(shape=round_rear,seed=1) plane=wall at=160,88 anchor=center hidden=yes   # featureless; no look, no face
  +0    sfx FX_WHOOSH gain=-24dB
  +0    cam to scale=1.060 over=48 ease=INOUT
  +0    cam pan dx=15.1 dy=5.1 over=48 ease=INOUT
  +6    show rear ; shake SHK_TAP ; show door:bulge            # presses against the grille
  +12   sfx FX_BOING_GATE ; shake SHK_IMPACT                   # bar 24.2: bounces once
  +14   punch 0 -2 ; pop lock1 TWT_HOP2 ; pop lock2 TWT_HOP2 ; pop lock3 TWT_HOP2 ; pop lock4 TWT_HOP2 ; fol FOL_padlock_1
  +18   show door ; hide rear
  ad "Behind the shut grille, something big and round presses against the gate and bounces. The padlocks jump."
end

shot mt11 beat=e101_mt_6 len=264 set=logo_card:pose px=1 look=pixel cut=SMASH matte=open gore=CUTE
  note "HaHaland paints over things and they bleed back. TODO(lane2 prop motion): the roller crosses; staged as show + paint splats"
  +0    sfx FX_LETTER_DROP ; shake SHK_TAP ; fx sparkle at=160,40 n=12 seed=1100   # the halves meet on the logo
  +0    cam to scale=1.060 over=264 ease=INOUT
  +0    cam pan dx=15.1 dy=5.1 over=264 ease=INOUT
  +15   show roller ; sfx FX_ROLLER_LONG ; fx paint_bloom at=40,84 n=6 seed=1102
  +24   fx paint_bloom at=90,84 n=6 seed=1103
  +30   hide drip ; fx paint_bloom at=126,84 n=6 seed=1104   # painted over as the roller passes x 126
  +38   fx paint_bloom at=180,84 n=6 seed=1105
  +45   hide roller
  +120  fx sparkle at=60,30 n=6 seed=1106 ; fx sparkle at=260,30 n=6 seed=1107
  +240  show drip ; sfx FX_WET_BLIP ; fx paint_bloom at=126,84 n=8 seed=1101   # bar 30.1, the last chord: it bleeds back
  ad "The logo. A pink roller paints over its red drip - and on the last chord the drip bleeds back through."
end

shot mt12 beat=e101_mt_7 len=36 set=logo_card:pose px=1 look=pixel cut=CUT matte=open base=mt11@+263
  +0    mx theme_main_title mute 36                           # MUTE 13, then the ring stays out
  +6    say mt7_pet_01 mouth=none                             # "beep." raw piezo (lib:pet/beep_v1); gag beep 1 of 6
  +14   fx sparkle at=200,40 n=1 seed=1201 ; sfx FX_SPARKLE gain=-20dB   # the last sparkle (purple), it sinks
  ad "Silence. A tiny beep. One purple sparkle sinks."
end

shot mt13 beat=e101_mt_7 len=48 set=title_card:dusk px=1 look=pixel cut=FADE matte=open
  +0    fade in over=13                                       # the dissolve, 13 f
  +0    amb AMB_night_fair on gain=-34dB                      # frame-0 sound; 1-01 owns what follows
  +0    sign s_mt7_title on=banner
  +0    cam to scale=1.100 over=48 ease=OUT                   # insert push
  +0    cam pan dx=14.5 dy=8.2 over=48 ease=OUT
  ad "Title: GIGGLE NIGHT - with MINGLE showing through the wet paint."
end
