# show/ep101/shots/a2.shw: ACT TWO "21:00 (we don't do that)" + EYECATCH PAIR 2
# Source: show/ep101/shotlists/a2.md (57 shots, 7950 f, episode frames 14400-22349).
# Spec §5-§6. Show px on 320x180. Numbers not in the shot list are marked "# choice:".
# Possessed lines: two takes, Clinker slid exactly R8 (8 f) behind Bonejangles, mouth=none (voice from the ribs).
include ../strings/a2.shw

act A2 "21:00 (we don't do that)"
  beat e101_2_01 len=660  shots=a2_01..a2_04
  beat e101_2_02 len=990  shots=a2_05..a2_10
  beat e101_2_03 len=900  shots=a2_11..a2_21
  beat e101_2_04 len=1050 shots=a2_22..a2_27
