# show/ep101/shots/a3.shw - ACT THREE "22:00 ~~Bedtime!~~ weather" + EYECATCH PAIR 3 (seg a3)
# Source: show/ep101/shotlists/a3.md (39 shots, 7,950 f, 00:12:25:00-00:16:50:00).
# Show px on 320x180; +N = frames from the shot's frame 0. Line lengths from lines.csv
# target_seconds until voice.lock exists (anchors marked provisional by the compiler).
#
# STANDARDS: gore lands on demons only (puff_demon, big_puff). Scenes a3_fair, a3_tent,
# a3_house_fp, a3_tent_fp have NO child (assert below). Every scene with Pip is gore=CUTE.
#
# Ops not yet in spec 5.5 (lane 3, VIEW3D/HUD; see the shot list TODO), used as written:
#   hud on|off [slam] · hud set hearts= shells= plate=<string> sub=<string> label=<string>
#   hud face idle|glance|grin|wince|horn · hud sticker on <string> | hud sticker blow
#   hud spin to=<weapon> plate=<string> · hud heart pop
#   mon <id> spawn sprite=<char> at=<cell x,y> [scale=] | mon <id> die gore=<kind> | flinch | lunge
#   lens splat|gib|paint over=F | lens drip on|off | lens clear over=F [twos]
#   gore CUTE|BRUTAL over=F   (mid-shot filter switch, the REWIND)

# =================================================================== 3-01 (1,500 f)
shot a3s01 beat=e101_3_01 len=75 set=act_cards:act3 look=pixel cut=CUT scene=a3_card gore=CUTE
  ad "The Mayor's clipboard: 22:00 Bedtime! is crossed out. Above it, small: weather."
  +0    mx heehee_bell start ; cc "[bell]"
  +0    sign s_a3_01_card on=l5
  +8    sfx FX_PEN_SCRATCH ; reveal l5_strike1 over=+8..+12
  +18   sfx FX_PEN_SCRATCH ; reveal l5_strike2 over=+18..+21
  +23   sfx FX_PEN_SCRATCH ; reveal l5_strike3 over=+23..+26
  +35   sign s_a3_01_card_over on=weather ; pop weather TWT_POP_BUBBLE
  +0    cam to scale=1.100 over=75 ease=OUT    # motion: insert push
  +0    cam pan dx=14.5 dy=8.2 over=75 ease=OUT    # motion: (centred on the frame)
end

shot a3s02 beat=e101_3_01 len=234 set=fun_fair:cute px=1 look=pixel cut=CUT scene=a3_fair gore=CUTE cue=hook_cute@bar:1
  note "STD: no child in this scene"
  cam at=-150,0 ; cam drift dx=0.4
  actor sunny who=sunny kind=figure at=-30,160 face=R idle=on pose=carry_wand
  actor pet   who=pet kind=sprite at=-30,112 idle=on
  crowd puffs gen=randomize who=puff_demon n=8 seed=3021 kind=sprite lane=y150 from=120 spacing=22 cycle=bounce ripple=0..3 age=adult
  end
  ad "Cute mode: Sunny marches across a lilac fun fair, bubbling round gumdrop demons."
  +0    sfx FX_POP ; mx hook_cute start
  +0    walk sunny to=60 over=60
  +105  label WAVE1 ; pose sunny wand_swing fps=8
  +105  fx bubbles at=actor:sunny n=4 seed=31
  +129  fx pop_heart at=crowd:puffs.0 seed=1 ; sfx FX_POP ; sfx FX_SPARKLE ; hitstop 2 ; shake SHK_TAP ; pop pet TWT_POP_BUBBLE
  +155  fx pop_heart at=crowd:puffs.1 seed=2 ; sfx FX_POP ; hitstop 2 ; shake SHK_TAP ; pop pet TWT_POP_BUBBLE
  +180  fx pop_heart at=crowd:puffs.2 seed=3 ; sfx FX_POP ; hitstop 2 ; shake SHK_TAP ; pop pet TWT_POP_BUBBLE
  +206  fx pop_heart at=crowd:puffs.3 seed=4 ; sfx FX_POP ; hitstop 2 ; shake SHK_TAP ; pop pet TWT_POP_BUBBLE
  +232  fx bubble_rise at=crowd:puffs.4 seed=5           # the insert's bubble, on the pop's beat
end

shot a3s03 beat=e101_3_01 len=4 set=fun_fair:cute px=1 look=pixel cut=CUT scene=a3_fair gore=BRUTAL replay=a3s02@+233 insert
  tag shot gore_truth
  note "STD: no child in this scene"
  +0    sfx FX_WETPOP                                     # owns the audio, 4 f
  +0    fx truth_heart at=crowd:puffs.4 seed=6           # the burst, an anatomical heart, beating; red stays in the burst
end

