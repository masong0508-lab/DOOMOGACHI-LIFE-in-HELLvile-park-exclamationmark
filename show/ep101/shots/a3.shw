# =================================================================== 3-04 (1,200 f, PROTECTED HOLD 1 of 3)
shot a3s19 beat=e101_3_04 len=120 set=bandstand:rite px=1 look=pixel cut=CUT scene=a3_steps gore=CUTE
  cam at=-90,0
  actor fuzz who=fuzz kind=figure at=170,164 face=R idle=on px=2
  actor bloom who=bloom kind=figure at=-30,170 face=R idle=on px=2
  actor bone who=bonejangles kind=figure at=285,124 face=L idle=still px=2
  +0    state bone possessed ; twitch bone on
  +0    show candle2 ; show candle3:out                  # two lit, one dead wick
  ad "Silence. On the bandstand steps Bloom catches Father Fuzz's sleeve."
  +0    move bloom to=108,170 over=8    # she hurries in and catches his sleeve
  +10   headturn fuzz 128 4    # turns to her
  +0    mx doomtastic_doom mute 1200 ; sfx FX_CREAK      # sequencer keeps time under the mute
  +6    say a3_04_bloom_01 bloom
  +47   pose fuzz pat ; sfx FX_PAT                        # R8 after the line
  +56   say a3_04_fuzz_01 fuzz
  +115  move bloom to=100,170 over=5 ; headturn fuzz 0 4    # lets go; he looks up at the stage
  @a3_04_bloom_01.start+6 take beat_gesture bloom    # motion:
  @a3_04_fuzz_01.start+6 take beat_gesture fuzz    # motion:
  +0    cam to scale=1.050 over=120 ease=INOUT    # motion: push in, drifting toward the speaker
  +0    cam pan dx=2.6 dy=4.3 over=120 ease=INOUT    # motion: (centred on the frame)
end

