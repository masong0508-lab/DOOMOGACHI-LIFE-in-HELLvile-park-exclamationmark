shot a1_14a beat=e101_1_14 len=240 set=bandstand:vape px=1 cut=CUT scene=a1_sc27
  cam at=frame:boards
  actor bone who=bonejangles kind=figure at=-40,124 face=R idle=on pose=play_ribs fps=8
  change fog1.hidden=yes ; change fog2.hidden=yes ; change eyes1.hidden=yes ; change eyes2.hidden=yes ; change eyes3.hidden=yes
  change lan05.state=default ; change lan06.state=lean ; change lan07.state=lean ; change lan08.state=lean ; change lan09.state=lean ; change lan10.state=lean
  +0    mx bone_xylo start gain=-14dB                             # alone, bright
  +20   prop.show fog1 ; prop.show fog2 ; move fog1 dx=-72 over=220 tw=TW_LINEAR ; move fog2 dx=-60 over=220 tw=TW_LINEAR
  +20   mx ominous_fog start gain=-18dB ; amb FX_FOG_HISS on gain=-30dB   # the series' first OMINOUS cue
  +60   prop.set lan10 state=out ; sfx FX_LANTERN_PFF
  +81   prop.set lan09 state=out ; sfx FX_LANTERN_PFF             # 21
  +94   prop.set lan08 state=out ; sfx FX_LANTERN_PFF             # 13
  +102  prop.set lan07 state=out ; sfx FX_LANTERN_PFF             # 8
  +107  prop.set lan06 state=out ; sfx FX_LANTERN_PFF             # 5
  +110  prop.set lan05 state=out ; sfx FX_LANTERN_PFF             # 3
  +112  prop.set lan04 state=out ; sfx FX_LANTERN_PFF             # 2
  tag scene no
  +0    cam to scale=1.060 over=240 ease=INOUT    # motion: track the action
  +0    cam pan dx=15.1 dy=5.1 over=240 ease=INOUT    # motion: (centred on the frame)
end

