# show/ep101/shots/a1.shw - ACT ONE "18:00 Welcome!" (02:30-07:50, 9,600 f, SC14-SC27)
# Shot list: show/ep101/shotlists/a1.md (every number here traces to it; `# choice:` marks mine).
# Show px on 320x180; doc: = 384x216 units. Times are frames from each shot's frame 0.
# Prop ops at a time (`prop.set <id> state=`, `prop.show`, `prop.hide`) are staging's names,
# pending the lane-2 op (shotlists/a1.md TODO). Cue and SFX ids are provisional (AUDIO).
include ../strings/a1.shw

act A1 "18:00 Welcome!"
  beat e101_1_01 len=540  shots=a1_01a..a1_01c  elastic=150
  beat e101_1_02 len=510  shots=a1_02a..a1_02c
  beat e101_1_03 len=390  shots=a1_03a..a1_03c
  beat e101_1_04 len=390  shots=a1_04a..a1_04c
  beat e101_1_05 len=300  shots=a1_05a..a1_05c
  beat e101_1_06 len=480  shots=a1_06a..a1_06b
  beat e101_1_07 len=390  shots=a1_07a..a1_07b
  beat e101_1_08 len=1350 shots=a1_08a..a1_08f
  beat e101_1_09 len=1650 shots=a1_09a..a1_09h
  beat e101_1_10 len=840  shots=a1_10a..a1_10d
  beat e101_1_11 len=540  shots=a1_11a..a1_11c
  beat e101_1_12 len=600  shots=a1_12a..a1_12d
  beat e101_1_13 len=720  shots=a1_13a..a1_13d
  beat e101_1_14 len=900  shots=a1_14a..a1_14g  protected=yes
end

# ===================================================================== SC14 · 1-01 (540)
shot a1_01a beat=e101_1_01 len=90 set=act_cards:act1 px=1 cut=CUT matte=open scene=a1_sc14
  change l1.state=default                                     # the tick lands at +52
  change l1.hidden=yes ; change l2.hidden=yes ; change l3.hidden=yes ; change l4.hidden=yes ; change l5.hidden=yes
  +0    mx heehee_bell start                                  # HEE_HEE bell on frame 0
  +4    prop.show l1 ; pop l1 TWT_POP_SMALL ; fol FOL_PEN_SCRIBBLE
  +12   prop.show l2 ; pop l2 TWT_POP_SMALL ; fol FOL_PEN_SCRIBBLE
  +20   prop.show l3 ; pop l3 TWT_POP_SMALL ; fol FOL_PEN_SCRIBBLE
  +28   prop.show l4 ; pop l4 TWT_POP_SMALL ; fol FOL_PEN_SCRIBBLE
  +36   prop.show l5 ; pop l5 TWT_POP_SMALL ; fol FOL_PEN_SCRIBBLE
  +52   prop.set l1 state=tick ; pop l1 TWT_POP_BUBBLE ; sfx FX_TINK
  cc "[a bell: hee, hee]"
  ad "The Mayor's festival clipboard: 18:00 Welcome! gets a tick."
  +0    cam to scale=1.100 over=90 ease=OUT    # motion: insert push
  +0    cam pan dx=14.5 dy=8.2 over=90 ease=OUT    # motion: (centred on the frame)
end

shot a1_01b beat=e101_1_01 len=330 set=candy_hills_road:sunset px=1 cut=CUT matte=open
  cam at=0,0
  actor sunny who=sunny kind=chibi at=-120,128 face=R idle=on   # in the bus's back window (rides the bus)
  attach sunny to=bus dx=40 dy=-33                            # choice: window offset
  change bus.x=-140
  +0    mx hahaland_day start filter=radio gain=-14dB ; cc "[tinny radio music]"
  +0    move bus to=244,161 over=240 tw=TW_LINEAR             # constant 1.6 px/f: no easing is the gag
  +240  prop.set bus state=stop ; sfx FX_RECORD_SCRATCH ; tapestop 5
  +245  mx hahaland_day stop                                  # 14 f of silence from +245
  +259  detach sunny ; actor.kind sunny figure ; move sunny to=232,166 over=9 tw=TW_DROP
  +268  squash sunny 313 over=2 ; squash sunny 256 over=4      # 1.22 / 0.80 (Q8); plush recovers
  +276  prop.show suitcase at=250,166 ; sfx FX_BOING ; squash suitcase 200 over=3
  +290  sfx FX_BOING gain=-6dB ; pop suitcase TWT_POP_SMALL
  +300  squash suitcase 256 over=3                            # settles beside Sunny as if first
  prop  suitcase art=gen:suitcase(seed=14) plane=road at=250,166 anchor=bottom hidden=yes
  ad "A pink bus crosses the candy hills without slowing, then brakes dead. Sunny is thrown into the road; the suitcase lands after."
  +0    cam to scale=1.060 over=330 ease=INOUT    # motion: track the action
  +0    cam pan dx=15.1 dy=5.1 over=330 ease=INOUT    # motion: (centred on the frame)
end

shot a1_01c beat=e101_1_01 len=120 set=candy_hills_road:sunset px=1 cut=CUT
  cam at=0,0
  change bus.x=244 ; change bus.state=stop
  actor sunny who=sunny kind=figure at=232,166 face=R idle=on pose=sit
  prop  suitcase art=gen:suitcase(seed=14) plane=road at=250,166 anchor=bottom
  +0    sfx FX_DOOR_FOLD
  +20   prop.set bus state=drive ; move bus to=460,161 over=135 tw=TW_LINEAR ; sfx FX_BUS_AWAY
  +20   fx dust_pink at=prop:bus n=12 seed=1401
  +80   blink sunny
  +0    cam to scale=1.060 over=120 ease=INOUT    # motion: track the action
  +0    cam pan dx=15.1 dy=5.1 over=120 ease=INOUT    # motion: (centred on the frame)
end

# ===================================================================== SC15 · 1-02 (510)
