# ===================================================== staged-shot names (STAGING's shots/*.shw call these)
# alias:<ID>[:semis[:seconds]] renders another library sound, varispeed and cut; the staged name keeps
# its own gain and caption. Swap any for a dedicated design later without touching a shot.
amb AMB_NIGHT_ROOM           src=alias:AMB_cottage_dawn:-3          cat=staged gain=-26dB stereo loop
amb AMB_crickets             src=alias:AMB_night_crickets           cat=staged gain=-22dB stereo loop
amb AMB_lamp_hum             src=alias:AMB_fog:7                    cat=staged gain=-28dB stereo loop
amb AMB_night_air            src=alias:AMB_fog:3                    cat=staged gain=-24dB stereo loop
amb AMB_night_still          src=alias:AMB_night_crickets:-2        cat=staged gain=-26dB stereo loop
fol FOL_bone_clatter_soft    src=alias:FOL_bone_clack               cat=staged gain=-14dB
fol FOL_bone_click_walk      src=alias:FX_BONE_CLICK                cat=staged gain=-14dB
fol FOL_bone_creak           src=alias:FX_CREAK:-5                  cat=staged gain=-14dB
