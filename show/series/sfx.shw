# show/series/sfx.shw - SFX, foley and ambience names -> sources, gains, pans, SDH captions
# (owner: AUDIO, WP10; SHOW_ENGINE_SPEC.md sec.5.1, 6.1, 10.5; GAG_BIBLE.md sec.9, 10.1).
# Rendered by `show sfx build` (python3 -m showtk.sfx.library build) to
# <show_lib>/sfx/DGL_<cat>_<name>_<var>.wav, 48 kHz / 24-bit, peak -1 dBFS; hashes in
# show/lib/sfx/sfx.lock. A shot plays one with `sfx† <id> [gain=] [pan=]` (`fol†`, `amb†`).
#
#   sfx|fol|amb <ID> src=<source> cat=<category> [gain=dB] [pan=center|L|R|x|auto] [cc="[...]"]
#                    [stereo] [loop] [process=none]
# Sources (the game's own first):
#   synth:<recipe>[:semis]   core/src/audio_fx.c SynthSeg tables, stepped as audio_fx_synth_step()
#   sfxgen:<NAME>            tools/sfxgen.py imported and run at 48,000 Hz
#   piezo:<recipe>[:semis]   the engine's own render (`runner --wav` code), sample-and-hold to 48 kHz
#   design:<fn>              showtk/sfx/designs.py (built on the two above where the game has it)
#   foley:crayon(stroke_speed) | foley:paws(steps=crowd)   the two data-driven foley synths
# `gain` is the default level in the FX bus (the shot may override it); captions follow the
# gag bible: comic sounds that carry a joke are captioned, the rest are not.

# ===================================================== the game's comedy kit (audio_fx.c SynthSeg)
sfx FX_SCRATCH       src=synth:scratch   cat=synth gain=-8dB  pan=center cc="[record scratch]"
sfx FX_BOING         src=synth:boing     cat=synth gain=-9dB  pan=auto   cc="[boing]"
sfx FX_POP           src=synth:pop       cat=synth gain=-12dB pan=auto
sfx FX_THUD          src=synth:thud      cat=synth gain=-6dB  pan=center
sfx FX_WHOOSH        src=synth:whoosh    cat=synth gain=-12dB pan=auto
sfx FX_KAZOO         src=synth:kazoo     cat=synth gain=-9dB  pan=center cc="[kazoo]"
sfx FX_KAZOO_2       src=synth:kazoo:-3  cat=synth gain=-9dB  pan=center cc="[kazoo, lower]"
sfx FX_KAZOO_3       src=synth:kazoo:-6  cat=synth gain=-9dB  pan=center cc="[kazoo, lower still]"
sfx FX_GLITCH        src=synth:glitch    cat=synth gain=-12dB pan=center
sfx FX_TIK           src=synth:tik       cat=synth gain=-14dB pan=auto
sfx FX_SHWIP         src=synth:shwip     cat=synth gain=-10dB pan=center
sfx FX_TINK          src=synth:tink      cat=synth gain=-12dB pan=auto   cc="[*tink*]"
sfx FX_FANFARE       src=synth:fanfare   cat=synth gain=-10dB pan=center
sfx FX_CHOIR         src=synth:choir     cat=synth gain=-12dB pan=center
sfx FX_PLUCK         src=synth:pluck     cat=synth gain=-10dB pan=center
sfx FX_CREAK         src=synth:creak     cat=synth gain=-12dB pan=auto

# ===================================================== the game's PCM effects (sfxgen.py at 48 kHz)
sfx FX_CURSOR        src=sfxgen:CURSOR      cat=game gain=-14dB pan=center
sfx FX_SELECT        src=sfxgen:SELECT      cat=game gain=-14dB pan=center
sfx FX_CANCEL        src=sfxgen:CANCEL      cat=game gain=-14dB pan=center
sfx FX_ERROR         src=sfxgen:ERROR       cat=game gain=-14dB pan=center
sfx FX_BLIP          src=sfxgen:BLIP        cat=game gain=-14dB pan=center
sfx FX_EAT           src=sfxgen:EAT         cat=game gain=-10dB pan=auto
sfx FX_HAPPY         src=sfxgen:HAPPY       cat=game gain=-12dB pan=center
sfx FX_SAD           src=sfxgen:SAD         cat=game gain=-12dB pan=center
sfx FX_LOVE          src=sfxgen:LOVE        cat=game gain=-12dB pan=center
sfx FX_SPARKLE       src=sfxgen:SPARKLE     cat=game gain=-14dB pan=auto
sfx FX_SPLASH        src=sfxgen:SPLASH      cat=game gain=-10dB pan=auto
sfx FX_POOP          src=sfxgen:POOP        cat=game gain=-12dB pan=auto
sfx FX_EGG_CRACK     src=sfxgen:EGG_CRACK   cat=game gain=-6dB  pan=center cc="[crack]"
sfx FX_EVOLVE        src=sfxgen:EVOLVE      cat=game gain=-12dB pan=center
sfx FX_PISTOL        src=sfxgen:PISTOL      cat=game gain=-8dB  pan=auto
sfx FX_SHOTGUN       src=sfxgen:SHOTGUN     cat=game gain=-6dB  pan=auto
sfx FX_CHAINGUN      src=sfxgen:CHAINGUN    cat=game gain=-8dB  pan=auto
sfx FX_ROCKET        src=sfxgen:ROCKET      cat=game gain=-8dB  pan=auto
sfx FX_PLASMA        src=sfxgen:PLASMA      cat=game gain=-8dB  pan=auto
sfx FX_BUBBLE        src=sfxgen:BUBBLE      cat=game gain=-12dB pan=auto
sfx FX_SQUEAK        src=sfxgen:SQUEAK      cat=game gain=-10dB pan=auto   cc="[squeak]"
sfx FX_CHAINSAW      src=sfxgen:CHAINSAW    cat=game gain=-8dB  pan=auto
sfx FX_EXPLODE       src=sfxgen:EXPLODE     cat=game gain=-6dB  pan=auto
sfx FX_SPLAT         src=sfxgen:SPLAT       cat=game gain=-8dB  pan=auto
sfx FX_CONFETTI      src=sfxgen:CONFETTI    cat=game gain=-10dB pan=auto
sfx FX_DEMON_ROAR    src=sfxgen:DEMON_ROAR  cat=game gain=-8dB  pan=auto
sfx FX_DEMON_PAIN    src=sfxgen:DEMON_PAIN  cat=game gain=-10dB pan=auto
sfx FX_DEMON_DIE     src=sfxgen:DEMON_DIE   cat=game gain=-8dB  pan=auto
sfx FX_PLAYER_HURT   src=sfxgen:PLAYER_HURT cat=game gain=-10dB pan=center
sfx FX_PICKUP        src=sfxgen:PICKUP      cat=game gain=-12dB pan=center
sfx FX_DOOR          src=sfxgen:DOOR        cat=game gain=-10dB pan=auto
sfx FX_WELD          src=sfxgen:WELD        cat=game gain=-10dB pan=auto
sfx FX_HOLY          src=sfxgen:HOLY        cat=game gain=-10dB pan=center
sfx FX_POSSESS       src=sfxgen:POSSESS     cat=game gain=-8dB  pan=center
sfx FX_BELL          src=sfxgen:BELL        cat=game gain=-10dB pan=auto

# ===================================================== the pet: the raw GBA piezo (never processed)
# "beep." is the engine's own sound in three readings (sec.10.2): process=none is enforced, no
# EQ, no reverb, no limiter; the caption is the line. The demon copy (EC2-IN) beeps lower.
sfx PET_BEEP_1       src=piezo:beep       cat=pet gain=-10dB pan=center process=none cc="[beep.]"
sfx PET_BEEP_2       src=piezo:beep:2     cat=pet gain=-10dB pan=center process=none cc="[beep.]"
sfx PET_BEEP_3       src=piezo:beep:-2    cat=pet gain=-10dB pan=center process=none cc="[beep.]"
sfx FX_DEMON_BEEP    src=piezo:beep:-7    cat=pet gain=-12dB pan=center process=none cc="[a lower beep]"

# ===================================================== the cold open (COLD_OPEN_SHOTLIST.md)
