# ---------------------------------------------------------------- staged-shot names
# STAGING's shots name these; each renders the same score/file as the cue it copies (same
# bar map), so a later dedicated arrangement replaces one line here and no shot changes.
cue riff_em src=score:pilot.riff form=possessed bars=16 bpm=140 meter=4/4 key=E desc="the ribs play with no hands (2-01) (= riff_possessed)"
end
cue fuzz_hymn src=score:pilot.hymn_try3 bpm=96 meter=4/4 key=F desc="the FUZZ hymn under the sermon (2-05) (= hymn_try3)"
end
cue fuzz_hymn_motif src=score:pilot.sting form=fuzz_small bpm=80 meter=4/4 key=F desc="the FUZZ hymn motif, small (3-08) (= fuzz_small)"
end
cue fail_sting src=score:pilot.fail times=1 bpm=120 meter=4/4 key=C desc="the FAIL card sting (2-06) (= fail_x1)"
end
cue doomtastic_doom src=file:doomtastic_times_main_title.flac barmap=midi:midi/main_title/tracks/doomtastic_times_main_title_full.mid length=1500 fade=0.3 desc="the theme as the DOOM-side lift (3-03): start from=prechorus_last2 (= theme_main_title)"
end
cue wall_motif src=score:pilot.sting form=wall_flame bpm=70 meter=4/4 key=E desc="the wall's motif under the blue candle (3-09) (= wall_flame)"
end
cue riff_its_fine src=score:pilot.its_fine key=C bpm=140 meter=4/4 desc="the RIFF landing on ITS_FINE (3-09) (= its_fine)"
end
cue ominous_bed src=mml:SONG_OMINOUS bpm=70 meter=4/4 key=E passes=2 verb=hall rt60=2.6 desc="the Mayor's bed creeping in (4-0x) (= ominous_fog)"
  # @10 spooky wobble lead (the WALL motif e2 f2 | e2 a+2) -> a wobbling pulse; @9 pad; the
  # @12 music box far off; the heartbeat kick
  track 0 inst=chip_p12 p.vib_depth=55 p.vib_rate=4.5 p.vib_delay=0.1 gain=-6dB send=-6
  track 1 inst=string_pad gain=-4dB send=-8
  track 2 inst=musicbox gain=-15dB send=-4
  track 3 inst=drums_acoustic gain=-10dB send=-14
end
cue choir_soft src=score:pilot.true_name bpm=72 meter=4/4 key=F desc="the soft choir as the candles relight (4-01) (= true_name)"
end
