end
cue mayor_motif src=score:pilot.sting form=mayor_slow bpm=72 meter=4/4 key=C desc="the Mayor's motif, slow (4-0x) (= mayor_slow)"
end
cue home_box src=score:pilot.sting form=home_cottage bpm=84 meter=3/4 key=C desc="HOME on the music box at the cottage (4-08) (= home_cottage)"
end
cue credits_box src=score:pilot.credits_musicbox bpm=120 meter=4/4 key=E desc="end credits: the theme's chorus hook on the music box (= credits_musicbox)"
end
cue theme_eyecatch_in src=score:pilot.eyecatch_in bpm=150 meter=4/4 key=E desc="eyecatch IN: the RIFF resolving on ITS_FINE (= eyecatch_in)"
end
