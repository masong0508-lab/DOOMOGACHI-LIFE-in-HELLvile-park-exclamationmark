# child_hand.pxt - the storybook captions' child's hand (spec 8.6, WP7): 1-bit glyphs
# in 12-row cells, '#' ink, '.' paper. Caps sit on rows 1-9, the x-height is rows 4-9,
# descenders reach row 11. The player draws every glyph with a 1 px outline and a
# baseline wobble of -1..+1 px by position, so the same letter never sits twice the
# same way. Edit pixels here, then run `python3 -m showtk.l2.pxt` (from show/tools)
# to regenerate show/engine/show_font_child.c; a test fails if the two disagree.
pxt font child_hand h=12 line=14 space=1

glyph code=0x20   # space
