# core_sources.cmake - the curated core closure of show.exe (spec 8.7, 15.1).
#
# Measured by the v1.1 link probe (critique_nye/probe): what the player's
# 2D layer, portraits, beat, camfx, tween, text and town need, plus the
# house and map modules the ROOM / VIEW3D / OVERWORLD stages need. Never
# game.c, scene.c or any scene: show_game.c defines what they would.
#
# Every path is read-only. portrait.c and portrait_head.c are NOT listed:
# CMakeLists.txt compiles patched copies of them (patches/, spec 4.3).
# A name here that the game deletes stops the show's configure step with
# its path (the game build never reads this file).

set(SHOW_CORE_NAMES
	# portrait engine (portrait.c + portrait_head.c come patched, from gen/)
	portrait_body portrait_fx portrait_gfx portrait_gun portrait_hair portrait_lut
	# runtime the player drives
	beat camfx tween tween_tables
	# 2D layer, text, fonts, palette
	ui ui_draw ui_raster ui_fmt font palette fixmath fixmath_table txt
	# looks and the town that serves them (doomo_town: beat.c and hcmd.c
	# reference it directly), the options camfx/ui read (opt_get)
	resident catalog rng town options
	# art accessors and the weak placeholders the strong code overrides
	stubs textures sprites plat_weak_fx plat_weak_music
	# ROOM (home_room_template, home_room_defs, home_obj_view, home_furn,
	# home_furn_by_role) and the maps VIEW3D / OVERWORLD read
	home home_draw home_edit map maps
)

# files under core/gen/ (generated by the game's own tools, committed)
set(SHOW_CORE_GEN_NAMES
	txt_dict furn_data furn_iso furn_grant
)

# compiled -O2 like the game's DOOMO_CORE_HOT list (the rest is -Os)
set(SHOW_CORE_HOT ui_raster ui ui_draw font fixmath map rng)

set(SHOW_CORE_SRCS "")
foreach(_n ${SHOW_CORE_NAMES})
	if(NOT EXISTS ${CORE_DIR}/src/${_n}.c)
		message(FATAL_ERROR "show: core/src/${_n}.c is gone (show/engine/core_sources.cmake)")
	endif()
	list(APPEND SHOW_CORE_SRCS ${CORE_DIR}/src/${_n}.c)
endforeach()
foreach(_n ${SHOW_CORE_GEN_NAMES})
	if(NOT EXISTS ${CORE_DIR}/gen/${_n}.c)
		message(FATAL_ERROR "show: core/gen/${_n}.c is gone (show/engine/core_sources.cmake)")
	endif()
	list(APPEND SHOW_CORE_SRCS ${CORE_DIR}/gen/${_n}.c)
endforeach()

# the game's maps (core/gen/map_*.c), packed like the game does them
file(GLOB SHOW_CORE_MAPS CONFIGURE_DEPENDS ${CORE_DIR}/gen/map_*.c)
list(SORT SHOW_CORE_MAPS)

# the portrait files the show patches (spec 4.3)
set(SHOW_PATCHED portrait portrait_head)
